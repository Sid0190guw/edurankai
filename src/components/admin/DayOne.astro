---
/**
 * admin/DayOne — ONE SHAPE FOR AN EMPTY PANEL, WITH THE THREE STATES KEPT APART.
 *
 * WHAT IT REPLACES. A blank tbody. The sentence "Nothing here yet." A list that renders zero rows
 * because the query threw. All three looked identical on this console, and the third one dressed as
 * the second is how a failure goes unnoticed for months: nobody investigates the word "none".
 *
 * THE THREE STATES, and the different sentence each one gets:
 *
 *   unconfigured — this module has never been set up. Amber. Says what has not been set up, what
 *                  does not work until it is, and links to the screen that sets it up. This is the
 *                  state almost every screen on a fresh deployment is actually in, and the state no
 *                  screen could previously express.
 *   empty        — the register exists, the read worked, there is genuinely nothing in it. Neutral,
 *                  and it does not apologise: an empty approvals queue is good news. It still names
 *                  the first action, because a first-time operator has no idea what to do next.
 *   unreadable   — the read failed. Red, and it SAYS WHAT FAILED. Never "something went wrong".
 *                  The reason comes from dbReason(), which unwraps e.cause — e.message on a drizzle
 *                  error is only the SQL that failed.
 *
 * THE ACTION IS ALWAYS AN ANCHOR, never a button with a handler. It works with the bundle blocked,
 * opens in a new tab on a middle click, and needs no JavaScript — which matters most on exactly the
 * deployment where nothing is configured yet.
 *
 * MOBILE FIRST. Everything stacks at 360px and every link is a 44px target.
 *
 * NO EMOJI. The one glyph is an inline monochrome SVG, aria-hidden, because the sentence beside it
 * already says everything the drawing says.
 */
import type { DayOneState, Prerequisite } from '@/lib/day-one';

export interface Props {
  state: DayOneState;
  /** The thing, as a noun phrase that can start a sentence: "The department register". */
  thing: string;
  /** The real Postgres reason, already unwrapped. Required in practice when state is unreadable. */
  error?: string | null;
  /** Extra sentence for the genuinely-empty state. */
  emptyBody?: string;
  /** Overrides the default not-configured sentence when a screen needs to be more specific. */
  unconfiguredBody?: string;
  /** What has to exist first. Each renders its consequence and its link. */
  prereqs?: Prerequisite[];
  /** The first action on THIS screen, when there is one (a form below, a New button). */
  actionLabel?: string;
  actionHref?: string;
  /** Tightens it for use inside a card or a table cell. */
  compact?: boolean;
}

const {
  state,
  thing,
  error = null,
  emptyBody = '',
  unconfiguredBody = '',
  prereqs = [],
  actionLabel = '',
  actionHref = '',
  compact = false,
} = Astro.props as Props;

// CONSTANTS FIRST — `const` is not hoisted and a binding under its first reader has taken pages down
// on this project. Plain strings rather than a typed map: a `Record<string,string>` read inside JSX
// is one of the .astro compiler's known failure modes here.
const isFail = state === 'unreadable';
const isUnconfigured = state === 'unconfigured';

const border = isFail ? 'rgba(239,68,68,0.32)' : isUnconfigured ? 'rgba(245,158,11,0.32)' : '#1a1a1f';
const wash = isFail ? 'rgba(239,68,68,0.07)' : isUnconfigured ? 'rgba(245,158,11,0.06)' : '#0f0f14';
const ink = isFail ? '#fca5a5' : isUnconfigured ? '#fcd34d' : '#8a8a94';
const headInk = isFail ? '#fecaca' : isUnconfigured ? '#fde68a' : '#e6e6ea';
const pad = compact ? '12px 14px' : '18px 18px';

// THE HEADLINE SAYS WHICH OF THE THREE IT IS, IN THE FIRST FOUR WORDS.
const heading = isFail
  ? thing + ' could not be read'
  : isUnconfigured
  ? thing + ' has not been set up yet'
  : thing + ' is empty';

// The body sentence. The unreadable one is the important one: it states that the blank below is
// UNKNOWN rather than none, which is the whole reason this component exists.
const body = isFail
  ? 'Nothing below is a statement that there is none — this page does not know what is there. Do not act on the blank space; reload once the reason underneath is fixed.'
  : isUnconfigured
  ? unconfiguredBody ||
    'This is a fresh deployment and nobody has configured it yet. Nothing has gone wrong.'
  : emptyBody || 'This was read successfully and is genuinely empty.';
---
<div class="dayone" style={`background:${wash};border:1px solid ${border};border-radius:12px;padding:${pad};`}>
  <div class="dayone-head">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="dayone-glyph">
      {isFail ? (
        <g><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></g>
      ) : isUnconfigured ? (
        <g><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></g>
      ) : (
        <g><path d="M3 7h18"/><path d="M5 7v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></g>
      )}
    </svg>
    <p class="dayone-title" style={`color:${headInk};`}>{heading}</p>
  </div>

  <p class="dayone-body" style={`color:${ink};`}>{body}</p>

  {isFail && error && (
    <p class="dayone-reason">{error}</p>
  )}

  {prereqs.length > 0 && !isFail && (
    <ul class="dayone-steps">
      {prereqs.map((p) => (
        <li class="dayone-step">
          <a href={p.href} class="dayone-link">{p.action}</a>
          <span class="dayone-because">{p.blocks}</span>
        </li>
      ))}
    </ul>
  )}

  {actionHref && actionLabel && !isFail && (
    <p class="dayone-action"><a href={actionHref} class="dayone-link">{actionLabel}</a></p>
  )}
</div>

<style>
  /* 360px first. Nothing here has a fixed width and nothing relies on a hover state. */
  .dayone { line-height: 1.65; }
  .dayone-head { display: flex; align-items: flex-start; gap: 9px; }
  .dayone-glyph { flex: 0 0 auto; margin-top: 3px; }
  .dayone-title {
    margin: 0; font-size: 13.5px; font-weight: 700; overflow-wrap: anywhere;
  }
  .dayone-body {
    margin: 7px 0 0; font-size: 12.5px; overflow-wrap: anywhere;
  }
  /* The Postgres reason is a machine string: monospace, wrapping, and never clipped to a width that
     hides the part naming the table. */
  .dayone-reason {
    margin: 9px 0 0; font-family: 'Geist Mono', monospace; font-size: 11px; color: #f87171;
    overflow-wrap: anywhere; background: rgba(0,0,0,0.28); border-radius: 6px; padding: 7px 9px;
  }
  .dayone-steps { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .dayone-step { display: flex; flex-direction: column; gap: 3px; }
  .dayone-because { font-size: 12px; color: #8a8a94; overflow-wrap: anywhere; }
  .dayone-action { margin: 12px 0 0; }
  /* 44px target, and it stays a link: underlined, focusable, no handler. */
  .dayone-link {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 2px;
    color: #FF7040; font-size: 13px; font-weight: 600; text-decoration: underline;
    text-underline-offset: 3px; overflow-wrap: anywhere;
  }
  .dayone-link:focus-visible { outline: 2px solid #FF7040; outline-offset: 2px; border-radius: 4px; }
</style>
