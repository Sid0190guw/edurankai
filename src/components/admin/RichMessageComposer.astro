---
// A message body an operator can type into OR paste formatted content into.
//
// ---------------------------------------------------------------------------------------------
// WHAT "PASTE HTML AND IT LOOKS LIKE NORMAL TEXT" ACTUALLY REQUIRES
// ---------------------------------------------------------------------------------------------
// Two different things get called "pasting HTML", and this handles both, because an operator does
// not distinguish them and should not have to:
//
//   1. Pasting FORMATTED CONTENT copied from a document or another mail. The clipboard carries a
//      text/html flavour, the browser would normally paste it with every font, colour and class
//      from wherever it came, and the result looks like a ransom note in our template. We take the
//      html flavour, strip presentation down to structure, and insert that.
//   2. Pasting HTML SOURCE - actual angle brackets typed or copied as text. The browser would show
//      the tags literally. If what was pasted is unmistakably markup, we render it instead, so the
//      recipient sees normal formatted text rather than <p> tags.
//
// Case 2 is a guess, so it is a REVERSIBLE one: the notice under the editor says what happened and
// offers "paste as plain text instead", which re-inserts the original characters verbatim. A silent
// guess about somebody's message is the version of this that gets a bug report.
//
// THE BROWSER IS NOT THE SECURITY BOUNDARY. Everything here is convenience. The body is sanitised
// server-side by sanitizeEmailHtml(OUTBOUND) in src/lib/talent/code-message.ts before it is sent,
// and that is the only check that counts - this file could be bypassed with a curl.
//
// execCommand is deprecated and still the only thing that edits a contenteditable selection with
// undo intact across the browsers this admin runs in. It is what src/pages/portal/notes.astro:542
// already uses; a second, different editor model on one product is worse than a deprecated call.
interface Props {
  /** Form field the sanitised HTML is submitted under. */
  name: string;
  /** Initial HTML. Rendered with set:html - callers pass server-built markup, never user input. */
  value: string;
  label: string;
  hint?: string;
  /** Tokens the operator may use, shown as insert buttons. */
  tokens?: ReadonlyArray<{ token: string; means: string }>;
  /** Unique per instance so two composers on one page do not collide. */
  id?: string;
  /** Shown while the editor is empty. A contenteditable has no placeholder of its own. */
  placeholder?: string;
}
const { name, value, label, hint = '', tokens = [], id = 'composer', placeholder = '' } = Astro.props;
const editorId = id + '-editor';
const fieldId = id + '-field';
const noticeId = id + '-notice';
---

<div class="rmc" data-rmc={id}>
  <div class="rmc__head">
    <label class="rmc__label" for={editorId}>{label}</label>
    {hint && <p class="rmc__hint">{hint}</p>}
  </div>

  <div class="rmc__toolbar" role="toolbar" aria-label="Formatting">
    <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
    <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
    <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
    <span class="rmc__sep"></span>
    <button type="button" data-cmd="h3" title="Heading">H</button>
    <button type="button" data-cmd="ul" title="Bullet list">List</button>
    <button type="button" data-cmd="ol" title="Numbered list">1.</button>
    <button type="button" data-cmd="quote" title="Quote">Quote</button>
    <span class="rmc__sep"></span>
    <button type="button" data-cmd="link" title="Add a link">Link</button>
    <button type="button" data-cmd="clear" title="Clear formatting">Clear</button>
  </div>

  {tokens.length > 0 && (
    <div class="rmc__tokens">
      <span class="rmc__tokens-lead">Insert:</span>
      {tokens.map((t) => (
        <button type="button" class="rmc__token" data-token={t.token} title={t.means}>{t.token}</button>
      ))}
    </div>
  )}

  <div
    id={editorId}
    class="rmc__editor"
    contenteditable="true"
    role="textbox"
    aria-multiline="true"
    aria-label={label}
    data-placeholder={placeholder}
    set:html={value}
  />

  <p id={noticeId} class="rmc__notice" role="status" aria-live="polite" hidden></p>

  <textarea id={fieldId} name={name} hidden>{value}</textarea>
</div>

<style>
  .rmc { display: flex; flex-direction: column; gap: 8px; }
  .rmc__head { display: flex; flex-direction: column; gap: 2px; }
  .rmc__label { font-size: 11px; font-weight: 600; color: #8a8a94; }
  .rmc__hint { margin: 0; font-size: 12px; color: #8a8a94; line-height: 1.5; }

  .rmc__toolbar { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .rmc__toolbar button {
    min-width: 30px; height: 28px; padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 6px;
    background: rgba(255, 255, 255, 0.04); color: inherit;
    font-size: 12px; cursor: pointer; line-height: 1;
  }
  .rmc__toolbar button:hover { background: rgba(255, 255, 255, 0.1); }
  .rmc__toolbar button:focus-visible { outline: 2px solid #ff4f00; outline-offset: 1px; }
  .rmc__sep { width: 1px; height: 18px; background: rgba(255, 255, 255, 0.14); margin: 0 2px; }

  .rmc__tokens { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .rmc__tokens-lead { font-size: 11px; color: #8a8a94; }
  .rmc__token {
    padding: 3px 7px; border: 1px dashed rgba(255, 255, 255, 0.22); border-radius: 5px;
    background: transparent; color: inherit; font-family: ui-monospace, monospace;
    font-size: 11px; cursor: pointer;
  }
  .rmc__token:hover { border-style: solid; background: rgba(255, 255, 255, 0.06); }

  .rmc__editor {
    min-height: 220px; max-height: 460px; overflow-y: auto;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 8px;
    background: rgba(0, 0, 0, 0.2);
    font-size: 14px; line-height: 1.65;
  }
  .rmc__editor:focus { outline: none; border-color: #ff4f00; }
  /* :empty alone is not enough - a contenteditable that has been focused holds a stray <br>. The
     class is toggled from script, which is the only thing that knows the field is really empty. */
  .rmc__editor.is-empty::before {
    content: attr(data-placeholder);
    color: #6b6b75;
    pointer-events: none;
  }
  .rmc__editor p { margin: 0 0 10px; }
  .rmc__editor p:last-child { margin-bottom: 0; }
  .rmc__editor ul, .rmc__editor ol { margin: 0 0 10px; padding-left: 22px; }
  .rmc__editor blockquote {
    margin: 0 0 10px; padding-left: 12px;
    border-left: 2px solid rgba(255, 255, 255, 0.2); color: #b9b9c2;
  }
  .rmc__editor a { color: #ff8a4f; }

  .rmc__notice { margin: 0; font-size: 12px; line-height: 1.5; color: #d9b45a; }
  .rmc__notice button {
    margin-left: 6px; padding: 0; border: 0; background: none;
    color: inherit; text-decoration: underline; cursor: pointer; font-size: 12px;
  }

  /* The admin is used on laptops and phones. Below this the toolbar is the first thing to crowd. */
  @media (max-width: 560px) {
    .rmc__editor { min-height: 180px; font-size: 16px; } /* 16px stops iOS zooming the field */
    .rmc__toolbar button { height: 32px; min-width: 34px; } /* touch target */
  }
</style>

<script>
  (function () {
    const roots = document.querySelectorAll('[data-rmc]');
    roots.forEach(function (root) {
      const id = root.getAttribute('data-rmc');
      const ed = document.getElementById(id + '-editor');
      const field = document.getElementById(id + '-field');
      const notice = document.getElementById(id + '-notice');
      if (!ed || !field) return;

      // ---- keeping the hidden field in step -------------------------------------------------
      // The form submits the FIELD, not the editor. Every path that changes the editor has to write
      // it back, so this is called from input, paste and every toolbar action rather than only on
      // submit - a submit handler alone loses the content if the form is posted any other way.
      function sync() {
        const html = ed.innerHTML;
        // A focused-then-emptied contenteditable holds '<br>' or '<p><br></p>'. Submitting that as
        // a note would store markup for a message the operator did not write.
        const bare = html.replace(/<br\s*\/?>/gi, '').replace(/<\/?(p|div)>/gi, '').replace(/&nbsp;|\s/g, '');
        field.value = bare === '' ? '' : html;
        ed.classList.toggle('is-empty', bare === '');
      }
      ed.addEventListener('input', sync);
      ed.addEventListener('blur', sync);
      const form = ed.closest('form');
      if (form) form.addEventListener('submit', sync);

      function say(html) {
        if (!notice) return;
        notice.innerHTML = html;
        notice.hidden = !html;
      }

      // ---- toolbar ---------------------------------------------------------------------------
      root.querySelectorAll('.rmc__toolbar button').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          ed.focus();
          const cmd = btn.getAttribute('data-cmd');
          if (cmd === 'bold') document.execCommand('bold');
          else if (cmd === 'italic') document.execCommand('italic');
          else if (cmd === 'underline') document.execCommand('underline');
          else if (cmd === 'h3') document.execCommand('formatBlock', false, 'H3');
          else if (cmd === 'ul') document.execCommand('insertUnorderedList');
          else if (cmd === 'ol') document.execCommand('insertOrderedList');
          else if (cmd === 'quote') document.execCommand('formatBlock', false, 'BLOCKQUOTE');
          else if (cmd === 'clear') {
            document.execCommand('removeFormat');
            document.execCommand('formatBlock', false, 'P');
          } else if (cmd === 'link') {
            // prompt() is blunt, and it is also the only thing that cannot lose the selection while
            // a nicer dialog takes focus. An empty answer cancels rather than inserting a dead link.
            const url = window.prompt('Link address', 'https://');
            if (url && /^(https?:|mailto:)/i.test(url)) document.execCommand('createLink', false, url);
            else if (url) say('That link was not added. A link has to start with http, https or mailto.');
          }
          sync();
        });
      });

      // ---- token buttons ---------------------------------------------------------------------
      root.querySelectorAll('.rmc__token').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          ed.focus();
          document.execCommand('insertText', false, btn.getAttribute('data-token'));
          sync();
        });
      });

      // ---- paste ------------------------------------------------------------------------------
      // What the clipboard offers, in the order we prefer it.
      let lastPlain = '';

      function looksLikeMarkup(s) {
        // Deliberately strict. A message that merely MENTIONS a tag ("use the <b> tag") must not be
        // rendered; this wants an opening tag and a matching closing tag for a real element.
        if (!/<([a-z][a-z0-9]*)\b[^>]*>/i.test(s)) return false;
        return /<\/(p|div|span|b|strong|i|em|u|ul|ol|li|a|h[1-6]|br|table|tr|td|blockquote)\s*>/i.test(s)
          || /<br\s*\/?>/i.test(s);
      }

      // Strip presentation, keep structure. Pasted content arrives carrying the fonts and colours of
      // wherever it came from, and inside our template that reads as a broken message rather than a
      // formatted one. The server sanitiser is what makes it SAFE; this only makes it look ours.
      function cleanPasted(html) {
        const doc = document.implementation.createHTMLDocument('');
        doc.body.innerHTML = html;
        doc.body.querySelectorAll('script,style,meta,link,title,object,embed,iframe,form,input,button')
          .forEach(function (n) { n.remove(); });
        doc.body.querySelectorAll('*').forEach(function (n) {
          Array.prototype.slice.call(n.attributes).forEach(function (a) {
            const keep = (n.tagName === 'A' && a.name === 'href');
            if (!keep) n.removeAttribute(a.name);
          });
        });
        return doc.body.innerHTML;
      }

      function insert(html) { document.execCommand('insertHTML', false, html); sync(); }

      ed.addEventListener('paste', function (e) {
        const cb = e.clipboardData;
        if (!cb) return;
        const html = cb.getData('text/html');
        const text = cb.getData('text/plain');

        if (html) {
          e.preventDefault();
          lastPlain = text;
          insert(cleanPasted(html));
          say('Pasted with its formatting kept and its styling removed.'
            + ' <button type="button" data-undo="1">Paste as plain text instead</button>');
          return;
        }

        if (text && looksLikeMarkup(text)) {
          e.preventDefault();
          lastPlain = text;
          insert(text);
          say('That looked like HTML, so it was rendered rather than shown as tags.'
            + ' <button type="button" data-undo="1">Paste as plain text instead</button>');
          return;
        }
        // Anything else is ordinary text: the browser's own handling is right, and sync happens on
        // the input event that follows.
      });

      // The reversal. Re-inserts exactly what was on the clipboard, as characters.
      if (notice) {
        notice.addEventListener('click', function (e) {
          const b = e.target.closest('[data-undo]');
          if (!b) return;
          e.preventDefault();
          document.execCommand('undo');
          ed.focus();
          document.execCommand('insertText', false, lastPlain);
          sync();
          say('');
        });
      }

      sync();
    });
  })();
</script>
