---
// An ordered pipeline as vertical columns: one column per stage, left to right in workflow order,
// each coloured by its phase from a validated one-hue ordinal ramp (four steps of blue, checked
// against the dark admin surface). Counts sit on top of each column; every column has a hover title
// and the figures are repeated in a table for screen readers. A zero stage draws a hairline, so the
// stage is still visibly present.
interface Stage { key: string; label: string; value: number; phase: string; href?: string }
interface Phase { key: string; label: string; color: string }
interface Props { stages: Stage[]; phases: Phase[]; caption: string }
const { stages, phases, caption } = Astro.props;
const max = Math.max(1, ...stages.map((s) => s.value));
const colorOf = (phase: string) => phases.find((p) => p.key === phase)?.color || '#3987e5';
const cols = stages.map((s) => ({ ...s, color: colorOf(s.phase), height: s.value ? Math.max(4, Math.round((s.value / max) * 100)) : 0 }));
---
<figure class="stcol-fig" style="margin:0;">
  <div class="stcol" role="img" aria-label={caption + ': ' + cols.map((c) => c.label + ' ' + c.value).join(', ')}>
    {cols.map((c) => (
      <a class="stcol-col" href={c.href || '#'} title={c.label + ': ' + c.value}>
        <span class="stcol-val">{c.value}</span>
        <span class="stcol-track">
          <span class={'stcol-bar' + (c.height ? '' : ' zero')} style={'height:' + c.height + '%;background:' + c.color + ';'}></span>
        </span>
        <span class="stcol-lbl">{c.label}</span>
      </a>
    ))}
  </div>
  <ul class="stcol-legend">{phases.map((p) => <li><span class="sw" style={'background:' + p.color + ';'}></span>{p.label}</li>)}</ul>
  <table class="sr-only"><caption>{caption}</caption><tbody>{cols.map((c) => <tr><th scope="row">{c.label}</th><td>{c.value}</td></tr>)}</tbody></table>
</figure>

<style>
  .stcol { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 6px; align-items: end; overflow-x: auto; padding-bottom: 2px; }
  .stcol-col { display: grid; grid-template-rows: 18px 150px auto; gap: 6px; text-decoration: none; min-width: 52px; }
  .stcol-val { font-size: 12px; font-weight: 700; color: #fff; text-align: center; font-variant-numeric: tabular-nums; align-self: end; }
  .stcol-track { display: flex; align-items: flex-end; justify-content: center; border-bottom: 1px solid #2a2a2f; }
  .stcol-bar { width: 70%; max-width: 44px; border-radius: 4px 4px 0 0; transition: filter .15s ease; }
  .stcol-bar.zero { height: 2px !important; background: #2a2a2f !important; border-radius: 1px; }
  .stcol-col:hover .stcol-bar { filter: brightness(1.18); }
  .stcol-col:focus-visible { outline: 2px solid #FF9A66; outline-offset: 2px; border-radius: 6px; }
  .stcol-lbl { font-size: 10.5px; line-height: 1.25; color: #9aa6b6; text-align: center; word-break: break-word; }
  .stcol-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 14px; margin: 12px 0 0; padding: 0; font-size: 12px; color: #c8c8d0; }
  .stcol-legend li { display: flex; align-items: center; gap: 6px; }
  .stcol-legend .sw { width: 10px; height: 10px; border-radius: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) { .stcol-bar { transition: none; } }
</style>
