---
// One whole split into parts: a segmented bar with a legend (dataviz: "tall segmented bar" for a
// split read alone, "thin" above a list that already gives the figures). At most six parts: the
// tail folds into "Other". Colours are the validated dark categorical slots, assigned in fixed
// order and never cycled. Each block carries a hover title, and a table copy is kept for screen
// readers, so colour never carries the meaning alone.
interface Part { label: string; value: number }
interface Props { parts: Part[]; tall?: boolean; caption: string }
const { parts, tall = false, caption } = Astro.props;

const COLORS = ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300'];
const sorted = [...parts].filter((p) => p.value > 0).sort((a, b) => b.value - a.value);
const head = sorted.length > 6 ? sorted.slice(0, 5) : sorted;
const tailTotal = sorted.length > 6 ? sorted.slice(5).reduce((s, p) => s + p.value, 0) : 0;
const shown = tailTotal ? [...head, { label: 'Other', value: tailTotal }] : head;
const total = shown.reduce((s, p) => s + p.value, 0);
const pct = (v: number) => (total ? Math.round((v / total) * 100) : 0);
// Text on a block takes whichever of near-black or white contrasts more with that block.
const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ink = (hex: string) => ((lum(hex) + 0.05) / (0.0048 + 0.05) >= (1.05) / (lum(hex) + 0.05) ? '#0b0b0f' : '#ffffff');
const blocks = shown.map((p, i) => {
  const width = total ? (p.value / total) * 100 : 0;
  return { ...p, color: COLORS[i], text: ink(COLORS[i]), share: pct(p.value), width, labelled: tall && width >= 9 };
});
---
{total === 0 ? (
  <p class="hint" style="margin:0;">Nothing to show yet.</p>
) : (
  <figure class="segbar-fig" style="margin:0;">
    <div class={'segbar' + (tall ? ' tall' : '')} role="img" aria-label={caption + ': ' + blocks.map((b) => b.label + ' ' + b.value + ' (' + b.share + '%)').join(', ')}>
      {blocks.map((b) => (
        <span class="seg" style={'width:' + b.width + '%;background:' + b.color + ';'} title={b.label + ': ' + b.value + ' (' + b.share + '%)'}>
          {b.labelled && <span class="seg-txt" style={'color:' + b.text + ';'}>{b.share}%</span>}
        </span>
      ))}
    </div>
    <ul class="seg-legend">
      {blocks.map((b) => (
        <li><span class="sw" style={'background:' + b.color + ';'}></span><span class="lb">{b.label}</span><span class="vl">{b.value}</span></li>
      ))}
    </ul>
    <table class="sr-only">
      <caption>{caption}</caption>
      <tbody>{blocks.map((b) => <tr><th scope="row">{b.label}</th><td>{b.value}</td><td>{b.share}%</td></tr>)}</tbody>
    </table>
  </figure>
)}

<style>
  .segbar { display: flex; gap: 2px; height: 8px; border-radius: 999px; overflow: hidden; background: #1a1a1f; }
  .segbar.tall { height: 28px; border-radius: 4px; }
  .seg { display: flex; align-items: center; justify-content: center; min-width: 3px; height: 100%; }
  .segbar.tall .seg:first-child { border-radius: 4px 0 0 4px; }
  .segbar.tall .seg:last-child { border-radius: 0 4px 4px 0; }
  .seg-txt { font-size: 11px; font-weight: 700; letter-spacing: 0.02em; }
  .seg-legend { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
  .seg-legend li { display: grid; grid-template-columns: 12px 1fr auto; gap: 8px; align-items: center; font-size: 12.5px; }
  .seg-legend .sw { width: 10px; height: 10px; border-radius: 3px; }
  .seg-legend .lb { color: #d8d8de; }
  .seg-legend .vl { color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
