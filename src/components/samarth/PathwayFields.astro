---
// The requirement questions for every discovery pathway, from src/lib/samarth/pathways.ts.
// Every pathway's block is rendered; a few lines of script show the chosen one and disable the
// rest so only its answers are posted. Without script every block shows, and the server still reads
// only the chosen pathway's answers.
import { PATHWAYS, COMMON_QUESTIONS, fieldName, type Answers, type Question } from '@/lib/samarth/pathways';

interface Props { pathway: string; answers: Answers }
const { pathway, answers } = Astro.props;
const val = (q: Question) => answers[q.key] || '';
---
<div class="sam-field">
  <label for="pathway">What kind of project is this?</label>
  <select id="pathway" name="pathway" required>
    <option value="">Choose one</option>
    {PATHWAYS.map((p) => <option value={p.id} selected={p.id === pathway}>{p.label}</option>)}
  </select>
  <span class="hint">The questions below adapt to your choice. If nothing fits, choose the closest and explain in your own words.</span>
</div>

{PATHWAYS.map((p) => (
  <fieldset class="sam-pathway" data-pathway={p.id}>
    <legend class="sam-legend">{p.label}</legend>
    <p class="hint" style="font-size:0.8rem;color:#7a7266;margin:0 0 10px;">{p.intro}</p>
    <div class="sam-form">
      {p.questions.map((q) => (
        <div class="sam-field">
          <label for={'q_' + p.id + '_' + q.key}>{q.label}{q.required ? '' : ' (optional)'}</label>
          {q.kind === 'textarea' && <textarea id={'q_' + p.id + '_' + q.key} name={fieldName(q.key)} maxlength={q.max || 2000}>{val(q)}</textarea>}
          {q.kind === 'text' && <input id={'q_' + p.id + '_' + q.key} name={fieldName(q.key)} type="text" maxlength={q.max || 300} value={val(q)} />}
          {q.kind === 'select' && (
            <select id={'q_' + p.id + '_' + q.key} name={fieldName(q.key)}>
              <option value="">Choose one</option>
              {(q.options || []).map((o) => <option value={o.value} selected={val(q) === o.value}>{o.label}</option>)}
            </select>
          )}
          {q.kind === 'yesno' && (
            <select id={'q_' + p.id + '_' + q.key} name={fieldName(q.key)}>
              <option value="">Choose one</option>
              <option value="yes" selected={val(q) === 'yes'}>Yes</option>
              <option value="no" selected={val(q) === 'no'}>No</option>
            </select>
          )}
          {q.help && <span class="hint">{q.help}</span>}
        </div>
      ))}
    </div>
  </fieldset>
))}

<fieldset>
  <legend class="sam-legend">About the project</legend>
  <div class="sam-form">
    {COMMON_QUESTIONS.map((q) => (
      <div class="sam-field">
        <label for={'q_common_' + q.key}>{q.label}{q.required ? '' : ' (optional)'}</label>
        {q.kind === 'textarea' && <textarea id={'q_common_' + q.key} name={fieldName(q.key)} maxlength={q.max || 2000}>{val(q)}</textarea>}
        {q.kind === 'text' && <input id={'q_common_' + q.key} name={fieldName(q.key)} type="text" maxlength={q.max || 300} value={val(q)} />}
        {q.kind === 'select' && (
          <select id={'q_common_' + q.key} name={fieldName(q.key)}>
            <option value="">Choose one</option>
            {(q.options || []).map((o) => <option value={o.value} selected={val(q) === o.value}>{o.label}</option>)}
          </select>
        )}
        {q.help && <span class="hint">{q.help}</span>}
      </div>
    ))}
  </div>
</fieldset>

<script is:inline>
  (function () {
    var sel = document.getElementById('pathway');
    if (!sel) return;
    function sync() {
      var blocks = document.querySelectorAll('.sam-pathway');
      for (var i = 0; i < blocks.length; i++) {
        var on = blocks[i].getAttribute('data-pathway') === sel.value;
        blocks[i].style.display = on ? '' : 'none';
        blocks[i].disabled = !on;
      }
    }
    sel.addEventListener('change', sync);
    sync();
  })();
</script>
