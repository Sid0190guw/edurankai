---
// The SAMARTH admin frame: AdminLayout, the SAMARTH tab bar, flash messages and one style sheet
// scoped under .sa, matching the dark admin consoles (see /admin/hr/completions).
import AdminLayout from '@/layouts/AdminLayout.astro';
import { samarthSchemaStatus } from '@/lib/samarth/schema';

interface Props { title: string; active: string; eyebrow?: string; msg?: string; err?: string; showX?: boolean; showDesk?: boolean }
const { title, active, eyebrow = 'SAMARTH', msg = '', err = '', showX = true, showDesk = true } = Astro.props;
const TABS = [
  { key: 'overview', label: 'Overview', href: '/admin/samarth', desk: true },
  { key: 'applications', label: 'Consultation requests', href: '/admin/samarth/applications', desk: true },
  { key: 'engagements', label: 'Engagements and quotations', href: '/admin/samarth/engagements', desk: true },
  { key: 'fees', label: 'Booking fees', href: '/admin/samarth/fees', desk: true },
  { key: 'partners', label: 'Partners', href: '/admin/samarth/partners', desk: true },
  { key: 'x', label: 'SAMARTH X', href: '/admin/samarth/x', desk: false },
  { key: 'search', label: 'Search', href: '/admin/samarth/search', desk: true },
].filter((t) => (t.desk ? showDesk : showX));
// Every SAMARTH desk is useless without its tables, so every desk says so and offers the fix.
const schema = await samarthSchemaStatus();
const here = Astro.url.pathname;
---
<AdminLayout title={title} activeNav={active === 'overview' ? 'samarth' : 'samarth-' + active}>
  <div class="sa">
    <nav class="sa-tabs" aria-label="SAMARTH">{TABS.map((t) => <a href={t.href} class={t.key === active ? 'on' : ''}>{t.label}</a>)}</nav>
    <p class="sa-eyebrow">{eyebrow}</p>
    <h1 class="sa-h1">{title}</h1>
    {msg && <div class="sa-flash" role="status">{msg}</div>}
    {err && <div class="sa-flash warn" role="alert">{err}</div>}
    {!schema.ready && (
      <div class="sa-flash bad" role="alert">
        <strong>SAMARTH is not set up on this deployment yet.</strong> {schema.missing.length} of its tables do not exist, so requests, fees and payments cannot be saved, and the public fee page shows an error.
        <form method="POST" action="/api/admin/samarth/setup" style="margin-top:10px;">
          <input type="hidden" name="next" value={here} />
          <button class="sa-btn" type="submit">Set up SAMARTH now</button>
        </form>
        <span class="hint" style="display:block;margin-top:6px;">Creates the eight SAMARTH tables only. Nothing existing is changed. Needs the platform settings permission.</span>
      </div>
    )}
    <slot />
  </div>
</AdminLayout>

<style is:global>
  .sa { padding: 12px 16px 90px; max-width: 1180px; margin: 0 auto; color: #d8d8de; }
  .sa a { color: #FF9A66; }
  .sa-tabs { display: flex; gap: 4px; overflow-x: auto; margin: 0 0 14px; padding-bottom: 4px; scrollbar-width: none; }
  .sa-tabs::-webkit-scrollbar { display: none; }
  .sa-tabs a { white-space: nowrap; font-size: 12.5px; color: #9aa6b6; text-decoration: none; padding: 8px 12px; border-radius: 9px; border: 1px solid #1a1a1f; background: #0f0f14; }
  .sa-tabs a.on { color: #fff; border-color: rgba(255,79,0,0.5); background: rgba(255,79,0,0.08); }
  .sa-eyebrow { font-size: 10.5px; color: #FF7040; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; font-weight: 700; }
  .sa-h1 { font-size: 22px; color: #fff; margin: 6px 0 10px; font-weight: 700; }
  .sa-h2 { font-size: 15px; color: #fff; margin: 0 0 10px; font-weight: 700; }
  .sa-lede { font-size: 13px; color: #9aa6b6; margin: 0 0 14px; line-height: 1.6; max-width: 86ch; }
  .sa-flash { background: rgba(103,232,249,0.08); border: 1px solid rgba(103,232,249,0.3); color: #a5f3fc; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 13px; line-height: 1.5; }
  .sa-flash.warn { background: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.32); color: #fde68a; }
  .sa-flash.bad { background: rgba(248,113,113,0.08); border-color: rgba(248,113,113,0.35); color: #fecaca; }
  .sa-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 14px; }
  .sa-tile { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  .sa-tile .v { font-size: 21px; color: #fff; font-weight: 700; }
  .sa-tile .l { font-size: 11px; color: #9aa6b6; }
  .sa-panel { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 14px; padding: 16px; margin-bottom: 14px; }
  .sa-grid2 { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .sa-grid2 { grid-template-columns: 1fr 1fr; } }
  .sa-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .sa-table th, .sa-table td { text-align: left; padding: 9px 8px; border-bottom: 1px solid #1a1a1f; vertical-align: top; }
  .sa-table th { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a8a94; font-weight: 700; }
  .sa-table tr:hover td { background: rgba(255,255,255,0.015); }
  .sa-scroll { overflow-x: auto; }
  .sa-chip { display: inline-block; font-size: 10.5px; font-weight: 700; padding: 4px 9px; border-radius: 100px; border: 1px solid #2a2a2f; color: #9aa6b6; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
  .sa-chip.ok { color: #86efac; border-color: rgba(134,239,172,0.4); }
  .sa-chip.warn { color: #fde68a; border-color: rgba(253,230,138,0.4); }
  .sa-chip.bad { color: #fca5a5; border-color: rgba(252,165,165,0.4); }
  .sa-chip.hot { color: #FF9A66; border-color: rgba(255,79,0,0.5); }
  .sa input[type=text], .sa input[type=email], .sa input[type=url], .sa input[type=number], .sa input[type=date], .sa input[type=datetime-local], .sa input[type=search], .sa select, .sa textarea {
    background: #08080a; border: 1px solid #2a2a2f; color: #fff; padding: 9px 10px; border-radius: 8px; font-size: 13px; font-family: inherit; min-height: 40px; box-sizing: border-box; width: 100%; }
  .sa textarea { min-height: 90px; line-height: 1.5; resize: vertical; }
  .sa label { font-size: 12px; color: #c8c8d0; display: grid; gap: 5px; }
  .sa .hint { font-size: 11px; color: #8a8a94; line-height: 1.5; }
  .sa-form { display: grid; gap: 10px; }
  .sa-row { display: grid; gap: 10px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .sa-row { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); } }
  .sa-inline { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .sa-btn { background: #FF4F00; color: #fff !important; border: none; padding: 0 14px; min-height: 40px; border-radius: 9px; font-size: 12.5px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-family: inherit; white-space: nowrap; }
  .sa-btn.ghost { background: transparent; border: 1px solid #2a2a2f; color: #d8d8de !important; }
  .sa-btn.danger { background: #7f1d1d; }
  .sa-btn[disabled] { opacity: 0.45; cursor: not-allowed; }
  .sa-kv { display: grid; grid-template-columns: minmax(130px, 30%) 1fr; gap: 6px 12px; font-size: 12.5px; margin: 0; }
  .sa-kv dt { color: #8a8a94; } .sa-kv dd { margin: 0; color: #e8e8ee; white-space: pre-wrap; word-break: break-word; }
  .sa-timeline { list-style: none; margin: 0; padding: 0; }
  .sa-timeline li { border-left: 2px solid #2a2a2f; padding: 0 0 12px 12px; position: relative; }
  .sa-timeline li::before { content: ''; position: absolute; left: -5px; top: 4px; width: 8px; height: 8px; border-radius: 50%; background: #FF4F00; }
  .sa-timeline .w { font-size: 10.5px; color: #8a8a94; font-family: 'Geist Mono', monospace; }
  .sa-timeline .b { font-size: 12.5px; color: #d8d8de; margin: 2px 0 0; white-space: pre-wrap; line-height: 1.5; }
  .sa-timeline .vis { font-size: 9.5px; color: #FF9A66; margin-left: 6px; }
  .sa-empty { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 12px; padding: 26px 18px; text-align: center; color: #8a8a94; font-size: 13px; line-height: 1.6; }
  .sa-bar { height: 6px; border-radius: 3px; background: #1a1a1f; overflow: hidden; }
  .sa-bar span { display: block; height: 100%; background: #FF4F00; }
  .sa-check { display: flex !important; grid-template-columns: none !important; gap: 8px; align-items: flex-start; }
  .sa-check input { margin-top: 2px; accent-color: #FF4F00; }
  .sa details > summary { cursor: pointer; color: #fff; font-size: 13px; font-weight: 600; }
</style>
