---
// The frame every public SAMARTH page renders in: the site layout, the SAMARTH sub-navigation,
// breadcrumbs (visible and as structured data), any page structured data, and one shared style
// sheet scoped under .sam so nothing leaks onto the rest of the site.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';

interface Crumb { label: string; href: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  active?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], jsonLd = [], active = '', noindex = false } = Astro.props;

const NAV = [
  { key: 'home', label: 'Overview', href: '/samarth' },
  { key: 'consultation', label: 'Consultation', href: '/samarth/consultation' },
  { key: 'industry', label: 'Industry', href: '/samarth/industry' },
  { key: 'government', label: 'Government', href: '/samarth/government' },
  { key: 'engineering', label: 'Engineering', href: '/samarth/engineering' },
  { key: 'consultancy', label: 'Packages', href: '/samarth/consultancy' },
  { key: 'services', label: 'Capabilities', href: '/samarth/services' },
  { key: 'partners', label: 'Partners', href: '/samarth/partners' },
  { key: 'x', label: 'SAMARTH X', href: '/samarth/x' },
];

const base = SITE.url.replace(/\/+$/, '');
const trail = [{ label: 'EduRankAI', href: '/' }, ...crumbs];
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: base + c.href })),
};
// One block, as an @graph, rather than a <script> per item: a script tag inside a JSX expression
// is a parsing hazard in .astro files on this project.
const graph = { '@context': 'https://schema.org', '@graph': [breadcrumbLd, ...jsonLd].map((x: any) => { const { ['@context']: _c, ...rest } = x; return rest; }) };
const graphJson = JSON.stringify(graph);
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <script is:inline type="application/ld+json" set:html={graphJson} />
  <div class="sam">
    <nav class="sam-sub" aria-label="SAMARTH">
      <div class="sam-sub-in">
        <a href="/samarth" class="sam-brand">SAMARTH</a>
        <div class="sam-sub-links">
          {NAV.map((n) => <a href={n.href} class={n.key === active ? 'on' : ''} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>)}
        </div>
        <a href="/samarth/register" class="sam-btn sam-btn-sm">Register</a>
      </div>
    </nav>
    {crumbs.length > 0 && (
      <ol class="sam-crumbs" aria-label="Breadcrumb">
        {trail.map((c, i) => <li>{i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    )}
    <slot />
  </div>
</BaseLayout>

<style is:global>
  .sam { --ink: #16130f; --soft: #5a544b; --mute: #7a7266; --line: rgba(22,19,15,0.10); --burn: #FF4F00; --paper: #fbf8f4; --card: #fff; --ok: #15803d; --warn: #9a6200; --bad: #b42318; color: var(--ink); }
  .sam a { color: inherit; }
  .sam-sub { position: sticky; top: 0; z-index: 30; background: rgba(251,248,244,0.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .sam-sub-in { max-width: 1160px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 14px; }
  .sam-brand { font-family: 'Geist Mono', ui-monospace, monospace; font-weight: 800; letter-spacing: 0.2em; font-size: 0.78rem; color: var(--burn) !important; text-decoration: none; flex-shrink: 0; }
  .sam-sub-links { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; flex: 1; min-width: 0; }
  .sam-sub-links::-webkit-scrollbar { display: none; }
  .sam-sub-links a { white-space: nowrap; font-size: 0.82rem; color: var(--soft); text-decoration: none; padding: 7px 10px; border-radius: 8px; }
  .sam-sub-links a:hover { background: rgba(22,19,15,0.05); color: var(--ink); }
  .sam-sub-links a.on { color: var(--ink); background: rgba(255,79,0,0.09); font-weight: 600; }
  .sam-crumbs { max-width: 1160px; margin: 14px auto 0; padding: 0 16px; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.76rem; color: var(--mute); }
  .sam-crumbs li + li::before { content: '/'; margin-right: 6px; color: #c4bcb0; }
  .sam-crumbs a { text-decoration: none; } .sam-crumbs a:hover { text-decoration: underline; }
  .sam-wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .sam-narrow { max-width: 820px; margin: 0 auto; padding: 0 16px; }
  .sam-hero { padding: clamp(44px, 8vw, 96px) 0 clamp(30px, 5vw, 56px); }
  .sam-eyebrow { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--burn); font-weight: 700; margin: 0 0 14px; }
  .sam-h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -0.022em; font-size: clamp(2.2rem, 5.6vw, 4.2rem); line-height: 1.03; margin: 0 0 20px; max-width: 18ch; }
  .sam-h1 em { font-style: italic; font-weight: 500; color: var(--burn); }
  .sam-lead { font-size: clamp(1rem, 1.4vw, 1.14rem); line-height: 1.75; font-weight: 300; color: #46413a; max-width: 44rem; margin: 0 0 26px; }
  .sam-h2 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -0.015em; line-height: 1.12; margin: 0 0 12px; }
  .sam-h3 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 1.18rem; line-height: 1.2; margin: 0 0 8px; }
  .sam-p { font-size: 0.97rem; line-height: 1.8; color: #46413a; font-weight: 300; margin: 0 0 14px; }
  .sam-sec { padding: clamp(36px, 6vw, 72px) 0; border-top: 1px solid var(--line); }
  .sam-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .sam-grid.two { grid-template-columns: 1fr 1fr; } .sam-grid.three { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .sam-grid.four { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 720px) and (max-width: 999px) { .sam-grid.four { grid-template-columns: 1fr 1fr; } }
  .sam-card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 22px; }
  a.sam-card { display: block; text-decoration: none; transition: border-color .3s ease, transform .3s ease; }
  a.sam-card:hover { border-color: rgba(255,79,0,0.45); transform: translateY(-2px); }
  .sam-tag { display: inline-block; font-family: 'Geist Mono', monospace; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); border: 1px solid var(--line); border-radius: 100px; padding: 4px 10px; margin: 0 6px 6px 0; background: rgba(255,255,255,0.6); }
  .sam-list { margin: 0; padding: 0; list-style: none; }
  .sam-list li { position: relative; padding: 5px 0 5px 18px; font-size: 0.92rem; line-height: 1.6; color: #3f3a33; }
  .sam-list li::before { content: ''; position: absolute; left: 2px; top: 13px; width: 6px; height: 6px; border-radius: 50%; background: var(--burn); opacity: 0.75; }
  .sam-steps { counter-reset: s; list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .sam-steps li { counter-increment: s; position: relative; padding: 14px 16px 14px 56px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; font-size: 0.92rem; line-height: 1.6; color: #3f3a33; }
  .sam-steps li::before { content: counter(s); position: absolute; left: 14px; top: 13px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-family: 'Geist Mono', monospace; font-size: 0.75rem; font-weight: 700; color: var(--burn); border: 1px solid rgba(255,79,0,0.35); background: #fff4ee; }
  .sam-steps strong { color: var(--ink); }
  .sam-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--burn); color: #fff !important; border: 0; border-radius: 10px; padding: 0 20px; min-height: 46px; font-weight: 650; font-size: 0.92rem; text-decoration: none; cursor: pointer; font-family: inherit; }
  .sam-btn:hover { filter: brightness(0.95); }
  .sam-btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  .sam-btn-sm { min-height: 36px; padding: 0 14px; font-size: 0.82rem; flex-shrink: 0; }
  .sam-btn.ghost { background: transparent; color: var(--ink) !important; border: 1px solid rgba(22,19,15,0.2); }
  .sam-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .sam-note { border-left: 3px solid var(--burn); background: #fff7f2; border-radius: 0 12px 12px 0; padding: 14px 16px; font-size: 0.9rem; line-height: 1.65; color: #4a3f35; margin: 0 0 16px; }
  .sam-note.neutral { border-left-color: #9a8f80; background: #f6f2ec; }
  .sam-flash { border-radius: 12px; padding: 12px 14px; font-size: 0.9rem; line-height: 1.55; margin: 0 0 16px; border: 1px solid; }
  .sam-flash.ok { background: #effaf2; border-color: #b7e2c3; color: #14532d; }
  .sam-flash.err { background: #fff1f0; border-color: #f4c7c3; color: #7a1d14; }
  .sam-flash.info { background: #f1f5fb; border-color: #c9d6ea; color: #1e3a5f; }
  .sam-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .sam-table th, .sam-table td { text-align: left; padding: 11px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .sam-table th { font-family: 'Geist Mono', monospace; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); font-weight: 700; }
  .sam-scroll { overflow-x: auto; }
  .sam-form { display: grid; gap: 14px; }
  .sam-field { display: grid; gap: 6px; }
  .sam-field label, .sam-legend { font-size: 0.86rem; font-weight: 600; color: var(--ink); }
  .sam-field .hint { font-size: 0.78rem; color: var(--mute); line-height: 1.5; }
  .sam input[type=text], .sam input[type=email], .sam input[type=tel], .sam input[type=url], .sam input[type=number], .sam input[type=date], .sam input[type=datetime-local], .sam select, .sam textarea {
    width: 100%; box-sizing: border-box; border: 1px solid rgba(22,19,15,0.18); border-radius: 10px; background: #fff; padding: 11px 12px; font: inherit; font-size: 0.93rem; color: var(--ink); min-height: 46px; }
  .sam textarea { min-height: 110px; resize: vertical; line-height: 1.55; }
  .sam input:focus, .sam select:focus, .sam textarea:focus { outline: 2px solid rgba(255,79,0,0.35); outline-offset: 1px; border-color: var(--burn); }
  .sam fieldset { border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin: 0; background: #fff; }
  .sam legend { padding: 0 6px; }
  .sam-check { display: flex; gap: 10px; align-items: flex-start; font-size: 0.88rem; line-height: 1.55; color: #3f3a33; }
  .sam-check input { margin-top: 4px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--burn); }
  .sam-row2 { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .sam-row2 { grid-template-columns: 1fr 1fr; } }
  .sam-choice { display: grid; gap: 8px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .sam-choice { grid-template-columns: 1fr 1fr; } }
  .sam-choice label { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--line); border-radius: 12px; padding: 12px; background: #fff; cursor: pointer; font-weight: 400; }
  .sam-choice label:has(input:checked) { border-color: var(--burn); background: #fff7f2; }
  .sam-choice input { margin-top: 3px; accent-color: var(--burn); }
  .sam-choice b { display: block; font-size: 0.9rem; } .sam-choice small { display: block; font-size: 0.78rem; color: var(--mute); line-height: 1.45; margin-top: 2px; }
  .sam-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sam-chip { display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; padding: 4px 10px; border-radius: 100px; border: 1px solid var(--line); color: var(--soft); background: #fff; }
  .sam-chip.ok { color: var(--ok); border-color: #b7e2c3; background: #effaf2; }
  .sam-chip.warn { color: var(--warn); border-color: #f0dca8; background: #fdf7e7; }
  .sam-chip.bad { color: var(--bad); border-color: #f4c7c3; background: #fff1f0; }
  .sam-progress { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin: 0 0 22px; padding: 0; list-style: none; }
  .sam-progress li { font-size: 0.68rem; line-height: 1.3; color: var(--mute); border-top: 3px solid #e7e0d6; padding-top: 7px; }
  .sam-progress li.done { border-top-color: var(--ok); color: var(--ok); }
  .sam-progress li.current { border-top-color: var(--burn); color: var(--ink); font-weight: 700; }
  @media (max-width: 560px) { .sam-progress { grid-template-columns: repeat(3, 1fr); } }
  .sam-timeline { list-style: none; margin: 0; padding: 0; }
  .sam-timeline li { border-left: 2px solid #eadfd2; padding: 0 0 14px 16px; position: relative; }
  .sam-timeline li::before { content: ''; position: absolute; left: -6px; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #fff; border: 2px solid var(--burn); }
  .sam-timeline .when { font-family: 'Geist Mono', monospace; font-size: 0.68rem; color: var(--mute); }
  .sam-timeline .what { font-size: 0.9rem; line-height: 1.55; color: #3f3a33; white-space: pre-wrap; margin: 2px 0 0; }
  .sam-kv { display: grid; grid-template-columns: minmax(120px, 34%) 1fr; gap: 8px 14px; font-size: 0.9rem; margin: 0; }
  .sam-kv dt { color: var(--mute); } .sam-kv dd { margin: 0; color: var(--ink); white-space: pre-wrap; word-break: break-word; }
  @media (prefers-reduced-motion: reduce) { a.sam-card { transition: none; } }
</style>
