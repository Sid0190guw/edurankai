---
// src/components/mailgov/GovActions.astro — one client script for every governance form.
//
// Each screen declares its actions as ordinary forms:
//
//   <form data-gov-post="/api/mail/gov/orgs" data-gov-confirm="Suspend this organization?">
//     <input type="hidden" name="action" value="suspend" />
//     <input name="reason" />
//   </form>
//
// and this posts them as JSON, shows what came back, and reloads. Written once because ten screens
// hand-rolling the same fetch is ten chances to forget the error branch — and the error branch is the
// entire point here: a governance action that fails silently looks exactly like one that worked.
//
// NO `define:vars`. It cannot be combined with `is:inline` in Astro, and this script needs to be
// inline so it runs on a page with no bundler entry. Everything it needs is read from the DOM.
//
// IT NEVER ASSUMES SUCCESS. `ok: false` in the body is a failure even with a 200, and a non-JSON
// response is reported as one rather than being swallowed into a generic "something went wrong".
---
<div id="gov-result" role="status" aria-live="polite"
     style="display:none;position:fixed;bottom:20px;right:20px;max-width:460px;z-index:60;padding:14px 16px;border-radius:12px;font-size:12.5px;line-height:1.6;box-shadow:0 10px 40px rgba(0,0,0,0.5);"></div>

<script is:inline>
(function () {
  var box = document.getElementById('gov-result');

  function show(ok, title, detail, keep) {
    if (!box) return;
    box.style.display = 'block';
    box.style.background = ok ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.12)';
    box.style.border = '1px solid ' + (ok ? 'rgba(16,185,129,0.40)' : 'rgba(239,68,68,0.40)');
    box.style.color = ok ? '#a7f3d0' : '#fca5a5';
    box.textContent = '';
    var h = document.createElement('p');
    h.style.cssText = 'margin:0 0 4px;font-weight:700;';
    h.textContent = title;
    box.appendChild(h);
    if (detail) {
      var d = document.createElement('p');
      d.style.cssText = 'margin:0;color:#d8d8de;word-break:break-word;';
      d.textContent = detail;
      box.appendChild(d);
    }
    if (!keep) window.setTimeout(function () { box.style.display = 'none'; }, 9000);
  }

  // A value the server shows ONCE — an API key, a download token — is put on screen to be copied
  // rather than flashed away, and the message says so.
  function showOnce(label, value) {
    if (!box) return;
    show(true, label, '', true);
    var pre = document.createElement('code');
    pre.style.cssText = 'display:block;margin-top:8px;padding:8px 10px;background:#08080a;border:1px solid #2a2a2f;border-radius:6px;color:#FF7040;font-size:11.5px;word-break:break-all;';
    pre.textContent = value;
    box.appendChild(pre);
    var note = document.createElement('p');
    note.style.cssText = 'margin:8px 0 0;color:#d8d8de;';
    note.textContent = 'This is shown once and cannot be recovered. Copy it now.';
    box.appendChild(note);
  }

  document.addEventListener('submit', function (ev) {
    var form = ev.target;
    if (!form || !form.getAttribute || !form.getAttribute('data-gov-post')) return;
    ev.preventDefault();

    var confirmText = form.getAttribute('data-gov-confirm');
    if (confirmText && !window.confirm(confirmText)) return;

    var url = form.getAttribute('data-gov-post');
    var payload = {};
    var fields = form.querySelectorAll('input, select, textarea');
    for (var i = 0; i < fields.length; i++) {
      var f = fields[i];
      if (!f.name) continue;
      if (f.type === 'checkbox') payload[f.name] = f.checked;
      else if (f.type === 'number') payload[f.name] = f.value === '' ? null : Number(f.value);
      else if (f.getAttribute('data-json') === '1') {
        try { payload[f.name] = JSON.parse(f.value || '[]'); } catch (e) { payload[f.name] = []; }
      } else if (f.getAttribute('data-multi') === '1') {
        payload[f.name] = (payload[f.name] || []);
        if (f.checked) payload[f.name].push(f.value);
      } else payload[f.name] = f.value;
    }

    var buttons = form.querySelectorAll('button[type="submit"]');
    for (var b = 0; b < buttons.length; b++) buttons[b].disabled = true;
    show(true, 'Working…', '', true);

    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function (res) {
      return res.text().then(function (text) {
        var data = null;
        try { data = JSON.parse(text); } catch (e) { data = null; }
        if (!data) {
          show(false, 'The server did not return JSON (HTTP ' + res.status + ').', text.slice(0, 300), true);
          return null;
        }
        // `ok: false` with a 200 is still a failure. Trusting the status code alone is how a refused
        // action gets reported as done.
        if (!res.ok || data.ok === false) {
          show(false, 'Refused', String(data.error || data.reason || ('HTTP ' + res.status)), true);
          return null;
        }
        return data;
      });
    }).then(function (data) {
      if (!data) return;
      if (data.newKey) { showOnce('New API key', data.newKey); return; }
      if (data.downloadToken) { showOnce('Download token', data.downloadToken); return; }
      show(true, 'Done', data.next || data.note || data.warning || data.summary || '', !!data.warning);
      window.setTimeout(function () { window.location.reload(); }, data.warning ? 6000 : 1200);
    }).catch(function (err) {
      show(false, 'The request did not complete.', String(err && err.message ? err.message : err), true);
    }).then(function () {
      for (var b2 = 0; b2 < buttons.length; b2++) buttons[b2].disabled = false;
    });
  });
})();
</script>
