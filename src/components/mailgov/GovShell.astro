---
// src/components/mailgov/GovShell.astro — the enterprise console frame.
//
// One component owns three things every governance screen needs to do identically:
//
//   1. THE REFUSAL. A page opened by somebody without the capability renders the reason IN PLACE —
//      it does not redirect to a login screen. Somebody who is signed in and unauthorised being sent
//      to a sign-in page learns nothing and is taught to re-authenticate at a page they should not be
//      opening. The refusal names the capability they lack and the role they hold.
//
//   2. THE TENANT BANNER. A platform administrator looking at one customer's data must be able to
//      see, at a glance and at all times, WHOSE data is on screen. Cross-tenant mistakes in an
//      administration console are made by people who forgot which tab they were in.
//
//   3. THE NAVIGATION, generated from the capabilities the viewer actually holds — so a support
//      engineer is not offered a retention screen that will refuse them.
//
// A HIDDEN LINK IS NOT A LOCK. Every page behind these links calls requireGov()/authorizeGov() on its
// own. This decides what is OFFERED; the page decides what is permitted. The same rule
// src/lib/admin-nav.ts states for the main console applies here.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { GOV_ROLE_LABEL, authorizeGov, type GovActor, type GovCapability } from '@/lib/mailgov/policy';

interface Props {
  title: string;
  actor: GovActor;
  /** The capability this page needs. Rendered as a refusal when the viewer lacks it. */
  capability: GovCapability;
  /** The organization being viewed, when the page is about one. */
  org?: { id: string; name: string } | null;
  subtitle?: string;
}

const { title, actor, capability, org = null, subtitle = '' } = Astro.props;

// The SAME substitution gate() makes: a tenant-scoped viewer who is not looking at a named
// organization is looking at their own. Deriving it differently here would draw a refusal over a page
// the server had already authorised, which is the worst of both — a screen that says "not open to
// your account" for a page that is.
const scopeOrgId = org?.id || actor.orgId || undefined;
const decision = authorizeGov(actor, capability, { orgId: scopeOrgId, platformWide: !org && !actor.orgId });
const allowed = decision.allowed;

const TABS = [
  { href: '/admin/mail/enterprise', label: 'Overview', cap: 'org.view' },
  { href: '/admin/mail/enterprise/organizations', label: 'Organizations', cap: 'org.view' },
  { href: '/admin/mail/enterprise/users', label: 'Users', cap: 'user.view' },
  { href: '/admin/mail/enterprise/audit', label: 'Audit', cap: 'audit.view' },
  { href: '/admin/mail/enterprise/retention', label: 'Retention', cap: 'retention.view' },
  { href: '/admin/mail/enterprise/data', label: 'Export & deletion', cap: 'export.view' },
  { href: '/admin/mail/enterprise/consent', label: 'Consent', cap: 'consent.view' },
  { href: '/admin/mail/enterprise/security', label: 'Security', cap: 'security.view' },
  { href: '/admin/mail/enterprise/holds', label: 'Legal holds', cap: 'hold.view' },
  { href: '/admin/mail/enterprise/support', label: 'Support', cap: 'support.metadata.view' },
  { href: '/admin/mail/enterprise/search', label: 'Search', cap: 'search.run' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const orgQuery = org ? '?org=' + org.id : '';

// Offered only where the capability is held. `platformWide` is left unset so the check asks the
// question the tab actually leads to rather than a narrower one.
const tabs = TABS.filter((t) =>
  authorizeGov(actor, t.cap as GovCapability, { orgId: scopeOrgId, platformWide: !org && !actor.orgId }).allowed);
---

<AdminLayout title={title} activeNav="mail">
<div class="admin-page" style="max-width:1180px;">
  <div class="admin-page-header" style="margin-bottom:14px;">
    <div class="admin-page-title-block">
      <div class="admin-page-eyebrow">EduRankAI Mail &middot; Enterprise administration</div>
      <h1 class="admin-page-title">{title}</h1>
      {subtitle && <p class="admin-page-sub">{subtitle}</p>}
    </div>
  </div>

  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;">
    <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;">Signed in as</span>
    <span style="font-size:12px;font-weight:700;color:#fff;">{actor.email || 'not signed in'}</span>
    <span style="font-size:11px;color:#FF7040;font-family:'Geist Mono',monospace;">{GOV_ROLE_LABEL[actor.role]}</span>
    {actor.orgId
      ? <span style="font-size:10.5px;color:#9aa6b6;">scoped to one organization</span>
      : <span style="font-size:10.5px;color:#9aa6b6;">platform scope</span>}
    {org && (
      <span style="margin-left:auto;font-size:11.5px;color:#fbbf24;font-family:'Geist Mono',monospace;background:rgba(251,191,36,0.10);border:1px solid rgba(251,191,36,0.30);padding:3px 10px;border-radius:999px;">
        Viewing: {org.name}
      </span>
    )}
  </div>

  <nav style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:18px;border-bottom:1px solid #1a1a1f;padding-bottom:10px;">
    {tabs.map((t) => (
      <a
        href={t.href + orgQuery}
        style={'font-size:12px;padding:6px 12px;border-radius:8px;text-decoration:none;'
          + (path === t.href ? 'background:#FF4F00;color:#fff;font-weight:700;' : 'color:#9aa6b6;')}
      >{t.label}</a>
    ))}
  </nav>

  {!allowed && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:18px 20px;">
      <p style="font-size:13px;font-weight:700;color:#fca5a5;margin:0 0 8px;">This screen is not open to your account.</p>
      <p style="font-size:12.5px;color:#d8d8de;margin:0 0 10px;line-height:1.6;">{decision.reason}</p>
      <p style="font-size:11.5px;color:#8a8a94;margin:0;font-family:'Geist Mono',monospace;">
        capability: {capability} &middot; your role: {actor.role} &middot; refusal: {decision.code}
      </p>
      <p style="font-size:11.5px;color:#8a8a94;margin:10px 0 0;line-height:1.6;">
        This refusal has been recorded in the audit log and on the security screen, which is deliberate:
        a denial that leaves no trace is indistinguishable from a mistyped address.
      </p>
    </div>
  )}

  {allowed && <slot />}
</div>
</AdminLayout>
