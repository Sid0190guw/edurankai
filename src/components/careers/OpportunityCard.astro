---
// src/components/careers/OpportunityCard.astro — one posting in a list.
//
// ONE CARD, USED EVERYWHERE. The opportunities search, a department page and a division page all
// render this. That is not tidiness: it is the only way the research classification appears on every
// listing surface, rather than on whichever page somebody remembered to add it to.
//
// The classification chip is NOT optional decoration. A posting whose scale range is shown without
// what kind of work it is reads as a claim of reach, which is exactly the misrepresentation the
// department is built to avoid.
import {
  classificationDef, classificationEvidence, scaleRangeText, careerRung,
} from '@/lib/xscale/taxonomy';
// THROUGH work-mode.ts, NOT STRAIGHT OUT OF THE ROW.
//
// This chip rendered `role.location` raw, and this card is what /careers/opportunities, every
// department page and every division page list postings with — so a legacy "Remote / Hybrid
// (India)" row still in the database advertised remote work on all three. displayLocation() leaves
// a genuine bespoke site alone ("On-site — your own campus") and rewrites only the lines that
// contradict the policy, which is the whole reason that function takes the stored string at all.
import { displayLocation } from '@/lib/work-mode';
import type { OpportunityRow } from '@/lib/xscale/roles-ext';

interface Props {
  role: OpportunityRow;
  /** Show the division line. Off on a division page, where it would repeat the heading. */
  showDivision?: boolean;
  /** Admin listings show the status chip; the public one only ever lists PUBLISHED. */
  showStatus?: boolean;
}

const { role, showDivision = true, showStatus = false } = Astro.props;

const cls = classificationDef(role.researchClassification);
const ev = classificationEvidence(role.researchClassification, role.scaleMinExp, role.scaleMaxExp);
const rung = careerRung(role.careerLevel);

const locationText = displayLocation(role.engagementType, role.level, role.location);

const hasScale = typeof role.scaleMinExp === 'number' && typeof role.scaleMaxExp === 'number';
const scaleText = hasScale ? scaleRangeText(role.scaleMinExp as number, role.scaleMaxExp as number) : '';

// Hoisted: a `<` or a typed Record inside a JSX expression breaks .astro parsing.
const skills = (role.skills || []).slice(0, 4);
const extraSkillCount = Math.max(0, (role.skills || []).length - skills.length);
const hasSkills = skills.length > 0;
const showDivisionLine = showDivision && !!role.divisionName;

// The evidence colour is the honest signal, and it darkens as the ground gets softer. Speculative
// work is not painted in the same confident green as established engineering.
const evidenceTone: Record<string, string> = {
  established: '#1f5136',
  experimental: '#1045BB',
  computational: '#5b4bb8',
  theoretical: '#8a5a00',
  speculative: '#9a3412',
};
const evidenceBg: Record<string, string> = {
  established: '#E4EEE7',
  experimental: '#EBF0FF',
  computational: '#EFEBFB',
  theoretical: '#FBF3E2',
  speculative: '#FCEBE2',
};
const evTone = ev ? (evidenceTone[ev.key] || '#6b6257') : '#6b6257';
const evBg = ev ? (evidenceBg[ev.key] || '#F1EDE7') : '#F1EDE7';

const statusTone: Record<string, string> = {
  PUBLISHED: '#1f5136', DRAFT: '#6b6257', PENDING_APPROVAL: '#8a5a00',
  PAUSED: '#8a5a00', CLOSED: '#9a3412', ARCHIVED: '#6b6257',
};
const stTone = statusTone[role.jobStatus] || '#6b6257';
---

<article class="opp-card">
  <a href={`/careers/${role.slug}`} class="opp-card-link">
    <div class="opp-card-head">
      <h3 class="opp-title">{role.title}</h3>
      {showStatus && <span class="opp-status" style={`color:${stTone};border-color:${stTone}40;`}>{role.jobStatus}</span>}
    </div>

    {showDivisionLine && (
      <p class="opp-division">{role.divisionName}</p>
    )}

    <p class="opp-function">{role.functionText}</p>

    <div class="opp-chips">
      {cls && (
        <span class="opp-chip" style={`color:${evTone};background:${evBg};border-color:${evTone}26;`}>
          {cls.label}
        </span>
      )}
      {ev && <span class="opp-chip opp-chip-quiet">{ev.label}</span>}
      {rung && <span class="opp-chip opp-chip-quiet">L{rung.level} &middot; {rung.label}</span>}
      <span class="opp-chip opp-chip-quiet">{role.engagementType}</span>
      <span class="opp-chip opp-chip-quiet">{locationText}</span>
    </div>

    {hasScale && (
      <p class="opp-scale">
        <span class="opp-scale-label">Scale</span>
        <span class="opp-scale-value">{scaleText}</span>
      </p>
    )}

    {hasSkills && (
      <p class="opp-skills">
        {skills.join(' &middot; ')}{extraSkillCount > 0 ? ' + ' + extraSkillCount + ' more' : ''}
      </p>
    )}
  </a>
</article>

<style>
  .opp-card {
    background: #fff;
    border: 1px solid rgba(14, 11, 8, 0.10);
    border-radius: 14px;
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }
  .opp-card:hover {
    transform: translateY(-1px);
    border-color: rgba(14, 11, 8, 0.18);
    box-shadow: 0 4px 16px rgba(0, 0, 0, .05);
  }
  .opp-card-link {
    display: block; padding: 16px 18px; text-decoration: none; color: inherit;
  }
  .opp-card-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
  }
  .opp-title {
    margin: 0 0 2px; font-size: 1rem; font-weight: 650; line-height: 1.3;
    color: var(--ink, #0e0b08);
  }
  .opp-status {
    flex-shrink: 0; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em;
    padding: 2px 7px; border-radius: 6px; border: 1px solid; white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .opp-division {
    margin: 0 0 6px; font-size: 0.74rem; font-weight: 600;
    color: #DC5000; letter-spacing: 0.01em;
  }
  .opp-function {
    margin: 0 0 10px; font-size: 0.84rem; line-height: 1.55;
    color: var(--ink-soft, #6b6257);
  }
  .opp-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .opp-chip {
    font-size: 0.68rem; font-weight: 600; padding: 2.5px 8px;
    border-radius: 999px; border: 1px solid transparent; white-space: nowrap;
  }
  .opp-chip-quiet {
    color: #6b6257; background: #F4F1EC; border-color: rgba(14, 11, 8, 0.07);
  }
  .opp-scale {
    display: flex; align-items: baseline; gap: 7px; margin: 10px 0 0;
  }
  .opp-scale-label {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: #8a8078;
  }
  .opp-scale-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem; color: var(--ink-2, #3a332c);
  }
  .opp-skills {
    margin: 8px 0 0; font-size: 0.72rem; line-height: 1.5; color: #8a8078;
  }
</style>
