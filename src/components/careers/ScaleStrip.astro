---
// src/components/careers/ScaleStrip.astro — the eleven scale bands, drawn, with a range highlighted.
//
// WHY THIS COMPONENT EXISTS AT ALL, rather than a line of text. A span from 10^-100 m to 10^100 m is
// two hundred orders of magnitude, and printed as a number range it reads as a boast. Drawn as a
// strip with most of it marked "no experiment reaches here", it reads as what it is: a filing system
// for research, in which the reachable part is a minority of the width.
//
// THE BANDS THAT ARE NOT EXPERIMENTALLY ACCESSIBLE ARE VISIBLY DIFFERENT — hatched, and labelled in
// the legend. That is the whole point of the drawing. If a future edit makes every band look the
// same, the strip has become decoration and should be deleted rather than kept.
//
// Every comparison is computed in the frontmatter. A `<` inside a JSX expression breaks .astro
// parsing, and so does a typed Record<string,string> in the markup; both have taken pages down here.
import { SCALE_BANDS, bandsForRange, scaleRangeText, SCALE_DISCLAIMER_SHORT } from '@/lib/xscale/taxonomy';

interface Props {
  /** Highlight this range, if given. */
  minExp?: number | null;
  maxExp?: number | null;
  /** Link each band into a listing. Omit for a static illustration. */
  hrefBase?: string;
  compact?: boolean;
  showDisclaimer?: boolean;
}

const { minExp = null, maxExp = null, hrefBase = '', compact = false, showDisclaimer = true } = Astro.props;

const hasRange = typeof minExp === 'number' && typeof maxExp === 'number';
const activeIds = hasRange
  ? new Set(bandsForRange(minExp as number, maxExp as number).map((b) => b.id))
  : new Set<string>();

// Each band is given equal width rather than width proportional to its decades. Proportional width
// would give band 01 (65 decades of pure theory) two thirds of the strip and squeeze every band
// anything is actually built in into a sliver — a drawing that is arithmetically right and
// communicatively useless.
const cells = SCALE_BANDS.map((b) => ({
  id: b.id,
  label: b.label,
  description: b.description,
  reachable: b.experimentallyAccessible,
  active: activeIds.has(b.id),
  range: scaleRangeText(b.minExp, b.maxExp, ''),
  href: hrefBase ? hrefBase + (hrefBase.includes('?') ? '&' : '?') + 'band=' + b.id : '',
}));

const rangeLabel = hasRange ? scaleRangeText(minExp as number, maxExp as number) : '';
const unreachableCount = SCALE_BANDS.filter((b) => !b.experimentallyAccessible).length;
const cellHeight = compact ? '34px' : '52px';
---

<div class="scale-strip">
  {hasRange && (
    <p class="scale-strip-range">
      <span class="scale-strip-range-label">Scale range</span>
      <span class="scale-strip-range-value">{rangeLabel}</span>
    </p>
  )}

  <div class="scale-strip-track" style={`--cell-h:${cellHeight};`} role="list" aria-label="Scale bands from 10 to the minus 100 metres to 10 to the 100 metres">
    {cells.map((c) => (
      <div role="listitem" class:list={['scale-cell', { 'is-active': c.active, 'is-unreachable': !c.reachable }]}>
        {c.href ? (
          <a href={c.href} class="scale-cell-hit" title={c.label + ' (' + c.range + ' m). ' + c.description}>
            <span class="scale-cell-code">{c.id.replace('BAND_', '')}</span>
          </a>
        ) : (
          <span class="scale-cell-hit" title={c.label + ' (' + c.range + ' m). ' + c.description}>
            <span class="scale-cell-code">{c.id.replace('BAND_', '')}</span>
          </span>
        )}
      </div>
    ))}
  </div>

  <div class="scale-strip-ends">
    <span>10<sup>-100</sup> m</span>
    <span>10<sup>0</sup> m</span>
    <span>10<sup>100</sup> m</span>
  </div>

  <div class="scale-strip-legend">
    <span class="scale-legend-item"><i class="swatch swatch-reach"></i>Experiments reach here</span>
    <span class="scale-legend-item"><i class="swatch swatch-noreach"></i>{unreachableCount} bands no experiment reaches</span>
    {hasRange && <span class="scale-legend-item"><i class="swatch swatch-active"></i>This role</span>}
  </div>

  {showDisclaimer && (
    <p class="scale-strip-note">{SCALE_DISCLAIMER_SHORT}</p>
  )}
</div>

<style>
  .scale-strip { margin: 0; }
  .scale-strip-range {
    display: flex; align-items: baseline; gap: 8px; margin: 0 0 8px;
    font-size: 0.82rem;
  }
  .scale-strip-range-label {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.68rem;
    font-weight: 700; color: var(--ink-soft, #8a8078);
  }
  .scale-strip-range-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86rem; color: var(--ink, #0e0b08); font-weight: 600;
  }

  .scale-strip-track {
    display: grid; grid-template-columns: repeat(11, 1fr); gap: 2px;
    border-radius: 8px; overflow: hidden;
  }
  .scale-cell { position: relative; height: var(--cell-h); }
  .scale-cell-hit {
    display: grid; place-items: center; width: 100%; height: 100%;
    background: #E4EEE7; color: #1f5136; text-decoration: none;
    font-size: 0.62rem; font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: filter .15s ease, transform .15s ease;
  }
  a.scale-cell-hit:hover { filter: brightness(0.94); transform: translateY(-1px); }

  /* Not reachable by any apparatus: hatched, and deliberately not a solid confident block. */
  .scale-cell.is-unreachable .scale-cell-hit {
    color: #6b6257;
    background:
      repeating-linear-gradient(45deg, #EFEAE3 0 5px, #E2DBD2 5px 10px);
  }
  .scale-cell.is-active .scale-cell-hit {
    background: #FF4F00; color: #fff;
  }
  .scale-cell.is-active.is-unreachable .scale-cell-hit {
    color: #fff;
    background:
      repeating-linear-gradient(45deg, #FF4F00 0 5px, #C93F00 5px 10px);
  }

  .scale-strip-ends {
    display: flex; justify-content: space-between; margin-top: 5px;
    font-size: 0.66rem; color: var(--ink-soft, #8a8078);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .scale-strip-ends sup { font-size: 0.85em; }

  .scale-strip-legend {
    display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px;
    font-size: 0.7rem; color: var(--ink-soft, #8a8078);
  }
  .scale-legend-item { display: inline-flex; align-items: center; gap: 5px; }
  .swatch { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }
  .swatch-reach { background: #E4EEE7; }
  .swatch-noreach { background: repeating-linear-gradient(45deg, #EFEAE3 0 3px, #E2DBD2 3px 6px); }
  .swatch-active { background: #FF4F00; }

  .scale-strip-note {
    margin: 8px 0 0; font-size: 0.72rem; line-height: 1.5;
    color: var(--ink-soft, #8a8078);
  }

  @media (max-width: 560px) {
    .scale-cell-hit { font-size: 0.55rem; }
  }
</style>
