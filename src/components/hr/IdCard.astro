---
// THE EMPLOYEE ID CARD, FRONT AND BACK. One component for the phone card, the print sheet and the
// HR desk preview, so the three can never drift apart.
//
// Sized to ISO/IEC 7810 ID-1 (the bank-card size, 54 x 85.6 mm), portrait. On screen it scales with
// its container (every measurement is in container-query units); in print it is exactly 54 mm wide,
// so a sheet printed at 100% can be cut and laminated, or fed to a card printer.
//
// THE QR IS THE ONLY SECURITY FEATURE THAT MATTERS, and it is on the back: an Ed25519-signed
// credential (src/lib/hr/id-card-crypto.ts). The guilloche, microprint and foil band are there so a
// colour photocopy looks like one at a glance. They are deterrence, and are not described as more.
//
// No emoji, no arrows; inline SVG only.
export interface Props {
  side: 'front' | 'back';
  fullName: string;
  designation: string;
  employeeCode: string;
  employmentType: string;
  photoUrl: string | null;
  serial: string;
  validUntil: string;
  validFrom?: string | null;
  /** Server-rendered SVG for the back. */
  qrHtml?: string | null;
  logoSrc?: string;
}
const {
  side, fullName, designation, employeeCode, employmentType, photoUrl, serial, validUntil,
  validFrom = null, qrHtml = null, logoSrc = '/icon-192.png',
} = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function shortDate(iso: string | null | undefined): string {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || ''));
  if (!m) return '';
  return Number(m[3]) + ' ' + (MONTHS[Number(m[2]) - 1] || '') + ' ' + m[1];
}
const kind = /intern/i.test(employmentType) ? 'Intern'
  : /apprentic/i.test(employmentType) ? 'Apprentice'
  : /contract/i.test(employmentType) ? 'Contractor'
  : 'Team member';
const initials = fullName.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'E';
const microText = ('EDURANKAI GENUINE ' + serial + ' ').repeat(6);
---
<div class={'idc idc--' + side} data-idc>
  {side === 'front' ? (
    <div class="idc__face">
      <div class="idc__band">
        <div class="idc__guilloche" aria-hidden="true"></div>
        <div class="idc__brand">
          <img src={logoSrc} alt="" class="idc__logo" width="40" height="40" />
          <div>
            <p class="idc__word">Edu<span>Rank</span>AI</p>
            <p class="idc__tag">AI Research and Technology</p>
          </div>
        </div>
      </div>
      <div class="idc__accent" aria-hidden="true"></div>

      <div class="idc__photo">
        {photoUrl
          ? <img src={photoUrl} alt={'Photograph of ' + fullName} />
          : <span class="idc__initials" aria-hidden="true">{initials}</span>}
      </div>

      <div class="idc__who">
        <p class="idc__name">{fullName}</p>
        <p class="idc__role">{designation || kind}</p>
        <p class="idc__kind">{kind}</p>
      </div>

      <div class="idc__facts">
        <div><p class="idc__k">ID no.</p><p class="idc__v">{employeeCode || '-'}</p></div>
        <div><p class="idc__k">Valid until</p><p class="idc__v">{shortDate(validUntil)}</p></div>
      </div>

      <div class="idc__foot">
        <div class="idc__foil" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z" /><path d="M9 12l2 2 4-4" /></svg>
        </div>
        <p class="idc__serial">{serial}</p>
      </div>
      <p class="idc__micro" aria-hidden="true">{microText}</p>
    </div>
  ) : (
    <div class="idc__face idc__face--back">
      <div class="idc__bandsm">
        <img src={logoSrc} alt="" class="idc__logo idc__logo--sm" width="28" height="28" />
        <p class="idc__word idc__word--sm">Edu<span>Rank</span>AI</p>
      </div>
      <p class="idc__scan">Scan to verify</p>
      <div class="idc__qr">
        {qrHtml ? <Fragment set:html={qrHtml} /> : <p class="idc__noqr">Verification code unavailable</p>}
      </div>
      <p class="idc__serial idc__serial--back">{serial}</p>
      <p class="idc__valid">
        {validFrom ? 'Valid ' + shortDate(validFrom) + ' to ' + shortDate(validUntil) : 'Valid until ' + shortDate(validUntil)}
      </p>
      <div class="idc__rule" aria-hidden="true"></div>
      <p class="idc__small">
        This card is the property of EduRankAI and must be returned when the holder leaves.
        If found, please return it to EduRankAI, Guwahati, Assam, India, or write to hr@edurankai.in.
      </p>
      <p class="idc__small idc__small--strong">Checked at edurankai.in/verify/id with a signed code. A photocopy of this card proves nothing.</p>
      <div class="idc__sig">
        <div class="idc__sigline" aria-hidden="true"></div>
        <p class="idc__k">Issuing authority, EduRankAI</p>
      </div>
      <p class="idc__micro" aria-hidden="true">{microText}</p>
    </div>
  )}
</div>

<style>
  .idc {
    --ink: #0E0B08; --saffron: #FF4F00; --gold: #B8892D; --paper: #FFFDF8; --muted: #6B635C;
    width: var(--idc-w, 300px);
    aspect-ratio: 54 / 85.6;
    container-type: inline-size;
    border-radius: 4.5cqw;
    overflow: hidden;
    position: relative;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 rgba(255,255,255,0.5) inset, 0 18px 40px -14px rgba(14,11,8,0.45), 0 2px 6px rgba(14,11,8,0.18);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .idc__face { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; }
  .idc__band { position: relative; width: 100%; height: 30%; background: var(--ink); overflow: hidden; }
  .idc__guilloche {
    position: absolute; inset: -20%;
    background:
      repeating-radial-gradient(circle at 18% 120%, rgba(255,79,0,0.0) 0 1.6cqw, rgba(255,79,0,0.22) 1.6cqw 1.9cqw),
      repeating-radial-gradient(circle at 92% -30%, rgba(184,137,45,0.0) 0 2.1cqw, rgba(184,137,45,0.2) 2.1cqw 2.35cqw);
  }
  .idc__brand { position: relative; display: flex; align-items: center; gap: 3cqw; padding: 6cqw 6cqw 0; }
  .idc__logo { width: 11cqw; height: 11cqw; border-radius: 2.4cqw; display: block; }
  .idc__logo--sm { width: 7.5cqw; height: 7.5cqw; border-radius: 1.6cqw; }
  .idc__word { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-weight: 700; font-size: 7.2cqw; color: #fff; letter-spacing: -0.01em; line-height: 1; }
  .idc__word span { color: var(--saffron); }
  .idc__word--sm { color: var(--ink); font-size: 5.4cqw; }
  .idc__tag { margin: 1.2cqw 0 0; font-size: 2.5cqw; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.7); font-weight: 700; }
  .idc__accent { width: 100%; height: 1.6cqw; background: linear-gradient(90deg, var(--saffron), #ff8a4c 55%, var(--gold)); }

  .idc__photo {
    margin-top: -15cqw; width: 40cqw; height: 46cqw; border-radius: 4cqw; overflow: hidden;
    border: 1.4cqw solid var(--paper); background: #EDE4D3; position: relative; z-index: 2;
    box-shadow: 0 2cqw 5cqw -2cqw rgba(14,11,8,0.4);
    display: flex; align-items: center; justify-content: center;
  }
  .idc__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .idc__initials { font-family: Georgia, serif; font-size: 15cqw; font-weight: 700; color: var(--gold); }

  .idc__who { text-align: center; padding: 3.5cqw 6cqw 0; }
  .idc__name { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 7.6cqw; font-weight: 700; line-height: 1.12; }
  .idc__role { margin: 1.4cqw 0 0; font-size: 3.9cqw; color: var(--muted); line-height: 1.3; }
  .idc__kind {
    display: inline-block; margin: 2.4cqw 0 0; padding: 1cqw 3.4cqw; border-radius: 100px;
    background: var(--saffron); color: #fff; font-size: 2.7cqw; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 800;
  }
  .idc__facts { display: flex; gap: 4cqw; justify-content: center; margin-top: 4cqw; width: 100%; padding: 0 6cqw; box-sizing: border-box; }
  .idc__facts > div { flex: 1; text-align: center; border-top: 0.3cqw solid #E7DCC8; padding-top: 2cqw; }
  .idc__k { margin: 0; font-size: 2.4cqw; letter-spacing: 0.16em; text-transform: uppercase; color: #9a9188; font-weight: 700; }
  .idc__v { margin: 0.8cqw 0 0; font-size: 3.7cqw; font-weight: 700; font-family: Consolas, Menlo, monospace; }

  .idc__foot { margin-top: auto; width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 6cqw 4.6cqw; box-sizing: border-box; }
  .idc__foil {
    width: 10cqw; height: 10cqw; border-radius: 2cqw; color: rgba(14,11,8,0.55); display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #d9c48f, #f6ecd0 35%, #c9a95a 55%, #f3e3b6 75%, #b8892d);
    background-size: 200% 200%; animation: idc-foil 6s ease-in-out infinite;
  }
  .idc__foil svg { width: 6.4cqw; height: 6.4cqw; }
  @keyframes idc-foil { 0%, 100% { background-position: 0% 0%; } 50% { background-position: 100% 100%; } }
  @media (prefers-reduced-motion: reduce) { .idc__foil { animation: none; } }
  .idc__serial { margin: 0; font-family: Consolas, Menlo, monospace; font-size: 3.2cqw; font-weight: 700; letter-spacing: 0.06em; color: var(--ink); }
  .idc__micro {
    position: absolute; left: 0; right: 0; bottom: 1.2cqw; margin: 0; white-space: nowrap; overflow: hidden;
    font-size: 1.15cqw; letter-spacing: 0.08em; color: rgba(184,137,45,0.75); font-family: Consolas, Menlo, monospace; text-align: center;
  }

  .idc__face--back { padding: 0 7cqw; box-sizing: border-box; }
  .idc__bandsm { display: flex; align-items: center; gap: 2cqw; margin-top: 6cqw; }
  .idc__scan { margin: 4.5cqw 0 0; font-size: 2.8cqw; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); font-weight: 800; }
  .idc__qr {
    margin-top: 2.6cqw; width: 62cqw; height: 62cqw; padding: 2.6cqw; background: #fff; border-radius: 3cqw;
    border: 0.4cqw solid #E7DCC8; box-sizing: border-box; display: flex; align-items: center; justify-content: center;
  }
  .idc__qr :global(svg) { width: 100%; height: 100%; display: block; }
  .idc__noqr { font-size: 3cqw; color: var(--muted); text-align: center; margin: 0; }
  .idc__serial--back { margin-top: 3cqw; font-size: 4cqw; }
  .idc__valid { margin: 1.2cqw 0 0; font-size: 3cqw; color: var(--muted); }
  .idc__rule { width: 14cqw; height: 0.6cqw; background: var(--saffron); margin: 3.4cqw 0 2.4cqw; border-radius: 1cqw; }
  .idc__small { margin: 0 0 1.6cqw; font-size: 2.55cqw; line-height: 1.45; color: var(--muted); text-align: center; }
  .idc__small--strong { color: var(--ink); font-weight: 600; }
  .idc__sig { margin-top: auto; margin-bottom: 5cqw; width: 60%; text-align: center; }
  .idc__sigline { height: 0.3cqw; background: var(--ink); margin-bottom: 1.2cqw; opacity: 0.7; }

  @media print {
    .idc { --idc-w: 54mm; box-shadow: none; border: 0.2mm solid #d8cfbf; break-inside: avoid; }
    .idc__foil { animation: none; }
  }
</style>
