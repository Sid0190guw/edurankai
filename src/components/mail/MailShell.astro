---
/**
 * src/components/mail/MailShell.astro — the frame every /mail screen sits in.
 *
 * WHY THIS IS A COMPONENT AND NOT A LAYOUT IN src/layouts/. CLAUDE.md forbids editing src/layouts/
 * without explicit approval, and adding a file to that directory is a change to it. An Astro layout
 * is a component with a <slot/>, so nothing is lost: MailShell IS the layout, it just lives where
 * this product's own code lives.
 *
 * IT AUTHORISES BEFORE IT RENDERS. canUseMailbox() is asked in the frontmatter and a refusal returns
 * a full page rather than a redirect — a redirect out of a mail app loses whatever the person was
 * doing and tells them nothing. This is the same gate the three write endpoints use
 * (src/lib/auth/mail-access.ts), so what you can open and what you can do cannot disagree.
 *
 * ONE IMPLEMENTATION, NARROWED. The rail is a drawer under 1080px and a column above it — there is
 * no second mobile build to keep in step. The scrim, the burger and the Escape handler are all in
 * this file, so every screen gets them by existing.
 */
import '@/styles/mail-product.css';
import MailIcon from './MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getMailboxAddress } from '@/lib/mail';
import { initials } from '@/lib/mail-product/common';

interface Props {
  title: string;
  /** Nav id to mark as the current page. */
  active?: string;
  /** Small grey line under the page title in the topbar. */
  subtitle?: string;
  /** `flush` removes page padding — used by the mailbox and the builder, which own their whole area. */
  flush?: boolean;
  /** Unread counts keyed by folder, from getFolderCounts(). */
  counts?: Record<string, number>;
  /** [{label, href}] — rendered before the h1. */
  crumbs?: { label: string; href?: string }[];
}

const { title, active = '', subtitle = '', flush = false, counts = {}, crumbs = [] } = Astro.props as Props;
const user = Astro.locals.user;

// THE GATE, BEFORE ANY QUERY. A page that fetched its data and then refused has already run the read.
const access = await canUseMailbox(user as any);

let address = '';
if (access.allowed) {
  // A mailbox address is not worth a 500. The rail shows the login email if this cannot be resolved.
  address = await getMailboxAddress(user!.id).catch(() => String(user?.email || ''));
}

type Item = { id: string; label: string; href: string; icon: string; count?: number };
type Group = { title: string; items: Item[] };

const NAV: Group[] = [
  {
    title: 'Mailbox',
    items: [
      { id: 'dashboard', label: 'Dashboard', href: '/mail', icon: 'dashboard' },
      { id: 'inbox', label: 'Inbox', href: '/mail/box/inbox', icon: 'inbox', count: counts.inbox || 0 },
      { id: 'starred', label: 'Starred', href: '/mail/box/starred', icon: 'star' },
      { id: 'sent', label: 'Sent', href: '/mail/box/sent', icon: 'sent' },
      { id: 'drafts', label: 'Drafts', href: '/mail/box/drafts', icon: 'draft', count: counts.drafts_total || 0 },
      { id: 'archive', label: 'Archive', href: '/mail/box/archive', icon: 'archive' },
      { id: 'spam', label: 'Spam', href: '/mail/box/spam', icon: 'spam', count: counts.spam || 0 },
      { id: 'trash', label: 'Trash', href: '/mail/box/trash', icon: 'trash' },
    ],
  },
  {
    title: 'Audience',
    items: [
      { id: 'contacts', label: 'Contacts', href: '/mail/contacts', icon: 'contacts' },
      { id: 'lists', label: 'Lists & segments', href: '/mail/contacts/lists', icon: 'list' },
    ],
  },
  {
    title: 'Sending',
    items: [
      { id: 'campaigns', label: 'Campaigns', href: '/mail/campaigns', icon: 'campaigns' },
      { id: 'templates', label: 'Templates', href: '/mail/templates', icon: 'templates' },
      { id: 'automations', label: 'Automations', href: '/mail/automations', icon: 'automations' },
      { id: 'analytics', label: 'Analytics', href: '/mail/analytics', icon: 'analytics' },
    ],
  },
  {
    title: 'Infrastructure',
    items: [
      { id: 'domains', label: 'Domains', href: '/mail/domains', icon: 'domains' },
      { id: 'mailboxes', label: 'Mailboxes', href: '/mail/mailboxes', icon: 'mailboxes' },
      { id: 'api', label: 'API & webhooks', href: '/mail/api', icon: 'api' },
      { id: 'settings', label: 'Settings', href: '/mail/settings', icon: 'settings' },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · EduRankAI Mail</title>
</head>
<body class="em">

{!access.allowed && (
  <main class="em-page" style="max-width:560px;margin:12vh auto">
    <div class="em-card">
      <div class="em-card-body" style="text-align:center">
        <MailIcon name="mail" size={40} class="em-lock-icon" />
        <h1 class="em-h1" style="margin-top:16px">{access.denial?.title || 'This mailbox is not open to you'}</h1>
        <p class="em-lede">{access.denial?.reason || 'Ask an administrator if you should have a company mailbox.'}</p>
        <p style="margin-top:24px">
          <a class="em-btn" href="/portal">Back to the portal</a>
        </p>
      </div>
    </div>
  </main>
)}

{access.allowed && (
  <div class="em-shell" id="emShell">
    <a class="em-skip" href="#emMain">Skip to main content</a>

    <nav class="em-rail" id="emRail" aria-label="EduRankAI Mail">
      <a class="em-brand" href="/mail">
        <span class="em-brand-mark"><MailIcon name="mail" size={17} strokeWidth={2} /></span>
        <span>
          <span class="em-brand-name">EduRankAI Mail</span>
          <span class="em-brand-sub">Sending platform</span>
        </span>
      </a>

      <div class="em-compose">
        <button type="button" class="em-btn pri wide" data-compose>
          <MailIcon name="edit" size={15} />
          Compose
        </button>
      </div>

      <div class="em-nav">
        {NAV.map((group) => (
          <div class="em-nav-group">
            <p class="em-nav-title">{group.title}</p>
            {group.items.map((item) => (
              <a
                href={item.href}
                class="em-nav-item"
                aria-current={active === item.id ? 'page' : undefined}
              >
                <MailIcon name={item.icon} size={16} />
                <span>{item.label}</span>
                {!!item.count && item.count > 0 && (
                  <span class={'em-nav-count' + (item.id === 'inbox' ? ' on' : '')}>{item.count > 999 ? '999+' : item.count}</span>
                )}
              </a>
            ))}
          </div>
        ))}
      </div>

      <div class="em-rail-foot">
        <div class="em-who">
          <span class="em-avatar sm" aria-hidden="true">{initials(user?.name, user?.email)}</span>
          <span style="min-width:0">
            <span class="em-who-name">{user?.name || 'Signed in'}</span>
            <span class="em-who-addr" title={address}>{address}</span>
          </span>
        </div>
      </div>
    </nav>

    <div class="em-scrim" data-close-nav aria-hidden="true"></div>

    <div class="em-main">
      <header class="em-top">
        <button type="button" class="em-btn ghost icon em-burger" data-open-nav aria-label="Open navigation" aria-controls="emRail" aria-expanded="false">
          <MailIcon name="menu" size={18} />
        </button>
        <div style="min-width:0">
          <h1>{title}</h1>
          {subtitle && <p class="em-top-sub">{subtitle}</p>}
        </div>
        <div class="em-top-actions">
          <slot name="actions" />
        </div>
      </header>

      <main class={'em-page' + (flush ? ' flush' : '')} id="emMain" tabindex="-1">
        {crumbs.length > 0 && (
          <nav class="em-crumbs" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <Fragment>
                {i > 0 && <MailIcon name="chevronRight" size={12} />}
                {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
              </Fragment>
            ))}
          </nav>
        )}
        <slot />
      </main>
    </div>
  </div>
)}

<div class="em-toasts" id="emToasts" role="status" aria-live="polite" aria-atomic="false"></div>

<script src="/mail/app.js" is:inline defer></script>
<style>
  .em-lock-icon { color: var(--em-ink-4); }
</style>
</body>
</html>
