---
/**
 * src/components/mail/Chart.astro — the product's only chart.
 *
 * SERVER-RENDERED INLINE SVG, NO CHART LIBRARY. The data is already aggregated in Postgres (tens of
 * points, never thousands), so drawing it costs a few hundred bytes of markup and zero client
 * JavaScript. A charting library here would be ~90 KB to draw six lines that do not move.
 *
 * IT IS READABLE WITHOUT THE PICTURE. The <svg> carries role="img" and a summary label, and the same
 * numbers are emitted as a real <table> in a visually-hidden block underneath — so a screen reader
 * gets the values rather than "graphic", and so does anybody printing the page.
 *
 * COLOUR IS NOT THE ONLY CHANNEL. Series are distinguished by colour AND by their position in the
 * legend AND by a dash pattern after the second one, because a reader with a colour vision
 * deficiency should not have to guess which line is bounces.
 */
interface Series { key: string; label: string; colour?: string; }
interface Props {
  /** [{ day: '2026-08-01', sent: 10, opened: 4, ... }] */
  rows: Record<string, any>[];
  series: Series[];
  /** Field holding the x label. */
  xKey?: string;
  height?: number;
  kind?: 'line' | 'bar';
  /** Sentence used as the accessible name. Say what the chart shows, not "chart". */
  summary: string;
}

const { rows = [], series = [], xKey = 'day', height = 210, kind = 'line', summary } = Astro.props as Props;

const RAMP = ['var(--em-c1)', 'var(--em-c2)', 'var(--em-c3)', 'var(--em-c4)', 'var(--em-c5)', 'var(--em-c6)'];
const DASH = ['', '', '5 3', '2 3', '8 3 2 3', '4 2'];

const W = 720;
const H = height;
const PAD = { t: 12, r: 14, b: 26, l: 40 };
const iw = W - PAD.l - PAD.r;
const ih = H - PAD.t - PAD.b;

const n = rows.length;
const values = rows.flatMap((r) => series.map((s) => Number(r[s.key]) || 0));
const rawMax = values.length ? Math.max(...values) : 0;

/** A round number above the data. An axis that ends at 4,731 reads as noise. */
function niceMax(v: number): number {
  if (v <= 0) return 4;
  const mag = Math.pow(10, Math.floor(Math.log10(v)));
  for (const step of [1, 1.5, 2, 2.5, 3, 4, 5, 7.5, 10]) {
    if (v <= step * mag) return step * mag;
  }
  return 10 * mag;
}
const max = niceMax(rawMax);

const x = (i: number) => PAD.l + (n <= 1 ? iw / 2 : (i / (n - 1)) * iw);
const y = (v: number) => PAD.t + ih - (max ? (v / max) * ih : 0);

const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => ({ v: max * f, y: y(max * f) }));

function shortNum(v: number): string {
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(v % 1_000_000 ? 1 : 0) + 'M';
  if (v >= 1000) return (v / 1000).toFixed(v % 1000 ? 1 : 0) + 'k';
  return String(Math.round(v));
}

function shortDay(v: unknown): string {
  const d = new Date(String(v));
  if (Number.isNaN(d.getTime())) return String(v ?? '');
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
}

const paths = series.map((s, si) => {
  const pts = rows.map((r, i) => `${x(i).toFixed(1)},${y(Number(r[s.key]) || 0).toFixed(1)}`);
  return { ...s, colour: s.colour || RAMP[si % RAMP.length], dash: DASH[si % DASH.length], d: pts.length ? 'M' + pts.join(' L') : '' };
});

// Only ~6 x labels, whatever the range: a 90-day chart with 90 labels is an unreadable smear.
const labelEvery = Math.max(1, Math.ceil(n / 6));
const barW = n > 0 ? Math.max(2, Math.min(28, (iw / n) * 0.62)) : 0;
const empty = rawMax === 0;
// HOISTED OUT OF THE MARKUP. `n <= 32` inside a JSX expression is read by the .astro compiler as the
// start of a tag, and the build fails with "Unable to assign attributes when using <> Fragment
// shorthand syntax" pointing at a line that looks perfectly fine. Same family as the
// no-arrow-characters-in-JSX rule in CLAUDE.md: comparison operators belong in the frontmatter.
const showDots = n <= 32;
---
<figure class="emc-chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary} preserveAspectRatio="none" class="emc-svg">
    {ticks.map((t) => (
      <Fragment>
        <line x1={PAD.l} x2={W - PAD.r} y1={t.y} y2={t.y} class="emc-grid" />
        <text x={PAD.l - 8} y={t.y + 3.5} class="emc-axis" text-anchor="end">{shortNum(t.v)}</text>
      </Fragment>
    ))}

    {rows.map((r, i) => (i % labelEvery === 0 || i === n - 1) && (
      <text x={x(i)} y={H - 8} class="emc-axis" text-anchor="middle">{shortDay(r[xKey])}</text>
    ))}

    {!empty && kind === 'bar' && series.map((s, si) => rows.map((r, i) => {
      const v = Number(r[s.key]) || 0;
      const groupW = barW / series.length;
      return v > 0 ? (
        <rect
          x={x(i) - barW / 2 + si * groupW} y={y(v)}
          width={Math.max(1.5, groupW - 1)} height={Math.max(1, PAD.t + ih - y(v))}
          rx="1.5" fill={s.colour || RAMP[si % RAMP.length]}
        />
      ) : null;
    }))}

    {!empty && kind === 'line' && paths.map((p) => (
      <path d={p.d} fill="none" stroke={p.colour} stroke-width="2" stroke-dasharray={p.dash}
            stroke-linejoin="round" stroke-linecap="round" />
    ))}
    {/* Dots only when the series is short enough for them to be points rather than a rope. */}
    {!empty && kind === 'line' && showDots && paths.map((p) => rows.map((r, i) => (
      <circle cx={x(i)} cy={y(Number(r[p.key]) || 0)} r="2.4" fill="var(--em-surface)" stroke={p.colour} stroke-width="1.6" />
    )))}

    {empty && (
      <text x={W / 2} y={PAD.t + ih / 2} class="emc-none" text-anchor="middle">Nothing recorded in this period</text>
    )}
  </svg>

  <figcaption class="emc-legend">
    {series.map((s, si) => (
      <span class="emc-key">
        <span class="emc-swatch" style={`background:${s.colour || RAMP[si % RAMP.length]}`} aria-hidden="true"></span>
        {s.label}
      </span>
    ))}
  </figcaption>

  {/* The same numbers, for a screen reader and for print. Not a duplicate — the only readable form. */}
  <div class="em-sr">
    <table>
      <caption>{summary}</caption>
      <thead><tr><th scope="col">Date</th>{series.map((s) => <th scope="col">{s.label}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{shortDay(r[xKey])}</th>
            {series.map((s) => <td>{Number(r[s.key]) || 0}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>

<style>
  .emc-chart { margin: 0; }
  .emc-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .emc-grid { stroke: var(--em-line); stroke-width: 1; }
  .emc-axis { font-size: 10.5px; fill: var(--em-ink-4); font-family: var(--em-font); font-variant-numeric: tabular-nums; }
  .emc-none { font-size: 12.5px; fill: var(--em-ink-4); font-family: var(--em-font); }
  .emc-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; }
  .emc-key { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--em-ink-3); font-weight: 560; }
  .emc-swatch { width: 10px; height: 3px; border-radius: 2px; }
  /* Visually hidden but present for assistive tech — never display:none, which removes it entirely. */
  .em-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media print { .em-sr { position: static; width: auto; height: auto; clip: auto; clip-path: none; } }
</style>
