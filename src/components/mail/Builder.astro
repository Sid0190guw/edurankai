---
/**
 * src/components/mail/Builder.astro — the email builder's markup.
 *
 * ONE BUILDER, TWO OWNERS. /mail/templates/[id] and /mail/campaigns/[id]/design both mount this
 * component and differ only in `saveUrl` and the payload key — so a fix to the builder is a fix to
 * both, and a template and a campaign cannot end up with two different editors.
 *
 * THE CANVAS SHOWS SERVER-RENDERED HTML. Every change posts the document to
 * /api/mail/product/templates (action 'render') and puts the answer on the canvas. That is a round
 * trip per edit, debounced — and it is worth it, because it makes the canvas, the desktop preview,
 * the mobile preview, the HTML tab and the bytes that are sent all the SAME renderer. A local
 * approximation would be faster and would be a preview of something that does not exist.
 */
import MailIcon from './MailIcon.astro';
import { FONT_STACKS } from '@/lib/mail-product/blocks';
import { MERGE_VARIABLES } from '@/lib/mail-product/personalize';

import { jsonIsland } from '@/lib/mailsec/island';
interface Props {
  /** 'template' | 'campaign' — decides which endpoint the save goes to. */
  owner: 'template' | 'campaign';
  ownerId: string;
  doc: unknown;
  subject?: string;
  preheader?: string;
}
const { owner, ownerId, doc, subject = '', preheader = '' } = Astro.props as Props;

const BLOCKS: { kind: string; label: string; icon: string }[] = [
  { kind: 'heading', label: 'Heading', icon: 'heading' },
  { kind: 'text', label: 'Text', icon: 'text' },
  { kind: 'image', label: 'Image', icon: 'image' },
  { kind: 'button', label: 'Button', icon: 'button' },
  { kind: 'divider', label: 'Divider', icon: 'divider' },
  { kind: 'spacer', label: 'Spacer', icon: 'spacer' },
  { kind: 'columns', label: 'Columns', icon: 'columns' },
  { kind: 'social', label: 'Social', icon: 'social' },
  { kind: 'quote', label: 'Quote', icon: 'quote' },
  { kind: 'html', label: 'HTML', icon: 'code' },
  { kind: 'footer', label: 'Footer', icon: 'text' },
  { kind: 'signature', label: 'Signature', icon: 'signature' },
];
---
<div class="bd" id="bdRoot" data-owner={owner} data-owner-id={ownerId}>

  <!-- Palette ------------------------------------------------------------------------------- -->
  <aside class="bd-palette" id="bdPalette" aria-label="Blocks">
    <h3>Blocks</h3>
    <div class="bd-blocks">
      {BLOCKS.map((b) => (
        <button type="button" class="bd-block" draggable="true" data-bd-add={b.kind}>
          <MailIcon name={b.icon} size={18} strokeWidth={1.6} />
          {b.label}
        </button>
      ))}
    </div>
    <p class="em-hint" style="margin-top:16px">
      Drag onto the canvas, or press to append. Blocks can be reordered by dragging their handle.
    </p>

    <h3 style="margin-top:24px">Message</h3>
    <label class="em-field">
      <span class="em-label">Subject</span>
      <input class="em-input" id="bdSubject" value={subject} maxlength="300" />
    </label>
    <label class="em-field">
      <span class="em-label">Preview text</span>
      <input class="em-input" id="bdPreheader" value={preheader} maxlength="200" />
      <span class="em-hint">The grey line beside the subject in the inbox.</span>
    </label>
  </aside>

  <!-- Canvas -------------------------------------------------------------------------------- -->
  <div class="bd-canvas-wrap">
    <div class="bd-devices" role="group" aria-label="Preview size">
      <div class="em-seg">
        <button type="button" data-bd-device="desktop" aria-pressed="true">
          <MailIcon name="desktop" size={13} /> Desktop
        </button>
        <button type="button" data-bd-device="mobile" aria-pressed="false">
          <MailIcon name="mobile" size={13} /> Mobile
        </button>
        <button type="button" data-bd-device="html" aria-pressed="false">
          <MailIcon name="code" size={13} /> HTML
        </button>
      </div>
      <div class="bd-mobile-tabs">
        <button type="button" class="em-btn sm" data-bd-toggle="palette">Blocks</button>
        <button type="button" class="em-btn sm" data-bd-toggle="inspect">Properties</button>
      </div>
    </div>

    <div class="bd-frame" id="bdFrame" data-device="desktop">
      <div class="bd-doc" id="bdDoc" aria-label="Email canvas">
        <div class="bd-empty">
          <span class="em-spin"></span>
          <p class="em-note" style="margin-top:10px">Rendering…</p>
        </div>
      </div>
      <pre class="bd-html" id="bdHtml" hidden aria-label="Generated HTML"></pre>
    </div>
  </div>

  <!-- Inspector ------------------------------------------------------------------------------ -->
  <aside class="bd-inspect" id="bdInspect" aria-label="Properties">
    <div id="bdInspectBody">
      <h3>Email settings</h3>
      <p class="em-note">Select a block to edit it, or set the page defaults here.</p>
    </div>
  </aside>
</div>

<script type="application/json" id="bdDocSeed" set:html={jsonIsland(doc)}></script>
<script type="application/json" id="bdMeta" set:html={jsonIsland({
  fonts: FONT_STACKS,
  variables: MERGE_VARIABLES,
  blocks: BLOCKS,
})}></script>
<script src="/mail/builder.js" is:inline defer></script>
