---
/**
 * src/components/mail/MailIcon.astro — the product's whole icon set, in one file.
 *
 * INLINE MONOCHROME SVG, NEVER EMOJI. That is a house rule (CLAUDE.md) and it is also the only thing
 * that works: an emoji renders as a different picture on every platform, cannot take currentColor,
 * and is announced by a screen reader as its unicode name in the middle of a sentence.
 *
 * DECORATIVE BY DEFAULT. Every icon here sits beside a text label, so it carries aria-hidden and is
 * skipped by assistive tech. Pass `title` ONLY when the icon is the sole content of a control — that
 * swaps it to role="img" with an accessible name. An icon-only button with neither is a button a
 * screen-reader user hears as "button".
 *
 * One path set, one stroke weight, one 24-grid. Mixed icon families are the fastest way to make a
 * product look assembled rather than designed.
 */
interface Props {
  name: string;
  size?: number;
  /** Accessible name. Omit for decorative icons that sit next to a visible label. */
  title?: string;
  class?: string;
  strokeWidth?: number;
  fill?: boolean;
}

const { name, size = 16, title, class: cls = '', strokeWidth = 1.8, fill = false } = Astro.props as Props;

