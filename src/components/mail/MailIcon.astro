const d = P[name] || P.info;
// Cast: the two shapes are a union and SVGAttributes will not accept a spread of one. The values are
// literal strings written above, so nothing unchecked reaches the element.
const a11y = (title
  ? { role: 'img', 'aria-label': title }
  : { 'aria-hidden': 'true', focusable: 'false' }) as Record<string, string>;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  {...a11y}
  set:html={(title ? `<title>${title}</title>` : '') + d}
/>
