---
// Retired hiring-homepage section. No page imports this component any more, and
// BHARAT was dropped from src/data/home.ts in the homepage redesign, so the copy
// is restored here verbatim from that file at commit d18b843. Archived: the stat
// counts below are from the original design and are now out of date, so review
// them before any page renders this again.
type BharatStat = { value: string; label: string };

type BharatCopy = {
  eyebrow: string;
  title: string;
  body: string;
  stats: readonly BharatStat[];
};

const BHARAT: BharatCopy = {
  eyebrow: 'Building for Bharat. Building for the World.',
  title: 'Rooted in <em>Bharat.</em><br/>Built for everyone.',
  body: 'EduRankAI is born in India and built for the world. We hire globally, ship in multiple languages, design for learners in any geography, and incubate ventures that solve problems in education, human connection, travel, and business. India is our home. The world is our scope.',
  stats: [
    { value: '6', label: 'Ventures in the ecosystem' },
    { value: '12+', label: 'Languages planned for launch' },
    { value: '5', label: 'Dimensions of human development' },
    { value: 'inf', label: 'Belief in human potential' }
  ]
};
---
<section class="px-[5vw] py-20 md:py-28 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">{BHARAT.eyebrow}</p>
      <h2 class="section-title mb-5" set:html={BHARAT.title} />
      <p class="text-[0.95rem] text-ink-soft font-light leading-[1.85]">{BHARAT.body}</p>
    </div>
    <div class="grid grid-cols-2 gap-3">
      {BHARAT.stats.map((s) => (
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-6">
          <div class="font-display text-[2.2rem] font-bold text-burn leading-none mb-2">{s.value}</div>
          <p class="text-[0.72rem] text-ink-soft font-medium uppercase tracking-wider">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
