---
// Retired hiring-homepage section. No page imports this component any more — the
// current src/pages/index.astro carries its own five-dimension block — and
// DIMENSIONS was dropped from src/data/home.ts in the homepage redesign, so the
// rows are restored here verbatim from that file at commit d18b843.
// `color` is a union of exactly the keys of colorMap below, which is what makes
// the lookup in the template safe.
type DimensionColor = 'burn' | 'sky' | 'plum' | 'teal' | 'gold';

type Dimension = { icon: string; title: string; desc: string; color: DimensionColor };

const DIMENSIONS: readonly Dimension[] = [
  { icon: 'body', title: 'Physical', desc: 'Active health, energy, stamina, body awareness.', color: 'burn' },
  { icon: 'brain', title: 'Mental', desc: 'Clarity, focus, resilience, learning capacity.', color: 'sky' },
  { icon: 'heart', title: 'Emotional', desc: 'Self-awareness, empathy, feedback, regulation.', color: 'plum' },
  { icon: 'hand', title: 'Social', desc: 'Collaboration, communication, team trust.', color: 'teal' },
  { icon: 'spark', title: 'Spiritual', desc: 'Purpose, values, meaning beyond the task.', color: 'gold' }
];

const colorMap = {
  burn: 'bg-burn-pale border-burn-dim text-burn',
  sky: 'bg-sky-bg border-sky-border text-sky',
  plum: 'bg-plum-bg border-plum-border text-plum',
  teal: 'bg-teal-bg border-teal-border text-teal',
  gold: 'bg-gold-bg border-gold-border text-gold-deep'
};
---
<section class="bg-cream-2 px-[5vw] py-20 md:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mb-12">
      <p class="eyebrow mb-3">The Standard</p>
      <h2 class="section-title mb-4">We see the <em>whole person.</em></h2>
      <p class="text-[0.9rem] text-ink-soft font-light leading-[1.8]">At hiring. And every day after. We evaluate every team member across five dimensions of human wholeness - because the product we are building serves the same dimensions in learners worldwide.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      {DIMENSIONS.map((d) => (
        <div class="bg-white border border-ink/10 rounded-xl p-5 text-center transition-all hover:-translate-y-1 hover:shadow-lg">
          <div class={`w-12 h-12 rounded-full border flex items-center justify-center text-xl mx-auto mb-3 ${colorMap[d.color]}`}>*</div>
          <div class="font-display text-[1.05rem] font-bold text-ink mb-1.5">{d.title}</div>
          <p class="text-[0.72rem] text-ink-soft leading-relaxed">{d.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
