---
/**
 * QuickActions — "what can I do right now", rendered from composeWorkspace().quickActions.
 *
 * IT HAS NO LIST OF ITS OWN, and that is the entire point. Every item arrives already filtered:
 * each one is the `quickAction` declared on a widget that passed every permission, section,
 * audience and gate check the composer applies. So an action can never be offered to somebody the
 * composer did not admit to the widget behind it.
 *
 * That is not a theoretical improvement. src/pages/portal/index.astro:416 (QUICK_ACCESS) and
 * src/components/workforce/BottomNav.astro:115 (SETS) are both static arrays with no capability
 * test at all — every tab renders for everyone, whatever was resolved. This component exists so
 * there is not a third one.
 *
 * NO EMOJI. Each glyph is an inline monochrome SVG with a distinct SHAPE, so the row reads in
 * greyscale, in forced-colors mode, and for anyone who cannot rely on colour.
 */
import type { QuickAction } from '@/lib/workforce/composer';

export interface Props {
  actions: readonly QuickAction[];
  /** How many to show. Past about eight, a "quick" row stops being quick and becomes a menu. */
  max?: number;
  label?: string;
  class?: string;
}

const { actions = [], max = 8, label = 'Quick actions', class: cls = '' } = Astro.props;
const shown = (actions || []).slice(0, Math.max(1, max));

// The glyph table. Keyed by QuickActionIcon; the registry's validateRegistry() refuses any icon
// name that is not in QUICK_ACTION_ICONS, so an unknown key here means the two lists have drifted —
// which renders an empty mark rather than breaking the row.
const GLYPHS = {
  clock: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>',
  note: '<path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5Z"/><path d="M14 3.5v5h5"/><path d="M8.8 14.2h6.4"/>',
  timer: '<path d="M9 2.6h6"/><path d="M12 6.2v5.6l3.4 2"/><circle cx="12" cy="13.4" r="8"/>',
  check: '<path d="M4 12.6 8.6 17.2 20 5.8"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10.2h17M8.5 3v4M15.5 3v4"/>',
  stamp: '<path d="M9 3.5h6a2.5 2.5 0 0 1 2.5 2.5c0 2.4-2.5 3-2.5 5h-6c0-2-2.5-2.6-2.5-5A2.5 2.5 0 0 1 9 3.5Z"/><rect x="3.5" y="14" width="17" height="6.5" rx="1.8"/>',
  wallet: '<path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/>',
  people: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  doc: '<path d="M13.5 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9Z"/><path d="M13.5 3.5V9H19"/>',
  person: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
};
const glyphOf = (icon: string): string => (GLYPHS as any)[icon] || '';
---
{shown.length > 0 && (
  <nav class={`qa ${cls}`} aria-label={label}>
    <ul class="qa__list">
      {shown.map((a) => (
        <li class="qa__item">
          <a class="qa__link wf-focusable" href={a.href} data-widget={a.key}>
            <span class="qa__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={glyphOf(a.icon)} />
            </span>
            <span class="qa__label">{a.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .qa { margin: 0 14px 12px; }
  .qa__list {
    display: grid;
    /* MOBILE FIRST, AND MEASURED: at 360px the viewport minus two 14px margins is 332px, which fits
       two 160px tiles with an 8px gap. Three would be 105px each — not enough for "Write today's
       report" without a hyphen break, and a label that wraps to three lines is not a quick action.
       auto-fit widens it to three and then four on anything larger, with no breakpoint to maintain. */
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--wf-s-2, 8px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .qa__item { margin: 0; }
  .qa__link {
    display: flex;
    align-items: center;
    gap: 9px;
    /* The whole tile is the target, and the touch floor is a MIN so a wrapped label still grows it. */
    min-height: var(--wf-touch, 44px);
    height: 100%;
    padding: 10px 11px;
    background: var(--wf-surface, #fff);
    border: 1px solid var(--wf-line, #e5e7eb);
    border-radius: var(--wf-r-md, 12px);
    box-shadow: var(--wf-shadow-1, none);
    text-decoration: none;
    transition: var(--wf-tr-feedback, none);
  }
  .qa__link:active { transform: scale(var(--wf-press, 1)); }
  .qa__mark {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--wf-r-sm, 8px);
    background: var(--wf-veil, #f6f5f3);
    border: 1px solid var(--wf-line, #e5e7eb);
    color: var(--wf-ink-2, #564e43);
  }
  .qa__mark svg { width: 15px; height: 15px; display: block; }
  .qa__label {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    font-weight: 650;
    line-height: 1.3;
    color: var(--wf-ink, #111);
    overflow-wrap: anywhere;
  }

  @media (forced-colors: active) {
    .qa__link, .qa__mark { border-color: CanvasText; }
  }
</style>
