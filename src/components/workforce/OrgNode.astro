---
/**
 * Workforce / OrgNode — one person in the organization tree, and everyone under them.
 *
 * THIS COMPONENT RENDERS. IT DECIDES NOTHING. Every node handed to it was already fetched under the
 * viewer's scope predicate in src/lib/org-chart.ts, so there is no branch here that could hide a
 * person from a tree they should not have been sent — because a person they should not see was never
 * fetched, never serialised and is not in this document at all.
 *
 * WHY IT RECURSES INTO ITSELF. An org tree has no fixed depth, and a flat list with a padding-left
 * multiplier cannot express containment to a screen reader or to a disclosure control. Astro renders
 * a self-import server-side, so the whole tree is HTML before it reaches the phone; the recursion
 * costs nothing at runtime and the depth is already capped at MAX_TREE_DEPTH by the query.
 *
 * EXPAND AND COLLAPSE WITH NO JAVASCRIPT. A node with reports is a <details>; its row is the
 * <summary>. That gives a real disclosure widget, keyboard operable, announced correctly, working
 * before hydration and on the offline shell. The page adds an Expand-all button on top of it as
 * progressive enhancement, and that button is hidden until a script un-hides it, so nothing dead is
 * ever rendered.
 *
 * MOBILE FIRST — around nine in ten of these people are on a phone. Indentation is 12px per level
 * with a hairline rule, not 24px: at 360px and eight levels deep, 24px would leave 168px for a name.
 * Names wrap rather than truncate, every summary clears the 44px touch floor, and the tree NEVER
 * makes the page scroll sideways — the page puts this inside its own overflow-x container.
 *
 * NO EMOJI. The one glyph is an inline monochrome SVG chevron that rotates on open.
 */
import type { OrgTreeNode } from '@/lib/org-chart';
import Self from './OrgNode.astro';

export interface Props {
  node: OrgTreeNode;
  /** Levels open on first paint. Deeper branches start closed so a phone gets a short page. */
  openDepth?: number;
}

const { node, openDepth = 2 } = Astro.props;

const children = node.children || [];
const hasChildren = children.length > 0;
// "3 reports" is the count of DIRECT reports drawn here — not the size of the subtree. A number that
// silently means something else is worse than no number.
const reportCount = children.length;
const startOpen = node.depth < openDepth;

const meta = [node.designation, node.departmentName].filter((v) => !!v).join(' · ');
---

{hasChildren ? (
  <details class="orgn" open={startOpen}>
    <summary class="orgn__row orgn__row--parent wf-focusable">
      <svg class="orgn__chev" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 3 5 5-5 5" />
      </svg>
      <span class="orgn__body">
        <span class="orgn__name" data-viewer={node.isViewer ? 'yes' : null} data-match={node.matched ? 'yes' : null}>
          {node.fullName || 'Unnamed record'}
          {node.isViewer && <span class="orgn__you">you</span>}
        </span>
        {meta && <span class="orgn__meta">{meta}</span>}
        {node.tags.length > 0 && (
          <span class="orgn__tags">{node.tags.map((t) => <span class="orgn__tag">{t}</span>)}</span>
        )}
      </span>
      <span class="orgn__count">{reportCount}</span>
    </summary>
    <div class="orgn__kids">
      {children.map((child) => <Self node={child} openDepth={openDepth} />)}
    </div>
  </details>
) : (
  <div class="orgn orgn--leaf">
    <div class="orgn__row">
      <span class="orgn__dot" aria-hidden="true"></span>
      <span class="orgn__body">
        <span class="orgn__name" data-viewer={node.isViewer ? 'yes' : null} data-match={node.matched ? 'yes' : null}>
          {node.fullName || 'Unnamed record'}
          {node.isViewer && <span class="orgn__you">you</span>}
        </span>
        {meta && <span class="orgn__meta">{meta}</span>}
        {node.tags.length > 0 && (
          <span class="orgn__tags">{node.tags.map((t) => <span class="orgn__tag">{t}</span>)}</span>
        )}
      </span>
    </div>
  </div>
)}

<style>
  .orgn {
    min-width: 0;
  }

  .orgn__row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-height: 44px; /* the touch floor, not a suggestion */
    padding: 8px 8px 8px 4px;
    border-radius: 8px;
    cursor: default;
    list-style: none;
  }

  .orgn__row--parent {
    cursor: pointer;
  }

  /* Safari and Chrome each need their own way of removing the default triangle. */
  .orgn__row::-webkit-details-marker {
    display: none;
  }

  .orgn__row--parent:hover {
    background: #F3F1EF;
  }

  .orgn__chev {
    flex: none;
    margin-top: 3px;
    color: #70685C;
    transition: transform 110ms cubic-bezier(0.2, 0.6, 0.35, 1);
  }

  .orgn > details[open] > .orgn__row > .orgn__chev,
  details[open] > .orgn__row > .orgn__chev {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .orgn__chev {
      transition: none;
    }
  }

  .orgn__dot {
    flex: none;
    width: 6px;
    height: 6px;
    margin: 8px 4px 0;
    border-radius: 50%;
    background: #C6C1BA;
  }

  .orgn__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .orgn__name {
    font-size: 0.875rem;
    font-weight: 620;
    line-height: 1.35;
    color: #1B1813;
    /* Wrap, never truncate. A name cut to "Sudhanshu Ram…" is a different person. */
    overflow-wrap: anywhere;
  }

  .orgn__name[data-viewer='yes'] {
    color: #8A3415;
  }

  .orgn__name[data-match='yes'] {
    background: #FBF6F1;
    box-shadow: inset 0 -2px 0 #D56F15;
  }

  .orgn__you {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 6px;
    border: 1px solid #EADACD;
    border-radius: 999px;
    background: #FBF6F1;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #794111;
  }

  .orgn__meta {
    font-size: 0.75rem;
    line-height: 1.45;
    color: #70685C;
    overflow-wrap: anywhere;
  }

  .orgn__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .orgn__tag {
    padding: 1px 7px;
    border: 1px solid #CDD8EA;
    border-radius: 999px;
    background: #F1F5FB;
    font-size: 0.6875rem;
    font-weight: 650;
    color: #224E91;
  }

  .orgn__count {
    flex: none;
    align-self: center;
    min-width: 22px;
    padding: 2px 6px;
    border-radius: 999px;
    background: #F2F0EE;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    text-align: center;
    color: #564E43;
  }

  /* 12px per level, with a hairline that makes the containment readable at 360px. */
  .orgn__kids {
    margin-left: 10px;
    padding-left: 6px;
    border-left: 1px solid #DFDCD8;
  }

  @media (forced-colors: active) {
    .orgn__tag,
    .orgn__count,
    .orgn__you {
      border: 1px solid CanvasText;
    }
    .orgn__kids {
      border-left-color: CanvasText;
    }
  }
</style>
