---
/**
 * Workforce / EmptyState — a screen with nothing on it yet.
 *
 * WHAT THIS IS FOR. An empty board column, a task with no comments, a filter
 * that matched nothing, a first day with no work assigned. One drawing, one
 * warm line, one clear action.
 *
 * DESIGN DECISION — NOTHING HERE APOLOGISES, because in this product empty is
 * usually correct. An empty "Blocked" column means nobody is stuck, which is
 * the best news on the board; an empty comment thread means the work was clear
 * enough that nobody had to ask. Copy like "Nothing here yet!" or a shrugging
 * illustration turns a good state into a small failure thirty times a day.
 * So the drawings are calm, the line states the fact and says what happens
 * next, and there is no exclamation mark anywhere in the component.
 *
 * DESIGN DECISION — the action is an ANCHOR, never a button. Every empty state
 * in this set resolves by going somewhere: a form page, a board, a filter with
 * different parameters. An anchor works with the bundle blocked, opens in a new
 * tab on a middle click, and is reachable by keyboard without a handler. If a
 * caller genuinely needs a POST, they put a form in the `action` slot — the
 * component does not grow an onclick.
 *
 * The drawings share one construction — a soft wash shape and one continuous
 * line at a single weight — which is what makes four different pictures read as
 * one family rather than four clip-art imports. They are decorative and marked
 * aria-hidden: the heading already says what the drawing says, and a screen
 * reader announcing "illustration of an empty tray" adds nothing but time.
 */
import '../../styles/workforce.css';

export interface Props {
  title: string;
  body?: string;
  actionLabel?: string;
  actionHref?: string;
  /** Which drawing. Or put your own SVG in the `illustration` slot. */
  illustration?: 'tray' | 'check' | 'search' | 'note';
  /** Tints the drawing with a semantic ramp, e.g. 'approved' for a clear board. */
  tone?: string;
  headingLevel?: 2 | 3 | 4;
  /** Tightens everything for use inside a board column. */
  compact?: boolean;
  class?: string;
}

const {
  title,
  body,
  actionLabel,
  actionHref,
  illustration = 'tray',
  tone = 'draft',
  headingLevel = 3,
  compact = false,
  class: cls = '',
} = Astro.props;

// `: any` is required, not lazy — see the note in TaskCard.astro.
const Heading: any = `h${headingLevel}`;

// A 120x88 field. Two parts only: .wash (filled, no stroke) and .line (stroked).
const ART = {
  // an empty tray: nothing waiting, and nothing wrong
  tray:
    '<ellipse class="wash" cx="60" cy="46" rx="34" ry="26"/>' +
    '<path class="line" d="M24 40h17l5 9h28l5-9h17"/>' +
    '<path class="line" d="M24 40v20a6 6 0 0 0 6 6h60a6 6 0 0 0 6-6V40"/>' +
    '<path class="line" d="M33 27h54"/>',
  // everything is done
  check:
    '<circle class="wash" cx="60" cy="44" r="27"/>' +
    '<circle class="line" cx="60" cy="44" r="21"/>' +
    '<path class="line" d="m50 44 7 7 14-15"/>' +
    '<path class="line" d="M26 76h68"/>',
  // a filter matched nothing
  search:
    '<circle class="wash" cx="56" cy="42" r="26"/>' +
    '<circle class="line" cx="54" cy="40" r="18"/>' +
    '<path class="line" d="m67 53 13 13"/>' +
    '<path class="line" d="M30 78h60"/>',
  // no conversation yet
  note:
    '<rect class="wash" x="26" y="24" width="58" height="44" rx="12"/>' +
    '<path class="line" d="M36 18h52a8 8 0 0 1 8 8v26a8 8 0 0 1-8 8H58l-14 12V60h-8a8 8 0 0 1-8-8V26a8 8 0 0 1 8-8Z"/>' +
    '<path class="line" d="M46 32h32"/>' +
    '<path class="line" d="M46 44h20"/>',
};

const art = ART[illustration as keyof typeof ART] || ART.tray;
const hasSlotArt = Astro.slots.has('illustration');
const hasLink = Boolean(actionHref) && Boolean(actionLabel);
const hasActionSlot = Astro.slots.has('action');
---

<div class:list={['wf-empty', { 'wf-empty--compact': compact }, cls]} data-wf-tone={tone}>
  {hasSlotArt ? (
    <div class="wf-empty__art" aria-hidden="true"><slot name="illustration" /></div>
  ) : (
    <svg
      class="wf-empty__art"
      viewBox="0 0 120 88"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={art}
    />
  )}

  <Heading class="wf-empty__title">{title}</Heading>

  {body && <p class="wf-empty__body">{body}</p>}

  {hasLink && (
    <a class="wf-empty__action wf-focusable" href={actionHref}>{actionLabel}</a>
  )}

  {!hasLink && hasActionSlot && (
    <div class="wf-empty__slot"><slot name="action" /></div>
  )}
</div>

<style>
  .wf-empty {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    min-width: 0;
    padding: var(--wf-s-5) var(--wf-s-4);
    text-align: center;
    font-family: var(--wf-font);
    color: var(--wf-ink);
  }

  .wf-empty--compact {
    padding: var(--wf-s-4) var(--wf-s-2);
  }

  .wf-empty__art {
    display: block;
    width: min(100%, 168px);
    height: auto;
    margin-bottom: var(--wf-s-3);
    color: var(--wf-tone-accent);
  }

  .wf-empty--compact .wf-empty__art {
    width: min(100%, 108px);
    margin-bottom: var(--wf-s-2);
  }

  /* set:html injects without Astro's scope attribute, so the parts of the
     drawing are reached with :global() from the scoped parent. */
  .wf-empty__art :global(.wash) {
    fill: var(--wf-tone-wash);
    stroke: none;
  }

  .wf-empty__art :global(.line) {
    fill: none;
    stroke: currentColor;
  }

  .wf-empty__title {
    margin: 0;
    font-size: var(--wf-t-title);
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--wf-ink);
    text-wrap: balance;
  }

  .wf-empty--compact .wf-empty__title {
    font-size: var(--wf-t-body);
  }

  .wf-empty__body {
    margin: var(--wf-s-2) 0 0;
    max-width: 42ch;
    font-size: var(--wf-t-meta);
    line-height: 1.6;
    color: var(--wf-ink-3);
    text-wrap: pretty;
  }

  .wf-empty__action,
  .wf-empty__slot {
    margin-top: var(--wf-s-4);
  }

  .wf-empty--compact .wf-empty__action,
  .wf-empty--compact .wf-empty__slot {
    margin-top: var(--wf-s-3);
  }

  .wf-empty__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--wf-touch);
    padding: var(--wf-s-2) var(--wf-s-5);
    border: 1px solid var(--wf-ink);
    border-radius: var(--wf-r-sm);
    background: var(--wf-ink);
    color: var(--wf-surface);
    font-size: var(--wf-t-body);
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
  }

  .wf-empty__action:active {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-empty__action:active {
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .wf-empty__action {
      border-color: CanvasText;
    }
  }
</style>
