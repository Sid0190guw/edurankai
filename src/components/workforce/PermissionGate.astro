---
/**
 * Workforce / PermissionGate — hides a control the viewer may not use.
 *
 * =========================================================================
 * THIS IS NOT A SECURITY BOUNDARY. IT IS CSS FOR PEOPLE.
 *
 * It renders its slot when a boolean is true and does not when it is false.
 * That is all it does and all it can do. The slot's markup is evaluated by
 * Astro before it reaches this component either way — anything you compute to
 * build the children has already run, and any data you interpolated into them
 * has already been read out of the database.
 *
 * SO THE SERVER MUST STILL REFUSE. Every write behind a gated control has to
 * re-derive the actor's right to make it, on the server, in the request that
 * performs it. src/lib/employee-tasks.ts already does exactly this and is the
 * model: moveTask() re-reads the actor's roles and puts
 * actorHasAnyRoleSql(actor, allowedRoles) inside the WHERE clause of the UPDATE
 * itself, so the authorisation and the write are one statement and a role
 * revoked a moment ago cannot be spent a moment later. Hiding the button is
 * what makes the screen honest; the WHERE clause is what makes it safe.
 *
 * A control hidden here and not refused there is a control anyone can use by
 * typing the URL, and they will not even have to be clever about it — the form
 * fields are in the page source of the colleague sitting next to them.
 * =========================================================================
 *
 * DESIGN DECISION — the default for a false gate is to render NOTHING, and the
 * alternative has to be asked for by name. A greyed-out control is a worse
 * answer than an absent one in almost every case here: it is unreadable by
 * design, it still takes up the space and the eye's attention, and it invites
 * the reader to press it and be refused. Where the absence itself would be
 * confusing — the person is looking for the Approve button and needs to know it
 * exists and is not theirs — pass `reason`, and the component says who to ask
 * instead. canTransition() in the task engine already returns exactly that
 * sentence ("Moving this to Approved is for an approver or the department lead.
 * Ask them, or add a comment saying it is ready."), so the honest message is a
 * prop away and nobody has to invent one.
 *
 * `fallback` is a named slot for the rare case where something else belongs in
 * the space entirely.
 */
import '../../styles/workforce.css';

export interface Props {
  /** Server-resolved. Never a value the browser sent. */
  allowed: boolean;
  /** Shown instead of the slot when allowed is false. Pass the engine's own
   *  refusal sentence rather than writing a new one. */
  reason?: string | null;
  class?: string;
}

const { allowed, reason = null, class: cls = '' } = Astro.props;

const showReason = !allowed && typeof reason === 'string' && reason.trim().length > 0;
const hasFallback = !allowed && Astro.slots.has('fallback');
---

{allowed && <slot />}

{!allowed && hasFallback && <slot name="fallback" />}

{showReason && !hasFallback && (
  /* Not role="alert" and not aria-live. This is a standing fact about the
     page, present from the moment it rendered — announcing it as an alert
     would interrupt a screen reader reader mid-sentence to tell them something
     that has not changed. It is read in document order, like the sentence it is. */
  <p class:list={['wf-gate', cls]}>{reason}</p>
)}

<style>
  .wf-gate {
    margin: var(--wf-s-2) 0 0;
    font-family: var(--wf-font);
    font-size: var(--wf-t-meta);
    line-height: 1.55;
    color: var(--wf-ink-3);
    max-width: 56ch;
    overflow-wrap: anywhere;
  }
</style>
