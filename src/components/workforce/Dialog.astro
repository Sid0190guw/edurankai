---
/**
 * Workforce / Dialog — a native <dialog>, with a page to fall back to.
 *
 * WHAT THIS IS FOR. Confirming a destructive move, adding a collaborator,
 * stating a reason before a task is blocked: the small interruptions that
 * should not cost a full page load, but must still work when the bundle does
 * not arrive.
 *
 * THE PLATFORM DOES THE HARD PART. showModal() traps focus inside the dialog,
 * makes everything behind it inert, closes on Escape, and returns focus to the
 * element that opened it — all of it, in every current browser, for free. The
 * hand-rolled equivalent is a focus-trap loop, aria-modal, aria-labelledby,
 * an Escape handler, a scroll lock and a stack of previously-focused elements,
 * and it is usually still wrong on a screen reader. There is roughly a dozen
 * lines of script in this component and none of them touch focus.
 *
 * DESIGN DECISION — `fallbackHref` is REQUIRED, and that is the whole design.
 * Without script, a <dialog> that is never opened is display:none and its
 * trigger does nothing at all: a dead control on a page that otherwise works.
 * So the trigger is not a <button>, it is an <a href> pointing at a real page
 * that does the same job, and the script's only contribution is to preventDefault
 * and open the dialog instead. Script blocked, script not yet loaded, browser
 * without showModal, tap that lands before hydration: the anchor navigates and
 * the person completes the task. If a caller finds they have no page to point
 * at, that is the component telling them this content wanted to be a page.
 * Ruling 3 in one prop.
 *
 * A page may also open this dialog from its own markup: put
 * `data-wf-dialog-open="<the id>"` on any anchor. The listener is delegated at
 * the document, so it works for markup that did not exist when it ran.
 */
import '../../styles/workforce.css';

export interface Props {
  /** Unique on the page. The trigger references it. */
  id: string;
  /** The dialog's accessible name, and its visible heading. */
  title: string;
  /** REQUIRED. Where the trigger goes when script is unavailable. See above. */
  fallbackHref: string;
  triggerLabel: string;
  /** 'primary' for the one action that matters, 'quiet' for everything else. */
  triggerVariant?: 'primary' | 'quiet' | 'link';
  closeLabel?: string;
  /** Short line under the heading. */
  description?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

const {
  id,
  title,
  fallbackHref,
  triggerLabel,
  triggerVariant = 'quiet',
  closeLabel = 'Close',
  description,
  headingLevel = 2,
  class: cls = '',
} = Astro.props;

// `: any` is required, not lazy — see the note in TaskCard.astro.
const Heading: any = `h${headingLevel}`;
const titleId = id + '-title';
const descId = id + '-desc';
---

<a
  class:list={['wf-dlg__trigger', 'wf-dlg__trigger--' + triggerVariant, 'wf-focusable', cls]}
  href={fallbackHref}
  data-wf-dialog-open={id}
>{triggerLabel}</a>

<dialog
  class="wf-dlg"
  id={id}
  aria-labelledby={titleId}
  aria-describedby={description ? descId : undefined}
>
  <div class="wf-dlg__panel">
    <div class="wf-dlg__head">
      <Heading class="wf-dlg__title" id={titleId}>{title}</Heading>

      {/* method="dialog" closes without script and without a submit handler.
          It is the only close control that keeps working if everything else
          fails, so it is the one in the corner. */}
      <form method="dialog" class="wf-dlg__closeform">
        <button class="wf-dlg__close wf-focusable" type="submit" aria-label={closeLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18" />
          </svg>
        </button>
      </form>
    </div>

    {description && <p class="wf-dlg__desc" id={descId}>{description}</p>}

    <div class="wf-dlg__body">
      <slot />
    </div>

    <div class="wf-dlg__foot">
      <slot name="actions" />
      <form method="dialog" class="wf-dlg__closeform">
        <button class="wf-btn wf-focusable" type="submit">{closeLabel}</button>
      </form>
    </div>
  </div>
</dialog>

<script>
  // Delegated once at the document, so every Dialog on the page shares this and
  // markup added later still works. Astro bundles one copy however many
  // instances a page renders.
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;

    var trigger = target.closest('[data-wf-dialog-open]');
    if (trigger) {
      var id = trigger.getAttribute('data-wf-dialog-open');
      // `as any` because the feature test below is the point: an older browser
      // returns an HTMLElement with no showModal at all, which is precisely the
      // case being handled. Narrowing to HTMLDialogElement would assert the
      // method exists and delete the only reason this branch is here.
      var dialog = (id ? document.getElementById(id) : null) as any;
      // No dialog, or a browser without showModal: do nothing and let the
      // anchor navigate to fallbackHref. Never preventDefault before we are
      // certain we can do the thing instead.
      if (!dialog || typeof dialog.showModal !== 'function') return;
      event.preventDefault();
      dialog.showModal();
      return;
    }

    // A click on the backdrop lands on the <dialog> itself rather than on the
    // panel inside it. Escape already does this; a lot of people reach for the
    // greyed-out area first.
    var maybeDialog = target as any;
    if (maybeDialog.tagName === 'DIALOG' && maybeDialog.classList.contains('wf-dlg')
        && typeof maybeDialog.close === 'function') {
      maybeDialog.close();
    }
  });
</script>

<style>
  .wf-dlg__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--wf-touch);
    padding: var(--wf-s-2) var(--wf-s-4);
    border-radius: var(--wf-r-sm);
    font-family: var(--wf-font);
    font-size: var(--wf-t-body);
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }

  .wf-dlg__trigger--primary {
    border: 1px solid var(--wf-ink);
    background: var(--wf-ink);
    color: var(--wf-surface);
  }

  .wf-dlg__trigger--quiet {
    border: 1px solid var(--wf-line-strong);
    background: var(--wf-raised);
    color: var(--wf-ink);
  }

  .wf-dlg__trigger--link {
    min-height: 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--wf-info-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .wf-dlg__trigger:active {
    opacity: 0.8;
  }

  .wf-dlg {
    /* The element is the full modal layer; the panel inside it is the card.
       Splitting them is what makes a backdrop click detectable. */
    padding: 0;
    border: none;
    background: none;
    max-width: 100%;
    max-height: 100%;
    color: var(--wf-ink);
    font-family: var(--wf-font);
  }

  /* --wf-scrim, not a literal: the dark theme needs a heavier veil than the
     light one to separate anything at all, and a hex sitting in this file
     could not know that.
     WITH A FALLBACK, AND THE FALLBACK IS THE POINT. ::backdrop only began
     inheriting from its originating element in 2023-24 (CSS Position 4).
     Before that it inherited from nothing, so a custom property was simply
     unavailable inside it and `background: var(--wf-scrim)` would compute to
     nothing — a modal with no dim behind it, on exactly the old Android
     WebView this set is built for. The literal second argument is what that
     browser gets; every current one resolves the token. */
  .wf-dlg::backdrop {
    background: var(--wf-scrim, rgba(22, 21, 19, 0.55));
  }

  .wf-dlg__panel {
    box-sizing: border-box;
    /* At 360px this is a full-width sheet with a small margin; on a laptop it
       stops at 34rem. One rule, no breakpoint. */
    width: min(34rem, calc(100vw - var(--wf-s-4) * 2));
    max-height: calc(100vh - var(--wf-s-6));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--wf-s-4);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-lg);
    background: var(--wf-raised);
    box-shadow: var(--wf-shadow-2);
  }

  .wf-dlg__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--wf-s-3);
  }

  .wf-dlg__title {
    margin: 0;
    font-size: var(--wf-t-lg);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .wf-dlg__closeform {
    margin: 0;
    flex: 0 0 auto;
  }

  .wf-dlg__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* A 44px target that looks like a 20px cross: the extra is transparent
       padding, pulled back out with a negative margin so the heading still
       aligns with the panel's top edge. */
    width: var(--wf-touch);
    height: var(--wf-touch);
    margin: calc(var(--wf-s-2) * -1) calc(var(--wf-s-2) * -1) 0 0;
    padding: 0;
    border: none;
    border-radius: var(--wf-r-sm);
    background: none;
    color: var(--wf-ink-3);
    cursor: pointer;
  }

  .wf-dlg__close svg {
    width: 20px;
    height: 20px;
  }

  .wf-dlg__close:hover {
    background: var(--wf-row-hover);
    color: var(--wf-ink);
  }

  .wf-dlg__desc {
    margin: var(--wf-s-2) 0 0;
    font-size: var(--wf-t-meta);
    line-height: 1.6;
    color: var(--wf-ink-3);
    max-width: 56ch;
  }

  .wf-dlg__body {
    margin-top: var(--wf-s-4);
    font-size: var(--wf-t-body);
    line-height: 1.6;
  }

  .wf-dlg__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--wf-s-2);
    margin-top: var(--wf-s-5);
  }

  .wf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--wf-touch);
    padding: var(--wf-s-2) var(--wf-s-4);
    border: 1px solid var(--wf-line-strong);
    border-radius: var(--wf-r-sm);
    background: var(--wf-raised);
    color: var(--wf-ink);
    font-family: inherit;
    font-size: var(--wf-t-body);
    font-weight: 650;
    cursor: pointer;
  }

  .wf-btn:active,
  .wf-dlg__close:active {
    opacity: 0.8;
  }

  /* The one movement: the sheet arrives from slightly below, which says "this
     came from the thing you pressed" rather than "this appeared". Transform and
     opacity only, 180ms, and it never runs on an open dialog again. */
  @media (prefers-reduced-motion: no-preference) {
    .wf-dlg[open] .wf-dlg__panel {
      animation: wf-dlg-in var(--wf-dur-move) var(--wf-ease) both;
    }
  }

  @keyframes wf-dlg-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-dlg__trigger:active,
    .wf-btn:active,
    .wf-dlg__close:active {
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .wf-dlg__panel {
      border-color: CanvasText;
    }
  }
</style>
