---
/**
 * Workforce / WorkspaceNav — the employee workspace navigation, rendered from a composition.
 *
 * WHAT IT IS. A bottom tab bar plus a full-list drawer, built entirely from what
 * composeWorkspace() already decided. It contains no authorization logic of its
 * own: src/lib/workforce/navigation.ts projects the composed result into a list
 * of doors, and this file draws them. If a destination is not in that list, it
 * does not render — there is no branch here that could put one back.
 *
 * WHY IT WRAPS BottomNav RATHER THAN REPLACING IT. BottomNav.astro is the single
 * copy of the portal's fixed bar: its geometry, its 44px floor (--wf-touch), its
 * focus ring, its aria-current and its contrast values were all measured rather
 * than guessed, and ten portal pages already render it. A second bar would be a
 * duplicate that drifts. So the bar here IS BottomNav, handed a composed item
 * list through the `items` prop it already accepts. Only the drawer is new,
 * because a disclosure control is the one thing a list of links cannot express.
 *
 * NO JAVASCRIPT. The drawer opens on :target — the More tab is an anchor to
 * #wsnav-more and the panel is display:none until the fragment matches. That
 * keeps the nav working on a slow phone before hydration, in a locked-down
 * browser, and on the offline-cached shell. Closing is an anchor back to "#".
 * The cost is one history entry per open, which is the correct trade for a
 * control that must work before anything else on the page does.
 *
 * MOBILE IS THE PRIMARY TARGET, not a variant. Around nine in ten of these
 * people are on a phone. The bar holds four tabs because BottomNav measured that
 * five at 360px gives about 72px each against a 10px label. Every drawer row is
 * at least 48px tall, labels ellipsis rather than widen, and nothing in here can
 * make the page scroll sideways.
 *
 * TO MOUNT IT, on any portal surface that already composes:
 *   import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
 *   <WorkspaceNav composed={composed} active="home" />
 * `active` is optional — the path lights the right tab on its own.
 *
 * The page must leave room for the bar: it is position:fixed and takes no space
 * in flow. This component cannot set that for you without reaching into the
 * page's own body rule, which is exactly the kind of global reach that breaks a
 * page it was never tested on. /portal already carries pb-16 on its <main>.
 *
 * THE ACCOUNT BLOCK — WHO YOU ARE, AND THE WAY OUT.
 *
 * Until this was added, the employee portal had no sign-out anywhere. On a shared
 * or borrowed phone there was simply no way to end a session, and the more common
 * failure is not forgetting to sign out — it is not realising you were signed in
 * as somebody else. So the top of the drawer names the account before it offers
 * the button, and the button is the first thing under the head.
 *
 * IT IS A POST, TO THE ONE ENDPOINT THAT ALREADY EXISTS. /portal/logout is the
 * portal's single session-clearing path (invalidateSession + clearSessionCookie);
 * this is a form, not a link, because a GET sign-out is triggered by a prefetch,
 * an <img src>, or a chat client unfurling a preview, and the symptom — random
 * sign-outs — is close to undiagnosable from a support ticket.
 *
 * IT IS IN THE DRAWER, WHICH IS WHY THE DRAWER IS NOW UNCONDITIONAL. The bar is a
 * row of links and cannot hold a form, so the control lives one tap behind the
 * More tab. buildWorkspaceNav therefore returns hasMore:true always — see the
 * note on that field. Before, four-or-fewer destinations produced no drawer at
 * all, which is exactly the degraded render where somebody most wants out.
 *
 * IDENTITY COMES FROM Astro.locals.user, set by middleware from the validated
 * session, so every page that mounts this gets it with no prop to pass and no
 * page to edit. It is NOT taken from the composition: WorkspaceContext carries no
 * name and no email by design (navigation.ts: "no user object, no email, no
 * role"), and adding them there would put identity into a module whose whole
 * claim is that it cannot see any.
 */
import BottomNav from '@/components/workforce/BottomNav.astro';
import '@/styles/workforce.css';
import { buildWorkspaceNav, MORE_TARGET_ID } from '@/lib/workforce/navigation';
import type { ComposedWorkspace } from '@/lib/workforce/composer';

export interface Props {
  /** The SAME composition the page rendered its widgets from. composeWorkspace() memoises on
   *  Astro.locals, so composing and then navigating costs one lookup, not two. */
  composed: ComposedWorkspace;
  /** Key of the destination the reader is on. Omit and the path decides. */
  active?: string;
  /** Accessible name of the landmark. Change it only if a page has two navs. */
  label?: string;
  /**
   * HOW MANY THINGS ARE WAITING, by destination key — `{ approvals: 3, notifications: 7 }`.
   *
   * THE PAGE SUPPLIES THESE AND MUST ALREADY HAVE COUNTED THEM. This projects numbers the caller
   * resolved for its own screen; it is not a licence to query. Passing a figure the page did not
   * already have would add a read to every render of every surface that mounts this nav, which is
   * the exact cost the composition exists to avoid.
   *
   * A key naming a destination this composition did NOT authorise is discarded inside
   * buildWorkspaceNav rather than rendered, so a stale map cannot hint at a surface somebody may not
   * open. Zero, NaN and negatives render nothing at all rather than a "0" pill.
   */
  badges?: Record<string, number>;
}

const { composed, active, label = 'Workspace', badges } = Astro.props;

const nav = buildWorkspaceNav(composed, { active, pathname: Astro.url.pathname, badges });

// WHO IS SIGNED IN. Straight off the request, set by middleware from the validated session — not
// from the composition, and not from anything a form could post. Read defensively because this
// component is mounted on pages that resolve their own user: a missing locals.user must collapse the
// account block, never throw and take the whole navigation down with it.
const signedInUser = (Astro.locals as any)?.user || null;
const accountName = String(signedInUser?.name || '').trim();
const accountEmail = String(signedInUser?.email || '').trim();
// An INITIAL, never a photograph. This renders on a phone that may be in somebody else's hand.
const accountInitial = (accountName || accountEmail || '?').charAt(0).toUpperCase();
// No session on this render means no identity to show and nothing to sign out of. The rest of the
// drawer still renders — the destinations came from the composition, which the page already built.
const showAccount = Boolean(signedInUser);

// The bar. The LAST SLOT IS ALWAYS the drawer trigger, and it is pushed unconditionally rather than
// behind `nav.hasMore`: the drawer is now the only place carrying the sign-out, and a panel that
// renders with no tab to open it would hide the control completely. buildWorkspaceNav already
// reserves the slot (it returns BAR_CAPACITY - 1 ranked entries), so this cannot overflow the bar.
// It is an anchor to a fragment, which is what lets BottomNav carry it without knowing anything
// about a menu.
//
// THE MORE TAB CARRIES WHAT IT IS HIDING. nav.moreBadge is the sum of every count on an authorised
// destination that did not take a bar slot. Without it the badge mechanism would be decorative for
// the people it matters to: 'approvals' is rank 4 and only three ranked entries reach the bar, so a
// manager's pending queue lives in the drawer — and a count you must open a menu to discover is a
// count nobody discovers.
//
// The glyph is 'menu', not 'grid'. It reused Home's glyph, which put the same picture on two of the
// four tabs; at 10px labels the icon is the primary scan target, so the two read as interchangeable.
// Typed up front rather than inferred from the map: the More tab pushed below carries a `hint` the
// ranked entries do not, and an inferred element type would reject it.
type BarItem = { key: string; href: string; label: string; icon: string; badge: number; hint?: string };
const barItems: BarItem[] = nav.bar.map((e) => ({
  key: e.key,
  href: e.href,
  label: e.label,
  icon: e.icon as string,
  badge: e.badge || 0,
}));
barItems.push({
  key: 'more',
  href: '#' + MORE_TARGET_ID,
  label: 'More',
  icon: 'menu',
  badge: nav.moreBadge,
  // The More tab is a disclosure, not a fourth destination, and a screen reader currently gets
  // "More, link" with no signal that a panel opens. aria-expanded is deliberately NOT used: the
  // sheet opens on :target with no JavaScript, so the attribute could never be updated and a static
  // aria-expanded="false" would be a lie exactly while the panel is open. The name says it instead.
  hint: nav.moreBadge > 0
    ? 'opens the workspace menu, ' + nav.moreBadge + ' waiting inside'
    : 'opens the workspace menu',
});

// Lucide-weight line glyphs, monochrome, drawn at 24 and rendered at 18. A plain
// object literal and not a typed map: a Record<string,string> annotation reaching
// the template is one of the .astro parse traps this repo has been bitten by.
// No emoji anywhere, by standing rule.
const GLYPHS = {
  grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  checklist: '<path d="M10 6h10M10 12h10M10 18h10"/><path d="M3.5 6 4.8 7.3 7.2 5"/><path d="M3.5 12l1.3 1.3L7.2 11"/><path d="M3.5 18l1.3 1.3L7.2 17"/>',
  // Matches the glyph BottomNav now draws for the More tab, so the tab and any drawer row using it
  // wear the same picture rather than the silent 'grid' fallback.
  menu: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
};
const glyphFor = (name: string) => GLYPHS[name as keyof typeof GLYPHS] || GLYPHS.grid;

const sheetId = MORE_TARGET_ID;
---

<BottomNav items={barItems} active={nav.active} label={label} />

{/* THE DRAWER IS UNCONDITIONAL. It used to render only when there were more
    destinations than bar slots; it now always renders, because it carries the
    account block and the sign-out, and those must exist on every render — most
    of all on the degraded one, where exactly four destinations survive and the
    old condition produced no drawer at all. */}
<div id={sheetId} class="wsnav-sheet">
  {/* The scrim closes the sheet. It is a link and not a div so it works without
      JavaScript and is reachable from a keyboard. */}
  <a class="wsnav-sheet__scrim" href="#" aria-label="Close the workspace menu"></a>

    <div class="wsnav-sheet__panel">
      <div class="wsnav-sheet__head">
        <p class="wsnav-sheet__title">Your workspace</p>
        <a class="wsnav-sheet__close wf-focusable" href="#">Close</a>
      </div>

      {showAccount && (
        <div class="wsnav-account">
          {/* WHO FIRST, THEN THE BUTTON. The failure this exists for is not
              forgetting to sign out; it is not realising you were signed in as
              somebody else. A control that says only "Sign out" cannot tell you
              that, so the name and the address sit directly above it. */}
          <div class="wsnav-account__who">
            <span class="wsnav-account__avatar" aria-hidden="true">{accountInitial}</span>
            <span class="wsnav-account__text">
              <span class="wsnav-account__label">Signed in as</span>
              <span class="wsnav-account__name">{accountName || 'Your account'}</span>
              {accountEmail && <span class="wsnav-account__mail">{accountEmail}</span>}
            </span>
          </div>

          {/* A FORM, NOT A LINK. A GET sign-out is fired by a prefetch, an image
              tag or a link preview, and the resulting random sign-outs are close
              to undiagnosable. /portal/logout is the portal's ONE session-clearing
              path: it deletes the `sessions` row server-side and then clears the
              cookie. No JavaScript — this posts on a phone with a dead bundle. */}
          <form method="POST" action="/portal/logout" class="wsnav-account__form">
            <button type="submit" class="wsnav-account__btn wf-focusable">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Sign out</span>
            </button>
          </form>
        </div>
      )}

      {nav.degraded && (
        <p class="wsnav-sheet__note">
          Some of your access could not be read just now, so this list may be shorter than usual.
          Nothing has been removed from your account. Try again in a moment.
        </p>
      )}

      {nav.drawer.map((group) => (
        <section class="wsnav-group">
          <h2 class="wsnav-group__label">{group.label}</h2>
          <ul class="wsnav-list">
            {group.entries.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  class:list={['wsnav-row', 'wf-focusable', { 'is-active': entry.key === nav.active }]}
                  aria-current={entry.key === nav.active ? 'page' : undefined}
                >
                  <svg
                    class="wsnav-row__icon"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={glyphFor(entry.icon)}
                  />
                  <span class="wsnav-row__label">{entry.label}</span>
                  {/* THE COUNT, on the row it belongs to. The pill is aria-hidden and the sentence
                      beside it is the only spoken form, because "Approvals" then "3" as two
                      unconnected fragments tells a screen-reader user two things and joins neither.
                      Rendered only above zero — a drawer of "0" pills is a drawer whose pills nobody
                      reads. */}
                  {(entry.badge || 0) > 0 && (
                    <span class="wsnav-row__count">
                      <span aria-hidden="true">{entry.badge}</span>
                      <span class="wf-sr-only">{entry.badge} waiting</span>
                    </span>
                  )}
                  <svg
                    class="wsnav-row__chev"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
</div>

<style is:global>
  /* The floating action button and the bottom bar occupy the same corner of the
     same phone. Hidden the way portal/mail.astro:309 already does it, so the two
     conventions agree rather than fight. The page keeps its era-has-fab class —
     nothing here reaches into src/layouts/. */
  body.era-has-fab #eraFab,
  body.era-has-fab #eraFabMenu {
    display: none !important;
  }
</style>

<style>
  /* THE SHEET IS CLOSED UNTIL THE FRAGMENT MATCHES. display:none rather than a
     transform, so a screen reader does not walk a menu that is not open and a
     keyboard cannot tab into it. */
  .wsnav-sheet {
    display: none;
  }

  .wsnav-sheet:target {
    display: block;
  }

  .wsnav-sheet__scrim {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(15, 15, 20, 0.45);
    /* An empty anchor still needs to be a target a finger can land on: it covers
       the viewport, so its own size is the whole screen. */
    display: block;
  }

  .wsnav-sheet__panel {
    position: fixed;
    left: 0;
    right: 0;
    /* Sits ON TOP of the bar rather than above it: the bar is ~56px plus the safe
       area, and stacking the two would push the list off a short phone. */
    bottom: 0;
    z-index: 60;
    max-height: 76vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--wf-surface);
    border-top: 1px solid var(--wf-line);
    border-top-left-radius: var(--wf-r-lg);
    border-top-right-radius: var(--wf-r-lg);
    padding: 4px 0 calc(16px + env(safe-area-inset-bottom));
    font-family: var(--wf-font);
    color: var(--wf-ink);
  }

  .wsnav-sheet__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px 10px;
    background: var(--wf-surface);
    border-bottom: 1px solid var(--wf-line);
  }

  .wsnav-sheet__title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--wf-ink);
  }

  .wsnav-sheet__close {
    /* 44px floor, stated rather than inherited from the type size. */
    min-height: var(--wf-touch);
    min-width: var(--wf-touch);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: var(--wf-r-sm);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--wf-ink-2);
  }

  .wsnav-sheet__note {
    margin: 12px 16px 4px;
    padding: 10px 12px;
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-sm);
    background: var(--wf-veil);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--wf-ink-2);
  }

  .wsnav-group {
    padding: 10px 0 2px;
  }

  .wsnav-group__label {
    margin: 0;
    padding: 6px 16px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* ink-3 is the meta tone and clears AA at this size against every surface in
       the set; ink-4 is non-text only and is deliberately not used here. */
    color: var(--wf-ink-3);
  }

  .wsnav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wsnav-row {
    display: flex;
    align-items: center;
    gap: 12px;
    /* Comfortably past the 44px floor: these are one-handed taps on a moving bus. */
    min-height: 48px;
    padding: 10px 16px;
    text-decoration: none;
    color: var(--wf-ink);
    font-size: 0.92rem;
  }

  .wsnav-row:hover {
    background: var(--wf-row-hover);
  }

  .wsnav-row.is-active {
    background: var(--wf-row-selected);
    font-weight: 600;
  }

  .wsnav-row__icon {
    flex: 0 0 auto;
    color: var(--wf-ink-2);
  }

  .wsnav-row__label {
    /* min-width:0 plus ellipsis is what stops a long label widening the sheet past
       the phone — the one way a menu can cause a horizontal page scroll. */
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The count on a drawer row. flex:0 0 auto so it never competes with the label
     for width — the label ellipsis first, the number always survives, because a
     truncated count is worse than a truncated word. */
  .wsnav-row__count {
    flex: 0 0 auto;
    min-width: 22px;
    height: 20px;
    padding: 0 7px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--wf-tone-wash, var(--wf-veil));
    border: 1px solid var(--wf-line);
    color: var(--wf-ink);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .wsnav-row__chev {
    flex: 0 0 auto;
    color: var(--wf-ink-4);
  }

  /* Feedback that the press landed, and nothing else moves. Opacity only, gone the
     moment the finger lifts — a menu that animates is slower than the navigation
     it triggers. */
  .wsnav-row:active,
  .wsnav-sheet__close:active {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .wsnav-row:active,
    .wsnav-sheet__close:active {
      opacity: 1;
    }
  }

  /* Wide screens get the same sheet as a centred card rather than a new layout.
     One set of markup, one set of rules, no desktop-only branch to keep in step. */
  @media (min-width: 720px) {
    .wsnav-sheet__panel {
      left: 50%;
      transform: translateX(-50%);
      width: min(560px, 92vw);
      bottom: 72px;
      border-radius: var(--wf-r-lg);
      border: 1px solid var(--wf-line);
    }
  }
</style>
