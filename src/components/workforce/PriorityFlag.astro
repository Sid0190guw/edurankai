---
/**
 * Workforce / PriorityFlag — how much this one matters relative to the rest.
 *
 * WHAT THIS IS FOR. employee_tasks.priority holds one of four values and
 * TASK_PRIORITIES in src/lib/employee-tasks.ts orders them. This renders one,
 * on a card face, in a filter bar, or beside a task title.
 *
 * SHAPE CARRIES THE RANK, AND THE SHAPE IS ORDINAL. Priority is not four
 * unrelated categories, it is a scale, so the glyphs are a scale too: a
 * chevron pointing down, a flat bar, a chevron pointing up, two chevrons
 * pointing up. Somebody who has never seen this product before can order four
 * cards correctly without reading a word or seeing a colour, because the marks
 * themselves go down, level, up, further up. The same greyscale and
 * colour-vision collapse that governs StatusBadge applies here — the four
 * priority accents sit at matched luminance by construction — so colour is the
 * third channel here too, after shape and after the word.
 *
 * DESIGN DECISION — 'normal' can render as nothing, and TaskCard asks it to.
 * Three quarters of tasks are normal priority. A flag on all of them is a flag
 * on none of them: it costs a card's most valuable asset, which is the reader
 * noticing the one card that is urgent. `hideNormal` makes the component return
 * an empty string, so a caller does not have to wrap it in a conditional and
 * cannot accidentally leave a hole in a flex row where the flag used to be.
 * It defaults to false, because a component that silently renders nothing
 * unless asked is a component someone will spend an afternoon debugging.
 * The filter bar and the detail page leave it false; the card face passes it.
 */
import type { TaskPriority } from '@/lib/employee-tasks';
import '../../styles/workforce.css';

export interface Props {
  priority: TaskPriority | string;
  /** Overrides the derived word. */
  label?: string;
  size?: 'sm' | 'md';
  /** Render the mark alone; the word stays in the DOM for assistive tech. */
  glyphOnly?: boolean;
  /** Render nothing at all for 'normal'. See the note above. */
  hideNormal?: boolean;
  class?: string;
}

const {
  priority,
  label,
  size = 'sm',
  glyphOnly = false,
  hideNormal = false,
  class: cls = '',
} = Astro.props;

const raw = String(priority || '').trim().toLowerCase();
const key = (raw === 'low' || raw === 'normal' || raw === 'high' || raw === 'urgent')
  ? raw
  : 'normal';

// An ordinal ramp: down, level, up, up twice.
const GLYPHS = {
  low: '<path d="m6.5 9.75 5.5 5.5 5.5-5.5"/>',
  normal: '<path d="M6.5 12h11"/>',
  high: '<path d="m6.5 14.25 5.5-5.5 5.5 5.5"/>',
  urgent: '<path d="m6.5 12.5 5.5-5.5 5.5 5.5"/><path d="m6.5 17.5 5.5-5.5 5.5 5.5"/>',
};

// 'Urgent' is a word people act on; the others are reference points.
const WORDS = { low: 'Low', normal: 'Normal', high: 'High', urgent: 'Urgent' };

const hidden = hideNormal && key === 'normal';
const text = label || WORDS[key as keyof typeof WORDS];
const glyph = GLYPHS[key as keyof typeof GLYPHS];
---

{!hidden && (
  <span
    class:list={['wf-prio', 'wf-prio--' + size, 'wf-prio--' + key, { 'wf-prio--glyph': glyphOnly }, cls]}
    data-wf-tone={'p_' + key}
  >
    <svg
      class="wf-prio__glyph"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={glyph}
    />
    {glyphOnly
      ? <span class="wf-sr-only">{'Priority: ' + text}</span>
      : <span class="wf-prio__text">{text}</span>}
  </span>
)}

<style>
  .wf-prio {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    max-width: 100%;
    min-width: 0;
    padding: 2px 8px 2px 5px;
    border-radius: var(--wf-r-pill);
    color: var(--wf-tone-text);
    font-family: var(--wf-font);
    font-size: var(--wf-t-micro);
    font-weight: 600;
    line-height: 1.45;
    vertical-align: middle;
  }

  /* Low and normal carry no fill: they are the absence of news, and a filled
     chip for "nothing special" competes with the one card that matters. High
     and urgent get the wash and the hairline, so the eye finds them first in a
     column of thirty. */
  .wf-prio--high,
  .wf-prio--urgent {
    padding: 2px 8px 2px 5px;
    background: var(--wf-tone-wash);
    border: 1px solid var(--wf-tone-border);
  }

  .wf-prio--md {
    font-size: var(--wf-t-meta);
    padding: 4px 10px 4px 7px;
  }

  .wf-prio--glyph {
    padding: 3px;
  }

  .wf-prio__glyph {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }

  .wf-prio--md .wf-prio__glyph {
    width: 16px;
    height: 16px;
  }

  .wf-prio__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    .wf-prio--high,
    .wf-prio--urgent {
      border-color: CanvasText;
    }
  }
</style>
