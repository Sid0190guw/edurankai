---
/**
 * Workforce / StatusBadge — where one task is in the workflow.
 *
 * WHAT THIS IS FOR. src/lib/employee-tasks.ts models ten statuses and an
 * explicit graph of who may move between them. This renders one of those ten,
 * anywhere a task appears: on a card face, in a board column head, on the
 * detail page, in a timeline entry. It is presentation and nothing else — it
 * never decides what a status means, only how it looks.
 *
 * SHAPE FIRST, WORD SECOND, COLOUR THIRD — AND THAT ORDER IS MEASURED, NOT
 * PREFERRED. The ten status colours in workforce.css were each solved to the
 * same contrast target, which necessarily gives them near-identical luminance:
 * measured pairwise in greyscale, all 45 pairs differ by dL < 1.3. In a
 * greyscale rendering they are ONE COLOUR. Under simulated deuteranopia,
 * draft and cancelled collapse to dE=1.5 and in_progress and blocked to
 * dE=3.0; protanopia and tritanopia each collapse a different six or eight
 * pairs. No ten-hue palette survives that, so this badge does not try: every
 * status gets a distinct GLYPH, and the glyphs are built from four different
 * container shapes (dashed ring, ring, rounded square, filing box) so they are
 * separable at 14px by outline alone. Turn the whole file greyscale and the
 * board still reads.
 *
 * DESIGN DECISION — the label is derived, not looked up, and that is on
 * purpose. STATUS_LABELS in employee-tasks.ts is exactly the humanised form of
 * each key for all ten values ('under_review' gives 'Under review', and so on
 * for the rest). So this component derives the word from the key instead of
 * importing the map, and a status added to the engine renders correctly here
 * with no second file to remember. A caller that wants the engine's exact
 * string — or a translation — passes `label` and this never runs. The only
 * thing borrowed from the engine is `import type`, which compiles away: a
 * presentational badge must not pull the database client into a page's module
 * graph to draw a coloured pill.
 *
 * Legacy values are understood. Rows written before the workflow existed carry
 * 'open' and 'done'; those are mapped the same way canonicalStatus() maps them,
 * so a legacy row does not render as an unknown blank.
 */
import type { TaskStatus, LegacyTaskStatus } from '@/lib/employee-tasks';
import '../../styles/workforce.css';

export interface Props {
  status: TaskStatus | LegacyTaskStatus | string;
  /** Overrides the derived word. Pass STATUS_LABELS[s] to bind to the engine. */
  label?: string;
  /** 'sm' for inside a dense card, 'md' for a detail page heading row. */
  size?: 'sm' | 'md';
  /** Drops the word and leaves the glyph, with the word still in the DOM for
   *  assistive tech. For a column head that already says the status above it. */
  glyphOnly?: boolean;
  class?: string;
}

const { status, label, size = 'sm', glyphOnly = false, class: cls = '' } = Astro.props;

// The engine's own aliasing, in the two places it matters. Presentation-side
// normalisation only — employee-tasks.ts remains the authority on what a status
// means; this just refuses to render a blank for a row written last year.
const ALIASES = { open: 'assigned', done: 'completed' };

const raw = String(status || '').trim().toLowerCase();
const key = (ALIASES[raw as keyof typeof ALIASES] || raw) || 'assigned';

// Four container shapes across ten statuses, chosen so neighbours in the
// workflow never share one:
//   dashed ring   nothing has been handed over yet        draft
//   ring          live work, with the mark inside saying which kind
//   rounded sq.   the work is finished and signed         approved, completed
//   filing box    the task has left the board             archived
const GLYPHS = {
  // a ring that is not yet solid: nobody has been given this
  draft: '<circle cx="12" cy="12" r="8" stroke-dasharray="3 3"/>',
  // handed to someone: a mark travelling into the ring
  assigned: '<circle cx="12" cy="12" r="8"/><path d="M8.5 12h6.2"/><path d="m12.4 9.2 3 2.8-3 2.8"/>',
  // taken on, not started: the ring is ticked
  accepted: '<circle cx="12" cy="12" r="8"/><path d="m8.6 12.3 2.3 2.3 4.5-4.9"/>',
  // underway: the ring is half filled, which reads as progress at 14px
  in_progress: '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/>',
  // stopped by something: the ring is barred
  blocked: '<circle cx="12" cy="12" r="8"/><path d="M8 12h8"/>',
  // somebody is reading it
  under_review: '<path d="M2.6 12S6.2 6.2 12 6.2 21.4 12 21.4 12 17.8 17.8 12 17.8 2.6 12 2.6 12Z"/><circle cx="12" cy="12" r="2.4"/>',
  // signed off: two ticks, no container, so it cannot be confused with accepted
  approved: '<path d="m2.8 12.6 3.2 3.2 6.6-7"/><path d="m10.4 15 1.6 1.6 6.8-7.2"/>',
  // finished: a tick in a SQUARE. Deliberately a different container from
  // accepted's ring, because those two are the pair people misread.
  completed: '<rect x="4" y="4" width="16" height="16" rx="4"/><path d="m8.6 12.3 2.3 2.3 4.5-4.9"/>',
  // called off
  cancelled: '<circle cx="12" cy="12" r="8"/><path d="m9.2 9.2 5.6 5.6M14.8 9.2l-5.6 5.6"/>',
  // filed away
  archived: '<rect x="3" y="4" width="18" height="5" rx="1.5"/><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/>',
};

const glyph = GLYPHS[key as keyof typeof GLYPHS] || GLYPHS.assigned;

// 'under_review' gives 'Under review'. See the note above on why this is
// derived rather than imported.
const humanised = key.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const text = label || humanised;

// A tone this file has never seen falls back to the neutral ramp in
// workforce.css rather than rendering transparent on transparent.
const tone = GLYPHS[key as keyof typeof GLYPHS] ? key : 'draft';
---

<span
  class:list={['wf-badge', 'wf-badge--' + size, { 'wf-badge--glyph': glyphOnly }, cls]}
  data-wf-tone={tone}
>
  <svg
    class="wf-badge__glyph"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={glyph}
  />
  {glyphOnly
    ? <span class="wf-sr-only">{text}</span>
    : <span class="wf-badge__text">{text}</span>}
</span>

<style>
  .wf-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--wf-s-1);
    max-width: 100%;
    min-width: 0;
    padding: 3px 9px 3px 7px;
    border: 1px solid var(--wf-tone-border);
    border-radius: var(--wf-r-pill);
    background: var(--wf-tone-wash);
    color: var(--wf-tone-text);
    font-family: var(--wf-font);
    font-size: var(--wf-t-micro);
    font-weight: 600;
    line-height: 1.45;
    /* Not uppercase. Ten statuses at 11px in caps is a row of shapes nobody
       reads; sentence case is scanned, not decoded. */
    letter-spacing: 0.005em;
    vertical-align: middle;
  }

  .wf-badge--md {
    padding: 5px 12px 5px 9px;
    font-size: var(--wf-t-meta);
  }

  .wf-badge--glyph {
    padding: 4px;
  }

  .wf-badge__glyph {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }

  .wf-badge--md .wf-badge__glyph {
    width: 16px;
    height: 16px;
  }

  .wf-badge__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Windows high-contrast mode drops author colours entirely. The border keeps
     the pill's edge, and the glyph keeps the meaning. */
  @media (forced-colors: active) {
    .wf-badge {
      border-color: CanvasText;
    }
  }
</style>
