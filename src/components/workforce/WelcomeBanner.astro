---
/**
 * WelcomeBanner — who this person is, as recorded, and where their workspace stands right now.
 *
 * IT STATES ONLY WHAT WAS ACTUALLY READ. There is no greeting derived from a clock the database did
 * not supply ("Good morning" is a guess about a timezone that is wrong for someone), no role name
 * (the workspace context carries none, deliberately, so that a card and the query behind it cannot
 * answer differently), and no department when none is recorded. Every line here is either a value
 * that came back or is absent.
 *
 * IT IS THE MINIMAL-SET WIDGET, which is why it takes no loader and no employee id. When the
 * composition could NOT be resolved — a closed record, two records on one email, a lookup that did
 * not run — this still renders, so the workspace opens with a name and a sentence rather than a
 * blank screen. On that screen it is handed `degraded`, and it says so instead of pretending.
 *
 * NO EMOJI. The mark is the person's photo, or their initial.
 */
export interface Props {
  /** hr_employees.full_name, or users.name, or the email — resolved by the caller from the composed
   *  workspace. users has `name`, NOT full_name: four files queried full_name and 500ed a live page. */
  name: string;
  /** employee code, designation — identity and engagement only. Never gender, government ids,
   *  bank details or salary; the EMPLOYEE_COLUMNS allow-list exists so none of those are in scope. */
  designation?: string | null;
  employeeCode?: string | null;
  /** hr_employees.department_id resolved to a name. Absent is the ordinary case. */
  departmentName?: string | null;
  photoUrl?: string | null;
  /** Today, as the DATABASE counts it. Null withholds the date rather than printing the render
   *  process's idea of the day, which is off by one whenever the timezones differ. */
  today?: string | null;
  /** Something did not answer. The banner must not read as a confident all-clear over it. */
  degraded?: boolean;
  /** One short line about the day, supplied by the caller from data it already read. */
  standing?: string | null;
  class?: string;
}

const {
  name,
  designation = null,
  employeeCode = null,
  departmentName = null,
  photoUrl = null,
  today = null,
  degraded = false,
  standing = null,
  class: cls = '',
} = Astro.props;

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

// Formatted from the database's own date string, read in UTC. Parsing 'YYYY-MM-DD' with local
// getters lands on the previous day for anyone west of UTC.
const dateLabel = (() => {
  const iso = String(today || '').slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return '';
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return '';
  return DAYS[d.getUTCDay()] + ', ' + d.getUTCDate() + ' ' + MONTHS[d.getUTCMonth()];
})();

const initial = String(name || '?').trim().charAt(0).toUpperCase() || '?';
// Joined here rather than in JSX: three nested ternaries around a separator is a line nobody reads.
const subLine = [employeeCode, designation, departmentName].filter(Boolean).join(' · ');
---
<section class={`wb ${cls}`} aria-label="Your workspace">
  <div class="wb__row">
    {photoUrl
      ? <img class="wb__photo" src={photoUrl} alt="" width="48" height="48" loading="lazy" decoding="async" />
      : <span class="wb__photo wb__photo--initial" aria-hidden="true">{initial}</span>}
    <div class="wb__body">
      {dateLabel && <p class="wb__date">{dateLabel}</p>}
      <p class="wb__name">{name}</p>
      {subLine && <p class="wb__sub">{subLine}</p>}
    </div>
  </div>

  {standing && !degraded && <p class="wb__standing">{standing}</p>}

  {degraded && (
    <p class="wb__degraded">Part of your workspace could not be read just now, so what is below may be incomplete. Nothing you have logged is lost.</p>
  )}
</section>

<style>
  .wb {
    margin: 0 14px 12px;
    padding: 14px;
    background: var(--wf-surface, #fff);
    border: 1px solid var(--wf-line, #e5e7eb);
    border-radius: var(--wf-r-md, 12px);
    box-shadow: var(--wf-shadow-1, none);
  }
  .wb__row { display: flex; align-items: center; gap: 12px; }
  .wb__photo {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--wf-line, #e5e7eb);
  }
  .wb__photo--initial {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--wf-veil, #f6f5f3);
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--wf-ink-2, #564e43);
  }
  .wb__body { min-width: 0; flex: 1 1 auto; }
  .wb__date {
    margin: 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-micro, 0.6875rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wf-ink-3, #70685c);
  }
  .wb__name {
    margin: 2px 0 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-lg, 1.125rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--wf-ink, #111);
    overflow-wrap: anywhere;
  }
  .wb__sub {
    margin: 3px 0 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    line-height: 1.45;
    color: var(--wf-ink-3, #70685c);
    overflow-wrap: anywhere;
  }
  .wb__standing {
    margin: 10px 0 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    line-height: 1.55;
    color: var(--wf-ink-2, #564e43);
  }
  .wb__degraded {
    margin: 10px 0 0;
    padding: 9px 11px;
    background: var(--wf-due_soon-wash, #fff7ed);
    border: 1px solid var(--wf-due_soon-border, #fed7aa);
    border-radius: var(--wf-r-sm, 8px);
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    line-height: 1.55;
    color: var(--wf-due_soon-text, #73430d);
  }

  @media (forced-colors: active) {
    .wb, .wb__degraded { border-color: CanvasText; }
  }
</style>
