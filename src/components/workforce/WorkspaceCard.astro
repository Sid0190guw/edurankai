---
/**
 * WorkspaceCard — the shell every widget on a workspace surface renders inside.
 *
 * THE ONE THING IT ENFORCES STRUCTURALLY: "there is nothing" and "we could not read it" are
 * different sentences, and they cannot be collapsed into one by accident here. `failed` is checked
 * BEFORE `empty`, so a loader that returns ok:false can never render the reassuring copy — which is
 * the exact failure this codebase has shipped twice (a green flash over a write that never landed,
 * and "you have no tasks" over a query that threw). A caller that passes `failed` and forgets
 * `empty` still gets the honest branch; a caller that passes neither gets its own content.
 *
 * It is deliberately NOT a layout: it has no grid, no columns and no opinion about what goes in it.
 * Widgets differ far too much for a single body template, and a component that tries becomes a
 * second design system inside the first.
 *
 * Tokens come from src/styles/workforce.css. Nothing here invents a colour, a radius or a touch
 * target, so the contrast work and the reduced-motion handling are inherited rather than restated.
 */
export interface Props {
  title: string;
  /** Anchor id, for a quick action that jumps to a control living inside this card. */
  id?: string;
  /** The full surface behind this card. Null or omitted renders no link — which is correct whenever
   *  there is no page to send someone to, and far better than a link that bounces. */
  href?: string | null;
  /** The word on that link. "Open" by default; say something truer where you can. */
  hrefLabel?: string;
  /** A short figure or status shown at the top right. Never render one over a failed read. */
  meta?: string | null;
  /** THE READ DID NOT HAPPEN. Takes precedence over `empty` and over the slot. */
  failed?: boolean;
  failedMessage?: string;
  /** The read happened and there is genuinely nothing. */
  empty?: boolean;
  emptyMessage?: string;
  /** A caveat that is true even when there IS content: a partial list, a coverage gap, a limitation
   *  of the underlying table. Rendered under the body, in the same words on every card. */
  note?: string | null;
  /** Heading level, so a page keeps one outline. */
  headingLevel?: 2 | 3;
  /** Span the full width of a multi-column workspace. */
  full?: boolean;
  class?: string;
}

const {
  title,
  id,
  href = null,
  hrefLabel = 'Open',
  meta = null,
  failed = false,
  failedMessage = 'We could not read this just now. Nothing has been lost. Reload in a moment, and tell HR if it keeps happening.',
  empty = false,
  emptyMessage = 'Nothing here yet.',
  note = null,
  headingLevel = 3,
  full = false,
  class: cls = '',
} = Astro.props;

const Heading = headingLevel === 2 ? 'h2' : 'h3';
// Checked in this order on purpose — see the note at the top of this file.
const state = failed ? 'failed' : empty ? 'empty' : 'body';
---
<section class={`wsc ${full ? 'wsc--full' : ''} ${cls}`} id={id}>
  <div class="wsc__head">
    <Heading class="wsc__title">{title}</Heading>
    {/* A figure over a failed read is a claim the card is not in a position to make. */}
    {meta && !failed && <span class="wsc__meta wf-num">{meta}</span>}
    {href && (
      <a class="wsc__link wf-focusable" href={href}>
        {hrefLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    )}
  </div>

  <div class="wsc__body">
    {state === 'failed' && <p class="wsc__failed">{failedMessage}</p>}
    {state === 'empty' && <p class="wsc__empty">{emptyMessage}</p>}
    {state === 'body' && <slot />}
    {note && !failed && <p class="wsc__note">{note}</p>}
  </div>
</section>

<style>
  .wsc {
    margin: 0 14px 12px;
    background: var(--wf-surface, #fff);
    border: 1px solid var(--wf-line, #e5e7eb);
    border-radius: var(--wf-r-md, 12px);
    box-shadow: var(--wf-shadow-1, none);
    overflow: hidden;
  }
  .wsc__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--wf-line, #f0f0f0);
  }
  .wsc__title {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-body, 0.875rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--wf-ink, #111);
    overflow-wrap: anywhere;
  }
  .wsc__meta {
    flex: 0 0 auto;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    font-weight: 700;
    color: var(--wf-ink-3, #6b7280);
    white-space: nowrap;
  }
  /* A link inside a card head still has to be openable with a thumb, so it carries the touch floor
     as padding rather than as a height that would stretch the header. */
  .wsc__link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: var(--wf-touch, 44px);
    padding: 0 2px 0 8px;
    font-family: var(--wf-font, system-ui, sans-serif);
    font-size: var(--wf-t-meta, 0.75rem);
    font-weight: 700;
    color: var(--wf-info-text, #225281);
    text-decoration: none;
    white-space: nowrap;
  }
  .wsc__link svg { width: 13px; height: 13px; }

  .wsc__body { padding: 12px 14px; }

  .wsc__empty,
  .wsc__failed,
  .wsc__note {
    margin: 0;
    font-family: var(--wf-font, system-ui, sans-serif);
    line-height: 1.55;
  }
  .wsc__empty {
    font-size: var(--wf-t-meta, 0.75rem);
    color: var(--wf-ink-3, #6b7280);
  }
  /* due_soon, not danger: nothing is broken for the person reading it, but what is on screen is
     incomplete and they must not read it as an all-clear. */
  .wsc__failed {
    padding: 9px 11px;
    background: var(--wf-due_soon-wash, #fff7ed);
    border: 1px solid var(--wf-due_soon-border, #fed7aa);
    border-radius: var(--wf-r-sm, 8px);
    color: var(--wf-due_soon-text, #9a3412);
    font-size: var(--wf-t-meta, 0.75rem);
  }
  .wsc__note {
    margin-top: 10px;
    font-size: var(--wf-t-micro, 0.6875rem);
    color: var(--wf-ink-3, #6b7280);
  }

  @media (forced-colors: active) {
    .wsc, .wsc__failed { border-color: CanvasText; }
  }
</style>
