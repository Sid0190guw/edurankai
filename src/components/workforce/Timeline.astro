---
/**
 * Workforce / Timeline — one entry in a task's activity history.
 *
 * WHAT THIS IS FOR. Every write in src/lib/employee-tasks.ts calls logAudit()
 * with the actor, the roles they held, the status they moved the task from and
 * the one they moved it to. This renders one of those records as a sentence a
 * person can read: who, in what capacity, did what, from what, to what, when.
 *
 * IT RENDERS AN <li>, AND THE PAGE OWNS THE <ol>. Wrap entries in
 * `<ol class="wf-timeline">` (the reset lives in workforce.css). The list is the
 * page's because only the page knows whether it is showing five entries or
 * fifty, whether it is paginated, and what its heading is. A component that
 * rendered its own <ol> per item would emit one list per row, and a screen
 * reader would announce "list of 1" forty times.
 *
 * DESIGN DECISION — the timestamp is an ELAPSED INTERVAL, not a wall clock, and
 * that is a correctness decision rather than a stylistic one. This page renders
 * on a server whose timezone is not the reader's. A server-rendered "14:32" is
 * simply wrong for most of the people who will read it, and the usual fix — a
 * data-ts attribute and a line of script that rewrites it on load — means the
 * time is wrong until the script runs and stays wrong forever if it does not.
 * "4 hours ago" is the same number in every timezone on earth, so the no-script
 * rendering is correct for everyone, immediately. The exact instant is still in
 * the `datetime` attribute for machines, and `data-ts` is still on the element,
 * so the one-line localiser that src/pages/portal/employee.astro already runs
 * can upgrade it to a wall-clock time where that is genuinely more useful. The
 * page loses nothing by that script failing.
 *
 * The status change is shown with the same StatusBadge the board uses, so the
 * shape a person learned on the card is the shape they meet in the history.
 * Between the two, a visual arrow and the word "to" for anyone not reading the
 * arrow — the arrow is an SVG path, never a character in a string, because an
 * arrow character in .astro JSX is one of the parse traps this repo has hit.
 */
import StatusBadge from './StatusBadge.astro';
import '../../styles/workforce.css';

export interface Props {
  /** Who did it. */
  actor: string;
  /** In what capacity: pass ACTOR_ROLE_LABELS[r] ('the department lead'). */
  actorRole?: string | null;
  /** What they did, as a verb phrase: 'moved this task', 'added a comment'. */
  action: string;
  /** Previous and new value. Rendered as badges when kind is 'status'. */
  from?: string | null;
  to?: string | null;
  kind?: 'status' | 'text';
  /** ISO 8601. */
  at?: string | null;
  /** Optional link to whatever the entry is about. */
  href?: string | null;
  /** A short free-text note, e.g. the reason a task was blocked. */
  note?: string | null;
  class?: string;
}

const {
  actor,
  actorRole = null,
  action,
  from = null,
  to = null,
  kind = 'status',
  at = null,
  href = null,
  note = null,
  class: cls = '',
} = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Elapsed interval. Timezone-free by construction; see the note above. Past
// about a month an absolute date is more use than "43 days ago", and by then
// the at-most-one-day ambiguity of rendering it in UTC costs nobody anything.
const sinceText = (iso: string) => {
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  const secs = Math.floor((Date.now() - t) / 1000);
  if (secs < 0) return 'just now';
  if (secs < 60) return 'just now';
  const mins = Math.floor(secs / 60);
  if (mins < 60) return mins === 1 ? '1 minute ago' : mins + ' minutes ago';
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return hrs === 1 ? '1 hour ago' : hrs + ' hours ago';
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'yesterday';
  if (days < 31) return days + ' days ago';
  const d = new Date(t);
  const y = d.getUTCFullYear();
  const now = new Date().getUTCFullYear();
  return d.getUTCDate() + ' ' + MONTHS[d.getUTCMonth()] + (y === now ? '' : ' ' + y);
};

const when = at ? sinceText(at) : '';
const hasChange = Boolean(from || to);
const roleText = String(actorRole || '').trim();
---

<li class:list={['wf-tl', cls]}>
  <span class="wf-tl__rail" aria-hidden="true"><span class="wf-tl__dot"></span></span>

  <div class="wf-tl__body">
    <p class="wf-tl__line">
      <span class="wf-tl__actor">{actor}</span>
      {roleText && <span class="wf-tl__role">{'as ' + roleText}</span>}
      <span class="wf-tl__action">{action}</span>
    </p>

    {hasChange && (
      <p class="wf-tl__change">
        {from && (kind === 'status'
          ? <StatusBadge status={from} />
          : <span class="wf-tl__value">{from}</span>)}

        {from && to && (
          <>
            <svg class="wf-tl__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13" />
              <path d="m13 6 6 6-6 6" />
            </svg>
            <span class="wf-sr-only">to</span>
          </>
        )}

        {to && (kind === 'status'
          ? <StatusBadge status={to} />
          : <span class="wf-tl__value">{to}</span>)}
      </p>
    )}

    {note && <p class="wf-tl__note">{note}</p>}

    <p class="wf-tl__meta">
      {at
        ? <time class="wf-tl__time" datetime={at} data-ts={at}>{when}</time>
        : <span class="wf-tl__time">Time not recorded</span>}
      {href && <a class="wf-tl__link wf-focusable" href={href}>Open</a>}
    </p>
  </div>
</li>

<style>
  .wf-tl {
    display: flex;
    align-items: stretch;
    gap: var(--wf-s-3);
    margin: 0;
    padding: 0;
    font-family: var(--wf-font);
    color: var(--wf-ink);
  }

  /* The rail is one continuous line through the whole list, drawn per entry.
     The last entry's line is trimmed by :last-child so the history does not
     appear to carry on past its final record. */
  .wf-tl__rail {
    position: relative;
    flex: 0 0 auto;
    width: 9px;
    display: flex;
    justify-content: center;
  }

  .wf-tl__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--wf-line);
  }

  .wf-tl:first-child .wf-tl__rail::before {
    top: 9px;
  }

  .wf-tl:last-child .wf-tl__rail::before {
    bottom: auto;
    height: 9px;
  }

  .wf-tl__dot {
    position: relative;
    margin-top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--wf-ink-4);
    box-shadow: 0 0 0 3px var(--wf-surface);
  }

  .wf-tl__body {
    flex: 1 1 auto;
    min-width: 0;
    padding-bottom: var(--wf-s-4);
  }

  .wf-tl__line {
    margin: 0;
    font-size: var(--wf-t-meta);
    line-height: 1.55;
    color: var(--wf-ink-2);
    overflow-wrap: anywhere;
  }

  .wf-tl__actor {
    font-weight: 650;
    color: var(--wf-ink);
  }

  .wf-tl__role {
    color: var(--wf-ink-3);
  }

  .wf-tl__change {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wf-s-1) 6px;
    margin: var(--wf-s-2) 0 0;
  }

  .wf-tl__arrow {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    color: var(--wf-ink-4);
  }

  .wf-tl__value {
    padding: 2px 8px;
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-pill);
    background: var(--wf-veil);
    color: var(--wf-ink-2);
    font-size: var(--wf-t-micro);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .wf-tl__note {
    margin: var(--wf-s-2) 0 0;
    padding-left: var(--wf-s-2);
    border-left: 2px solid var(--wf-line-strong);
    font-size: var(--wf-t-meta);
    line-height: 1.55;
    color: var(--wf-ink-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .wf-tl__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wf-s-3);
    margin: var(--wf-s-1) 0 0;
    font-size: var(--wf-t-micro);
    color: var(--wf-ink-3);
  }

  .wf-tl__link {
    /* An inline link inside a block of text; WCAG 2.2 exempts these from the
       target-size minimum, and padding it to 44px would push the rail apart. */
    color: var(--wf-info-text);
    font-weight: 600;
    text-decoration: none;
  }

  .wf-tl__link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (forced-colors: active) {
    .wf-tl__dot {
      background: CanvasText;
    }
  }
</style>
