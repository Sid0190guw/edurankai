---
/**
 * Workforce / AvatarStack — who is on this task.
 *
 * WHAT THIS IS FOR. listCollaborators() in src/lib/employee-tasks.ts returns
 * TaskCollaborator rows carrying `name` and `roleLabel`. This renders a few of
 * them as overlapping initials with a plus-N for the rest, on a card face, in a
 * board column, or in a table row.
 *
 * THE NAMES ARE IN THE DOM. NOT IN A title ATTRIBUTE. That is the entire point
 * of this component and it is worth being blunt about, because `title` is the
 * default way everyone builds this and it fails three of the four people it is
 * supposed to serve: it never appears on a touch screen, which is where most of
 * this product is used; it is not reachable by keyboard at all; and screen
 * reader support for it is inconsistent enough that WCAG guidance is to not
 * rely on it. So every avatar carries its person's full name and role as real
 * text, hidden visually with .wf-sr-only, and the plus-N chip carries the names
 * of everyone it is standing in for. A screen reader reads out the same eight
 * people a sighted user would find by opening the task. Nothing is only a
 * picture.
 *
 * DESIGN DECISION — these are not links, and the component refuses to make them
 * links. An avatar in a stack is 22px and overlaps its neighbour by eight: as a
 * control that is a quarter of the 44px target this set holds to, sitting on
 * top of another quarter-size control. There is no way to make an overlapping
 * stack of small discs keyboard-operable or thumb-operable without unstacking
 * it, at which point it is a list and not a stack. So the stack is text, the
 * whole <ul> is inert, and a caller who needs it to open something puts it
 * inside one properly-sized control — a card link, a details summary — where
 * one target covers the whole group. Presentation that cannot be operated
 * safely should not pretend to be operable.
 *
 * A person with no name renders a figure glyph, never a question mark or the
 * word "Unknown". A colleague whose row did not resolve is a data problem, and
 * putting a shrug in the middle of a team is the product being rude about
 * somebody on their own behalf.
 */
import '../../styles/workforce.css';

export interface Props {
  /** Pass TaskCollaborator rows: `role` wants c.roleLabel, the engine's own
   *  wording ('Working on it' for co_assignee), not the raw enum. */
  people: Array<{ name?: string | null; role?: string | null; id?: string | null }>;
  /** How many faces before the plus-N. Four is the most that fits at 360px
   *  beside a title and a due date. */
  max?: number;
  size?: 'sm' | 'md';
  /** The accessible name of the group. */
  label?: string;
  class?: string;
}

const {
  people = [],
  max = 3,
  size = 'sm',
  label = 'On this task',
  class: cls = '',
} = Astro.props;

const clean = (people || []).filter(Boolean);

// A plus-1 chip is wider than the avatar it replaces and saves nothing, so the
// cut only happens when it actually buys a row back.
const cap = Math.max(1, max);
const overflows = clean.length > cap + 1;
const shown = overflows ? clean.slice(0, cap) : clean;
const hiddenPeople = overflows ? clean.slice(cap) : [];

const displayName = (p: { name?: string | null }) => String(p?.name || '').trim();

const initialsOf = (name: string) => {
  const parts = name.split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
};

const described = (p: { name?: string | null; role?: string | null }) => {
  const n = displayName(p) || 'Name not on record';
  const r = String(p?.role || '').trim();
  return r ? n + ' (' + r + ')' : n;
};

const PERSON_GLYPH =
  '<path d="M19 20.5v-1.6a3.9 3.9 0 0 0-3.9-3.9H8.9A3.9 3.9 0 0 0 5 18.9v1.6"/>' +
  '<circle cx="12" cy="7.6" r="3.9"/>';

const hiddenNames = hiddenPeople.map(described).join(', ');
---

{clean.length > 0 && (
  <ul class:list={['wf-avatars', 'wf-avatars--' + size, cls]} aria-label={label}>
    {shown.map((p) => {
      const name = displayName(p);
      const initials = initialsOf(name);
      return (
        <li class="wf-avatars__item">
          <span class="wf-avatars__disc" aria-hidden="true">
            {initials
              ? initials
              : (
                <svg
                  class="wf-avatars__figure"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={PERSON_GLYPH}
                />
              )}
          </span>
          <span class="wf-sr-only">{described(p)}</span>
        </li>
      );
    })}

    {overflows && (
      <li class="wf-avatars__item">
        <span class="wf-avatars__disc wf-avatars__disc--more" aria-hidden="true">
          {'+' + hiddenPeople.length}
        </span>
        {/* The point of the whole component: the people behind the plus-N are
            readable, not merely counted. */}
        <span class="wf-sr-only">{'and ' + hiddenPeople.length + ' more: ' + hiddenNames}</span>
      </li>
    )}
  </ul>
)}

<style>
  .wf-avatars {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--wf-font);
    /* Inert: see the note on why these are not controls. */
    pointer-events: none;
  }

  .wf-avatars__item {
    display: inline-flex;
    margin: 0;
    padding: 0;
  }

  .wf-avatars__item + .wf-avatars__item {
    margin-left: -8px;
  }

  .wf-avatars__disc {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--wf-veil);
    color: var(--wf-ink-2);
    /* The ring is the page surface, not a colour, so overlapping discs read as
       separate people on a card, in a sunk column, and on the page ground
       alike. It is drawn as a box-shadow rather than a border so the ring does
       not eat into the 24px and shrink the initials. */
    box-shadow: 0 0 0 2px var(--wf-surface);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    user-select: none;
  }

  .wf-avatars--md .wf-avatars__disc {
    width: 32px;
    height: 32px;
    font-size: var(--wf-t-meta);
  }

  .wf-avatars--md .wf-avatars__item + .wf-avatars__item {
    margin-left: -10px;
  }

  .wf-avatars__disc--more {
    background: var(--wf-sunk);
    color: var(--wf-ink-3);
    font-weight: 700;
  }

  .wf-avatars__figure {
    width: 15px;
    height: 15px;
    color: var(--wf-ink-3);
  }

  .wf-avatars--md .wf-avatars__figure {
    width: 19px;
    height: 19px;
  }

  @media (forced-colors: active) {
    .wf-avatars__disc {
      border: 1px solid CanvasText;
    }
  }
</style>
