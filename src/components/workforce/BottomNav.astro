---
/**
 * Workforce / BottomNav — the portal's fixed bottom tab bar.
 *
 * WHAT THIS IS FOR. The same tab bar is written out by hand in three files
 * today: src/pages/portal/employee.astro (markup at line 1084, CSS at 549),
 * src/pages/portal/discussion.astro (292 / 145) and
 * src/pages/portal/interviews.astro (120 / 41). The `.bottom-nav` and
 * `.nav-btn` rules in those three files are byte-identical apart from three
 * extra declarations discussion.astro carries so the same class can dress a
 * <button> (`border:none;background:none;cursor:pointer`) — folded in here, so
 * one component covers all three. This file is the single copy. It is NOT yet
 * wired into those pages; swapping them is a separate change (see the note at
 * the bottom of this comment).
 *
 * THE ITEM SETS ARE NOT ACTUALLY IDENTICAL, WHICH IS THE WHOLE REASON THIS
 * TAKES A PROP RATHER THAN NONE. The bar looks the same on all three pages and
 * is not: employee.astro's fourth tab is "My HR" pointing at /portal/employee,
 * discussion.astro's is "Profile" pointing at /portal/enroll-face, and
 * interviews.astro replaces the second tab entirely with "Interviews" and
 * pushes Community to fourth. Three near-copies drifting apart is exactly how
 * that happens, and it is why `variant` names a whole SET rather than letting a
 * caller assemble one item at a time: the sets below are the three that exist,
 * reproduced link for link and label for label, so a page swaps to this
 * component by naming its variant and nothing about where its tabs point can
 * change by accident.
 *
 * DESIGN DECISION — the inactive label is #7C7C88, not the #6E6E78 production
 * ships. Ruling 4 says accessibility is not negotiable, and the production
 * value measures 3.79:1 against the #0F0F14 bar. These labels are 10px, so
 * WCAG 2.2 AA wants 4.5:1. #7C7C88 is the smallest lift that clears it
 * (4.64:1) — close enough that nobody will notice the bar changed, far enough
 * that a person on a phone in daylight can read the tab they are not on. The
 * active orange was already fine at 6.96:1 and is untouched. Both live in
 * workforce.css as --wf-nav-ink / --wf-nav-ink-active with the measurements
 * written next to them.
 *
 * Three more things this bar gains that the hand-written copies never had, all
 * of them free: an accessible name on the <nav>, aria-current="page" on the tab
 * you are on (today the only signal is colour, so a screen reader announces
 * four identical links), and a visible focus ring — a keyboard user currently
 * cannot see which tab they have landed on at all.
 *
 * NO MOTION. A tab bar that animates is a tab bar that is slower than the
 * navigation it triggers. Pressing a tab dims it by opacity for as long as the
 * finger is down (Ruling 1: that is feedback, not decoration) and nothing else
 * moves, ever.
 *
 * TO SWAP A PAGE OVER (a later change, deliberately not done here):
 *   1. import BottomNav from '@/components/workforce/BottomNav.astro'
 *   2. replace the <nav class="bottom-nav"> block with, respectively,
 *        employee.astro    <BottomNav variant="hr"         active="hr" />
 *        discussion.astro  <BottomNav variant="community"  active="community" />
 *        interviews.astro  <BottomNav variant="interviews" active="interviews" />
 *   3. delete the now-dead `.bottom-nav` / `.nav-btn` / `.nav-btn.active` rules
 *      from that page's <style> block. They are scoped, so they cannot reach
 *      this component's markup and would style nothing.
 *   4. KEEP the page's `body { padding-bottom: … }`. The bar is position:fixed
 *      and takes no space in flow; this component cannot set that for you
 *      without reaching outside itself into the page's own body rule.
 */
import '../../styles/workforce.css';

export interface Props {
  /** Which item SET to render. See the note above on why these are not one set. */
  variant?: 'hr' | 'community' | 'interviews' | 'tasks';
  /** Key of the tab the person is currently on: gets the accent and aria-current. */
  active?: string;
  /** Full override, when a surface needs a bar none of the variants describe.
   *
   *  `badge` is HOW MANY THINGS ARE WAITING behind that tab. Omit it, or pass 0, and nothing renders:
   *  a bar of "0" pills is a bar whose pills nobody reads. The caller supplies the number — this
   *  component neither counts nor authorises anything, exactly as it does not for `href`.
   *
   *  `hint` is appended to the tab's accessible name and is the only place the count is spoken. The
   *  pill itself is aria-hidden, because "Approvals 3" read as two unrelated fragments is worse than
   *  "Approvals, 3 waiting" read as one sentence. */
  items?: Array<{ key: string; href: string; label: string; icon?: string; badge?: number; hint?: string }>;
  /** The accessible name of the landmark. Change it only if a page has two navs. */
  label?: string;
  class?: string;
}

const {
  variant = 'hr',
  active = '',
  items,
  label = 'Primary',
  class: cls = '',
} = Astro.props;

// Lucide-weight line icons, drawn at 24 and rendered at 20 exactly as the three
// live pages do. Object literal rather than a typed map: a `Record<string,string>`
// annotation reaching the template is one of the .astro parse traps this repo
// has been bitten by.
const ICONS = {
  grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  checklist: '<path d="M10 6h10M10 12h10M10 18h10"/><path d="M3.5 6 4.8 7.3 7.2 5"/><path d="M3.5 12l1.3 1.3L7.2 11"/><path d="M3.5 18l1.3 1.3L7.2 17"/>',
  // The More tab used to fall back to `grid`, which is also Home's glyph — two of the four tabs
  // wearing the same picture. The labels here are 10px, which makes the icon the primary scan
  // target, so Home and More were interchangeable at a glance. Three rules, monochrome, no emoji.
  menu: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
};

// Every tab that exists, with the href and the label the live pages use. One
// definition each, so "Community" cannot come to mean two different URLs.
const TABS = {
  home: { href: '/portal', label: 'Home', icon: 'grid' },
  community: { href: '/portal/discussion', label: 'Community', icon: 'message' },
  learn: { href: '/portal/courses', label: 'Learn', icon: 'book' },
  hr: { href: '/portal/employee', label: 'My HR', icon: 'user' },
  // Profile opens the person's PROFILE, not a camera. This pointed at /portal/enroll-face, so
  // tapping Profile started face enrolment — one security feature standing in for an entire
  // identity surface. Face recognition now lives under Security > Biometric Authentication and
  // opens only when explicitly chosen. See docs/workforce-os/ACCOUNT_CENTER.md.
  profile: { href: '/portal/profile', label: 'Profile', icon: 'user' },
  interviews: { href: '/portal/interviews', label: 'Interviews', icon: 'calendar' },
  tasks: { href: '/portal/tasks', label: 'Tasks', icon: 'checklist' },
};

// The three bars that exist in production today, in their exact order, plus one
// for the task board.
const SETS = {
  // Tasks replaces Learn in the default bar. The complaint that prompted this was that the pieces
  // exist but are not reachable from one another: Tasks, Approvals and Workspace all shipped, and
  // the bar still showed the four tabs from before any of them were built. A feature nobody can
  // navigate to is the same as a feature that does not exist, and it is worse than that — it also
  // makes the product feel scattered to the people who know it is there somewhere.
  //
  // Learn moves into My HR rather than being dropped: five tabs at 360px gives ~72px each, and the
  // labels are 10px. Four is the honest ceiling for this width.
  hr: ['home', 'tasks', 'community', 'hr'],
  community: ['home', 'tasks', 'community', 'profile'],
  interviews: ['home', 'interviews', 'learn', 'community'],
  tasks: ['home', 'tasks', 'learn', 'hr'],
};

const keys = SETS[variant] || SETS.hr;

// A count is only ever a whole number above zero. Anything else — NaN from a failed query, a
// negative from a subtraction, a string straight off a pg row — becomes 0 and renders nothing,
// because the alternative is a pill reading "NaN" on the most-looked-at element on the phone.
// Capped at 99 with a "99+" face: a four-digit pill widens a ~90px tab, and that is the one way a
// fixed bar makes the page scroll sideways at 360px.
const countOf = (n: unknown) => {
  const v = Number(n);
  return Number.isFinite(v) && v > 0 ? Math.floor(v) : 0;
};

const resolved = (items && items.length)
  ? items.map((it) => ({
      key: it.key,
      href: it.href,
      label: it.label,
      glyph: ICONS[(it.icon || 'grid') as keyof typeof ICONS] || ICONS.grid,
      count: countOf(it.badge),
      hint: it.hint || '',
    }))
  : keys.map((k) => {
      const t = TABS[k as keyof typeof TABS];
      return {
        key: k,
        href: t.href,
        label: t.label,
        glyph: ICONS[t.icon as keyof typeof ICONS] || ICONS.grid,
        count: 0,
        hint: '',
      };
    });

// The tab's accessible name. Built here rather than in the template because the count belongs IN the
// name — a screen reader that reads "Approvals" and then, separately, "3" has told somebody two
// things and connected neither. The pill in the markup is aria-hidden for exactly that reason.
const nameOf = (t: { label: string; count: number; hint: string }) => {
  if (t.hint) return t.label + ', ' + t.hint;
  if (t.count > 0) return t.label + ', ' + t.count + ' waiting';
  return '';
};
---

<nav class:list={['wf-bottomnav', cls]} aria-label={label}>
  {resolved.map((tab) => (
    <a
      href={tab.href}
      class:list={['wf-bottomnav__tab', 'wf-focusable', { 'is-active': tab.key === active }]}
      aria-current={tab.key === active ? 'page' : undefined}
      aria-label={nameOf(tab) || undefined}
    >
      <span class="wf-bottomnav__mark">
        <svg
          class="wf-bottomnav__icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          set:html={tab.glyph}
        />
        {tab.count > 0 && (
          <span class="wf-bottomnav__badge" aria-hidden="true">{tab.count > 99 ? '99+' : tab.count}</span>
        )}
      </span>
      <span class="wf-bottomnav__label">{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  /* Geometry reproduced from the three live pages, declaration for declaration:
     fixed to the bottom edge, full width, flex row, z-index 40, and the safe-area
     inset so the bar clears the home indicator on a notched phone. */
  .wf-bottomnav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    background: var(--wf-nav-surface);
    border-top: 1px solid var(--wf-nav-line);
    padding-bottom: env(safe-area-inset-bottom);
    font-family: var(--wf-font);
  }

  .wf-bottomnav__tab {
    flex: 1;
    /* The four tabs split the width evenly. min-width:0 lets a long label
       ellipsis instead of pushing the bar wider than the phone — the one way a
       tab bar can cause a horizontal page scroll at 360px. */
    min-width: 0;
    /* 8px + 20px icon + 3px gap + ~12px label + 8px comes to about 51px on its
       own; the floor is stated anyway so a wrapped or scaled label can never
       drop the target under the 44px this set holds to. */
    min-height: var(--wf-touch);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 8px 4px;
    text-decoration: none;
    color: var(--wf-nav-ink);
    font-size: 10px;
    line-height: 1.2;
    /* so the same class can dress a <button>, as discussion.astro's copy does */
    border: none;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .wf-bottomnav__tab.is-active {
    color: var(--wf-nav-ink-active);
  }

  /* The icon and its count share one positioning context. The mark is the size of
     the icon and nothing more, so the pill hangs off the glyph rather than off the
     whole tab — which would put it over the neighbouring tab's label at 360px. */
  .wf-bottomnav__mark {
    position: relative;
    display: block;
    flex: 0 0 auto;
    line-height: 0;
  }

  .wf-bottomnav__icon {
    flex: 0 0 auto;
    display: block;
  }

  /* THE COUNT. Not a bare dot: "something is waiting" and "eleven things are
     waiting" are different sentences, and the second is the one that gets a
     manager to open the queue. aria-hidden, because the number is already in the
     tab's accessible name as a sentence — see nameOf() above.

     Colour is the active accent (--wf-nav-ink-active, measured at 6.96:1 on this
     bar) with the bar's own surface as the text, so it reads at 9px and survives
     forced-colors, where both tokens are handed back to the system. */
  .wf-bottomnav__badge {
    position: absolute;
    top: -5px;
    left: 11px;
    min-width: 15px;
    height: 15px;
    padding: 0 4px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--wf-nav-ink-active);
    color: var(--wf-nav-surface);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    /* Against the dark bar, so a pill sitting over the glyph still reads as separate from it. */
    border: 1.5px solid var(--wf-nav-surface);
  }

  @media (forced-colors: active) {
    .wf-bottomnav__badge {
      border-color: CanvasText;
    }
  }

  .wf-bottomnav__label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The page ring is only 3.65:1 against this bar, so the bar carries its own
     at 5.87:1. Inset rather than outset: an outset ring on a bar flush with the
     bottom of the viewport is clipped on its lower edge and reads as a smudge. */
  .wf-bottomnav__tab:focus-visible {
    outline: 2px solid var(--wf-nav-focus);
    outline-offset: -3px;
    border-radius: var(--wf-r-sm);
  }

  /* Ruling 1: this communicates "your press landed", which is the one thing a
     tab bar has to say before the next page paints. Opacity only, no transform,
     and gone the moment the finger lifts. */
  .wf-bottomnav__tab:active {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-bottomnav__tab:active {
      opacity: 1;
    }
  }
</style>
