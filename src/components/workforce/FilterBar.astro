---
/**
 * Workforce / FilterBar — narrowing a board or a list, in the URL.
 *
 * DESIGN DECISION — method="GET", AND THAT IS THE WHOLE COMPONENT. Filters go
 * in the query string, so:
 *
 *   - they survive a POST. The board moves a task with a form POST and the
 *     page redirects back to itself; anything held only in memory or in a
 *     hidden field is gone by then, and the reader who had narrowed to "urgent,
 *     overdue, mine" is dumped back on the full board every time they tick
 *     something off. That is the single most annoying thing a task board can do.
 *   - they are shareable. "Have a look at this" is a link, not six sentences of
 *     instructions about which dropdowns to set.
 *   - Back works. The browser's history already is the undo stack for a filter
 *     change; nothing here has to implement one.
 *   - it works with no script at all. A <form method="GET"> plus a submit
 *     button is a complete filtering system, and this component ships exactly
 *     that. There is no JavaScript in this file.
 *
 * DESIGN DECISION — `carry` re-emits parameters the bar does not own as hidden
 * inputs. A GET form replaces the ENTIRE query string with its own fields, so a
 * bar that does not know about `col` or `page` silently deletes them the first
 * time somebody changes a filter. That is a bug people report as "it keeps
 * jumping back to the first column" and it is never traced to the filter bar.
 * Passing them through is one line at the call site and removes the whole class.
 *
 * The Clear control is an anchor to the bare path, not a reset button:
 * <button type="reset"> restores the form to what the server rendered, which on
 * a filtered page means restoring the filters, which is the opposite of what
 * the word Clear means to the person pressing it.
 */
import '../../styles/workforce.css';

export interface Props {
  /** Where the form submits. Omit to submit to the page it is on. */
  action?: string;
  fields: Array<{
    name: string;
    label: string;
    type?: 'select' | 'text' | 'checkbox';
    value?: string | null;
    checked?: boolean;
    /** For 'select'. The first option is the do-not-filter one. */
    options?: Array<{ value: string; label: string }>;
    placeholder?: string;
  }>;
  /** Query params the bar does not own but must not drop. */
  carry?: Array<{ name: string; value: string }>;
  submitLabel?: string;
  /** Href for Clear. Omit to hide it. */
  clearHref?: string;
  clearLabel?: string;
  /** Accessible name for the surrounding region. */
  label?: string;
  /** Rendered at the end of the bar, e.g. "12 tasks, 3 overdue". */
  summary?: string;
  class?: string;
}

const {
  action,
  fields = [],
  carry = [],
  submitLabel = 'Apply',
  clearHref,
  clearLabel = 'Clear',
  label = 'Filters',
  summary,
  class: cls = '',
} = Astro.props;

const idFor = (name: string) => 'wf-f-' + String(name).replace(/[^a-zA-Z0-9_-]/g, '');

// A name the bar renders as a field must not ALSO be re-emitted as a hidden
// input, or the server receives it twice and reads whichever its form parser
// happens to pick. The field wins, because that is the one the person just set.
const owned = new Set(fields.map((f) => f.name));
const passthrough = (carry || []).filter((p) => p && p.name && !owned.has(p.name));
---

{/* role="search" rather than the <search> element. <search> is a 2023 addition
    and an older Android WebView parses it as an unknown inline element with no
    role at all, which is exactly the device Ruling 3 says to put first. The
    role attribute maps to the same thing everywhere, including there. */}
<div class:list={['wf-filters', cls]} role="search" aria-label={label}>
  <form class="wf-filters__form" method="GET" action={action}>
    {passthrough.map((p) => (
      <input type="hidden" name={p.name} value={p.value} />
    ))}

    <div class="wf-filters__grid">
      {fields.map((f) => {
        const type = f.type || 'select';
        const id = idFor(f.name);

        if (type === 'checkbox') {
          return (
            <div class="wf-filters__check">
              <input
                type="checkbox"
                id={id}
                name={f.name}
                value={f.value || '1'}
                checked={Boolean(f.checked)}
                class="wf-filters__box"
              />
              <label for={id} class="wf-filters__checklabel">{f.label}</label>
            </div>
          );
        }

        if (type === 'text') {
          return (
            <div class="wf-filters__field">
              <label for={id} class="wf-filters__label">{f.label}</label>
              <input
                type="text"
                id={id}
                name={f.name}
                value={f.value || ''}
                placeholder={f.placeholder}
                class="wf-filters__input"
                autocomplete="off"
              />
            </div>
          );
        }

        return (
          <div class="wf-filters__field">
            <label for={id} class="wf-filters__label">{f.label}</label>
            <select id={id} name={f.name} class="wf-filters__input">
              {(f.options || []).map((o) => (
                <option value={o.value} selected={String(f.value || '') === String(o.value)}>
                  {o.label}
                </option>
              ))}
            </select>
          </div>
        );
      })}
    </div>

    <div class="wf-filters__actions">
      <button class="wf-filters__submit wf-focusable" type="submit">{submitLabel}</button>
      {clearHref && <a class="wf-filters__clear wf-focusable" href={clearHref}>{clearLabel}</a>}
      {summary && <p class="wf-filters__summary" aria-live="polite">{summary}</p>}
    </div>
  </form>
</div>

<style>
  .wf-filters {
    display: block;
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    font-family: var(--wf-font);
    color: var(--wf-ink);
  }

  .wf-filters__form {
    padding: var(--wf-s-3);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-md);
    background: var(--wf-surface);
  }

  /* One column at 360px. auto-fit rather than a media query, so the bar reflows
     on the actual space it has and not on the width of the viewport — it is
     correct inside a narrow board column and inside a wide page. */
  .wf-filters__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--wf-s-3);
  }

  .wf-filters__field {
    min-width: 0;
  }

  .wf-filters__label {
    display: block;
    margin-bottom: var(--wf-s-1);
    font-size: var(--wf-t-micro);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--wf-ink-3);
  }

  .wf-filters__input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: var(--wf-touch);
    padding: var(--wf-s-2) var(--wf-s-3);
    border: 1px solid var(--wf-line-strong);
    border-radius: var(--wf-r-sm);
    background: var(--wf-raised);
    color: var(--wf-ink);
    font-family: inherit;
    /* 16px, so iOS Safari does not zoom the page when a field takes focus. */
    font-size: 1rem;
    line-height: 1.4;
  }

  .wf-filters__input:focus-visible {
    outline: 2px solid var(--wf-focus);
    outline-offset: 1px;
    border-color: var(--wf-focus);
  }

  .wf-filters__check {
    display: flex;
    align-items: center;
    gap: var(--wf-s-2);
    min-height: var(--wf-touch);
    min-width: 0;
  }

  .wf-filters__box {
    /* 22px, and the label beside it is part of the target because it is a real
       <label for>. Together they clear 44px comfortably. */
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    accent-color: var(--wf-ink);
    cursor: pointer;
  }

  .wf-filters__box:focus-visible {
    outline: 2px solid var(--wf-focus);
    outline-offset: 2px;
  }

  .wf-filters__checklabel {
    font-size: var(--wf-t-body);
    color: var(--wf-ink-2);
    cursor: pointer;
    min-width: 0;
  }

  .wf-filters__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wf-s-3);
    margin-top: var(--wf-s-3);
  }

  .wf-filters__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--wf-touch);
    padding: var(--wf-s-2) var(--wf-s-5);
    border: 1px solid var(--wf-ink);
    border-radius: var(--wf-r-sm);
    background: var(--wf-ink);
    color: var(--wf-surface);
    font-family: inherit;
    font-size: var(--wf-t-body);
    font-weight: 650;
    cursor: pointer;
  }

  .wf-filters__submit:active {
    opacity: 0.8;
  }

  .wf-filters__clear {
    display: inline-flex;
    align-items: center;
    min-height: var(--wf-touch);
    color: var(--wf-ink-3);
    font-size: var(--wf-t-meta);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wf-filters__summary {
    margin: 0;
    font-size: var(--wf-t-meta);
    color: var(--wf-ink-3);
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-filters__submit:active {
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .wf-filters__form {
      border-color: CanvasText;
    }
  }
</style>
