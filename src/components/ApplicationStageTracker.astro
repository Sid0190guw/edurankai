---
import { STAGES, stageIndex, isTerminalStage, stageDescriptor } from '@/lib/application-stages';

interface Props {
  currentStage: string;
  events?: any[];
}
const { currentStage, events = [] } = Astro.props;

// A CLOSED APPLICATION IS NOT STEP ONE.
//
// stageIndex() answers 0 for any key it does not recognise, and the two endings of this funnel
// ('decision_no', 'withdrawn') are not among the six open steps. So a closed or withdrawn
// application rendered as "01 · Submitted — your application is in our queue", to the one person
// who most needs to be told it is over. The ending is now drawn as an ending: the steps that were
// actually reached stay filled from the stage history, no open step is marked as current, and the
// panel underneath carries the closing sentence instead of an opening one.
const closedNow = isTerminalStage(currentStage);
const closing = closedNow ? stageDescriptor(currentStage) : null;

let reachedIdx = -1;
if (closedNow) {
  for (const e of events) {
    const i = STAGES.findIndex(s => s.key === e.to_stage);
    if (i > reachedIdx) reachedIdx = i;
  }
} else {
  reachedIdx = stageIndex(currentStage);
}
const filledThrough = closedNow ? reachedIdx + 1 : reachedIdx;   // exclusive bound for "done"
const currentIdx = closedNow ? -1 : reachedIdx;
const panel = closing || STAGES[stageIndex(currentStage)];

function fmt(d: any) { try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'short' }); } catch { return ''; } }
const eventsByStage: Record<string, any> = {};
for (const e of events) eventsByStage[e.to_stage] = e;
---
<div class="bg-white border border-ink/10 rounded-2xl p-5 md:p-7 mb-6">
  <p class="text-[0.62rem] font-mono uppercase tracking-[0.16em] text-burn font-bold mb-3">Recruitment funnel · Six steps. No surprises.</p>

  <div class="grid gap-3" style="grid-template-columns: repeat(6, minmax(0, 1fr));">
    {STAGES.map((s, i) => {
      const isDone = i < filledThrough;
      const isCurrent = i === currentIdx;
      const ev = eventsByStage[s.key];
      return (
        <div class="relative">
          {i < STAGES.length - 1 && (
            <div class="absolute top-3 left-[calc(50%+12px)] right-[-50%] h-[2px]" style={`background: ${isDone ? '#FF4F00' : 'rgba(14,11,8,0.10)'};`}></div>
          )}
          <div class="relative flex flex-col items-center">
            <div class={`flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center font-mono text-[0.65rem] font-bold ${isCurrent ? 'bg-burn text-white' : isDone ? 'bg-burn text-white' : 'bg-cream-2 text-ink-soft border border-ink/15'}`}>{isDone ? '✓' : i + 1}</div>
            <p class={`text-[0.6rem] font-mono uppercase tracking-[0.1em] font-bold mt-2 text-center leading-tight ${isCurrent ? 'text-burn' : isDone ? 'text-ink' : 'text-ink-soft'}`}>{s.label}</p>
            {ev && <p class="text-[0.6rem] text-ink-soft mt-0.5 m-0 font-mono">{fmt(ev.created_at)}</p>}
          </div>
        </div>
      );
    })}
  </div>

  <div class={closedNow
    ? 'mt-6 bg-ink/[0.04] border border-ink/15 rounded-xl p-4'
    : 'mt-6 bg-cream-2/60 border border-ink/10 rounded-xl p-4'}>
    <p class={closedNow
      ? 'text-[0.6rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold m-0 mb-1.5'
      : 'text-[0.6rem] font-mono uppercase tracking-[0.14em] text-burn font-bold m-0 mb-1.5'}>{panel.short}</p>
    <p class="text-[0.92rem] text-ink-2 leading-relaxed m-0">{panel.blurb}</p>
  </div>
</div>
