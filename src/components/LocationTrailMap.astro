---
// LocationTrailMap — plots an application's location trail for a super admin.
//
// DELIBERATELY TILE-FREE. Loading map tiles from a third party would send this applicant's
// coordinates to that provider on every page view — which defeats the point of a privacy-sensitive
// audit tool, and cuts against keeping core capability first-party. So the map is drawn from our own
// coordinates as inline SVG: no external requests, works offline, and nothing leaks.
//
// Third-party imagery is still one click away, but only on a deliberate click, and only for the
// single point the reviewer chose.
import type { LocationPoint, VpnAssessment } from '@/lib/applicant-location';

interface Props {
  trail: LocationPoint[];
  vpn: VpnAssessment;
  flags: string[];
}
const { trail, vpn, flags } = Astro.props as Props;

const pts = trail.filter((p) => p.latitude != null && p.longitude != null);

// Bounding box with a little padding, so a single point still renders sensibly.
const lats = pts.map((p) => p.latitude as number);
const lons = pts.map((p) => p.longitude as number);
const pad = 2;
const box = pts.length
  ? {
      west: Math.max(-180, Math.min(...lons) - pad), east: Math.min(180, Math.max(...lons) + pad),
      south: Math.max(-90, Math.min(...lats) - pad), north: Math.min(90, Math.max(...lats) + pad),
    }
  : { west: 60, east: 100, south: 5, north: 40 };   // fall back to a view of India
// Keep a minimum span or a single point produces a degenerate viewBox.
if (box.east - box.west < 4) { const c = (box.east + box.west) / 2; box.west = c - 2; box.east = c + 2; }
if (box.north - box.south < 4) { const c = (box.north + box.south) / 2; box.south = c - 2; box.north = c + 2; }

const W = 720, H = 380;
// Equirectangular projection into the SVG box. Fine at this scale and needs no dependency.
const px = (lon: number) => ((lon - box.west) / (box.east - box.west)) * W;
const py = (lat: number) => H - ((lat - box.south) / (box.north - box.south)) * H;

const plotted = pts.map((p, i) => ({
  ...p,
  x: px(p.longitude as number),
  y: py(p.latitude as number),
  n: i + 1,
}));

// Whole-degree graticule, so zooming has visible reference lines.
const gridLons: number[] = [];
const gridLats: number[] = [];
const stepFor = (span: number) => (span > 60 ? 20 : span > 20 ? 10 : span > 8 ? 5 : 1);
const lonStep = stepFor(box.east - box.west);
const latStep = stepFor(box.north - box.south);
for (let l = Math.ceil(box.west / lonStep) * lonStep; l <= box.east; l += lonStep) gridLons.push(l);
for (let l = Math.ceil(box.south / latStep) * latStep; l <= box.north; l += latStep) gridLats.push(l);

const VERDICT_STYLE: Record<string, { label: string; color: string }> = {
  'likely-vpn': { label: 'VPN LIKELY IN USE', color: '#f87171' },
  'possible-vpn': { label: 'POSSIBLE VPN', color: '#fbbf24' },
  'no-signal': { label: 'NO VPN SIGNAL', color: '#4ade80' },
  'unknown': { label: 'NOT ENOUGH DATA', color: '#8a8a94' },
};
const v = VERDICT_STYLE[vpn.verdict] || VERDICT_STYLE.unknown;

const fmt = (s: string) => { try { return new Date(s).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }); } catch { return s; } };
---
<div style="border:1px solid #2a2a30;border-radius:12px;background:#0f0f14;overflow:hidden;">
  <div style="padding:12px 14px;border-bottom:1px solid #2a2a30;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
    <strong style="font-size:13px;color:#e8e8ee;">Application location trail</strong>
    <span style={`font-size:9.5px;font-weight:700;letter-spacing:0.06em;padding:2px 8px;border-radius:100px;color:${v.color};background:${v.color}1f;`}>{v.label}</span>
    <span style="font-size:10px;color:#8a8a94;font-family:'Geist Mono',monospace;">confidence: {vpn.confidence}</span>
    {vpn.restrictedHit && (
      <span style="font-size:9.5px;font-weight:700;letter-spacing:0.06em;padding:2px 8px;border-radius:100px;color:#f87171;background:rgba(248,113,113,0.14);">RESTRICTED ORIGIN: {vpn.restrictedHit.toUpperCase()}</span>
    )}
    <span style="margin-left:auto;font-size:10px;color:#8a8a94;">{trail.length} point{trail.length === 1 ? '' : 's'}</span>
  </div>

  {/* Network vs device: the comparison that actually exposes a rerouted connection. */}
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:#2a2a30;">
    <div style="background:#12121a;padding:10px 14px;">
      <p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 3px;">Network says</p>
      <p style="font-size:14px;color:#e8e8ee;margin:0;font-weight:600;">{vpn.networkCountry || 'unknown'}</p>
    </div>
    <div style="background:#12121a;padding:10px 14px;">
      <p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 3px;">Device says</p>
      <p style="font-size:14px;color:#e8e8ee;margin:0;font-weight:600;">{vpn.deviceCountry || 'unknown'}</p>
    </div>
    <div style="background:#12121a;padding:10px 14px;">
      <p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 3px;">Apparent true origin</p>
      <p style={`font-size:14px;margin:0;font-weight:600;color:${vpn.restrictedHit ? '#f87171' : '#e8e8ee'};`}>{vpn.trueOrigin || 'undetermined'}</p>
    </div>
  </div>

  {vpn.evidence.length > 0 && (
    <div style="padding:12px 14px;border-top:1px solid #2a2a30;">
      <p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 6px;">Why</p>
      <ul style="margin:0;padding-left:16px;">
        {vpn.evidence.map((e) => (<li style="font-size:12px;color:#a0a0a8;line-height:1.55;margin-bottom:4px;">{e}</li>))}
      </ul>
    </div>
  )}

  {flags.length > 0 && (
    <div style="padding:12px 14px;border-top:1px solid #2a2a30;background:rgba(251,191,36,0.06);">
      <p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#fbbf24;margin:0 0 6px;">Worth a look</p>
      <ul style="margin:0;padding-left:16px;">
        {flags.map((f) => (<li style="font-size:12px;color:#d4d4d8;line-height:1.55;margin-bottom:4px;">{f}</li>))}
      </ul>
    </div>
  )}

  {plotted.length === 0 ? (
    <div style="padding:28px 14px;text-align:center;">
      <p style="font-size:12px;color:#8a8a94;margin:0;">No coordinates captured for this application.</p>
    </div>
  ) : (
    <div style="border-top:1px solid #2a2a30;">
      <div style="display:flex;align-items:center;gap:6px;padding:8px 14px;border-bottom:1px solid #2a2a30;">
        <button type="button" data-zoom="in" style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:15px;line-height:1;">+</button>
        <button type="button" data-zoom="out" style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:15px;line-height:1;">&minus;</button>
        <button type="button" data-zoom="reset" style="background:#1a1a22;border:1px solid #2a2a30;color:#a0a0a8;height:28px;padding:0 10px;border-radius:6px;cursor:pointer;font-size:11px;">Reset</button>
        <label style="display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:#8a8a94;margin-left:6px;">
          Open in
          <select data-map-provider style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;height:28px;border-radius:6px;font-size:11px;padding:0 6px;cursor:pointer;">
            <option value="google">Google Maps</option>
            <option value="osm">OpenStreetMap</option>
          </select>
        </label>
        <span style="font-size:10.5px;color:#8a8a94;margin-left:2px;">Scroll to zoom, drag to pan, click a point to open it</span>
      </div>

      <svg
        data-trail-map
        viewBox={`0 0 ${W} ${H}`}
        data-base-viewbox={`0 0 ${W} ${H}`}
        style="width:100%;height:auto;display:block;background:#0a0a10;cursor:grab;touch-action:none;"
        role="img"
        aria-label="Map of locations this application was filed from"
      >
        <g stroke="#1e1e28" stroke-width="0.6">
          {gridLons.map((l) => (<line x1={px(l)} y1="0" x2={px(l)} y2={H} />))}
          {gridLats.map((l) => (<line x1="0" y1={py(l)} x2={W} y2={py(l)} />))}
        </g>
        <g fill="#3a3a46" font-size="8" font-family="monospace">
          {gridLons.map((l) => (<text x={px(l) + 2} y={H - 3}>{l}&#176;</text>))}
          {gridLats.map((l) => (<text x="2" y={py(l) - 3}>{l}&#176;</text>))}
        </g>

        {/* Order of travel */}
        {plotted.length > 1 && (
          <polyline
            points={plotted.map((p) => `${p.x},${p.y}`).join(' ')}
            fill="none" stroke="#FF4F00" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.65"
          />
        )}

        {plotted.map((p) => (
          <g
            data-pt
            data-lat={p.latitude}
            data-lon={p.longitude}
            data-source={p.source}
            style="cursor:pointer;"
            role="button"
            tabindex="0"
            aria-label={`${p.source === 'gps' ? 'Precise' : 'Network'} location at ${p.city || 'unknown city'}, ${p.country || 'unknown country'}`}
          >
            {/* Accuracy radius, so a coarse network centroid is never mistaken for a real position. */}
            {p.source === 'ip' && (<circle cx={p.x} cy={p.y} r="16" fill="#1045BB" opacity="0.14" />)}
            <circle
              cx={p.x} cy={p.y} r={p.source === 'gps' ? 6 : 4.5}
              fill={p.source === 'gps' ? '#4ade80' : '#1045BB'}
              stroke="#0a0a10" stroke-width="1.5"
            />
            <title>{`#${p.n} ${p.source === 'gps' ? 'PRECISE (device GPS, metre-level)' : 'COARSE (network/IP) - CITY LEVEL ONLY, NOT AN ADDRESS'}
${p.city || '?'}, ${p.region || '?'}, ${p.country || '?'}
${p.latitude?.toFixed(5)}, ${p.longitude?.toFixed(5)}${p.accuracyM ? ` (±${Math.round(p.accuracyM)} m)` : ''}
step: ${p.step || '-'}   ip: ${p.ip || '-'}
device tz: ${p.browserTimezone || '-'}   network tz: ${p.timezone || '-'}
${fmt(p.createdAt)}`}</title>
          </g>
        ))}
      </svg>

      <div style="display:flex;gap:14px;align-items:center;padding:8px 14px;border-top:1px solid #2a2a30;flex-wrap:wrap;">
        <span style="display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:#a0a0a8;">
          <span style="width:9px;height:9px;border-radius:50%;background:#4ade80;display:inline-block;"></span> Precise (device GPS)
        </span>
        <span style="display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:#a0a0a8;">
          <span style="width:9px;height:9px;border-radius:50%;background:#1045BB;display:inline-block;"></span>
          Coarse &mdash; city level only. This is the centre of an IP address block, typically several
          km wide. It is NOT the applicant's address and must never be treated as one.
        </span>
      </div>
    </div>
  )}

  {/* Per-point detail. The map shows shape; this is the record. */}
  {trail.length > 0 && (
    <div style="border-top:1px solid #2a2a30;max-height:320px;overflow:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:11.5px;">
        <thead>
          <tr style="background:#12121a;position:sticky;top:0;">
            {['#', 'When', 'Step', 'Source', 'Network location', 'Device timezone', 'Languages', 'IP', ''].map((h) => (
              <th style="text-align:left;padding:7px 10px;font-size:9.5px;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;font-weight:700;white-space:nowrap;">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {trail.map((p, i) => (
            <tr style="border-top:1px solid #1a1a22;">
              <td style="padding:7px 10px;color:#8a8a94;font-family:monospace;">{i + 1}</td>
              <td style="padding:7px 10px;color:#a0a0a8;white-space:nowrap;">{fmt(p.createdAt)}</td>
              <td style="padding:7px 10px;color:#a0a0a8;">{p.step || '-'}</td>
              <td style="padding:7px 10px;white-space:nowrap;">
                <span style={`color:${p.source === 'gps' ? '#4ade80' : '#7f9cf5'};font-weight:600;`}>{p.source === 'gps' ? 'precise' : 'network'}</span>
                {p.gpsStatus && p.gpsStatus !== 'granted' && (<span style="color:#fbbf24;"> ({p.gpsStatus})</span>)}
              </td>
              <td style="padding:7px 10px;color:#e8e8ee;">{[p.city, p.region, p.country].filter(Boolean).join(', ') || '-'}</td>
              <td style={`padding:7px 10px;font-family:monospace;color:${p.browserTimezone && p.timezone && p.browserTimezone !== p.timezone ? '#f87171' : '#a0a0a8'};`}>{p.browserTimezone || '-'}</td>
              <td style="padding:7px 10px;color:#a0a0a8;font-family:monospace;">{p.browserLanguages || '-'}</td>
              <td style="padding:7px 10px;color:#8a8a94;font-family:monospace;">{p.ip || '-'}</td>
              <td style="padding:7px 10px;white-space:nowrap;">
                {p.latitude != null && p.longitude != null && (
                  <span data-ext-links data-lat={p.latitude} data-lon={p.longitude} style="display:inline-flex;gap:8px;">
                    {/* Coarse points open zoomed out with no pin — see the note in the click handler. */}
                    <a href={p.source === 'gps'
                        ? `https://www.google.com/maps/search/?api=1&query=${p.latitude},${p.longitude}`
                        : `https://www.google.com/maps/@${p.latitude},${p.longitude},11z`}
                       target="_blank" rel="noopener noreferrer" style="color:#FF4F00;font-size:10.5px;"
                       title={p.source === 'gps' ? 'Device-measured position' : 'City-level only — an IP centroid, not an address'}>
                      {p.source === 'gps' ? 'Map' : 'Map (city)'}
                    </a>
                    {p.source === 'gps' && (
                      <a href={`https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${p.latitude},${p.longitude}`}
                         target="_blank" rel="noopener noreferrer" style="color:#fbbf24;font-size:10.5px;">Street view</a>
                    )}
                    <a href={`https://www.openstreetmap.org/?mlat=${p.latitude}&mlon=${p.longitude}#map=13/${p.latitude}/${p.longitude}`}
                       target="_blank" rel="noopener noreferrer" style="color:#7f9cf5;font-size:10.5px;">OSM</a>
                    <a href={`https://worldview.earthdata.nasa.gov/?v=${(p.longitude as number) - 0.35},${(p.latitude as number) - 0.25},${(p.longitude as number) + 0.35},${(p.latitude as number) + 0.25}`}
                       target="_blank" rel="noopener noreferrer" style="color:#4ade80;font-size:10.5px;">Satellite</a>
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <p style="font-size:10.5px;color:#8a8a94;margin:0;padding:10px 14px;border-top:1px solid #2a2a30;line-height:1.55;">
    Advisory only. A VPN reroutes the network but does not change the device's clock, locale or GPS,
    which is what these comparisons rely on &mdash; but a determined user can still refuse the location
    prompt and change their system settings. Mismatches also have innocent explanations: expatriates,
    travellers, corporate VPNs and university networks. Verify against documents; never decide on this
    alone. Coordinates are held on our own infrastructure and are not sent to any third party unless
    a link above is clicked.
  </p>
</div>

<script>
  // Zoom and pan by rewriting the SVG viewBox. No library, no tiles, no network.
  document.querySelectorAll('svg[data-trail-map]').forEach((svgEl) => {
    const svg = svgEl as SVGSVGElement;
    const base = (svg.dataset.baseViewbox || '0 0 720 380').split(' ').map(Number);
    let [x, y, w, h] = base;

    const apply = () => svg.setAttribute('viewBox', `${x} ${y} ${w} ${h}`);
    const zoom = (factor: number, cx?: number, cy?: number) => {
      const nw = Math.min(base[2] * 4, Math.max(base[2] / 40, w * factor));
      const nh = nw * (base[3] / base[2]);
      // Keep the cursor position fixed while scaling, which is what makes zoom feel right.
      const ax = cx == null ? x + w / 2 : cx;
      const ay = cy == null ? y + h / 2 : cy;
      x = ax - (ax - x) * (nw / w);
      y = ay - (ay - y) * (nh / h);
      w = nw; h = nh;
      apply();
    };

    const container = svg.closest('div');
    container?.querySelector('[data-zoom="in"]')?.addEventListener('click', () => zoom(0.7));
    container?.querySelector('[data-zoom="out"]')?.addEventListener('click', () => zoom(1 / 0.7));
    container?.querySelector('[data-zoom="reset"]')?.addEventListener('click', () => { [x, y, w, h] = base; apply(); });

    const toSvg = (ev: MouseEvent | WheelEvent) => {
      const r = svg.getBoundingClientRect();
      return { sx: x + ((ev.clientX - r.left) / r.width) * w, sy: y + ((ev.clientY - r.top) / r.height) * h };
    };

    svg.addEventListener('wheel', (ev) => {
      ev.preventDefault();
      const { sx, sy } = toSvg(ev);
      zoom(ev.deltaY > 0 ? 1.15 : 0.87, sx, sy);
    }, { passive: false });

    let drag: { mx: number; my: number; ox: number; oy: number } | null = null;
    let moved = false;
    svg.addEventListener('pointerdown', (ev) => {
      drag = { mx: ev.clientX, my: ev.clientY, ox: x, oy: y };
      moved = false;
      svg.style.cursor = 'grabbing';
      svg.setPointerCapture(ev.pointerId);
    });
    svg.addEventListener('pointermove', (ev) => {
      if (!drag) return;
      const r = svg.getBoundingClientRect();
      const dx = (ev.clientX - drag.mx) / r.width * w;
      const dy = (ev.clientY - drag.my) / r.height * h;
      if (Math.abs(ev.clientX - drag.mx) + Math.abs(ev.clientY - drag.my) > 4) moved = true;
      x = drag.ox - dx; y = drag.oy - dy;
      apply();
    });
    const endDrag = () => { drag = null; svg.style.cursor = 'grab'; };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);

    // Click a point -> open it in a map. DELEGATED on the svg rather than bound to each <g>:
    // setPointerCapture above redirects pointer events to the svg, so the derived click lands on the
    // svg and a listener attached to the child <g> never fires. Resolving the target with closest()
    // works regardless of capture.
    const openPoint = (target: Element | null) => {
      if (moved) return;                                  // a pan must not count as a click
      const g = target?.closest('[data-pt]') as HTMLElement | null;
      if (!g) return;
      const lat = g.dataset.lat, lon = g.dataset.lon;
      if (!lat || !lon) return;
      // A COARSE point is an IP-block centroid — it identifies a city, never an address. Opening it
      // as a dropped pin at street zoom makes it look like a doorstep, which a reviewer could act
      // on. Coarse points therefore open CENTRED AND ZOOMED OUT, with no pin; only device GPS gets
      // a pin at street zoom, because only GPS actually measures a position.
      const coarse = g.dataset.source !== 'gps';
      const osm = (svg.dataset.mapProvider || 'google') === 'osm';
      const url = coarse
        ? (osm ? `https://www.openstreetmap.org/#map=11/${lat}/${lon}`
               : `https://www.google.com/maps/@${lat},${lon},11z`)
        : (osm ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`
               : `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`);
      const w = window.open(url, '_blank', 'noopener');
      // Popup blockers can return null even from a click. Fall back to a same-tab navigation rather
      // than appearing to do nothing at all.
      if (!w) window.location.href = url;
    };

    svg.addEventListener('click', (ev) => openPoint(ev.target as Element));
    svg.addEventListener('keydown', (ev) => {
      if ((ev as KeyboardEvent).key === 'Enter' || (ev as KeyboardEvent).key === ' ') {
        openPoint(document.activeElement);
      }
    });

    // Which provider a click uses. Remembered so a reviewer sets it once.
    const provSel = container?.querySelector('[data-map-provider]') as HTMLSelectElement | null;
    if (provSel) {
      const saved = localStorage.getItem('era_map_provider');
      if (saved) { provSel.value = saved; svg.dataset.mapProvider = saved; }
      else { svg.dataset.mapProvider = provSel.value; }
      provSel.addEventListener('change', () => {
        svg.dataset.mapProvider = provSel.value;
        try { localStorage.setItem('era_map_provider', provSel.value); } catch (_) {}
      });
    }
  });
</script>
