<script is:inline define:vars={{ basePath, myAddress, templateSubject, templateHtml, templateNote, openMessageIds: (thread || []).filter((m: any) => m.from_user_id !== user.id).map((m: any) => m.id) }}>
(function(){
  // Log an "open" event for every message the current user did NOT author
  // when a thread is shown - server logs it with IP + geolocation.
  if (Array.isArray(openMessageIds) && openMessageIds.length) {
    try {
      fetch('/api/mail/open', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messageIds: openMessageIds }),
      }).catch(function (err) {
        // Not silent. When this does not land, the SENDER is shown "Not opened yet" about a message
        // that was opened, and nothing anywhere would have said why.
        console.error('[MailClient] open receipt not logged:', (err && err.message) || err);
      });
    } catch (err) {
      console.error('[MailClient] open receipt not logged:', (err && err.message) || err);
    }
  }
  const modal = document.getElementById('mcModal');
  const $ = function(id){ return document.getElementById(id); };
  function openModal(title){ $('mcModalTitle').textContent = title || 'New message'; modal.hidden = false; $('mcTo').focus(); }
  function closeModal(){ modal.hidden = true; $('mcStatus').textContent=''; }
  // htmlMode is set ONLY by a loaded template. A hand-typed message keeps the plain-text path it has
  // always had (send.ts wraps it and escapes it); a template body is HTML the author wrote on
  // purpose, so it is sent as bodyHtml rather than escaped into visible tags.
  let htmlMode = false;
  function setTplNote(text){ const n = $('mcTplNote'); if (!n) return; n.textContent = text || ''; n.hidden = !text; }
  function clearForm(){ ['mcTo','mcCc','mcBcc','mcSubject','mcBody','mcAttUrl','mcThreadId','mcInReplyTo'].forEach(function(id){ $(id).value=''; }); if($('mcSchedule'))$('mcSchedule').value=''; if($('mcSig'))$('mcSig').checked=true; attachments=[]; htmlMode=false; setTplNote(''); renderAtts(); }

  let attachments = [];
  function renderAtts(){
    const box = $('mcAttList'); box.innerHTML='';
    attachments.forEach(function(a,i){
      const d=document.createElement('div'); d.className='mc-att-chip';
      d.innerHTML='<span>'+a.filename+'</span>';
      const b=document.createElement('button'); b.type='button'; b.textContent='remove';
      b.onclick=function(){ attachments.splice(i,1); renderAtts(); };
      d.appendChild(b); box.appendChild(d);
    });
  }
  const attUrl = $('mcAttUrl');
  if (attUrl) attUrl.addEventListener('keydown', function(e){
    if(e.key==='Enter'){ e.preventDefault(); const u=attUrl.value.trim(); if(u){ attachments.push({url:u, filename:u.split('/').pop()||'attachment'}); attUrl.value=''; renderAtts(); } }
  });

  const composeBtn = $('mcComposeBtn');
  if (composeBtn) composeBtn.addEventListener('click', function(){ clearForm(); openModal('New message'); });

  // Arrived from /admin/mail/templates with ?template=<id>. The refusal cases (missing, switched
  // off, unreadable) carry a note and NO body, so the composer opens saying why rather than opening
  // blank and letting somebody send an empty message believing the template was in it.
  if (templateNote) {
    clearForm();
    if (templateHtml || templateSubject) {
      $('mcSubject').value = templateSubject || '';
      $('mcBody').value = templateHtml || '';
      htmlMode = !!templateHtml;
    }
    setTplNote(templateNote);
    openModal(htmlMode ? 'New message from template' : 'New message');
  }
  const closeBtn = $('mcClose'); if (closeBtn) closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e){ if(e.target===modal) closeModal(); });

  // Reply / forward prefill
  const replyBox = document.querySelector('.mc-reply');
  const replyBtn = $('mcReplyBtn'), fwdBtn = $('mcForwardBtn');
  if (replyBtn && replyBox) replyBtn.addEventListener('click', function(){
    clearForm();
    $('mcTo').value = replyBox.getAttribute('data-to') || '';
    $('mcThreadId').value = replyBox.getAttribute('data-thread') || '';
    let s = replyBox.getAttribute('data-subject')||''; if(!/^re:/i.test(s)) s='Re: '+s;
    $('mcSubject').value = s;
    openModal('Reply');
  });
  if (fwdBtn && replyBox) fwdBtn.addEventListener('click', function(){
    clearForm();
    let s = replyBox.getAttribute('data-subject')||''; if(!/^fwd:/i.test(s)) s='Fwd: '+s;
    $('mcSubject').value = s; $('mcThreadId').value = replyBox.getAttribute('data-thread')||'';
    openModal('Forward');
  });

  function payload(){
    var p = {
      to: $('mcTo').value, cc: $('mcCc').value, bcc: $('mcBcc').value,
      subject: $('mcSubject').value, body: $('mcBody').value,
      threadId: $('mcThreadId').value || null, attachments: attachments,
      signature: $('mcSig') ? $('mcSig').checked : true,
    };
    // A template body IS markup. Sent as `body` it would be escaped by send.ts and the recipient
    // would read the tags; sent as `bodyHtml` it renders, and send.ts derives the text part itself.
    if (htmlMode) { p.bodyHtml = $('mcBody').value; p.body = ''; }
    var sched = $('mcSchedule') && $('mcSchedule').value;
    if (sched) { var dt = new Date(sched); if (!isNaN(dt.getTime())) p.scheduledAt = dt.toISOString(); }
    return p;
  }
  // A 500 that returns an HTML error page used to make r.json() throw, and every caller caught that
  // as "Network error" — so a server fault and an unplugged cable read identically, and neither
  // said which. The status is reported when the body cannot be read.
  // It also never THROWS any more. A dropped connection used to reject out of here into whichever
  // caller was awaiting it, and the two action handlers below awaited it without a try at all — so a
  // failed archive or star threw an unhandled rejection and the page reloaded as if it had worked.
  async function post(url, data){
    var r;
    try {
      r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    } catch (e) {
      return { ok:false, error: 'the request never reached the server (' + ((e && e.message) || 'network error') + ')' };
    }
    try {
      return await r.json();
    } catch (e) {
      return { ok:false, error: 'the server answered ' + r.status + ' with a response this page could not read' };
    }
  }
  function showAlert(msg){
    const a = $('mcAlert');
    if (!a) { console.error('[MailClient]', msg); return; }
    a.textContent = msg;
    a.hidden = false;
    a.scrollIntoView({ block: 'nearest' });
  }
  const sendBtn = $('mcSend');
  if (sendBtn) sendBtn.addEventListener('click', async function(){
    const p = payload();
    if(!p.to.trim()){ $('mcStatus').textContent='Add a recipient'; return; }
    $('mcStatus').textContent='Sending...'; sendBtn.disabled=true;
    try{
      const res = await post('/api/mail/send', p);
      if(res.ok){
        if (res.scheduled) { $('mcStatus').textContent = 'Scheduled for ' + new Date(res.scheduledAt).toLocaleString(); sendBtn.disabled = false; setTimeout(closeModal, 900); return; }
        if (res.external && res.external.attempted > 0 && !res.external.delivered) {
          $('mcStatus').textContent = 'Saved to Sent. External delivery is not set up yet (' + (res.external.error || 'no transport') + ').';
          sendBtn.disabled = false;
        } else {
          $('mcStatus').textContent = res.external && res.external.attempted ? ('Sent (external via ' + res.external.provider + ')') : 'Sent';
          setTimeout(function(){ location.href = basePath + '?folder=sent'; }, 500);
        }
      }
      else { $('mcStatus').textContent = 'Not sent - ' + (res.error || 'the server refused it without saying why') + '. Your message is still here.'; sendBtn.disabled=false; }
    }catch(e){ $('mcStatus').textContent='Not sent - ' + ((e && e.message) || 'this page could not complete the request') + '. Your message is still here.'; sendBtn.disabled=false; }
  });
  const draftBtn = $('mcSaveDraft');
  if (draftBtn) draftBtn.addEventListener('click', async function(){
    $('mcStatus').textContent='Saving...';
    try{ const res = await post('/api/mail/draft', payload()); $('mcStatus').textContent = res.ok ? 'Draft saved' : ('Not saved - ' + (res.error||'the server refused it without saying why')); if(res.ok) setTimeout(closeModal, 500); }
    catch(e){ $('mcStatus').textContent='Not saved - ' + ((e && e.message) || 'this page could not complete the request'); }
  });

  // Star toggles + thread actions.
  //
  // BOTH OF THESE USED TO IGNORE THE ANSWER. They awaited the POST and then reloaded (star) or
  // navigated to the inbox (archive / delete / mark-unread / spam) whichever way it went. A refused
  // action therefore looked identical to a completed one: you landed on a freshly-drawn inbox with
  // the mail exactly as it had been, and nothing said why. Neither navigates now unless the server
  // confirmed the change, and a refusal is printed at the top of the client.
  document.querySelectorAll('.mc-star').forEach(function(btn){
    btn.addEventListener('click', async function(e){
      e.preventDefault(); e.stopPropagation();
      const thread = btn.getAttribute('data-thread'); const action = btn.getAttribute('data-action');
      btn.disabled = true;
      const res = await post('/api/mail/action', { action: action, threadId: thread });
      if (!res || res.ok !== true) {
        btn.disabled = false;
        showAlert('This conversation was not ' + (action === 'star' ? 'starred' : 'unstarred') + ', and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '.');
        return;
      }
      location.reload();
    });
  });
  const ACTION_DONE = { archive: 'archived', trash: 'deleted', unread: 'marked unread', spam: 'reported as spam' };
  document.querySelectorAll('.mc-act').forEach(function(btn){
    btn.addEventListener('click', async function(){
      const thread = btn.getAttribute('data-thread'); const action = btn.getAttribute('data-action');
      btn.disabled = true;
      const res = await post('/api/mail/action', { action: action, threadId: thread });
      if (!res || res.ok !== true) {
        btn.disabled = false;
        showAlert('This conversation was not ' + (ACTION_DONE[action] || action) + ', and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '. It is still where it was.');
        return;
      }
      location.href = basePath + '?folder=inbox';
    });
  });
})();
</script>
