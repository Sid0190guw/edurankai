---
// Full unified mail client — the ONLY UI of the one mail system (src/lib/mail.ts +
// mail-transport.ts + mail-groups.ts + mail-advanced.ts). Mounted at exactly two routes:
//   /admin/mail           — the console mount, behind AdminLayout.
//   /portal/employee/mail — the employee mount, gated by canUseMailbox() (src/lib/auth/mail-access.ts).
// The line here used to name /portal/mail. That was never this component: /portal/mail is a
// SEPARATE, older mailbox on portal_mail_* tables with no SMTP or IMAP path, now a read-only archive
// that redirects to /portal/employee/mail for anyone with nothing stored in it.
//
// Props: user (Astro.locals.user), basePath ('/admin/mail' | '/portal/employee/mail').
// basePath drives navigation only; the three write endpoints are absolute (/api/mail/{send,draft,
// action}) and each authorises through denyMailApi(), so both mounts meet the same gate.
import { getFolderCounts, getMailboxAddress, getUserLabels, getThreadMessages, markThreadRead, deliveryWording, FOLDERS } from '@/lib/mail';
// PATCH 11 — the advanced layer. The listing no longer goes through listFolder(): that ran a
// window function over the WHOLE filtered mailbox to pick one row per conversation, which is a sort
// of everything to draw fifty rows. searchMailbox() walks the existing
// mail_box(user_id, folder, created_at DESC) index from a keyset cursor and collapses conversations
// inside the page, so the cost is the page rather than the mailbox. It also carries the larger
// grammar (body:, filename:, domain:, larger:, negation) — one parser for the box and the listing.
import { searchMailbox, SEARCH_HELP, isBroadQuery, type SearchPage } from '@/lib/mail-search';
import { assembleConversation, flattenConversation, summarizeConversation, splitQuoted, participantLine } from '@/lib/mail-threading';
import { classifyAttachment } from '@/lib/mail-attachments';
import { snoozePresets, maybeWakeDue } from '@/lib/mail-snooze';

const { user, basePath = '/admin/mail' } = Astro.props as { user: any; basePath?: string };

const url = new URL(Astro.request.url);
const folderParam = url.searchParams.get('folder') || 'inbox';
const starred = folderParam === 'starred';
const folder = starred ? 'inbox' : (folderParam as any);
const q = url.searchParams.get('q') || '';
const label = url.searchParams.get('label') || null;
const threadId = url.searchParams.get('thread') || '';

let counts: Record<string, number> = {};
let myAddress = '';
let listing: SearchPage | null = null;
let userLabels: string[] = [];
let dbReady = true;
// The reason, kept, so the banner can say what went wrong instead of guessing.
let mailError = '';
try {
  counts = await getFolderCounts(user.id);
  myAddress = await getMailboxAddress(user.id);
  // THE MAIL LIST WAS DEAD. listFolder was rewritten to take (userId, opts) and to return a
  // FolderListing OBJECT — { rows, query, filtered, scopeLabel } — and this, its only caller in
  // the repository, was never changed off the old (userId, folder, q, starred) positional form.
  // Two consequences, and neither announced itself: `folder`, `q` and `starred` were all dropped
  // on the floor (the second argument was a string where an options object was expected, so every
  // listing ignored the folder you clicked and the terms you searched), and `list` then held an
  // object, so `list.length === 0` was `undefined === 0` — false, hiding the empty state — and
  // `list.map(...)` threw TypeError while rendering. Both mail mounts answered 500.
  // withTotal is asked for ONLY when something is narrowing the list, because that is when the
  // number is worth a second statement — it is what "select all N results" needs a number for.
  listing = await searchMailbox(user.id, {
    query: q,
    scope: { folder, starred, label },
    limit: 50,
    withTotal: !!q || !!label || starred,
  });
  userLabels = await getUserLabels(user.id);
  // Bring back anything whose snooze is up. Server-side, bounded and throttled per process — see
  // maybeWakeDue() for why the daily cron alone is not enough to make "later today" mean it.
  await maybeWakeDue();
} catch (e: any) {
  // NOT SWALLOWED. The real Postgres reason is on e.cause; e.message is only the failed SQL.
  dbReady = false;
  mailError = String(e?.cause?.message || e?.message || 'unknown error');
  console.error('[MailClient] listing failed:', mailError);
}
// The engine returns camelCase hits; the markup below has always read snake_case rows. Mapped here
// rather than renaming forty template expressions — one function, one place, and the extra fields
// the advanced list needs (snooze, size, participants) come along with it.
const list: any[] = (listing ? listing.hits : []).map((h) => ({
  thread_id: h.threadId, message_id: h.messageId, subject: h.subject, snippet: h.snippet,
  from_name: h.fromName, from_email: h.fromEmail, from_user_id: h.fromUserId,
  created_at: h.createdAt, is_read: h.isRead, is_starred: h.isStarred,
  has_attachments: h.hasAttachments, folder: h.folder, labels: h.labels,
  thread_count: h.threadCount, direction: h.direction, is_draft: h.isDraft,
  participants: h.participants, snoozed_until: h.snoozedUntil,
}));
// What is actually on screen, from the listing itself rather than from the folder in the URL: a
// search with `in:anywhere` or a label pseudo-folder does not return the folder you are standing in.
const scopeLabel = listing ? listing.scopeLabel : '';
const filtered = !!(listing && (listing.query.active || !!label));
const queryNote = listing && listing.query && listing.query.active ? listing.query.describe : '';
// Operators that parsed to nothing usable, and an engine that had to fall back. Both are SHOWN. A
// search that quietly ignored half of what was typed is how somebody concludes their mail is gone.
const queryWarnings: string[] = listing ? listing.query.warnings : [];
const searchDegraded = listing ? listing.degraded : null;
const nextCursor = listing ? listing.nextCursor : null;
const resultTotal = listing && listing.total != null ? listing.total : null;
const resultTotalCapped = !!(listing && listing.totalIsCapped);
const queryIsBroad = !!(listing && isBroadQuery(listing.query));
const snoozeMenu = snoozePresets().map((p) => ({ key: p.key, label: p.label, when: p.when, at: p.at ? p.at.toISOString() : null }));

let thread: any[] = [];
let threadSubject = '';
let threadOtherParty = '';
// The reason a conversation would not open. It used to be thrown away by `catch (e) { thread = []; }`
// and an unreadable thread rendered as an EMPTY one — the reader was shown a conversation with no
// messages in it and told nothing had gone wrong.
let threadError = '';
if (threadId && dbReady) {
  try {
    // ONE READ, IN ONE PLACE. getThreadMessages() already resolves recipients, attachments, read
    // receipts AND delivery for every message in the thread (src/lib/mail.ts) — the four-statement
    // version written precisely to replace the raw block that used to sit here. That block was
    // still here, running AFTER it, and it did two harmful things:
    //
    //  1. IT THREW ON EVERY THREAD THE VIEWER HAD SENT INTO. `= ANY(${myMessageIds}::uuid[])` binds
    //     a JS array as a record literal, so Postgres refuses the cast (src/lib/pg-array.ts). The
    //     catch below then blanked `thread` and drew the "could not be opened" state over a
    //     conversation that was sitting right there — a reading pane that could not open its own
    //     sent mail.
    //  2. IT OVERWROTE THE DELIVERY TRUTH WITH THE VERSION THAT LIED. It re-keyed email_logs by
    //     rfc_message_id, which /api/mail/send does not write, and replaced the resolved
    //     DeliveryStatus with a raw log row — undoing the repair mail.ts documents at its
    //     "Delivery truth" heading.
    //
    // Deleted, not reimplemented. Nothing is lost: m.reads and m.delivery are already populated.
    thread = await getThreadMessages(user.id, threadId);
    await markThreadRead(user.id, threadId);
  } catch (e: any) {
    // NOT SWALLOWED. e.cause carries the real Postgres reason; e.message is only the failed SQL.
    thread = [];
    threadError = String(e?.cause?.message || e?.message || 'unknown error');
    console.error('[MailClient] thread failed:', threadError);
  }
  const first = thread[0];
  threadSubject = first?.subject || '(no subject)';
  // fall through to the conversation assembly below
  const last = thread[thread.length - 1] || {};
  const myEmail = (myAddress || '').toLowerCase();
  threadOtherParty = (last.from_email && last.from_email.toLowerCase() !== myEmail)
    ? last.from_email
    : ((last.recipients || []).find((r: any) => (r.email || '').toLowerCase() !== myEmail)?.email || last.from_email || '');
}

// ------------------------------------------------------------------------------------------------
// THE CONVERSATION, AS A CONVERSATION.
//
// getThreadMessages() returns a flat list in date order. Three things were missing from that and
// each of them is why a long exchange was hard to read:
//
//   1. SHAPE. A reply-all to an older message belongs UNDER that message. assembleConversation()
//      works the nesting out from In-Reply-To and References (src/lib/mail-threading.ts).
//   2. WHAT IS NEW versus WHAT IS A REPEAT. splitQuoted() separates the sentence somebody wrote
//      from the three screens of history their client stapled underneath it, so "show quoted text"
//      can exist at all — before this, every reply redisplayed the entire thread inside itself.
//   3. WHICH MESSAGES START OPEN. summarizeConversation() decides once — latest, unread, drafts —
//      instead of the markup inventing a rule of its own.
//
// Done on the SERVER, so the first paint is the finished conversation. /api/mail/conversation
// returns the same structure for the client-side paths (prefetch, mobile back-and-forth).
const convo = thread.length ? flattenConversation(assembleConversation(thread as any[])) : [];
const convoSummary = thread.length ? summarizeConversation(thread as any[]) : null;
const convoParticipants = convoSummary ? participantLine(convoSummary.participants) : '';
const selfHost = url.hostname;
const messages = convo.map((node: any) => {
  const m = node.message;
  const split = splitQuoted(m.body_text || stripTags(m.body_html));
  return {
    m,
    depth: node.depth,
    via: node.via,
    visible: split.visible,
    quoted: split.quoted,
    signature: split.signature,
    hasQuoted: !!split.quoted,
    expanded: convoSummary ? convoSummary.expandedIds.includes(m.id) : true,
    // Every attachment goes through ONE policy (src/lib/mail-attachments.ts). The markup never
    // decides for itself whether something is safe to render.
    atts: (m.attachments || []).map((a: any) => ({
      raw: a,
      v: classifyAttachment({ filename: a.filename, url: a.url, mime: a.mime, sizeBytes: a.size_bytes }, selfHost),
    })),
  };
});

// ------------------------------------------------------------------------------------------------
// TEMPLATE PREFILL - the missing half of /admin/mail/templates.
//
// That page authors rows in `email_templates` and its own copy says to "load a template into the
// composer". Nothing in the repository read that table: not this component, not /api/mail/send, not
// mail.ts. The whole screen - the editor, the live preview, the active/off toggle, the Duplicate
// button - wrote to a table with no reader, which is a feature that cannot be used, only maintained.
// `?template=<id>` is the reader.
//
// SCOPED TO THE ADMIN MOUNT. This component is also mounted at /portal/employee/mail for people who
// hold a mailbox but not the mail console; templates are console content and are not published to
// that mount.
//
// AN INACTIVE TEMPLATE IS REFUSED, WITH A REASON. That is what makes the "active / off" toggle on
// the templates page mean something: before this, `is_active` was a column nothing consulted.
let templateSubject = '';
let templateHtml = '';
let templateNote = '';
const templateId = (url.searchParams.get('template') || '').trim();
if (templateId && basePath === '/admin/mail') {
  try {
    const { db } = await import('@/lib/db');
    const { sql } = await import('drizzle-orm');
    const tr = await db.execute(sql`
      SELECT template_key, subject, body_html, is_active
        FROM email_templates WHERE id = ${templateId} LIMIT 1`);
    const t = ((Array.isArray(tr) ? tr : ((tr as any)?.rows || [])) as any[])[0];
    if (!t) templateNote = 'That template no longer exists.';
    else if (!t.is_active) templateNote = 'Template "' + t.template_key + '" is switched off, so it was not loaded. Turn it on in Email Templates first.';
    else {
      templateSubject = String(t.subject || '');
      templateHtml = String(t.body_html || '');
      templateNote = 'Template "' + t.template_key + '" loaded. It will be sent as HTML exactly as written - nothing substitutes {{...}} placeholders, so replace them by hand before sending.';
    }
  } catch (e: any) {
    // NOT SWALLOWED, and NOT rendered as an empty composer that silently dropped the template.
    templateNote = 'That template could not be loaded: ' + String(e?.cause?.message || e?.message || 'unknown error');
    console.error('[MailClient] template load failed:', templateNote);
  }
}

function stripTags(s: string) { return String(s || '').replace(/<style[\s\S]*?<\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); }
function bodyToText(m: any) { return m.body_text || stripTags(m.body_html); }
function initialOf(s: string) { return (s || '?').trim().charAt(0).toUpperCase() || '?'; }
function timeAgo(d: any) {
  if (!d) return '';
  const diff = Date.now() - new Date(d).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return 'now';
  if (m < 60) return m + 'm';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h';
  const days = Math.floor(h / 24);
  if (days < 7) return days + 'd';
  return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short' });
}
function fullTime(d: any) { return d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''; }

const folderLinks = [
  ...FOLDERS.slice(0, 1),
  { key: 'starred', label: 'Starred' } as any,
  ...FOLDERS.slice(1),
];
---

<div class="mailc" data-base={basePath}>
  {/* This banner used to read "Mailboxes are being set up. Once the database migration runs, your
      inbox will appear here." for EVERY failure — a dropped connection, a bad query, a permission
      error — which told people to wait for a migration that was not pending and would never come.
      It now says that the mail could not be loaded, and what the server actually reported. */}
  {!dbReady && (
    <div style="padding:9px 16px;background:rgba(251,191,36,0.12);border-bottom:1px solid rgba(251,191,36,0.28);color:#fbbf24;font-size:12px;">
      Your mail could not be loaded, so this list is empty for a reason that is not "no mail":
      {' '}{mailError}
    </div>
  )}
  {/* Where a FAILED star, archive, delete, mark-unread or spam report is said out loud. Those five
      buttons used to fire and then reload or navigate whichever way the request went, so a refused
      action left you on a fresh inbox with the mail exactly as it was and nothing on screen to say
      so — the same "reported success while nothing happened" this client was repaired for. */}
  <div class="mc-alert" id="mcAlert" role="alert" hidden></div>
  <!-- Header -->
  <div class="mc-head">
    <div class="mc-head-id">
      <span class="mc-dot"></span>
      <div>
        <p class="mc-title">Mail</p>
        <p class="mc-addr">{myAddress}</p>
      </div>
    </div>
    <form class="mc-search" method="get" action={basePath}>
      <input type="hidden" name="folder" value={folderParam} />
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" name="q" value={q} placeholder="Search mail" autocomplete="off" />
    </form>
    <button type="button" class="mc-compose-btn" id="mcComposeBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      <span>Compose</span>
    </button>
  </div>

  <div class={`mc-body ${threadId ? 'mc-has-thread' : ''}`}>
    <!-- Folder rail -->
    <nav class="mc-rail">
      {folderLinks.map((f: any) => {
        const active = f.key === 'starred' ? starred : (!starred && folderParam === f.key);
        const unread = counts[f.key] || 0;
        return (
          <a href={`${basePath}?folder=${f.key}`} class={`mc-rail-item ${active ? 'on' : ''}`}>
            <span class="mc-rail-label">{f.label}</span>
            {unread > 0 && f.key !== 'sent' && f.key !== 'starred' && <span class="mc-rail-badge">{unread}</span>}
          </a>
        );
      })}
      {/* LABELS ARE A PLACE YOU CAN STAND, not just a chip on a row. Built from the labels actually
          in use (getUserLabels), so the rail and the label picker cannot disagree. */}
      {userLabels.length > 0 && (
        <div class="mc-rail-group">
          <p class="mc-rail-head">Labels</p>
          {userLabels.map((l: string) => (
            <a href={`${basePath}?label=${encodeURIComponent(l)}`} class={`mc-rail-item ${label === l ? 'on' : ''}`}>
              <span class="mc-rail-label">{l}</span>
            </a>
          ))}
        </div>
      )}
    </nav>

    <!-- Thread list -->
    <div class="mc-list" id="mcList">
      {/* What this list is actually showing. A search for `in:anywhere`, or a label, returns mail
          from outside the folder highlighted in the rail, and without this line the rail is simply
          wrong about where you are. */}
      {dbReady && filtered && (
        <div class="mc-scope">
          <span>
            {scopeLabel}{queryNote ? ' - ' + queryNote : ''}
            {resultTotal != null && <span class="mc-scope-n">{resultTotal.toLocaleString('en-IN')}{resultTotalCapped ? '+' : ''} found</span>}
          </span>
          <a href={`${basePath}?folder=${folderParam}`}>clear</a>
        </div>
      )}
      {/* AN OPERATOR THAT PARSED TO NOTHING IS SAID OUT LOUD. Before this, a mistyped `after:` was
          simply dropped and the search silently answered a different question. */}
      {queryWarnings.length > 0 && (
        <div class="mc-warn">{queryWarnings.map((w: string) => <p>{w}</p>)}</div>
      )}
      {searchDegraded && <div class="mc-warn"><p>{searchDegraded}</p></div>}

      {/* THE BULK BAR. Hidden until something is ticked. "Select all N results" posts the QUERY,
          not ten thousand ids — see src/lib/mail-bulk.ts. */}
      <div class="mc-bulk" id="mcBulk" hidden>
        <label class="mc-bulk-all">
          <input type="checkbox" id="mcSelectPage" aria-label="Select everything on this page" />
          <span id="mcBulkCount">0 selected</span>
        </label>
        <div class="mc-bulk-acts">
          <button type="button" class="mc-bulk-btn" data-op="read">Read</button>
          <button type="button" class="mc-bulk-btn" data-op="unread">Unread</button>
          <button type="button" class="mc-bulk-btn" data-op="star">Star</button>
          <button type="button" class="mc-bulk-btn" data-op="archive">Archive</button>
          <button type="button" class="mc-bulk-btn" data-op="spam">Spam</button>
          <button type="button" class="mc-bulk-btn" data-op="trash">Delete</button>
          <button type="button" class="mc-bulk-btn" id="mcBulkLabel">Label</button>
          <button type="button" class="mc-bulk-btn" id="mcBulkSnooze">Snooze</button>
        </div>
        <p class="mc-bulk-all-results" id="mcAllResults" hidden>
          <span id="mcAllResultsText"></span>
          <button type="button" id="mcSelectAllResults">Select all results</button>
          <button type="button" id="mcClearSelection">Clear</button>
        </p>
        <p class="mc-bulk-status" id="mcBulkStatus" role="status"></p>
      </div>

      {list.length === 0 && (
        <div class="mc-empty">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          {/* "Nothing here yet" is only true when the listing succeeded. When it failed, an empty
              list means the mail was not read, not that there is none. */}
          <p>{!dbReady ? 'This list could not be loaded - see the message above.' : (filtered ? 'No mail matches that.' : 'Nothing here yet.')}</p>
        </div>
      )}
      <div id="mcRows">
      {list.map((t: any) => (
        <div class={`mc-row ${t.is_read ? '' : 'unread'} ${threadId === t.thread_id ? 'sel' : ''}`} data-thread={t.thread_id} data-href={`${basePath}?folder=${folderParam}&thread=${t.thread_id}`} tabindex="0" role="link">
          <input type="checkbox" class="mc-pick" data-thread={t.thread_id} aria-label={'Select conversation: ' + (t.subject || 'no subject')} />
          <button type="button" class={`mc-star ${t.is_starred ? 'on' : ''}`} data-thread={t.thread_id} data-action={t.is_starred ? 'unstar' : 'star'} aria-label="Star">
            <svg width="16" height="16" viewBox="0 0 24 24" fill={t.is_starred ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.7"><path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
          </button>
          <div class="mc-avatar" aria-hidden="true">{initialOf(folder === 'sent' || folder === 'drafts' ? (t.from_name || myAddress) : t.from_name)}</div>
          <a class="mc-row-main" href={`${basePath}?folder=${folderParam}&thread=${t.thread_id}`}>
            <div class="mc-row-top">
              <span class="mc-from">{t.participants || t.from_name || t.from_email}</span>
              <span class="mc-time">{timeAgo(t.created_at)}</span>
            </div>
            <p class="mc-subj">{t.subject || '(no subject)'}{t.thread_count > 1 && <span class="mc-count">{t.thread_count}</span>}</p>
            <p class="mc-snip">{t.snippet}</p>
            {(t.labels || []).length > 0 && (
              <p class="mc-row-labels">{(t.labels as string[]).slice(0, 4).map((l: string) => <span class="mc-chip">{l}</span>)}</p>
            )}
          </a>
          <div class="mc-row-icons">
            {t.snoozed_until && <span class="mc-chip snoozed" title={'Comes back ' + fullTime(t.snoozed_until)}>snoozed</span>}
            {t.has_attachments && <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg>}
          </div>
        </div>
      ))}
      </div>
      {/* INCREMENTAL LOADING. The cursor is opaque and comes from the engine; the button posts it
          back to /api/mail/search and appends. No OFFSET, so page 200 costs what page 1 costs. */}
      {nextCursor && (
        <button type="button" class="mc-more" id="mcMore" data-cursor={nextCursor}>Load more</button>
      )}
      <p class="mc-list-end" id="mcListEnd" hidden></p>
    </div>

    <!-- Reading pane -->
    <div class="mc-read">
      {!threadId && (
        <div class="mc-read-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.45"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          <p>Select a conversation to read</p>
        </div>
      )}
      {threadId && (
        <div class="mc-thread">
          <div class="mc-thread-head">
            <a href={`${basePath}?folder=${folderParam}`} class="mc-back" aria-label="Back">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <h2 class="mc-thread-subj">{threadSubject}</h2>
            <div class="mc-thread-actions">
              <button type="button" class="mc-act" data-thread={threadId} data-action="archive" title="Archive">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="5" rx="1"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9M10 13h4"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="trash" title="Delete">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="unread" title="Mark unread">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
              </button>
              <button type="button" class="mc-act" id="mcThreadSnooze" data-thread={threadId} title="Snooze">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="spam" title="Report spam">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
              </button>
            </div>
          </div>

          {threadError && (
            <div class="mc-thread-error">
              This conversation could not be read, so it is empty here for a reason that is not "no
              messages": {threadError}
            </div>
          )}
          {convoSummary && convoSummary.messageCount > 1 && (
            <div class="mc-convo-bar">
              <span class="mc-convo-people" title={convoSummary.participants.map((p: any) => p.email).join(', ')}>{convoParticipants}</span>
              <span class="mc-convo-count">{convoSummary.messageCount} messages{convoSummary.unreadCount > 0 ? ' · ' + convoSummary.unreadCount + ' unread' : ''}{convoSummary.attachmentCount > 0 ? ' · ' + convoSummary.attachmentCount + ' attached' : ''}</span>
              <button type="button" class="mc-convo-btn" id="mcExpandAll">Expand all</button>
              <button type="button" class="mc-convo-btn" id="mcCollapseAll">Collapse all</button>
            </div>
          )}
          {/* THE CONTACT CARD. Filled by /api/mail/contact-context after the conversation is on
              screen — deliberately not part of this render, so four extra lookups can never hold up
              the messages. If it fails, the conversation is still here. */}
          <div class="mc-contact" id="mcContact" data-email={threadOtherParty} hidden></div>
          <div class="mc-msgs">
            {messages.map((row: any) => {
              const m = row.m;
              return (
              <div class={'mc-msg d' + row.depth + (row.expanded ? ' open' : ' shut')} data-msg={m.id}>
                {/* The whole header is the collapse control. A conversation of twenty messages that
                    can only be opened by hitting a small chevron is a conversation nobody opens. */}
                <button type="button" class="mc-msg-head" aria-expanded={row.expanded ? 'true' : 'false'} aria-controls={'body-' + m.id}>
                  <div class="mc-avatar sm">{initialOf(m.from_name || m.from_email)}</div>
                  <div class="mc-msg-meta">
                    <p class="mc-msg-from">{m.from_name || m.from_email} <span class="mc-msg-email">&lt;{m.from_email}&gt;</span></p>
                    <p class="mc-msg-to">to {(m.recipients || []).map((r: any) => r.name || r.email).join(', ') || 'me'}</p>
                    <p class="mc-msg-peek">{row.visible.replace(/\s+/g, ' ').slice(0, 120)}</p>
                  </div>
                  <span class="mc-msg-time">{fullTime(m.created_at)}</span>
                  {m.is_read === false && <span class="mc-msg-new">new</span>}
                </button>
                <div class="mc-msg-body" id={'body-' + m.id}>
                  <div class="mc-msg-text">{row.visible}</div>
                  {row.signature && <div class="mc-msg-sig">{row.signature}</div>}
                  {/* QUOTED TEXT IS HIDDEN, NOT DELETED. It is one click away and it says how much
                      there is, because a reply whose quoted history is silently dropped is a reply
                      you cannot check. */}
                  {row.hasQuoted && (
                    <div class="mc-quoted">
                      <button type="button" class="mc-quoted-btn" aria-expanded="false">Show quoted text ({row.quoted.split('\n').length} lines)</button>
                      <pre class="mc-quoted-text" hidden>{row.quoted}</pre>
                    </div>
                  )}
                {m.from_user_id === user.id && (
                  <div class="mc-status">
                    {/* "Delivered" USED TO BE THE DEFAULT. Anything without a `failed` row in
                        email_logs was labelled delivered — including a message with NO log row at
                        all, which is what an external send that never reached a transport looks
                        like. Three states now, and the third one does not claim anything. */}
                    {(() => {
                      if (!m.delivery) return <span class="mc-st none" title="This message is stored in the mailbox. No external delivery was recorded for it, which is normal for mail that never left this system.">Stored, no delivery record</span>;
                      const w = deliveryWording(m.delivery);
                      const cls = w.tone === 'ok' ? 'ok' : w.tone === 'muted' ? 'none' : 'fail';
                      return <span class={'mc-st ' + cls} title={w.detail}>{w.label}</span>;
                    })()}
                    {(m.reads || []).length > 0
                      ? <span class="mc-st open">Opened{(m.reads as any[]).length > 1 ? ' · ' + (m.reads as any[]).length + ' opens' : ''}</span>
                      : <span class="mc-st none">Not opened yet</span>}
                  </div>
                )}
                {m.from_user_id === user.id && (m.reads || []).length > 0 && (
                  <div class="mc-reads">
                    <p class="mc-reads-head">Read by</p>
                    {(m.reads as any[]).slice(0, 6).map((r: any) => {
                      const place = [r.city, r.region, r.country].filter(Boolean).join(', ') || (r.ip_address ? 'IP ' + r.ip_address : 'unknown location');
                      const when = new Date(r.read_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                      return (
                        <div class="mc-read-row">
                          <span class="mc-read-dot" data-kind={r.kind}></span>
                          <span class="mc-read-when">{when}</span>
                          <span class="mc-read-place">{place}</span>
                          <span class="mc-read-kind">{r.kind === 'external' ? 'external open' : 'in app'}</span>
                        </div>
                      );
                    })}
                  </div>
                )}
                {/* ATTACHMENTS, THROUGH THE POLICY. `inline` is a raster image this site serves
                    itself; `link` opens in a new tab so the browser's own viewer and sandbox handle
                    it; `blocked` is listed with its name and NOT made clickable — you can still see
                    what you were sent. Nothing here is decided in the markup. */}
                {row.atts.length > 0 && (
                  <div class="mc-atts">
                    {row.atts.map((a: any) => (
                      a.v.preview === 'blocked' ? (
                        <div class="mc-att blocked" title={a.v.reason}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
                          <span>{a.v.safeName}</span>
                          {a.v.displaySize && <span class="mc-att-size">{a.v.displaySize}</span>}
                        </div>
                      ) : a.v.preview === 'inline' ? (
                        <figure class="mc-att-img">
                          <img src={a.raw.url} alt={a.v.safeName} loading="lazy" />
                          <figcaption>{a.v.safeName}{a.v.displaySize ? ' · ' + a.v.displaySize : ''}</figcaption>
                        </figure>
                      ) : (
                        <a href={a.raw.url} target="_blank" rel="noopener noreferrer" class="mc-att" title={a.v.reason}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg>
                          <span>{a.v.safeName}</span>
                          {a.v.displaySize && <span class="mc-att-size">{a.v.displaySize}</span>}
                        </a>
                      )
                    ))}
                  </div>
                )}
                {row.atts.filter((a: any) => a.v.warning).map((a: any) => (
                  <p class="mc-att-warn">{a.v.safeName}: {a.v.warning}</p>
                ))}
                </div>
              </div>
              );
            })}
          </div>

          <div class="mc-reply" data-thread={threadId} data-to={threadOtherParty} data-subject={threadSubject}>
            <button type="button" class="mc-reply-btn" id="mcReplyBtn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17l-5-5 5-5M4 12h11a5 5 0 0 1 0 10h-1"/></svg>
              Reply
            </button>
            <button type="button" class="mc-reply-btn ghost" id="mcForwardBtn">Forward</button>
          </div>
        </div>
      )}
    </div>
  </div>

  {/* KEYBOARD SHORTCUTS, AND THE WAY TO FIND OUT THEY EXIST.
      A shortcut nobody can discover is a shortcut for the person who wrote it. This opens on "?",
      and every action it lists is also reachable by a button — the keyboard is a faster route to
      the same thing, never the only route, which is what makes it an accessibility feature rather
      than a barrier. */}
  <div class="mc-keys" id="mcKeys" hidden role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
    <div class="mc-keys-card">
      <h3>Keyboard shortcuts</h3>
      <div class="mc-keys-row"><span>Next conversation</span><kbd>j</kbd></div>
      <div class="mc-keys-row"><span>Previous conversation</span><kbd>k</kbd></div>
      <div class="mc-keys-row"><span>Open</span><kbd>Enter</kbd></div>
      <div class="mc-keys-row"><span>Tick the box</span><kbd>x</kbd></div>
      <div class="mc-keys-row"><span>Reply</span><kbd>r</kbd></div>
      <div class="mc-keys-row"><span>Forward</span><kbd>f</kbd></div>
      <div class="mc-keys-row"><span>Compose</span><kbd>c</kbd></div>
      <div class="mc-keys-row"><span>Archive</span><kbd>e</kbd></div>
      <div class="mc-keys-row"><span>Mark unread</span><kbd>u</kbd></div>
      <div class="mc-keys-row"><span>Star</span><kbd>s</kbd></div>
      <div class="mc-keys-row"><span>Search</span><kbd>/</kbd></div>
      <div class="mc-keys-row"><span>This list</span><kbd>?</kbd></div>
      <p class="mc-keys-note">
        Shortcuts are off while you are typing, so a letter in the middle of a sentence never files
        the conversation behind the composer. Every one of them is also a button on screen.
      </p>
      <button type="button" class="mc-convo-btn" id="mcKeysClose">Close</button>
    </div>
  </div>

  <!-- Compose modal -->
  <div class="mc-modal" id="mcModal" hidden>
    <div class="mc-modal-card">
      <div class="mc-modal-head">
        <span id="mcModalTitle">New message</span>
        <button type="button" id="mcClose" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="mc-modal-body">
        <input type="hidden" id="mcThreadId" />
        <input type="hidden" id="mcInReplyTo" />
        <div class="mc-field"><label>To</label><input type="text" id="mcTo" placeholder="name@example.com, or @group:slug" /></div>
        <div class="mc-field mc-ccrow">
          <label>Cc</label><input type="text" id="mcCc" placeholder="cc (optional)" />
          <label>Bcc</label><input type="text" id="mcBcc" placeholder="bcc (optional)" />
        </div>
        <p style="font-size:11px;color:#6b7280;margin:-8px 0 4px;padding:0 2px;">Tip: type <code style="font-family:monospace;background:#f3f4f6;padding:1px 5px;border-radius:3px;">@group:slug</code> in any field to send to a saved group. Hidden-recipient groups auto-BCC. <a href="/admin/mail/groups" style="color:#FF4F00;text-decoration:none;">Manage groups</a></p>
        <div class="mc-field"><label>Subject</label><input type="text" id="mcSubject" placeholder="Subject" /></div>
        <p id="mcTplNote" hidden style="font-size:11px;color:#fbbf24;margin:-4px 0 6px;padding:0 2px;line-height:1.5;"></p>
        <textarea id="mcBody" rows="9" placeholder="Write your message..."></textarea>
        <div class="mc-field"><label>Attach URL</label><input type="text" id="mcAttUrl" placeholder="https://drive... link (optional)" /></div>
        <div class="mc-att-list" id="mcAttList"></div>
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:8px;padding:0 2px;">
          <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--mc-text);cursor:pointer;"><input type="checkbox" id="mcSig" checked /> Append signature</label>
          <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--mc-text);">Schedule <input type="datetime-local" id="mcSchedule" style="font-size:12px;background:var(--mc-soft);border:1px solid var(--mc-border);border-radius:6px;color:var(--mc-text);padding:3px 6px;" /></label>
          <a href="/admin/mail/rules" style="font-size:11px;color:#FF4F00;text-decoration:none;margin-left:auto;">Edit signature &amp; rules &rarr;</a>
        </div>
      </div>
      <div class="mc-modal-foot">
        <button type="button" class="mc-send" id="mcSend">Send</button>
        <button type="button" class="mc-savedraft" id="mcSaveDraft">Save draft</button>
        <span class="mc-status" id="mcStatus"></span>
      </div>
    </div>
  </div>
</div>

<style>
.mailc{
  --mc-bg: var(--o-bg0, #07090d);
  --mc-card: var(--o-bg2, #0f1218);
  --mc-soft: var(--o-panel, rgba(255,255,255,0.045));
  --mc-border: var(--o-stroke, rgba(255,255,255,0.09));
  --mc-text: var(--o-hi, #e9edf2);
  --mc-mid: var(--o-mid, #8b94a3);
  --mc-accent: var(--o-brand, #FF4F00);
  --mc-accent-bright: var(--o-brand-bright, #ff8a4c);
  color: var(--mc-text); display:flex; flex-direction:column; height:calc(100vh - 0px); min-height:560px;
  font-family: var(--o-font-body, inherit);
}
.mc-alert{ padding:10px 16px; background:rgba(239,68,68,0.12); border-bottom:1px solid rgba(239,68,68,0.32); color:#fca5a5; font-size:12px; line-height:1.5; overflow-wrap:anywhere; }
.mc-alert[hidden]{ display:none !important; }
.mc-thread-error{ margin:14px 18px 0; padding:10px 12px; background:rgba(251,191,36,0.12); border:1px solid rgba(251,191,36,0.28); border-radius:9px; color:#fbbf24; font-size:12px; line-height:1.5; overflow-wrap:anywhere; }
.mc-head{ display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid var(--mc-border); background:var(--mc-bg); position:sticky; top:0; z-index:8; flex-wrap:wrap; }
.mc-head-id{ display:flex; align-items:center; gap:9px; min-width:0; }
.mc-dot{ width:32px; height:32px; border-radius:9px; background:linear-gradient(135deg,var(--mc-accent),var(--mc-accent-bright)); flex-shrink:0; box-shadow:0 0 16px var(--o-brand-glow, rgba(255,79,0,0.35)); }
.mc-title{ font-size:14px; font-weight:800; margin:0; letter-spacing:-0.01em; }
.mc-addr{ font-size:11px; margin:0; color:var(--mc-mid); font-family:var(--o-font-mono,monospace); }
.mc-search{ flex:1; min-width:160px; display:flex; align-items:center; gap:8px; background:var(--mc-soft); border:1px solid var(--mc-border); border-radius:10px; padding:0 10px; color:var(--mc-mid); }
.mc-search input{ flex:1; background:transparent; border:none; outline:none; color:var(--mc-text); font-size:13px; padding:9px 0; }
.mc-compose-btn{ display:flex; align-items:center; gap:7px; background:linear-gradient(135deg,var(--mc-accent),var(--mc-accent-bright)); color:#fff; border:none; border-radius:10px; padding:9px 16px; font-size:13px; font-weight:700; cursor:pointer; box-shadow:0 6px 18px var(--o-brand-glow, rgba(255,79,0,0.32)); }

.mc-body{ flex:1; display:grid; grid-template-columns:190px 360px 1fr; min-height:0; }
.mc-rail{ border-right:1px solid var(--mc-border); padding:10px 8px; display:flex; flex-direction:column; gap:2px; background:var(--mc-bg); overflow-y:auto; }
.mc-rail-item{ display:flex; align-items:center; justify-content:space-between; gap:8px; text-decoration:none; color:var(--mc-mid); font-size:13px; font-weight:600; padding:9px 12px; border-radius:9px; }
.mc-rail-item:hover{ background:var(--mc-soft); color:var(--mc-text); }
.mc-rail-item.on{ background:var(--o-brand-soft, rgba(255,79,0,0.14)); color:var(--mc-text); box-shadow:inset 2px 0 0 var(--mc-accent); }
.mc-rail-badge{ background:var(--mc-accent); color:#fff; font-size:10px; font-weight:800; border-radius:100px; padding:1px 7px; }

.mc-list{ border-right:1px solid var(--mc-border); overflow-y:auto; background:var(--mc-bg); }
.mc-scope{ display:flex; gap:8px; align-items:center; justify-content:space-between; padding:8px 14px; font-size:11px; border-bottom:1px solid var(--mc-border); color:var(--mc-mid); }
.mc-scope a{ color:inherit; text-decoration:underline; text-underline-offset:2px; min-height:44px; display:inline-flex; align-items:center; }
.mc-row{ display:flex; align-items:flex-start; gap:10px; padding:11px 12px; border-bottom:1px solid var(--mc-border); text-decoration:none; color:var(--mc-text); position:relative; }
.mc-row:hover{ background:var(--mc-soft); }
.mc-row.sel{ background:var(--o-brand-soft, rgba(255,79,0,0.12)); }
.mc-row.unread{ background:color-mix(in srgb, var(--mc-card) 60%, transparent); }
.mc-row.unread .mc-from, .mc-row.unread .mc-subj{ font-weight:800; }
.mc-star{ background:none; border:none; color:var(--mc-mid); cursor:pointer; padding:2px; margin-top:2px; flex-shrink:0; }
.mc-star.on{ color:#f5b30a; }
.mc-avatar{ width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg,var(--mc-accent),var(--mc-accent-bright)); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:14px; flex-shrink:0; }
.mc-avatar.sm{ width:30px; height:30px; font-size:12px; }
.mc-row-main{ flex:1; min-width:0; }
.mc-row-top{ display:flex; justify-content:space-between; gap:8px; }
.mc-from{ font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mc-time{ font-size:11px; color:var(--mc-mid); flex-shrink:0; }
.mc-subj{ font-size:12.5px; margin:2px 0 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mc-count{ display:inline-block; background:var(--mc-soft); border:1px solid var(--mc-border); color:var(--mc-mid); font-size:10px; font-weight:700; border-radius:100px; padding:0 6px; margin-left:6px; }
.mc-snip{ font-size:11.5px; color:var(--mc-mid); margin:2px 0 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.mc-row-icons{ color:var(--mc-mid); flex-shrink:0; margin-top:3px; }
.mc-empty,.mc-read-empty{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; color:var(--mc-mid); padding:60px 20px; text-align:center; font-size:13px; height:100%; }

.mc-read{ overflow-y:auto; background:var(--mc-bg); }
.mc-thread-head{ display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--mc-border); position:sticky; top:0; background:var(--mc-bg); z-index:5; }
.mc-back{ display:none; color:var(--mc-text); }
.mc-thread-subj{ font-size:17px; font-weight:800; margin:0; flex:1; letter-spacing:-0.01em; }
.mc-thread-actions{ display:flex; gap:4px; }
.mc-act{ background:var(--mc-soft); border:1px solid var(--mc-border); color:var(--mc-mid); width:32px; height:32px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.mc-act:hover{ color:var(--mc-text); border-color:var(--mc-accent); }
.mc-msgs{ padding:16px 18px; display:flex; flex-direction:column; gap:14px; }
.mc-msg{ background:var(--mc-card); border:1px solid var(--mc-border); border-radius:14px; padding:14px 16px; }
.mc-msg-head{ display:flex; align-items:center; gap:10px; margin-bottom:10px; }
.mc-msg-meta{ flex:1; min-width:0; }
.mc-msg-from{ font-size:13px; font-weight:700; margin:0; }
.mc-msg-email{ font-weight:400; color:var(--mc-mid); font-size:11px; }
.mc-msg-to{ font-size:11px; color:var(--mc-mid); margin:1px 0 0; }
.mc-msg-time{ font-size:11px; color:var(--mc-mid); flex-shrink:0; }
.mc-msg-body{ font-size:14px; line-height:1.65; white-space:pre-wrap; word-break:break-word; }
.mc-status{ display:flex; gap:6px; margin-top:10px; flex-wrap:wrap; }
.mc-st{ font-size:10.5px; font-weight:700; padding:2px 9px; border-radius:100px; letter-spacing:0.02em; }
.mc-st.ok{ background:rgba(16,185,129,0.14); color:#10b981; }
.mc-st.open{ background:rgba(16,185,129,0.22); color:#059669; }
.mc-st.none{ background:var(--mc-soft); color:var(--mc-mid); border:1px solid var(--mc-border); }
.mc-st.fail{ background:rgba(239,68,68,0.14); color:#ef4444; }
.mc-reads{ margin-top:12px; padding:10px 12px; background:var(--mc-soft); border:1px solid var(--mc-border); border-radius:9px; }
.mc-reads-head{ font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--mc-mid); margin:0 0 6px; }
.mc-read-row{ display:flex; align-items:center; gap:8px; font-size:11.5px; padding:2px 0; flex-wrap:wrap; }
.mc-read-dot{ width:6px; height:6px; border-radius:50%; background:#34d399; flex-shrink:0; }
.mc-read-dot[data-kind="external"]{ background:#60a5fa; }
.mc-read-when{ color:var(--mc-mid); font-family:var(--o-font-mono,monospace); }
.mc-read-place{ color:var(--mc-text); flex:1; }
.mc-read-kind{ color:var(--mc-mid); font-size:10.5px; text-transform:lowercase; }
.mc-atts{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.mc-att{ display:flex; align-items:center; gap:6px; background:var(--mc-soft); border:1px solid var(--mc-border); border-radius:8px; padding:6px 10px; font-size:12px; color:var(--mc-text); text-decoration:none; }
.mc-reply{ padding:12px 18px 22px; display:flex; gap:8px; }
.mc-reply-btn{ display:flex; align-items:center; gap:7px; background:var(--mc-soft); border:1px solid var(--mc-border); color:var(--mc-text); border-radius:10px; padding:10px 18px; font-size:13px; font-weight:700; cursor:pointer; }
