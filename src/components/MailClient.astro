---
// Full unified mail client — the ONLY UI of the one mail system (src/lib/mail.ts +
// mail-transport.ts + mail-groups.ts + mail-advanced.ts). Mounted at exactly two routes:
//   /admin/mail           — the console mount, behind AdminLayout.
//   /portal/employee/mail — the employee mount, gated by canUseMailbox() (src/lib/auth/mail-access.ts).
// The line here used to name /portal/mail. That was never this component: /portal/mail is a
// SEPARATE, older mailbox on portal_mail_* tables with no SMTP or IMAP path, now a read-only archive
// that redirects to /portal/employee/mail for anyone with nothing stored in it.
//
// Props: user (Astro.locals.user), basePath ('/admin/mail' | '/portal/employee/mail').
// basePath drives navigation only; the three write endpoints are absolute (/api/mail/{send,draft,
// action}) and each authorises through denyMailApi(), so both mounts meet the same gate.
import { getFolderCounts, getMailboxAddress, listFolder, getThreadMessages, markThreadRead, FOLDERS } from '@/lib/mail';
import type { FolderListing } from '@/lib/mail';

const { user, basePath = '/admin/mail' } = Astro.props as { user: any; basePath?: string };

const url = new URL(Astro.request.url);
const folderParam = url.searchParams.get('folder') || 'inbox';
const starred = folderParam === 'starred';
const folder = starred ? 'inbox' : (folderParam as any);
const q = url.searchParams.get('q') || '';
const label = url.searchParams.get('label') || null;
const threadId = url.searchParams.get('thread') || '';

let counts: Record<string, number> = {};
let myAddress = '';
let listing: FolderListing | null = null;
let dbReady = true;
// The reason, kept, so the banner can say what went wrong instead of guessing.
let mailError = '';
try {
  counts = await getFolderCounts(user.id);
  myAddress = await getMailboxAddress(user.id);
  // THE MAIL LIST WAS DEAD. listFolder was rewritten to take (userId, opts) and to return a
  // FolderListing OBJECT — { rows, query, filtered, scopeLabel } — and this, its only caller in
  // the repository, was never changed off the old (userId, folder, q, starred) positional form.
  // Two consequences, and neither announced itself: `folder`, `q` and `starred` were all dropped
  // on the floor (the second argument was a string where an options object was expected, so every
  // listing ignored the folder you clicked and the terms you searched), and `list` then held an
  // object, so `list.length === 0` was `undefined === 0` — false, hiding the empty state — and
  // `list.map(...)` threw TypeError while rendering. Both mail mounts answered 500.
  listing = await listFolder(user.id, { folder, starred, label, query: q });
} catch (e: any) {
  // NOT SWALLOWED. The real Postgres reason is on e.cause; e.message is only the failed SQL.
  dbReady = false;
  mailError = String(e?.cause?.message || e?.message || 'unknown error');
  console.error('[MailClient] listing failed:', mailError);
}
const list: any[] = listing ? listing.rows : [];
// What is actually on screen, from the listing itself rather than from the folder in the URL: a
// search with `in:anywhere` or a label pseudo-folder does not return the folder you are standing in.
const scopeLabel = listing ? listing.scopeLabel : '';
const filtered = !!(listing && listing.filtered);
const queryNote = listing && listing.query && listing.query.active ? listing.query.describe : '';

let thread: any[] = [];
let threadSubject = '';
let threadOtherParty = '';
// The reason a conversation would not open. It used to be thrown away by `catch (e) { thread = []; }`
// and an unreadable thread rendered as an EMPTY one — the reader was shown a conversation with no
// messages in it and told nothing had gone wrong.
let threadError = '';
if (threadId && dbReady) {
  try {
    // ONE READ, IN ONE PLACE. getThreadMessages() already resolves recipients, attachments, read
    // receipts AND delivery for every message in the thread (src/lib/mail.ts) — the four-statement
    // version written precisely to replace the raw block that used to sit here. That block was
    // still here, running AFTER it, and it did two harmful things:
    //
    //  1. IT THREW ON EVERY THREAD THE VIEWER HAD SENT INTO. `= ANY(${myMessageIds}::uuid[])` binds
    //     a JS array as a record literal, so Postgres refuses the cast (src/lib/pg-array.ts). The
    //     catch below then blanked `thread` and drew the "could not be opened" state over a
    //     conversation that was sitting right there — a reading pane that could not open its own
    //     sent mail.
    //  2. IT OVERWROTE THE DELIVERY TRUTH WITH THE VERSION THAT LIED. It re-keyed email_logs by
    //     rfc_message_id, which /api/mail/send does not write, and replaced the resolved
    //     DeliveryStatus with a raw log row — undoing the repair mail.ts documents at its
    //     "Delivery truth" heading.
    //
    // Deleted, not reimplemented. Nothing is lost: m.reads and m.delivery are already populated.
    thread = await getThreadMessages(user.id, threadId);
    await markThreadRead(user.id, threadId);
  } catch (e: any) {
    // NOT SWALLOWED. e.cause carries the real Postgres reason; e.message is only the failed SQL.
    thread = [];
    threadError = String(e?.cause?.message || e?.message || 'unknown error');
    console.error('[MailClient] thread failed:', threadError);
  }
  const first = thread[0];
  threadSubject = first?.subject || '(no subject)';
  const last = thread[thread.length - 1] || {};
  const myEmail = (myAddress || '').toLowerCase();
  threadOtherParty = (last.from_email && last.from_email.toLowerCase() !== myEmail)
    ? last.from_email
    : ((last.recipients || []).find((r: any) => (r.email || '').toLowerCase() !== myEmail)?.email || last.from_email || '');
}

// ------------------------------------------------------------------------------------------------
// TEMPLATE PREFILL - the missing half of /admin/mail/templates.
//
// That page authors rows in `email_templates` and its own copy says to "load a template into the
// composer". Nothing in the repository read that table: not this component, not /api/mail/send, not
// mail.ts. The whole screen - the editor, the live preview, the active/off toggle, the Duplicate
// button - wrote to a table with no reader, which is a feature that cannot be used, only maintained.
// `?template=<id>` is the reader.
//
// SCOPED TO THE ADMIN MOUNT. This component is also mounted at /portal/employee/mail for people who
// hold a mailbox but not the mail console; templates are console content and are not published to
// that mount.
//
// AN INACTIVE TEMPLATE IS REFUSED, WITH A REASON. That is what makes the "active / off" toggle on
// the templates page mean something: before this, `is_active` was a column nothing consulted.
let templateSubject = '';
let templateHtml = '';
let templateNote = '';
const templateId = (url.searchParams.get('template') || '').trim();
if (templateId && basePath === '/admin/mail') {
  try {
    const { db } = await import('@/lib/db');
    const { sql } = await import('drizzle-orm');
    const tr = await db.execute(sql`
      SELECT template_key, subject, body_html, is_active
        FROM email_templates WHERE id = ${templateId} LIMIT 1`);
    const t = ((Array.isArray(tr) ? tr : ((tr as any)?.rows || [])) as any[])[0];
    if (!t) templateNote = 'That template no longer exists.';
    else if (!t.is_active) templateNote = 'Template "' + t.template_key + '" is switched off, so it was not loaded. Turn it on in Email Templates first.';
    else {
      templateSubject = String(t.subject || '');
      templateHtml = String(t.body_html || '');
      templateNote = 'Template "' + t.template_key + '" loaded. It will be sent as HTML exactly as written - nothing substitutes {{...}} placeholders, so replace them by hand before sending.';
    }
  } catch (e: any) {
    // NOT SWALLOWED, and NOT rendered as an empty composer that silently dropped the template.
    templateNote = 'That template could not be loaded: ' + String(e?.cause?.message || e?.message || 'unknown error');
    console.error('[MailClient] template load failed:', templateNote);
  }
}

function stripTags(s: string) { return String(s || '').replace(/<style[\s\S]*?<\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); }
function bodyToText(m: any) { return m.body_text || stripTags(m.body_html); }
function initialOf(s: string) { return (s || '?').trim().charAt(0).toUpperCase() || '?'; }
function timeAgo(d: any) {
  if (!d) return '';
  const diff = Date.now() - new Date(d).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return 'now';
  if (m < 60) return m + 'm';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h';
  const days = Math.floor(h / 24);
  if (days < 7) return days + 'd';
  return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short' });
}
function fullTime(d: any) { return d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''; }

const folderLinks = [
  ...FOLDERS.slice(0, 1),
  { key: 'starred', label: 'Starred' } as any,
  ...FOLDERS.slice(1),
];
---

<div class="mailc" data-base={basePath}>
  {/* This banner used to read "Mailboxes are being set up. Once the database migration runs, your
      inbox will appear here." for EVERY failure — a dropped connection, a bad query, a permission
      error — which told people to wait for a migration that was not pending and would never come.
      It now says that the mail could not be loaded, and what the server actually reported. */}
  {!dbReady && (
    <div style="padding:9px 16px;background:rgba(251,191,36,0.12);border-bottom:1px solid rgba(251,191,36,0.28);color:#fbbf24;font-size:12px;">
      Your mail could not be loaded, so this list is empty for a reason that is not "no mail":
      {' '}{mailError}
    </div>
  )}
  {/* Where a FAILED star, archive, delete, mark-unread or spam report is said out loud. Those five
      buttons used to fire and then reload or navigate whichever way the request went, so a refused
      action left you on a fresh inbox with the mail exactly as it was and nothing on screen to say
      so — the same "reported success while nothing happened" this client was repaired for. */}
  <div class="mc-alert" id="mcAlert" role="alert" hidden></div>
  <!-- Header -->
  <div class="mc-head">
    <div class="mc-head-id">
      <span class="mc-dot"></span>
      <div>
        <p class="mc-title">Mail</p>
        <p class="mc-addr">{myAddress}</p>
      </div>
    </div>
    <form class="mc-search" method="get" action={basePath}>
      <input type="hidden" name="folder" value={folderParam} />
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" name="q" value={q} placeholder="Search mail" autocomplete="off" />
    </form>
    <button type="button" class="mc-compose-btn" id="mcComposeBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      <span>Compose</span>
    </button>
  </div>

  <div class={`mc-body ${threadId ? 'mc-has-thread' : ''}`}>
    <!-- Folder rail -->
    <nav class="mc-rail">
      {folderLinks.map((f: any) => {
        const active = f.key === 'starred' ? starred : (!starred && folderParam === f.key);
        const unread = counts[f.key] || 0;
        return (
          <a href={`${basePath}?folder=${f.key}`} class={`mc-rail-item ${active ? 'on' : ''}`}>
            <span class="mc-rail-label">{f.label}</span>
            {unread > 0 && f.key !== 'sent' && f.key !== 'starred' && <span class="mc-rail-badge">{unread}</span>}
          </a>
        );
      })}
    </nav>

    <!-- Thread list -->
    <div class="mc-list">
      {/* What this list is actually showing. A search for `in:anywhere`, or a label, returns mail
          from outside the folder highlighted in the rail, and without this line the rail is simply
          wrong about where you are. */}
      {dbReady && filtered && (
        <div class="mc-scope">
          {scopeLabel}{queryNote ? ' - ' + queryNote : ''}
          <a href={`${basePath}?folder=${folderParam}`}>clear</a>
        </div>
      )}
      {list.length === 0 && (
        <div class="mc-empty">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          {/* "Nothing here yet" is only true when the listing succeeded. When it failed, an empty
              list means the mail was not read, not that there is none. */}
          <p>{!dbReady ? 'This list could not be loaded - see the message above.' : (filtered ? 'No mail matches that.' : 'Nothing here yet.')}</p>
        </div>
      )}
      {list.map((t: any) => (
        <a href={`${basePath}?folder=${folderParam}&thread=${t.thread_id}`} class={`mc-row ${t.is_read ? '' : 'unread'} ${threadId === t.thread_id ? 'sel' : ''}`}>
          <button type="button" class={`mc-star ${t.is_starred ? 'on' : ''}`} data-thread={t.thread_id} data-action={t.is_starred ? 'unstar' : 'star'} aria-label="Star">
            <svg width="16" height="16" viewBox="0 0 24 24" fill={t.is_starred ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.7"><path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
          </button>
          <div class="mc-avatar" aria-hidden="true">{initialOf(folder === 'sent' || folder === 'drafts' ? (t.from_name || myAddress) : t.from_name)}</div>
          <div class="mc-row-main">
            <div class="mc-row-top">
              <span class="mc-from">{t.from_name || t.from_email}</span>
              <span class="mc-time">{timeAgo(t.created_at)}</span>
            </div>
            <p class="mc-subj">{t.subject || '(no subject)'}{t.thread_count > 1 && <span class="mc-count">{t.thread_count}</span>}</p>
            <p class="mc-snip">{t.snippet}</p>
          </div>
          <div class="mc-row-icons">
            {t.has_attachments && <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg>}
          </div>
        </a>
      ))}
    </div>

    <!-- Reading pane -->
    <div class="mc-read">
      {!threadId && (
        <div class="mc-read-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.45"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          <p>Select a conversation to read</p>
        </div>
      )}
      {threadId && (
        <div class="mc-thread">
          <div class="mc-thread-head">
            <a href={`${basePath}?folder=${folderParam}`} class="mc-back" aria-label="Back">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <h2 class="mc-thread-subj">{threadSubject}</h2>
            <div class="mc-thread-actions">
              <button type="button" class="mc-act" data-thread={threadId} data-action="archive" title="Archive">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="5" rx="1"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9M10 13h4"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="trash" title="Delete">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="unread" title="Mark unread">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
              </button>
              <button type="button" class="mc-act" data-thread={threadId} data-action="spam" title="Report spam">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
              </button>
            </div>
          </div>

          {threadError && (
            <div class="mc-thread-error">
              This conversation could not be read, so it is empty here for a reason that is not "no
              messages": {threadError}
            </div>
          )}
          <div class="mc-msgs">
            {thread.map((m: any) => (
              <div class="mc-msg">
                <div class="mc-msg-head">
                  <div class="mc-avatar sm">{initialOf(m.from_name || m.from_email)}</div>
                  <div class="mc-msg-meta">
                    <p class="mc-msg-from">{m.from_name || m.from_email} <span class="mc-msg-email">&lt;{m.from_email}&gt;</span></p>
                    <p class="mc-msg-to">to {(m.recipients || []).map((r: any) => r.name || r.email).join(', ') || 'me'}</p>
                  </div>
                  <span class="mc-msg-time">{fullTime(m.created_at)}</span>
                </div>
                <div class="mc-msg-body">{bodyToText(m)}</div>
                {m.from_user_id === user.id && (
                  <div class="mc-status">
                    {/* "Delivered" USED TO BE THE DEFAULT. Anything without a `failed` row in
                        email_logs was labelled delivered — including a message with NO log row at
                        all, which is what an external send that never reached a transport looks
                        like. Three states now, and the third one does not claim anything. */}
                    {/* READ THE FIELD THAT EXISTS. getDeliveryStatuses() returns a DeliveryStatus
                        whose verdict is on `state`; this read `m.delivery?.status`, a property of
                        the raw email_logs row the deleted frontmatter block used to attach. On a
                        DeliveryStatus that expression is ALWAYS undefined, so the `failed` arm could
                        never be taken and a hard-failed external send rendered the green
                        "Delivered" badge — the very default mail.ts removed. Six states, each said
                        as what it is, and 'unknown' never claims delivery. */}
                    {m.delivery?.state === 'failed'
                      ? <span class="mc-st fail" title={m.delivery?.error || ''}>Failed to send</span>
                      : m.delivery?.state === 'partial'
                      ? <span class="mc-st fail" title={m.delivery?.error || ''}>Partly delivered &middot; {m.delivery?.failed} of {m.delivery?.externalCount} failed</span>
                      : m.delivery?.state === 'sent'
                      ? <span class="mc-st ok">Delivered</span>
                      : m.delivery?.state === 'internal'
                      ? <span class="mc-st ok" title="Everyone on this message has a mailbox here, so it was delivered by writing their mailbox row. Nothing had to leave the building.">Delivered here</span>
                      : m.delivery?.state === 'no_transport'
                      ? <span class="mc-st fail" title="This message has external recipients but no mail transport is configured, so it has not left the building.">Not sent &middot; no transport</span>
                      : m.delivery?.state === 'unknown'
                      ? <span class="mc-st none" title="The delivery log could not be read, so nothing is being claimed about this message either way.">Delivery unknown</span>
                      : <span class="mc-st none" title="This message is stored in the mailbox. No external delivery was recorded for it, which is normal for mail that never left this system.">Stored, no delivery record</span>}
                    {(m.reads || []).length > 0
                      ? <span class="mc-st open">Opened{(m.reads as any[]).length > 1 ? ' · ' + (m.reads as any[]).length + ' opens' : ''}</span>
                      : <span class="mc-st none">Not opened yet</span>}
                  </div>
                )}
                {m.from_user_id === user.id && (m.reads || []).length > 0 && (
                  <div class="mc-reads">
                    <p class="mc-reads-head">Read by</p>
                    {(m.reads as any[]).slice(0, 6).map((r: any) => {
                      const place = [r.city, r.region, r.country].filter(Boolean).join(', ') || (r.ip_address ? 'IP ' + r.ip_address : 'unknown location');
                      const when = new Date(r.read_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                      return (
                        <div class="mc-read-row">
                          <span class="mc-read-dot" data-kind={r.kind}></span>
                          <span class="mc-read-when">{when}</span>
                          <span class="mc-read-place">{place}</span>
                          <span class="mc-read-kind">{r.kind === 'external' ? 'external open' : 'in app'}</span>
                        </div>
                      );
                    })}
                  </div>
                )}
                {(m.attachments || []).length > 0 && (
                  <div class="mc-atts">
                    {m.attachments.map((a: any) => (
                      <a href={a.url} target="_blank" rel="noopener" class="mc-att">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg>
                        <span>{a.filename}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          <div class="mc-reply" data-thread={threadId} data-to={threadOtherParty} data-subject={threadSubject}>
            <button type="button" class="mc-reply-btn" id="mcReplyBtn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17l-5-5 5-5M4 12h11a5 5 0 0 1 0 10h-1"/></svg>
              Reply
            </button>
            <button type="button" class="mc-reply-btn ghost" id="mcForwardBtn">Forward</button>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Compose modal -->
  <div class="mc-modal" id="mcModal" hidden>
    <div class="mc-modal-card">
      <div class="mc-modal-head">
        <span id="mcModalTitle">New message</span>
        <button type="button" id="mcClose" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="mc-modal-body">
        <input type="hidden" id="mcThreadId" />
        <input type="hidden" id="mcInReplyTo" />
        <div class="mc-field"><label>To</label><input type="text" id="mcTo" placeholder="name@example.com, or @group:slug" /></div>
        <div class="mc-field mc-ccrow">
          <label>Cc</label><input type="text" id="mcCc" placeholder="cc (optional)" />
          <label>Bcc</label><input type="text" id="mcBcc" placeholder="bcc (optional)" />
        </div>
        <p style="font-size:11px;color:#6b7280;margin:-8px 0 4px;padding:0 2px;">Tip: type <code style="font-family:monospace;background:#f3f4f6;padding:1px 5px;border-radius:3px;">@group:slug</code> in any field to send to a saved group. Hidden-recipient groups auto-BCC. <a href="/admin/mail/groups" style="color:#FF4F00;text-decoration:none;">Manage groups</a></p>
        <div class="mc-field"><label>Subject</label><input type="text" id="mcSubject" placeholder="Subject" /></div>
        <p id="mcTplNote" hidden style="font-size:11px;color:#fbbf24;margin:-4px 0 6px;padding:0 2px;line-height:1.5;"></p>
        <textarea id="mcBody" rows="9" placeholder="Write your message..."></textarea>
        <div class="mc-field"><label>Attach URL</label><input type="text" id="mcAttUrl" placeholder="https://drive... link (optional)" /></div>
        <div class="mc-att-list" id="mcAttList"></div>
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:8px;padding:0 2px;">
          <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--mc-text);cursor:pointer;"><input type="checkbox" id="mcSig" checked /> Append signature</label>
