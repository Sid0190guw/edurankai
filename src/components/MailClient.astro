          sendBtn.disabled = false;
        } else if (gw) {
          $('mcStatus').textContent = (res.external && res.external.attempted ? ('Sent (external via ' + res.external.provider + ').') : 'Sent.') + gw;
          sendBtn.disabled = false;
        } else {
          $('mcStatus').textContent = res.external && res.external.attempted ? ('Sent (external via ' + res.external.provider + ')') : 'Sent';
          setTimeout(function(){ location.href = basePath + '?folder=sent'; }, 500);
        }
      }
      else { $('mcStatus').textContent = 'Not sent - ' + (res.error || 'the server refused it without saying why') + '. Your message is still here.'; sendBtn.disabled=false; }
    }catch(e){ $('mcStatus').textContent='Not sent - ' + ((e && e.message) || 'this page could not complete the request') + '. Your message is still here.'; sendBtn.disabled=false; }
  });
  const draftBtn = $('mcSaveDraft');
  if (draftBtn) draftBtn.addEventListener('click', async function(){
    $('mcStatus').textContent='Saving...';
    try{ const res = await post('/api/mail/draft', payload()); $('mcStatus').textContent = res.ok ? 'Draft saved' : ('Not saved - ' + (res.error||'the server refused it without saying why')); if(res.ok) setTimeout(closeModal, 500); }
    catch(e){ $('mcStatus').textContent='Not saved - ' + ((e && e.message) || 'this page could not complete the request'); }
  });

  // Star toggles + thread actions.
  //
  // BOTH OF THESE USED TO IGNORE THE ANSWER. They awaited the POST and then reloaded (star) or
  // navigated to the inbox (archive / delete / mark-unread / spam) whichever way it went. A refused
  // action therefore looked identical to a completed one: you landed on a freshly-drawn inbox with
  // the mail exactly as it had been, and nothing said why. Neither navigates now unless the server
  // confirmed the change, and a refusal is printed at the top of the client.
  // THE STAR HANDLER MOVED, IT DID NOT DISAPPEAR. It now lives in bindStar() further down, for one
  // reason: rows appended by "load more" are created after this line has already run, so a
  // querySelectorAll here would leave every control on an appended row inert — the button would be
  // there, it would look identical, and clicking it would do nothing at all. bindStar() is called
  // for the server-rendered rows AND for each row the client builds, and it guards on a data-bound
  // attribute so a row can never end up with two handlers posting the same change twice.
  const ACTION_DONE = { archive: 'archived', trash: 'deleted', unread: 'marked unread', spam: 'reported as spam' };
  document.querySelectorAll('.mc-act').forEach(function(btn){
    btn.addEventListener('click', async function(){
      const thread = btn.getAttribute('data-thread'); const action = btn.getAttribute('data-action');
      btn.disabled = true;
      const res = await post('/api/mail/action', { action: action, threadId: thread });
      if (!res || res.ok !== true) {
        btn.disabled = false;
        showAlert('This conversation was not ' + (ACTION_DONE[action] || action) + ', and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '. It is still where it was.');
        return;
      }
      location.href = basePath + '?folder=inbox';
    });
  });

  // ==============================================================================================
  // PATCH 11 — the advanced client.
  //
  // EVERY HANDLER BELOW READS THE ANSWER. That is the rule this component was repaired for once
  // already: a button that fires a request and then reloads whichever way it went makes a refusal
  // look exactly like a success. Nothing here navigates or redraws unless the server confirmed it,
  // and a refusal is printed where the person is looking.
  //
  // NOTHING HERE ENUMERATES A LARGE SELECTION. "Select all results" posts the QUERY; the server
  // resolves it. Ten thousand ids never cross the wire and there is never a request per row.
  // ==============================================================================================

  var selected = new Set();
  var allResults = false;   // true when the selection is "everything matching", not a list of ids
  var excluded = new Set(); // ticked off by hand after choosing all results

  function $$(sel){ return Array.prototype.slice.call(document.querySelectorAll(sel)); }
  function setStatus(el, msg, tone){
    if (!el) return;
    el.textContent = msg || '';
    el.className = 'mc-bulk-status' + (tone ? ' ' + tone : '');
  }

  // ---- Rows: click, keyboard focus, and the checkbox that must not follow the link ------------
  function rowHref(row){ return row.getAttribute('data-href'); }
  $$('.mc-row').forEach(function(row){
    row.addEventListener('click', function(e){
      // A click on the checkbox, the star or the inner link is that control's business.
      if (e.target.closest('.mc-pick') || e.target.closest('.mc-star') || e.target.closest('a')) return;
      var href = rowHref(row);
      if (href) location.href = href;
    });
    row.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') {
        if (e.target !== row) return;
        e.preventDefault();
        var href = rowHref(row);
        if (href) location.href = href;
      }
    });
  });

  // ---- Selection --------------------------------------------------------------------------------
  function pickedThreads(){
    return $$('.mc-pick').filter(function(c){ return c.checked; }).map(function(c){ return c.getAttribute('data-thread'); });
  }
  function refreshSelection(){
    var picks = pickedThreads();
    selected = new Set(picks);
    var bar = document.getElementById('mcBulk');
    var count = document.getElementById('mcBulkCount');
    var all = document.getElementById('mcAllResults');
    var allText = document.getElementById('mcAllResultsText');
    if (!bar) return;
    var n = allResults ? ((mcTotal == null ? picks.length : mcTotal) - excluded.size) : picks.length;
    bar.hidden = picks.length === 0 && !allResults;
    if (count) {
      count.textContent = allResults
        ? ('All ' + (mcTotal == null ? picks.length : mcTotal).toLocaleString('en-IN') + (mcTotalCapped ? '+' : '') + ' results selected' + (excluded.size ? ' (' + excluded.size + ' removed)' : ''))
        : (picks.length + (picks.length === 1 ? ' selected' : ' selected'));
    }
    // The offer to widen the selection only appears when there IS more than this page, and it says
    // the real number rather than implying one.
    if (all && allText) {
      var more = mcTotal != null && mcTotal > picks.length && picks.length > 0 && !allResults;
      all.hidden = !(more || allResults);
      allText.textContent = allResults
        ? 'Operations will apply to every conversation matching this search, on the server.'
        : (mcTotal != null ? (mcTotal.toLocaleString('en-IN') + (mcTotalCapped ? '+' : '') + ' conversations match this search.') : '');
    }
    $$('.mc-row').forEach(function(r){
      var c = r.querySelector('.mc-pick');
      r.classList.toggle('picked', !!(c && c.checked));
    });
  }
  $$('.mc-pick').forEach(function(c){
    c.addEventListener('change', function(){
      if (allResults) {
        // Un-ticking a row while "all results" is chosen is an EXCLUSION, posted with the query.
        var id = c.getAttribute('data-thread');
        if (c.checked) excluded.delete(id); else excluded.add(id);
      }
      refreshSelection();
    });
  });
  var selectPage = document.getElementById('mcSelectPage');
  if (selectPage) selectPage.addEventListener('change', function(){
    allResults = false; excluded.clear();
    $$('.mc-pick').forEach(function(c){ c.checked = selectPage.checked; });
    refreshSelection();
  });
  var selectAllBtn = document.getElementById('mcSelectAllResults');
  if (selectAllBtn) selectAllBtn.addEventListener('click', function(){
    allResults = true; excluded.clear();
    $$('.mc-pick').forEach(function(c){ c.checked = true; });
    refreshSelection();
  });
  var clearBtn = document.getElementById('mcClearSelection');
  if (clearBtn) clearBtn.addEventListener('click', function(){
    allResults = false; excluded.clear();
    if (selectPage) selectPage.checked = false;
    $$('.mc-pick').forEach(function(c){ c.checked = false; });
    refreshSelection();
  });

  // ---- The bulk request -------------------------------------------------------------------------
  function selectionPayload(){
    if (allResults) {
      return { mode: 'query', query: mcScope.q || '', scope: { folder: mcScope.folder, label: mcScope.label, starred: mcScope.starred }, exclude: Array.from(excluded) };
    }
    return { mode: 'ids', threadIds: Array.from(selected) };
  }
  async function runBulk(op, extra){
    var status = document.getElementById('mcBulkStatus');
    var sel = selectionPayload();
    if (sel.mode === 'ids' && !sel.threadIds.length) { setStatus(status, 'Nothing is selected.', 'bad'); return; }
    var body = Object.assign({ op: op, selection: sel }, extra || {});

    // A destructive operation over a selection the person cannot see is CONFIRMED FIRST, with the
    // count the server itself will act on — not a number this page guessed.
    if (allResults && (op === 'trash' || op === 'spam' || op === 'delete' || op === 'archive')) {
      var pre = await post('/api/mail/bulk', Object.assign({ preview: true }, body));
      if (!pre || pre.ok !== true) { setStatus(status, 'That selection could not be counted, so nothing was done: ' + ((pre && pre.error) || 'no answer from the server'), 'bad'); return; }
      if (!window.confirm(pre.message + '\n\nApply "' + op + '" to all of them?')) { setStatus(status, 'Cancelled. Nothing was changed.'); return; }
    }

    $$('.mc-bulk-btn').forEach(function(b){ b.disabled = true; });
    setStatus(status, 'Working...');
    var res = await post('/api/mail/bulk', body);
    $$('.mc-bulk-btn').forEach(function(b){ b.disabled = false; });
    if (!res || res.ok !== true) {
      setStatus(status, (res && res.message) || 'That did not go through, and your mail is unchanged.', 'bad');
      return;
    }
    setStatus(status, res.message, 'good');
    // Reloaded only after the server confirmed, and only then — the list on screen is now stale.
    setTimeout(function(){ location.reload(); }, 700);
  }
  $$('.mc-bulk-btn[data-op]').forEach(function(btn){
    btn.addEventListener('click', function(){ runBulk(btn.getAttribute('data-op')); });
  });

  // ---- Menus (snooze, label) --------------------------------------------------------------------
  var openMenu = null;
  function closeMenu(){ if (openMenu) { openMenu.remove(); openMenu = null; } }
  document.addEventListener('click', function(e){
    if (openMenu && !openMenu.contains(e.target)) closeMenu();
  });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeMenu(); });

  function showMenu(anchor, build){
    closeMenu();
    var menu = document.createElement('div');
    menu.className = 'mc-menu';
    build(menu);
    document.body.appendChild(menu);
    var r = anchor.getBoundingClientRect();
    menu.style.top = Math.min(r.bottom + 6, window.innerHeight - menu.offsetHeight - 10) + 'px';
    menu.style.left = Math.min(r.left, window.innerWidth - menu.offsetWidth - 10) + 'px';
    openMenu = menu;
    var first = menu.querySelector('button, input');
    if (first) first.focus();
  }

  function snoozeMenuFor(anchor, threadIds){
    showMenu(anchor, function(menu){
      var head = document.createElement('p'); head.className = 'mc-menu-head'; head.textContent = 'Snooze until'; menu.appendChild(head);
      mcSnooze.forEach(function(p){
        var b = document.createElement('button'); b.type = 'button';
        b.innerHTML = '<span></span><span class="mc-menu-when"></span>';
        b.firstChild.textContent = p.label;
        b.lastChild.textContent = p.when || '';
        b.addEventListener('click', async function(){
          if (p.key === 'custom') { customSnooze(menu, threadIds); return; }
          closeMenu();
          await doSnooze(threadIds, { preset: p.key });
        });
        menu.appendChild(b);
      });
    });
  }
  function customSnooze(menu, threadIds){
    menu.innerHTML = '';
    var head = document.createElement('p'); head.className = 'mc-menu-head'; head.textContent = 'Pick a date and time'; menu.appendChild(head);
    var input = document.createElement('input'); input.type = 'datetime-local'; menu.appendChild(input);
    var go = document.createElement('button'); go.type = 'button'; go.textContent = 'Snooze'; menu.appendChild(go);
    input.focus();
    go.addEventListener('click', async function(){
      if (!input.value) return;
      var dt = new Date(input.value);
      if (isNaN(dt.getTime())) return;
      closeMenu();
      await doSnooze(threadIds, { until: dt.toISOString() });
    });
  }
  async function doSnooze(threadIds, when){
    var res = await post('/api/mail/snooze', Object.assign({ threadIds: threadIds }, when));
    if (!res || res.ok !== true) {
      showAlert('That conversation was not snoozed, and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '.');
      return;
    }
    showAlert(res.message);
    setTimeout(function(){ location.reload(); }, 800);
  }
  var bulkSnooze = document.getElementById('mcBulkSnooze');
  if (bulkSnooze) bulkSnooze.addEventListener('click', function(e){
    e.stopPropagation();
    // Snooze over "all results" would need a query-mode bulk call; the menu here is for the ticked
    // rows, and it says so rather than pretending to cover a selection it did not send.
    var ids = Array.from(selected);
    if (!ids.length) { setStatus(document.getElementById('mcBulkStatus'), 'Tick the conversations to snooze first.', 'bad'); return; }
    snoozeMenuFor(bulkSnooze, ids);
  });

  var bulkLabel = document.getElementById('mcBulkLabel');
  if (bulkLabel) bulkLabel.addEventListener('click', function(e){
    e.stopPropagation();
    showMenu(bulkLabel, function(menu){
      var head = document.createElement('p'); head.className = 'mc-menu-head'; head.textContent = 'Apply a label'; menu.appendChild(head);
      (mcLabels || []).forEach(function(l){
        var b = document.createElement('button'); b.type = 'button'; b.textContent = l;
        b.addEventListener('click', function(){ closeMenu(); runBulk('label-add', { label: l }); });
        menu.appendChild(b);
      });
      var input = document.createElement('input'); input.type = 'text'; input.placeholder = 'New label'; menu.appendChild(input);
      input.addEventListener('keydown', function(ev){
        if (ev.key === 'Enter' && input.value.trim()) { closeMenu(); runBulk('label-add', { label: input.value.trim() }); }
      });
    });
  });

  // ---- Incremental loading ----------------------------------------------------------------------
  //
  // Appends the next page from the keyset cursor. No OFFSET anywhere: page two hundred costs what
  // page one costs, which is the whole reason a 100,000-message mailbox stays usable.
  var moreBtn = document.getElementById('mcMore');
  if (moreBtn) moreBtn.addEventListener('click', async function(){
    moreBtn.disabled = true;
    var prev = moreBtn.textContent;
    moreBtn.textContent = 'Loading...';
    var params = new URLSearchParams({ q: mcScope.q || '', folder: mcScope.folder || 'inbox', cursor: moreBtn.getAttribute('data-cursor') || '', limit: '50' });
    if (mcScope.label) params.set('label', mcScope.label);
    if (mcScope.starred) params.set('starred', '1');
    var res;
    try {
      var r = await fetch('/api/mail/search?' + params.toString(), { credentials: 'same-origin' });
      res = await r.json();
    } catch (err) {
      res = { ok: false, error: (err && err.message) || 'the request never reached the server' };
    }
    if (!res || res.ok !== true) {
      moreBtn.disabled = false;
      moreBtn.textContent = prev;
      showAlert('More mail could not be loaded, and nothing on this list has changed: ' + ((res && res.error) || 'the server did not answer') + '.');
      return;
    }
    var rows = document.getElementById('mcRows');
    res.hits.forEach(function(h){ rows.appendChild(buildRow(h)); });
    if (res.nextCursor) {
      moreBtn.setAttribute('data-cursor', res.nextCursor);
      moreBtn.disabled = false;
      moreBtn.textContent = prev;
    } else {
      moreBtn.remove();
      var end = document.getElementById('mcListEnd');
      if (end) { end.textContent = 'That is the end of this folder.'; end.hidden = false; }
    }
  });

  function esc(s){ var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function shortTime(iso){
    var diff = Date.now() - new Date(iso).getTime();
    var m = Math.floor(diff / 60000);
    if (m < 1) return 'now';
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    return new Date(iso).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short' });
  }
  function buildRow(h){
    var el = document.createElement('div');
    el.className = 'mc-row' + (h.isRead ? '' : ' unread');
    var href = basePath + '?folder=' + encodeURIComponent(mcScope.folder || 'inbox') + '&thread=' + encodeURIComponent(h.threadId);
    el.setAttribute('data-thread', h.threadId);
    el.setAttribute('data-href', href);
    el.setAttribute('tabindex', '0');
    el.setAttribute('role', 'link');
    var initial = ((h.fromName || h.fromEmail || '?').trim().charAt(0) || '?').toUpperCase();
    el.innerHTML =
      '<input type="checkbox" class="mc-pick" data-thread="' + esc(h.threadId) + '" aria-label="Select conversation" />' +
      '<button type="button" class="mc-star ' + (h.isStarred ? 'on' : '') + '" data-thread="' + esc(h.threadId) + '" data-action="' + (h.isStarred ? 'unstar' : 'star') + '" aria-label="Star">' +
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="' + (h.isStarred ? 'currentColor' : 'none') + '" stroke="currentColor" stroke-width="1.7"><path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>' +
      '</button>' +
      '<div class="mc-avatar" aria-hidden="true">' + esc(initial) + '</div>' +
      '<a class="mc-row-main" href="' + esc(href) + '">' +
        '<div class="mc-row-top"><span class="mc-from">' + esc(h.participants || h.fromName || h.fromEmail) + '</span><span class="mc-time">' + esc(shortTime(h.createdAt)) + '</span></div>' +
        '<p class="mc-subj">' + esc(h.subject || '(no subject)') + (h.threadCount > 1 ? '<span class="mc-count">' + h.threadCount + '</span>' : '') + '</p>' +
        '<p class="mc-snip">' + esc(h.snippet) + '</p>' +
      '</a>' +
      '<div class="mc-row-icons"></div>';
    el.addEventListener('click', function(e){
      if (e.target.closest('.mc-pick') || e.target.closest('.mc-star') || e.target.closest('a')) return;
      location.href = href;
    });
    var pick = el.querySelector('.mc-pick');
    pick.addEventListener('change', function(){
      if (allResults) { if (pick.checked) excluded.delete(h.threadId); else excluded.add(h.threadId); }
      refreshSelection();
    });
    if (allResults) pick.checked = !excluded.has(h.threadId);
    bindStar(el.querySelector('.mc-star'));
    return el;
  }

  // The star handler, extracted so a row appended by "load more" behaves like one rendered on the
  // server. Before this existed, every control on an appended row was inert.
  function bindStar(btn){
    if (!btn || btn.getAttribute('data-bound')) return;
    btn.setAttribute('data-bound', '1');
    btn.addEventListener('click', async function(e){
      e.preventDefault(); e.stopPropagation();
      var thread = btn.getAttribute('data-thread'); var action = btn.getAttribute('data-action');
      btn.disabled = true;
      var res = await post('/api/mail/action', { action: action, threadId: thread });
      if (!res || res.ok !== true) {
        btn.disabled = false;
        showAlert('This conversation was not ' + (action === 'star' ? 'starred' : 'unstarred') + ', and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '.');
        return;
      }
      // Redrawn in place rather than reloading the page, so the scroll position and the selection
      // survive what is a one-bit change.
      var on = action === 'star';
      btn.classList.toggle('on', on);
      btn.setAttribute('data-action', on ? 'unstar' : 'star');
      var svg = btn.querySelector('svg');
      if (svg) svg.setAttribute('fill', on ? 'currentColor' : 'none');
      btn.disabled = false;
    });
  }
  $$('.mc-star').forEach(bindStar);

  // ---- Conversation: collapse, expand, quoted text -----------------------------------------------
  $$('.mc-msg-head').forEach(function(head){
    head.addEventListener('click', function(){
      var msg = head.closest('.mc-msg');
      var open = msg.classList.toggle('open');
      msg.classList.toggle('shut', !open);
      head.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  function setAll(open){
    $$('.mc-msg').forEach(function(msg){
      msg.classList.toggle('open', open);
      msg.classList.toggle('shut', !open);
      var h = msg.querySelector('.mc-msg-head');
      if (h) h.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
  var expandAll = document.getElementById('mcExpandAll');
  if (expandAll) expandAll.addEventListener('click', function(){ setAll(true); });
  var collapseAll = document.getElementById('mcCollapseAll');
  if (collapseAll) collapseAll.addEventListener('click', function(){ setAll(false); });

  $$('.mc-quoted-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var pre = btn.parentElement.querySelector('.mc-quoted-text');
      var show = pre.hidden;
      pre.hidden = !show;
      btn.setAttribute('aria-expanded', show ? 'true' : 'false');
      btn.textContent = show ? 'Hide quoted text' : ('Show quoted text (' + pre.textContent.split('\n').length + ' lines)');
    });
  });

  // ---- Contact context ---------------------------------------------------------------------------
  //
  // Fetched AFTER the conversation is on screen. If it fails the card simply does not appear; the
  // messages are never held up by it and never removed by it.
  var contactBox = document.getElementById('mcContact');
  if (contactBox && contactBox.getAttribute('data-email')) {
    (async function(){
      try {
        var r = await fetch('/api/mail/contact-context?email=' + encodeURIComponent(contactBox.getAttribute('data-email')), { credentials: 'same-origin' });
        var res = await r.json();
        if (!res || res.ok !== true || !res.context) return;
        var c = res.context;
        var html = '<strong>' + esc(c.name) + '</strong>';
        if (c.isInternal) html += ' <span class="mc-chip">colleague</span>';
        if (res.line) html += '<br/>' + esc(res.line);
        if (c.tags && c.tags.length) html += '<br/>' + c.tags.map(function(t){ return '<span class="mc-chip">' + esc(t) + '</span>'; }).join('');
        if (c.lists && c.lists.length) html += '<br/>Lists: ' + esc(c.lists.join(', '));
        if (c.campaigns && c.campaigns.length) html += '<br/>Campaigns: ' + esc(c.campaigns.join(', '));
        if (c.recent && c.recent.length > 1) {
          html += '<br/>Recent: ' + c.recent.slice(0, 3).map(function(x){
            return '<a href="' + esc(basePath + '?folder=' + (mcScope.folder || 'inbox') + '&thread=' + x.threadId) + '">' + esc(x.subject) + '</a>';
          }).join(' · ');
        }
        // What this viewer was NOT shown, and why. A panel that silently omits half of itself
        // teaches people the data does not exist.
        if (c.withheld && c.withheld.length) html += '<p class="mc-withheld">' + esc(c.withheld.join(' ')) + '</p>';
        contactBox.innerHTML = html;
        contactBox.hidden = false;
      } catch (err) {
        console.error('[MailClient] contact context not loaded:', (err && err.message) || err);
      }
    })();
  }

  // ---- Keyboard ----------------------------------------------------------------------------------
  //
  // j/k move, Enter opens, r replies, f forwards, e archives, u marks unread, s stars, x ticks the
  // box, ? shows the list. Shortcuts NEVER fire while somebody is typing — the guard below is what
  // stops "e" in the middle of a sentence archiving the conversation behind the composer.
  var cursorIndex = -1;
  function rows(){ return $$('.mc-row'); }
  function moveCursor(delta){
    var all = rows();
    if (!all.length) return;
    cursorIndex = Math.max(0, Math.min(all.length - 1, cursorIndex + delta));
    all.forEach(function(r, i){ r.classList.toggle('cursor', i === cursorIndex); });
    var el = all[cursorIndex];
    el.scrollIntoView({ block: 'nearest' });
    el.focus({ preventScroll: true });
  }
  function currentThread(){
    var all = rows();
    if (cursorIndex >= 0 && all[cursorIndex]) return all[cursorIndex].getAttribute('data-thread');
    return mcScope.threadId || null;
  }
  function isTyping(el){
    if (!el) return false;
    var tag = (el.tagName || '').toLowerCase();
    return tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable;
  }
  async function actOnCurrent(action, done){
    var thread = currentThread();
    if (!thread) return;
    var res = await post('/api/mail/action', { action: action, threadId: thread });
    if (!res || res.ok !== true) {
      showAlert('That conversation was not ' + done + ', and nothing was changed: ' + ((res && res.error) || 'the server did not confirm it') + '.');
      return;
    }
    location.reload();
  }
  document.addEventListener('keydown', function(e){
    if (isTyping(e.target) || e.metaKey || e.ctrlKey || e.altKey) return;
    var modalOpen = modal && !modal.hidden;
    if (modalOpen) return;
    switch (e.key) {
      case 'j': e.preventDefault(); moveCursor(1); break;
      case 'k': e.preventDefault(); moveCursor(-1); break;
      case 'Enter': {
        var all = rows();
        if (cursorIndex >= 0 && all[cursorIndex]) { e.preventDefault(); location.href = all[cursorIndex].getAttribute('data-href'); }
        break;
      }
      case 'x': {
        var all2 = rows();
        if (cursorIndex >= 0 && all2[cursorIndex]) {
          e.preventDefault();
          var box = all2[cursorIndex].querySelector('.mc-pick');
          if (box) { box.checked = !box.checked; box.dispatchEvent(new Event('change')); }
        }
        break;
      }
      case 'r': {
        var rb = document.getElementById('mcReplyBtn');
        if (rb) { e.preventDefault(); rb.click(); }
        break;
      }
      case 'f': {
        var fb = document.getElementById('mcForwardBtn');
        if (fb) { e.preventDefault(); fb.click(); }
        break;
      }
      case 'c': {
        var cb = document.getElementById('mcComposeBtn');
        if (cb) { e.preventDefault(); cb.click(); }
        break;
      }
      case 'e': e.preventDefault(); actOnCurrent('archive', 'archived'); break;
      case 'u': e.preventDefault(); actOnCurrent('unread', 'marked unread'); break;
      case 's': e.preventDefault(); actOnCurrent('star', 'starred'); break;
      case '/': {
        var box2 = document.querySelector('.mc-search input');
        if (box2) { e.preventDefault(); box2.focus(); }
        break;
      }
      case '?': {
        e.preventDefault();
        var help = document.getElementById('mcKeys');
        if (help) { help.hidden = !help.hidden; if (!help.hidden) { var c2 = help.querySelector('button'); if (c2) c2.focus(); } }
        break;
      }
      default: break;
    }
  });

  // ---- Search help ---------------------------------------------------------------------------------
  //
  // The operator list comes from the PARSER'S OWN module, so the help cannot describe a grammar the
  // search box does not have.
  var searchInput = document.querySelector('.mc-search input');
  if (searchInput && Array.isArray(mcHelp)) {
    var helpBox = document.createElement('div');
    helpBox.className = 'mc-help';
    helpBox.hidden = true;
    helpBox.innerHTML = mcHelp.map(function(h){
      return '<div class="mc-help-row"><code>' + esc(h.op) + '</code><span>' + esc(h.means) + '</span></div>';
    }).join('');
    searchInput.parentElement.appendChild(helpBox);
    searchInput.addEventListener('focus', function(){ helpBox.hidden = false; });
    searchInput.addEventListener('blur', function(){ setTimeout(function(){ helpBox.hidden = true; }, 180); });
  }

  var keysClose = document.getElementById('mcKeysClose');
  if (keysClose) keysClose.addEventListener('click', function(){ document.getElementById('mcKeys').hidden = true; });
  var keysBox = document.getElementById('mcKeys');
  if (keysBox) keysBox.addEventListener('click', function(e){ if (e.target === keysBox) keysBox.hidden = true; });


  // ---- The snooze button on a conversation --------------------------------------------------------
  var threadSnooze = document.getElementById('mcThreadSnooze');
  if (threadSnooze) threadSnooze.addEventListener('click', function(e){
    e.stopPropagation();
    snoozeMenuFor(threadSnooze, [threadSnooze.getAttribute('data-thread')]);
  });

  // ================================================================================================
  // DRAFT AUTOSAVE.
  //
  // THE THING THIS IS BUILT AROUND: a save must never be able to destroy what it is saving.
  // /api/mail/draft does DELETE-then-INSERT, so a failure between the two loses the message, and the
  // window is widest exactly when somebody has written the most. /api/mail/autosave updates in place
  // and carries the version the edit was made against, so a stale save is REFUSED rather than
  // silently overwriting newer text from another tab.
  //
  // DEBOUNCED, AND QUIET WHEN NOTHING CHANGED. The timer fires on a schedule, not on a change, so
  // the server answers `unchanged: true` for an idle composer and no row and no revision is written.
  //
  // WHAT IT PROMISES ON SCREEN IS WHAT HAPPENED. "Saving..." while in flight, "Saved HH:MM" only
  // after the server confirmed, and the reason in full when it did not. It never says saved on a
  // request that failed.
  // ================================================================================================
  var AUTOSAVE_MS = 2500;
  var draftId = null;
  var draftVersion = 0;
  var draftTimer = null;
  var draftInFlight = false;
  // A per-tab identity, so a conflict can say WHERE the other copy came from. Not used for
  // authorisation anywhere — the server never trusts it.
  var clientId = 'tab-' + Math.random().toString(36).slice(2, 10);

  function draftStatus(msg){ var s = $('mcStatus'); if (s) s.textContent = msg; }
  function draftPayload(){
    return {
      draftId: draftId,
      version: draftVersion || null,
      to: $('mcTo').value, cc: $('mcCc').value, bcc: $('mcBcc').value,
      subject: $('mcSubject').value,
      bodyText: htmlMode ? '' : $('mcBody').value,
      bodyHtml: htmlMode ? $('mcBody').value : '',
      threadId: $('mcThreadId').value || null,
      inReplyTo: $('mcInReplyTo').value || null,
      attachments: attachments,
      clientId: clientId,
    };
  }
  function draftIsEmpty(){
    return !$('mcTo').value.trim() && !$('mcSubject').value.trim() && !$('mcBody').value.trim() && !attachments.length;
  }
  async function autosave(reason){
    if (draftInFlight) return;
    // An empty composer is not a draft. Saving one creates rows nobody wants and a recovery prompt
    // offering to restore a blank message.
    if (draftIsEmpty()) return;
    draftInFlight = true;
    if (reason !== 'quiet') draftStatus('Saving...');
    var res = await post('/api/mail/autosave', draftPayload());
    draftInFlight = false;

    if (res && res.conflict) {
      // NOT MERGED, AND NOT OVERWRITTEN. Both versions are kept and the person decides.
      draftStatus('');
      showAlert(res.message + ' The other version is in your Drafts folder; this window still holds exactly what you typed.');
      return;
    }
    if (!res || res.ok !== true) {
      draftStatus('');
      showAlert((res && res.message) || 'This draft was not saved, and nothing was lost from this window.');
      return;
    }
    draftId = res.draft.draftId;
    draftVersion = res.draft.version;
    if (!res.unchanged) {
      draftStatus('Saved ' + new Date(res.draft.updatedAt).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' }));
    }
  }
  function scheduleAutosave(){
    if (draftTimer) clearTimeout(draftTimer);
    draftTimer = setTimeout(function(){ autosave('typed'); }, AUTOSAVE_MS);
  }
  ['mcTo', 'mcCc', 'mcBcc', 'mcSubject', 'mcBody'].forEach(function(id){
    var el = $(id);
    if (el) el.addEventListener('input', scheduleAutosave);
  });

  // The last chance to save. `keepalive` is what makes this survive the page going away — an
  // ordinary fetch is cancelled when the document unloads, which is precisely the moment the draft
  // most needs to reach the server.
  window.addEventListener('pagehide', function(){
    if (draftIsEmpty() || draftInFlight) return;
    try {
      fetch('/api/mail/autosave', {
        method: 'POST', credentials: 'same-origin', keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(draftPayload()),
      });
    } catch (err) { /* the page is going; there is nowhere left to report this */ }
  });

  // The composer's own Save draft button now goes through the same versioned path, so the two ways
  // of saving cannot produce two different drafts.
  var draftBtn2 = $('mcSaveDraft');
  if (draftBtn2) {
    var clone = draftBtn2.cloneNode(true);
    draftBtn2.parentNode.replaceChild(clone, draftBtn2);
    clone.addEventListener('click', async function(){
      if (draftIsEmpty()) { draftStatus('Nothing to save yet.'); return; }
      await autosave('button');
      if (draftId) setTimeout(closeModal, 600);
    });
  }

  // A sent message is no longer a draft. Told to the server so the Drafts folder does not keep a
  // copy of something already in Sent — which is how the same message gets sent twice.
  var sendBtn2 = $('mcSend');
  if (sendBtn2) sendBtn2.addEventListener('click', function(){
    if (!draftId) return;
    var id = draftId;
    setTimeout(function(){
      post('/api/mail/autosave', { action: 'discard', draftId: id }).catch(function(){});
    }, 1500);
  });

  // ---- Recovery after a crash ---------------------------------------------------------------------
  //
  // The draft is on the SERVER after the last autosave, so this works on a different machine, after
  // a cleared profile, and in a window that was never opened before. Nothing here depends on
  // localStorage, which survives none of those.
  (async function(){
    if (mcScope.threadId) return; // reading a conversation, not composing
    var res = await post('/api/mail/autosave', { action: 'list' });
    if (!res || res.ok !== true || !res.drafts || !res.drafts.length) return;
    var d = res.drafts[0];
    var bar = document.createElement('div');
    bar.className = 'mc-recover';
    bar.innerHTML = '<span></span>';
    bar.firstChild.textContent = 'You have an unsent draft: "' + (d.subject || '(no subject)') + '", last saved '
      + new Date(d.updatedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + '.';
    var open = document.createElement('button');
    open.type = 'button'; open.textContent = 'Open it';
    open.addEventListener('click', function(){
      clearForm();
      draftId = d.draftId; draftVersion = d.version;
      $('mcTo').value = d.to; $('mcCc').value = d.cc; $('mcBcc').value = d.bcc;
      $('mcSubject').value = d.subject; $('mcBody').value = d.bodyText || d.bodyHtml;
      $('mcThreadId').value = d.threadId || '';
      attachments = d.attachments || [];
      renderAtts();
      openModal('Unsent draft');
      bar.remove();
    });
    var dismiss = document.createElement('button');
    dismiss.type = 'button'; dismiss.textContent = 'Not now';
    dismiss.addEventListener('click', function(){ bar.remove(); });
    bar.appendChild(open); bar.appendChild(dismiss);
    var list = document.getElementById('mcList');
    if (list) list.insertBefore(bar, list.firstChild);
  })();
  refreshSelection();
})();
</script>
