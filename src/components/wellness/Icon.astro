---
/**
 * Wellness icon system.
 *
 * <Icon name="moon" /> renders a 24x24 inline SVG on a shared geometric grid:
 *   - viewBox 0 0 24 24, optical content kept inside 2..22
 *   - 2px stroke, round caps and joins, currentColor only (no hex in this file)
 *   - solid dots are fill="currentColor" stroke="none" at r=1 so they match the
 *     2px stroke weight instead of reading as tiny rings
 *
 * Colour: the component defines NO colours. Every stroke and fill is
 * currentColor, so an icon inherits the contrast of the text it sits beside and
 * introduces zero new text/background pairs. Callers must give an icon a colour
 * with at least 3:1 against its surface (WCAG 1.4.11 non-text contrast) whenever
 * the icon carries meaning on its own; an icon that only decorates a visible
 * text label is exempt and should be rendered without a title (aria-hidden).
 *
 * Motion: rationed on purpose. Only four icons can animate (flower, the moon
 * phase family, ripple, sparkle) and only when the caller passes animate. Every
 * other icon in this file is static because static is the correct answer for
 * symptom logging, red-flag copy and anything a worried person reads at 2am.
 * All motion is one-shot (never a loop, so it can never become ambient), runs on
 * transform and opacity only, and is removed under prefers-reduced-motion -- the
 * still composition is the designed default, not a fallback.
 *
 * Contract for animate: pass it only at the moment the milestone actually
 * happens, on a surface the person is looking at. CSS animations start at page
 * load, so an animated icon far below the fold will finish unseen. That is the
 * honest cost of shipping no JavaScript; view-timeline triggers were rejected
 * because they re-fire on every scroll pass, which turns a milestone into noise.
 *
 * Names (97):
 *   cycle ovulation egg moon moon-new moon-waxing moon-half moon-full
 *   moon-waning sun sunrise drop ripple flow-light flow-medium flow-heavy
 *   flower leaf seedling heart pulse brain calendar calendar-check clock plate
 *   utensils water-glass mug capsule thermometer scale stethoscope baby
 *   pregnancy activity-ring breathing-circle wind stretch steps flame snowflake
 *   cloud mood-good mood-neutral mood-low chat chat-heart support shield
 *   shield-check lock eye eye-off fingerprint chart chart-line notes clipboard
 *   clipboard-check bookmark user users phone video search filter settings
 *   export download trash edit info question warning bell bell-off star sparkle
 *   plus minus check close chevron-left chevron-right chevron-up chevron-down
 *   arrow-left arrow-right home menu more grid list link play pause
 */

export interface Props {
  name: string;
  size?: number | string;
  stroke?: number;
  class?: string;
  title?: string;
  animate?: boolean;
}

