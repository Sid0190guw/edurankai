/* Only these four earn motion. Anything else ignores the animate prop. */
const ANIMATED = {
  flower: 'bloom',
  moon: 'phase',
  'moon-waxing': 'phase',
  'moon-half': 'phase',
  'moon-waning': 'phase',
  ripple: 'ripple',
  sparkle: 'shimmer',
} as const;

type IconName = keyof typeof ICONS;
type AnimName = keyof typeof ANIMATED;

const body = ICONS[name as IconName] ?? ICONS.info;
const anim = animate ? (ANIMATED[name as AnimName] ?? null) : null;
const px = typeof size === 'number' ? String(size) : size;
const uid = 'wlic-' + Math.random().toString(36).slice(2, 9);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`wl-ic ${cls}`.trim()}
  data-anim={anim}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-labelledby={title ? uid : undefined}
  focusable="false"
>
  {title ? <title id={uid}>{title}</title> : null}
  <Fragment set:html={body} />
</svg>

<style is:global>
  .wl-ic {
    display: inline-block;
    vertical-align: middle;
    flex: none;
  }

  /* Animatable parts. Origin is the icon centre in viewBox units, so the same
     rule works at any rendered size. No will-change: a one-shot 600-900ms
     compositor animation does not need a promoted layer, and spare layers are
     exactly what hurts on an old phone. */
  .wl-ic__m {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }

  /* Tier A curves come from the platform motion tokens when the wellness
     stylesheet is loaded, each with a self-contained fallback so this component
     still behaves correctly on its own. Exactly one source of overshoot per
     animation: the bloom curve bounces, the settle curve does not, and no
     keyframe stacks a second bounce on top of a bouncing curve.
     Phase, ripple and shimmer keep literal durations because no token carries
     their meaning; all three sit inside the Tier A 400-1200ms band. */
  .wl-ic[data-anim] .wl-ic__m {
    animation-timing-function: var(--w-a-ease-draw, cubic-bezier(0.16, 1, 0.3, 1));
    animation-fill-mode: both;
    animation-iteration-count: 1;
  }

  /* -- bloom: a completed log, a milestone. The overshoot lives in the curve,
        so the keyframes stay linear in intent. 700ms + 200ms stagger. ------- */
  @keyframes wl-ic-bloom {
    from { transform: scale(0.35); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  @keyframes wl-ic-core {
    from { transform: scale(0.2); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  .wl-ic[data-anim="bloom"] .wl-ic__m {
    animation-timing-function: var(--w-a-ease-bloom, cubic-bezier(0.34, 1.28, 0.64, 1));
  }
  .wl-ic[data-anim="bloom"] .wl-ic__core { animation-name: wl-ic-core; animation-duration: var(--w-a-dur-entry, 400ms); }
  .wl-ic[data-anim="bloom"] .wl-ic__petal { animation-name: wl-ic-bloom; animation-duration: var(--w-a-dur-bloom, 700ms); }
  .wl-ic[data-anim="bloom"] circle.wl-ic__petal:nth-of-type(2) { animation-delay: 60ms; }
  .wl-ic[data-anim="bloom"] circle.wl-ic__petal:nth-of-type(3) { animation-delay: 95ms; }
  .wl-ic[data-anim="bloom"] circle.wl-ic__petal:nth-of-type(4) { animation-delay: 130ms; }
  .wl-ic[data-anim="bloom"] circle.wl-ic__petal:nth-of-type(5) { animation-delay: 165ms; }
  .wl-ic[data-anim="bloom"] circle.wl-ic__petal:nth-of-type(6) { animation-delay: 200ms; }

  /* -- phase: the terminator sweeps across the disc and settles. The pass
        through scaleX(0) is a real new moon, not a trick. 900ms. ----------- */
  @keyframes wl-ic-phase {
    from { transform: scaleX(-1); opacity: 0.45; }
    45%  { transform: scaleX(-0.08); opacity: 0.55; }
    to   { transform: scaleX(1); opacity: 1; }
  }
  .wl-ic[data-anim="phase"] .wl-ic__phase { animation-name: wl-ic-phase; animation-duration: 900ms; }

  /* -- ripple: rings leave the centre, inner first. 700ms + 180ms stagger. - */
  @keyframes wl-ic-ripple {
    from { transform: scale(0.2); opacity: 0; }
    30%  { opacity: 1; }
    to   { transform: scale(1); opacity: 1; }
  }
  .wl-ic[data-anim="ripple"] .wl-ic__ring { animation-name: wl-ic-ripple; animation-duration: 700ms; }
  .wl-ic[data-anim="ripple"] circle.wl-ic__ring:nth-of-type(2) { animation-delay: 90ms; }
  .wl-ic[data-anim="ripple"] circle.wl-ic__ring:nth-of-type(3) { animation-delay: 180ms; }

  /* -- shimmer: each star turns up on its own centre. 560ms + 200ms. ------- */
  @keyframes wl-ic-shimmer {
    from { transform: scale(0.4) rotate(-25deg); opacity: 0; }
    55%  { transform: scale(1.1) rotate(4deg); opacity: 1; }
    to   { transform: scale(1) rotate(0deg); opacity: 1; }
  }
  .wl-ic[data-anim="shimmer"] .wl-ic__spark { animation-name: wl-ic-shimmer; animation-duration: 560ms; }
  .wl-ic[data-anim="shimmer"] .wl-ic__spark--a { transform-origin: 10.4px 10.7px; }
  .wl-ic[data-anim="shimmer"] .wl-ic__spark--b { transform-origin: 19px 4.88px; animation-delay: 110ms; }
  .wl-ic[data-anim="shimmer"] .wl-ic__spark--c { transform-origin: 18.6px 17.78px; animation-delay: 200ms; }

  /* Reduced motion is a first-class variant, not a degradation. Every animated
     icon was drawn so that its resting state is the finished composition: the
     flower is whole, the moon holds one phase, the rings are concentric, the
     stars sit in their constellation. Removing the motion removes nothing. */
  @media (prefers-reduced-motion: reduce) {
    .wl-ic[data-anim] .wl-ic__m {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
