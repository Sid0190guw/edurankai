---
/**
 * Wellness / Reveal
 *
 * Progressive disclosure on native <details>. A short summary is always
 * visible; the depth waits inside. Zero JavaScript, so it works before
 * hydration, with JS disabled, inside a printed page, and on a phone that
 * is struggling. This is the pattern the whole product leans on: the full
 * detail is always there, and it is never forced on anyone.
 *
 * Design decision — the panel does not slide open. Animating a height is
 * banned by Ruling 2 (it is layout, and it janks on cheap hardware), and
 * the JS-free height tricks all cost more than the effect is worth. So the
 * content simply exists the moment it is asked for, with a 180ms Tier B
 * fade and a 4px rise to soften the arrival, and the chevron turns. The
 * summary row never moves, which means the thing the reader was looking at
 * stays exactly where their eye already is.
 */
import './tokens.css';

export interface Props {
  /** The always-visible line. Can also be passed as a `summary` slot. */
  summary?: string;
  /** Small right-aligned context: a count, a date, a status word. */
  meta?: string;
  module?:
    | 'cycle' | 'pregnancy' | 'mental' | 'nutrition'
    | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'neutral';
  /** Start expanded. */
  open?: boolean;
  /** Drop the border and background when nested inside a Card. */
  flush?: boolean;
  class?: string;
}

const {
  summary = '',
  meta,
  module,
  open = false,
  flush = false,
  class: cls = '',
  ...rest
} = Astro.props;
---

<details
  class:list={['w-reveal', flush && 'w-reveal--flush', cls]}
  data-w-module={module}
  open={open}
  {...rest}
>
  <summary class="w-reveal__summary w-focusable">
    <span class="w-reveal__title">
      <slot name="summary">{summary}</slot>
    </span>

    {meta && <span class="w-reveal__meta">{meta}</span>}

    <svg
      class="w-reveal__chev"
      viewBox="0 0 16 16"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 6.25 8 10.25l4-4" />
    </svg>
  </summary>

  <div class="w-reveal__body">
    <slot />
  </div>
</details>

<style>
  .w-reveal {
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    background-color: var(--w-surface);
    border: 1px solid var(--w-hairline);
    border-radius: var(--w-r-md);
    font-family: var(--w-font-body);
    color: var(--w-ink);
  }

  .w-reveal--flush {
    background-color: transparent;
    border: 0;
    border-radius: 0;
  }

  .w-reveal__summary {
    display: flex;
    align-items: center;
    gap: var(--w-s-3);
    /* 44px of comfortable target on a phone, without looking chunky. */
    min-height: 44px;
    padding: var(--w-s-3) var(--w-s-4);
    cursor: pointer;
    list-style: none;
    color: var(--w-ink);
  }
  .w-reveal--flush .w-reveal__summary {
    padding-inline: 0;
  }

  /* Remove the browser's own disclosure marker in every engine. */
  .w-reveal__summary::-webkit-details-marker { display: none; }
  .w-reveal__summary::marker { content: ''; }

  .w-reveal__title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--w-t-body);
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .w-reveal__meta {
    flex: 0 0 auto;
    font-size: var(--w-t-meta);
    font-weight: 500;
    line-height: 1.3;
    color: var(--w-ink-3);
  }

  .w-reveal__chev {
    flex: 0 0 auto;
    color: var(--w-accent);
  }

  .w-reveal__body {
    padding: 0 var(--w-s-4) var(--w-s-4);
    font-size: var(--w-t-body);
    line-height: 1.6;
    color: var(--w-ink-2);
  }
  .w-reveal--flush .w-reveal__body {
    padding-inline: 0;
  }

  /* A hairline appears only once there is something to separate. */
  .w-reveal[open] .w-reveal__body {
    margin-top: var(--w-s-1);
    padding-top: var(--w-s-3);
    border-top: 1px solid var(--w-hairline);
  }

  .w-reveal__summary:focus-visible {
    outline: 2px solid var(--w-focus);
    outline-offset: -2px;
    border-radius: var(--w-r-md);
  }

  /* --- Tier B. Both moves are transform/opacity only. --- */
  @media (prefers-reduced-motion: no-preference) {
    .w-reveal__chev {
      transition: transform var(--w-dur-quiet) var(--w-ease-quiet);
    }
    .w-reveal[open] .w-reveal__body {
      animation: w-reveal-in var(--w-dur-quiet) var(--w-ease-quiet) both;
    }
  }

  /* The chevron flips in both variants — under reduced motion it simply
     arrives already turned, so the open/closed state is never ambiguous. */
  .w-reveal[open] .w-reveal__chev {
    transform: rotate(180deg);
  }

  @keyframes w-reveal-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
