  const defs = plateDefs(uu) + clipDef(uu)
    + lgU(`${uu}-fl`, 0, 178, 0, 240, st(0, 'tint', 0.8) + st(1, 'tint', 0.34))
    + lgU(`${uu}-ar`, 0, 84, 0, 178, st(0, 'glow', 0.95) + st(0.6, 'glow', 0.7) + st(1, 'lum', 0.42))
