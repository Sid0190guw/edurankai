---
/**
 * Illustration.astro — the illustration language for the wellness module.
 *
 *   <Illustration name="cycle" />
 *   <Illustration name="sleep" size={200} title="A quiet night sky" />
 *   <Illustration name="milestone" motion="reveal" />
 *   <Illustration name="loading" size={96} />
 *
 * WHAT THIS IS
 *   Ten hand-built scenes on one 320x240 stage, drawn from layered SVG shapes and
 *   gradient meshes. No filters, no images, no client JavaScript, no animation library.
 *   Every scene is composed to look finished as a STILL first; motion is layered on top
 *   and is switched off by default.
 *
 * MOTION TIERS (encoded in the API, not just in the comments)
 *   Tier C (default, every scene): nothing moves. `motion` defaults to "none", so an
 *     illustration on a symptom log or a red-flag escalation is still unless someone
 *     deliberately says otherwise. Stillness is the default state of this component.
 *   Tier A (opt-in, milestones only): motion="reveal" plays a ONE-SHOT entrance,
 *     520-620ms, soft spring. It cannot loop and it cannot be retriggered by scroll or
 *     hover, so it can never become ambient noise.
 *   The `loading` scene is the single exception that loops, because it exists to replace
 *     a spinner: a 1200ms bloom that should be unmounted the moment content arrives.
 *   Only `transform` and `opacity` are ever animated. No width/height/top/left/box-shadow/
 *     filter, and no hover motion (this is a phone-first surface).
 *
 * REDUCED MOTION
 *   Every animation rule lives inside `@media (prefers-reduced-motion: no-preference)`,
 *   and the base CSS is the finished state. So the reduced-motion build is not a
 *   degraded version, it is the composition itself: `loading` becomes a set of composed
 *   concentric rings around a lit core, `reveal` scenes simply arrive already assembled.
 *
 * TOKEN CONTRACT (consumed from src/styles/wellness.css, all with fallbacks)
 *   Per module, where <m> is one of
 *     cycle | pregnancy | mental-wellness | nutrition | sleep | hydration | fitness |
 *     therapy | neutral
 *       --w-<m>-surface   plate base
 *       --w-<m>-tint      secondary surface
 *       --w-<m>-accent    signature colour
 *       --w-<m>-ink       silhouette / primary form  (must FLIP with colour scheme)
 *   Shared, optional:
 *       --w-ill-lum       ambient light wash        (light in both schemes)
 *       --w-ill-glow      emissive light            (light in both schemes)
 *       --w-ill-ink       always-dark field, used by the night scenes
 *       --w-ill-wash      strength of the plate light wash (number)
 *       --w-ill-wash-soft mid stop of that wash            (number)
 *   If wellness.css is not loaded the fallbacks below render the identical composition,
 *   so this component never fails open to black.
 *
 * MEASURED CONTRAST (sRGB, WCAG 2.x formula, computed not estimated)
 *   This component defines no text/background pair: it renders no text at all, and the
 *   optional <title> is an accessible name, never a painted string. Captions live outside
 *   the SVG on the module's ink token. What is measured here is WCAG 1.4.11 non-text
 *   contrast (3:1) for the marks that carry meaning, against the surface behind them.
 *
 *   LIGHT SCHEME                   form:stage   accent:stage   accent:tint
 *     neutral                        12.99          4.74          3.95
 *     cycle                          12.95          4.98          3.89
 *     pregnancy                      12.31          4.23          3.51
 *     mental-wellness                12.59          4.35          3.65
 *     nutrition                      12.29          4.63          3.92
 *     sleep                          14.31          6.63          5.07
 *     hydration                      13.23          4.88          4.00
 *     fitness                        13.54          4.66          3.70
 *     therapy                        13.24          4.62          3.80
 *
 *   DARK SCHEME                    form:stage   accent:stage   accent:tint
 *     neutral                        14.36          7.14          5.79
 *     cycle                          14.65          7.43          6.11
 *     pregnancy                      14.89          8.76          7.08
 *     mental-wellness                15.18          7.97          6.43
 *     nutrition                      15.16          8.29          6.81
 *     sleep                          15.42          7.42          6.40
 *     hydration                      15.18          8.33          6.98
 *     fitness                        14.92          7.35          6.32
 *     therapy                        15.10          7.94          6.71
 *
 *   Night field (the sleep scene paints on --i-ink in both schemes):
 *     glow on light-scheme ink 13.78   glow on dark-scheme ink 17.55
 *
 *   Lowest value anywhere is 3.51:1, above the 3:1 floor for meaningful graphics.
 *   The silhouette/stage pair never drops below 12.29:1, so a caller who does place a
 *   caption on the plate in the form colour still clears AAA (7:1) with room to spare.
 */

// Kept on ONE line on purpose. Astro hoists exported declarations out of the frontmatter line by
// line, so an `export type X =` whose union continues on the following lines gets separated from
// its own body and the build dies on the orphaned `| '...'`. One line, one declaration.
export type IllustrationName = 'cycle' | 'pregnancy' | 'mental-wellness' | 'nutrition' | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'milestone' | 'empty' | 'loading';

export interface Props {
  /** Which scene to draw. Unknown names fall back to the calm 'empty' composition. */
  name?: IllustrationName | string;
  /** Borrow another module's palette, e.g. an 'empty' scene inside the cycle module. */
  tone?: string;
  /** Convenience for width. Height is derived from the 4:3 stage. */
  size?: number | string;
  width?: number | string;
  height?: number | string;
  /**
   * Accessible name. Omit it and the illustration is decorative (aria-hidden), which is
   * correct almost everywhere: the surrounding copy already carries the meaning.
   */
  title?: string;
  /** 'none' (default, Tier C stillness) or 'reveal' (Tier A one-shot, milestones only). */
  motion?: 'none' | 'reveal';
  class?: string;
}

const {
  name = 'empty',
  tone,
  size,
  width,
  height,
  title,
  motion = 'none',
  class: className = '',
} = Astro.props;

/* ------------------------------------------------------------------ plumbing */

// Gradient ids must be unique per document, or the second illustration on a page
// silently repaints itself with the first one's colours.
const g = globalThis as unknown as { __wIllSeq?: number };
g.__wIllSeq = (g.__wIllSeq || 0) + 1;
const u = 'wi' + g.__wIllSeq.toString(36);

/** Which palette each scene reaches for by default. */
const SCENE_TONES: { [key: string]: string } = {
  cycle: 'cycle',
  pregnancy: 'pregnancy',
  'mental-wellness': 'mental-wellness',
  nutrition: 'nutrition',
  sleep: 'sleep',
  hydration: 'hydration',
  fitness: 'fitness',
  therapy: 'therapy',
  milestone: 'neutral',
  empty: 'neutral',
  loading: 'neutral',
};

const TONES = [
  'cycle', 'pregnancy', 'mental-wellness', 'nutrition',
  'sleep', 'hydration', 'fitness', 'therapy', 'neutral',
];

const scene = Object.prototype.hasOwnProperty.call(SCENE_TONES, String(name)) ? String(name) : 'empty';
const toneKey = tone && TONES.indexOf(tone) >= 0 ? tone : SCENE_TONES[scene];

// Tier A is opt-in and never applies to the loading bloom, which owns its own motion.
const motionAttr = motion === 'reveal' && scene !== 'loading' ? 'reveal' : undefined;

const STAGE_W = 320;
const STAGE_H = 240;

const rawW = width ?? size ?? 320;
const numericW = typeof rawW === 'number'
  ? rawW
  : (/^\d+(?:\.\d+)?$/.test(String(rawW)) ? Number(rawW) : null);

const attrW = numericW !== null ? numericW : undefined;
const attrH = numericW !== null
  ? (typeof height === 'number' ? height : Math.round(numericW * (STAGE_H / STAGE_W)))
  : undefined;
const styleAttr = numericW === null ? `width:${rawW};height:auto` : undefined;

const titleId = `${u}-t`;

/* ------------------------------------------------------- drawing primitives */

/** A gradient stop painted from a role token. `a` may be a number or a var(). */
const st = (offset: number | string, role: string, a: number | string) =>
  `<stop offset="${offset}" style="stop-color:var(--i-${role});stop-opacity:${a}"/>`;

/** Radial gradient in user space (positioned in stage coordinates). */
const rgU = (id: string, cx: number, cy: number, r: number, stops: string) =>
  `<radialGradient id="${id}" cx="${cx}" cy="${cy}" r="${r}" gradientUnits="userSpaceOnUse">${stops}</radialGradient>`;

/** Radial gradient in bounding-box space (follows whatever shape uses it). */
const rgB = (id: string, stops: string, attrs = '') =>
  `<radialGradient id="${id}" ${attrs}>${stops}</radialGradient>`;

/** Linear gradient in user space. */
const lgU = (id: string, x1: number, y1: number, x2: number, y2: number, stops: string) =>
  `<linearGradient id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" gradientUnits="userSpaceOnUse">${stops}</linearGradient>`;

const n = (v: number) => (Math.round(v * 100) / 100).toString();

/** Deterministic pseudo-random, so star fields are identical on every render. */
function seeded(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

/**
 * A ribbon: a cubic chain offset vertically by `thick` and closed. Where the chain
 * runs steeply the band naturally narrows, which is what gives the aurora and the
 * fitness sweeps their taper without any stroke tricks.
 */
function ribbon(x0: number, y0: number, segs: number[][], thick: number, fill: string, extra = '') {
  let d = `M ${n(x0)},${n(y0)}`;
  for (const s of segs) d += ` C ${n(s[0])},${n(s[1])} ${n(s[2])},${n(s[3])} ${n(s[4])},${n(s[5])}`;
  const last = segs[segs.length - 1];
  d += ` L ${n(last[4])},${n(last[5] + thick)}`;
  for (let i = segs.length - 1; i >= 0; i--) {
    const s = segs[i];
    const prevX = i === 0 ? x0 : segs[i - 1][4];
    const prevY = i === 0 ? y0 : segs[i - 1][5];
    d += ` C ${n(s[2])},${n(s[3] + thick)} ${n(s[0])},${n(s[1] + thick)} ${n(prevX)},${n(prevY + thick)}`;
  }
  d += ' Z';
  return `<path d="${d}" fill="${fill}"${extra ? ' ' + extra : ''}/>`;
}

/**
 * A leaf built from two mirrored cubics, with a midrib and three vein pairs.
 * Below ~40 units the veins stop being detail and start being noise (and bytes),
 * so small leaves are drawn as clean silhouettes with a midrib only.
 */
function leaf(x: number, y: number, len: number, wid: number, rot: number, fill: string, op: number) {
  const d = `M 0,0 C ${n(wid)},${n(-len * 0.3)} ${n(wid * 0.5)},${n(-len * 0.84)} 0,${n(-len)}`
    + ` C ${n(-wid * 0.5)},${n(-len * 0.84)} ${n(-wid)},${n(-len * 0.3)} 0,0 Z`;
  let s = `<g transform="translate(${n(x)},${n(y)}) rotate(${n(rot)})" opacity="${op}">`;
  s += `<path d="${d}" fill="${fill}"/>`;
  s += `<path d="M 0,${n(-len * 0.08)} L 0,${n(-len * 0.93)}" fill="none" stroke="var(--i-stage)" stroke-opacity="0.42" stroke-width="${len > 40 ? '1.2' : '0.9'}" stroke-linecap="round"/>`;
  for (let i = 1; len > 40 && i <= 3; i++) {
    const by = -len * (0.16 + i * 0.18);
    const ty = by - len * 0.14;
    const tx = wid * (0.62 - i * 0.12);
    s += `<path d="M 0,${n(by)} Q ${n(tx * 0.55)},${n(by - len * 0.02)} ${n(tx)},${n(ty)}" fill="none" stroke="var(--i-stage)" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"/>`;
    s += `<path d="M 0,${n(by)} Q ${n(-tx * 0.55)},${n(by - len * 0.02)} ${n(-tx)},${n(ty)}" fill="none" stroke="var(--i-stage)" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"/>`;
  }
  s += '</g>';
  return s;
}

/** A teardrop, point up. */
function drop(x: number, y: number, s: number, fill: string, op: number) {
  const d = `M 0,${n(-s)} C ${n(s * 0.74)},${n(-s * 0.24)} ${n(s * 0.62)},${n(s * 0.56)} 0,${n(s * 0.64)}`
    + ` C ${n(-s * 0.62)},${n(s * 0.56)} ${n(-s * 0.74)},${n(-s * 0.24)} 0,${n(-s)} Z`;
  return `<path d="${d}" transform="translate(${n(x)},${n(y)})" fill="${fill}" fill-opacity="${op}"/>`;
}

/**
 * A moon at a given phase. `k` runs -1 (thin crescent) to 1 (nearly full); the inner
 * arc's x-radius is |k| * r and its sweep decides whether the terminator bulges away
 * from the lit limb (gibbous) or into it (crescent). k = 0 degenerates to a clean
 * half disc, which is exactly what a quarter moon should be.
 */
function moonBody(uu: string, r: number, kind: string, k: number) {
  let s = `<circle cx="0" cy="0" r="${n(r)}" fill="var(--i-accent)" fill-opacity="0.13"/>`;
  s += `<circle cx="0" cy="0" r="${n(r)}" fill="none" stroke="var(--i-accent)" stroke-opacity="0.34" stroke-width="1"/>`;
  if (kind === 'full') {
    s += `<circle cx="0" cy="0" r="${n(r)}" fill="url(#${uu}-moon)"/>`;
  } else if (kind === 'phase') {
    const ak = Math.abs(k) * r;
    const sweep = k >= 0 ? 1 : 0;
    s += `<path d="M 0,${n(-r)} A ${n(r)},${n(r)} 0 0 1 0,${n(r)} A ${n(ak)},${n(r)} 0 0 ${sweep} 0,${n(-r)} Z" fill="url(#${uu}-moon)"/>`;
  }
  return s;
}

/* ------------------------------------------------------------- shared stage */

const plateDefs = (uu: string) =>
  lgU(`${uu}-pl`, 0, 0, 0, STAGE_H, st(0, 'stage', 1) + st(0.6, 'stage', 1) + st(1, 'tint', 0.62))
  + rgU(`${uu}-pw`, 208, 40, 212,
      st(0, 'lum', 'var(--i-wash)') + st(0.52, 'lum', 'var(--i-wash-soft)') + st(1, 'lum', 0));

const plateBody = (uu: string) =>
  `<rect x="0" y="0" width="320" height="240" rx="28" ry="28" fill="url(#${uu}-pl)"/>`
  + `<rect x="0" y="0" width="320" height="240" rx="28" ry="28" fill="url(#${uu}-pw)"/>`;

const clipDef = (uu: string) =>
  `<clipPath id="${uu}-c"><rect x="0" y="0" width="320" height="240" rx="28" ry="28"/></clipPath>`;

// A hairline, not a shadow. Keeps the plate legible on a same-tone page background.
const frame =
  '<rect x="0.5" y="0.5" width="319" height="239" rx="27.5" ry="27.5" fill="none"'
  + ' stroke="var(--i-form)" stroke-opacity="0.1" stroke-width="1"/>';

/* ===================================================================== SCENES */

/** cycle — eight moon phases set on a rhythm ring, with the elapsed arc drawn in. */
function sceneCycle(uu: string) {
  const cx = 160, cy = 118, ring = 78, mr = 15;
  const defs = plateDefs(uu) + clipDef(uu)
    + `<linearGradient id="${uu}-moon" x1="0.05" y1="0" x2="0.9" y2="1">`
      + st(0, 'accent', 0.95) + st(1, 'accent', 0.55)
    + '</linearGradient>'
    + rgU(`${uu}-core`, cx, cy - 6, 74, st(0, 'lum', 'var(--i-wash)') + st(0.6, 'lum', 'var(--i-wash-soft)') + st(1, 'lum', 0))
    + rgU(`${uu}-halo`, cx, cy + ring, 34, st(0, 'accent', 0.32) + st(0.55, 'accent', 0.12) + st(1, 'accent', 0));

  const phases = [
    { kind: 'new', k: 0, flip: false },
    { kind: 'phase', k: -0.62, flip: false },
    { kind: 'phase', k: 0, flip: false },
    { kind: 'phase', k: 0.62, flip: false },
    { kind: 'full', k: 0, flip: false },
    { kind: 'phase', k: 0.62, flip: true },
    { kind: 'phase', k: 0, flip: true },
    { kind: 'phase', k: -0.62, flip: true },
  ];

  let moons = '';
  for (let i = 0; i < phases.length; i++) {
    const p = phases[i];
    const a = (i * 45 - 90) * Math.PI / 180;
    const mx = cx + ring * Math.cos(a);
    const my = cy + ring * Math.sin(a);
    const inner = moonBody(uu, mr, p.kind, p.k);
    const t = `translate(${n(mx)},${n(my)})` + (p.flip ? ' scale(-1,1)' : '');
    // The lift wrapper carries the CSS transform so it can never clash with the
    // positioning transform attribute on the inner group.
    moons += `<g class="w-i-lift w-i-d${(i % 6) + 1}"><g transform="${t}">${inner}</g></g>`;
  }

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<circle cx="${cx}" cy="${cy - 6}" r="74" fill="url(#${uu}-core)"/>`
      + `<circle cx="${cx}" cy="${cy + ring}" r="34" fill="url(#${uu}-halo)"/>`
      + `<circle cx="${cx}" cy="${cy}" r="${ring}" fill="none" stroke="var(--i-accent)" stroke-opacity="0.26" stroke-width="1.25"/>`
      + `<circle cx="${cx}" cy="${cy}" r="62" fill="none" stroke="var(--i-accent)" stroke-opacity="0.12" stroke-width="1"/>`
      // elapsed arc: top of the ring, clockwise, to the full moon
      + `<path d="M ${cx},${cy - ring} A ${ring},${ring} 0 0 1 ${cx},${cy + ring}" fill="none" stroke="var(--i-accent)" stroke-opacity="0.6" stroke-width="2.5" stroke-linecap="round"/>`
      + moons
      + `<path d="M ${cx},${cy + ring + 22} L ${cx},${cy + ring + 32}" stroke="var(--i-accent)" stroke-opacity="0.7" stroke-width="2" stroke-linecap="round"/>`
      + `<circle cx="${cx}" cy="${cy}" r="3.5" fill="var(--i-accent)" fill-opacity="0.55"/>`
      + `<circle cx="${cx}" cy="${cy}" r="10" fill="none" stroke="var(--i-accent)" stroke-opacity="0.2" stroke-width="1"/>`
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** pregnancy — a warm ambient glow and a soft profile, no features, no clinic. */
function scenePregnancy(uu: string) {
  const defs = plateDefs(uu) + clipDef(uu)
    + rgU(`${uu}-warm`, 214, 66, 190, st(0, 'glow', 0.9) + st(0.45, 'glow', 0.32) + st(1, 'glow', 0))
    + rgU(`${uu}-belly`, 150, 186, 52, st(0, 'lum', 0.62) + st(0.6, 'lum', 0.22) + st(1, 'lum', 0));

  const figure =
    '<g fill="var(--i-form)" fill-opacity="0.88">'
      + '<rect x="180" y="92" width="21" height="24" rx="9"/>'
      + '<circle cx="190" cy="80" r="23"/>'
      + '<circle cx="212" cy="64" r="11"/>'
      + '<path d="M 176,110 C 166,126 154,142 145,162 C 134,184 130,208 132,240'
        + ' L 232,240 C 236,206 233,176 227,154 C 221,132 214,120 204,110 Z"/>'
    + '</g>';

  const contours =
    '<g fill="none" stroke="var(--i-stage)" stroke-opacity="0.28" stroke-width="1.5" stroke-linecap="round">'
      + '<path d="M 152,150 C 138,168 134,192 139,214"/>'
      + '<path d="M 169,146 C 152,168 147,196 153,222"/>'
    + '</g>';

  const motes =
    '<g fill="var(--i-accent)">'
      + '<circle cx="96" cy="98" r="3" fill-opacity="0.38"/>'
      + '<circle cx="112" cy="70" r="2" fill-opacity="0.28"/>'
      + '<circle cx="84" cy="134" r="2.4" fill-opacity="0.22"/>'
    + '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<circle cx="214" cy="66" r="190" fill="url(#${uu}-warm)"/>`
      + motes
      + figure
      + contours
      + `<circle class="w-i-fade w-i-d3" cx="150" cy="186" r="52" fill="url(#${uu}-belly)"/>`
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** mental-wellness — aurora bands under drifting cloud forms. */
function sceneMental(uu: string) {
  const defs = plateDefs(uu) + clipDef(uu)
    + lgU(`${uu}-a1`, -20, 0, 340, 0, st(0, 'accent', 0) + st(0.3, 'accent', 0.42) + st(0.62, 'accent', 0.5) + st(1, 'accent', 0))
    + lgU(`${uu}-a2`, -20, 0, 340, 0, st(0, 'accent', 0) + st(0.42, 'accent', 0.3) + st(1, 'accent', 0))
    + lgU(`${uu}-a3`, -20, 0, 340, 0, st(0, 'accent', 0) + st(0.5, 'accent', 0.2) + st(1, 'accent', 0))
    + rgB(`${uu}-cl`, st(0, 'lum', 0.95) + st(0.55, 'lum', 0.5) + st(1, 'lum', 0))
    + rgB(`${uu}-cs`, st(0, 'accent', 0.2) + st(1, 'accent', 0))
    + rgU(`${uu}-hz`, 160, 236, 200, st(0, 'lum', 0.5) + st(1, 'lum', 0));

  function cloud(cx: number, cy: number, s: number, op: number) {
    const e = (x: number, y: number, rx: number, ry: number, g: string) =>
      `<ellipse cx="${n(x)}" cy="${n(y)}" rx="${n(rx)}" ry="${n(ry)}" fill="url(#${uu}-${g})"/>`;
    return `<g opacity="${op}">`
      + e(cx, cy + s * 0.26, s * 1.02, s * 0.4, 'cs')
      + e(cx, cy, s, s * 0.5, 'cl')
      + e(cx - s * 0.52, cy + s * 0.16, s * 0.62, s * 0.36, 'cl')
      + e(cx + s * 0.55, cy + s * 0.12, s * 0.56, s * 0.32, 'cl')
      + e(cx + s * 0.08, cy - s * 0.3, s * 0.5, s * 0.34, 'cl')
      + '</g>';
  }

  const rnd = seeded(20260802);
  let stars = '<g fill="var(--i-accent)">';
  for (let i = 0; i < 14; i++) {
    const sx = 22 + rnd() * 276;
    const sy = 22 + rnd() * 96;
    const sr = 0.7 + rnd() * 1.1;
    stars += `<circle cx="${n(sx)}" cy="${n(sy)}" r="${n(sr)}" fill-opacity="${n(0.18 + rnd() * 0.24)}"/>`;
  }
  stars += '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + stars
      + ribbon(-20, 72, [[52, 44, 100, 86, 156, 58], [210, 32, 264, 66, 340, 34]], 11, `url(#${uu}-a3)`)
      + ribbon(-20, 104, [[40, 72, 96, 120, 150, 88], [206, 54, 258, 96, 340, 58]], 26, `url(#${uu}-a1)`)
      + ribbon(-20, 150, [[46, 128, 104, 164, 158, 134], [212, 104, 262, 140, 340, 110]], 17, `url(#${uu}-a2)`)
      + cloud(96, 172, 46, 0.9)
      + cloud(226, 142, 30, 0.7)
      + cloud(176, 202, 38, 0.55)
      + '<ellipse cx="160" cy="236" rx="200" ry="46" fill="url(#' + uu + '-hz)"/>'
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** nutrition — an arranged botanical still life. */
function sceneNutrition(uu: string) {
  const defs = plateDefs(uu) + clipDef(uu)
    + rgB(`${uu}-gr`, st(0, 'form', 0.16) + st(0.6, 'form', 0.06) + st(1, 'form', 0))
    + rgB(`${uu}-fruit`, st(0, 'lum', 0.95) + st(0.42, 'accent', 0.8) + st(1, 'accent', 0.95),
        'cx="0.5" cy="0.5" r="0.72" fx="0.34" fy="0.28"');

  // Halved citrus: eight wedges with a hairline gap, never a drawn cartoon slice.
  const ccx = 166, ccy = 166, cr = 30;
  let citrus = `<circle cx="${ccx}" cy="${ccy}" r="${cr}" fill="var(--i-accent)" fill-opacity="0.8"/>`
    + `<circle cx="${ccx}" cy="${ccy}" r="${cr - 6}" fill="var(--i-stage)" fill-opacity="0.94"/>`;
  for (let i = 0; i < 8; i++) {
    const a1 = (i * 45 + 4) * Math.PI / 180;
    const a2 = ((i + 1) * 45 - 4) * Math.PI / 180;
    const wr = cr - 8;
    const x1 = ccx + wr * Math.cos(a1), y1 = ccy + wr * Math.sin(a1);
    const x2 = ccx + wr * Math.cos(a2), y2 = ccy + wr * Math.sin(a2);
    citrus += `<path d="M ${ccx},${ccy} L ${n(x1)},${n(y1)} A ${wr},${wr} 0 0 1 ${n(x2)},${n(y2)} Z" fill="var(--i-accent)" fill-opacity="0.34"/>`;
  }
  citrus += `<circle cx="${ccx}" cy="${ccy}" r="3" fill="var(--i-accent)" fill-opacity="0.6"/>`;

  const sprig =
    '<g>'
      + '<path d="M 262,196 C 272,166 278,142 294,114" fill="none" stroke="var(--i-accent)" stroke-opacity="0.6" stroke-width="2" stroke-linecap="round"/>'
      + leaf(268, 178, 26, 9, 52, 'var(--i-accent)', 0.6)
      + leaf(272, 162, 24, 8, -44, 'var(--i-accent)', 0.5)
      + leaf(278, 146, 24, 8, 56, 'var(--i-accent)', 0.6)
      + leaf(284, 132, 22, 7, -40, 'var(--i-accent)', 0.5)
      + leaf(291, 120, 22, 7, 30, 'var(--i-accent)', 0.6)
    + '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<ellipse cx="160" cy="198" rx="126" ry="18" fill="url(#${uu}-gr)"/>`
      + leaf(84, 198, 78, 26, -46, 'var(--i-form)', 0.14)
      + sprig
      + leaf(104, 196, 100, 34, -14, 'var(--i-accent)', 0.85)
      + leaf(200, 198, 62, 21, 26, 'var(--i-accent)', 0.5)
      + citrus
      + `<path d="M 232,146 C 233,139 235,135 239,132" fill="none" stroke="var(--i-form)" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round"/>`
      + leaf(236, 146, 22, 8, 30, 'var(--i-accent)', 0.85)
      + `<circle cx="232" cy="170" r="26" fill="url(#${uu}-fruit)"/>`
      + '<g fill="var(--i-accent)">'
        + '<circle cx="120" cy="190" r="7" fill-opacity="0.6"/>'
        + '<circle cx="136" cy="193" r="5.5" fill-opacity="0.75"/>'
        + '<circle cx="106" cy="193" r="4.5" fill-opacity="0.4"/>'
      + '</g>'
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** sleep — a night sky over a soft horizon. Dark in both colour schemes, by design. */
function sceneSleep(uu: string) {
  const defs = clipDef(uu)
    + lgU(`${uu}-sky`, 0, 0, 0, STAGE_H,
        st(0, 'ink', 1) + st(0.46, 'ink', 0.94) + st(0.72, 'accent', 0.5) + st(0.88, 'glow', 0.28) + st(1, 'glow', 0.14))
    + rgU(`${uu}-mh`, 240, 62, 50, st(0, 'glow', 0.3) + st(0.5, 'glow', 0.1) + st(1, 'glow', 0))
    + rgB(`${uu}-hz`, st(0, 'glow', 0.34) + st(0.55, 'glow', 0.12) + st(1, 'glow', 0));

  const rnd = seeded(881122);
  let stars = '<g fill="var(--i-glow)">';
  for (let i = 0; i < 32; i++) {
    const sx = 16 + rnd() * 288;
    const sy = 18 + rnd() * 136;
    const sr = 0.5 + rnd() * 1.2;
    const so = 0.25 + rnd() * 0.6;
    stars += `<circle cx="${n(sx)}" cy="${n(sy)}" r="${n(sr)}" fill-opacity="${n(so)}"/>`;
  }
  stars += '</g>'
    + '<g fill="var(--i-glow)">'
      + '<circle cx="74" cy="54" r="1.9" fill-opacity="0.9"/><circle cx="74" cy="54" r="6" fill-opacity="0.1"/>'
      + '<circle cx="132" cy="96" r="1.6" fill-opacity="0.8"/><circle cx="132" cy="96" r="5" fill-opacity="0.09"/>'
      + '<circle cx="286" cy="118" r="1.5" fill-opacity="0.7"/><circle cx="286" cy="118" r="5" fill-opacity="0.08"/>'
    + '</g>';

  const moon = '<g transform="translate(240,62)">'
    + '<path d="M 0,-21 A 21,21 0 0 1 0,21 A 11.55,21 0 0 0 0,-21 Z" fill="var(--i-glow)" fill-opacity="0.92"/>'
    + '</g>';

  const hills =
    '<path d="M -12,196 C 36,172 78,168 122,184 C 160,198 202,176 246,172 C 282,169 306,180 332,190'
      + ' L 332,252 L -12,252 Z" fill="var(--i-ink)" fill-opacity="0.72"/>'
    + '<path d="M -12,196 C 36,172 78,168 122,184 C 160,198 202,176 246,172 C 282,169 306,180 332,190"'
      + ' fill="none" stroke="var(--i-glow)" stroke-opacity="0.14" stroke-width="1"/>'
    + '<path d="M -12,216 C 54,196 116,210 172,218 C 222,225 282,216 332,208'
      + ' L 332,254 L -12,254 Z" fill="var(--i-ink)"/>'
    + '<path d="M -12,216 C 54,196 116,210 172,218 C 222,225 282,216 332,208"'
      + ' fill="none" stroke="var(--i-glow)" stroke-opacity="0.22" stroke-width="1"/>';

  const body =
    '<rect x="0" y="0" width="320" height="240" rx="28" ry="28" fill="url(#' + uu + '-sky)"/>'
    + `<g clip-path="url(#${uu}-c)">`
      + stars
      + `<circle cx="240" cy="62" r="50" fill="url(#${uu}-mh)"/>`
      + moon
      + `<ellipse cx="160" cy="210" rx="200" ry="54" fill="url(#${uu}-hz)"/>`
      + hills
    + '</g>'
    + '<rect x="0.5" y="0.5" width="319" height="239" rx="27.5" ry="27.5" fill="none" stroke="var(--i-glow)" stroke-opacity="0.12" stroke-width="1"/>';

  return `<defs>${defs}</defs>${body}`;
}

/** hydration — a liquid sphere with a specular highlight and a caustic under-pool. */
function sceneHydration(uu: string) {
  const cx = 160, cy = 116, r = 76;
  const defs = plateDefs(uu) + clipDef(uu)
    + `<clipPath id="${uu}-sp"><circle cx="${cx}" cy="${cy}" r="${r}"/></clipPath>`
    + rgU(`${uu}-glass`, cx - 34, cy - 40, 132, st(0, 'lum', 0.9) + st(0.5, 'tint', 0.55) + st(1, 'accent', 0.32))
    + lgU(`${uu}-liq`, 0, cy - 4, 0, cy + r, st(0, 'accent', 0.5) + st(1, 'accent', 0.85))
    + rgB(`${uu}-spec`, st(0, 'lum', 0.85) + st(0.6, 'lum', 0.3) + st(1, 'lum', 0))
    + rgB(`${uu}-pool`, st(0, 'accent', 0.3) + st(0.55, 'accent', 0.12) + st(1, 'accent', 0))
    + rgB(`${uu}-caus`, st(0, 'lum', 0.65) + st(1, 'lum', 0));

  const inside =
    `<g clip-path="url(#${uu}-sp)">`
      + `<circle cx="${cx}" cy="${cy}" r="${r}" fill="url(#${uu}-glass)"/>`
      + `<path d="M 82,118 C 106,102 130,132 160,124 C 190,116 214,102 240,118 L 240,200 L 82,200 Z" fill="url(#${uu}-liq)"/>`
      + '<path d="M 82,118 C 106,102 130,132 160,124 C 190,116 214,102 240,118" fill="none" stroke="var(--i-lum)" stroke-opacity="0.4" stroke-width="1.5"/>'
      + '<path d="M 108,158 A 67,67 0 0 0 212,158" fill="none" stroke="var(--i-lum)" stroke-opacity="0.42" stroke-width="6" stroke-linecap="round"/>'
      + '<ellipse cx="126" cy="80" rx="26" ry="17" transform="rotate(-28 126 80)" fill="url(#' + uu + '-spec)"/>'
      + '<ellipse cx="196" cy="72" rx="9" ry="6" transform="rotate(-24 196 72)" fill="url(#' + uu + '-spec)"/>'
    + '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<ellipse cx="160" cy="212" rx="86" ry="14" fill="url(#${uu}-pool)"/>`
      + `<ellipse cx="168" cy="211" rx="30" ry="6" fill="url(#${uu}-caus)"/>`
      + inside
      + `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--i-accent)" stroke-opacity="0.38" stroke-width="1.25"/>`
      + `<circle cx="${cx}" cy="${cy}" r="${r - 5}" fill="none" stroke="var(--i-lum)" stroke-opacity="0.3" stroke-width="1"/>`
      + '<g class="w-i-lift w-i-d2">' + drop(262, 62, 15, 'var(--i-accent)', 0.55) + '</g>'
      + '<g class="w-i-lift w-i-d4">' + drop(284, 96, 9, 'var(--i-accent)', 0.35) + '</g>'
      + '<g class="w-i-lift w-i-d3">' + drop(52, 74, 11, 'var(--i-accent)', 0.4) + '</g>'
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** fitness — flowing ribbon paths, movement without a figure. */
function sceneFitness(uu: string) {
  const defs = plateDefs(uu) + clipDef(uu)
    + lgU(`${uu}-r1`, 0, 220, 300, 46, st(0, 'accent', 0.06) + st(0.42, 'accent', 0.78) + st(1, 'accent', 0.14))
    + lgU(`${uu}-r2`, 0, 180, 280, 30, st(0, 'accent', 0.04) + st(0.5, 'accent', 0.42) + st(1, 'accent', 0.08))
    + lgU(`${uu}-r3`, 0, 250, 300, 100, st(0, 'form', 0.04) + st(0.5, 'form', 0.2) + st(1, 'form', 0.03))
    + rgU(`${uu}-goal`, 268, 62, 78, st(0, 'lum', 0.75) + st(0.5, 'lum', 0.24) + st(1, 'lum', 0));

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + '<circle cx="160" cy="120" r="88" fill="none" stroke="var(--i-accent)" stroke-opacity="0.14" stroke-width="1"/>'
      + '<circle cx="160" cy="120" r="64" fill="none" stroke="var(--i-accent)" stroke-opacity="0.08" stroke-width="1"/>'
      + `<circle cx="268" cy="62" r="78" fill="url(#${uu}-goal)"/>`
      + ribbon(-16, 236, [[62, 234, 98, 208, 138, 184], [178, 158, 226, 146, 274, 124]], 7, `url(#${uu}-r3)`)
      + ribbon(-16, 160, [[44, 158, 78, 130, 116, 104], [152, 80, 206, 68, 250, 44]], 11, `url(#${uu}-r2)`)
      + ribbon(-16, 206, [[52, 204, 84, 168, 120, 140], [158, 110, 214, 98, 268, 68]], 18, `url(#${uu}-r1)`)
      + '<g fill="var(--i-lum)">'
        + '<circle cx="120" cy="149" r="3.4" fill-opacity="0.72"/>'
        + '<circle cx="176" cy="118" r="3" fill-opacity="0.58"/>'
        + '<circle cx="226" cy="98" r="2.6" fill-opacity="0.44"/>'
        + '<circle cx="262" cy="79" r="2.2" fill-opacity="0.3"/>'
