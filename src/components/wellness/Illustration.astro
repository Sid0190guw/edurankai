/** milestone — the one openly celebratory composition. Pairs with motion="reveal". */
function sceneMilestone(uu: string) {
  const cx = 160, cy = 120;
  const defs = plateDefs(uu) + clipDef(uu)
    + rgB(`${uu}-core`, st(0, 'lum', 0.98) + st(0.5, 'accent', 0.7) + st(1, 'accent', 0.95),
        'cx="0.5" cy="0.5" r="0.66" fx="0.36" fy="0.3"')
    + rgU(`${uu}-aura`, cx, cy, 110, st(0, 'lum', 0.55) + st(0.55, 'lum', 0.18) + st(1, 'lum', 0));

  let rays = '<g fill="var(--i-accent)" stroke-linejoin="round">';
  for (let i = 0; i < 12; i++) {
    const a = (i * 30 - 90) * Math.PI / 180;
    const ca = Math.cos(a), sa = Math.sin(a);
    const nx = -sa, ny = ca;
    const r0 = 46;
    const r1 = i % 2 === 0 ? 78 : 62;
    const w0 = 3.4, w1 = 1.1;
    const p1x = cx + ca * r0 + nx * w0, p1y = cy + sa * r0 + ny * w0;
    const p2x = cx + ca * r1 + nx * w1, p2y = cy + sa * r1 + ny * w1;
    const p3x = cx + ca * r1 - nx * w1, p3y = cy + sa * r1 - ny * w1;
    const p4x = cx + ca * r0 - nx * w0, p4y = cy + sa * r0 - ny * w0;
    const op = i % 2 === 0 ? 0.6 : 0.34;
    rays += `<path class="w-i-fade w-i-d${(i % 6) + 1}" d="M ${n(p1x)},${n(p1y)} L ${n(p2x)},${n(p2y)} L ${n(p3x)},${n(p3y)} L ${n(p4x)},${n(p4y)} Z" fill-opacity="${op}"/>`;
  }
  rays += '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<circle cx="${cx}" cy="${cy}" r="110" fill="url(#${uu}-aura)"/>`
      + `<circle cx="${cx}" cy="${cy}" r="90" fill="none" stroke="var(--i-accent)" stroke-opacity="0.2" stroke-width="1"/>`
      + rays
      + `<circle cx="${cx}" cy="${cy}" r="42" fill="none" stroke="var(--i-lum)" stroke-opacity="0.5" stroke-width="1.25"/>`
      + `<circle cx="${cx}" cy="${cy}" r="34" fill="url(#${uu}-core)"/>`
      + '<g fill="var(--i-accent)">'
        + '<circle cx="72" cy="66" r="2.6" fill-opacity="0.4"/>'
        + '<circle cx="256" cy="184" r="2.2" fill-opacity="0.34"/>'
        + '<circle cx="248" cy="52" r="3" fill-opacity="0.3"/>'
        + '<circle cx="64" cy="182" r="2" fill-opacity="0.26"/>'
      + '</g>'
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/** empty — a space prepared, not a shrug. One entry logged, room for the rest. */
function sceneEmpty(uu: string) {
  const cx = 160, cy = 110, r = 58;
  const defs = plateDefs(uu) + clipDef(uu)
    + rgU(`${uu}-core`, cx, cy, 62, st(0, 'lum', 'var(--i-wash)') + st(0.6, 'lum', 'var(--i-wash-soft)') + st(1, 'lum', 0))
    + rgU(`${uu}-base`, 160, 214, 130, st(0, 'tint', 0.55) + st(1, 'tint', 0));

  let trail = '<g fill="var(--i-accent)">';
  const ops = [0.3, 0.2, 0.12];
  for (let i = 0; i < 3; i++) {
    const a = ((i + 1) * 45 - 90) * Math.PI / 180;
    trail += `<circle cx="${n(cx + r * Math.cos(a))}" cy="${n(cy + r * Math.sin(a))}" r="${n(3 - i * 0.4)}" fill-opacity="${ops[i]}"/>`;
  }
  trail += '</g>';

  const body = plateBody(uu)
    + `<g clip-path="url(#${uu}-c)">`
      + `<ellipse cx="160" cy="214" rx="130" ry="34" fill="url(#${uu}-base)"/>`
      + `<circle cx="${cx}" cy="${cy}" r="62" fill="url(#${uu}-core)"/>`
      + `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--i-form)" stroke-opacity="0.16" stroke-width="1.5"/>`
      + trail
      + `<circle class="w-i-lift w-i-d1" cx="${cx}" cy="${cy - r}" r="13" fill="var(--i-accent)" fill-opacity="0.16"/>`
      + `<circle class="w-i-lift w-i-d1" cx="${cx}" cy="${cy - r}" r="6" fill="var(--i-accent)" fill-opacity="0.9"/>`
      + '<path d="M 88,198 C 122,190 198,190 232,198" fill="none" stroke="var(--i-form)" stroke-opacity="0.12" stroke-width="1.5" stroke-linecap="round"/>'
      + '<g>'
        + '<circle cx="120" cy="192" r="5" fill="var(--i-form)" fill-opacity="0.16"/>'
        + '<circle cx="160" cy="186" r="6" fill="var(--i-accent)" fill-opacity="0.3"/>'
        + '<circle cx="200" cy="192" r="5" fill="var(--i-form)" fill-opacity="0.16"/>'
      + '</g>'
    + '</g>' + frame;

  return `<defs>${defs}</defs>${body}`;
}

/**
 * loading — the spinner replacement. Three rings bloom outward from a lit core on a
 * 1200ms cycle, staggered 400ms apart. With reduced motion the same three rings sit at
 * fixed scales around the core: a composed still, not a frozen animation.
 */
function sceneLoading(uu: string) {
  const defs = plateDefs(uu)
    + rgB(`${uu}-core`, st(0, 'lum', 0.98) + st(0.45, 'accent', 0.72) + st(1, 'accent', 0.92),
        'cx="0.5" cy="0.5" r="0.66" fx="0.36" fy="0.3"')
    + rgU(`${uu}-aura`, 160, 120, 92, st(0, 'lum', 'var(--i-wash-soft)') + st(1, 'lum', 0));

  const ring = (cls: string) =>
    `<g class="w-i-b ${cls}"><circle cx="0" cy="0" r="58" fill="none" stroke="var(--i-accent)" stroke-width="2"/></g>`;

  const body = plateBody(uu)
    + '<circle cx="160" cy="120" r="92" fill="url(#' + uu + '-aura)"/>'
    + '<g transform="translate(160,120)">'
      + ring('w-i-b3') + ring('w-i-b2') + ring('w-i-b1')
      + '<g class="w-i-core"><circle cx="0" cy="0" r="20" fill="url(#' + uu + '-core)"/></g>'
    + '</g>'
    + frame;

  return `<defs>${defs}</defs>${body}`;
}

/* -------------------------------------------------------------- scene lookup */

const SCENES: { [key: string]: (uu: string) => string } = {
  cycle: sceneCycle,
  pregnancy: scenePregnancy,
  'mental-wellness': sceneMental,
  nutrition: sceneNutrition,
  sleep: sceneSleep,
  hydration: sceneHydration,
  fitness: sceneFitness,
  therapy: sceneTherapy,
  milestone: sceneMilestone,
  empty: sceneEmpty,
  loading: sceneLoading,
};

const build = SCENES[scene] ?? sceneEmpty;
const titleMarkup = title ? `<title id="${titleId}">${String(title).replace(/[<>&]/g, '')}</title>` : '';
const inner = titleMarkup + build(u);
---

<svg
  class={`w-ill ${className}`.trim()}
  data-scene={scene}
  data-tone={toneKey}
  data-motion={motionAttr}
  viewBox="0 0 320 240"
  width={attrW}
  height={attrH}
  style={styleAttr}
  role={title ? 'img' : undefined}
  aria-labelledby={title ? titleId : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
><Fragment set:html={inner} /></svg>

<style is:global>
  /* ============================================================
     Illustration language: palette roles
     Every hex below is a FALLBACK inside var(). When
     src/styles/wellness.css is present its module tokens win, and
     each illustration inherits its module's identity for free.
     ============================================================ */

  .w-ill {
    display: block;
    max-width: 100%;
    height: auto;

    /* shared light roles: light in both schemes, they represent light itself */
    --i-lum: var(--w-ill-lum, #FFFBF2);
