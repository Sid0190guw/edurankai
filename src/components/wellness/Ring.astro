---
/**
 * Wellness / Ring
 *
 * A progress ring in plain SVG. By default it renders at its final value
 * with no animation at all — most rings live on a dashboard someone opened
 * to check something, and a ring that redraws itself every visit is noise.
 * Motion is opt-in per instance via `celebrate`, which is Tier A and meant
 * for finished logs, milestones and onboarding.
 *
 * Design decision — the celebration is NOT a stroke-dashoffset draw-on.
 * Ruling 2 allows transform and opacity only, and dashoffset is a paint
 * property, so the milestone is built from three compositor-only moves that
 * together read as the ring being drawn: the arc blooms up from 0.94 scale,
 * a terminal dot sweeps around the track to the arc's end, and the numeral
 * rises 6px into place. When a caller cannot have motion at all, the
 * celebratory state is still visible in the COMPOSITION — the echo hairline
 * and the terminal dot are static parts of the design, not by-products of
 * an animation. Nobody gets a lesser version, they get a still one.
 */
import './tokens.css';

export interface Props {
  value: number;
  max?: number;
  module?:
    | 'cycle' | 'pregnancy' | 'mental' | 'nutrition'
    | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'neutral';
  /** Visible caption under the ring and the ring's accessible name. */
  label?: string;
  /** Outer diameter in px. The ring never exceeds its container. */
  size?: number;
  /** Tier A milestone entrance. Off unless a caller asks for it. */
  celebrate?: boolean;
  /** Overrides the number in the middle. */
  display?: string;
  /** Small line under the number, inside the ring. */
  unit?: string;
  thickness?: number;
  class?: string;
}

const {
  value,
  max = 100,
  module,
  label,
  size = 112,
  celebrate = false,
  display,
  unit,
  thickness,
  class: cls = '',
  ...rest
} = Astro.props;

const box = 120; // fixed viewBox; the rendered size is CSS-driven
const stroke = Math.max(5, Math.min(20, thickness ?? Math.round(box * 0.085)));
// 4 units of headroom so the celebratory echo hairline sits inside the
// viewBox and never needs overflow to escape its own box.
const radius = (box - stroke) / 2 - 4;
const centre = box / 2;
const circumference = 2 * Math.PI * radius;

const safeMax = max > 0 ? max : 1;
const ratio = Math.min(1, Math.max(0, value / safeMax));
const dash = Number((circumference * ratio).toFixed(2));
const gap = Number((circumference - dash).toFixed(2));
const angle = Number((ratio * 360).toFixed(2));
const hasArc = dash > 0.5;

const centreText = display ?? String(value);
const ringName = label || 'Progress';
const valueText = `${value} of ${max}${unit ? ' ' + unit : ''}`;
---

<div
  class:list={['w-ring', celebrate && 'w-ring--celebrate', cls]}
  data-w-module={module}
  style={`--w-ring-size:${size}px;--w-ring-angle:${angle}deg`}
  {...rest}
>
  <div
    class="w-ring__stack"
    role="progressbar"
    aria-label={ringName}
    aria-valuemin="0"
    aria-valuemax={max}
    aria-valuenow={value}
    aria-valuetext={valueText}
  >
    <svg class="w-ring__svg" viewBox={`0 0 ${box} ${box}`} aria-hidden="true">
      <g transform={`rotate(-90 ${centre} ${centre})`}>
        {celebrate && (
          <circle
            class="w-ring__echo"
            cx={centre}
            cy={centre}
            r={radius + stroke * 0.78}
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          />
        )}

        <circle
          class="w-ring__track"
          cx={centre}
          cy={centre}
          r={radius}
          fill="none"
          stroke-width={stroke}
        />

        {hasArc && (
          <circle
            class="w-ring__arc"
            cx={centre}
            cy={centre}
            r={radius}
            fill="none"
            stroke-width={stroke}
            stroke-linecap="round"
            stroke-dasharray={`${dash} ${gap}`}
          />
        )}

        {celebrate && hasArc && (
          <g class="w-ring__sweep">
            <circle
              class="w-ring__dot"
              cx={centre + radius}
              cy={centre}
              r={stroke * 0.3}
            />
          </g>
        )}
      </g>
    </svg>

    <div class="w-ring__centre">
      <span class="w-ring__value">{centreText}</span>
      {unit && <span class="w-ring__unit">{unit}</span>}
    </div>
  </div>

  {label && <p class="w-ring__label" aria-hidden="true">{label}</p>}
</div>

<style>
  .w-ring {
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--w-s-2);
    max-width: 100%;
    min-width: 0;
    font-family: var(--w-font-body);
    color: var(--w-accent);
  }

  /* Stacking with grid rather than absolute positioning keeps the ring
     honest at 360px: the SVG sets the height, the centre text sits in the
     same cell, nothing is positioned off a magic number. */
  .w-ring__stack {
    position: relative;
    display: grid;
    width: min(100%, var(--w-ring-size));
  }
  .w-ring__stack > * {
    grid-area: 1 / 1;
  }

  .w-ring__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .w-ring__track { stroke: var(--w-track); }
  .w-ring__arc { stroke: var(--w-accent); }
  .w-ring__dot { fill: var(--w-accent); }
  .w-ring__echo { opacity: 0.34; }

  .w-ring__centre {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 0 12%;
    text-align: center;
    min-width: 0;
  }

  .w-ring__value {
    font-family: var(--w-font-num);
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
    font-size: max(0.95rem, calc(var(--w-ring-size) * 0.215));
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--w-ink);
  }

  .w-ring__unit {
    font-size: max(0.625rem, calc(var(--w-ring-size) * 0.095));
    font-weight: 500;
    line-height: 1.2;
    color: var(--w-ink-3);
  }

  .w-ring__label {
    margin: 0;
    max-width: min(100%, calc(var(--w-ring-size) + 32px));
    text-align: center;
    font-size: var(--w-t-meta);
    font-weight: 500;
    line-height: 1.4;
    color: var(--w-ink-2);
  }

  /* --- Tier A, milestones only, declared only where motion is welcome ---
     Everything below sits inside no-preference, so a reduced-motion user
     needs no override: the ring simply renders finished. */
  @media (prefers-reduced-motion: no-preference) {
    .w-ring--celebrate .w-ring__arc {
      transform-origin: 50% 50%;
      animation: w-ring-bloom var(--w-dur-rich) var(--w-ease-spring) both;
    }
    .w-ring--celebrate .w-ring__sweep {
      transform-origin: 50% 50%;
      animation: w-ring-sweep var(--w-dur-rich) var(--w-ease-rich) both;
    }
    .w-ring--celebrate .w-ring__echo {
      animation: w-ring-fade var(--w-dur-rich) var(--w-ease-rich) 120ms both;
    }
    .w-ring--celebrate .w-ring__centre {
      animation: w-ring-rise 420ms var(--w-ease-rich) 160ms both;
    }
  }

  @keyframes w-ring-bloom {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }

  /* The dot travels from twelve o'clock to the end of the arc. This is the
     gesture that reads as "drawing", and it is a pure rotation. */
  @keyframes w-ring-sweep {
    from { transform: rotate(0deg); }
    to { transform: rotate(var(--w-ring-angle)); }
  }

  @keyframes w-ring-fade {
    from { opacity: 0; }
    to { opacity: 0.34; }
  }

  @keyframes w-ring-rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
