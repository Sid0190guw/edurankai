---
/**
 * Wellness / Card
 *
 * The surface everything else sits on. It owns one job beyond looking calm:
 * it publishes `--w-accent` and `--w-tint` for its whole subtree, so a Ring
 * or a Metric dropped inside a "cycle" card is already the right colour
 * without being told a second time.
 *
 * Design decision — the hover lift is a pseudo-element fading in, not a
 * shadow growing. Ruling 2 forbids animating box-shadow, so the deeper
 * shadow is painted once on an inert ::after and only its OPACITY moves.
 * The card body carries a 2px translateY at the same time. Both properties
 * are compositor-only, so the lift costs a cheap Android phone nothing.
 * A static card gets no transition at all — not a 0ms one, none — because
 * the whole point of Tier B is that most surfaces never move.
 */
import './tokens.css';

export interface Props {
  module?:
    | 'cycle' | 'pregnancy' | 'mental' | 'nutrition'
    | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'neutral';
  tone?: 'calm' | 'celebratory';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  /** Renders an anchor and turns on the Tier B lift. */
  href?: string;
  /** Element to render when there is no href. */
  as?: 'div' | 'article' | 'section' | 'li' | 'label';
  /** Opt into the lift when the card is interactive by other means. */
  interactive?: boolean;
  /** Accessible name, used when the card is a link or a region. */
  label?: string;
  class?: string;
}

const {
  module = 'neutral',
  tone = 'calm',
  padding = 'md',
  href,
  as = 'div',
  interactive = false,
  label,
  class: cls = '',
  ...rest
} = Astro.props;

const isLink = typeof href === 'string' && href.length > 0;
const lifts = isLink || interactive;
const Tag = isLink ? 'a' : as;
---

<Tag
  class:list={[
    'w-card',
    `w-card--pad-${padding}`,
    tone === 'celebratory' && 'w-card--celebratory',
    lifts && 'w-card--lift',
    lifts && 'w-focusable',
    cls,
  ]}
  data-w-module={module}
  href={isLink ? href : undefined}
  aria-label={label}
  {...rest}
>
  <slot />
</Tag>

<style>
  .w-card {
    position: relative;
    display: block;
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    background-color: var(--w-surface);
    color: var(--w-ink);
    border: 1px solid var(--w-hairline);
    border-radius: var(--w-r-card);
    box-shadow: var(--w-shadow-soft);
    font-family: var(--w-font-body);
    font-size: var(--w-t-body);
    line-height: 1.55;
    text-decoration: none;
  }

  /* Padding scale. sm/md are sized for a 360px viewport first. */
  .w-card--pad-none { padding: 0; }
  .w-card--pad-sm { padding: var(--w-s-3); }
  .w-card--pad-md { padding: var(--w-s-4); }
  .w-card--pad-lg { padding: var(--w-s-5); }

  @media (min-width: 480px) {
    .w-card--pad-sm { padding: var(--w-s-4); }
    .w-card--pad-md { padding: var(--w-s-5); }
    .w-card--pad-lg { padding: var(--w-s-6); }
  }

  /* Celebratory is a composition change, not an effect: a single soft wash
     of the module tint off the top-right corner. It resolves to an opaque
     surface colour rather than `transparent` so no engine greys the fade. */
  .w-card--celebratory {
    background-image: radial-gradient(
      118% 88% at 86% -12%,
      var(--w-tint) 0%,
      var(--w-surface) 62%
    );
    border-color: var(--w-hairline-strong);
  }

  /* The lift shadow lives here, inert, at zero opacity. */
  .w-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--w-shadow-lift);
    opacity: 0;
    pointer-events: none;
  }

  /* Tier B. Only ever on an interactive card, only on real pointers —
     a touch device would otherwise keep the hover state stuck after a tap. */
  @media (hover: hover) and (pointer: fine) {
    .w-card--lift {
      transition: transform var(--w-dur-quiet) var(--w-ease-quiet);
    }
    .w-card--lift::after {
      transition: opacity var(--w-dur-quiet) var(--w-ease-quiet);
    }
    .w-card--lift:hover {
      transform: translateY(-2px);
    }
    .w-card--lift:hover::after {
      opacity: 1;
    }
  }

  .w-card--lift:active {
    transform: translateY(0);
  }

  .w-card.w-focusable:focus-visible {
    outline: 2px solid var(--w-focus);
    outline-offset: 3px;
    border-radius: var(--w-r-card);
  }

  /* Reduced motion keeps the affordance and drops the movement. The lift
     shadow still appears on hover, it just arrives instantly — the card is
     still legibly interactive, it simply never travels. */
  @media (prefers-reduced-motion: reduce) {
    .w-card,
    .w-card::after {
      transition: none;
    }
    .w-card--lift:hover {
      transform: none;
      border-color: var(--w-hairline-strong);
    }
    .w-card--lift:hover::after {
      opacity: 1;
    }
  }
</style>
