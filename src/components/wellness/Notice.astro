---
/**
 * Wellness / Notice
 *
 * Calm information. Three kinds: info, guidance, and urgent.
 *
 * Design decision — "urgent" is the quietest thing in this file. The person
 * reading it is already frightened; the design's job is to be legible, not
 * to add volume. So urgent gets no alarm red, no filled red block, no
 * uppercase, no exclamation mark, and no heavier weight than the other two.
 * It is distinguished by a solid clay rule down its edge and a flag mark —
 * the visual language of "this has been flagged for attention", not "sound
 * the siren". It also deliberately avoids role="alert", which would hijack
 * a screen reader mid-sentence; it is a note, and it waits to be read.
 * Tier C throughout: this component has no transitions and no animations.
 *
 * Measured contrast, urgent (the tightest of the three):
 *   light  body ink #1A1917 on #F9EDE9 = 15.32:1 (AAA)
 *          title    #8A3A24 on #F9EDE9 =  6.76:1 (AA)
 *   dark   body ink #F3EEE9 on #251A16 = 14.72:1 (AAA)
 *          title    #E9A489 on #251A16 =  8.19:1 (AAA)
 */
import './tokens.css';

export interface Props {
  kind?: 'info' | 'guidance' | 'urgent';
  title?: string;
  class?: string;
}

const { kind = 'info', title, class: cls = '', ...rest } = Astro.props;

// Drawn for this set, in one line weight, with round caps. No icon library.
const MARKS = {
  // a quiet circular note mark
  info: '<circle cx="10" cy="10" r="7.4" /><path d="M10 9.3v4.3" /><path d="M10 6.5v.9" />',
  // a sprig: something growing, for advice you can act on
  guidance:
    '<path d="M14.6 5.4c.7 4.4-1.9 7.9-6.3 8.4-.7-4.4 1.9-7.9 6.3-8.4Z" /><path d="M5.4 15.4c1.7-2 3.4-3.7 5.1-5" />',
  // a flag: this has been marked for attention, factually
  urgent: '<path d="M6 4.4v11.2" /><path d="M6 5.6h8.4l-1.8 2.7 1.8 2.7H6Z" />',
};

const mark = MARKS[kind];
const titleId = title ? `w-notice-${Math.random().toString(36).slice(2, 9)}` : undefined;
---

<aside
  class:list={['w-notice', cls]}
  data-kind={kind}
  role="note"
  aria-labelledby={titleId}
  {...rest}
>
  <svg
    class="w-notice__mark"
    viewBox="0 0 20 20"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={mark}
  />

  <div class="w-notice__text">
    {title && <p class="w-notice__title" id={titleId}>{title}</p>}
    <div class="w-notice__body"><slot /></div>
  </div>
</aside>

<style>
  .w-notice {
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: var(--w-s-3);
    max-width: 100%;
    min-width: 0;
    padding: var(--w-s-3) var(--w-s-4);
    background-color: var(--w-notice-bg);
    border-radius: var(--w-r-md);
    border-inline-start: 3px solid var(--w-notice-mark);
    font-family: var(--w-font-body);
    color: var(--w-ink);
  }

  .w-notice[data-kind='info'] {
    --w-notice-bg: var(--w-notice-info-bg);
    --w-notice-mark: var(--w-notice-info-mark);
  }
  .w-notice[data-kind='guidance'] {
    --w-notice-bg: var(--w-notice-guidance-bg);
    --w-notice-mark: var(--w-notice-guidance-mark);
  }
  .w-notice[data-kind='urgent'] {
    --w-notice-bg: var(--w-notice-urgent-bg);
    --w-notice-mark: var(--w-notice-urgent-mark);
  }

  .w-notice__mark {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--w-notice-mark);
  }

  .w-notice__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Same weight and size for all three kinds. Urgency is carried by the
     rule and the words, never by shouting. */
  .w-notice__title {
    margin: 0 0 var(--w-s-1);
    font-size: var(--w-t-body);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--w-notice-mark);
  }

  /* Body copy sits on ink, not on the accent: AAA in both themes. */
  .w-notice__body {
    font-size: var(--w-t-body);
    line-height: 1.6;
    color: var(--w-ink);
    overflow-wrap: anywhere;
  }

  .w-notice__body :global(p) {
    margin: 0 0 var(--w-s-2);
  }
  .w-notice__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .w-notice__body :global(a) {
    color: var(--w-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .w-notice__body :global(a:focus-visible) {
    outline: 2px solid var(--w-focus);
    outline-offset: 2px;
    border-radius: var(--w-r-sm);
  }

  /* No motion block. A Notice never moves, in any preference state. */
</style>
