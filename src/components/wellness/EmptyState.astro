---
/**
 * Wellness / EmptyState
 *
 * An illustration, one warm line, and one clear action. Nothing else.
 *
 * Design decision — the illustrations are drawn for this set rather than
 * pulled from a library, and they are all drawn from the same two parts: a
 * soft wash of the module tint, and one continuous accent line at a single
 * weight. That constraint is what makes seven different pictures read as
 * one family, and it means an empty screen looks composed rather than
 * broken. Empty is a normal state here — the first day of a cycle log, a
 * new pregnancy, a night with no sleep data — so nothing in this component
 * apologises, and nothing animates.
 */
import './tokens.css';

export interface Props {
  module?:
    | 'cycle' | 'pregnancy' | 'mental' | 'nutrition'
    | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'neutral';
  /** Overrides the drawing chosen for the module. */
  illustration?: 'sprout' | 'moon' | 'droplet' | 'bloom' | 'path' | 'note' | 'cup';
  title: string;
  body?: string;
  actionLabel?: string;
  actionHref?: string;
  /** 2, 3 or 4. Pick what fits the page outline. */
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

const {
  module = 'neutral',
  illustration,
  title,
  body,
  actionLabel,
  actionHref,
  headingLevel = 3,
  class: cls = '',
  ...rest
} = Astro.props;

// Two parts only: a wash shape and a line drawing, in a 120x96 field.
const ART = {
  sprout:
    '<circle class="wash" cx="60" cy="46" r="27" />' +
    '<path class="line" d="M26 72q34 12 68 0" />' +
    '<path class="line" d="M60 72V46" />' +
    '<path class="line" d="M60 56c-9.5-.4-16.6-6.6-18-15.6 9.4-1 17 5.1 18 15.6Z" />' +
    '<path class="line" d="M60 50c9.5-.4 16.6-6.6 18-15.6-9.4-1-17 5.1-18 15.6Z" />',

  moon:
    '<circle class="wash" cx="60" cy="44" r="27" />' +
    '<path class="line" d="M68 26a20 20 0 1 0 0 38 22 22 0 0 1 0-38Z" />' +
    '<path class="line" d="M22 78h76" />' +
    '<circle class="dot" cx="34" cy="30" r="2" />' +
    '<circle class="dot" cx="92" cy="22" r="1.6" />',

  droplet:
    '<circle class="wash" cx="60" cy="44" r="26" />' +
    '<path class="line" d="M60 22s-16 19.8-16 30a16 16 0 0 0 32 0c0-10.2-16-30-16-30Z" />' +
    '<path class="line" d="M32 76q28 10 56 0" />' +
    '<path class="line" d="M42 84q18 6 36 0" />',

  bloom:
    '<circle class="wash" cx="60" cy="46" r="28" />' +
    '<ellipse class="line" cx="60" cy="32" rx="8.5" ry="14" />' +
    '<ellipse class="line" cx="60" cy="32" rx="8.5" ry="14" transform="rotate(72 60 46)" />' +
    '<ellipse class="line" cx="60" cy="32" rx="8.5" ry="14" transform="rotate(144 60 46)" />' +
    '<ellipse class="line" cx="60" cy="32" rx="8.5" ry="14" transform="rotate(216 60 46)" />' +
    '<ellipse class="line" cx="60" cy="32" rx="8.5" ry="14" transform="rotate(288 60 46)" />' +
    '<circle class="dot" cx="60" cy="46" r="3.4" />',

  path:
    '<circle class="wash" cx="58" cy="48" r="28" />' +
    '<path class="line" d="M22 78c18 0 18-20 36-20s18-22 40-30" />' +
    '<circle class="line" cx="98" cy="28" r="8" />' +
    '<circle class="dot" cx="98" cy="28" r="3.2" />' +
    '<circle class="dot" cx="22" cy="78" r="3" />',

  note:
    '<rect class="wash" x="26" y="28" width="56" height="54" rx="14" />' +
    '<rect class="line" x="38" y="16" width="56" height="54" rx="14" />' +
    '<path class="line" d="M50 34h32" />' +
    '<path class="line" d="M50 44h32" />' +
    '<path class="line" d="M50 54h20" />',

  cup:
    '<circle class="wash" cx="60" cy="46" r="26" />' +
    '<path class="line" d="M38 34h38v18a19 19 0 0 1-38 0Z" />' +
    '<path class="line" d="M76 38h6a8 8 0 0 1 0 16h-2" />' +
    '<path class="line" d="M30 78h60" />',
};

const DEFAULT_ART = {
  cycle: 'bloom',
  pregnancy: 'sprout',
  mental: 'path',
  nutrition: 'cup',
  sleep: 'moon',
  hydration: 'droplet',
  fitness: 'path',
  therapy: 'note',
  neutral: 'sprout',
};

const artName = illustration || DEFAULT_ART[module] || 'sprout';
const art = ART[artName as keyof typeof ART] || ART.sprout;

const Heading = `h${headingLevel}`;
const hasAction = typeof actionHref === 'string' && actionHref.length > 0 && Boolean(actionLabel);
const hasActionSlot = Astro.slots.has('action');
---

<div class:list={['w-empty', cls]} data-w-module={module} {...rest}>
  <svg
    class="w-empty__art"
    viewBox="0 0 120 96"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={art}
  />

  <Heading class="w-empty__title">{title}</Heading>

  {body && <p class="w-empty__body">{body}</p>}

  {hasAction && (
    <a class="w-empty__action w-focusable" href={actionHref}>{actionLabel}</a>
  )}

  {!hasAction && hasActionSlot && (
    <div class="w-empty__slot"><slot name="action" /></div>
  )}
</div>

<style>
  .w-empty {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    min-width: 0;
    padding: var(--w-s-5) var(--w-s-4);
    text-align: center;
    font-family: var(--w-font-body);
    color: var(--w-ink);
  }

  .w-empty__art {
    display: block;
    width: min(100%, 168px);
    height: auto;
    margin-bottom: var(--w-s-4);
    color: var(--w-accent);
  }

  /* set:html content is injected without Astro's scope class, so the parts
     of the drawing are reached with :global() from the scoped parent. */
  .w-empty__art :global(.wash) {
    fill: var(--w-tint);
    stroke: none;
  }
  .w-empty__art :global(.line) {
    fill: none;
    stroke: currentColor;
  }
  .w-empty__art :global(.dot) {
    fill: currentColor;
    stroke: none;
  }

  /* The one place the serif appears. An empty screen is the most human
     moment in the product, so it gets the warmest voice in the system. */
  .w-empty__title {
    margin: 0;
    font-family: var(--w-font-display);
    font-size: clamp(1.25rem, 5.5vw, 1.5rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.005em;
    color: var(--w-ink);
    text-wrap: balance;
  }

  .w-empty__body {
    margin: var(--w-s-2) 0 0;
    max-width: 34ch;
    font-size: var(--w-t-body);
    line-height: 1.6;
    color: var(--w-ink-2);
    text-wrap: pretty;
  }

  .w-empty__action,
  .w-empty__slot {
    margin-top: var(--w-s-4);
  }

  .w-empty__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--w-s-2) var(--w-s-5);
    border-radius: var(--w-r-pill);
    background-color: var(--w-accent);
    color: var(--w-on-accent);
    font-size: var(--w-t-body);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .w-empty__action:focus-visible {
    outline: 2px solid var(--w-focus);
    outline-offset: 3px;
    border-radius: var(--w-r-pill);
  }

  /* --- Tier B, and only on a real pointer. --- */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .w-empty__action {
      transition: transform var(--w-dur-quiet) var(--w-ease-quiet);
    }
    .w-empty__action:hover {
      transform: translateY(-1px);
    }
  }

  .w-empty__action:active {
    transform: translateY(0);
  }
</style>
