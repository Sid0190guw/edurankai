---
/**
 * Wellness / Metric
 *
 * One health number, read at a glance: label, value, unit, optional trend.
 * Tier C — this component has no transitions and no animations anywhere.
 * It is the thing a worried person is actually trying to read.
 *
 * Design decision — a trend direction is NOT a verdict. In a health context
 * "up" is not good news and "down" is not bad news; heavier bleeding is up,
 * so is a longer night's sleep. So direction and sentiment are separate
 * props, and sentiment defaults to neutral ink. Colour only ever appears
 * when a caller explicitly says what the change means, and even then the
 * arrow's SHAPE and a text label carry the same information, so nothing is
 * conveyed by colour alone.
 */
import './tokens.css';

export interface Props {
  value: string | number;
  unit?: string;
  label: string;
  trend?: 'up' | 'down' | 'steady';
  /** Words for the trend. Falls back to a plain reading of the direction. */
  trendLabel?: string;
  /** Only pass this when the direction genuinely means something. */
  sentiment?: 'neutral' | 'positive' | 'caution';
  module?:
    | 'cycle' | 'pregnancy' | 'mental' | 'nutrition'
    | 'sleep' | 'hydration' | 'fitness' | 'therapy' | 'neutral';
  size?: 'sm' | 'md' | 'lg';
  /** A short calm note under the number. */
  hint?: string;
  class?: string;
}

const {
  value,
  unit,
  label,
  trend,
  trendLabel,
  sentiment = 'neutral',
  module,
  size = 'md',
  hint,
  class: cls = '',
  ...rest
} = Astro.props;

// Shapes, not just colours. Each silhouette is distinct at 12px:
// a solid triangle pointing up, a solid triangle pointing down, and two
// stacked bars for no change.
const TREND_SHAPES = {
  up: '<path d="M6 2.4 10.2 9.6H1.8Z" fill="currentColor" />',
  down: '<path d="M6 9.6 1.8 2.4h8.4Z" fill="currentColor" />',
  steady:
    '<path d="M2 4.5h8M2 7.5h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />',
};
const TREND_WORDS = {
  up: 'higher than the last reading',
  down: 'lower than the last reading',
  steady: 'unchanged from the last reading',
};

const shape = trend ? TREND_SHAPES[trend] : '';
const spoken = trend ? (trendLabel || TREND_WORDS[trend]) : '';
---

<div
  class:list={['w-metric', `w-metric--${size}`, cls]}
  data-w-module={module}
  {...rest}
>
  <p class="w-metric__label">{label}</p>

  <p class="w-metric__row">
    <span class="w-metric__value">{value}</span>
    {unit && <span class="w-metric__unit">{unit}</span>}

    {trend && (
      <span class="w-metric__trend" data-dir={trend} data-sentiment={sentiment}>
        <svg
          class="w-metric__arrow"
          viewBox="0 0 12 12"
          width="11"
          height="11"
          fill="none"
          aria-hidden="true"
          set:html={shape}
        />
        <span class={trendLabel ? 'w-metric__trendtext' : 'w-sr-only'}>{spoken}</span>
      </span>
    )}
  </p>

  {hint && <p class="w-metric__hint">{hint}</p>}
</div>

<style>
  .w-metric {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    font-family: var(--w-font-body);
    color: var(--w-ink);
  }

  /* Meta label above the number: it is scanned, not read.
     #635C55 on #FFFCFA is 6.44:1, comfortably past AA for UI text. */
  .w-metric__label {
    margin: 0 0 var(--w-s-2);
    font-size: var(--w-t-meta);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--w-ink-3);
  }

  .w-metric__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--w-s-2);
    margin: 0;
    min-width: 0;
  }

  /* Tabular figures so a number changing from 9 to 10 does not shift the
     unit sideways, and so a column of values lines up on the decimal. */
  .w-metric__value {
    font-family: var(--w-font-num);
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--w-ink);
  }

  .w-metric--sm .w-metric__value { font-size: 1.375rem; }
  .w-metric--md .w-metric__value { font-size: clamp(1.75rem, 7vw, 2.25rem); }
  .w-metric--lg .w-metric__value { font-size: clamp(2.25rem, 10vw, 3rem); }

  .w-metric__unit {
    font-size: var(--w-t-body);
    font-weight: 500;
    color: var(--w-ink-2);
    line-height: 1;
  }

  .w-metric__trend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-inline-start: var(--w-s-1);
    padding: 3px var(--w-s-2);
    border-radius: var(--w-r-pill);
    background-color: var(--w-surface-sunk);
    font-size: var(--w-t-meta);
    font-weight: 500;
    line-height: 1.2;
    color: var(--w-ink-2);
  }

  .w-metric__arrow { flex: 0 0 auto; }

  /* Sentiment is opt-in. Neutral inherits ink and stays quiet. */
  .w-metric__trend[data-sentiment='positive'] { color: var(--w-positive); }
  .w-metric__trend[data-sentiment='caution'] { color: var(--w-caution); }

  .w-metric__trendtext {
    white-space: nowrap;
  }

  .w-metric__hint {
    margin: var(--w-s-2) 0 0;
    font-size: var(--w-t-meta);
    line-height: 1.5;
    color: var(--w-ink-2);
  }

  /* No motion block is needed. There is no motion here, by design. */
</style>
