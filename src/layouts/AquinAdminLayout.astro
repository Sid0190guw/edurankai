---
// AquinTutor's own admin shell — its nav, its identity, its chrome.
//
// =================================================================================================
// WHY A SECOND LAYOUT AND NOT AdminLayout
// =================================================================================================
//
// AquinTutor is becoming its own product on its own domain. AdminLayout is EduRankAI's: it renders
// EduRankAI's 162-entry sidebar, reads EduRankAI's user, and links to EduRankAI's screens. An
// AquinTutor administrator who is not an EduRankAI employee has no business seeing Payroll, HR
// Separations or the Offer Templates in the menu, and would not be able to open them anyway.
//
// So this is the AquinTutor shell. It gates on the AquinTutor principal, shows AquinTutor's own nav,
// and names whose account you are signed in as — because during the transition a person may hold
// both, and the single most confusing thing a screen could do is leave that ambiguous.
//
// A NEW FILE, not an edit to an existing layout. Nothing that renders today changes.
import { requireAquinAdmin } from '@/lib/aquin/gate';
import { withDbRetry, isDbUnavailable } from '@/lib/db-timeout';
import { isAquinSuperAdmin } from '@/lib/aquin/identity';

interface Props {
  title: string;
  /** Which nav entry to mark current. */
  active?: string;
  /** Set when only a super admin may open the page. */
  superAdminOnly?: boolean;
  /**
   * The exact roles that may open this page, when "any administrator" is too wide.
   *
   * THIS PROP EXISTS BECAUSE A PORT WIDENED ACCESS WITHOUT ANYBODY DECIDING TO. Moving these pages
   * onto this layout replaced each page's own gate with the layout's, and the layout's default is
   * "any admin-surface role". Two pages had been narrower on purpose:
   *
   *   analytics   super_admin only. Named learners with their email addresses, and CSV exports.
   *   moderator   admins and moderators only. Its own comment recorded the narrowing as deliberate:
   *               "partner, teacher, applicant ... lose this page ... no reason to hold a
   *               stranger's passport image."
   *
   * Both were re-opened to every teacher and partner on the platform, as a side effect of changing
   * which product the page belonged to. A port may narrow by accident and somebody will complain; it
   * must never widen by accident, because nobody will.
   *
   * So a page states who it admits rather than inheriting a default that cannot know.
   */
  roles?: readonly string[];
}
const { title, active = '', superAdminOnly = false, roles: allowedRoles } = Astro.props;

// BOUNDED, BECAUSE THE DEGRADED ANSWER THIS PANEL ALREADY HAS WAS UNREACHABLE.
//
// src/lib/aquin/gate.ts:74 already returns an honest gate for `principal.degraded` — "Your
// AquinTutor sign-in could not be checked just now. Nothing is wrong with your account." That
// branch is exactly right and it could not be reached, because the await above it had no bound at
// all: postgres-js has no query timeout, so when a connection stalls the promise never settles and
// the platform kills the invocation. Every page in this panel answered with a gateway timeout
// instead of the sentence someone had already written for the occasion.
//
// withDbRetry rather than withDbTimeout, and for the same reason src/middleware.ts uses it at its
// own five gates: what fails on this deployment is OPENING a connection, so asking a second time
// gets an answer where waiting longer does not.
//
// FAILS CLOSED. A timeout produces a degraded gate — not a redirect to the login, which would sign
// an administrator out over a five-second blip, and not an open door.
let gate: Awaited<ReturnType<typeof requireAquinAdmin>>;
let gateUnreadable = false;
try {
  gate = superAdminOnly
    ? await withDbRetry(() => (import('@/lib/aquin/gate')).then((m) => m.requireAquinSuperAdmin(Astro as any)), 'aquinAdmin.gate.super')
    : await withDbRetry(() => requireAquinAdmin(Astro as any), 'aquinAdmin.gate');
} catch (e: any) {
  if (!isDbUnavailable(e)) throw e;
  console.error('[AquinAdminLayout] access could not be checked -', e?.cause?.message || e?.message);
  gateUnreadable = true;
  // Shaped like a denial so everything below reads it unchanged. principal is the empty one, so the
  // header renders "Not signed in" rather than inventing an identity we could not verify.
  gate = { ok: false, principal: { userId: null, email: null, name: null, roles: [] } as any, redirect: null, message: null } as any;
}
// The gate's own degraded answer, which means the same thing arrived by a different route: the
// principal resolved to "could not be checked" rather than to a person. Both render the same panel.
if (!gateUnreadable && !gate.ok && !gate.redirect && (gate.principal as any)?.degraded) gateUnreadable = true;

// A LAYOUT CANNOT REDIRECT, AND TRYING TO TOOK EVERY PAGE IN THIS PANEL DOWN.
//
// This line read `return Astro.redirect(gate.redirect)`. Only a PAGE may return a Response in
// Astro; returning one from a component throws — so instead of being sent to the AquinTutor login,
// a signed-out visitor got `HTTP 200: Internal server error`, on Overview, People, Courses,
// Teaching, Partners, Moderation, Analytics, Payouts and Mind alike. Verified live before changing
// anything: every one of them, while /aquintutor/admin/login itself rendered perfectly.
//
// Worse than a broken page, it was a broken page with no explanation. An administrator whose
// session had simply expired saw a server error and had no way to learn that signing in again was
// the whole fix.
//
// So the target is RENDERED rather than returned. The panel below offers the link, and the status
// is set honestly to 401 so this is never cached or indexed as though it were the page itself.
let signInHref: string | null = null;
if (gate.redirect) {
  signInHref = gate.redirect;
  // NO Astro.response.status HERE, AND THAT IS THE POINT.
  //
  // The first version of this fix set status 401 and a no-store header on this line. Neither
  // applied: Astro streams the response, so by the time a LAYOUT renders, the status line and
  // headers have already gone out. The live page answered 200 with `Cache-Control: public` while
  // the code plainly said otherwise — which is the same shape as the bug being fixed, a component
  // trying to control a response it does not own.
  //
  // Caching and indexing for this whole panel are set at the edge instead, in vercel.json, where
  // /aquintutor/admin/(.*) now carries the same no-store and noindex headers /admin/(.*) has always
  // had. That works because it never depends on when a component happened to render.
}

// Narrower than "any administrator", when the page says so. Applied AFTER the gate above, so an
// unauthenticated caller still gets the login redirect rather than this refusal.
let narrowed = gate;
if (gate.ok && allowedRoles && allowedRoles.length) {
  const held = gate.principal.roles.some((r) => allowedRoles.includes(r));
  if (!held) {
    narrowed = {
      ...gate,
      ok: false,
      message: 'This page is open to ' + allowedRoles.join(', ')
        + '. Your AquinTutor roles are ' + (gate.principal.roles.join(', ') || 'none')
        + '. An AquinTutor super admin can change that.',
    };
  }
}

const p = gate.principal;
const superAdmin = isAquinSuperAdmin(p);

// The nav. Short on purpose: an admin menu nobody can hold in their head is one where things get
// lost, which is how this product ended up with fifty pages nobody could reach.
const NAV: { href: string; label: string; sup?: boolean }[] = [
  // The independent overview. /aquintutor/admin (the old Command Center) still gates on an
  // EduRankAI session and is the next port; pointing Overview at it would send somebody straight
  // from this panel to a different product's login.
  { href: '/aquintutor/admin/console', label: 'Overview' },
  { href: '/aquintutor/admin/people', label: 'People & roles', sup: true },
  { href: '/aquintutor/admin/courses', label: 'Courses' },
  { href: '/aquintutor/admin/teacher', label: 'Teaching' },
  { href: '/aquintutor/admin/partner', label: 'Partners' },
  { href: '/aquintutor/admin/moderator', label: 'Moderation' },
  { href: '/aquintutor/admin/analytics', label: 'Analytics' },
  { href: '/aquintutor/admin/payouts', label: 'Payouts' },
];
const visible = NAV.filter((n) => !n.sup || superAdmin);
---

<html lang="en" data-surface="editorial">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · AquinTutor</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="stylesheet" href="/era/era-tokens.css" />
  <style>
    :root { --ink:#0E0B08; --paper:#FBFAF4; --rust:#a8472c; --mute:#6f665e; --line:rgba(14,11,8,0.12); }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--paper); color:var(--ink);
           font-family:'Inter Tight',Inter,system-ui,-apple-system,sans-serif; }
    a { color:var(--rust); }
    .aq-top { display:flex; align-items:center; gap:16px; flex-wrap:wrap;
              padding:12px 20px; border-bottom:1px solid var(--line); background:#fff; }
    .aq-brand { font-weight:800; font-size:16px; letter-spacing:-0.01em; text-decoration:none; color:var(--ink); }
    .aq-brand span { color:var(--rust); }
    .aq-who { margin-left:auto; display:flex; align-items:center; gap:10px; font-size:12px; color:var(--mute); }
    .aq-chip { border:1px solid var(--line); border-radius:100px; padding:3px 10px; font-size:11px;
               font-family:'Geist Mono',ui-monospace,monospace; }
    .aq-chip.sup { border-color:rgba(168,71,44,0.5); color:var(--rust); }
    .aq-nav { display:flex; gap:2px; overflow-x:auto; padding:0 12px; border-bottom:1px solid var(--line);
              background:#fff; -webkit-overflow-scrolling:touch; }
    .aq-nav a { display:block; padding:11px 14px; font-size:13.5px; text-decoration:none; color:var(--mute);
                white-space:nowrap; border-bottom:2px solid transparent; min-height:44px; }
    .aq-nav a.on { color:var(--ink); border-bottom-color:var(--rust); font-weight:650; }
    main { padding:22px 20px 64px; max-width:1120px; margin:0 auto; }
    .aq-deny { max-width:560px; margin:64px auto; padding:22px 24px; background:#fff;
               border:1px solid rgba(180,60,40,0.35); border-radius:14px; }
    /* MOBILE FIRST: 360px, 44px targets. Most of this product is opened on a phone. */
    @media (max-width: 520px) {
      .aq-who { width:100%; margin-left:0; }
      main { padding:16px 14px 56px; }
    }
  </style>
</head>
<body>
  <header class="aq-top">
    <a class="aq-brand" href="/aquintutor/admin/console">Aquin<span>Tutor</span> administration</a>
    <div class="aq-who">
      {p.userId ? (
        <>
          <span>{p.name || p.email}</span>
          <span class={'aq-chip' + (superAdmin ? ' sup' : '')}>{superAdmin ? 'super admin' : p.roles.join(' · ') || 'no role'}</span>
          <!-- Says WHICH account. During the transition a person may hold an EduRankAI one as well,
               and a screen that leaves that ambiguous is the most confusing thing here. -->
          <span class="aq-chip">AquinTutor account</span>
          <a href="/aquintutor/admin/logout">Sign out</a>
        </>
      ) : <span>Not signed in</span>}
    </div>
  </header>

  {gateUnreadable ? (
    <div class="aq-deny" style="border-color:rgba(14,11,8,0.18);">
      <p style="margin:0 0 8px;font-weight:700;font-size:15px;">Your access could not be checked just now</p>
      <p style="margin:0;font-size:13.5px;color:var(--mute);line-height:1.65;">
        The database did not answer, so nothing is being shown rather than something wrong. This is a
        problem on our side and not a problem with your account or your roles - you have not been
        signed out.
      </p>
      <p style="margin:16px 0 0;">
        <a href="" style="display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:10px;background:var(--rust);color:#fff;text-decoration:none;font-weight:650;font-size:15px;">Try again</a>
      </p>
    </div>
  ) : signInHref ? (
    <div class="aq-deny" style="border-color:rgba(14,11,8,0.18);">
      <p style="margin:0 0 8px;font-weight:700;font-size:15px;">Sign in to AquinTutor administration</p>
      <p style="margin:0;font-size:13.5px;color:var(--mute);line-height:1.65;">
        This is AquinTutor's own administration, with its own accounts. An EduRankAI sign-in does not
        reach it, and a session here expires like any other.
      </p>
      <p style="margin:16px 0 0;">
        <a href={signInHref} style="display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:10px;background:var(--rust);color:#fff;text-decoration:none;font-weight:650;font-size:15px;">Sign in</a>
      </p>
    </div>
  ) : narrowed.ok ? (
    <>
      <nav class="aq-nav">
        {visible.map((n) => (
          <a href={n.href} class={active === n.href ? 'on' : ''}>{n.label}</a>
        ))}
      </nav>
      <main><slot /></main>
    </>
  ) : (
    <div class="aq-deny">
      <p style="margin:0 0 8px;font-weight:700;font-size:15px;color:#a04330;">Not available to this account</p>
      <p style="margin:0;font-size:13.5px;color:var(--mute);line-height:1.65;">{narrowed.message}</p>
      <p style="margin:14px 0 0;font-size:13px;">
        <a href="/aquintutor/admin/login">Sign in with a different AquinTutor account</a>
      </p>
    </div>
  )}
</body>
</html>
