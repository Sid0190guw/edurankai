---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { getProgram, deliveryBreakdown, modelByN } from '@/lib/aquin-programs';

const { slug } = Astro.params;
const program = slug ? await getProgram(slug) : null;
if (!program) return Astro.redirect('/aquintutor/programs');

const model = modelByN(program.deliveryModel);
const b = deliveryBreakdown(program);

const rows = [
  { label: 'Digital academics', body: b.digital, glyph: 'M4 5h16M4 12h16M4 19h10' },
  { label: 'Practical training', body: b.practical, glyph: 'M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z' },
  { label: 'Immersive technology', body: b.immersive, glyph: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z M12 9a3 3 0 100 6 3 3 0 000-6z' },
  { label: 'Assessment', body: b.assessment, glyph: 'M9 11l3 3L22 4 M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11' },
];
---
<AquintutorLayout title={program.name} description={`${program.name} at AquinTutor — ${b.digital}`}>
  <section style="max-width:900px;margin:0 auto;padding:36px 20px 72px;">

    <a href="/aquintutor/programs" style="font-size:12.5px;color:#6b6b6b;text-decoration:none;font-family:'Geist Mono',monospace;">&larr; All programs</a>

    <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0 6px;">
      <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:3px 9px;border-radius:100px;color:#FF4F00;background:#FF4F0018;">{program.level}</span>
      <span style="font-size:12px;color:#6b6b6b;font-family:'Geist Mono',monospace;">Delivery model {model.n} &middot; {model.title}</span>
    </div>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(26px,4vw,38px);font-weight:600;line-height:1.1;margin:0 0 6px;color:#141414;">{program.name}</h1>
    <p style="font-size:15px;color:#3a3a3a;margin:0 0 4px;">{program.discipline}</p>

    <div style="display:flex;gap:20px;flex-wrap:wrap;margin:20px 0 8px;padding:16px 20px;background:#f7f6f2;border-radius:14px;">
      <div><div style="font-family:'Fraunces',serif;font-size:28px;font-weight:600;color:#128a3f;line-height:1;">{program.virtualPct}%</div><div style="font-size:11px;color:#6b6b6b;text-transform:uppercase;letter-spacing:0.06em;margin-top:3px;">delivered online</div></div>
      <div style="flex:1;min-width:220px;"><div style="font-size:11px;color:#6b6b6b;text-transform:uppercase;letter-spacing:0.06em;">Practical partner</div><div style="font-size:14px;color:#141414;font-weight:500;margin-top:3px;">{model.partnerType}</div></div>
    </div>

    {program.regulated && (
      <div style="border-left:4px solid #8a5a00;background:#fdf8ef;border-radius:0 12px 12px 0;padding:14px 18px;margin:14px 0;">
        <p style="font-size:13.5px;color:#5a4a20;margin:0;line-height:1.6;"><strong>Regulated qualification.</strong> {program.regulatoryNote}</p>
      </div>
    )}

    <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:30px 0 14px;color:#141414;">How this program is delivered</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;">
      {rows.map((r) => (
        <div style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:15px 16px;background:#fff;">
          <div style="display:flex;align-items:center;gap:9px;margin-bottom:7px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#FF4F00" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={r.glyph}/></svg>
            <h3 style="font-size:14px;font-weight:700;margin:0;color:#141414;">{r.label}</h3>
          </div>
          <p style="font-size:13px;color:#4a4a4a;margin:0;line-height:1.6;">{r.body}</p>
        </div>
      ))}
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;">
      <a href="/aquintutor/courses" style="background:#141414;color:#fff;text-decoration:none;font-size:13px;font-weight:600;padding:10px 18px;border-radius:10px;">Browse courses</a>
      <a href="/aquintutor/labs" style="background:#fff;color:#141414;text-decoration:none;font-size:13px;font-weight:600;padding:10px 18px;border-radius:10px;border:1px solid rgba(0,0,0,0.15);">Virtual labs</a>
      <a href="/aquintutor/partners" style="background:#fff;color:#141414;text-decoration:none;font-size:13px;font-weight:600;padding:10px 18px;border-radius:10px;border:1px solid rgba(0,0,0,0.15);">Practical partners</a>
      <a href="/aquintutor/competencies" style="background:#fff;color:#141414;text-decoration:none;font-size:13px;font-weight:600;padding:10px 18px;border-radius:10px;border:1px solid rgba(0,0,0,0.15);">Competency framework</a>
    </div>

  </section>
</AquintutorLayout>
