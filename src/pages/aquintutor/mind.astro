---
// /aquintutor/mind — what the platform has learned about how THIS learner learns, shown to them.
//
// The learner-facing half of src/lib/mind. It is deliberately the same numbers the system uses
// itself: the mastery estimate it holds, the probability it would give them on the next question in
// each concept, and the inputs that moved that probability. If a system is going to shape what a
// person is asked next, the person is entitled to read it.
//
// Nobody else's data is reachable here. The identity comes from the session; there is no learner
// parameter to change.
//
// Server-rendered, no client-side JavaScript.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { learnerSnapshot } from '@/lib/mind/serve';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/mind'));

let snapshot = { attempts: 0, correct: 0, concepts: [] as any[], modelVersion: null as number | null, source: 'baseline' as 'model' | 'baseline', explain: [] as any[] };
let failed = false;
try { snapshot = await learnerSnapshot(user.id) as any; }
catch (e: any) { failed = true; console.error('[aquintutor/mind] snapshot failed:', e?.cause?.message || e?.message); }

const pct = (x: number) => Math.round(x * 100) + '%';
const accuracy = snapshot.attempts ? snapshot.correct / snapshot.attempts : 0;
const band = (p: number) => (p >= 0.87 ? 'Revision' : p >= 0.55 ? 'Where you learn most' : 'A stretch');
const bandColour = (p: number) => (p >= 0.87 ? '#1A6B35' : p >= 0.55 ? '#a8472c' : '#8a5a10');
const next = snapshot.concepts.find((c: any) => c.predicted >= 0.5 && c.predicted < 0.87) || snapshot.concepts[0] || null;

const CARD = 'background:var(--paper,#FBFAF4);border:1px solid var(--rule,rgba(14,11,8,0.12));border-radius:16px;padding:24px;margin-bottom:18px;';
const EYE = "font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--rust,#a8472c);font-weight:700;margin:0;";
const TH = "text-align:left;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-500,#6f665e);font-weight:700;padding:10px 12px;border-bottom:1px solid var(--rule,rgba(14,11,8,0.12));";
const TD = 'padding:11px 12px;border-bottom:1px solid var(--rule,rgba(14,11,8,0.08));font-size:13.5px;';
---

<AquintutorLayout title="How you learn" description="What AquinTutor has learned about how you learn, and what it does with it." noindex={true}>
  <main id="main-content" style="max-width:940px;margin:0 auto;padding:36px 22px 72px;">
    <p style={EYE}>AquinTutor &middot; your learning</p>
    <h1 class="font-display" style="font-family:'Fraunces',serif;font-size:clamp(1.9rem,4vw,2.6rem);font-weight:500;letter-spacing:-0.02em;margin:8px 0 12px;">
      What the platform has learned about <em style="font-style:italic;color:var(--rust,#a8472c);">how you learn</em>
    </h1>
    <p style="font-size:15px;line-height:1.7;color:var(--ink-500,#4a443e);max-width:66ch;margin:0 0 26px;">
      Every question you answer teaches AquinTutor something about the shape of your learning, not
      just your score. These are the actual numbers it holds — the same ones it uses to decide what
      to put in front of you next. They advise; they never grade you and never decide anything about
      your standing.
    </p>

    {failed && (
      <div style={CARD + 'border-color:rgba(180,60,40,0.35);'}>
        <p style="margin:0;font-size:14px;line-height:1.65;color:#a04330;">
          Your learning record could not be read just now. Nothing has been lost — try again in a moment.
        </p>
      </div>
    )}

    {!failed && snapshot.attempts === 0 && (
      <div style={CARD}>
        <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:var(--ink-500,#4a443e);">
          Nothing recorded yet. This page fills in as you practise: answer a few questions and it
          will show you the mastery estimate for each concept, how likely you are to get the next
          question right, and which inputs moved that estimate.
        </p>
        <a href="/aquintutor/practice" style="display:inline-block;background:var(--ink,#0E0B08);color:var(--sand-50,#FBFAF4);padding:12px 20px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;min-height:44px;">Start practising</a>
      </div>
    )}

    {!failed && snapshot.attempts > 0 && (
      <>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px;">
          <div style={CARD + 'margin:0;padding:18px 20px;'}>
            <div style="font-family:'Fraunces',serif;font-size:30px;font-weight:600;line-height:1;">{snapshot.attempts}</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-500,#6f665e);margin-top:7px;font-weight:700;">Answers recorded</div>
          </div>
          <div style={CARD + 'margin:0;padding:18px 20px;'}>
            <div style="font-family:'Fraunces',serif;font-size:30px;font-weight:600;line-height:1;">{pct(accuracy)}</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-500,#6f665e);margin-top:7px;font-weight:700;">Correct so far</div>
          </div>
          <div style={CARD + 'margin:0;padding:18px 20px;'}>
            <div style="font-family:'Fraunces',serif;font-size:30px;font-weight:600;line-height:1;">{snapshot.concepts.length}</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-500,#6f665e);margin-top:7px;font-weight:700;">Concepts touched</div>
          </div>
          <div style={CARD + 'margin:0;padding:18px 20px;'}>
            <div style="font-family:'Fraunces',serif;font-size:30px;font-weight:600;line-height:1;">{snapshot.source === 'model' ? 'v' + snapshot.modelVersion : 'Base'}</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-500,#6f665e);margin-top:7px;font-weight:700;">{snapshot.source === 'model' ? 'Trained model' : 'Platform estimator'}</div>
          </div>
        </div>

        {next && (
          <div style={CARD + 'border-color:rgba(168,71,44,0.35);'}>
            <p style={EYE}>Suggested next</p>
            <p style="font-family:'Fraunces',serif;font-size:1.5rem;font-weight:500;margin:8px 0 8px;">{next.concept}</p>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--ink-500,#4a443e);max-width:62ch;">
              You are at about {pct(next.predicted)} to get the next question in this right. That is
              the band where learning actually happens — hard enough to be worth doing, close enough
              to reach. It is a suggestion, not an instruction: you can work on anything you like.
            </p>
            <p style="margin:14px 0 0;">
              <a href="/aquintutor/practice" style="color:var(--rust,#a8472c);font-weight:600;font-size:14px;text-decoration:none;">Practise this &rarr;</a>
            </p>
          </div>
        )}

        <div style={CARD}>
          <p style={EYE}>Concept by concept</p>
          <p style="font-size:13.5px;color:var(--ink-500,#6f665e);line-height:1.65;margin:10px 0 16px;max-width:64ch;">
            Mastery is a probability that you know the concept, updated after every answer — not an
            average of your marks. The next column is what the platform predicts for your next
            question in it. Weakest first.
          </p>
          <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;">
              <thead><tr><th style={TH}>Concept</th><th style={TH}>Answers</th><th style={TH}>Mastery</th><th style={TH}>Next question</th><th style={TH}></th></tr></thead>
              <tbody>
                {snapshot.concepts.map((c: any) => (
                  <tr>
                    <td style={TD}>{c.concept}</td>
                    <td style={TD + "font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-500,#6f665e);"}>{c.correct}/{c.attempts}</td>
                    <td style={TD}>
                      <span style="display:inline-block;width:96px;height:7px;border-radius:100px;background:var(--sand-100,rgba(14,11,8,0.07));overflow:hidden;vertical-align:middle;">
                        <i style={'display:block;height:100%;background:' + bandColour(c.mastery) + ';width:' + Math.round(c.mastery * 100) + '%;'}></i>
                      </span>
                      <span style="font-family:'JetBrains Mono',monospace;font-size:11.5px;margin-left:8px;color:var(--ink-500,#6f665e);">{pct(c.mastery)}</span>
                    </td>
                    <td style={TD + "font-family:'JetBrains Mono',monospace;font-size:12.5px;"}>{pct(c.predicted)}</td>
                    <td style={TD + 'font-size:12px;font-weight:600;color:' + bandColour(c.predicted) + ';'}>{band(c.predicted)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {snapshot.explain.length > 0 && (
          <div style={CARD}>
            <p style={EYE}>Why it says that</p>
            <p style="font-size:13.5px;color:var(--ink-500,#6f665e);line-height:1.65;margin:10px 0 14px;max-width:64ch;">
              These are the inputs that actually moved the most recent prediction, largest first. A
              number you cannot interrogate has no business sitting next to your work, so it is here.
            </p>
            <ul style="margin:0;padding-left:18px;font-size:14px;line-height:1.9;color:var(--ink,#0E0B08);">
              {snapshot.explain.map((e: any) => (
                <li>
                  {e.feature}
                  <span style={'font-family:\'JetBrains Mono\',monospace;font-size:11.5px;margin-left:8px;color:' + (e.direction === 'helps' ? '#1A6B35' : '#a04330') + ';'}>
                    {e.direction === 'helps' ? 'raised the estimate' : 'lowered the estimate'}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}

    <div style={CARD + 'background:rgba(14,11,8,0.02);'}>
      <p style={EYE}>What this does and does not do</p>
      <ul style="margin:12px 0 0;padding-left:18px;font-size:13.5px;line-height:1.85;color:var(--ink-500,#4a443e);">
        <li>It suggests what to work on next and says how sure it is. It never grades you, never blocks you, and never affects any result or credential. A person decides anything that counts.</li>
        <li>It learns from your answers on this platform — which questions, how hard they were, how they went. Nothing from health, wellness or private messages reaches it.</li>
        <li>It can be wrong, and it says so: when it has not earned its place against the platform's simpler estimate, that simpler estimate is what you are seeing.</li>
        <li>Staff see these figures only in aggregate. There is no screen anywhere that shows a member of staff your stream on its own.</li>
      </ul>
      <p style="margin:14px 0 0;font-size:13.5px;">
        <a href="/aquintutor/knowledge-graph" style="color:var(--rust,#a8472c);text-decoration:none;font-weight:600;">See how the concepts connect &rarr;</a>
      </p>
    </div>
  </main>
</AquintutorLayout>
