---
// /aquintutor/assignments — WHAT THIS LEARNER ACTUALLY OWES.
//
// This page used to be a hand-written array: four columns of invented coursework for courses that
// do not exist ("QT-407 · density matrices", "18 ACTIVE" in the breadcrumb), owed by nobody, due
// never. It is now read from lms_assignments and lms_submissions for the signed-in person, through
// the same pure state function the instructor's queue uses (src/lib/lms/policy.ts), so the column a
// piece of work sits in here and the column it sits in for the person grading it cannot disagree.
//
// The kanban shape is kept because it was the right shape. What changed is that it is true.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { learnerBoard, type BoardItem } from '@/lib/lms/assignments';
import { relativeDue, stateLabel, stateTone, kindLabel } from '@/lib/lms/policy';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/assignments'));

const now = new Date();
let board: BoardItem[] = [];
let readError = '';
try {
  board = await learnerBoard(user.id, now);
} catch (e: any) {
  // A page that says "you owe nothing" because a query failed is the worst possible wrong answer
  // on a coursework screen. It says what happened instead.
  readError = e?.cause?.message || e?.message || 'unknown error';
}

const COLUMNS = [
  { id: 'todo', title: 'To do', accent: '#6b5f4c', states: ['not_started', 'locked'] },
  { id: 'doing', title: 'In progress', accent: '#3d6b76', states: ['draft', 'missing', 'returned'] },
  { id: 'review', title: 'Under review', accent: '#a87526', states: ['submitted'] },
  { id: 'done', title: 'Graded', accent: '#4a7048', states: ['graded', 'closed'] },
];

const columns = COLUMNS.map((c) => ({ ...c, items: board.filter((b) => c.states.includes(b.state)) }));
const activeCount = board.filter((b) => b.state !== 'graded' && b.state !== 'closed').length;
const overdue = board.filter((b) => b.state === 'missing').length;
const dueThisWeek = board.filter((b) => {
  if (!b.dueAt || b.state === 'graded' || b.state === 'closed') return false;
  const ms = new Date(b.dueAt).getTime() - now.getTime();
  return ms > 0 && ms < 7 * 86400000;
}).length;
const gradedItems = board.filter((b) => b.gradePct != null);
const averagePct = gradedItems.length
  ? Math.round(gradedItems.reduce((s, b) => s + (b.gradePct as number), 0) / gradedItems.length)
  : null;
const courses = Array.from(new Set(board.map((b) => b.courseTitle)));
---
<AquintutorLayout title="Assignments" description="What you owe, what you are doing, what is done — across every course you are enrolled in.">

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1400px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor" style="color:var(--ink-500); text-decoration:none;">AQUINTUTOR</a>
      <span style="margin:0 8px;">/</span>
      <a href="/aquintutor/dashboard" style="color:var(--ink-500); text-decoration:none;">DASHBOARD</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">ASSIGNMENTS &middot; {activeCount} ACTIVE</span>
    </div>
  </div>

  <section style="border-bottom:1px solid var(--rule);">
    <div style="max-width:1400px; margin:0 auto; padding:32px 28px 24px;">
      <div style="display:flex; align-items:start; justify-content:space-between; gap:18px; flex-wrap:wrap;">
        <div>
          <h1 class="font-display" style="font-size:clamp(28px,4vw,40px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Assignments</h1>
          <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:60ch; margin:0;">
            Everything set on {courses.length === 1 ? 'your course' : 'your ' + courses.length + ' courses'}. A piece of work moves
            across these columns on its own as you save, submit and are graded.
          </p>
        </div>
        <div style="display:flex; gap:22px; flex-wrap:wrap;">
          <div>
            <div class="font-display" style="font-size:30px; font-weight:500; line-height:1;">{dueThisWeek}</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">DUE THIS WEEK</div>
          </div>
          <div>
            <div class="font-display" style={'font-size:30px; font-weight:500; line-height:1; color:' + (overdue ? '#a8472c' : 'inherit') + ';'}>{overdue}</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">OVERDUE</div>
          </div>
          <div>
            <div class="font-display" style="font-size:30px; font-weight:500; line-height:1;">{averagePct == null ? 'n/a' : averagePct + '%'}</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">AVERAGE GRADED</div>
          </div>
        </div>
      </div>
      <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap; font-family:'Inter Tight',sans-serif; font-size:13px;">
        <a href="/aquintutor/grades" style="padding:7px 14px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Your grades</a>
        <a href="/aquintutor/transcript" style="padding:7px 14px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Academic record</a>
        <a href="/aquintutor/courses" style="padding:7px 14px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Your courses</a>
      </div>
    </div>
  </section>

  {readError && (
    <div style="max-width:1400px; margin:20px auto 0; padding:0 28px;">
      <div style="border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:14px 16px; font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a;">
        <strong>Your coursework could not be read just now.</strong> This page is not saying you have nothing due &mdash; it is saying
        the query failed ({readError}). Reload in a moment; if it keeps happening, tell your instructor before a deadline passes.
      </div>
    </div>
  )}

  <section style="max-width:1400px; margin:0 auto; padding:26px 28px 60px;">
    {!readError && board.length === 0 && (
      <div style="border:1px solid var(--rule); border-radius:12px; padding:44px 28px; text-align:center; background:var(--sand-50);">
        <h2 class="font-display" style="font-size:22px; font-weight:500; margin:0 0 8px;">Nothing has been set yet</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:52ch; margin:0 auto 18px;">
          Assignments appear here the moment an instructor publishes one on a course you are enrolled in. Nothing on this page is a
          sample or a placeholder.
        </p>
        <a href="/aquintutor/courses" style="display:inline-block; padding:10px 20px; background:var(--ink); color:var(--sand-50); border-radius:8px; text-decoration:none; font-family:'Inter Tight',sans-serif; font-size:14px;">Find a course</a>
      </div>
    )}

    {board.length > 0 && (
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; align-items:start;">
        {columns.map((col) => (
          <div style="border:1px solid var(--rule); border-radius:12px; background:var(--sand-50); overflow:hidden;">
            <div style={'padding:12px 16px; border-bottom:1px solid var(--rule); display:flex; align-items:center; justify-content:space-between; border-top:3px solid ' + col.accent + ';'}>
              <span class="font-display" style="font-size:15px; font-weight:500;">{col.title}</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--ink-500);">{col.items.length}</span>
            </div>
            <div style="padding:12px; display:flex; flex-direction:column; gap:10px; min-height:60px;">
              {col.items.length === 0 && (
                <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:6px 4px;">Nothing here.</p>
              )}
              {col.items.map((item) => (
                <a href={'/aquintutor/assignments/' + item.id} style="display:block; border:1px solid var(--rule); border-radius:10px; padding:12px 13px; background:#fff; text-decoration:none; color:var(--ink);">
                  <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:6px;">
                    <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.06em; color:var(--ink-500); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:60%;">{item.courseTitle.toUpperCase()}</span>
                    <span style={'font-family:"JetBrains Mono",monospace; font-size:10px; letter-spacing:0.05em; color:' + stateTone(item.state) + ';'}>{stateLabel(item.state).toUpperCase()}</span>
                  </div>
                  <div class="font-display" style="font-size:15px; font-weight:500; line-height:1.25; margin-bottom:8px;">{item.title}</div>
                  <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">
                    <span>{kindLabel(item.kind)}</span>
                    <span style="font-weight:600;">{item.points} pts</span>
                  </div>
                  <div style={'margin-top:8px; font-family:"Inter Tight",sans-serif; font-size:12.5px; color:' + (item.state === 'missing' ? '#a8472c' : 'var(--ink-500)') + ';'}>
                    {item.gradePct != null
                      ? 'Scored ' + item.gradePoints + ' of ' + item.points + ' (' + item.gradePct + '%)'
                      : relativeDue(item.dueAt, now)}
                  </div>
                  {item.isLate && item.state !== 'graded' && (
                    <div style="margin-top:6px; font-family:'Inter Tight',sans-serif; font-size:12px; color:#a8472c;">Submitted late</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</AquintutorLayout>
