---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { db } from '@/lib/db';
import { users } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { hashPassword, verifyPassword } from '@/lib/auth/password';
import { sql } from 'drizzle-orm';
// The professional directory's writer. /aquintutor/careerflow/network's empty state has always
// pointed people at THIS page to "publish your profile", and this page has never written a network
// profile — so network_profiles had no INSERT anywhere and the directory could only render empty.
import { upsertProfile, profileForUser, parseList, PROFILE_KINDS, SENIORITIES, OPEN_TO } from '@/lib/network';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/profile'));

let okMsg = '';
let errMsg = '';
let activeTab: 'profile' | 'password' = 'profile';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = (fd.get('action') as string || '').trim();

  if (action === 'update_profile') {
    const name = (fd.get('name') as string || '').trim();
    if (!name || name.length < 2) {
      errMsg = 'Please enter your full name.';
    } else if (name.length > 200) {
      errMsg = 'Name is too long.';
    } else {
      try {
        await db.update(users).set({ name }).where(eq(users.id, user.id));
        user.name = name;
        okMsg = 'Profile updated.';
      } catch (e: any) { errMsg = 'Could not save: ' + (e?.message || 'unknown'); }
    }
  } else if (action === 'change_password') {
    activeTab = 'password';
    const current = (fd.get('current_password') as string || '');
    const next = (fd.get('new_password') as string || '');
    const confirm = (fd.get('confirm_password') as string || '');
    if (!current || !next) {
      errMsg = 'Both current and new password are required.';
    } else if (next.length < 8) {
      errMsg = 'New password must be at least 8 characters.';
    } else if (next !== confirm) {
      errMsg = 'New password and confirmation do not match.';
    } else {
      try {
        const r = await db.execute(sql`SELECT password_hash FROM users WHERE id = ${user.id} LIMIT 1`);
        const rows = Array.isArray(r) ? r : (r?.rows || []);
        const stored = (rows[0] as any)?.password_hash;
        if (!stored) {
          errMsg = 'Account not found.';
        } else {
          const ok = await verifyPassword(stored, current);
          if (!ok) {
            errMsg = 'Current password is incorrect.';
          } else {
            const newHash = await hashPassword(next);
            await db.update(users).set({ passwordHash: newHash }).where(eq(users.id, user.id));
            okMsg = 'Password changed.';
          }
        }
      } catch (e: any) { errMsg = 'Could not change password: ' + (e?.message || 'unknown'); }
    }
  } else if (action === 'publish_network_profile') {
    // upsertProfile() keys on the signed-in user id and never on a slug from the form body, so this
    // cannot be pointed at somebody else's row. It returns a discriminated result; the failure is
    // shown, never swallowed.
    const res = await upsertProfile(user.id, {
      kind: String(fd.get('kind') || 'individual'),
      displayName: String(fd.get('display_name') || ''),
      tagline: String(fd.get('tagline') || ''),
      bio: String(fd.get('net_bio') || ''),
      location: String(fd.get('location') || ''),
      websiteUrl: String(fd.get('website_url') || ''),
      contactEmail: String(fd.get('contact_email') || ''),
      skills: parseList(String(fd.get('skills') || ''), 30),
      languages: parseList(String(fd.get('net_languages') || ''), 20),
      servicesOffered: parseList(String(fd.get('services') || ''), 20),
      seniority: String(fd.get('seniority') || ''),
      yearsExperience: fd.get('net_years') ? Number(fd.get('net_years')) : null,
      openTo: fd.getAll('open_to').map(String),
      isPublic: fd.get('is_public') === 'on',
    });
    if (res.ok) {
      okMsg = (res.created ? 'Your profile is published at /u/' : 'Your profile has been updated. It is at /u/') + res.slug + '.';
    } else {
      errMsg = res.error;
    }
  }
}

// What this person has already published, so the form is an editor rather than a second create.
const netRes = await profileForUser(user.id);
const netProfile = netRes.ok ? netRes.value : null;
const netReadFailed = !netRes.ok;

let stats = { enrolments: 0, attempts: 0, credentials: 0 };
try {
  const r = await db.execute(sql`
    SELECT
      (SELECT COUNT(*)::int FROM training_enrollments WHERE user_id = ${user.id}) as enrolments,
      (SELECT COUNT(*)::int FROM test_attempts WHERE candidate_id = ${user.id}) as attempts,
      (SELECT COUNT(*)::int FROM training_certificates WHERE user_id = ${user.id}) as credentials
  `);
  const rows = Array.isArray(r) ? r : (r?.rows || []);
  if (rows[0]) stats = rows[0] as any;
} catch (_) {}

function fmtDate(d: any) {
  if (!d) return '-';
  try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' }); }
  catch { return '-'; }
}
---
<AquintutorLayout title="Profile" description="Your AquinTutor account - name, email, password.">

  <section style="border-bottom:1px solid var(--rule);">
    <div style="max-width:880px; margin:0 auto; padding:56px 28px 36px;">
      <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--rust); font-weight:600; letter-spacing:0.04em; margin:0 0 14px;">Your account</p>
      <h1 class="font-display" style="font-size:clamp(2rem, 4vw, 3rem); line-height:1.1; letter-spacing:-0.02em; font-weight:500; margin:0; color:var(--ink);">{user.name}</h1>
      <p style="font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink-500); margin:10px 0 0;">{user.email}</p>
    </div>
  </section>

  <section style="background:var(--sand-100); border-bottom:1px solid var(--rule);">
    <div style="max-width:880px; margin:0 auto; padding:36px 28px;">
      <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;">
        {[
          { l: 'Enrolments', v: stats.enrolments, href: '/aquintutor/dashboard' },
          { l: 'Examinations', v: stats.attempts, href: '/aquintutor/dashboard' },
          { l: 'Credentials', v: stats.credentials, href: '/aquintutor/dashboard' },
        ].map((s) => (
          <a href={s.href} style="background:var(--paper); border:1px solid var(--rule); border-radius:10px; padding:18px 20px; text-decoration:none; color:var(--ink);">
            <p style="font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin:0 0 6px;">{s.l}</p>
            <p class="font-display" style="font-size:1.85rem; font-weight:500; margin:0; line-height:1; color:var(--ink); letter-spacing:-0.02em;">{s.v}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div style="max-width:880px; margin:0 auto; padding:48px 28px 80px;">

      {okMsg && (
        <div style="background:rgba(125,211,168,0.14); border:1px solid #7dd3a8; color:#3f8a64; border-radius:8px; padding:14px 18px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:24px;">{okMsg}</div>
      )}
      {errMsg && (
        <div style="background:rgba(160,66,30,0.10); border:1px solid rgba(160,66,30,0.4); color:var(--rust); border-radius:8px; padding:14px 18px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:24px;">{errMsg}</div>
      )}

      <div style="display:flex; gap:8px; border-bottom:1px solid var(--rule); margin-bottom:28px;">
        <button type="button" id="tabProfile" style={'background:transparent; border:none; padding:12px 4px; font-family:Inter Tight,sans-serif; font-size:14px; font-weight:600; cursor:pointer; margin-right:18px; ' + (activeTab === 'profile' ? 'color:var(--ink); border-bottom:2px solid var(--ink);' : 'color:var(--ink-500);')}>Profile</button>
        <button type="button" id="tabPassword" style={'background:transparent; border:none; padding:12px 4px; font-family:Inter Tight,sans-serif; font-size:14px; font-weight:600; cursor:pointer; ' + (activeTab === 'password' ? 'color:var(--ink); border-bottom:2px solid var(--ink);' : 'color:var(--ink-500);')}>Password</button>
      </div>

      <div id="paneProfile" style={activeTab === 'profile' ? '' : 'display:none;'}>
        <form method="post" style="background:var(--paper); border:1px solid var(--rule); border-radius:12px; padding:28px; display:flex; flex-direction:column; gap:16px;">
          <input type="hidden" name="action" value="update_profile" />
          <div>
            <label for="name" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Full name</label>
            <input id="name" name="name" type="text" maxlength="200" required value={user.name || ''} style="width:100%; padding:11px 14px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
          </div>
          <div>
            <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Email address</label>
            <p style="margin:0; font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink);">{user.email}</p>
            <p style="margin:6px 0 0; font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">Email cannot be changed here. Contact <a href="mailto:hr@edurankai.in" style="color:var(--rust); text-decoration:underline;">hr@edurankai.in</a> if you need to update your registered address.</p>
          </div>
          <div>
            <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Role</label>
            <p style="margin:0; font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); text-transform:capitalize;">{(user.role || 'applicant').replace('_',' ')}</p>
          </div>
          <button type="submit" style="background:var(--ink); color:var(--sand-50); padding:12px 22px; border:none; border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer; align-self:flex-start;">Save changes</button>
        </form>
      </div>

      <div id="panePassword" style={activeTab === 'password' ? '' : 'display:none;'}>
        <form method="post" style="background:var(--paper); border:1px solid var(--rule); border-radius:12px; padding:28px; display:flex; flex-direction:column; gap:16px;">
          <input type="hidden" name="action" value="change_password" />
          <div>
            <label for="current_password" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Current password</label>
            <input id="current_password" name="current_password" type="password" required style="width:100%; padding:11px 14px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
          </div>
          <div>
            <label for="new_password" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">New password</label>
            <input id="new_password" name="new_password" type="password" required minlength="8" style="width:100%; padding:11px 14px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
            <p style="margin:6px 0 0; font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">At least 8 characters.</p>
          </div>
          <div>
            <label for="confirm_password" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Confirm new password</label>
            <input id="confirm_password" name="confirm_password" type="password" required minlength="8" style="width:100%; padding:11px 14px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
          </div>
          <button type="submit" style="background:var(--ink); color:var(--sand-50); padding:12px 22px; border:none; border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer; align-self:flex-start;">Change password</button>
        </form>
      </div>

      <div style="margin-top:32px; padding-top:28px; border-top:1px solid var(--rule);">
        <p style="font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin:0 0 6px;">Your public profile</p>
        <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin:0 0 16px; line-height:1.65; max-width:62ch;">
          This is what appears in the professional directory and at your own address. It is separate from
          your account above: nothing here is published until you save it, and you can hide it again at any
          time without losing what you wrote.
        </p>

        {netReadFailed && (
          <div style="background:rgba(160,66,30,0.08); border:1px solid rgba(160,66,30,0.35); border-radius:8px; padding:12px 16px; font-family:'Inter Tight',sans-serif; font-size:13.5px; margin-bottom:16px; line-height:1.6;">
            We could not read your existing profile, so this form may be blank even though you have one.
            Saving now could overwrite what is already published — please reload before editing.
            <span style="display:block; font-size:12px; color:var(--ink-500); margin-top:5px;">Reason recorded: {netRes.ok ? '' : netRes.reason}</span>
          </div>
        )}

        {netProfile && (
          <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; margin:0 0 14px;">
            Published at <a href={'/u/' + netProfile.slug} style="color:var(--rust); text-decoration:underline;">/u/{netProfile.slug}</a>
            {netProfile.isPublic ? ' — visible in the directory.' : ' — currently hidden from the directory.'}
          </p>
        )}

        {!netReadFailed && (
        <form method="post" style="background:var(--paper); border:1px solid var(--rule); border-radius:12px; padding:24px; display:flex; flex-direction:column; gap:14px;">
          <input type="hidden" name="action" value="publish_network_profile" />

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px;">
            <div>
              <label for="display_name" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Listed name</label>
              <input id="display_name" name="display_name" type="text" maxlength="200" required value={netProfile?.displayName || user.name || ''} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="kind" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Listed as</label>
              <select id="kind" name="kind" style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);">
                {PROFILE_KINDS.map((k) => <option value={k} selected={(netProfile?.kind || 'individual') === k}>{k}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label for="tagline" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Headline</label>
            <input id="tagline" name="tagline" type="text" maxlength="300" value={netProfile?.tagline || ''} placeholder="What you do, in one line" style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
          </div>

          <div>
            <label for="net_bio" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">About</label>
            <textarea id="net_bio" name="net_bio" rows="4" maxlength="6000" style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink); line-height:1.6;">{netProfile?.bio || ''}</textarea>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px;">
            <div>
              <label for="location" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Location</label>
              <input id="location" name="location" type="text" maxlength="120" value={netProfile?.location || ''} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="website_url" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Website</label>
              <input id="website_url" name="website_url" type="url" value={netProfile?.websiteUrl || ''} placeholder="https://" style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="contact_email" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Contact email (public)</label>
              <input id="contact_email" name="contact_email" type="email" maxlength="200" value={netProfile?.contactEmail || ''} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="seniority" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Seniority</label>
              <select id="seniority" name="seniority" style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);">
                <option value="">Not stated</option>
                {SENIORITIES.map((s) => <option value={s} selected={netProfile?.seniority === s}>{s}</option>)}
              </select>
            </div>
            <div>
              <label for="net_years" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Years of experience</label>
              <input id="net_years" name="net_years" type="number" min="0" max="80" value={netProfile?.yearsExperience ?? ''} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px;">
            <div>
              <label for="skills" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Skills (comma separated)</label>
              <input id="skills" name="skills" type="text" value={(netProfile?.skills || []).join(', ')} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="net_languages" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Languages (comma separated)</label>
              <input id="net_languages" name="net_languages" type="text" value={(netProfile?.languages || []).join(', ')} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
            <div>
              <label for="services" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin-bottom:6px;">Services offered (comma separated)</label>
              <input id="services" name="services" type="text" value={(netProfile?.servicesOffered || []).join(', ')} style="width:100%; padding:10px 13px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink);" />
            </div>
          </div>

          <fieldset style="border:1px solid var(--rule); border-radius:8px; padding:12px 14px;">
            <legend style="font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; padding:0 5px;">Open to</legend>
            <div style="display:flex; flex-wrap:wrap; gap:14px;">
              {OPEN_TO.map((o) => (
                <label style="font-family:'Inter Tight',sans-serif; font-size:13.5px; display:flex; align-items:center; gap:5px;">
                  <input type="checkbox" name="open_to" value={o} checked={(netProfile?.openTo || []).includes(o)} />{o}
                </label>
              ))}
            </div>
          </fieldset>

          <label style="font-family:'Inter Tight',sans-serif; font-size:13.5px; display:flex; align-items:center; gap:7px;">
            <input type="checkbox" name="is_public" checked={netProfile ? netProfile.isPublic : true} />
            List me in the directory at /aquintutor/careerflow/network
          </label>

          <button type="submit" style="background:var(--ink); color:var(--sand-50); padding:12px 22px; border:none; border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer; align-self:flex-start;">{netProfile ? 'Save profile' : 'Publish profile'}</button>
        </form>
        )}
      </div>

      <div style="margin-top:32px; padding-top:28px; border-top:1px solid var(--rule);">
        <p style="font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); font-weight:600; margin:0 0 12px;">Session</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/aquintutor/dashboard" style="background:transparent; color:var(--ink); padding:11px 20px; border-radius:6px; border:1px solid var(--rule); font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; text-decoration:none;">Dashboard</a>
          <form method="post" action="/aquintutor/logout" style="margin:0;">
            <button type="submit" style="background:transparent; color:var(--rust); padding:11px 20px; border-radius:6px; border:1px solid rgba(160,66,30,0.5); font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Sign out</button>
          </form>
        </div>
      </div>

    </div>
  </section>

  <script is:inline>
    (function() {
      var tProf = document.getElementById('tabProfile');
      var tPass = document.getElementById('tabPassword');
      var pProf = document.getElementById('paneProfile');
      var pPass = document.getElementById('panePassword');
      function show(which) {
        if (which === 'password') {
          pProf.style.display = 'none'; pPass.style.display = '';
          tProf.style.color = 'var(--ink-500)'; tProf.style.borderBottom = 'none';
          tPass.style.color = 'var(--ink)'; tPass.style.borderBottom = '2px solid var(--ink)';
        } else {
          pPass.style.display = 'none'; pProf.style.display = '';
          tPass.style.color = 'var(--ink-500)'; tPass.style.borderBottom = 'none';
          tProf.style.color = 'var(--ink)'; tProf.style.borderBottom = '2px solid var(--ink)';
        }
      }
      if (tProf) tProf.addEventListener('click', function() { show('profile'); });
      if (tPass) tPass.addEventListener('click', function() { show('password'); });
    })();
  </script>

</AquintutorLayout>
