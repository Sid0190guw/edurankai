---
// The competency framework, and — for a signed-in learner — where they actually stand on it.
//
// WHAT THIS PAGE USED TO BE. Two constant arrays rendered as cards, under a sentence describing a
// progression through "not started, in progress, demonstrated, verified". No learner could be in any
// of those states: addCompetency() and setProgress() in src/lib/aquin-competencies.ts were called by
// nothing, so aquin_competencies had no writer and aquin_competency_progress had neither a writer
// nor a reader. The framework described a system that did not exist.
//
// Competencies are defined at /admin/aquintutor/curriculum now, and this page reads what is there.
// When nothing has been defined it says exactly that, rather than implying a learner has done
// nothing; and when the read fails it says that instead of either.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import {
  DIMENSIONS, ASSESSMENT_MODES, dimensionLabel,
  programsWithCompetencies, progressFor,
} from '@/lib/aquin-competencies';
import { listProgramsResult } from '@/lib/aquin-programs';

const dimColor = ['#FF4F00', '#1045BB', '#128a3f', '#8a5a00', '#a11d6b', '#0a7ea4'];

const STATE_LABEL: Record<string, string> = {
  not_started: 'Not started',
  in_progress: 'In progress',
  demonstrated: 'Demonstrated',
  verified: 'Verified',
};
const STATE_COLOR: Record<string, string> = {
  not_started: '#6b6b6b',
  in_progress: '#8a5a00',
  demonstrated: '#1045BB',
  verified: '#128a3f',
};

const learner = Astro.locals.user;

// Which programmes have competencies at all. "No programme has any defined" and "we could not find
// out" are different sentences and get different panels.
const definedRead = learner ? await programsWithCompetencies() : null;
const defined = definedRead && definedRead.ok ? definedRead.value.filter((d) => d.count > 0) : [];
const definedFailed = !!definedRead && !definedRead.ok;
const definedReason = definedRead && !definedRead.ok ? definedRead.reason : '';

// Programme names, so a learner reads a title rather than a slug. A failure here costs the label
// only: the slug is shown and nothing is hidden.
const progRead = learner && defined.length > 0 ? await listProgramsResult() : null;
const progNames = new Map((progRead && progRead.ok ? progRead.programs : []).map((p) => [p.slug, p.name]));

const selected = String(Astro.url.searchParams.get('program') || defined[0]?.programSlug || '').trim();
const myRead = learner && selected ? await progressFor(learner.id, selected) : null;
const myRows = myRead && myRead.ok ? myRead.value : [];
const myFailed = !!myRead && !myRead.ok;
const myReason = myRead && !myRead.ok ? myRead.reason : '';
const verifiedCount = myRows.filter((r) => r.status === 'verified').length;
---
<AquintutorLayout title="Competency Framework" description="AquinTutor is competency-based: students progress by demonstrating competencies across online theory, partner practical, projects, community, wellness and research.">
  <section style="max-width:1000px;margin:0 auto;padding:40px 20px 72px;">

    <p style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 8px;">Competency Framework</p>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.1;margin:0 0 14px;color:#141414;">You progress by proving competence, not by counting hours.</h1>
    <p style="font-size:16px;line-height:1.7;color:#3a3a3a;max-width:770px;margin:0 0 6px;">
      AquinTutor is <strong>competency-based</strong>. Rather than passively completing lectures, students
      advance by demonstrating real competencies across a blend of digital theory, hands-on practical
      training at partners, industry projects, community engagement, wellness and research. Each
      competency is assessed online, at a partner institution, or jointly by both.
    </p>

    <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:34px 0 14px;color:#141414;">The six progression dimensions</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
      {DIMENSIONS.map((d, i) => (
        <div style={`border:1px solid rgba(0,0,0,0.10);border-left:4px solid ${dimColor[i % dimColor.length]};border-radius:0 12px 12px 0;padding:15px 17px;background:#fff;`}>
          <h3 style="font-size:15px;font-weight:700;margin:0 0 5px;color:#141414;">{d.label}</h3>
          <p style="font-size:13px;color:#4a4a4a;margin:0;line-height:1.6;">{d.blurb}</p>
        </div>
      ))}
    </div>

    <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:36px 0 14px;color:#141414;">How competencies are assessed</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
      {ASSESSMENT_MODES.map((m) => (
        <div style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:15px 17px;background:#f7f6f2;">
          <h3 style="font-size:14px;font-weight:700;margin:0 0 5px;color:#141414;">{m.label}</h3>
          <p style="font-size:12.5px;color:#4a4a4a;margin:0;line-height:1.6;">{m.blurb}</p>
        </div>
      ))}
    </div>

    <div style="margin-top:38px;border-top:1px solid rgba(0,0,0,0.08);padding-top:18px;">
      <p style="font-size:14px;color:#4a4a4a;line-height:1.7;max-width:770px;margin:0;">
        Each program defines its own competencies against these dimensions. A learner's progress moves
        through <strong>not started &rarr; in progress &rarr; demonstrated &rarr; verified</strong>,
        with partner-assessed competencies verified by certified supervisors. Explore how any program is
        delivered from the <a href="/aquintutor/programs" style="color:#FF4F00;font-weight:600;">degree catalog</a>.
      </p>
    </div>

    <!-- Where this learner actually stands. Read from aquin_competency_progress, which is written
         when a competency is recorded against them; it is not derived from anything on screen. -->
    {learner && (
      <div style="margin-top:38px;border-top:1px solid rgba(0,0,0,0.08);padding-top:22px;">
        <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:0 0 12px;color:#141414;">Where you stand</h2>

        {definedFailed ? (
          <div style="border:1px solid #FF4F00;border-radius:12px;padding:16px 18px;background:#fff;">
            <p style="font-size:15px;font-weight:700;margin:0 0 6px;color:#141414;">Your competency record could not be read.</p>
            <p style="font-size:13.5px;color:#3a3a3a;line-height:1.6;margin:0;max-width:70ch;">
              That is a fault on our side. It does not mean you have not demonstrated anything, and
              nothing you have earned has been lost.
            </p>
            <p style="font-family:'Geist Mono',monospace;font-size:11px;color:#8a8a8a;margin:10px 0 0;">Reason recorded: {definedReason}</p>
          </div>
        ) : defined.length === 0 ? (
          <p style="font-size:14px;color:#4a4a4a;line-height:1.7;max-width:770px;margin:0;">
            No programme has published its competencies yet, so there is nothing to show you against
            one. This says nothing about your work &mdash; it means faculty have not defined the list.
          </p>
        ) : (
          <div>
            {defined.length > 1 && (
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                {defined.map((d) => (
                  <a
                    href={'/aquintutor/competencies?program=' + encodeURIComponent(d.programSlug)}
                    style={'font-size:12px;padding:6px 14px;border-radius:100px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);' + (d.programSlug === selected ? 'background:#141414;color:#fff;' : 'color:#2E2520;')}
                  >{progNames.get(d.programSlug) || d.programSlug}</a>
                ))}
              </div>
            )}

            {myFailed ? (
              <div style="border:1px solid #FF4F00;border-radius:12px;padding:16px 18px;background:#fff;">
                <p style="font-size:15px;font-weight:700;margin:0 0 6px;color:#141414;">This programme's competencies could not be read.</p>
                <p style="font-family:'Geist Mono',monospace;font-size:11px;color:#8a8a8a;margin:8px 0 0;">Reason recorded: {myReason}</p>
              </div>
            ) : myRows.length === 0 ? (
              <p style="font-size:14px;color:#4a4a4a;margin:0;">This programme has no competencies defined yet.</p>
            ) : (
              <div>
                <p style="font-size:13px;color:#6b6b6b;margin:0 0 10px;">
                  {verifiedCount} of {myRows.length} verified. A competency changes state only when
                  somebody with the authority to assess it records that it happened.
                </p>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px;">
                  {myRows.map((r) => (
                    <div style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:13px 15px;background:#fff;">
                      <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;">
                        <h3 style="font-size:14px;font-weight:600;margin:0;color:#141414;line-height:1.3;">{r.competency.name}</h3>
                        <span style={'font-size:10px;font-weight:700;white-space:nowrap;padding:2px 8px;border-radius:100px;color:#fff;background:' + (STATE_COLOR[r.status] || '#6b6b6b')}>{STATE_LABEL[r.status] || r.status}</span>
                      </div>
                      <p style="font-size:12px;color:#6b6b6b;margin:5px 0 0;">{dimensionLabel(r.competency.dimension)} &middot; assessed {r.competency.assessmentMode}</p>
                      {r.competency.description && <p style="font-size:12.5px;color:#4a4a4a;margin:6px 0 0;line-height:1.6;">{r.competency.description}</p>}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    )}

  </section>
</AquintutorLayout>
