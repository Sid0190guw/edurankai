---
// /aquintutor/assignments/[id] — one assignment: the brief, the rubric, your attempts, your grade,
// and the form you submit with.
//
// THE FORM POSTS TO THIS PAGE, NOT TO AN API. There is no fetch and no client-side JSON on this
// screen: a plain form means a learner on a bad connection who presses Submit gets either a saved
// submission or an error, never a spinner that silently lost eight hundred words. The one piece of
// script is a live word counter, and it degrades to nothing.
//
// SUBMISSION IS A LINK OR TYPED TEXT. Not an upload — that is this project's standing rule, and the
// reason is on the form in plain words: work stays in the learner's own drive, we store the URL.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { learnerAssignment, submitAssignment } from '@/lib/lms/assignments';
import { relativeDue, stateLabel, stateTone, kindLabel } from '@/lib/lms/policy';

export const prerender = false;

const user = Astro.locals.user;
const assignmentId = String(Astro.params.id || '');
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/assignments/' + assignmentId));

const now = new Date();

// EVERY const THIS HANDLER TOUCHES IS DECLARED ABOVE IT. const is not hoisted, and a POST handler
// placed before its own dependencies is how two production pages here threw on their first line
// while reporting success.
let flash = '';
let flashOk = false;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const asDraft = String(form.get('action') || '') === 'draft';
    const result = await submitAssignment(user.id, {
      assignmentId,
      body: String(form.get('body') || ''),
      links: String(form.get('links') || '').split(/[\r\n]+/),
      asDraft,
    }, now);
    flashOk = result.ok;
    if (result.ok) {
      flash = asDraft
        ? 'Draft saved. Nothing has been sent to your instructor yet.'
        : (result.late
            ? 'Submitted, ' + result.daysLate + ' day(s) late. The late penalty set for this assignment will be applied when it is graded.'
            : 'Submitted. Your instructor can see it now.');
    } else {
      flash = result.error || 'Your work was not saved.';
    }
  } catch (e: any) {
    // Never swallow: a submission path that fails quietly is a learner who believes they submitted.
    console.error('[assignments/[id]] POST:', e?.cause?.message || e?.message);
    flash = 'Your work was not saved: ' + (e?.cause?.message || e?.message || 'unknown error');
    flashOk = false;
  }
}

// A read failure here must not become a blank 500 on a page somebody is about to submit work on.
// It is reported, with the reason, and the learner is told not to assume they have nothing to do.
let view: any = null;
let loadError = '';
try {
  view = await learnerAssignment(user.id, assignmentId, now);
} catch (e: any) {
  loadError = e?.cause?.message || e?.message || 'unknown error';
  console.error('[assignments/[id]] load:', loadError);
}
if (!view && !loadError) return Astro.redirect('/aquintutor/assignments');

const a = view ? view.detail : null;
const item = view ? view.item : null;
const kinds: string[] = a && Array.isArray(a.submission_kinds) ? a.submission_kinds : ['link', 'text'];
const draft = view ? view.attempts.find((s: any) => s.status === 'draft') : null;
const graded = view ? view.attempts.filter((s: any) => s.grade_points != null) : [];
const latest = view ? (view.attempts[0] || null) : null;
const canWrite = !!view && view.window.open && view.attemptsLeft > 0;
const existingLinks = (draft?.links || latest?.links || []) as string[];
---
<AquintutorLayout title={a ? a.title : 'Assignment'} description={a ? 'Assignment in ' + a.course_title : 'Assignment'} noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1100px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/assignments" style="color:var(--ink-500); text-decoration:none;">ASSIGNMENTS</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">{String(a ? a.course_title : 'assignment').toUpperCase()}</span>
    </div>
  </div>

  <section style="max-width:1100px; margin:0 auto; padding:30px 28px 60px;">

    {flash && (
      <div style={'margin-bottom:20px; border:1px solid ' + (flashOk ? '#4a7048' : '#a8472c') + '; background:' + (flashOk ? '#f2f7f1' : '#fdf3f0') + '; border-radius:10px; padding:13px 16px; font-family:"Inter Tight",sans-serif; font-size:14px; color:' + (flashOk ? '#2f4a2d' : '#7a2f1a') + ';'}>
        {flash}
      </div>
    )}

    {loadError && (
      <div style="border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:14px 16px; font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a;">
        <strong>This assignment could not be loaded.</strong> The read failed ({loadError}) &mdash; which is not the same fact as
        the assignment not existing, and is not a reason to assume you have nothing to submit. Reload, and tell your instructor
        if it keeps happening before a deadline.
      </div>
    )}

    {a && item && (
    <div>
    <div style="display:flex; align-items:start; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:8px;">
      <div style="flex:1 1 420px;">
        <div style={'font-family:"JetBrains Mono",monospace; font-size:10.5px; letter-spacing:0.08em; margin-bottom:8px; color:' + stateTone(item.state) + ';'}>
          {stateLabel(item.state).toUpperCase()} &middot; {kindLabel(a.kind).toUpperCase()}
        </div>
        <h1 class="font-display" style="font-size:clamp(26px,3.6vw,36px); font-weight:500; letter-spacing:-0.02em; margin:0 0 10px;">{a.title}</h1>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14px; color:var(--ink-500); margin:0;">
          {a.course_title}{a.section_code ? ' · section ' + a.section_code : ''} &middot; worth {Number(a.points)} points
        </p>
      </div>
      <div style="border:1px solid var(--rule); border-radius:10px; padding:14px 16px; background:var(--sand-50); min-width:220px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin-bottom:4px;">DEADLINE</div>
        <div class="font-display" style="font-size:17px; font-weight:500; margin-bottom:8px;">{relativeDue(a.due_at, now)}</div>
        <div style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.5;">
          {a.due_at ? new Date(a.due_at).toUTCString() : 'No due date set'}<br />
          {a.allow_late
            ? 'Late work accepted' + (Number(a.max_late_days) > 0 ? ' up to ' + a.max_late_days + ' day(s) late' : '') + ', at ' + Number(a.late_penalty_pct_per_day) + '% per day'
            : 'Late work is not accepted'}<br />
          {Number(a.max_attempts)} attempt(s) allowed &middot; {view.attemptsLeft} left
        </div>
      </div>
    </div>

    {a.instructions && (
      <div style="margin:24px 0 0; border:1px solid var(--rule); border-radius:12px; padding:20px 22px; background:#fff;">
        <h2 class="font-display" style="font-size:17px; font-weight:500; margin:0 0 10px;">The brief</h2>
        <div style="font-family:'Inter Tight',sans-serif; font-size:14.5px; line-height:1.65; white-space:pre-wrap;">{a.instructions}</div>
      </div>
    )}

    {view.rubric.length > 0 && (
      <div style="margin:18px 0 0; border:1px solid var(--rule); border-radius:12px; padding:20px 22px; background:#fff;">
        <h2 class="font-display" style="font-size:17px; font-weight:500; margin:0 0 4px;">How this is marked</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0 0 14px;">The grader scores each criterion separately. You can see the rubric before you write.</p>
        <div style="display:flex; flex-direction:column; gap:10px;">
          {view.rubric.map((c: any) => (
            <div style="display:flex; align-items:start; justify-content:space-between; gap:16px; border-bottom:1px solid var(--rule); padding-bottom:9px;">
              <div>
                <div style="font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600;">{c.label}</div>
                {c.description && <div style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin-top:2px;">{c.description}</div>}
              </div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:13px; white-space:nowrap;">{Number(c.points)} pts</div>
            </div>
          ))}
        </div>
      </div>
    )}

    {graded.length > 0 && (
      <div style="margin:18px 0 0; border:1px solid #4a7048; border-radius:12px; padding:20px 22px; background:#f7faf6;">
        <h2 class="font-display" style="font-size:17px; font-weight:500; margin:0 0 12px;">Your grade</h2>
        {graded.map((g: any) => (
          <div style="margin-bottom:14px;">
            <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
              <span class="font-display" style="font-size:28px; font-weight:500;">{Number(g.grade_points)}</span>
              <span style="font-family:'Inter Tight',sans-serif; font-size:14px; color:var(--ink-500);">of {Number(a.points)} points{g.grade_pct != null ? ' · ' + Number(g.grade_pct) + '%' : ''}</span>
              {Number(g.penalty_points) > 0 && (
                <span style="font-family:'Inter Tight',sans-serif; font-size:13px; color:#a8472c;">includes a late penalty of {Number(g.penalty_points)} points</span>
              )}
            </div>
            {g.feedback && (
              <div style="margin-top:10px; font-family:'Inter Tight',sans-serif; font-size:14px; line-height:1.6; white-space:pre-wrap; border-left:3px solid #4a7048; padding-left:12px;">{g.feedback}</div>
            )}
          </div>
        ))}
      </div>
    )}

    <div style="margin:18px 0 0; border:1px solid var(--rule); border-radius:12px; padding:20px 22px; background:#fff;">
      <h2 class="font-display" style="font-size:17px; font-weight:500; margin:0 0 4px;">
        {canWrite ? (draft ? 'Your draft' : 'Submit your work') : 'Your submission'}
      </h2>

      {!canWrite && (
        <p style="font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a; margin:6px 0 0;">
          {view.attemptsLeft <= 0
            ? 'You have used every attempt on this assignment.'
            : 'This assignment is not accepting submissions: ' + view.window.reason + '.'}
        </p>
      )}

      {canWrite && view.window.willBeLate && (
        <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:#7a2f1a; margin:6px 0 0; border-left:3px solid #a8472c; padding-left:10px;">
          This is {view.window.daysLate} day(s) past the deadline. If you submit now
          {view.latePreview ? ' the late policy takes ' + view.latePreview.penaltyPoints + ' points (' + view.latePreview.penaltyPct + '%)' : ' a late penalty applies'}.
          You are seeing this before you submit, not after.
        </p>
      )}

      {canWrite && (
        <form method="POST" style="margin-top:16px;">
          {kinds.includes('link') && (
            <div style="margin-bottom:18px;">
              <label for="links" style="display:block; font-family:'Inter Tight',sans-serif; font-size:13.5px; font-weight:600; margin-bottom:5px;">Link to your work &mdash; one per line</label>
              <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); margin:0 0 8px;">
                Your work stays in your own drive; we store the link. Set the sharing to <strong>anyone with the link can view</strong>
                before you paste it &mdash; a link your grader cannot open counts as nothing submitted.
              </p>
              <textarea id="links" name="links" rows="3" placeholder="https://..." style="width:100%; padding:10px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'JetBrains Mono',monospace; font-size:13px; resize:vertical;">{existingLinks.join('\n')}</textarea>
            </div>
          )}

          {kinds.includes('text') && (
            <div style="margin-bottom:16px;">
              <label for="body" style="display:block; font-family:'Inter Tight',sans-serif; font-size:13.5px; font-weight:600; margin-bottom:5px;">
                Write your response{a.min_words ? ' — at least ' + a.min_words + ' words' : ''}
              </label>
              <textarea id="body" name="body" rows="12" style="width:100%; padding:12px 14px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14.5px; line-height:1.6; resize:vertical;">{draft?.body || ''}</textarea>
              <div style="margin-top:5px; font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--ink-500);">
                <span id="wc">{draft?.word_count || 0}</span> words
              </div>
            </div>
          )}

          <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
            <button type="submit" name="action" value="submit" style="padding:11px 22px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14.5px; font-weight:600; cursor:pointer;">
              Submit for grading
            </button>
            <button type="submit" name="action" value="draft" style="padding:11px 20px; background:transparent; color:var(--ink); border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14.5px; cursor:pointer;">
              Save a draft
            </button>
            <span style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">A draft is private to you until you submit.</span>
          </div>
        </form>
      )}

      {view.attempts.length > 0 && (
        <div style="margin-top:24px; border-top:1px solid var(--rule); padding-top:16px;">
          <h3 style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 10px;">YOUR ATTEMPTS</h3>
          {view.attempts.map((s: any) => (
            <div style="border:1px solid var(--rule); border-radius:8px; padding:12px 14px; margin-bottom:10px; background:var(--sand-50);">
              <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500);">
                <span>Attempt {s.attempt} &middot; {s.status}{s.is_late ? ' · ' + s.days_late + ' day(s) late' : ''}</span>
                <span>{s.submitted_at ? new Date(s.submitted_at).toUTCString() : 'not submitted'}</span>
              </div>
              {Array.isArray(s.links) && s.links.length > 0 && (
                <ul style="margin:8px 0 0; padding-left:18px; font-family:'JetBrains Mono',monospace; font-size:12px;">
                  {s.links.map((l: string) => (<li><a href={l} rel="noopener noreferrer nofollow" target="_blank" style="color:var(--rust);">{l}</a></li>))}
                </ul>
              )}
              {s.body && (
                <div style="margin-top:8px; font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6; white-space:pre-wrap; max-height:180px; overflow:auto;">{s.body}</div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
    </div>
    )}
  </section>

  <script is:inline>
    // The only script on this page: a word counter. If it never runs, the form still submits and the
    // server still enforces the minimum.
    (function () {
      var box = document.getElementById('body');
      var out = document.getElementById('wc');
      if (!box || !out) return;
      var count = function () {
        var t = (box.value || '').trim();
        out.textContent = t ? String(t.split(/\s+/).length) : '0';
      };
      box.addEventListener('input', count);
      count();
    })();
  </script>
</AquintutorLayout>
