---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';

// Security & digital-trust posture (spec §7). Status is HONEST: "Active" = built and running;
// "Planned" = roadmap or an infrastructure/ops commitment code alone cannot complete.
const LAYERS = [
  {
    title: 'Identity',
    items: [
      { t: 'Multi-factor authentication', s: 'active' },
      { t: 'Passkeys / FIDO2 (self-built WebAuthn)', s: 'active' },
      { t: 'Biometric face verification', s: 'active' },
      { t: 'Verified digital student identity', s: 'active' },
    ],
  },
  {
    title: 'Academic integrity',
    items: [
      { t: 'AI-assisted remote proctoring (advisory — a human decides)', s: 'active' },
      { t: 'Continuous authentication during exams', s: 'active' },
      { t: 'Browser lockdown where appropriate', s: 'planned' },
      { t: 'Plagiarism & AI-content attribution', s: 'planned' },
    ],
  },
  {
    title: 'Data',
    items: [
      { t: 'Role-based access control', s: 'active' },
      { t: 'Field-level encryption of sensitive data', s: 'active' },
      { t: 'Encrypted backups', s: 'active' },
      { t: 'Zero-trust architecture & data-residency controls', s: 'planned' },
    ],
  },
  {
    title: 'Infrastructure',
    items: [
      { t: 'Security response headers (HSTS, framing, CSP)', s: 'active' },
      { t: 'API authentication & rate limiting', s: 'active' },
      { t: 'WAF / DDoS protection', s: 'ops' },
      { t: 'Continuous vulnerability scanning & SOC', s: 'ops' },
    ],
  },
  {
    title: 'Credential trust',
    items: [
      { t: 'Tamper-resistant, cryptographically signed digital credentials', s: 'active' },
      { t: 'Public employer verification portal', s: 'active' },
      { t: 'Verifiable digital transcripts', s: 'planned' },
    ],
  },
  {
    title: 'Student safety',
    items: [
      { t: 'Emergency / SOS response', s: 'active' },
      { t: 'Well-being monitoring (privacy-safeguarded)', s: 'active' },
      { t: 'Cyberbullying & harassment detection', s: 'planned' },
    ],
  },
  {
    title: 'Research security',
    items: [
      { t: 'Version-controlled repositories', s: 'active' },
      { t: 'Secure research workspaces & controlled dataset access', s: 'planned' },
      { t: 'Intellectual-property protection', s: 'planned' },
    ],
  },
];
const badge = (s: string) => s === 'active'
  ? { txt: 'Active', c: '#128a3f' }
  : s === 'ops' ? { txt: 'Infrastructure', c: '#8a5a00' } : { txt: 'Planned', c: '#6b6b6b' };
---
<AquintutorLayout title="Security & Digital Trust" description="Security is a foundational pillar at AquinTutor — identity, academic integrity, data, credentials and student safety, with an honest view of what is active today and what is planned.">
  <section style="max-width:1000px;margin:0 auto;padding:40px 20px 72px;">

    <p style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 8px;">Security &amp; Digital Trust</p>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.1;margin:0 0 14px;color:#141414;">Security is a pillar, not an afterthought.</h1>
    <p style="font-size:16px;line-height:1.7;color:#3a3a3a;max-width:780px;margin:0 0 6px;">
      A university that handles examinations, credentials, research and student data must protect every
      interaction. Below is an honest view of AquinTutor's security posture &mdash; what is <strong>active
      today</strong>, what is <strong>planned</strong>, and what is an ongoing <strong>infrastructure</strong>
      commitment. Identity, proctoring, access control and credential signing are self-built and running.
    </p>

    <div style="display:flex;gap:14px;flex-wrap:wrap;margin:14px 0 8px;font-size:12px;color:#6b6b6b;">
      <span><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#128a3f;margin-right:5px;"></span>Active</span>
      <span><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b6b6b;margin-right:5px;"></span>Planned</span>
      <span><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#8a5a00;margin-right:5px;"></span>Infrastructure / ops</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-top:16px;">
      {LAYERS.map((layer) => (
        <div style="border:1px solid rgba(0,0,0,0.10);border-radius:14px;padding:16px 18px;background:#fff;">
          <h2 style="font-family:'Fraunces',serif;font-size:17px;font-weight:600;margin:0 0 10px;color:#141414;">{layer.title}</h2>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
            {layer.items.map((it) => {
              const b = badge(it.s);
              return (
                <li style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
                  <span style="font-size:13px;color:#3a3a3a;line-height:1.45;">{it.t}</span>
                  <span style={`font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:${b.c};background:${b.c}18;padding:2px 7px;border-radius:100px;white-space:nowrap;flex-shrink:0;`}>{b.txt}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div style="margin-top:30px;background:#141414;border-radius:16px;padding:22px 24px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;">
      <div>
        <h2 style="font-family:'Fraunces',serif;font-size:19px;font-weight:600;margin:0 0 4px;color:#fff;">Verify a credential</h2>
        <p style="font-size:13.5px;color:rgba(255,255,255,0.75);margin:0;max-width:520px;">Employers and institutions can confirm any AquinTutor credential is genuine and unaltered, using its cryptographic signature.</p>
      </div>
      <a href="/verify" style="background:#FF4F00;color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 22px;border-radius:10px;white-space:nowrap;">Verification portal &rarr;</a>
    </div>

  </section>
</AquintutorLayout>
