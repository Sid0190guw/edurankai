---
// /aquintutor/receipt/[id] — a payment receipt / invoice (Prompt AP5b). Owner-only; shows the real
// payment record. Printable. Not a tax invoice unless the platform issues GST — labelled honestly.
export const prerender = false;
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { paymentById } from '@/lib/course-payments';
import { planById } from '@/lib/payment-gateway';

const user = Astro.locals.user;
const { id } = Astro.params as { id: string };
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/receipt/' + id));
// A FAILED READ IS NOT "THAT RECEIPT IS NOT YOURS".
//
// `.catch(() => null)` fell into the same redirect as a receipt belonging to somebody else, so a
// pooler timeout bounced a payer back to the billing list with no word of why — and a receipt that
// vanishes reads as a payment that was never recorded. The two are told apart now.
let readFailed = false;
const p = await paymentById(Number(id)).catch((e: any) => {
  readFailed = true;
  console.error('[aquintutor/receipt] payment', id, 'could not be read -', e?.cause?.message || e?.message);
  return null;
});
if (readFailed) {
  return new Response(
    '<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
    + '<title>Receipt unavailable</title>'
    + '<div style="max-width:34rem;margin:12vh auto;padding:0 1.25rem;font:16px/1.7 system-ui,sans-serif;color:#1a1a1a">'
    + '<h1 style="font-size:1.35rem;margin:0 0 .75rem">This receipt could not be loaded</h1>'
    + '<p style="margin:0 0 .75rem">Our records could not be reached just now. Your payment is not missing and nothing has changed.</p>'
    + '<p style="margin:0">Please reload in a moment. <strong>Do not pay again.</strong> If it keeps happening, email connect@edurankai.in.</p>'
    + '</div>',
    { status: 503, headers: { 'Content-Type': 'text/html; charset=utf-8', 'cache-control': 'no-store' } },
  );
}
if (!p || String(p.user_id) !== String(user.id)) return Astro.redirect('/aquintutor/billing');
const plan = planById(String(p.plan));
// Two decimals always: a receipt printing "₹500" for one amount and "₹499.5" for another is a
// document somebody has to re-derive before they can file it.
function inr(paise: number) { return '₹' + (Number(paise || 0) / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
// THE DATE ON A RECEIPT IS THE PAYER'S DATE. toLocaleString('en-IN') with no zone formats in the
// RENDER PROCESS's zone, and this server runs in UTC: a payment taken at 10:00 IST printed as
// 4:30 am, and anything paid before 05:30 IST carried the previous day's date on the document.
const paidAt = p.created_at
  ? new Date(p.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' })
  : '—';
---
<AquintutorLayout title="Receipt">
  <main style="max-width:600px;margin:0 auto;padding:40px 22px 80px;">
    <div style="background:#fff;border:1px solid var(--rule);border-radius:14px;padding:28px 30px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;">
        <div><span style="font-family:Fraunces,serif;font-size:22px;font-weight:600;color:var(--ink);">AquinTutor</span><br><span style="font-family:'Inter Tight',sans-serif;font-size:12px;color:#8a8378;">by EduRank&middot;AI</span></div>
        <div style="text-align:right;"><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#8a8378;">RECEIPT #{p.id}</span><br><span style={'font-family:Inter Tight,sans-serif;font-size:13px;font-weight:700;color:' + (p.status === 'paid' ? '#2f7d5b' : '#b3541e')}>{String(p.status).toUpperCase()}</span></div>
      </div>
      <table style="width:100%;font-family:'Inter Tight',sans-serif;font-size:14px;color:var(--ink);border-collapse:collapse;">
        <tr><td style="padding:8px 0;color:#6b6455;">Plan</td><td style="padding:8px 0;text-align:right;">{plan ? plan.label : p.plan}</td></tr>
        <tr style="border-top:1px solid var(--rule);"><td style="padding:8px 0;color:#6b6455;">Amount</td><td style="padding:8px 0;text-align:right;font-weight:600;">{inr(p.amount_paise)} {p.currency}</td></tr>
        <tr style="border-top:1px solid var(--rule);"><td style="padding:8px 0;color:#6b6455;">Payment ref</td><td style="padding:8px 0;text-align:right;font-family:'JetBrains Mono',monospace;font-size:12px;">{p.payment_id || '—'}</td></tr>
        <tr style="border-top:1px solid var(--rule);"><td style="padding:8px 0;color:#6b6455;">Mode</td><td style="padding:8px 0;text-align:right;">{p.mode}</td></tr>
        <tr style="border-top:1px solid var(--rule);"><td style="padding:8px 0;color:#6b6455;">Date</td><td style="padding:8px 0;text-align:right;">{paidAt}</td></tr>
      </table>
      {p.mode !== 'live' && <p style="font-family:'Inter Tight',sans-serif;font-size:12px;color:#9b2c2c;margin:16px 0 0;">This was a {p.mode} transaction, not a real payment.</p>}
      <p style="font-family:'Inter Tight',sans-serif;font-size:11px;color:#8a8378;margin:16px 0 0;">This is a payment receipt, not a GST tax invoice.</p>
    </div>
    <button onclick="window.print()" style="margin-top:16px;background:var(--ink);color:#fff;border:none;border-radius:9px;padding:10px 20px;font-family:'Inter Tight',sans-serif;font-size:14px;font-weight:600;cursor:pointer;">Print / save PDF</button>
  </main>
</AquintutorLayout>
