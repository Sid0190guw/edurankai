---
// /aquintutor/homework — TONIGHT'S WORK, IN TIME ORDER.
//
// /aquintutor/assignments is the whole board by state. This page answers a narrower and more urgent
// question — what is due, soonest first, and what have I already missed — and it is the page a
// learner opens at nine in the evening. Same data, same pure state function, different question.
//
// It was, like the board, a hand-written array of fictional homework. It is now the real deadline
// list for the signed-in person, plus the announcements their instructors have actually posted.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { learnerBoard, type BoardItem } from '@/lib/lms/assignments';
import { relativeDue, stateLabel, stateTone } from '@/lib/lms/policy';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/homework'));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const now = new Date();
let board: BoardItem[] = [];
let readError = '';
try {
  board = await learnerBoard(user.id, now);
} catch (e: any) {
  readError = e?.cause?.message || e?.message || 'unknown error';
}

const outstanding = board.filter((b) => b.state !== 'graded' && b.state !== 'closed' && b.state !== 'submitted');
const overdue = outstanding.filter((b) => b.state === 'missing')
  .sort((a, b) => new Date(a.dueAt || 0).getTime() - new Date(b.dueAt || 0).getTime());
const upcoming = outstanding.filter((b) => b.state !== 'missing' && b.dueAt)
  .sort((a, b) => new Date(a.dueAt as string).getTime() - new Date(b.dueAt as string).getTime());
const undated = outstanding.filter((b) => !b.dueAt && b.state !== 'missing');
const awaiting = board.filter((b) => b.state === 'submitted');

const endOfToday = new Date(now); endOfToday.setUTCHours(23, 59, 59, 999);
const dueToday = upcoming.filter((b) => new Date(b.dueAt as string) <= endOfToday);
const dueThisWeek = upcoming.filter((b) => {
  const t = new Date(b.dueAt as string).getTime();
  return t > endOfToday.getTime() && t <= now.getTime() + 7 * 86400000;
});
const later = upcoming.filter((b) => new Date(b.dueAt as string).getTime() > now.getTime() + 7 * 86400000);

let announcements: any[] = [];
try {
  announcements = rows(await db.execute(sql`
    SELECT a.id, a.title, a.body, a.published_at, c.title AS course_title, c.slug AS course_slug
    FROM lms_announcements a JOIN training_courses c ON c.id = a.course_id
    WHERE a.published_at <= NOW()
      AND (a.course_id IN (SELECT course_id FROM training_enrollments WHERE user_id = ${user.id})
        OR a.section_id IN (SELECT section_id FROM lms_section_members WHERE user_id = ${user.id} AND status = 'active'))
    ORDER BY a.pinned DESC, a.published_at DESC LIMIT 5`));
} catch (e: any) {
  console.error('[aquintutor/homework] announcements:', e?.cause?.message || e?.message);
}

const GROUPS = [
  { title: 'Overdue', note: 'Past the deadline and not submitted.', tone: '#a8472c', items: overdue },
  { title: 'Due today', note: 'Before the end of today.', tone: '#a87526', items: dueToday },
  { title: 'This week', note: 'Within the next seven days.', tone: '#3d6b76', items: dueThisWeek },
  { title: 'Later', note: 'Set, but not urgent.', tone: '#6b5f4c', items: later },
  { title: 'No deadline', note: 'Open until the course says otherwise.', tone: '#6b5f4c', items: undated },
];
const groups = GROUPS.filter((g) => g.items.length > 0);
---
<AquintutorLayout title="Homework" description="What is due, soonest first." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1100px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor" style="color:var(--ink-500); text-decoration:none;">AQUINTUTOR</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">HOMEWORK</span>
    </div>
  </div>

  <section style="max-width:1100px; margin:0 auto; padding:32px 28px 60px;">
    <div style="display:flex; align-items:end; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:24px;">
      <div>
        <h1 class="font-display" style="font-size:clamp(28px,4vw,40px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Homework</h1>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:60ch; margin:0;">
          Everything outstanding, soonest first. The full board by state is on
          <a href="/aquintutor/assignments" style="color:var(--rust);">assignments</a>.
        </p>
      </div>
      <div style="display:flex; gap:22px;">
        <div>
          <div class="font-display" style={'font-size:30px; font-weight:500; line-height:1; color:' + (overdue.length ? '#a8472c' : 'inherit') + ';'}>{overdue.length}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">OVERDUE</div>
        </div>
        <div>
          <div class="font-display" style="font-size:30px; font-weight:500; line-height:1;">{dueToday.length + dueThisWeek.length}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">NEXT 7 DAYS</div>
        </div>
        <div>
          <div class="font-display" style="font-size:30px; font-weight:500; line-height:1;">{awaiting.length}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">AWAITING A GRADE</div>
        </div>
      </div>
    </div>

    {readError && (
      <div style="margin-bottom:22px; border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:14px 16px; font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a;">
        <strong>Your homework could not be read.</strong> This is a failed query ({readError}), not an empty list. Reload before
        you conclude that nothing is due.
      </div>
    )}

    {announcements.length > 0 && (
      <div style="margin-bottom:26px; border:1px solid var(--rule); border-radius:12px; background:var(--sand-50); padding:16px 20px;">
        <h2 style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 12px;">FROM YOUR INSTRUCTORS</h2>
        {announcements.map((a: any) => (
          <div style="border-bottom:1px solid var(--rule); padding-bottom:10px; margin-bottom:10px;">
            <div style="font-family:'Inter Tight',sans-serif; font-size:14.5px; font-weight:600;">{a.title}</div>
            <div style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin-top:3px; line-height:1.55;">{String(a.body || '').slice(0, 240)}</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); margin-top:5px;">
              {String(a.course_title).toUpperCase()} &middot; {new Date(a.published_at).toISOString().slice(0, 10)}
            </div>
          </div>
        ))}
      </div>
    )}

    {!readError && outstanding.length === 0 && (
      <div style="border:1px solid var(--rule); border-radius:12px; padding:44px 28px; text-align:center; background:var(--sand-50);">
        <h2 class="font-display" style="font-size:22px; font-weight:500; margin:0 0 8px;">Nothing is outstanding</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); margin:0;">
          {awaiting.length > 0
            ? awaiting.length + ' piece(s) are with a grader. Nothing is waiting on you.'
            : 'No published assignment on your courses is currently unsubmitted.'}
        </p>
      </div>
    )}

    {groups.map((group) => (
      <div style="margin-bottom:28px;">
        <div style={'display:flex; align-items:baseline; gap:12px; border-bottom:2px solid ' + group.tone + '; padding-bottom:7px; margin-bottom:12px;'}>
          <h2 class="font-display" style="font-size:18px; font-weight:500; margin:0;">{group.title}</h2>
          <span style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500);">{group.note}</span>
          <span style="margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-500);">{group.items.length}</span>
        </div>
        <div style="display:flex; flex-direction:column; gap:9px;">
          {group.items.map((item) => (
            <a href={'/aquintutor/assignments/' + item.id} style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; border:1px solid var(--rule); border-radius:10px; padding:13px 16px; background:#fff; text-decoration:none; color:var(--ink);">
              <div style="flex:1 1 300px;">
                <div class="font-display" style="font-size:16px; font-weight:500; line-height:1.3;">{item.title}</div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.06em; color:var(--ink-500); margin-top:4px;">
                  {item.courseTitle.toUpperCase()} &middot; {item.points} PTS
                </div>
              </div>
              <div style="text-align:right;">
                <div style={'font-family:"Inter Tight",sans-serif; font-size:14px; font-weight:600; color:' + group.tone + ';'}>{relativeDue(item.dueAt, now)}</div>
                <div style={'font-family:"JetBrains Mono",monospace; font-size:10px; letter-spacing:0.05em; margin-top:3px; color:' + stateTone(item.state) + ';'}>{stateLabel(item.state).toUpperCase()}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    {awaiting.length > 0 && (
      <div style="margin-top:10px;">
        <h2 style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 10px;">WITH A GRADER</h2>
        <div style="display:flex; flex-direction:column; gap:7px;">
          {awaiting.map((item) => (
            <a href={'/aquintutor/assignments/' + item.id} style="display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap; border:1px solid var(--rule); border-radius:8px; padding:10px 14px; background:var(--sand-50); text-decoration:none; color:var(--ink); font-family:'Inter Tight',sans-serif; font-size:13.5px;">
              <span>{item.title}</span>
              <span style="color:var(--ink-500);">submitted {item.submittedAt ? new Date(item.submittedAt).toISOString().slice(0, 10) : ''}{item.isLate ? ' · late' : ''}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</AquintutorLayout>
