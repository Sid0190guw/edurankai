---
// /aquintutor/transcript — the academic record.
//
// This page previously read from nothing at all: invented courses, an invented grade point average,
// on the one screen whose entire purpose is to be believed. It now reads src/lib/lms/transcript.ts.
//
// THE RULE THIS PAGE IS BUILT AROUND: a course in progress does not have a grade. It appears, it is
// labelled, and it is excluded from the grade point average. The alternative — averaging a
// half-marked course into a cumulative figure — produces a number that moves every week and means
// nothing, which is exactly what a transcript must never be.
//
// It also states plainly what this document is and is not. EduRankAI is the technology platform;
// accredited partners award credentials. This is a platform record, not a university transcript,
// and saying so is not a disclaimer bolted on — it is the accurate description.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { transcriptFor } from '@/lib/lms/transcript';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/transcript'));

const record = await transcriptFor(user.id);
const inProgress = record.entries.filter((e) => e.status === 'in_progress');
const issuedOn = new Date().toISOString().slice(0, 10);
---
<AquintutorLayout title="Academic record" description="Your record on the AquinTutor platform." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1100px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor" style="color:var(--ink-500); text-decoration:none;">AQUINTUTOR</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">ACADEMIC RECORD</span>
    </div>
  </div>

  <section style="max-width:1100px; margin:0 auto; padding:34px 28px 60px;">

    <div style="display:flex; align-items:start; justify-content:space-between; gap:22px; flex-wrap:wrap; padding-bottom:22px; border-bottom:2px solid var(--ink);">
      <div>
        <h1 class="font-display" style="font-size:clamp(26px,3.6vw,36px); font-weight:500; letter-spacing:-0.02em; margin:0 0 6px;">Academic record</h1>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14px; color:var(--ink-500); margin:0;">
          {user.name} &middot; {user.email}
        </p>
        <p style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--ink-500); margin:6px 0 0;">GENERATED {issuedOn}</p>
      </div>
      <div style="display:flex; gap:26px; flex-wrap:wrap;">
        <div>
          <div class="font-display" style="font-size:32px; font-weight:500; line-height:1;">
            {record.cumulativeGpa == null ? 'n/a' : record.cumulativeGpa.toFixed(2)}
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">CUMULATIVE GPA</div>
        </div>
        <div>
          <div class="font-display" style="font-size:32px; font-weight:500; line-height:1;">{record.creditsEarned}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">CREDITS EARNED</div>
        </div>
        <div>
          <div class="font-display" style="font-size:32px; font-weight:500; line-height:1;">{record.creditsInProgress}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">IN PROGRESS</div>
        </div>
      </div>
    </div>

    {record.readFailures.length > 0 && (
      <div style="margin-top:20px; border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:13px 16px; font-family:'Inter Tight',sans-serif; font-size:13.5px; color:#7a2f1a;">
        This record is incomplete: {record.readFailures.join('; ')} could not be read. Do not treat the totals above as final
        until this page loads without this message.
      </div>
    )}

    {record.cumulativeGpa == null && record.entries.length > 0 && (
      <p style="margin-top:20px; font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); border-left:3px solid var(--rule); padding-left:12px;">
        No grade point average is shown because no course has a posted final grade with credit hours yet. A course in progress
        is deliberately not averaged in.
      </p>
    )}

    {record.byTerm.map((term) => (
      <div style="margin-top:30px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:14px; border-bottom:1px solid var(--rule); padding-bottom:8px; margin-bottom:4px;">
          <h2 class="font-display" style="font-size:19px; font-weight:500; margin:0;">{term.termTitle}</h2>
          <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--ink-500);">
            {term.credits} credit(s){term.termGpa != null ? ' · term GPA ' + term.termGpa.toFixed(2) : ''}
          </span>
        </div>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:560px;">
            <thead>
              <tr style="text-align:left;">
                <th style="padding:9px 0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">COURSE</th>
                <th style="padding:9px 12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">SECTION</th>
                <th style="padding:9px 12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">CREDITS</th>
                <th style="padding:9px 12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">PERCENT</th>
                <th style="padding:9px 0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">GRADE</th>
              </tr>
            </thead>
            <tbody>
              {term.entries.map((e) => (
                <tr style="border-top:1px solid var(--rule);">
                  <td style="padding:11px 0;"><a href={'/aquintutor/courses/' + e.courseSlug} style="color:var(--ink); text-decoration:none;">{e.courseTitle}</a></td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--ink-500);">{e.sectionCode || '—'}</td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px;">{e.creditHours}</td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px;">{e.pct == null ? '—' : e.pct + '%'}</td>
                  <td style="padding:11px 0; font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:600;">{e.letter || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    {inProgress.length > 0 && (
      <div style="margin-top:34px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:14px; border-bottom:1px solid var(--rule); padding-bottom:8px;">
          <h2 class="font-display" style="font-size:19px; font-weight:500; margin:0;">In progress</h2>
          <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--ink-500);">NOT COUNTED TOWARD GPA</span>
        </div>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:520px;">
            <tbody>
              {inProgress.map((e) => (
                <tr style="border-top:1px solid var(--rule);">
                  <td style="padding:11px 0;"><a href={'/aquintutor/courses/' + e.courseSlug} style="color:var(--ink); text-decoration:none;">{e.courseTitle}</a></td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px;">{e.creditHours} credit(s)</td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--ink-500);">
                    {e.pct == null ? 'no released grades yet' : e.pct + '% on work graded so far'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {record.credentials.length > 0 && (
      <div style="margin-top:34px;">
        <h2 class="font-display" style="font-size:19px; font-weight:500; margin:0 0 4px; border-bottom:1px solid var(--rule); padding-bottom:8px;">Credentials issued</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:10px 0 12px;">
          Each of these is independently verifiable against the certificate ledger, without this page.
        </p>
        <div style="display:flex; flex-direction:column; gap:9px;">
          {record.credentials.map((c: any) => (
            <div style="display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap; border:1px solid var(--rule); border-radius:8px; padding:11px 14px; background:var(--sand-50); font-family:'Inter Tight',sans-serif; font-size:13.5px;">
              <span>{c.course_title}</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-500);">
                {c.code} &middot; {c.issued_at ? new Date(c.issued_at).toISOString().slice(0, 10) : ''}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    {record.entries.length === 0 && record.credentials.length === 0 && (
      <div style="margin-top:30px; border:1px solid var(--rule); border-radius:12px; padding:40px 26px; text-align:center; background:var(--sand-50);">
        <h2 class="font-display" style="font-size:21px; font-weight:500; margin:0 0 8px;">Nothing recorded yet</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); margin:0;">
          Your record fills in as you enrol, are graded, and are issued credentials. It shows nothing until then, by design.
        </p>
      </div>
    )}

    <div style="margin-top:38px; border-top:1px solid var(--rule); padding-top:16px;">
      <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.65; max-width:76ch;">
        <strong>What this document is.</strong> A record of coursework, grades and credentials held by the AquinTutor platform for
        this account. EduRankAI is the technology platform; where a course leads to an award, that award is conferred by the
        accredited partner institution named on the course. This record is not a degree, a diploma, or a statement issued by a
        university, and should not be presented as one.
      </p>
    </div>
  </section>
</AquintutorLayout>
