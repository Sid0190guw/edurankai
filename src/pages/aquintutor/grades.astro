---
// /aquintutor/grades — the learner's own gradebook.
//
// The number at the top of each course is computed by the SAME pure function the instructor's
// gradebook uses (src/lib/lms/policy.ts courseGrade). That is the whole point of putting the
// arithmetic in a tested pure module: there is no second implementation to drift.
//
// TWO HONESTIES THIS PAGE INSISTS ON
//   1. Only POSTED grades appear. A grade an instructor has saved but not released does not exist
//      here, and no query on this page can reach one.
//   2. A category with nothing graded yet is NOT counted as zero. The page says how much of the
//      course is still ungraded rather than presenting a partial average as a final standing.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { gradeForLearner } from '@/lib/lms/gradebook';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/grades'));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const readFailures: string[] = [];
let enrolled: any[] = [];
try {
  enrolled = rows(await db.execute(sql`
    SELECT c.id, c.title, c.slug, COALESCE(c.credit_hours, 0) AS credit_hours
    FROM training_enrollments te JOIN training_courses c ON c.id = te.course_id
    WHERE te.user_id = ${user.id}
    UNION
    SELECT c.id, c.title, c.slug, COALESCE(c.credit_hours, 0) AS credit_hours
    FROM lms_section_members m JOIN lms_sections s ON s.id = m.section_id
    JOIN training_courses c ON c.id = s.course_id
    WHERE m.user_id = ${user.id} AND m.role = 'student' AND m.status = 'active'`));
} catch (e: any) {
  console.error('[aquintutor/grades] enrolled:', e?.cause?.message || e?.message);
  readFailures.push('your enrolled courses');
}

const courses: any[] = [];
for (const course of enrolled) {
  try {
    const grade = await gradeForLearner(course.id, user.id, { postedOnly: true });
    courses.push({ ...course, grade });
  } catch (e: any) {
    console.error('[aquintutor/grades] roll-up ' + course.slug + ':', e?.cause?.message || e?.message);
    readFailures.push('grades for ' + course.title);
  }
}

const withGrades = courses.filter((c) => c.grade.pct != null);
const overall = withGrades.length
  ? Math.round(withGrades.reduce((s, c) => s + c.grade.pct, 0) / withGrades.length)
  : null;
---
<AquintutorLayout title="Your grades" description="Every graded piece of work, and where each course stands." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1200px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor" style="color:var(--ink-500); text-decoration:none;">AQUINTUTOR</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">GRADES</span>
    </div>
  </div>

  <section style="max-width:1200px; margin:0 auto; padding:32px 28px 60px;">
    <div style="display:flex; align-items:end; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:26px;">
      <div>
        <h1 class="font-display" style="font-size:clamp(28px,4vw,40px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Your grades</h1>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:62ch; margin:0;">
          Only grades your instructor has released appear here. Where a course is part-marked, the figure is your standing
          <em>on the work graded so far</em> &mdash; the ungraded part is named, not counted as zero.
        </p>
      </div>
      {overall != null && (
        <div style="text-align:right;">
          <div class="font-display" style="font-size:40px; font-weight:500; line-height:1;">{overall}%</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500);">MEAN ACROSS {withGrades.length} COURSE(S)</div>
        </div>
      )}
    </div>

    {readFailures.length > 0 && (
      <div style="margin-bottom:22px; border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:13px 16px; font-family:'Inter Tight',sans-serif; font-size:13.5px; color:#7a2f1a;">
        Some of this page could not be read: {readFailures.join('; ')}. What is shown below is therefore incomplete.
      </div>
    )}

    {courses.length === 0 && (
      <div style="border:1px solid var(--rule); border-radius:12px; padding:44px 28px; text-align:center; background:var(--sand-50);">
        <h2 class="font-display" style="font-size:22px; font-weight:500; margin:0 0 8px;">No grades yet</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); margin:0;">
          Grades appear once you are enrolled and an instructor has released marked work.
        </p>
      </div>
    )}

    {courses.map((course) => (
      <div style="border:1px solid var(--rule); border-radius:12px; margin-bottom:20px; background:#fff; overflow:hidden;">
        <div style="padding:18px 22px; border-bottom:1px solid var(--rule); display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
          <div>
            <a href={'/aquintutor/courses/' + course.slug} class="font-display" style="font-size:19px; font-weight:500; color:var(--ink); text-decoration:none;">{course.title}</a>
            <div style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); margin-top:3px;">
              {course.grade.rows.filter((r: any) => r.points != null).length} of {course.grade.rows.length} pieces graded
              {course.grade.ungradedWeight > 0 ? ' · ' + course.grade.ungradedWeight + '% of the course weight is not graded yet' : ''}
            </div>
          </div>
          <div style="text-align:right;">
            <div class="font-display" style="font-size:26px; font-weight:500; line-height:1;">
              {course.grade.pct == null ? 'Not graded yet' : course.grade.pct + '%'}
            </div>
            {course.grade.pct != null && (
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.06em; color:var(--ink-500);">
                {course.grade.letter}{course.grade.complete ? '' : ' · SO FAR'}
              </div>
            )}
          </div>
        </div>

        {course.grade.categories.length > 1 && (
          <div style="padding:14px 22px; border-bottom:1px solid var(--rule); background:var(--sand-50); display:flex; gap:22px; flex-wrap:wrap;">
            {course.grade.categories.map((cat: any) => (
              <div>
                <div style="font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600;">{cat.name}</div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-500);">
                  {cat.pct == null ? 'not graded' : cat.pct + '%'} &middot; weight {cat.weight}%
                  {cat.dropped > 0 ? ' · lowest ' + cat.dropped + ' dropped' : ''}
                </div>
              </div>
            ))}
          </div>
        )}

        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:520px;">
            <thead>
              <tr style="text-align:left; background:var(--sand-50);">
                <th style="padding:10px 22px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">WORK</th>
                <th style="padding:10px 12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">SCORE</th>
                <th style="padding:10px 12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">PERCENT</th>
                <th style="padding:10px 22px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">RELEASED</th>
              </tr>
            </thead>
            <tbody>
              {course.grade.rows.map((row: any) => (
                <tr style="border-top:1px solid var(--rule);">
                  <td style="padding:11px 22px;">
                    <a href={'/aquintutor/assignments/' + row.assignment_id} style="color:var(--ink); text-decoration:none;">{row.title}</a>
                  </td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px;">
                    {row.excused ? 'excused' : (row.points == null ? '—' : Number(row.points) + ' / ' + Number(row.total))}
                  </td>
                  <td style="padding:11px 12px; font-family:'JetBrains Mono',monospace; font-size:13px;">
                    {row.pct == null || row.excused ? '—' : Number(row.pct) + '%'}
                  </td>
                  <td style="padding:11px 22px; font-size:13px; color:var(--ink-500);">
                    {row.graded_at ? new Date(row.graded_at).toISOString().slice(0, 10) : 'not yet'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin-top:26px; max-width:70ch;">
      A grade here is a record made by this platform. Where a course leads to a credential, that credential is awarded by the
      accredited partner named on the course, not by EduRankAI. Your full record is on your
      <a href="/aquintutor/transcript" style="color:var(--rust);">academic record</a>.
    </p>
  </section>
</AquintutorLayout>
