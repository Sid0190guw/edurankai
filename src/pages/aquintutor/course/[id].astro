---
// /aquintutor/course/[id] — THE COURSE AS A PLACE, FOR THE PEOPLE IN IT.
//
// /aquintutor/courses/[slug] is the public page: what this course is, who it is for, how to enrol.
// This is the other one — the room you are inside once you are enrolled. Announcements, the
// syllabus, the coursework, and a discussion that belongs to the COURSE rather than to one lesson.
//
// It is gated on enrolment, server side, in the first twenty lines. A person who is not on this
// course cannot read its discussion by knowing its id.
//
// Discussion lives here rather than on its own route, with ?topic=<id> opening a thread. One page,
// one POST handler, one gate — three routes would have meant repeating the gate three times, and a
// gate repeated is a gate that eventually differs.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { isEnrolled, mySectionId, teachClaim } from '@/lib/lms/access';
import { courseAnnouncements, getSyllabus, courseTopics, getTopic, createTopic, replyToTopic, markAnswer } from '@/lib/lms/course-home';
import { learnerBoard } from '@/lib/lms/assignments';
import { relativeDue, stateLabel, stateTone } from '@/lib/lms/policy';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user;
const courseId = String(Astro.params.id || '');
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/course/' + courseId));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

let course: any = null;
try {
  course = rows(await db.execute(sql`SELECT id, title, slug, subtitle, school FROM training_courses WHERE id = ${courseId} LIMIT 1`))[0] || null;
} catch (e: any) {
  console.error('[aquintutor/course] course:', e?.cause?.message || e?.message);
}
if (!course) return Astro.redirect('/aquintutor/courses');

const claim = await teachClaim(user, courseId);
const enrolled = await isEnrolled(user.id, courseId);
if (!enrolled && !claim.canTeach && !claim.canGrade) return Astro.redirect('/aquintutor/courses/' + course.slug);

const sectionId = await mySectionId(user.id, courseId);
const topicId = String(Astro.url.searchParams.get('topic') || '');

// Every const the POST handler reads is declared above it. const is not hoisted.
let flash = '';
let flashOk = false;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get('action') || '');
    if (action === 'topic') {
      const r = await createTopic({
        courseId,
        sectionId,
        title: String(form.get('title') || ''),
        body: String(form.get('body') || ''),
        kind: String(form.get('kind') || 'discussion'),
      }, user.id);
      flashOk = r.ok;
      flash = r.ok ? 'Topic posted.' : (r.error || 'Could not post the topic.');
    } else if (action === 'reply') {
      const r = await replyToTopic(String(form.get('topicId') || ''), String(form.get('body') || ''), user.id, String(form.get('parentId') || '') || null);
      flashOk = r.ok;
      flash = r.ok ? 'Reply posted.' : (r.error || 'Could not post your reply.');
    } else if (action === 'answer' && (claim.canTeach || claim.canGrade)) {
      await markAnswer(String(form.get('topicId') || ''), String(form.get('postId') || ''));
      flashOk = true;
      flash = 'Marked as the answer.';
    }
  } catch (e: any) {
    console.error('[aquintutor/course] POST:', e?.cause?.message || e?.message);
    flash = 'That did not go through: ' + (e?.cause?.message || e?.message || 'unknown error');
    flashOk = false;
  }
}

const announcements = await courseAnnouncements(courseId, sectionId, 8);
const syllabus = await getSyllabus(courseId, sectionId);
const topics = await courseTopics(courseId, sectionId, 30);
const thread = topicId ? await getTopic(topicId) : { topic: null, posts: [] };

let coursework: any[] = [];
try {
  const board = await learnerBoard(user.id, new Date());
  coursework = board.filter((b) => b.courseId === courseId);
} catch (e: any) {
  console.error('[aquintutor/course] coursework:', e?.cause?.message || e?.message);
}

const now = new Date();
---
<AquintutorLayout title={course.title} description={'Course home for ' + course.title} noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1200px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/courses" style="color:var(--ink-500); text-decoration:none;">COURSES</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">{String(course.title).toUpperCase()}</span>
      {claim.canTeach && (<span style="margin-left:12px; color:var(--ink-500);">YOU TEACH THIS ({claim.via.toUpperCase()})</span>)}
    </div>
  </div>

  <section style="max-width:1200px; margin:0 auto; padding:30px 28px 60px;">

    {flash && (
      <div style={'margin-bottom:20px; border:1px solid ' + (flashOk ? '#4a7048' : '#a8472c') + '; background:' + (flashOk ? '#f2f7f1' : '#fdf3f0') + '; border-radius:10px; padding:13px 16px; font-family:"Inter Tight",sans-serif; font-size:14px; color:' + (flashOk ? '#2f4a2d' : '#7a2f1a') + ';'}>{flash}</div>
    )}

    <div style="display:flex; align-items:end; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:26px;">
      <div>
        <h1 class="font-display" style="font-size:clamp(26px,3.6vw,38px); font-weight:500; letter-spacing:-0.02em; margin:0 0 6px;">{course.title}</h1>
        {course.subtitle && <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); margin:0; max-width:64ch;">{course.subtitle}</p>}
      </div>
      <div style="display:flex; gap:9px; flex-wrap:wrap; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
        <a href={'/aquintutor/courses/' + course.slug} style="padding:8px 15px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Lessons</a>
        <a href="/aquintutor/assignments" style="padding:8px 15px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Assignments</a>
        <a href="/aquintutor/grades" style="padding:8px 15px; border:1px solid var(--rule); border-radius:999px; color:var(--ink); text-decoration:none;">Grades</a>
        {claim.canTeach && (
          <a href={'/aquintutor/admin/lms/course-home?course=' + courseId} style="padding:8px 15px; background:var(--ink); color:var(--sand-50); border-radius:999px; text-decoration:none;">Teach</a>
        )}
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:20px; align-items:start;">

      <div style="display:flex; flex-direction:column; gap:20px;">
        <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
            <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Announcements</h2>
          </div>
          <div style="padding:16px 18px;">
            {announcements.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin:0;">Nothing posted yet.</p>}
            {announcements.map((a: any) => (
              <div style="border-bottom:1px solid var(--rule); padding-bottom:12px; margin-bottom:12px;">
                <div style="font-family:'Inter Tight',sans-serif; font-size:15px; font-weight:600;">{a.pinned ? 'Pinned: ' : ''}{a.title}</div>
                <div style="font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6; margin-top:5px; white-space:pre-wrap;">{a.body}</div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); margin-top:6px;">
                  {a.author_name || 'Course staff'} &middot; {new Date(a.published_at).toISOString().slice(0, 10)}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
            <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Your coursework here</h2>
          </div>
          <div style="padding:12px 14px;">
            {coursework.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin:4px;">No published assignments on this course yet.</p>}
            {coursework.map((item) => (
              <a href={'/aquintutor/assignments/' + item.id} style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:10px 6px; border-bottom:1px solid var(--rule); text-decoration:none; color:var(--ink); font-family:'Inter Tight',sans-serif; font-size:14px;">
                <span>{item.title}</span>
                <span style={'font-size:12.5px; color:' + stateTone(item.state) + ';'}>{stateLabel(item.state)} &middot; {relativeDue(item.dueAt, now)}</span>
              </a>
            ))}
          </div>
        </div>

        {syllabus && (
          <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
            <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
              <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Syllabus</h2>
            </div>
            <div style="padding:16px 18px; font-family:'Inter Tight',sans-serif; font-size:14px; line-height:1.7; white-space:pre-wrap;">{syllabus}</div>
          </div>
        )}
      </div>

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50); display:flex; align-items:center; justify-content:space-between; gap:10px;">
          <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Discussion</h2>
          {thread.topic && <a href={'/aquintutor/course/' + courseId} style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--rust); text-decoration:none;">All topics</a>}
        </div>

        {!thread.topic && (
          <div style="padding:14px 18px;">
            {topics.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin:0 0 14px;">No topics yet. Start the first one.</p>}
            {topics.map((t: any) => (
              <a href={'/aquintutor/course/' + courseId + '?topic=' + t.id} style="display:block; padding:11px 4px; border-bottom:1px solid var(--rule); text-decoration:none; color:var(--ink);">
                <div style="font-family:'Inter Tight',sans-serif; font-size:14.5px; font-weight:600;">
                  {t.pinned ? 'Pinned: ' : ''}{t.title}
                  {t.kind === 'question' && t.answer_count > 0 && <span style="margin-left:8px; font-size:11.5px; color:#4a7048; font-weight:500;">answered</span>}
                </div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); margin-top:4px;">
                  {t.reply_count} REPLIES &middot; {t.author_name || 'A learner'} &middot; {new Date(t.last_post_at).toISOString().slice(0, 10)}
                </div>
              </a>
            ))}

            <form method="POST" style="margin-top:18px; border-top:1px solid var(--rule); padding-top:16px;">
              <input type="hidden" name="action" value="topic" />
              <label for="t-title" style="display:block; font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600; margin-bottom:5px;">Start a topic</label>
              <input id="t-title" name="title" required minlength="4" placeholder="What is your question or point?" style="width:100%; padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:8px;" />
              <textarea name="body" rows="3" placeholder="Say more (optional)" style="width:100%; padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; resize:vertical; margin-bottom:8px;"></textarea>
              <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <select name="kind" style="padding:8px 10px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
                  <option value="discussion">Discussion</option>
                  <option value="question">Question</option>
                </select>
                <button type="submit" style="padding:9px 18px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Post</button>
              </div>
            </form>
          </div>
        )}

        {thread.topic && (
          <div style="padding:16px 18px;">
            <h3 class="font-display" style="font-size:18px; font-weight:500; margin:0 0 4px;">{thread.topic.title}</h3>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); margin-bottom:12px;">
              {thread.topic.author_name || 'A learner'} &middot; {new Date(thread.topic.created_at).toISOString().slice(0, 10)}
              {thread.topic.locked ? ' · LOCKED' : ''}
            </div>
            {thread.topic.body && <div style="font-family:'Inter Tight',sans-serif; font-size:14px; line-height:1.65; white-space:pre-wrap; margin-bottom:16px;">{thread.topic.body}</div>}

            {thread.posts.filter((p: any) => !p.hidden).map((p: any) => (
              <div style={'border-left:3px solid ' + (p.is_answer ? '#4a7048' : 'var(--rule)') + '; padding:8px 0 8px 12px; margin-bottom:12px;'}>
                <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); margin-bottom:4px;">
                  {p.author_name || 'A learner'} &middot; {new Date(p.created_at).toISOString().slice(0, 10)}{p.is_answer ? ' · ACCEPTED ANSWER' : ''}
                </div>
                <div style="font-family:'Inter Tight',sans-serif; font-size:14px; line-height:1.6; white-space:pre-wrap;">{p.body}</div>
                {(claim.canTeach || claim.canGrade) && !p.is_answer && (
                  <form method="POST" style="margin-top:6px;">
                    <input type="hidden" name="action" value="answer" />
                    <input type="hidden" name="topicId" value={thread.topic.id} />
                    <input type="hidden" name="postId" value={p.id} />
                    <button type="submit" style="padding:4px 10px; background:transparent; border:1px solid var(--rule); border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:12px; cursor:pointer;">Mark as the answer</button>
                  </form>
                )}
              </div>
            ))}
            {thread.posts.some((p: any) => p.hidden) && (
              <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">
                {thread.posts.filter((p: any) => p.hidden).length} reply(ies) hidden by a moderator.
              </p>
            )}

            {!thread.topic.locked && (
              <form method="POST" style="margin-top:14px; border-top:1px solid var(--rule); padding-top:14px;">
                <input type="hidden" name="action" value="reply" />
                <input type="hidden" name="topicId" value={thread.topic.id} />
                <textarea name="body" rows="3" required placeholder="Reply" style="width:100%; padding:10px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; resize:vertical; margin-bottom:8px;"></textarea>
                <button type="submit" style="padding:9px 18px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Reply</button>
              </form>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
</AquintutorLayout>
