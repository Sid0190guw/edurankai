---
// /aquintutor/alerts — in-app notification center (Prompt 18, main surface). Lightweight: server-
// rendered, no polling. Real events only. Preferences live at /aquintutor/settings.
export const prerender = false;
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { listNotifications } from '@/lib/edu-notify';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=/aquintutor/alerts');

// A FAILED READ IS NOT AN EMPTY INBOX. `.catch(() => [])` rendered "No notifications yet." when the
// query threw, so an unreachable database and a quiet week looked identical on the one screen whose
// job is to tell you that something happened. The reason is kept and shown. e.cause carries the real
// Postgres message; e.message is only the failed SQL.
let items: any[] = [];
let loadError = '';
try {
  items = await listNotifications(user.id, 50);
} catch (e: any) {
  loadError = String((e as any)?.cause?.message || (e as any)?.message || 'unknown error');
  console.error('[aquintutor/alerts] notification list failed:', loadError);
}
const unread = items.filter((n: any) => !n.read).length;
function fmt(d: any) { try { return new Date(d).toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch { return '-'; } }
const icon: Record<string, string> = { credential: 'var(--rust,#b3541e)', admission: '#5a5aa8', result: '#2f7d5b', deadline: '#8a5a1a', guardian: '#b3541e', general: '#8a8478' };
---
<AquintutorLayout title="Notifications">
  <main style="max-width:680px;margin:0 auto;padding:44px 22px 80px;">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px;">
      <h1 style="font-family:Fraunces,serif;font-size:30px;font-weight:600;color:var(--ink,#1a1712);margin:0;">Notifications{unread ? ' (' + unread + ')' : ''}</h1>
      {unread ? <button id="markRead" type="button" style="background:#fff;border:1px solid var(--line,#e6e1d6);color:var(--ink,#1a1712);border-radius:8px;padding:8px 14px;font-family:'Inter Tight',sans-serif;font-size:13px;font-weight:600;cursor:pointer;">Mark all read</button> : null}
    </div>
    {loadError && (
      <p style="font-family:'Inter Tight',sans-serif;font-size:14px;line-height:1.6;color:var(--ink,#1a1712);background:rgba(179,84,30,0.08);border:1px solid rgba(179,84,30,0.3);border-radius:10px;padding:12px 16px;margin:0 0 14px;overflow-wrap:anywhere;">
        Your notifications could not be loaded, so this list is empty for a reason that is not "nothing happened": {loadError}
      </p>
    )}
    <p id="markMsg" style="display:none;font-family:'Inter Tight',sans-serif;font-size:14px;line-height:1.6;color:var(--ink,#1a1712);background:rgba(179,84,30,0.08);border:1px solid rgba(179,84,30,0.3);border-radius:10px;padding:12px 16px;margin:0 0 14px;"></p>
    {items.length === 0 && !loadError ? <p style="font-family:'Inter Tight',sans-serif;font-size:15px;color:#6b6455;">No notifications yet.</p> :
      <div style="display:flex;flex-direction:column;gap:8px;">{items.map((n: any) => (
        <a href={n.link || '#'} style={'display:block;text-decoration:none;background:#fff;border:1px solid var(--line,#e6e1d6);border-left:3px solid ' + (icon[n.type] || '#8a8478') + ';border-radius:10px;padding:12px 16px;' + (n.read ? 'opacity:.7;' : '')}>
          <p style="font-family:'Inter Tight',sans-serif;font-size:14.5px;font-weight:600;color:var(--ink,#1a1712);margin:0;">{n.title}</p>
          {n.body ? <p style="font-family:'Inter Tight',sans-serif;font-size:13px;color:#6b6455;margin:3px 0 0;">{n.body}</p> : null}
          <p style="font-family:'Geist Mono',monospace;font-size:10.5px;color:#8a8478;margin:5px 0 0;">{n.type} · {fmt(n.at)}</p>
        </a>
      ))}</div>}
  </main>
  <script is:inline>
    // IT USED TO RELOAD WHATEVER CAME BACK. `.then(function () { location.reload(); })` ran on a 500
    // exactly as it ran on a success, so a failed mark-all-read redrew the page with everything still
    // unread and nothing on screen saying why. It reloads only on a confirmed change now, and says so
    // out loud when the server refused.
    (function () {
      var b = document.getElementById('markRead');
      var msg = document.getElementById('markMsg');
      function say(t) { if (msg) { msg.textContent = t; msg.style.display = 'block'; } }
      if (!b) return;
      b.addEventListener('click', function () {
        b.disabled = true;
        fetch('/api/aquintutor/notifications-read', { method: 'POST', credentials: 'same-origin' })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .then(function (d) {
            if (d && d.ok) { location.reload(); return; }
            b.disabled = false;
            say((d && d.error) || 'These could not be marked as read just now. Nothing has been lost.');
          })
          .catch(function () {
            b.disabled = false;
            say('Nothing was changed - the request never reached the server.');
          });
      });
    })();
  </script>
</AquintutorLayout>
