---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { db } from '@/lib/db';
import { users } from '@/lib/db/schema';
import { eq, sql } from 'drizzle-orm';
import { generateSessionToken, createSession } from '@/lib/auth/session';
import { setSessionCookie } from '@/lib/auth/cookie';
import { findUserByLoginIdentifier, verifyPasswordForLogin } from '@/lib/auth/handle';
import {
  isSecondStepRequired, availableSecondFactors, startPendingChallenge,
  resolvePendingChallenge, verifySecondFactor, dropPendingChallenge,
  pendingCookieName, verifyFaceSecondFactor, canCompleteSecondStep,
  PENDING_TTL_SECONDS, PENDING_COOKIE_SECURE,
  type SecondFactorMethod,
} from '@/lib/auth/two-factor';

if (Astro.locals.user) {
  return Astro.redirect('/aquintutor/dashboard');
}

// Declared before the handler that uses them - `const` is not hoisted.
const SURFACE = 'aquintutor' as const;
const PENDING_COOKIE = pendingCookieName(SURFACE);
const LEGACY_FACE_COOKIE = 'aquintutor_face_pending';

function setPendingCookie(cookies: any, token: string) {
  cookies.set(PENDING_COOKIE, token, {
    path: '/', httpOnly: true, sameSite: 'lax', secure: PENDING_COOKIE_SECURE, maxAge: PENDING_TTL_SECONDS,
  });
}
function clearPendingCookies(cookies: any) {
  cookies.delete(PENDING_COOKIE, { path: '/' });
  cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
}

let errorMsg = '';
let noticeMsg = '';
let requireSecondStep = false;
let pendingUserName = '';
let offerFace = false;
let offerCode = false;

// The half-finished sign-in is named by an opaque server-minted token. It used
// to be a raw user id in a cookie, which is client-settable - see the report.
let pendingToken = Astro.cookies.get(PENDING_COOKIE)?.value || '';

if (Astro.request.method === 'POST') {
  const fd2 = await Astro.request.formData();
  const action = (fd2.get('action') as string) || '';

  if (action === 'second_factor') {
    const method = ((fd2.get('method') as string) || 'totp') as SecondFactorMethod;
    const payload = method === 'face'
      ? ((fd2.get('live_descriptor') as string) || '')
      : ((fd2.get('code') as string) || '').trim();
    try {
      if (method === 'face') {
        const peek = await resolvePendingChallenge(pendingToken, SURFACE);
        if (peek) {
          const r = await verifyFaceSecondFactor(peek.userId, payload);
          await db.execute(sql`
            INSERT INTO identity_verifications (user_id, email, claimed_name, method, face_match_distance, face_match_passed, verdict, ip_address, user_agent)
            VALUES (${peek.userId}, ${''}, ${''}, 'face_login', ${Number.isFinite(r.distance) ? r.distance : null}, ${r.matched}, ${r.matched ? 'verified' : 'rejected'}, ${(Astro.clientAddress || '').toString().slice(0, 64) || null}, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500)})
          `).catch(() => {});
        }
      }
      const result = await verifySecondFactor(pendingToken, SURFACE, method, payload);
      if (!result.ok) {
        errorMsg = result.error;
        if (result.locked) { clearPendingCookies(Astro.cookies); pendingToken = ''; }
      } else {
        if (method === 'face') {
          await db.execute(sql`UPDATE user_face_enrollments SET last_used_at = NOW() WHERE user_id = ${result.userId}`).catch(() => {});
        }
        const token = generateSessionToken();
        const session = await createSession(token, result.userId, {
          userAgent: Astro.request.headers.get('user-agent') || undefined,
          ipAddress: Astro.clientAddress,
        });
        setSessionCookie(Astro.cookies, token, session.expiresAt);
        await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, result.userId)).catch(() => {});
        clearPendingCookies(Astro.cookies);
        return Astro.redirect('/aquintutor/dashboard');
      }
    } catch (e: any) {
      // Never swallowed - a bare catch in a login path hid an outage here once.
      console.error('[aquintutor/login second_factor]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Verification is temporarily unavailable. Please try again.';
    }
  } else if (action === 'cancel_face' || action === 'cancel_second_step') {
    await dropPendingChallenge(pendingToken).catch(() => {});
    clearPendingCookies(Astro.cookies);
    return Astro.redirect('/aquintutor/login');
  } else {
    const identifier = (fd2.get('email') as string || '').trim();
    const password = (fd2.get('password') as string) || '';
    if (!identifier || !password) {
      errorMsg = 'Enter your email or internal handle, and your password.';
    } else {
      try {
        const user = await findUserByLoginIdentifier(identifier);
        // scrypt runs whether or not the account exists, so an unknown handle
        // and a wrong password cost the same and answer the same.
        const ok = await verifyPasswordForLogin(user, password);
        if (!ok || !user || !user.isActive) {
          errorMsg = 'Invalid email or password.';
        } else {
          const methods = await availableSecondFactors(user.id);
          const optedIn = await isSecondStepRequired(user.id);
          // Pre-existing posture: a face on file meant a face challenge.
          const legacyFaceRule = methods.indexOf('face') >= 0;
          // A remaining recovery code is a completable second step too, so an
          // account whose only enrolled factor was cleared is still challenged
          // instead of being waved through on one factor. False only when nothing
          // is left at all - the one case where challenging would be a lockout.
          if ((optedIn || legacyFaceRule) && await canCompleteSecondStep(user.id)) {
            const t = await startPendingChallenge(user.id, SURFACE, 'password');
            setPendingCookie(Astro.cookies, t);
            return Astro.redirect('/aquintutor/login');
          }
          const token = generateSessionToken();
          const session = await createSession(token, user.id, {
            userAgent: Astro.request.headers.get('user-agent') || undefined,
            ipAddress: Astro.clientAddress,
          });
          setSessionCookie(Astro.cookies, token, session.expiresAt);
          await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, user.id)).catch(() => {});
          clearPendingCookies(Astro.cookies);
          return Astro.redirect('/aquintutor/dashboard');
        }
      } catch (e: any) {
        console.error('[aquintutor/login password]', e?.cause?.message || e?.message, e?.stack);
        errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
      }
    }
  }
}

if (pendingToken) {
  try {
    const pending = await resolvePendingChallenge(pendingToken, SURFACE);
    if (pending) {
      requireSecondStep = true;
      const u = await db.select({ name: users.name }).from(users).where(eq(users.id, pending.userId)).limit(1);
      pendingUserName = u[0]?.name || '';
      const methods = await availableSecondFactors(pending.userId);
      offerFace = methods.indexOf('face') >= 0;
      offerCode = methods.indexOf('totp') >= 0;
    } else {
      clearPendingCookies(Astro.cookies);
      pendingToken = '';
      if (!errorMsg) noticeMsg = 'That sign-in step expired. Please sign in again.';
    }
  } catch (e: any) {
    console.error('[aquintutor/login pending]', e?.cause?.message || e?.message, e?.stack);
    clearPendingCookies(Astro.cookies);
    pendingToken = '';
    errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
  }
}

// The enrolled descriptor is never sent to the browser; the server compares.
const showCamera = requireSecondStep && offerFace;
const showPasswordForm = !requireSecondStep;
---
<AquintutorLayout title="Sign in" description="Sign in to AquinTutor - the frontier research institution." noindex={true}>

  <section style="border-bottom:1px solid var(--rule); position:relative; overflow:hidden;">
    <div aria-hidden="true" style="position:absolute; right:-60px; top:60px; opacity:0.05; pointer-events:none;" class="hide-mobile">
      <svg width="320" height="320" viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="44" stroke="var(--ink)" stroke-width="0.4"/>
        <path d="M30 40 L50 60 L70 40" stroke="var(--ink)" stroke-width="0.4"/>
      </svg>
    </div>
    <div style="max-width:540px; margin:0 auto; padding:72px 28px 56px; position:relative; z-index:1;">

      <p style="font-family:'Inter Tight',sans-serif; font-size:12px; color:var(--rust); font-weight:600; letter-spacing:0.16em; text-transform:uppercase; margin:0 0 14px;">{requireSecondStep ? 'One more step' : 'Sign in'}</p>

      <h1 class="font-display" style="font-size:clamp(2rem, 5vw, 3.5rem); line-height:1.02; letter-spacing:-0.025em; font-weight:500; margin:0; color:var(--ink);">
        {requireSecondStep
          ? <>Welcome back,<br/><span style="font-style:italic; font-weight:300; color:var(--ink-500);">{pendingUserName}.</span></>
          : <>Continue your<br/><span style="font-style:italic; font-weight:300; color:var(--ink-500);">studies.</span></>}
      </h1>

      {errorMsg && (
        <div style="background:rgba(160,66,30,0.08); border:1px solid rgba(160,66,30,0.4); color:var(--rust); padding:12px 16px; border-radius:8px; margin-top:24px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">{errorMsg}</div>
      )}

      {noticeMsg && (
        <div style="background:rgba(160,66,30,0.05); border:1px solid rgba(160,66,30,0.25); color:var(--ink-500); padding:12px 16px; border-radius:8px; margin-top:24px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">{noticeMsg}</div>
      )}

      {showPasswordForm && (
        <form method="POST" style="margin-top:32px; display:flex; flex-direction:column; gap:18px;">
          <div>
            <label for="email" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); margin-bottom:6px; font-weight:600;">Email or internal handle</label>
            <input id="email" name="email" type="text" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" required autofocus style="width:100%; padding:11px 14px; min-height:48px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
          </div>
          <div>
            <label for="password" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); margin-bottom:6px; font-weight:600;">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required style="width:100%; padding:11px 14px; min-height:48px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'Inter Tight',sans-serif; font-size:15px; color:var(--ink); outline:none;" />
          </div>
          <button type="submit" style="margin-top:8px; background:var(--ink); color:var(--sand-50); padding:13px 24px; min-height:48px; border:none; border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer; align-self:flex-start;">Sign in</button>
        </form>
      )}

      {showCamera && (
        <div style="margin-top:32px; background:var(--paper); border:1px solid var(--rule); border-radius:14px; overflow:hidden;">
          <div style="background:#000; aspect-ratio:3/4; position:relative; max-height:380px;">
            <video id="videoEl" autoplay playsinline muted style="width:100%; height:100%; object-fit:cover; transform:scaleX(-1);"></video>
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none;">
              <div style="width:55%; aspect-ratio:3/4; border:2.5px solid rgba(160,66,30,0.7); border-radius:50%;"></div>
            </div>
            <div style="position:absolute; bottom:12px; left:0; right:0; text-align:center;">
              <span id="camStatus" style="background:rgba(0,0,0,0.75); color:#fff; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; padding:5px 14px; border-radius:100px;">Loading face model...</span>
            </div>
          </div>
          <button id="verifyBtn" type="button" disabled style="width:100%; border:none; font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; padding:16px; min-height:48px; cursor:pointer; background:var(--ink); color:var(--sand-50); border-radius:0;">Preparing camera</button>
        </div>
      )}

      {showCamera && (
        <form id="faceSuccessForm" method="POST" style="display:none;">
          <input type="hidden" name="action" value="second_factor"/>
          <input type="hidden" name="method" value="face"/>
          <input type="hidden" name="live_descriptor" id="liveDescriptorField" value=""/>
        </form>
      )}

      {requireSecondStep && (
        <form method="POST" style="margin-top:24px; display:flex; flex-direction:column; gap:14px;">
          <input type="hidden" name="action" value="second_factor"/>
          <input type="hidden" name="method" value="totp"/>
          <div>
            <label for="code" style="display:block; font-family:'Inter Tight',sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ink-500); margin-bottom:6px; font-weight:600;">{offerCode ? 'Authenticator code, or a recovery code' : 'Recovery code'}</label>
            <input id="code" name="code" type="text" inputmode="text" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="one-time-code" maxlength="16" required style="width:100%; padding:11px 14px; min-height:48px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); font-family:'JetBrains Mono',monospace; font-size:18px; letter-spacing:0.18em; text-align:center; color:var(--ink); outline:none;" />
          </div>
          <button type="submit" style="background:var(--ink); color:var(--sand-50); padding:13px 24px; min-height:48px; border:none; border-radius:6px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Verify</button>
        </form>
      )}

      {requireSecondStep && (
        <div style="text-align:center; margin-top:16px;">
          <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); margin:0 0 8px; line-height:1.6;">Lost your phone? Use one of the recovery codes you saved. Each one works once.</p>
          <form method="POST" style="display:inline;">
            <input type="hidden" name="action" value="cancel_second_step"/>
            <button type="submit" style="background:transparent; border:none; font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); cursor:pointer; text-decoration:underline; padding:12px; min-height:44px;">Use a different account</button>
          </form>
        </div>
      )}

      <div style="margin-top:40px; padding-top:24px; border-top:1px solid var(--rule); display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between;">
        <p style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:15px; color:var(--ink-500); margin:0;">No account yet?</p>
        <a href="/aquintutor/signup" style="background:transparent; color:var(--ink); padding:10px 18px; border-radius:6px; border:1px solid var(--ink); font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600; text-decoration:none;">Apply for admission</a>
      </div>

      <div style="margin-top:18px; display:flex; gap:18px; flex-wrap:wrap; font-family:'Inter Tight',sans-serif; font-size:12.5px;">
        <a href="/aquintutor/login" style="color:var(--ink-500); text-decoration:underline;">Forgot password</a>
        <a href="/aquintutor/profile" style="color:var(--ink-500); text-decoration:underline;">First-time identity setup</a>
      </div>
    </div>
  </section>

  {showCamera && (
    <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.min.js"></script>
  )}
  {showCamera && (
    <script is:inline>
    // The enrolled descriptor is NEVER sent to the browser. This captures a live
    // descriptor and posts it; the comparison and verdict happen server-side.
    (function () {
      var video = document.getElementById('videoEl');
      var verifyBtn = document.getElementById('verifyBtn');
      var statusEl = document.getElementById('camStatus');
      var form = document.getElementById('faceSuccessForm');
      var field = document.getElementById('liveDescriptorField');
      if (!video || !verifyBtn || !form || !field) return;
      var submitted = false;
      var stream = null;

      function setStatus(msg) { if (statusEl) statusEl.textContent = msg; }

      // THE CAMERA IS TURNED OFF EXPLICITLY, ON EVERY EXIT - before the descriptor
      // is posted, and whenever this page is left. Leaving it to the navigation
      // keeps the light on through the POST and the next render, and keeps it on
      // indefinitely for anyone who abandons the face step and types a code
      // instead. Nothing is stored either way; a camera still running after the
      // moment it was granted for is its own trust failure.
      function shutCamera() {
        try {
          if (stream) { stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); }
        } catch (_) {}
        stream = null;
        try { video.pause(); } catch (_) {}
        try { video.srcObject = null; } catch (_) {}
        try { video.removeAttribute('src'); } catch (_) {}
      }
      window.addEventListener('pagehide', shutCamera);

      async function init() {
        setStatus('Loading face model...');
        var MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
        await Promise.all([
          faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
          faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        video.srcObject = stream;
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify my face';
        verifyBtn.onclick = capture;
        setStatus('Position your face in the oval');
      }

      async function capture() {
        if (submitted) return;
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Checking';
        setStatus('Scanning...');
        try {
          var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
            .withFaceLandmarks(true).withFaceDescriptor();
          if (!det) {
            setStatus('No face detected. Try again in better light.');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Try again';
            return;
          }
          submitted = true;
          field.value = JSON.stringify(Array.prototype.slice.call(det.descriptor));
          // Camera off BEFORE anything is posted. The frame it came from is never
          // drawn to a canvas, never uploaded, and does not outlive this line.
          shutCamera();
          setStatus('Sending for verification...');
          form.submit();
        } catch (e) {
          setStatus('Camera error. Use a code instead.');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Try again';
        }
      }

      init().catch(function () {
        setStatus('Camera unavailable. Use a code instead.');
        verifyBtn.textContent = 'Camera unavailable';
      });
    })();
    </script>
  )}

</AquintutorLayout>
