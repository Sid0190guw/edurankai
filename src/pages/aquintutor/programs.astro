---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { programsByModel } from '@/lib/aquin-programs';

// The degree catalog, classified by delivery model (docs/aquintutor-university-model.md).
let groups: { model: any; programs: any[] }[] = [];
let regulated: any[] = [];
let total = 0;
try {
  const r = await programsByModel();
  groups = r.virtual;
  regulated = r.regulated;
  total = groups.reduce((n, g) => n + g.programs.length, 0) + regulated.length;
} catch (e) { /* renders the taxonomy even if the DB is unavailable */ }

const levelColor = (lvl: string) =>
  lvl === 'Master' ? '#1045BB' : lvl === 'Diploma' ? '#128a3f' : lvl === 'Certificate' ? '#8a5a00' : '#FF4F00';
---
<AquintutorLayout title="Degree Programs" description="AquinTutor's degree portfolio, classified by how each program is delivered — digital academics plus practical training through accredited partners.">
  <section style="max-width:1080px;margin:0 auto;padding:40px 20px 72px;">

    <p style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 8px;">Degree Programs</p>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,42px);font-weight:600;line-height:1.08;margin:0 0 14px;color:#141414;">Academics delivered digitally. Practical skills through trusted partners.</h1>
    <p style="font-size:16px;line-height:1.7;color:#3a3a3a;max-width:760px;margin:0 0 10px;">
      Every program below is classified by <strong>how it is delivered</strong> — the share taught online
      and the accredited partner that supplies the practical training. Students receive a world-class
      education without being disconnected from real-world experience, human interaction, or physical
      well-being.
    </p>
    {total > 0 && (
      <p style="font-size:13px;color:#6b6b6b;margin:0 0 4px;font-family:'Geist Mono',monospace;">{total} programs across {groups.length} delivery models{regulated.length > 0 ? (' + ' + regulated.length + ' regulated (hybrid)') : ''}</p>
    )}

    {groups.map((g) => (
      <div style="margin-top:40px;">
        <div style="display:flex;align-items:flex-start;gap:12px;border-bottom:2px solid #141414;padding-bottom:10px;margin-bottom:18px;flex-wrap:wrap;">
          <span style="font-family:'Fraunces',serif;font-size:26px;font-weight:600;color:#FF4F00;line-height:1;">{g.model.n}</span>
          <div style="flex:1;min-width:220px;">
            <h2 style="font-family:'Fraunces',serif;font-size:22px;font-weight:600;margin:0;color:#141414;line-height:1.15;">{g.model.title}</h2>
            <p style="font-size:13px;color:#5a5a5a;margin:3px 0 0;">Academics: {g.model.academics} &middot; Practical: {g.model.practical}</p>
          </div>
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-family:'Fraunces',serif;font-size:22px;font-weight:600;color:#128a3f;line-height:1;">{g.model.virtualPct}%</div>
            <div style="font-size:10.5px;color:#6b6b6b;text-transform:uppercase;letter-spacing:0.08em;">online</div>
          </div>
        </div>
        <p style="font-size:12.5px;color:#6b6b6b;margin:0 0 14px;"><strong style="color:#3a3a3a;">Practical partner:</strong> {g.model.partnerType}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;">
          {g.programs.map((p) => (
            <a href={`/aquintutor/programs/${p.slug}`} style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:13px 15px;background:#fff;text-decoration:none;color:inherit;display:block;transition:border-color .15s;">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                <h3 style="font-size:14.5px;font-weight:600;margin:0;color:#141414;line-height:1.3;">{p.name}</h3>
                <span style={`font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;padding:2px 7px;border-radius:100px;white-space:nowrap;flex-shrink:0;color:${levelColor(p.level)};background:${levelColor(p.level)}18;`}>{p.level}</span>
              </div>
              <p style="font-size:12px;color:#6b6b6b;margin:5px 0 0;">{p.discipline}</p>
            </a>
          ))}
        </div>
      </div>
    ))}

    {regulated.length > 0 && (
      <div style="margin-top:48px;">
        <div style="border-left:4px solid #8a5a00;background:#fdf8ef;border-radius:0 12px 12px 0;padding:18px 20px;">
          <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:0 0 6px;color:#141414;">Regulated professional qualifications (hybrid only)</h2>
          <p style="font-size:14px;line-height:1.65;color:#3a3a3a;margin:0 0 14px;max-width:760px;">
            These are regulated qualifications. Academic instruction is delivered digitally, but mandatory
            clinical and practical competencies are completed at accredited partner institutions, within
            the requirements of the relevant statutory regulators. AquinTutor offers them only within
            those requirements &mdash; it does not replace them.
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;">
            {regulated.map((p) => (
              <div style="border:1px solid rgba(138,90,0,0.25);border-radius:12px;padding:13px 15px;background:#fff;">
                <h3 style="font-size:15px;font-weight:700;margin:0;color:#141414;">{p.name}</h3>
                <p style="font-size:12px;color:#6b6b6b;margin:4px 0 0;line-height:1.5;">{p.regulatoryNote}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <div style="margin-top:44px;border-top:1px solid rgba(0,0,0,0.08);padding-top:20px;">
      <h2 style="font-family:'Fraunces',serif;font-size:18px;font-weight:600;margin:0 0 8px;color:#141414;">How delivery works</h2>
      <ul style="font-size:14px;line-height:1.75;color:#3a3a3a;margin:0;padding-left:18px;max-width:800px;">
        <li><strong>Digital-first academics</strong> &mdash; live and recorded classes, AI tutoring, real-time visualization and simulations, on a laptop, tablet or phone. No special hardware.</li>
        <li><strong>Immersive when it helps</strong> &mdash; AR/VR/XR is reserved for labs, anatomy, simulations and design visualization, not everyday teaching.</li>
        <li><strong>Practical through partners</strong> &mdash; industry, hospitals, research institutes, studios and field partners provide hands-on training; competencies are assessed jointly.</li>
        <li><strong>Holistic growth</strong> &mdash; local sports, wellness and community partners support physical, mental and social development alongside academics.</li>
      </ul>
    </div>

  </section>
</AquintutorLayout>
