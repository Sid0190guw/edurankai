---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { partnersByType } from '@/lib/aquin-partners';

let groups: { type: any; partners: any[] }[] = [];
let totalPartners = 0;
try { groups = await partnersByType(true); totalPartners = groups.reduce((n, g) => n + g.partners.length, 0); } catch (_) {}

const mouColor = (s: string) => s === 'active' ? '#128a3f' : s === 'mou_signed' ? '#1045BB' : s === 'paused' ? '#8a5a00' : '#6b6b6b';
const mouLabel = (s: string) => s === 'active' ? 'Active' : s === 'mou_signed' ? 'MoU signed' : s === 'paused' ? 'Paused' : 'Prospective';
---
<AquintutorLayout title="Partner Ecosystem" description="AquinTutor builds partnerships, not infrastructure. Practical competencies are completed at accredited partner institutions and assessed jointly.">
  <section style="max-width:1000px;margin:0 auto;padding:40px 20px 72px;">

    <p style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 8px;">Partner Ecosystem</p>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.1;margin:0 0 14px;color:#141414;">Partnerships, not infrastructure.</h1>
    <p style="font-size:16px;line-height:1.7;color:#3a3a3a;max-width:760px;margin:0 0 8px;">
      Rather than build every laboratory and hospital, AquinTutor partners with accredited institutions
      near each learner. Academic instruction is delivered digitally; practical competencies are
      completed at these partners and assessed jointly. Local sports, wellness and community partners
      support physical, mental and social development.
    </p>
    {totalPartners > 0 && (
      <p style="font-size:13px;color:#6b6b6b;font-family:'Geist Mono',monospace;margin:0;">{totalPartners} partner organizations across the ecosystem</p>
    )}

    {groups.map((g) => (
      <div style="margin-top:34px;">
        <div style="border-bottom:2px solid #141414;padding-bottom:8px;margin-bottom:14px;">
          <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:0;color:#141414;">{g.type.label}</h2>
          <p style="font-size:13px;color:#5a5a5a;margin:3px 0 0;">{g.type.blurb}</p>
        </div>
        {g.partners.length === 0 ? (
          <p style="font-size:13px;color:#8a8a8a;font-style:italic;margin:0;">This part of the network is being established. Partner organizations will be listed here as agreements are signed.</p>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;">
            {g.partners.map((p) => (
              <div style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:14px 15px;background:#fff;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                  <h3 style="font-size:14.5px;font-weight:600;margin:0;color:#141414;line-height:1.3;">{p.name}</h3>
                  <span style={`font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;padding:2px 7px;border-radius:100px;white-space:nowrap;flex-shrink:0;color:${mouColor(p.mouStatus)};background:${mouColor(p.mouStatus)}18;`}>{mouLabel(p.mouStatus)}</span>
                </div>
                {p.location && <p style="font-size:12px;color:#6b6b6b;margin:4px 0 0;">{p.location}</p>}
                {p.accreditation && <p style="font-size:11.5px;color:#128a3f;margin:3px 0 0;">Accredited: {p.accreditation}</p>}
                {p.description && <p style="font-size:12px;color:#5a5a5a;margin:6px 0 0;line-height:1.5;">{p.description}</p>}
              </div>
            ))}
          </div>
        )}
      </div>
    ))}

  </section>
</AquintutorLayout>
