---
// /aquintutor/admin/console — the AquinTutor admin overview, on AquinTutor's own identity.
//
// The landing page of the independent panel. Everything it counts is AquinTutor's: its accounts, its
// administrators, its courses. It gates on the AquinTutor principal through AquinAdminLayout, so an
// EduRankAI session — including the founder's — reaches nothing here.
//
// NOTE ON /aquintutor/admin (the Command Center next door): that page still gates on
// Astro.locals.user and is left running deliberately, because it works and carries live controls.
// It is the next thing to port. Until it is, this page says so rather than leaving somebody to
// discover two admins that answer to different sign-ins.
//
// const BEFORE THE HANDLER — `const` is not hoisted, and that has taken pages down here.
import AquinAdminLayout from '@/layouts/AquinAdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { aquinStore } from '@/lib/aquin/store';
import { AQUIN_TABLES } from '@/lib/aquin/schema';

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));
const gaps: string[] = [];

/** Named, independent, and a failure is reported rather than shown as a zero. */
async function figure(what: string, q: any): Promise<number | null> {
  try { return Number(rowsOf(await db.execute(q))[0]?.c ?? 0); }
  catch (e: any) {
    console.error('[aquin/console] ' + what + ' failed:', e?.cause?.message || e?.message);
    gaps.push(what);
    return null;                       // null renders as a dash. A zero would be a claim.
  }
}

const accounts = await figure('accounts', sql`SELECT COUNT(*)::int AS c FROM aq_users`);
const admins = await figure('administrators', sql`SELECT COUNT(DISTINCT user_id)::int AS c FROM aq_user_roles WHERE role_key IN ('super_admin','admin','teacher','partner','moderator')`);
const supers = await figure('super admins', sql`SELECT COUNT(*)::int AS c FROM aq_user_roles WHERE role_key = 'super_admin'`);
const live = await figure('live sessions', sql`SELECT COUNT(*)::int AS c FROM aq_sessions WHERE revoked_at IS NULL AND expires_at > NOW()`);
// Shared while the database is shared, and moving with AquinTutor at the split.
const courses = await figure('courses', sql`SELECT COUNT(*)::int AS c FROM training_courses`);
const learners = await figure('enrolments', sql`SELECT COUNT(*)::int AS c FROM training_enrollments`);

let missing: string[] = [];
try {
  const store = await aquinStore();
  const present = await store.presentTables();
  missing = AQUIN_TABLES.filter((t) => !present.includes(t));
} catch (e: any) {
  console.error('[aquin/console] table check failed:', e?.cause?.message || e?.message);
}

const CARD = 'background:#fff;border:1px solid rgba(14,11,8,0.12);border-radius:14px;padding:18px 20px;margin-bottom:18px;';
const show = (n: number | null) => (n === null ? '—' : String(n));

const TILES: { v: number | null; l: string; note: string }[] = [
  { v: accounts, l: 'AquinTutor accounts', note: 'Separate from EduRankAI' },
  { v: admins, l: 'With an admin role', note: 'Reach this panel' },
  { v: supers, l: 'Super admins', note: 'Can appoint administrators' },
  { v: live, l: 'Live sessions', note: 'Signed in right now' },
  { v: courses, l: 'Courses', note: 'Shared until the split' },
  { v: learners, l: 'Enrolments', note: 'Shared until the split' },
];
---

<AquinAdminLayout title="Overview" active="/aquintutor/admin/console">
  <h1 style="font-size:24px;margin:0 0 6px;">Overview</h1>
  <p style="font-size:13.5px;color:#6f665e;line-height:1.65;margin:0 0 20px;max-width:70ch;">
    You are signed in with an AquinTutor account. It is not connected to any EduRankAI account, and
    nothing on this panel can change anything there.
  </p>

  {gaps.length > 0 && (
    <div style={CARD + 'border-color:rgba(180,60,40,0.4);background:rgba(180,60,40,0.05);'}>
      <p style="margin:0;font-size:13.5px;color:#a04330;line-height:1.6;">
        These figures could not be read, and show a dash rather than a zero: {gaps.join(', ')}.
        A zero would be a claim that there are none.
      </p>
    </div>
  )}

  {missing.length > 0 && (
    <div style={CARD + 'border-color:rgba(230,120,0,0.45);background:rgba(230,120,0,0.06);'}>
      <p style="margin:0;font-size:13.5px;color:#8a5a10;line-height:1.6;">
        AquinTutor tables still missing: {missing.join(', ')}. Open
        <a href="/admin/aquintutor-bootstrap" style="color:#a8472c;"> the bootstrap page</a> to create them.
      </p>
    </div>
  )}

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:12px;margin-bottom:18px;">
    {TILES.map((t) => (
      <div style="background:#fff;border:1px solid rgba(14,11,8,0.12);border-radius:12px;padding:15px 16px;">
        <div style="font-size:28px;font-weight:800;letter-spacing:-0.02em;">{show(t.v)}</div>
        <div style="font-size:12.5px;color:#4a443e;margin-top:2px;">{t.l}</div>
        <div style="font-size:11px;color:#a89f96;margin-top:3px;">{t.note}</div>
      </div>
    ))}
  </div>

  <div style={CARD}>
    <p style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#8a7f76;margin:0 0 12px;">Where to go</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;">
      <a href="/aquintutor/admin/people" style="display:block;padding:13px 15px;border:1px solid rgba(168,71,44,0.3);border-radius:10px;text-decoration:none;">
        <div style="font-weight:700;font-size:14px;color:#a8472c;">People &amp; roles</div>
        <div style="font-size:12.5px;color:#6f665e;margin-top:3px;line-height:1.5;">Create AquinTutor accounts, grant and remove roles. Super admin only.</div>
      </a>
      <a href="/aquintutor/admin/courses" style="display:block;padding:13px 15px;border:1px solid rgba(14,11,8,0.12);border-radius:10px;text-decoration:none;">
        <div style="font-weight:700;font-size:14px;color:#0E0B08;">Courses</div>
        <div style="font-size:12.5px;color:#6f665e;margin-top:3px;line-height:1.5;">The catalogue and its authoring.</div>
      </a>
      <a href="/aquintutor/admin/teacher" style="display:block;padding:13px 15px;border:1px solid rgba(14,11,8,0.12);border-radius:10px;text-decoration:none;">
        <div style="font-weight:700;font-size:14px;color:#0E0B08;">Teaching</div>
        <div style="font-size:12.5px;color:#6f665e;margin-top:3px;line-height:1.5;">Lessons, learners, completion.</div>
      </a>
      <a href="/aquintutor/admin/partner" style="display:block;padding:13px 15px;border:1px solid rgba(14,11,8,0.12);border-radius:10px;text-decoration:none;">
        <div style="font-weight:700;font-size:14px;color:#0E0B08;">Partners</div>
        <div style="font-size:12.5px;color:#6f665e;margin-top:3px;line-height:1.5;">Catalogue, enrolments, settlements.</div>
      </a>
      <!-- Linked from here rather than the nav: the shell's menu lives in src/layouts, which is not
           edited without the owner's say-so. -->
      <a href="/aquintutor/admin/mind" style="display:block;padding:13px 15px;border:1px solid rgba(14,11,8,0.12);border-radius:10px;text-decoration:none;">
        <div style="font-weight:700;font-size:14px;color:#0E0B08;">The Mind</div>
        <div style="font-size:12.5px;color:#6f665e;margin-top:3px;line-height:1.5;">The platform's own model: what it learned from, what it trained, and every time it refused to promote.</div>
      </a>
    </div>
  </div>

  <!-- SAID PLAINLY, because two admins answering to different sign-ins is the kind of thing that
       wastes an afternoon if nobody writes it down. -->
  <div style={CARD}>
    <p style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#8a7f76;margin:0 0 10px;">Still on the old sign-in</p>
    <p style="margin:0;font-size:13px;color:#6f665e;line-height:1.65;">
      The pages linked above other than People &amp; roles still gate on an EduRankAI session, and the
      Command Center at <a href="/aquintutor/admin" style="color:#a8472c;">/aquintutor/admin</a> does
      too. They work and they are being ported onto this account one at a time. Until a page is
      ported, opening it may ask you to sign in to EduRankAI instead — that is the port outstanding,
      not a fault.
    </p>
  </div>
</AquinAdminLayout>
