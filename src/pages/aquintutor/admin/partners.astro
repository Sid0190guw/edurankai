---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { PARTNER_TYPES, MOU_STATUS, listPartners, addPartner, partnerTypeLabel } from '@/lib/aquin-partners';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=/aquintutor/admin/partners');
if (user.role === 'applicant') return Astro.redirect('/portal');
const isAdmin = ['super_admin', 'hr', 'editor', 'admin'].includes(user.role as string);
if (!isAdmin) return Astro.redirect('/aquintutor');

let msg = '', err = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const r = await addPartner({
    name: String(fd.get('name') || ''), type: String(fd.get('type') || 'academic'),
    accreditation: String(fd.get('accreditation') || ''), location: String(fd.get('location') || ''),
    capacity: fd.get('capacity') ? Number(fd.get('capacity')) : null,
    mouStatus: String(fd.get('mou_status') || 'prospective'), website: String(fd.get('website') || ''),
    description: String(fd.get('description') || ''), createdBy: String(user.id),
  });
  if (r.ok) msg = 'Partner added.'; else err = r.error || 'Could not add partner.';
}

let partners: any[] = [];
try { partners = await listPartners(); } catch (_) {}
const inp = 'width:100%;padding:9px 11px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:13px;font-family:inherit;';
---
<AquintutorLayout title="Partners — Admin" noindex={true}>
  <section style="max-width:900px;margin:0 auto;padding:32px 20px 72px;">
    <a href="/aquintutor/admin" style="font-size:12.5px;color:#6b6b6b;text-decoration:none;font-family:'Geist Mono',monospace;">&larr; AquinTutor admin</a>
    <h1 style="font-family:'Fraunces',serif;font-size:28px;font-weight:600;margin:12px 0 4px;color:#141414;">Partner registry</h1>
    <p style="font-size:14px;color:#5a5a5a;margin:0 0 20px;">Accredited institutions that deliver practical training. Shown publicly on the partner-ecosystem page.</p>

    {msg && <div style="background:#e7f6ec;border:1px solid #86efac;color:#166534;border-radius:10px;padding:10px 14px;font-size:13px;margin-bottom:14px;">{msg}</div>}
    {err && <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:10px;padding:10px 14px;font-size:13px;margin-bottom:14px;">{err}</div>}

    <form method="POST" style="background:#f7f6f2;border-radius:14px;padding:18px 20px;margin-bottom:26px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div style="grid-column:1/3;"><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Name *</label><input name="name" required style={inp} placeholder="e.g. City General Teaching Hospital" /></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Category</label><select name="type" style={inp}>{PARTNER_TYPES.map((t) => (<option value={t.key}>{t.label}</option>))}</select></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">MoU status</label><select name="mou_status" style={inp}>{MOU_STATUS.map((m) => (<option value={m.key}>{m.label}</option>))}</select></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Location</label><input name="location" style={inp} placeholder="City, State" /></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Capacity (seats)</label><input name="capacity" type="number" min="0" style={inp} /></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Accreditation</label><input name="accreditation" style={inp} placeholder="e.g. NABH / NAAC / ISO" /></div>
      <div><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Website</label><input name="website" style={inp} placeholder="https://" /></div>
      <div style="grid-column:1/3;"><label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b6b6b;">Description</label><textarea name="description" rows="2" style={inp}></textarea></div>
      <div style="grid-column:1/3;"><button type="submit" style="background:#141414;color:#fff;border:none;font-size:13px;font-weight:600;padding:11px 22px;border-radius:9px;cursor:pointer;">Add partner</button></div>
    </form>

    <h2 style="font-family:'Fraunces',serif;font-size:18px;font-weight:600;margin:0 0 12px;color:#141414;">Registered partners ({partners.length})</h2>
    {partners.length === 0 ? (
      <p style="font-size:13px;color:#8a8a8a;font-style:italic;">No partners yet. Add the first accredited institution above.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:8px;">
        {partners.map((p) => (
          <div style="border:1px solid rgba(0,0,0,0.10);border-radius:10px;padding:11px 14px;display:flex;justify-content:space-between;gap:10px;align-items:center;background:#fff;">
            <div><span style="font-size:14px;font-weight:600;color:#141414;">{p.name}</span> <span style="font-size:11px;color:#6b6b6b;">&middot; {partnerTypeLabel(p.type)}{p.location ? ' · ' + p.location : ''}</span></div>
            <span style="font-size:10px;font-weight:700;text-transform:uppercase;color:#6b6b6b;">{p.mouStatus.replace('_', ' ')}</span>
          </div>
        ))}
      </div>
    )}
  </section>
</AquintutorLayout>
