---
// /aquintutor/admin/lms/media — WHERE A VIDEO COMES FROM.
//
// Two questions an author has, answered on one screen.
//
//   1. "Will this link work?" — paste it, and the SAME function that runs on save tells you what it
//      resolved to, what the learner will actually get, and any sharing setting you still have to
//      fix. A checker that used looser rules than the save path would be worse than no checker,
//      because it would promise a playable lesson and then refuse it.
//
//   2. "Can I just upload the file?" — now yes, and honestly. The file goes from the browser
//      straight to object storage through a signed, single-object, few-minute authorisation. It
//      does not pass through this server, which is the only reason a full-length lecture can move
//      at all: a serverless request body is capped at a few megabytes and no amount of chunking
//      inside the function changes that.
//
// NO BRAND NAMES ANYWHERE ON THIS PAGE. The provider list is an internal enum and the descriptions
// are generic by construction (src/lib/video-embed.ts). That is also why there is no printed list
// of "supported sites": the checker is the list, and it is always current.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { resolveVideoLink, describeVideoLink } from '@/lib/video-embed';
import { directUploadStatus } from '@/lib/storage';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms/media'));

const courses = await myTaughtCourses(user);
const courseId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const claim = courseId ? await teachClaim(user, courseId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };

// Declared before the POST handler that reads them. `const` is not hoisted.
let checked: any = null;
let checkedInput = '';
let checkedAllowLinkOut = false;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    checkedInput = String(form.get('url') || '').trim();
    checkedAllowLinkOut = String(form.get('allowLinkOut') || '') === 'on';
    if (checkedInput) {
      const r = resolveVideoLink(checkedInput, { allowLinkOut: checkedAllowLinkOut });
      checked = {
        ok: r.ok,
        message: describeVideoLink(r),
        kind: r.ok ? r.kind : null,
        mediaKind: r.ok ? (r.mediaKind || null) : null,
        needsStreamPlayer: r.ok ? !!r.needsStreamPlayer : false,
        warning: r.ok ? (r.warning || null) : null,
        embedUrl: r.ok ? r.embedUrl : null,
        sandbox: r.ok ? r.sandbox : '',
        allow: r.ok ? r.allow : '',
        referrerPolicy: r.ok ? r.referrerPolicy : '',
        canLinkOut: !r.ok ? r.canLinkOut : false,
      };
    }
  } catch (e: any) {
    console.error('[admin/lms/media] POST:', e?.cause?.message || e?.message);
    checked = { ok: false, message: 'The check itself failed: ' + (e?.cause?.message || e?.message || 'unknown error') };
  }
}

const storage = directUploadStatus();

// What a learner ends up with, said in words rather than in an enum.
const KIND_WORDS: Array<{ key: string; label: string }> = [
  { key: 'embed', label: 'It plays inside the lesson, in a locked-down frame.' },
  { key: 'file', label: 'It plays inside the lesson, in a media element with no script context at all.' },
  { key: 'internal', label: 'It opens inside the lesson — this is a page on this platform.' },
  { key: 'link', label: 'Learners get a button that opens it in a new tab. It cannot be shown inside the page.' },
];
function kindWords(kind: string | null): string {
  const hit = KIND_WORDS.find((k) => k.key === kind);
  return hit ? hit.label : '';
}
const MEDIA_WORDS: Array<{ key: string; label: string }> = [
  { key: 'video', label: 'a video file' },
  { key: 'audio', label: 'sound only — no picture' },
  { key: 'hls', label: 'an adaptive stream' },
  { key: 'dash', label: 'an adaptive stream' },
];
function mediaWords(kind: string | null): string {
  const hit = MEDIA_WORDS.find((k) => k.key === kind);
  return hit ? hit.label : '';
}
---
<AquintutorLayout title="Video and audio sources" description="Check a link, or upload a file." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1200px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin/lms" style="color:var(--ink-500); text-decoration:none;">TEACHING</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">VIDEO AND AUDIO</span>
    </div>
  </div>

  <section style="max-width:1200px; margin:0 auto; padding:30px 28px 60px;">

    <h1 class="font-display" style="font-size:clamp(26px,3.6vw,36px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Video and audio sources</h1>
    <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:66ch; margin:0 0 26px;">
      A lesson's media can come from a link on almost any hosting service, from a file in a shared drive, from a direct file or
      stream address, or from a file you upload here. Paste an address below and this will tell you exactly what a learner will
      get &mdash; using the same code that runs when you save, so it cannot promise something the save then refuses.
    </p>

    <form method="GET" style="margin-bottom:24px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <select name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:250px;">
        {courses.map((c: any) => (<option value={c.id} selected={c.id === courseId}>{c.title}</option>))}
      </select>
      <button type="submit" style="padding:9px 16px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch course</button>
    </form>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:22px; align-items:start;">

      <!-- ------------------------------------------------------------------ the checker -->
      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Check an address</h2>
        </div>
        <form method="POST" style="padding:18px;">
          <label for="url" style="display:block; font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600; margin-bottom:5px;">Paste the address</label>
          <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); margin:0 0 8px;">
            Copy it from the browser bar of the page the video actually plays on &mdash; not from a channel, a search, or a folder.
          </p>
          <input id="url" name="url" value={checkedInput} placeholder="https://..." style="width:100%; padding:10px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'JetBrains Mono',monospace; font-size:12.5px; margin-bottom:10px;" />
          <label style="display:flex; align-items:center; gap:8px; font-family:'Inter Tight',sans-serif; font-size:13px; margin-bottom:12px;">
            <input type="checkbox" name="allowLinkOut" checked={checkedAllowLinkOut} />
            If it cannot be played inside the page, save it as a link that opens elsewhere
          </label>
          <button type="submit" style="padding:10px 20px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Check it</button>
        </form>

        {checked && (
          <div style={'padding:16px 18px; border-top:1px solid var(--rule); background:' + (checked.ok ? '#f7faf6' : '#fdf3f0') + ';'}>
            <div style={'font-family:"Inter Tight",sans-serif; font-size:14px; font-weight:600; color:' + (checked.ok ? '#2f4a2d' : '#7a2f1a') + '; margin-bottom:6px;'}>
              {checked.ok ? 'Recognised' : 'Not accepted'}
            </div>
            <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6; margin:0 0 8px;">{checked.message}</p>
            {checked.ok && (
              <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0 0 8px;">
                {kindWords(checked.kind)}
                {checked.mediaKind ? ' The address is ' + mediaWords(checked.mediaKind) + '.' : ''}
              </p>
            )}
            {checked.warning && (
              <p style="font-family:'Inter Tight',sans-serif; font-size:13px; line-height:1.6; margin:0 0 8px; border-left:3px solid #a87526; padding-left:10px; color:#6d4d12;">
                {checked.warning}
              </p>
            )}
            {!checked.ok && checked.canLinkOut && (
              <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0 0 8px;">
                It is a safe public address, so you can still save it as a link that opens elsewhere &mdash; tick the box above and check again.
              </p>
            )}

            {checked.ok && checked.kind === 'embed' && (
              <div style="margin-top:10px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin-bottom:6px;">WHAT THE LEARNER SEES</div>
                <iframe src={checked.embedUrl} title="Preview" loading="lazy" sandbox={checked.sandbox} allow={checked.allow} referrerpolicy={checked.referrerPolicy} allowfullscreen style="width:100%; aspect-ratio:16/9; border:1px solid var(--rule); border-radius:8px; background:#000;"></iframe>
              </div>
            )}
            {checked.ok && checked.kind === 'file' && checked.mediaKind === 'audio' && (
              <div style="margin-top:10px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin-bottom:6px;">WHAT THE LEARNER HEARS</div>
                <audio controls preload="none" src={checked.embedUrl} style="width:100%;"></audio>
              </div>
            )}
            {checked.ok && checked.kind === 'file' && checked.mediaKind !== 'audio' && (
              <div style="margin-top:10px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin-bottom:6px;">WHAT THE LEARNER SEES</div>
                <video controls preload="metadata" src={checked.embedUrl} style="width:100%; aspect-ratio:16/9; border:1px solid var(--rule); border-radius:8px; background:#000;"></video>
                {checked.needsStreamPlayer && (
                  <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:#6d4d12; margin:8px 0 0;">
                    If this preview stays black, your browser is one of the ones that cannot play this format unaided. That is
                    exactly what a learner on the same browser would see, which is why the lesson also gives them a button.
                  </p>
                )}
              </div>
            )}
            {checked.ok && (
              <div style="margin-top:12px; font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--ink-500); word-break:break-all;">
                ADDRESS WE BUILT: {checked.embedUrl}
              </div>
            )}
          </div>
        )}
      </div>

      <!-- ------------------------------------------------------------------ the uploader -->
      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Upload a file</h2>
        </div>
        <div style="padding:18px;">
          {!storage.available && (
            <div style="border:1px solid #a87526; background:#fdf8ef; border-radius:8px; padding:13px 15px; font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6; color:#6d4d12;">
              <strong>Uploading is not switched on.</strong>
              <div style="margin-top:6px;">{storage.reason}</div>
              <div style="margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:11px;">ACTIVE BACKEND: {storage.backend.toUpperCase()}</div>
            </div>
          )}

          {storage.available && !claim.canTeach && (
            <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:#7a2f1a; margin:0;">
              You do not have teaching access to the selected course, so you cannot upload media to it.
            </p>
          )}

          {storage.available && claim.canTeach && (
            <div>
              <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.6; margin:0 0 12px;">
                The file goes from this browser straight to storage &mdash; it does not pass through the site, which is the only
                reason a full-length recording can be sent at all. Video or audio, up to 5&nbsp;GB. When it finishes you get an
                address to paste into the lesson.
              </p>
              <input type="file" id="mediaFile" accept="video/*,audio/*" style="width:100%; padding:10px; border:1px dashed var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:13px; margin-bottom:10px;" />
              <button type="button" id="uploadBtn" data-course={courseId} style="padding:10px 20px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Upload</button>
              <div id="uploadState" style="margin-top:12px; font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6;"></div>
              <div id="uploadBarWrap" style="display:none; margin-top:8px; height:8px; background:var(--sand-100); border-radius:999px; overflow:hidden;">
                <div id="uploadBar" style="height:100%; width:0%; background:var(--rust); transition:width .15s linear;"></div>
              </div>
              <div id="uploadResult" style="margin-top:12px;"></div>
            </div>
          )}
        </div>
      </div>
    </div>

    <div style="margin-top:24px; border:1px solid var(--rule); border-radius:12px; background:var(--sand-50); padding:18px 22px;">
      <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0 0 8px;">Two things worth knowing before you publish</h2>
      <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.65; color:var(--ink-500); margin:0 0 8px;">
        <strong>A drive file that plays for you may not play for anybody else.</strong> We cannot open your file to check its
        sharing setting, so where one applies the checker says so in words. A link set to "only people I choose" shows every
        learner a sign-in screen where the lesson should be.
      </p>
      <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.65; color:var(--ink-500); margin:0;">
        <strong>A meeting invitation is not a recording.</strong> Those are refused on purpose &mdash; they expire, and they send
        learners into a room with nobody in it. A recording of that meeting, on the other hand, is accepted.
      </p>
    </div>
  </section>

  <script is:inline>
    // The only script on this page. It exists because a 2 GB file cannot be sent through a form
    // post: we ask the server to authorise one object, then PUT the bytes straight to storage with
    // a progress bar. If this never runs, the checker above still works and nothing is broken —
    // the page simply has no uploader, which is exactly the state it was in before.
    (function () {
      var btn = document.getElementById('uploadBtn');
      var file = document.getElementById('mediaFile');
      var state = document.getElementById('uploadState');
      var barWrap = document.getElementById('uploadBarWrap');
      var bar = document.getElementById('uploadBar');
      var result = document.getElementById('uploadResult');
      if (!btn || !file) return;

      function say(msg, tone) {
        state.textContent = msg;
        state.style.color = tone === 'bad' ? '#7a2f1a' : (tone === 'good' ? '#2f4a2d' : '#6b5f4c');
      }

      btn.addEventListener('click', async function () {
        var f = file.files && file.files[0];
        if (!f) { say('Choose a file first.', 'bad'); return; }
        result.innerHTML = '';
        btn.disabled = true;
        say('Asking for permission to upload ' + (f.size / 1048576).toFixed(1) + ' MB...');

        var signed;
        try {
          var res = await fetch('/api/aquintutor/lms/upload-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ courseId: btn.getAttribute('data-course'), filename: f.name, contentType: f.type, sizeBytes: f.size }),
          });
          signed = await res.json();
          if (!signed || !signed.ok) { say(signed && signed.error ? signed.error : 'The upload was not authorised.', 'bad'); btn.disabled = false; return; }
        } catch (e) {
          say('Could not reach the server to authorise the upload.', 'bad');
          btn.disabled = false;
          return;
        }

        barWrap.style.display = 'block';
        say('Uploading. This window has to stay open until it finishes.');

        // XHR rather than fetch, for one reason: it reports upload progress and fetch does not.
        var xhr = new XMLHttpRequest();
        xhr.open('PUT', signed.uploadUrl, true);
        if (signed.contentType) xhr.setRequestHeader('Content-Type', signed.contentType);
        xhr.upload.onprogress = function (ev) {
          if (!ev.lengthComputable) return;
          var pct = Math.round((ev.loaded / ev.total) * 100);
          bar.style.width = pct + '%';
          say('Uploading — ' + pct + '%');
        };
        xhr.onload = function () {
          btn.disabled = false;
          if (xhr.status >= 200 && xhr.status < 300) {
            bar.style.width = '100%';
            say('Uploaded. Checking that learners can actually read it...');
            result.innerHTML =
              '<div style="font-family:\'Inter Tight\',sans-serif;font-size:13px;margin-bottom:6px;">Paste this address into the lesson\'s video field:</div>' +
              '<input readonly value="' + signed.publicUrl.replace(/"/g, '&quot;') + '" style="width:100%;padding:9px 11px;border:1px solid #d9d2c2;border-radius:7px;font-family:\'JetBrains Mono\',monospace;font-size:12px;" onclick="this.select()" />' +
              '<div id="readback" style="font-family:\'Inter Tight\',sans-serif;font-size:12.5px;margin-top:8px;color:#6b5f4c;"></div>';

            // A SUCCESSFUL UPLOAD IS NOT THE SAME FACT AS A PLAYABLE LESSON, and the difference is a
            // bucket that is writable by us and not readable by the public. Nothing in the upload
            // path can see that: the PUT succeeds either way, and the failure appears weeks later as
            // a black rectangle in front of a cohort. So we actually try to read it back, with a
            // media element rather than fetch() — playback is not subject to the cross-origin rules
            // that would make a fetch() probe answer the wrong question.
            var probe = document.createElement(/^audio\//.test(signed.contentType || '') ? 'audio' : 'video');
            var readback = document.getElementById('readback');
            var settled = false;
            var finish = function (msg, tone) {
              if (settled) return;
              settled = true;
              readback.textContent = msg;
              readback.style.color = tone === 'bad' ? '#7a2f1a' : '#2f4a2d';
              say(tone === 'bad' ? 'Uploaded, but not readable yet.' : 'Uploaded and readable.', tone === 'bad' ? 'bad' : 'good');
              probe.removeAttribute('src');
            };
            probe.preload = 'metadata';
            probe.muted = true;
            probe.addEventListener('loadedmetadata', function () {
              finish('Read back successfully — a learner\'s browser can play this address.', 'good');
            });
            probe.addEventListener('error', function () {
              finish('The file uploaded, but this address could not be read back. That almost always means the bucket is not publicly readable — fix that before you use this in a lesson, or learners will see a black rectangle.', 'bad');
            });
            probe.src = signed.publicUrl;
            setTimeout(function () {
              finish('The file uploaded, but the read-back check did not answer in time. Open the address above in a new tab before you rely on it.', 'bad');
            }, 15000);
          } else {
            // Never silent. A storage rejection is a real answer and the author needs the status.
            say('Storage refused the upload (status ' + xhr.status + '). The authorisation may have expired — try again.', 'bad');
          }
        };
        xhr.onerror = function () {
          btn.disabled = false;
          say('The upload failed before it finished. Nothing was saved.', 'bad');
        };
        xhr.send(f);
      });
    })();
  </script>
</AquintutorLayout>
