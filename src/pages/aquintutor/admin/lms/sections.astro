---
// /aquintutor/admin/lms/sections — TERMS, COHORTS AND WHO IS IN THEM.
//
// "Who is in my class" had no answer in this codebase before L3: `cohort` existed only as a label
// on an access window (src/lib/course-access.ts), meaning "this course opens on the 3rd", never a
// group anybody belonged to. A section is that group, and every roster below is a real membership
// row with a role and a status.
//
// DROPPING SOMEBODY DOES NOT DELETE THEM. The membership row is kept with status = dropped, because
// their submissions and grades reference it and because "left in week nine" is a fact the section
// history needs. There is no destructive button on this page.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { listTerms, saveTerm, courseSections, saveSection, sectionRoster, addToRoster, setRosterStatus, getSection } from '@/lib/lms/sections';
import { parseRosterCsv, importRoster } from '@/lib/lms/interop';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms/sections'));

const courses = await myTaughtCourses(user);
const courseId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const openSectionId = String(Astro.url.searchParams.get('section') || '');
const claim = courseId ? await teachClaim(user, courseId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };

// Declared before the POST handler. const is not hoisted.
let flash = '';
let flashOk = false;
let importReport: { added: number; alreadyThere: number; noAccount: string[]; badLines: Array<{ line: number; text: string; reason: string }> } | null = null;

if (Astro.request.method === 'POST') {
  if (!claim.canAdminister) {
    flash = 'Changing terms, sections or rosters needs administering access to this course.';
  } else {
    try {
      const form = await Astro.request.formData();
      const action = String(form.get('action') || '');

      if (action === 'term') {
        const r = await saveTerm({
          id: String(form.get('termId') || '') || null,
          code: String(form.get('code') || ''),
          title: String(form.get('title') || ''),
          startsOn: String(form.get('startsOn') || '') || null,
          endsOn: String(form.get('endsOn') || '') || null,
          addDropUntil: String(form.get('addDropUntil') || '') || null,
        });
        flashOk = r.ok;
        flash = r.ok ? 'Term saved.' : (r.error || 'Could not save the term.');
      } else if (action === 'section') {
        const r = await saveSection({
          id: String(form.get('sectionId') || '') || null,
          courseId,
          termId: String(form.get('termId') || '') || null,
          code: String(form.get('code') || ''),
          title: String(form.get('title') || '') || null,
          capacity: form.get('capacity') ? Number(form.get('capacity')) : null,
          delivery: String(form.get('delivery') || 'online'),
          meets: String(form.get('meets') || '') || null,
        }, user.id);
        flashOk = r.ok;
        flash = r.ok ? 'Section saved.' : (r.error || 'Could not save the section.');
      } else if (action === 'add') {
        const r = await addToRoster(String(form.get('sectionId') || ''), String(form.get('email') || ''), String(form.get('role') || 'student'), user.id);
        flashOk = r.ok;
        flash = r.ok ? 'Added to the roster.' : (r.error || 'Could not add that person.');
      } else if (action === 'status') {
        await setRosterStatus(String(form.get('memberId') || ''), String(form.get('status') || 'active'));
        flashOk = true;
        flash = 'Roster updated. The membership row is kept, not deleted.';
      } else if (action === 'import') {
        const parsed = parseRosterCsv(String(form.get('csv') || ''));
        const result = await importRoster(String(form.get('sectionId') || ''), parsed.rows, user.id);
        importReport = { ...result, badLines: parsed.errors };
        flashOk = true;
        flash = 'Imported ' + result.added + ' of ' + parsed.rows.length + ' readable line(s).';
      }
    } catch (e: any) {
      console.error('[admin/lms/sections] POST:', e?.cause?.message || e?.message);
      flash = 'That did not save: ' + (e?.cause?.message || e?.message || 'unknown error');
      flashOk = false;
    }
  }
}

const terms = await listTerms();
const sections = courseId ? await courseSections(courseId) : [];
const openSection = openSectionId ? await getSection(openSectionId) : null;
const roster = openSectionId ? await sectionRoster(openSectionId) : [];
const activeStudents = roster.filter((m: any) => m.role === 'student' && m.status === 'active').length;
---
<AquintutorLayout title="Terms and sections" description="Cohorts, rosters and capacity." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1400px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin/lms" style="color:var(--ink-500); text-decoration:none;">TEACHING</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">TERMS AND SECTIONS</span>
    </div>
  </div>

  <section style="max-width:1400px; margin:0 auto; padding:26px 28px 60px;">

    {flash && (
      <div style={'margin-bottom:18px; border:1px solid ' + (flashOk ? '#4a7048' : '#a8472c') + '; background:' + (flashOk ? '#f2f7f1' : '#fdf3f0') + '; border-radius:10px; padding:13px 16px; font-family:"Inter Tight",sans-serif; font-size:14px; color:' + (flashOk ? '#2f4a2d' : '#7a2f1a') + ';'}>{flash}</div>
    )}

    {importReport && (
      <div style="margin-bottom:20px; border:1px solid var(--rule); border-radius:10px; padding:14px 18px; background:var(--sand-50); font-family:'Inter Tight',sans-serif; font-size:13.5px;">
        <strong>Import report.</strong> {importReport.added} added, {importReport.alreadyThere} already on the roster.
        {importReport.noAccount.length > 0 && (
          <div style="margin-top:8px; color:#7a2f1a;">
            No account here for: {importReport.noAccount.join(', ')}. Nobody was created &mdash; inviting people is a separate act.
          </div>
        )}
        {importReport.badLines.length > 0 && (
          <div style="margin-top:8px; color:#7a2f1a;">
            Unreadable lines: {importReport.badLines.map((b) => 'line ' + b.line + ' (' + b.reason + ')').join('; ')}.
          </div>
        )}
      </div>
    )}

    <form method="GET" style="margin-bottom:22px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <select name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:250px;">
        {courses.map((c: any) => (<option value={c.id} selected={c.id === courseId}>{c.title}</option>))}
      </select>
      <button type="submit" style="padding:9px 16px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch course</button>
    </form>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:20px; align-items:start; margin-bottom:24px;">

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:13px 17px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0;">Academic terms</h2>
        </div>
        <div style="padding:14px 17px;">
          {terms.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0 0 12px;">No terms yet. A course can run without one; a term is what groups sections on a transcript.</p>}
          {terms.map((t: any) => (
            <div style="display:flex; justify-content:space-between; gap:10px; padding:7px 0; border-bottom:1px solid var(--rule); font-family:'Inter Tight',sans-serif; font-size:13.5px;">
              <span><strong>{t.code}</strong> &middot; {t.title}</span>
              <span style="color:var(--ink-500); font-size:12.5px; white-space:nowrap;">
                {t.starts_on ? String(t.starts_on).slice(0, 10) : '?'} to {t.ends_on ? String(t.ends_on).slice(0, 10) : '?'} &middot; {t.section_count} section(s)
              </span>
            </div>
          ))}
          <form method="POST" style="margin-top:14px; border-top:1px solid var(--rule); padding-top:14px;">
            <input type="hidden" name="action" value="term" />
            <div style="display:flex; gap:6px; margin-bottom:7px;">
              <input name="code" placeholder="2026-AUTUMN" required style="flex:0 0 140px; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-family:'JetBrains Mono',monospace; font-size:12.5px;" />
              <input name="title" placeholder="Autumn 2026" required style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:13px;" />
            </div>
            <div style="display:flex; gap:6px; margin-bottom:9px;">
              <input name="startsOn" type="date" style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
              <input name="endsOn" type="date" style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
              <input name="addDropUntil" type="date" title="add/drop deadline" style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
            </div>
            <button type="submit" style="padding:8px 16px; background:var(--ink); color:var(--sand-50); border:none; border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px; cursor:pointer;">Add term</button>
          </form>
        </div>
      </div>

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:13px 17px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0;">Sections of this course</h2>
        </div>
        <div style="padding:14px 17px;">
          {sections.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0 0 12px;">No sections. The course runs as one open group and every assignment applies to everybody enrolled.</p>}
          {sections.map((s: any) => (
            <a href={'/aquintutor/admin/lms/sections?course=' + courseId + '&section=' + s.id}
               style={'display:flex; justify-content:space-between; gap:10px; padding:9px 6px; border-bottom:1px solid var(--rule); text-decoration:none; color:var(--ink); font-family:"Inter Tight",sans-serif; font-size:13.5px; background:' + (s.id === openSectionId ? 'var(--sand-100)' : 'transparent') + ';'}>
              <span><strong>{s.code}</strong>{s.title ? ' · ' + s.title : ''}{s.term_code ? ' · ' + s.term_code : ''}</span>
              <span style="color:var(--ink-500); font-size:12.5px; white-space:nowrap;">
                {s.student_count}{s.capacity ? ' / ' + s.capacity : ''} enrolled
              </span>
            </a>
          ))}
          <form method="POST" style="margin-top:14px; border-top:1px solid var(--rule); padding-top:14px;">
            <input type="hidden" name="action" value="section" />
            <div style="display:flex; gap:6px; margin-bottom:7px;">
              <input name="code" placeholder="S1" required style="flex:0 0 80px; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-family:'JetBrains Mono',monospace; font-size:12.5px;" />
              <input name="title" placeholder="Section name (optional)" style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:13px;" />
            </div>
            <div style="display:flex; gap:6px; margin-bottom:9px;">
              <select name="termId" style="flex:1; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;">
                <option value="">No term</option>
                {terms.map((t: any) => (<option value={t.id}>{t.code}</option>))}
              </select>
              <select name="delivery" style="flex:0 0 110px; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;">
                <option value="online">Online</option>
                <option value="hybrid">Hybrid</option>
                <option value="in_person">In person</option>
              </select>
              <input name="capacity" type="number" min="0" placeholder="cap" style="flex:0 0 70px; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
            </div>
            <input name="meets" placeholder="Meets — for example Tue and Thu, 18:00 IST" style="width:100%; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:13px; margin-bottom:9px;" />
            <button type="submit" style="padding:8px 16px; background:var(--ink); color:var(--sand-50); border:none; border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px; cursor:pointer;">Add section</button>
          </form>
        </div>
      </div>
    </div>

    {openSection && (
      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:15px 19px; border-bottom:1px solid var(--rule); background:var(--sand-50); display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap; align-items:center;">
          <div>
            <h2 class="font-display" style="font-size:17px; font-weight:500; margin:0;">
              Roster &mdash; {openSection.course_title} &middot; {openSection.code}
            </h2>
            <div style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin-top:3px;">
              {activeStudents} active student(s){openSection.capacity ? ' of ' + openSection.capacity : ''}
              {openSection.term_title ? ' · ' + openSection.term_title : ''}
              {openSection.meets ? ' · ' + openSection.meets : ''}
            </div>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:minmax(320px,1.4fr) minmax(280px,1fr); gap:0;">
          <div style="border-right:1px solid var(--rule);">
            <table style="width:100%; border-collapse:collapse; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
              <thead>
                <tr style="background:var(--sand-50);">
                  <th style="padding:9px 18px; text-align:left; font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">PERSON</th>
                  <th style="padding:9px 10px; text-align:left; font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">ROLE</th>
                  <th style="padding:9px 18px; text-align:left; font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:0.08em; color:var(--ink-500); font-weight:500;">STATUS</th>
                </tr>
              </thead>
              <tbody>
                {roster.length === 0 && <tr><td colspan="3" style="padding:18px; color:var(--ink-500);">Nobody on this roster yet.</td></tr>}
                {roster.map((m: any) => (
                  <tr style="border-top:1px solid var(--rule);">
                    <td style="padding:9px 18px;">
                      <div style="font-weight:600;">{m.name || '(no name)'}</div>
                      <div style="font-size:11.5px; color:var(--ink-500);">{m.email}</div>
                    </td>
                    <td style="padding:9px 10px; font-family:'JetBrains Mono',monospace; font-size:11.5px;">{String(m.role).toUpperCase()}</td>
                    <td style="padding:9px 18px;">
                      <form method="POST" style="display:flex; gap:5px; align-items:center;">
                        <input type="hidden" name="action" value="status" />
                        <input type="hidden" name="memberId" value={m.id} />
                        <select name="status" style="padding:5px 7px; border:1px solid var(--rule); border-radius:6px; font-size:12px;">
                          {['active', 'dropped', 'completed', 'withdrawn'].map((s) => (<option value={s} selected={m.status === s}>{s}</option>))}
                        </select>
                        <button type="submit" style="padding:5px 9px; border:1px solid var(--rule); background:transparent; border-radius:6px; font-size:11.5px; cursor:pointer;">Set</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div style="padding:16px 19px;">
            <h3 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 10px;">ADD ONE PERSON</h3>
            <form method="POST" style="margin-bottom:22px;">
              <input type="hidden" name="action" value="add" />
              <input type="hidden" name="sectionId" value={openSection.id} />
              <input name="email" type="email" placeholder="their email" required style="width:100%; padding:8px 10px; border:1px solid var(--rule); border-radius:7px; font-size:13.5px; margin-bottom:7px;" />
              <div style="display:flex; gap:7px;">
                <select name="role" style="flex:1; padding:8px 10px; border:1px solid var(--rule); border-radius:7px; font-size:13px;">
                  <option value="student">Student</option>
                  <option value="instructor">Instructor</option>
                  <option value="ta">Teaching assistant</option>
                  <option value="observer">Observer</option>
                </select>
                <button type="submit" style="padding:8px 16px; background:var(--ink); color:var(--sand-50); border:none; border-radius:7px; font-size:13.5px; cursor:pointer;">Add</button>
              </div>
            </form>

            <h3 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 10px;">PASTE A ROSTER</h3>
            <form method="POST">
              <input type="hidden" name="action" value="import" />
              <input type="hidden" name="sectionId" value={openSection.id} />
              <p style="font-family:'Inter Tight',sans-serif; font-size:12px; color:var(--ink-500); margin:0 0 7px;">
                One per line: email, or email and name, or email, name and role. Comma or tab. A header line is skipped. Every
                line that cannot be read is reported back rather than dropped.
              </p>
              <textarea name="csv" rows="6" placeholder="a@example.com, Ann Rao&#10;b@example.com, Bo Sen, ta" style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'JetBrains Mono',monospace; font-size:12px; resize:vertical; margin-bottom:8px;"></textarea>
              <button type="submit" style="padding:8px 16px; background:var(--ink); color:var(--sand-50); border:none; border-radius:7px; font-size:13.5px; cursor:pointer;">Import</button>
            </form>
          </div>
        </div>
      </div>
    )}
  </section>
</AquintutorLayout>
