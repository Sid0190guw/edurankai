---
// /aquintutor/admin/lms/assignments — SET WORK.
//
// The authoring side of L1. Everything a learner is later held to is decided on this form: the
// points, the deadline, the late policy, how many attempts, and whether a rubric is attached. The
// form posts to itself; saveAssignment() validates and writes.
//
// PUBLISHING IS SEPARATE FROM SAVING, deliberately. An unpublished assignment is invisible to every
// learner query in this spine, so a half-written brief cannot appear on somebody's board at two in
// the morning. Publishing is a single explicit act with its own button.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { courseAssignments, saveAssignment, setPublished, deleteAssignment, getAssignment } from '@/lib/lms/assignments';
import { courseCategories, courseRubrics } from '@/lib/lms/gradebook';
import { courseSections } from '@/lib/lms/sections';
import { ASSIGNMENT_KIND_LABELS, relativeDue } from '@/lib/lms/policy';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms/assignments'));

const courses = await myTaughtCourses(user);
const courseId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const editId = String(Astro.url.searchParams.get('edit') || '');
const claim = courseId ? await teachClaim(user, courseId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };

// Declared before the POST handler that reads them. const is not hoisted.
let flash = '';
let flashOk = false;

if (Astro.request.method === 'POST') {
  if (!claim.canTeach) {
    flash = 'You do not have teaching access to this course.';
  } else {
    try {
      const form = await Astro.request.formData();
      const action = String(form.get('action') || '');
      if (action === 'publish' || action === 'unpublish') {
        await setPublished(String(form.get('id') || ''), action === 'publish');
        flashOk = true;
        flash = action === 'publish' ? 'Published. It is on the learners boards now.' : 'Unpublished. It is hidden from learners.';
      } else if (action === 'delete') {
        const r = await deleteAssignment(String(form.get('id') || ''));
        flashOk = r.ok;
        flash = r.ok ? 'Deleted.' : (r.error || 'Could not delete it.');
      } else {
        const r = await saveAssignment({
          id: String(form.get('id') || '') || null,
          courseId,
          sectionId: String(form.get('sectionId') || '') || null,
          categoryId: String(form.get('categoryId') || '') || null,
          rubricId: String(form.get('rubricId') || '') || null,
          title: String(form.get('title') || ''),
          instructions: String(form.get('instructions') || ''),
          kind: String(form.get('kind') || 'essay'),
          points: Number(form.get('points') || 100),
          dueAt: String(form.get('dueAt') || ''),
          availableFrom: String(form.get('availableFrom') || ''),
          closesAt: String(form.get('closesAt') || ''),
          allowLate: String(form.get('allowLate') || '') === 'on',
          latePenaltyPctPerDay: Number(form.get('latePenalty') || 10),
          maxLateDays: Number(form.get('maxLateDays') || 5),
          maxAttempts: Number(form.get('maxAttempts') || 1),
          submissionKinds: form.getAll('kinds').map(String),
          minWords: form.get('minWords') ? Number(form.get('minWords')) : null,
          published: String(form.get('published') || '') === 'on',
        }, user.id);
        flashOk = r.ok;
        flash = r.ok ? 'Saved.' : (r.error || 'Could not save it.');
      }
    } catch (e: any) {
      console.error('[admin/lms/assignments] POST:', e?.cause?.message || e?.message);
      flash = 'That did not save: ' + (e?.cause?.message || e?.message || 'unknown error');
      flashOk = false;
    }
  }
}

const list = courseId ? await courseAssignments(courseId, { includeUnpublished: true }) : [];
const categories = courseId ? await courseCategories(courseId) : [];
const rubrics = courseId ? await courseRubrics(courseId) : [];
const sections = courseId ? await courseSections(courseId) : [];
const editing = editId ? await getAssignment(editId) : null;
const now = new Date();

function forInput(value: any): string {
  if (!value) return '';
  const d = new Date(value);
  return isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 16);
}
const editKinds: string[] = editing && Array.isArray(editing.submission_kinds) ? editing.submission_kinds : ['link', 'text'];
---
<AquintutorLayout title="Assignments" description="Set and publish coursework." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1300px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin/lms" style="color:var(--ink-500); text-decoration:none;">TEACHING</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">ASSIGNMENTS</span>
    </div>
  </div>

  <section style="max-width:1300px; margin:0 auto; padding:30px 28px 60px;">

    {flash && (
      <div style={'margin-bottom:20px; border:1px solid ' + (flashOk ? '#4a7048' : '#a8472c') + '; background:' + (flashOk ? '#f2f7f1' : '#fdf3f0') + '; border-radius:10px; padding:13px 16px; font-family:"Inter Tight",sans-serif; font-size:14px; color:' + (flashOk ? '#2f4a2d' : '#7a2f1a') + ';'}>{flash}</div>
    )}

    <form method="GET" style="margin-bottom:24px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <select name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:260px;">
        {courses.map((c: any) => (<option value={c.id} selected={c.id === courseId}>{c.title}</option>))}
      </select>
      <button type="submit" style="padding:9px 16px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch course</button>
    </form>

    {!claim.canTeach && courseId && (
      <div style="border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:14px 16px; font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a;">
        You can see this course but you do not have teaching access to it, so the form is read-only.
      </div>
    )}

    <div style="display:grid; grid-template-columns:minmax(320px,1fr) minmax(340px,420px); gap:24px; align-items:start;">

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50); display:flex; justify-content:space-between; align-items:center; gap:10px;">
          <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Set so far ({list.length})</h2>
          {editId && <a href={'/aquintutor/admin/lms/assignments?course=' + courseId} style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--rust); text-decoration:none;">New assignment</a>}
        </div>
        <div style="padding:8px 0;">
          {list.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); margin:14px 18px;">Nothing set on this course yet.</p>}
          {list.map((a: any) => (
            <div style="padding:14px 18px; border-bottom:1px solid var(--rule);">
              <div style="display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap; align-items:start;">
                <div style="flex:1 1 240px;">
                  <div class="font-display" style="font-size:15.5px; font-weight:500;">{a.title}</div>
                  <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.05em; color:var(--ink-500); margin-top:4px;">
                    {a.published ? 'PUBLISHED' : 'DRAFT'} &middot; {Number(a.points)} PTS
                    {a.section_code ? ' · SECTION ' + a.section_code : ' · WHOLE COURSE'}
                    {a.category_name ? ' · ' + String(a.category_name).toUpperCase() : ''}
                  </div>
                  <div style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin-top:4px;">
                    {relativeDue(a.due_at, now)} &middot; {a.submitted_count} submitted &middot; {a.ungraded_count} to mark
                  </div>
                </div>
                <div style="display:flex; gap:7px; flex-wrap:wrap;">
                  <a href={'/aquintutor/admin/lms/assignments?course=' + courseId + '&edit=' + a.id} style="padding:6px 12px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px; text-decoration:none; color:var(--ink);">Edit</a>
                  {a.ungraded_count > 0 && (
                    <a href={'/aquintutor/admin/lms/grade?course=' + courseId + '&assignment=' + a.id} style="padding:6px 12px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px; text-decoration:none; color:var(--rust);">Mark {a.ungraded_count}</a>
                  )}
                  {claim.canTeach && (
                    <form method="POST" style="display:inline;">
                      <input type="hidden" name="id" value={a.id} />
                      <input type="hidden" name="action" value={a.published ? 'unpublish' : 'publish'} />
                      <button type="submit" style="padding:6px 12px; border:1px solid var(--rule); background:transparent; border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px; cursor:pointer;">{a.published ? 'Unpublish' : 'Publish'}</button>
                    </form>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden; position:sticky; top:90px;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">{editing ? 'Edit assignment' : 'New assignment'}</h2>
        </div>
        <form method="POST" style="padding:18px;">
          {editing && <input type="hidden" name="id" value={editing.id} />}

          <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Title</label>
          <input name="title" required value={editing?.title || ''} style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:12px;" />

          <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">The brief</label>
          <textarea name="instructions" rows="5" style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px; resize:vertical; margin-bottom:12px;">{editing?.instructions || ''}</textarea>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Kind</label>
              <select name="kind" style="width:100%; padding:9px 10px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
                {ASSIGNMENT_KIND_LABELS.map((k) => (<option value={k.key} selected={editing?.kind === k.key}>{k.label}</option>))}
              </select>
            </div>
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Points</label>
              <input name="points" type="number" min="0" step="1" value={editing ? Number(editing.points) : 100} style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px;" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Section</label>
              <select name="sectionId" style="width:100%; padding:9px 10px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
                <option value="">Whole course</option>
                {sections.map((s: any) => (<option value={s.id} selected={editing?.section_id === s.id}>{s.code}{s.term_code ? ' · ' + s.term_code : ''}</option>))}
              </select>
            </div>
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Grade category</label>
              <select name="categoryId" style="width:100%; padding:9px 10px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px;">
                <option value="">Uncategorised</option>
                {categories.map((c: any) => (<option value={c.id} selected={editing?.category_id === c.id}>{c.name} ({Number(c.weight)}%)</option>))}
              </select>
            </div>
          </div>

          <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Rubric</label>
          <select name="rubricId" style="width:100%; padding:9px 10px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:13.5px; margin-bottom:12px;">
            <option value="">No rubric — a single score</option>
            {rubrics.map((r: any) => (<option value={r.id} selected={editing?.rubric_id === r.id}>{r.title} ({r.criteria_count} criteria, {Number(r.total_points)} pts)</option>))}
          </select>

          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12px; font-weight:600; margin-bottom:4px;">Opens</label>
              <input name="availableFrom" type="datetime-local" value={forInput(editing?.available_from)} style="width:100%; padding:8px 9px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px;" />
            </div>
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12px; font-weight:600; margin-bottom:4px;">Due</label>
              <input name="dueAt" type="datetime-local" value={forInput(editing?.due_at)} style="width:100%; padding:8px 9px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px;" />
            </div>
            <div>
              <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12px; font-weight:600; margin-bottom:4px;">Hard close</label>
              <input name="closesAt" type="datetime-local" value={forInput(editing?.closes_at)} style="width:100%; padding:8px 9px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:12.5px;" />
            </div>
          </div>

          <div style="border:1px solid var(--rule); border-radius:8px; padding:12px; margin-bottom:12px; background:var(--sand-50);">
            <label style="display:flex; align-items:center; gap:8px; font-family:'Inter Tight',sans-serif; font-size:13px; font-weight:600; margin-bottom:9px;">
              <input type="checkbox" name="allowLate" checked={editing ? !!editing.allow_late : true} /> Accept late work
            </label>
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;">
              <div>
                <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:11.5px; color:var(--ink-500); margin-bottom:3px;">Penalty %/day</label>
                <input name="latePenalty" type="number" min="0" max="100" value={editing ? Number(editing.late_penalty_pct_per_day) : 10} style="width:100%; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
              </div>
              <div>
                <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:11.5px; color:var(--ink-500); margin-bottom:3px;">Max days late</label>
                <input name="maxLateDays" type="number" min="0" value={editing ? Number(editing.max_late_days) : 5} style="width:100%; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
              </div>
              <div>
                <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:11.5px; color:var(--ink-500); margin-bottom:3px;">Attempts</label>
                <input name="maxAttempts" type="number" min="1" max="20" value={editing ? Number(editing.max_attempts) : 1} style="width:100%; padding:7px 9px; border:1px solid var(--rule); border-radius:6px; font-size:12.5px;" />
              </div>
            </div>
          </div>

          <div style="margin-bottom:12px;">
            <div style="font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:6px;">How they submit</div>
            <label style="display:inline-flex; align-items:center; gap:6px; font-family:'Inter Tight',sans-serif; font-size:13px; margin-right:14px;">
              <input type="checkbox" name="kinds" value="link" checked={editKinds.includes('link')} /> A link
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-family:'Inter Tight',sans-serif; font-size:13px;">
              <input type="checkbox" name="kinds" value="text" checked={editKinds.includes('text')} /> Typed text
            </label>
            <p style="font-family:'Inter Tight',sans-serif; font-size:11.5px; color:var(--ink-500); margin:6px 0 0;">
              There is no file upload, by design: work stays in the learner own drive and this platform stores the link.
            </p>
          </div>

          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Minimum words (optional)</label>
            <input name="minWords" type="number" min="0" value={editing?.min_words || ''} style="width:100%; padding:8px 10px; border:1px solid var(--rule); border-radius:7px; font-size:13px;" />
          </div>

          <label style="display:flex; align-items:center; gap:8px; font-family:'Inter Tight',sans-serif; font-size:13.5px; font-weight:600; margin-bottom:14px;">
            <input type="checkbox" name="published" checked={editing ? !!editing.published : false} /> Published (visible to learners)
          </label>

          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button type="submit" disabled={!claim.canTeach} style="padding:10px 20px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; font-weight:600; cursor:pointer;">{editing ? 'Save changes' : 'Create assignment'}</button>
            {editing && claim.canTeach && (
              <button type="submit" name="action" value="delete" formnovalidate style="padding:10px 16px; background:transparent; border:1px solid #a8472c; color:#a8472c; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Delete</button>
            )}
          </div>
        </form>
      </div>
    </div>
  </section>
</AquintutorLayout>
