---
// /aquintutor/admin/lms — THE TEACHING CONSOLE.
//
// One place from which a person who teaches a course can do the four things teaching a course
// consists of: set work, mark it, keep the roster, and talk to the cohort. Everything below is
// scoped to the courses THIS person actually teaches — myTaughtCourses() resolves that from the
// course staff list, the section roster, the authoring table and their platform role, and a person
// with no claim on any course sees an empty console rather than somebody else's cohort.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms'));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const courses = await myTaughtCourses(user);
const selectedId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const claim = selectedId ? await teachClaim(user, selectedId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };

let stats = { assignments: 0, published: 0, ungraded: 0, students: 0, sections: 0, topics: 0 };
if (selectedId && (claim.canTeach || claim.canGrade)) {
  const one = async (statement: any): Promise<number> => {
    try { return Number(rows(await db.execute(statement))[0]?.c || 0); } catch (e: any) {
      console.error('[admin/lms] stat:', e?.cause?.message || e?.message);
      return 0;
    }
  };
  stats = {
    assignments: await one(sql`SELECT COUNT(*)::int AS c FROM lms_assignments WHERE course_id = ${selectedId}`),
    published: await one(sql`SELECT COUNT(*)::int AS c FROM lms_assignments WHERE course_id = ${selectedId} AND published = true`),
    ungraded: await one(sql`SELECT COUNT(*)::int AS c FROM lms_submissions s JOIN lms_assignments a ON a.id = s.assignment_id
      LEFT JOIN lms_grades g ON g.submission_id = s.id WHERE a.course_id = ${selectedId} AND s.status = 'submitted' AND g.id IS NULL`),
    students: await one(sql`SELECT COUNT(DISTINCT user_id)::int AS c FROM training_enrollments WHERE course_id = ${selectedId}`),
    sections: await one(sql`SELECT COUNT(*)::int AS c FROM lms_sections WHERE course_id = ${selectedId}`),
    topics: await one(sql`SELECT COUNT(*)::int AS c FROM lms_topics WHERE course_id = ${selectedId}`),
  };
}

const TILES = [
  { href: '/aquintutor/admin/lms/assignments', title: 'Assignments', note: 'Set work, publish it, set the late policy and the rubric.' },
  { href: '/aquintutor/admin/lms/grade', title: 'Grading queue', note: 'Everything waiting on you, oldest first. Grade, comment, release.' },
  { href: '/aquintutor/admin/lms/gradebook', title: 'Gradebook', note: 'The whole section as a matrix. Weighted categories, scale, export, final grades.' },
  { href: '/aquintutor/admin/lms/sections', title: 'Terms and sections', note: 'Cohorts, rosters, capacity, and a paste-in roster import.' },
  { href: '/aquintutor/admin/lms/course-home', title: 'Course home', note: 'Announcements, syllabus, discussion moderation and scheduled release.' },
  { href: '/aquintutor/admin/lms/interop', title: 'Import and export', note: 'SCORM package structure, the xAPI statement store, grade export.' },
];
---
<AquintutorLayout title="Teaching console" description="Set work, mark it, keep the roster." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1200px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin" style="color:var(--ink-500); text-decoration:none;">AQUINTUTOR ADMIN</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">TEACHING</span>
    </div>
  </div>

  <section style="max-width:1200px; margin:0 auto; padding:32px 28px 60px;">
    <h1 class="font-display" style="font-size:clamp(26px,3.6vw,36px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Teaching console</h1>
    <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:64ch; margin:0 0 24px;">
      Scoped to the courses you teach. Everything here writes to the same records the learner sees &mdash; there is no separate
      instructor copy of a grade.
    </p>

    {courses.length === 0 && (
      <div style="border:1px solid var(--rule); border-radius:12px; padding:40px 26px; background:var(--sand-50);">
        <h2 class="font-display" style="font-size:20px; font-weight:500; margin:0 0 8px;">You are not attached to any course</h2>
        <p style="font-family:'Inter Tight',sans-serif; font-size:14px; color:var(--ink-500); margin:0; max-width:62ch;">
          Teaching access comes from being listed as course staff, being an instructor on a section, being a course author, or
          holding a faculty, dean or registrar role. An administrator can add you on the sections screen.
        </p>
      </div>
    )}

    {courses.length > 0 && (
      <form method="GET" style="margin-bottom:26px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <label for="course" style="font-family:'Inter Tight',sans-serif; font-size:13.5px; font-weight:600;">Course</label>
        <select id="course" name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:280px;">
          {courses.map((c: any) => (
            <option value={c.id} selected={c.id === selectedId}>{c.title}{c.is_published ? '' : ' (unpublished)'}</option>
          ))}
        </select>
        <button type="submit" style="padding:9px 18px; background:var(--ink); color:var(--sand-50); border:none; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch</button>
        <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--ink-500);">ACCESS VIA {claim.via.toUpperCase()}</span>
      </form>
    )}

    {selectedId && (
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; margin-bottom:26px;">
        {[
          { label: 'ASSIGNMENTS', value: stats.assignments, sub: stats.published + ' published' },
          { label: 'AWAITING A GRADE', value: stats.ungraded, sub: 'submitted, not marked' },
          { label: 'ENROLLED', value: stats.students, sub: 'on this course' },
          { label: 'SECTIONS', value: stats.sections, sub: 'cohorts' },
          { label: 'DISCUSSION', value: stats.topics, sub: 'topics' },
        ].map((s) => (
          <div style="border:1px solid var(--rule); border-radius:10px; padding:14px 16px; background:var(--sand-50);">
            <div class="font-display" style="font-size:26px; font-weight:500; line-height:1;">{s.value}</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:0.08em; color:var(--ink-500); margin-top:5px;">{s.label}</div>
            <div style="font-family:'Inter Tight',sans-serif; font-size:12px; color:var(--ink-500); margin-top:2px;">{s.sub}</div>
          </div>
        ))}
      </div>
    )}

    {selectedId && (
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px;">
        {TILES.map((tile) => (
          <a href={tile.href + '?course=' + selectedId} style="display:block; border:1px solid var(--rule); border-radius:12px; padding:20px 22px; background:#fff; text-decoration:none; color:var(--ink);">
            <div class="font-display" style="font-size:17px; font-weight:500; margin-bottom:6px;">{tile.title}</div>
            <div style="font-family:'Inter Tight',sans-serif; font-size:13.5px; color:var(--ink-500); line-height:1.55;">{tile.note}</div>
          </a>
        ))}
      </div>
    )}
  </section>
</AquintutorLayout>
