---
// /aquintutor/admin/lms/interop — WHAT COMES IN, WHAT GOES OUT (L6).
//
// SCORM package structure in, xAPI statements in and out, grades out.
//
// THE HONEST LIMIT IS PRINTED ON THE PAGE, not buried in a commit message. This imports a SCORM
// package's STRUCTURE from its imsmanifest.xml and creates modules and lessons whose content is the
// launch link. It is not a SCORM run-time: a package served from another origin cannot reach a
// window.API object on our page, because browsers forbid that across origins, so claiming cmi.core
// tracking would be claiming something that cannot work. Completion of an imported item is tracked
// the way every other lesson on this platform is.
//
// The import PREVIEWS before it writes. You see exactly what would be created, and press again.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { parseScormManifest, manifestPlan, importScormPlan, listStatements } from '@/lib/lms/interop';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms/interop'));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const courses = await myTaughtCourses(user);
const courseId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const claim = courseId ? await teachClaim(user, courseId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };

// Declared before the POST handler. const is not hoisted.
let flash = '';
let flashOk = false;
let preview: Array<{ module: string; lessons: Array<{ title: string; href: string | null }> }> | null = null;
let previewXml = '';
let previewBase = '';
let previewTitle = '';

if (Astro.request.method === 'POST') {
  if (!claim.canTeach) {
    flash = 'You do not have teaching access to this course.';
  } else {
    try {
      const form = await Astro.request.formData();
      const action = String(form.get('action') || '');
      const xml = String(form.get('xml') || '');
      const base = String(form.get('base') || '').trim();

      if (action === 'preview') {
        if (!xml.trim()) {
          flash = 'Paste the contents of imsmanifest.xml first.';
        } else {
          const manifest = parseScormManifest(xml);
          preview = manifestPlan(manifest, base);
          previewXml = xml;
          previewBase = base;
          previewTitle = manifest.title;
          const lessonCount = preview.reduce((s, p) => s + p.lessons.length, 0);
          if (!lessonCount) {
            flash = 'No items were found in that manifest. Check that you pasted imsmanifest.xml and not the package listing.';
          } else {
            flashOk = true;
            flash = 'Read ' + preview.length + ' module(s) and ' + lessonCount + ' item(s). Nothing has been written yet.';
          }
        }
      } else if (action === 'import') {
        const manifest = parseScormManifest(xml);
        const plan = manifestPlan(manifest, base);
        const r = await importScormPlan(courseId, plan, user.id, String(form.get('filename') || 'imsmanifest.xml'));
        flashOk = r.ok;
        flash = r.ok
          ? 'Imported ' + r.modules + ' module(s) and ' + r.lessons + ' lesson(s). Nothing existing was removed.'
          : (r.error || 'The import failed.');
      }
    } catch (e: any) {
      console.error('[admin/lms/interop] POST:', e?.cause?.message || e?.message);
      flash = 'That did not work: ' + (e?.cause?.message || e?.message || 'unknown error');
      flashOk = false;
    }
  }
}

const statements = courseId ? await listStatements({ courseId, limit: 40 }) : [];
let imports: any[] = [];
try {
  imports = courseId
    ? rows(await db.execute(sql`SELECT kind, filename, status, summary, created_at FROM lms_imports WHERE course_id = ${courseId} ORDER BY created_at DESC LIMIT 10`))
    : [];
} catch (e: any) {
  console.error('[admin/lms/interop] imports:', e?.cause?.message || e?.message);
}
const siteOrigin = Astro.url.origin;
---
<AquintutorLayout title="Import and export" description="SCORM structure, xAPI statements, grade export." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1300px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin/lms" style="color:var(--ink-500); text-decoration:none;">TEACHING</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">IMPORT AND EXPORT</span>
    </div>
  </div>

  <section style="max-width:1300px; margin:0 auto; padding:26px 28px 60px;">

    {flash && (
      <div style={'margin-bottom:18px; border:1px solid ' + (flashOk ? '#4a7048' : '#a8472c') + '; background:' + (flashOk ? '#f2f7f1' : '#fdf3f0') + '; border-radius:10px; padding:13px 16px; font-family:"Inter Tight",sans-serif; font-size:14px; color:' + (flashOk ? '#2f4a2d' : '#7a2f1a') + ';'}>{flash}</div>
    )}

    <form method="GET" style="margin-bottom:22px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <select name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:250px;">
        {courses.map((c: any) => (<option value={c.id} selected={c.id === courseId}>{c.title}</option>))}
      </select>
      <button type="submit" style="padding:9px 16px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch course</button>
      <a href={'/api/aquintutor/lms/export?course=' + courseId} style="padding:9px 18px; background:var(--ink); color:var(--sand-50); border-radius:8px; text-decoration:none; font-family:'Inter Tight',sans-serif; font-size:14px;">Export grades as CSV</a>
    </form>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(360px,1fr)); gap:20px; align-items:start;">

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:13px 17px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0;">SCORM package structure</h2>
        </div>
        <div style="padding:15px 17px;">
          <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.6; margin:0 0 12px;">
            Paste the contents of the package's <strong>imsmanifest.xml</strong>. The organisation tree becomes modules and
            lessons, and each item's resource href becomes its launch link.
          </p>
          <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:#7a2f1a; line-height:1.6; margin:0 0 12px; border-left:3px solid #a8472c; padding-left:10px;">
            <strong>What this does not do.</strong> It is not a SCORM run-time. A package hosted elsewhere cannot report
            cmi.core progress back to this page &mdash; a browser blocks that across origins &mdash; so imported items are
            tracked like any other lesson here, by completion, not by SCORM's own data model.
          </p>

          <form method="POST">
            <input type="hidden" name="action" value={preview ? 'import' : 'preview'} />
            <input name="base" value={previewBase} placeholder="Base URL where the package is hosted (optional)" style="width:100%; padding:8px 10px; border:1px solid var(--rule); border-radius:7px; font-size:13px; margin-bottom:8px;" />
            <textarea name="xml" rows={preview ? 3 : 9} placeholder="<?xml version=&quot;1.0&quot;?><manifest ...>" style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'JetBrains Mono',monospace; font-size:11.5px; resize:vertical; margin-bottom:9px;">{previewXml}</textarea>
            <button type="submit" style="padding:8px 16px; background:var(--ink); color:var(--sand-50); border:none; border-radius:7px; font-size:13.5px; cursor:pointer;">
              {preview ? 'Import this into the course' : 'Read the manifest'}
            </button>
          </form>

          {preview && (
            <div style="margin-top:14px; border-top:1px solid var(--rule); padding-top:12px;">
              <h3 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 9px;">WOULD CREATE &mdash; {previewTitle.toUpperCase()}</h3>
              {preview.map((group) => (
                <div style="margin-bottom:10px;">
                  <div style="font-family:'Inter Tight',sans-serif; font-size:13.5px; font-weight:600;">{group.module}</div>
                  <ul style="margin:4px 0 0; padding-left:18px; font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500);">
                    {group.lessons.map((l) => (<li>{l.title}{l.href ? '' : ' — no launch link in the manifest'}</li>))}
                  </ul>
                </div>
              ))}
            </div>
          )}

          {imports.length > 0 && (
            <div style="margin-top:14px; border-top:1px solid var(--rule); padding-top:12px;">
              <h3 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 8px;">PAST IMPORTS</h3>
              {imports.map((i: any) => (
                <div style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); padding:4px 0;">
                  {i.kind} &middot; {i.filename || 'pasted'} &middot; {new Date(i.created_at).toISOString().slice(0, 10)}
                  {i.summary?.lessons != null ? ' · ' + i.summary.lessons + ' lessons' : ''}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
        <div style="padding:13px 17px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
          <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0;">xAPI statement store</h2>
        </div>
        <div style="padding:15px 17px;">
          <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.6; margin:0 0 10px;">
            This platform writes a statement when somebody submits work and when a grade is released. External tools can post
            statements to the endpoint below with an API key.
          </p>
          <div style="background:var(--sand-50); border:1px solid var(--rule); border-radius:7px; padding:10px 12px; font-family:'JetBrains Mono',monospace; font-size:11.5px; margin-bottom:12px; overflow-x:auto;">
            POST {siteOrigin}/api/aquintutor/lms/xapi<br />
            x-api-key: &lt;your key&gt;<br />
            Content-Type: application/json
          </div>
          <p style="font-family:'Inter Tight',sans-serif; font-size:12px; color:var(--ink-500); margin:0 0 14px;">
            An LRS-lite: it stores, shreds and reports statements. It does not implement statement signing, attachments, or the
            activity-state document API, and it does not claim conformance.
          </p>

          <h3 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.08em; color:var(--ink-500); margin:0 0 8px;">LATEST ON THIS COURSE</h3>
          {statements.length === 0 && <p style="font-family:'Inter Tight',sans-serif; font-size:13px; color:var(--ink-500); margin:0;">No statements recorded for this course yet.</p>}
          <div style="max-height:340px; overflow-y:auto;">
            {statements.map((s: any) => (
              <div style="border-bottom:1px solid var(--rule); padding:7px 0; font-family:'Inter Tight',sans-serif; font-size:12.5px;">
                <span style="font-weight:600;">{s.user_name || s.actor_name || 'someone'}</span> {s.verb} <span style="color:var(--ink-500);">{s.object_name || s.object_id}</span>
                <div style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--ink-500); margin-top:2px;">
                  {new Date(s.stored_at).toISOString().slice(0, 16).replace('T', ' ')} &middot; {String(s.source).toUpperCase()}
                  {s.score_scaled != null ? ' · SCORE ' + Math.round(Number(s.score_scaled) * 100) + '%' : ''}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</AquintutorLayout>
