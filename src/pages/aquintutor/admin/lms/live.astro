---
// /aquintutor/admin/lms/live — SCHEDULE A LIVE CLASS ON THE STREAMING CHANNEL, FROM HERE.
//
// WHAT THIS SCREEN HONESTLY IS
//
// The control plane. It creates the event, attaches the reusable encoder stream, and shows the
// teacher the address and key to paste into their streaming software once. The video itself never
// touches this platform: a browser cannot speak the protocol the channel ingests, so the encoder
// pushes straight there. Everything else — who may watch, the board, the polls, the recording —
// stays here.
//
// WHY THERE IS NO "GO LIVE" BUTTON
//
// The event is created with auto-start and auto-stop. It goes live the moment the encoder connects
// and ends about a minute after it stops. A button that pretended to start a broadcast the encoder
// had not fed yet would fail with "the stream is inactive", which is a confusing way to say
// "you have not pressed Start Streaming yet".
//
// NO BRAND NAMES. The channel is "the streaming channel" throughout, the same way
// src/lib/video-embed.ts keeps provider ids internal.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { myTaughtCourses, teachClaim } from '@/lib/lms/access';
import { liveEgressStatus } from '@/lib/live-egress';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/aquintutor/login?next=' + encodeURIComponent('/aquintutor/admin/lms/live'));

const courses = await myTaughtCourses(user);
const courseId = String(Astro.url.searchParams.get('course') || courses[0]?.id || '');
const claim = courseId ? await teachClaim(user, courseId) : { canTeach: false, canGrade: false, canAdminister: false, via: 'none' };
const status = liveEgressStatus();
---
<AquintutorLayout title="Live class" description="Schedule a live class on the streaming channel." noindex={true}>

  <div style="border-bottom:1px solid var(--rule); background:var(--sand-100);">
    <div style="max-width:1100px; margin:0 auto; padding:10px 28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--ink-500);">
      <a href="/aquintutor/admin/lms" style="color:var(--ink-500); text-decoration:none;">TEACHING</a>
      <span style="margin:0 8px;">/</span>
      <span style="color:var(--rust); font-weight:600;">LIVE CLASS</span>
    </div>
  </div>

  <section style="max-width:1100px; margin:0 auto; padding:30px 28px 60px;">
    <h1 class="font-display" style="font-size:clamp(26px,3.6vw,36px); font-weight:500; letter-spacing:-0.02em; margin:0 0 8px;">Live class</h1>
    <p style="font-family:'Inter Tight',sans-serif; font-size:14.5px; color:var(--ink-500); max-width:66ch; margin:0 0 24px;">
      Schedule the class here, then paste the address and key below into your streaming software once. It starts on its own when
      you press Start Streaming there, and ends about a minute after you stop. Learners watch it on their course page, where
      enrolment is checked.
    </p>

    <form method="GET" style="margin-bottom:22px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <select name="course" style="padding:9px 12px; border:1px solid var(--rule); border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; min-width:260px;">
        {courses.map((c: any) => (<option value={c.id} selected={c.id === courseId}>{c.title}</option>))}
      </select>
      <button type="submit" style="padding:9px 16px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:'Inter Tight',sans-serif; font-size:14px; cursor:pointer;">Switch course</button>
    </form>

    {!status.available && (
      <div style="border:1px solid #a87526; background:#fdf8ef; border-radius:10px; padding:15px 18px; font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.65; color:#6d4d12; margin-bottom:22px;">
        <strong>No streaming channel is connected yet.</strong>
        <div style="margin-top:6px;">{status.reason}</div>
        <div style="margin-top:10px;">
          Two things have to happen before this works, and one of them has a long lead time:
          the channel needs live streaming enabled (there is a waiting period of about a day after you first turn it on), and the
          sign-in consent has to be <strong>published</strong> before the stored connection is created. A connection made while
          consent is still in testing stops working after seven days, with no warning and no visible symptom until a class fails
          to start.
        </div>
      </div>
    )}

    {!claim.canTeach && courseId && (
      <div style="border:1px solid #a8472c; background:#fdf3f0; border-radius:10px; padding:14px 16px; font-family:'Inter Tight',sans-serif; font-size:14px; color:#7a2f1a;">
        You do not have teaching access to this course.
      </div>
    )}

    {claim.canTeach && (
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:20px; align-items:start;">

        <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
            <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Schedule a class</h2>
          </div>
          <div style="padding:18px;">
            <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Title</label>
            <input id="lTitle" placeholder="What is this class about?" style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:10px;" />
            <label style="display:block; font-family:'Inter Tight',sans-serif; font-size:12.5px; font-weight:600; margin-bottom:4px;">Starts</label>
            <input id="lStart" type="datetime-local" style="width:100%; padding:9px 11px; border:1px solid var(--rule); border-radius:7px; font-family:'Inter Tight',sans-serif; font-size:14px; margin-bottom:14px;" />
            <button type="button" id="lCreate" data-course={courseId} disabled={!status.available}
              style={'padding:10px 20px; border:none; border-radius:8px; font-family:"Inter Tight",sans-serif; font-size:14px; font-weight:600; cursor:pointer; background:' + (status.available ? 'var(--ink)' : '#c9c2b2') + '; color:var(--sand-50);'}>
              Create the class
            </button>
            <div id="lState" style="margin-top:12px; font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.6;"></div>
            <div id="lOut" style="margin-top:12px;"></div>
          </div>
        </div>

        <div style="border:1px solid var(--rule); border-radius:12px; background:#fff; overflow:hidden;">
          <div style="padding:14px 18px; border-bottom:1px solid var(--rule); background:var(--sand-50);">
            <h2 class="font-display" style="font-size:16px; font-weight:500; margin:0;">Your encoder settings</h2>
          </div>
          <div style="padding:18px;">
            <p style="font-family:'Inter Tight',sans-serif; font-size:12.5px; color:var(--ink-500); line-height:1.6; margin:0 0 12px;">
              These are the same for every class, so you paste them once. Shown on request rather than kept on screen, because the
              key is a password: anyone who has it can broadcast onto the channel.
            </p>
            <button type="button" id="lIngest" data-course={courseId} disabled={!status.available}
              style={'padding:9px 18px; border:1px solid var(--rule); background:transparent; border-radius:8px; font-family:"Inter Tight",sans-serif; font-size:14px; cursor:' + (status.available ? 'pointer' : 'not-allowed') + ';'}>
              Show the address and key
            </button>
            <div id="lIngestOut" style="margin-top:14px;"></div>
          </div>
        </div>
      </div>
    )}

    <div style="margin-top:24px; border:1px solid var(--rule); border-radius:12px; background:var(--sand-50); padding:18px 22px;">
      <h2 class="font-display" style="font-size:15px; font-weight:500; margin:0 0 8px;">What "not public" does and does not mean</h2>
      <p style="font-family:'Inter Tight',sans-serif; font-size:13.5px; line-height:1.65; color:var(--ink-500); margin:0;">
        A class created here is unlisted on the streaming channel: it will not appear in search or on the channel page. That is
        <strong>not</strong> the same as private. Anyone who obtains the address can watch it, signed out, and can keep watching
        the recording afterwards. Enrolment is enforced on the course page here, by us. If a class must be genuinely restricted,
        it cannot go on the streaming channel at all &mdash; use the in-house classroom instead.
      </p>
    </div>
  </section>

  <script is:inline>
    // Two buttons, one fetch each. No polling loop: the class starts itself when the encoder
    // connects, so there is nothing here that needs to watch the clock.
    (function () {
      function post(body) {
        return fetch('/api/aquintutor/lms/live-egress', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        }).then(function (r) { return r.json(); });
      }
      function esc(s) { return String(s == null ? '' : s).replace(/[<>&"]/g, function (c) { return ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]; }); }

      var create = document.getElementById('lCreate');
      if (create) create.addEventListener('click', async function () {
        var st = document.getElementById('lState'), out = document.getElementById('lOut');
        var title = (document.getElementById('lTitle').value || '').trim();
        var start = document.getElementById('lStart').value;
        if (!title || !start) { st.textContent = 'A title and a start time are both needed.'; st.style.color = '#7a2f1a'; return; }
        create.disabled = true; st.style.color = '#6b5f4c'; st.textContent = 'Creating the class...';
        var d = await post({ action: 'create', courseId: create.getAttribute('data-course'), title: title, startIso: new Date(start).toISOString() });
        create.disabled = false;
        if (!d || !d.ok) { st.style.color = '#7a2f1a'; st.textContent = (d && d.error) ? d.error : 'The class was not created.'; return; }
        st.style.color = '#2f4a2d'; st.textContent = 'Created. It will go live on its own when you start streaming.';
        out.innerHTML =
          '<div style="border:1px solid #d9d2c2;border-radius:8px;padding:12px 14px;background:#fbfaf4;">' +
          '<div style="font-family:\'Inter Tight\',sans-serif;font-size:13px;margin-bottom:6px;">Learners watch it here:</div>' +
          '<input readonly value="/aquintutor/course/' + esc(create.getAttribute('data-course')) + '" onclick="this.select()" style="width:100%;padding:8px 10px;border:1px solid #d9d2c2;border-radius:6px;font-family:\'JetBrains Mono\',monospace;font-size:12px;" />' +
          '<div style="font-family:\'Inter Tight\',sans-serif;font-size:12.5px;color:#6d4d12;margin-top:10px;line-height:1.55;">' + esc(d.privacyNote) + '</div>' +
          '</div>';
      });

      var ing = document.getElementById('lIngest');
      if (ing) ing.addEventListener('click', async function () {
        var out = document.getElementById('lIngestOut');
        ing.disabled = true; out.textContent = 'Asking the channel...';
        var d = await post({ action: 'ingest', courseId: ing.getAttribute('data-course') });
        ing.disabled = false;
        if (!d || !d.ok) { out.innerHTML = '<span style="color:#7a2f1a;font-family:\'Inter Tight\',sans-serif;font-size:13.5px;">' + esc((d && d.error) || 'Could not read the encoder settings.') + '</span>'; return; }
        out.innerHTML =
          '<label style="display:block;font-family:\'Inter Tight\',sans-serif;font-size:12.5px;font-weight:600;margin-bottom:4px;">Server</label>' +
          '<input readonly value="' + esc(d.serverUrl) + '" onclick="this.select()" style="width:100%;padding:8px 10px;border:1px solid #d9d2c2;border-radius:6px;font-family:\'JetBrains Mono\',monospace;font-size:12px;margin-bottom:10px;" />' +
          '<label style="display:block;font-family:\'Inter Tight\',sans-serif;font-size:12.5px;font-weight:600;margin-bottom:4px;">Stream key</label>' +
          '<input readonly type="password" id="lKey" value="' + esc(d.streamKey) + '" onclick="this.select()" style="width:100%;padding:8px 10px;border:1px solid #d9d2c2;border-radius:6px;font-family:\'JetBrains Mono\',monospace;font-size:12px;" />' +
          '<button type="button" id="lReveal" style="margin-top:8px;padding:6px 12px;border:1px solid #d9d2c2;background:transparent;border-radius:6px;font-family:\'Inter Tight\',sans-serif;font-size:12.5px;cursor:pointer;">Reveal</button>' +
          '<div style="font-family:\'Inter Tight\',sans-serif;font-size:12.5px;color:#6d4d12;margin-top:10px;line-height:1.55;">' + esc(d.warning) + '</div>' +
          '<div style="font-family:\'Inter Tight\',sans-serif;font-size:12.5px;color:#6b5f4c;margin-top:8px;">' +
          (d.receiving ? 'The channel is receiving video on this stream right now.' : 'The channel is not receiving video yet — that is normal until you press Start Streaming.') +
          '</div>';
        var rev = document.getElementById('lReveal');
        if (rev) rev.addEventListener('click', function () {
          var k = document.getElementById('lKey');
          k.type = k.type === 'password' ? 'text' : 'password';
          rev.textContent = k.type === 'password' ? 'Reveal' : 'Hide';
        });
      });
    })();
  </script>
</AquintutorLayout>
