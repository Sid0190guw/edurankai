---
// /aquintutor/admin/logout — end the AquinTutor session, and only that one.
//
// Signing out of AquinTutor must not sign anybody out of EduRankAI. They are two identity domains
// with two cookies; touching the other one here would be the same coupling the separation exists to
// remove, just running in the opposite direction.
//
// The session row is REVOKED rather than deleted, so the record of when it ended survives, and the
// cookie is cleared regardless of whether the revoke succeeded — a person who pressed Sign out must
// end up signed out of this browser even if the database is unreachable.
import { aquinStore } from '@/lib/aquin/store';
import { signOut } from '@/lib/aquin/identity';
import { readAquinCookie, clearAquinCookie } from '@/lib/aquin/gate';

const token = readAquinCookie(Astro.cookies);
if (token) {
  try {
    const store = await aquinStore();
    await signOut(store, token);
  } catch (e: any) {
    console.error('[aquintutor/admin/logout] revoke failed:', e?.cause?.message || e?.message);
  }
}
clearAquinCookie(Astro.cookies);
return Astro.redirect('/aquintutor/admin/login?bye=1');
---
