---
// /aquintutor/admin/login — the way into AquinTutor's own administration.
//
// =================================================================================================
// THIS IS NOT THE EduRankAI LOGIN, AND IT NEVER FALLS BACK TO IT
// =================================================================================================
//
// aquintutor.com is its own product with its own accounts, its own administrators and its own idea
// of who may do what (docs/aquintutor-independence.md). This page signs somebody in against aq_users
// and issues the aquin_session cookie. An EduRankAI account — including the founder's — has no
// standing here at all until an AquinTutor super admin has created one and granted it a role.
//
// The temptation to add "or, if they are already a super admin over there, let them in" will be
// strongest during the transition, when signing in twice is a nuisance. That is the bridge the whole
// separation exists to prevent, and a nuisance is a much smaller cost than two products that can
// never actually be pulled apart.
//
// NOTE ON /aquintutor/login: the existing page next door still signs learners in against the
// EduRankAI tables, and is left alone deliberately — it works today and repointing it would lock
// out everybody who has an account, since aq_users starts empty. It migrates once accounts exist.
//
// const BEFORE THE HANDLER — `const` is not hoisted, and that has taken pages down here.
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { aquinStore } from '@/lib/aquin/store';
import { signIn } from '@/lib/aquin/identity';
import { setAquinCookie, readAquinCookie } from '@/lib/aquin/gate';
import { resolveAquinUser, mayOpenAquinAdmin } from '@/lib/aquin/identity';
import { safeNextPath } from '@/lib/auth/safe-next';

const HOME = '/aquintutor/admin';
// safeNextPath, so `?next=` cannot bounce somebody to another site after they sign in.
const next = safeNextPath(Astro.url.searchParams.get('next'), HOME);

let errorMsg = '';
let notice = '';
let setupNeeded = false;

// Already signed in and already an administrator? Do not make them type it again.
const existing = readAquinCookie(Astro.cookies);
if (existing && Astro.request.method !== 'POST') {
  try {
    const store = await aquinStore();
    const who = await resolveAquinUser(store, existing);
    if (mayOpenAquinAdmin(who)) return Astro.redirect(next);
  } catch { /* fall through to the form */ }
}

// Is there anybody to sign in AS? An empty aq_users is not a wrong password, and telling somebody
// their details are wrong when no account exists at all sends them to reset a password they never
// had. This asks the database rather than guessing.
try {
  const store = await aquinStore();
  const present = await store.presentTables();
  if (!present.includes('aq_users')) setupNeeded = true;
  else if ((await store.countRole('super_admin')) === 0) setupNeeded = true;
} catch (e: any) {
  console.error('[aquintutor/admin/login] setup check failed:', e?.cause?.message || e?.message);
  notice = 'We could not check whether AquinTutor administration has been set up yet.';
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData().catch(() => null);
  const email = String(fd?.get('email') || '');
  const password = String(fd?.get('password') || '');
  try {
    const store = await aquinStore();
    const result = await signIn(store, email, password, {
      ip: Astro.clientAddress || null,
      userAgent: Astro.request.headers.get('user-agent'),
    });
    if (!result.ok) {
      errorMsg = result.error || 'That did not work.';
    } else if (!mayOpenAquinAdmin(result.principal!)) {
      // Correct password, no administrative role. Said plainly: the alternative is a redirect loop
      // back to this page, which reads as the password being wrong.
      errorMsg = 'Those details are correct, but this account holds no AquinTutor administrative role. Ask an AquinTutor super admin to grant one.';
    } else {
      setAquinCookie(Astro.cookies, result.token!, result.expiresAt!);
      return Astro.redirect(next);
    }
  } catch (e: any) {
    // NEVER SWALLOWED. A bare catch on a sign-in path hid a total outage on this project for hours.
    console.error('[aquintutor/admin/login] sign-in failed:', e?.cause?.message || e?.message);
    errorMsg = 'Sign-in could not be completed just now. Nothing is wrong with your password.';
  }
}

const CARD = 'background:var(--paper,#FBFAF4);border:1px solid rgba(14,11,8,0.12);border-radius:16px;padding:28px;max-width:420px;margin:0 auto;';
const LBL = 'display:block;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#8a7f76;margin-bottom:6px;';
const INP = 'width:100%;padding:11px 13px;border:1px solid rgba(14,11,8,0.18);border-radius:9px;font-size:15px;background:#fff;color:#0E0B08;';
---

<AquintutorLayout title="AquinTutor administration" description="Sign in to administer AquinTutor.">
  <main style="padding:64px 20px;min-height:70vh;">
    <div style={CARD}>
      <p style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#a8472c;margin:0 0 8px;">AquinTutor</p>
      <h1 style="font-size:26px;margin:0 0 6px;color:#0E0B08;">Administration</h1>
      <p style="font-size:13.5px;color:#6f665e;line-height:1.6;margin:0 0 22px;">
        AquinTutor accounts are separate from EduRankAI. Signing in there does not sign you in here.
      </p>

      {notice !== '' && (
        <p style="margin:0 0 16px;padding:10px 12px;border-radius:9px;background:rgba(180,120,20,0.10);border:1px solid rgba(180,120,20,0.35);color:#8a5a10;font-size:13px;line-height:1.55;">{notice}</p>
      )}

      {setupNeeded ? (
        <div style="padding:14px 16px;border-radius:10px;background:rgba(180,60,40,0.08);border:1px solid rgba(180,60,40,0.30);">
          <p style="margin:0 0 8px;font-size:14px;font-weight:650;color:#a04330;">No AquinTutor administrator exists yet.</p>
          <p style="margin:0;font-size:13px;color:#6f665e;line-height:1.6;">
            Nobody can sign in here until the first super admin is created. That is done once, from
            the EduRankAI admin at <a href="/admin/aquintutor-bootstrap" style="color:#a8472c;">/admin/aquintutor-bootstrap</a>,
            and the page refuses to run again afterwards.
          </p>
        </div>
      ) : (
        <form method="POST" style="display:flex;flex-direction:column;gap:16px;">
          {errorMsg !== '' && (
            <p style="margin:0;padding:10px 12px;border-radius:9px;background:rgba(180,60,40,0.09);border:1px solid rgba(180,60,40,0.32);color:#a04330;font-size:13px;line-height:1.55;">{errorMsg}</p>
          )}
          <div>
            <label style={LBL} for="aq-email">Email</label>
            <input id="aq-email" style={INP} type="email" name="email" required autocomplete="username" />
          </div>
          <div>
            <label style={LBL} for="aq-password">Password</label>
            <input id="aq-password" style={INP} type="password" name="password" required autocomplete="current-password" />
          </div>
          <button type="submit" style="min-height:46px;border:0;border-radius:10px;background:#a8472c;color:#fff;font-weight:650;font-size:15px;cursor:pointer;">Sign in to AquinTutor</button>
        </form>
      )}
    </div>
  </main>
</AquintutorLayout>
