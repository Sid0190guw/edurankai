---
import AquintutorLayout from '@/layouts/AquintutorLayout.astro';
import { sessionsByKind, AI_OVERLAYS, PSYCHOMOTOR_NOTE } from '@/lib/aquin-immersive';

// The catalogue read used to sit inside `try { ... } catch (_) {}`, so an unreachable database and an
// empty catalogue rendered the identical page. Those are opposite facts: one means nothing has been
// recorded yet, the other means recordings exist and we cannot show them. sessionsByKind() now says
// which it is, and this page prints it.
//
// It was also always the first: addSession() was the only writer of aquin_immersive_sessions and
// nothing called it, so this catalogue could not have had a row in it. It is written from
// /admin/aquintutor/curriculum now.
const sessionsRead = await sessionsByKind(true);
const groups: { kind: any; sessions: any[] }[] = sessionsRead.ok ? sessionsRead.value : [];
const total = groups.reduce((n, g) => n + g.sessions.length, 0);
const catalogueFailed = !sessionsRead.ok;
const catalogueReason = sessionsRead.ok ? '' : sessionsRead.reason;

// Observation-contribution estimates (spec §3).
const CONTRIB = [
  ['Operating-room observation', '95–100%'],
  ['Clinical demonstrations', '90–95%'],
  ['Emergency simulations', '90–95%'],
  ['Ward rounds', '85–95%'],
  ['Anatomy demonstrations', '85–95%'],
  ['Laboratory demonstrations', '85–90%'],
  ['Hands-on procedural skills', '20–40% (supplements, does not replace)'],
  ['Real patient interaction', '10–30% (supplements, does not replace)'],
];
---
<AquintutorLayout title="Digital Clinical Campus" description="A network of 360° cameras and immersive sessions across partner hospitals, labs and simulation centres — observation-based learning that augments hands-on training completed at accredited partners.">
  <section style="max-width:1000px;margin:0 auto;padding:40px 20px 72px;">

    <p style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 8px;">Digital Clinical Campus</p>
    <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.1;margin:0 0 14px;color:#141414;">Attend a live surgery from anywhere. Earn the skills where it counts.</h1>
    <p style="font-size:16px;line-height:1.7;color:#3a3a3a;max-width:780px;margin:0 0 6px;">
      A network of 360° cameras and immersive sessions across partner operating rooms, wards, anatomy
      labs, skills labs and simulation centres lets learners look around freely and observe real clinical
      workflow and team coordination &mdash; live or on demand. AI overlays add labels, subtitles,
      translation, quizzes and summaries.
    </p>
    <div style="background:#fdf8ef;border-left:4px solid #8a5a00;border-radius:0 12px 12px 0;padding:13px 17px;margin:16px 0 8px;">
      <p style="font-size:13.5px;color:#5a4a20;margin:0;line-height:1.6;">{PSYCHOMOTOR_NOTE}</p>
    </div>

    <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:32px 0 12px;color:#141414;">What immersive observation contributes</h2>
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13.5px;min-width:420px;">
        <tbody>
          {CONTRIB.map(([label, val], i) => (
            <tr style={i % 2 ? 'background:#f7f6f2;' : ''}>
              <td style="padding:9px 12px;color:#3a3a3a;">{label}</td>
              <td style="padding:9px 12px;text-align:right;font-weight:600;color:#141414;font-family:'Geist Mono',monospace;white-space:nowrap;">{val}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 style="font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:36px 0 12px;color:#141414;">Sessions</h2>
    {catalogueFailed ? (
      <div style="border:1px solid #FF4F00;border-radius:12px;padding:16px 18px;background:#fff;">
        <p style="font-size:15px;font-weight:700;margin:0 0 6px;color:#141414;">The session library could not be loaded.</p>
        <p style="font-size:13.5px;color:#3a3a3a;line-height:1.6;margin:0;max-width:70ch;">
          This is a fault on our side, not an empty library. We would rather say so than show you a
          blank page and let you conclude there is nothing here.
        </p>
        <p style="font-family:'Geist Mono',monospace;font-size:11px;color:#8a8a8a;margin:10px 0 0;">Reason recorded: {catalogueReason}</p>
      </div>
    ) : total === 0 ? (
      <p style="font-size:13.5px;color:#8a8a8a;font-style:italic;">The clinical-campus session library is being established with partner institutions. Recorded and live 360&deg; sessions will appear here.</p>
    ) : (
      groups.map((g) => (
        <div style="margin-bottom:24px;">
          <div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid rgba(0,0,0,0.1);padding-bottom:6px;margin-bottom:10px;">
            <h3 style="font-size:15px;font-weight:700;margin:0;color:#141414;">{g.kind.label}</h3>
            <span style="font-size:11px;color:#6b6b6b;font-family:'Geist Mono',monospace;">obs. {g.kind.contribution}</span>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;">
            {g.sessions.map((s) => (
              <div style="border:1px solid rgba(0,0,0,0.10);border-radius:12px;padding:13px 15px;background:#fff;">
                <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;">
                  <h4 style="font-size:14px;font-weight:600;margin:0;color:#141414;line-height:1.3;">{s.title}</h4>
                  {s.is360 && <span style="font-size:9px;font-weight:700;color:#1045BB;background:#1045BB18;padding:2px 6px;border-radius:100px;white-space:nowrap;">360&deg;</span>}
                </div>
                {s.discipline && <p style="font-size:12px;color:#6b6b6b;margin:4px 0 0;">{s.discipline}</p>}
                {s.aiOverlays.length > 0 && <p style="font-size:11px;color:#128a3f;margin:6px 0 0;">AI: {s.aiOverlays.join(', ')}</p>}
                {s.sourceUrl && <a href={s.sourceUrl} target="_blank" rel="noopener" style="font-size:12px;color:#FF4F00;font-weight:600;text-decoration:none;display:inline-block;margin-top:8px;">Open session &rarr;</a>}
              </div>
            ))}
          </div>
        </div>
      ))
    )}

    <div style="margin-top:34px;border-top:1px solid rgba(0,0,0,0.08);padding-top:18px;">
      <h2 style="font-family:'Fraunces',serif;font-size:17px;font-weight:600;margin:0 0 10px;color:#141414;">AI overlays available on sessions</h2>
      <div style="display:flex;flex-wrap:wrap;gap:8px;">
        {AI_OVERLAYS.map((o) => (
          <span style="font-size:12px;color:#3a3a3a;background:#f0f0eb;padding:5px 11px;border-radius:100px;">{o.label}</span>
        ))}
      </div>
    </div>

  </section>
</AquintutorLayout>
