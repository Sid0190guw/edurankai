    .capture-help{margin:0 0 9px;color:#424a55;font-size:.82rem;line-height:1.5}
    .capture-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .capture-button{border:1px solid #596575;border-radius:7px;background:#fff;color:#17202b;padding:8px 11px;font-size:.82rem;font-weight:600;cursor:pointer}
    .capture-button:hover{background:#edf2f8}
    .capture-button:disabled{opacity:.6;cursor:wait}
    .capture-status{margin:8px 0 0;color:#384352;font-size:.8rem}
    .capture-video,.capture-preview{display:none;width:100%;max-width:360px;max-height:280px;object-fit:cover;border-radius:8px;background:#10151d}
    .capture-preview{object-fit:contain}
    .signature-canvas{display:block;width:100%;height:auto;touch-action:none;border:1px solid #7a8492;border-radius:7px;background:#fff}
  </style>
</BaseLayout>
