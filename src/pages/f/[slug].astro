    .public-form-page[data-appearance="system"]{color-scheme:light}
    @media(prefers-color-scheme:dark){.public-form-page[data-appearance="system"]{--form-bg:#11151b;--form-card:#1b222b;--form-text:#f5f7fa;--form-muted:#c1cad5;--form-border:#394553;color:var(--form-text);color-scheme:dark}.public-form-page[data-appearance="system"] .appearance-picker button[aria-pressed="true"]{background:#303b48;color:#fff}}
    @media(max-width:520px){.public-form-page{padding:12px}.respondent-brand{align-items:flex-start;flex-direction:column;margin-bottom:14px}.appearance-picker{width:100%;justify-content:space-between}.appearance-picker button{flex:1;padding:8px 5px}.form-sheet{padding:19px 15px;border-radius:13px}}
    @media(prefers-reduced-motion:reduce){.public-form-page *{scroll-behavior:auto!important;transition:none!important}}
    .public-form-page~.era-fab,.era-has-fab .era-fab{display:none!important}
    .preview-notice{margin:12px 0;padding:10px 12px;border:1px solid #b45309;border-radius:8px;background:#fff7ed;color:#7c2d12;font-size:.86rem;font-weight:600}
    .preview-controls{display:flex;flex-direction:column;gap:1rem;width:100%;min-width:0;margin:0;padding:0;border:0}
