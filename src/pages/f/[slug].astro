    .public-form-page .pfi:focus{border-color:#c93e0a}
    .public-form-page .capture-box{border-color:var(--form-border);background:var(--form-bg)}
    .public-form-page .capture-help,.public-form-page .capture-status{color:var(--form-muted)}
    .public-form-page .capture-button{min-height:42px;border-color:#6b7583;background:var(--form-card);color:var(--form-text)}
    .public-form-page .preview-notice,.public-form-page .recruitment-notice{color:#71330c}
    .public-form-page[data-appearance="dark"]{--form-bg:#11151b;--form-card:#1b222b;--form-text:#f5f7fa;--form-muted:#c1cad5;--form-border:#394553;color:var(--form-text)}
    .public-form-page[data-appearance="dark"] .appearance-picker button[aria-pressed="true"]{background:#303b48;color:#fff}
