---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { isConfigured } from '@/lib/razorpay';
import { normalizeFormFields, validateFormForPublishing, type FormField } from '@/lib/forms/form-schema';
import { canAccessSection } from '@/lib/auth/permissions';

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });
const preview = new URL(Astro.request.url).searchParams.get('preview') === '1';
if (preview && !(await canAccessSection(Astro.locals.user as any, 'content', 'view'))) {
  return new Response('Not found', { status: 404 });
}
if (preview) Astro.response.headers.set('Cache-Control', 'private, no-store');
function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }
const form: any = rows(await db.execute(preview
  ? sql`SELECT * FROM forms WHERE slug = ${slug} LIMIT 1`
  : sql`SELECT * FROM forms WHERE slug = ${slug} AND is_published = true LIMIT 1`))[0];

let fields: FormField[] = [];
if (form) {
  try {
    fields = normalizeFormFields(form.fields);
    const publicationError = validateFormForPublishing(fields);
    if (publicationError) throw new Error(publicationError);
  } catch (error) {
    console.error('[public-form] invalid saved form definition:', error instanceof Error ? error.message : error);
    return new Response('This form is temporarily unavailable. Please contact the form owner.', { status: 500 });
  }
}
const feeChf = form ? (parseInt(form.fee_chf || 0) || 0) : 0;
const paymentsReady = isConfigured();
let recruitmentLink: any = null;
if (form) {
  try {
    recruitmentLink = rows(await db.execute(sql`
      SELECT r.title, r.slug, r.is_open, r.application_deadline
      FROM form_role_links l
      JOIN roles r ON r.id = l.role_id
      WHERE l.form_id = ${form.id}
      LIMIT 1
    `))[0] || null;
  } catch (error) {
    console.error('[public-form] recruitment-link lookup failed:', error instanceof Error ? error.message : error);
  }
}
const loginRequired = !!recruitmentLink && (!Astro.locals.user || Astro.locals.user.role !== 'applicant');
---
<BaseLayout title={form ? form.title : 'Form'} description={form?.description || 'EduRankAI form'} showNav={false} showFooter={false} noindex={preview}>
  <section class="public-form-page px-4 py-6 md:px-6 md:py-10">
    <div class="public-form-shell">
      <header class="respondent-brand">
        <a href="/" aria-label="EduRankAI home"><img src="/favicon.svg" alt="" width="32" height="32" /><span>EduRankAI</span></a>
        {form && <div class="appearance-picker" role="group" aria-label="Form appearance">
          <button type="button" data-appearance-choice="system" aria-pressed="true">System</button>
          <button type="button" data-appearance-choice="light" aria-pressed="false">Light</button>
          <button type="button" data-appearance-choice="dark" aria-pressed="false">Dark</button>
          <button type="button" data-appearance-choice="reading" aria-pressed="false">Reading</button>
        </div>}
      </header>
    {!form ? (
      <div class="form-sheet form-unavailable">
        <h1 class="font-display text-[1.5rem] font-semibold text-ink mb-2">Form not found</h1>
        <p class="text-[0.9rem] text-ink-soft">This form is unavailable or not published.</p>
      </div>
    ) : (
      <>
        <div class="form-sheet">
        <h1 id="formTitle" class="font-display text-[clamp(1.7rem,4.5vw,2.4rem)] font-semibold text-ink leading-tight mb-2">{form.title}</h1>
        {form.description && <p id="formDescription" class="text-[0.95rem] text-ink-soft leading-relaxed mb-2 whitespace-pre-wrap">{form.description}</p>}
        {preview && <p class="preview-notice" role="status">Private preview — this form is not accepting responses.</p>}
        {recruitmentLink && <p class="recruitment-notice">Application for <strong>{recruitmentLink.title}</strong>. Sign in with a verified applicant account before submitting. Submission creates an application in My Applications.</p>}
        {recruitmentLink && <p class="recruitment-login" style={loginRequired ? undefined : 'display:none'}><a id="recruitmentSignIn" href={'/portal/login?next=' + encodeURIComponent('/f/' + form.slug)}>Sign in to continue</a></p>}
        {feeChf > 0 && <p class="text-[0.85rem] text-ink-2 mb-5 inline-block bg-burn-pale border border-burn-dim rounded-lg px-3 py-1.5">Fee on submit: <strong>{feeChf} CHF</strong> (charged in INR via Razorpay)</p>}

        <form id="pubForm" aria-labelledby="formTitle" aria-describedby={form.description ? 'formDescription' : undefined} class="respondent-form flex flex-col gap-4 border rounded-2xl p-5 md:p-7 mt-3">
          <div class="section-progress" aria-live="polite">
            <div class="section-progress-label"><span id="sectionProgressText"></span><span id="sectionProgressPercent"></span></div>
            <progress id="sectionProgress" max="100" value="0" aria-label="Form progress"></progress>
          </div>
          <fieldset class="preview-controls">
            {fields.map((f: FormField, index: number) => (
              <>
              {(index === 0 || fields[index - 1].section !== f.section) && <div class="form-section-heading" data-section-heading={f.section}><h2>{f.section}</h2></div>}
              <div class="form-question" data-field data-section={f.section} data-key={f.key} data-type={f.type} data-required={f.required ? 'true' : 'false'} data-condition={f.condition ? JSON.stringify(f.condition) : ''}>
              {f.type === 'acknowledgment' ? (
                <div>
                  <label class="flex items-start gap-3 text-[0.9rem] text-ink-2 leading-relaxed"><input data-input type="checkbox" aria-label={f.label} required={f.required} class="accent-burn mt-1" /><span>{f.label}{f.required && <span class="text-burn"> *</span>}</span></label>
                  {f.description && <p class="field-description">{f.description}</p>}
                </div>
              ) : (
                <>
                  <label class="block text-[0.9rem] font-semibold text-ink mb-1.5">{f.label}{f.required && <span class="text-burn"> *</span>}{['selfie','location','signature'].includes(f.type) && <span class="ml-2 text-[0.78rem] font-normal text-ink-soft">(optional)</span>}</label>
                  {f.description && <p class="field-description">{f.description}</p>}
                  {f.type === 'textarea' ? (
                    <textarea data-input aria-label={f.label} required={f.required} minlength={f.minLength ?? undefined} maxlength={f.maxLength ?? undefined} rows="3" placeholder={f.placeholder || ''} class="pfi"></textarea>
                  ) : f.type === 'select' ? (
                    <select data-input aria-label={f.label} required={f.required} class="pfi"><option value="">Choose...</option>{(f.options || []).map((o: string) => <option value={o}>{o}</option>)}</select>
                  ) : f.type === 'radio' ? (
                    <div role="group" aria-label={f.label} class="flex flex-col gap-1.5">{(f.options || []).map((o: string, i: number) => <label class="flex items-center gap-2 text-[0.9rem] text-ink-2"><input type="radio" name={'r_' + f.key} value={o} required={f.required && i === 0} class="accent-burn" /> {o}</label>)}</div>
                  ) : f.type === 'checkbox' ? (
                    <div role="group" aria-label={f.label} class="flex flex-col gap-1.5">{(f.options || []).map((o: string) => <label class="flex items-center gap-2 text-[0.9rem] text-ink-2"><input type="checkbox" data-cb value={o} class="accent-burn" /> {o}</label>)}</div>
                  ) : f.type === 'yes_no' ? (
                    <div role="group" aria-label={f.label} class="flex gap-5">{['yes','no'].map((answer) => <label class="flex items-center gap-2 text-[0.9rem] text-ink-2"><input type="radio" name={'r_' + f.key} value={answer} required={f.required && answer === 'yes'} class="accent-burn" /> {answer === 'yes' ? 'Yes' : 'No'}</label>)}</div>
                  ) : f.type === 'rating' || f.type === 'linear_scale' ? (
                    <select data-input required={f.required} class="pfi" aria-label={f.type === 'rating' ? 'Choose a rating' : 'Choose a scale value'}>
                      <option value="">Choose...</option>
                      {Array.from({ length: (f.max !== null ? f.max : 5) - (f.min !== null ? f.min : 0) + 1 }, (_, index) => (f.min !== null ? f.min : 0) + index).map((value) => (
                        <option value={value}>{f.type === 'rating' ? value + ' stars' : value}</option>
                      ))}
                    </select>
                  ) : f.type === 'selfie' ? (
                    <div class="capture-box">
                      <p class="capture-help">Optional live selfie. Camera access starts only after you choose to turn it on.</p>
                      <video data-camera playsinline muted class="capture-video" aria-label="Live selfie camera preview"></video>
                      <img data-selfie-preview class="capture-preview" alt="Captured selfie preview" />
                      <div class="capture-actions">
                        <button type="button" data-camera-start class="capture-button">Turn on camera</button>
                        <button type="button" data-camera-capture class="capture-button" style="display:none;">Capture selfie</button>
                        <button type="button" data-camera-clear class="capture-button" style="display:none;">Retake / remove</button>
                      </div>
                      <p data-camera-status class="capture-status" aria-live="polite"></p>
                    </div>
                  ) : f.type === 'location' ? (
                    <div class="capture-box">
                      <p class="capture-help">Optional location. Your browser asks for permission only after you press the button.</p>
                      <button type="button" data-location-capture class="capture-button">Share current location</button>
                      <button type="button" data-location-clear class="capture-button" style="display:none;">Remove location</button>
                      <p data-location-status class="capture-status" aria-live="polite">No location shared.</p>
                    </div>
                  ) : f.type === 'signature' ? (
                    <div class="capture-box">
                      <p class="capture-help">Optional. Draw your signature below; it is included only if you choose to sign.</p>
                      <canvas data-signature class="signature-canvas" width="640" height="180" aria-label="Draw your signature here"></canvas>
                      <button type="button" data-signature-clear class="capture-button" style="margin-top:8px;">Clear signature</button>
                    </div>
                  ) : (
                    <div>
                      <input data-input aria-label={f.label} type={['number','currency','percentage','duration'].includes(f.type) ? 'number' : f.type === 'email' ? 'email' : f.type === 'url' ? 'url' : f.type === 'date' ? 'date' : f.type === 'time' ? 'time' : f.type === 'datetime' ? 'datetime-local' : f.type === 'phone' ? 'tel' : 'text'} step={['currency','percentage'].includes(f.type) ? 'any' : undefined} required={f.required} min={f.min ?? undefined} max={f.max ?? undefined} minlength={f.minLength ?? undefined} maxlength={f.maxLength ?? undefined} autocomplete={f.type === 'phone' ? 'tel' : f.type === 'email' ? 'email' : undefined} placeholder={f.placeholder || ''} class="pfi" />
                      {f.example && <p class="field-example">{f.example}</p>}
                    </div>
                  )}
                  {f.example && ['textarea','select','radio','checkbox','yes_no','rating','linear_scale'].includes(f.type) && <p class="field-example">{f.example}</p>}
                </>
              )}
              </div>
              </>
            ))}
            <div class="section-actions">
              <button type="button" id="sectionBack" class="section-button" style="display:none;">Back</button>
              <button type="button" id="sectionContinue" class="section-button section-button-primary" style="display:none;">Continue</button>
            </div>
            <button type="submit" id="pubSubmit" disabled={preview} class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 rounded-lg text-[0.92rem] mt-1">{preview ? 'Preview only' : feeChf > 0 ? 'Pay ' + feeChf + ' CHF & submit' : 'Submit'}</button>
            <p id="pubErr" class="text-[0.82rem] text-red-700 text-center" style="display:none;"></p>
          </fieldset>
        </form>
        <div id="pubDone" style="display:none;" class="bg-leaf-bg/40 border border-leaf-border rounded-2xl p-6 text-center mt-3">
          <p class="font-semibold text-leaf mb-1">Submitted</p>
          <p id="pubDoneMsg" class="text-[0.9rem] text-ink-2"></p>
        </div>
        </div>
      </>
    )}
    </div>
  </section>

  {form && (
    <>
      {feeChf > 0 && paymentsReady && !preview && <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>}
      <script is:inline define:vars={{ slug, fee: feeChf, preview, sectionNames: Array.from(new Set(fields.map((field) => field.section))) }}>
        (function () {
          var form = document.getElementById('pubForm'); if (!form) return;
          var err = document.getElementById('pubErr'), btn = document.getElementById('pubSubmit');
          var sections = Array.isArray(sectionNames) && sectionNames.length ? sectionNames : ['General'];
          var activeSection = 0;
          var sectionBack = document.getElementById('sectionBack');
          var sectionContinue = document.getElementById('sectionContinue');
          function showErr(m) { err.textContent = m; err.style.display = 'block'; }
          function done(msg) { form.style.display = 'none'; document.getElementById('pubDone').style.display = 'block'; document.getElementById('pubDoneMsg').textContent = msg || 'Your response has been recorded.'; }
          function setSection(index) {
            activeSection = Math.max(0, Math.min(index, sections.length - 1));
            var name = sections[activeSection];
            document.querySelectorAll('[data-section-heading]').forEach(function (heading) {
              heading.style.display = heading.getAttribute('data-section-heading') === name ? '' : 'none';
            });
            document.querySelectorAll('[data-field]').forEach(function (wrap) {
              var isCurrent = wrap.getAttribute('data-section') === name;
              wrap.classList.toggle('form-question-inactive', !isCurrent);
              if (!isCurrent && typeof wrap.__stopCamera === 'function') wrap.__stopCamera();
              wrap.querySelectorAll('input,select,textarea,button').forEach(function (control) {
                control.disabled = !isCurrent || wrap.hidden;
              });
            });
            var progress = document.getElementById('sectionProgress');
            var progressText = document.getElementById('sectionProgressText');
            var progressPercent = document.getElementById('sectionProgressPercent');
            progress.value = Math.round(((activeSection + 1) / sections.length) * 100);
            progressText.textContent = sections.length > 1
              ? 'Section ' + (activeSection + 1) + ' of ' + sections.length + ' · ' + name
              : name;
            progressPercent.textContent = progress.value + '%';
            sectionBack.style.display = activeSection > 0 ? '' : 'none';
            sectionContinue.style.display = activeSection < sections.length - 1 ? '' : 'none';
            btn.style.display = activeSection === sections.length - 1 ? '' : 'none';
          }
          function applyAppearance(appearance) {
            var supported = ['system', 'light', 'dark', 'reading'];
            if (supported.indexOf(appearance) < 0) appearance = 'system';
            document.querySelector('.public-form-page').setAttribute('data-appearance', appearance);
            document.querySelectorAll('[data-appearance-choice]').forEach(function (choice) {
              choice.setAttribute('aria-pressed', choice.getAttribute('data-appearance-choice') === appearance ? 'true' : 'false');
            });
            try { localStorage.setItem('edurankai-form-appearance', appearance); } catch (_) {}
          }
          var savedAppearance = 'system';
          try { savedAppearance = localStorage.getItem('edurankai-form-appearance') || 'system'; } catch (_) {}
          applyAppearance(savedAppearance);
          document.querySelectorAll('[data-appearance-choice]').forEach(function (choice) {
            choice.addEventListener('click', function () {
              applyAppearance(choice.getAttribute('data-appearance-choice'));
            });
          });
          function collect() {
            var data = Object.create(null);
            document.querySelectorAll('[data-field]').forEach(function (wrap) {
              var key = wrap.getAttribute('data-key'), type = wrap.getAttribute('data-type');
              if (type === 'acknowledgment') { var ack = wrap.querySelector('[data-input]'); data[key] = !!(ack && ack.checked); }
              else if (type === 'selfie' || type === 'location') {
                var captured = wrap.getAttribute('data-value') || '';
                if (type === 'location' && captured) { try { data[key] = JSON.parse(captured); } catch (_) { data[key] = ''; } }
                else data[key] = captured;
              }
              else if (type === 'signature') {
                var canvas = wrap.querySelector('[data-signature]');
                data[key] = canvas && canvas.getAttribute('data-signed') === 'true' ? canvas.toDataURL('image/png') : '';
              }
              else if (type === 'radio' || type === 'yes_no') { var c = wrap.querySelector('input[type=radio]:checked'); data[key] = c ? c.value : ''; }
              else if (type === 'checkbox') { var arr = []; wrap.querySelectorAll('[data-cb]:checked').forEach(function (x) { arr.push(x.value); }); data[key] = arr; }
              else { var el = wrap.querySelector('[data-input]'); data[key] = el ? el.value.trim() : ''; }
            });
            return data;
          }
          function readValue(wrap) {
            var type = wrap.getAttribute('data-type');
            if (type === 'radio' || type === 'yes_no') {
              var checked = wrap.querySelector('input[type=radio]:checked');
              return checked ? checked.value : '';
            }
            if (type === 'checkbox') {
              var checkedOptions = [];
              wrap.querySelectorAll('[data-cb]:checked').forEach(function (input) { checkedOptions.push(input.value); });
              return checkedOptions;
            }
            var input = wrap.querySelector('[data-input]');
            return input ? input.value.trim() : '';
          }
          function updateConditionalFields() {
            var wrappers = Array.prototype.slice.call(document.querySelectorAll('[data-field]'));
            wrappers.forEach(function (wrap) {
              var raw = wrap.getAttribute('data-condition');
              if (!raw) return;
              var condition;
              try { condition = JSON.parse(raw); } catch (_) { wrap.hidden = true; return; }
              var source = wrappers.find(function (candidate) { return candidate.getAttribute('data-key') === condition.fieldKey; });
              var value = source && !source.hidden ? readValue(source) : '';
              var answered = Array.isArray(value) ? value.length > 0 : value !== '';
              var visible = true;
              if (condition.operator === 'answered') visible = answered;
              else if (condition.operator === 'not_answered') visible = !answered;
              else {
                var equal = Array.isArray(value) ? value.indexOf(condition.value) >= 0 : String(value) === condition.value;
                visible = condition.operator === 'equals' ? equal : !equal;
              }
              wrap.hidden = !visible;
              if (!visible && typeof wrap.__stopCamera === 'function') wrap.__stopCamera();
              wrap.querySelectorAll('input,select,textarea').forEach(function (control) {
                if (!control.hasAttribute('data-rule-required')) {
                  control.setAttribute('data-rule-required', control.required ? 'true' : 'false');
                }
                control.required = visible && control.getAttribute('data-rule-required') === 'true';
              });
            });
            setSection(activeSection);
          }
          form.addEventListener('input', updateConditionalFields);
          form.addEventListener('change', updateConditionalFields);
          updateConditionalFields();
          function validateCurrentSection() {
            if (!form.reportValidity()) return false;
            var valid = true;
            document.querySelectorAll('[data-field][data-type="checkbox"]').forEach(function (wrap) {
              var input = wrap.querySelector('[data-cb]');
              if (wrap.getAttribute('data-section') === sections[activeSection] &&
                  !wrap.hidden && wrap.getAttribute('data-required') === 'true' &&
                  input && !wrap.querySelector('[data-cb]:checked')) {
                showErr('Please choose at least one option.');
                input.focus();
                valid = false;
              }
            });
            return valid;
          }
          sectionBack.addEventListener('click', function () {
            err.style.display = 'none';
            setSection(activeSection - 1);
            document.getElementById('formTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          sectionContinue.addEventListener('click', function () {
            err.style.display = 'none';
            if (!validateCurrentSection()) return;
            setSection(activeSection + 1);
            document.getElementById('formTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          if (preview) return;
          function validateChoiceGroups() {
            var ok = true;
            document.querySelectorAll('[data-field][data-type="checkbox"]').forEach(function (wrap) {
              var input = wrap.querySelector('[data-cb]');
              if (wrap.getAttribute('data-section') === sections[activeSection] &&
                  !wrap.hidden && wrap.getAttribute('data-required') === 'true' && input && !wrap.querySelector('[data-cb]:checked')) {
                showErr('Please choose at least one option.');
                input.focus();
                ok = false;
              }
            });
            return ok;
          }
          document.querySelectorAll('[data-field][data-type="selfie"]').forEach(function (wrap) {
            var start = wrap.querySelector('[data-camera-start]');
            var capture = wrap.querySelector('[data-camera-capture]');
            var clear = wrap.querySelector('[data-camera-clear]');
            var video = wrap.querySelector('[data-camera]');
            var preview = wrap.querySelector('[data-selfie-preview]');
            var status = wrap.querySelector('[data-camera-status]');
            var stream = null;
            function stopCamera() {
              if (stream) stream.getTracks().forEach(function (track) { track.stop(); });
              stream = null;
              video.srcObject = null;
              video.style.display = 'none';
              capture.style.display = 'none';
              start.style.display = '';
            }
            wrap.__stopCamera = stopCamera;
            start.addEventListener('click', function () {
              if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                status.textContent = 'Live camera capture is not available in this browser. You can leave this optional field blank.';
                return;
              }
              start.disabled = true;
              navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false }).then(function (result) {
                stream = result;
                video.srcObject = stream;
                video.style.display = 'block';
                start.style.display = 'none';
                capture.style.display = '';
                start.disabled = false;
                return video.play();
              }).catch(function () {
                stopCamera();
                start.disabled = false;
                status.textContent = 'Camera permission was not granted or the camera is unavailable. This field is optional.';
              });
            });
            capture.addEventListener('click', function () {
              if (!video.videoWidth || !video.videoHeight) {
                status.textContent = 'Wait for the camera preview, then try again.';
                return;
              }
              var scale = Math.min(1, 640 / video.videoWidth);
              var quality = 0.5;
              var canvas = document.createElement('canvas');
              var image = '';
              do {
                canvas.width = Math.round(video.videoWidth * scale);
                canvas.height = Math.round(video.videoHeight * scale);
                canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                image = canvas.toDataURL('image/jpeg', quality);
                if (image.length <= 45000) break;
                if (quality > 0.3) quality -= 0.1;
                else scale *= 0.8;
              } while (scale > 0.2);
              if (image.length > 50000) {
                status.textContent = 'This image could not be compressed enough. Please try again or leave the field blank.';
                return;
              }
              wrap.setAttribute('data-value', image);
              preview.src = image;
              preview.style.display = 'block';
              clear.style.display = '';
              status.textContent = 'Selfie captured. It will be submitted with this form.';
              stopCamera();
            });
            clear.addEventListener('click', function () {
              wrap.removeAttribute('data-value');
              preview.removeAttribute('src');
              preview.style.display = 'none';
              clear.style.display = 'none';
              status.textContent = 'Selfie removed. You may capture another or leave this blank.';
            });
            window.addEventListener('pagehide', stopCamera);
          });
          document.querySelectorAll('[data-field][data-type="location"]').forEach(function (wrap) {
            var capture = wrap.querySelector('[data-location-capture]');
            var clear = wrap.querySelector('[data-location-clear]');
            var status = wrap.querySelector('[data-location-status]');
            capture.addEventListener('click', function () {
              if (!navigator.geolocation) {
                status.textContent = 'Location is not available in this browser. This field is optional.';
                return;
              }
              capture.disabled = true;
              status.textContent = 'Waiting for your browser location permission...';
              navigator.geolocation.getCurrentPosition(function (position) {
                wrap.setAttribute('data-value', JSON.stringify({
                  latitude: position.coords.latitude,
                  longitude: position.coords.longitude,
                  accuracy: position.coords.accuracy,
                  capturedAt: new Date(position.timestamp).toISOString()
                }));
                status.textContent = 'Location added. It will be submitted with this form.';
                clear.style.display = '';
                capture.disabled = false;
              }, function () {
                status.textContent = 'Location permission was not granted or location is unavailable. This field is optional.';
                capture.disabled = false;
              }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
            });
            clear.addEventListener('click', function () {
              wrap.removeAttribute('data-value');
              clear.style.display = 'none';
              status.textContent = 'Location removed.';
            });
          });
          document.querySelectorAll('[data-field][data-type="signature"]').forEach(function (wrap) {
            var canvas = wrap.querySelector('[data-signature]');
            var context = canvas.getContext('2d');
            var drawing = false;
            context.strokeStyle = '#17202b';
            context.lineWidth = 3;
            context.lineCap = 'round';
            context.lineJoin = 'round';
            canvas.addEventListener('pointerdown', function (event) {
              drawing = true;
              canvas.setPointerCapture(event.pointerId);
              var rect = canvas.getBoundingClientRect();
              context.beginPath();
              context.moveTo((event.clientX - rect.left) * canvas.width / rect.width, (event.clientY - rect.top) * canvas.height / rect.height);
              event.preventDefault();
            });
            canvas.addEventListener('pointermove', function (event) {
              if (!drawing) return;
              var rect = canvas.getBoundingClientRect();
              context.lineTo((event.clientX - rect.left) * canvas.width / rect.width, (event.clientY - rect.top) * canvas.height / rect.height);
              context.stroke();
              canvas.setAttribute('data-signed', 'true');
              event.preventDefault();
            });
            function stopDrawing() { drawing = false; }
            canvas.addEventListener('pointerup', stopDrawing);
            canvas.addEventListener('pointercancel', stopDrawing);
            wrap.querySelector('[data-signature-clear]').addEventListener('click', function () {
              context.clearRect(0, 0, canvas.width, canvas.height);
              canvas.removeAttribute('data-signed');
            });
          });
          form.addEventListener('submit', function (e) {
            e.preventDefault(); err.style.display = 'none';
            if (activeSection < sections.length - 1) {
              if (!validateCurrentSection()) return;
              setSection(activeSection + 1);
              document.getElementById('formTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
              return;
            }
            if (!form.reportValidity() || !validateChoiceGroups()) return;
            document.querySelectorAll('[data-field]').forEach(function (wrap) {
              if (typeof wrap.__stopCamera === 'function') wrap.__stopCamera();
            });
            var prev = btn.textContent; btn.disabled = true; btn.textContent = 'Submitting...';
            fetch('/api/forms/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: slug, data: collect() }) })
              .then(function (r) { return r.json(); }).then(function (d) {
                if (!d.ok) {
                  btn.disabled = false; btn.textContent = prev; showErr(d.error || 'Could not submit.');
                  if (d.signInUrl) { var login = document.getElementById('recruitmentSignIn'); if (login) login.href = d.signInUrl; }
                  return;
                }
                if (d.redirect) { window.location.assign(d.redirect); return; }
                if (d.done) { done(d.message); return; }
                if (typeof Razorpay === 'undefined') { btn.disabled = false; btn.textContent = prev; showErr('Razorpay failed to load.'); return; }
                var rzp = new Razorpay({ key: d.keyId, amount: d.amountPaise, currency: d.currency, name: 'EduRankAI', description: d.formTitle || 'Form fee', order_id: d.orderId, prefill: d.prefill || {}, theme: { color: '#FF4F00' },
                  handler: function (resp) { btn.textContent = 'Verifying...';
                    fetch('/api/forms/confirm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ razorpay_order_id: resp.razorpay_order_id, razorpay_payment_id: resp.razorpay_payment_id, razorpay_signature: resp.razorpay_signature }) })
                      .then(function (r) { return r.json(); }).then(function (c) { if (c.ok) { done(c.message); } else { btn.disabled = false; btn.textContent = prev; showErr(c.error || 'Verify failed.'); } })
                      .catch(function () { btn.disabled = false; btn.textContent = prev; showErr('Network error.'); });
                  },
                  modal: { ondismiss: function () { btn.disabled = false; btn.textContent = prev; } } });
                rzp.open();
              }).catch(function () { btn.disabled = false; btn.textContent = prev; showErr('Network error.'); });
          });
        })();
      </script>
    </>
  )}
  <style>
    .public-form-page{--form-bg:#f4f5f7;--form-card:#fff;--form-text:#17202b;--form-muted:#4c5868;--form-border:#d7dce2;min-height:calc(100vh - 1px);background:var(--form-bg);color:var(--form-text);font-family:Inter,ui-sans-serif,system-ui,sans-serif}
    .public-form-shell{width:min(100%,48rem);margin:0 auto}
    .respondent-brand{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:0 auto 22px;padding:4px 2px}
    .respondent-brand>a{display:inline-flex;align-items:center;gap:9px;color:var(--form-text);font-weight:750;text-decoration:none;font-size:1rem;letter-spacing:-.02em}
    .respondent-brand>a img{width:32px;height:32px;object-fit:contain}
    .appearance-picker{display:flex;gap:3px;padding:3px;border:1px solid var(--form-border);border-radius:10px;background:var(--form-card)}
    .appearance-picker button{border:0;border-radius:7px;padding:6px 9px;background:transparent;color:var(--form-muted);font:600 .72rem/1.1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer}
    .appearance-picker button[aria-pressed="true"]{background:#e9edf2;color:var(--form-text)}
    .form-sheet{padding:clamp(20px,5vw,36px);border:1px solid var(--form-border);border-top:5px solid #ff4f00;border-radius:16px;background:var(--form-card);box-shadow:0 14px 44px rgba(23,32,43,.07)}
    .respondent-form{border-color:var(--form-border);background:var(--form-card);box-shadow:none}
    .form-question{padding:3px 0}
    .form-question-inactive{display:none!important}
    .section-progress{display:grid;gap:7px;margin:0 0 3px;color:var(--form-muted);font-size:.78rem;font-weight:650}
    .section-progress-label{display:flex;justify-content:space-between;gap:12px}
    .section-progress progress{width:100%;height:7px;overflow:hidden;border:0;border-radius:99px;background:#e8ebef;accent-color:#e4480b}
    .section-progress progress::-webkit-progress-bar{border-radius:99px;background:#e8ebef}
    .section-progress progress::-webkit-progress-value{border-radius:99px;background:#e4480b}
    .section-progress progress::-moz-progress-bar{border-radius:99px;background:#e4480b}
    .section-actions{display:flex;justify-content:space-between;gap:12px;margin-top:4px}
    .section-button{min-height:44px;padding:9px 16px;border:1px solid var(--form-border);border-radius:8px;background:var(--form-card);color:var(--form-text);font:650 .9rem Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer}
    .section-button-primary{margin-left:auto;border-color:#c83d0b;background:#c83d0b;color:#fff}
    .section-button:hover{filter:brightness(.96)}
    .section-button:focus-visible,.appearance-picker button:focus-visible{outline:3px solid #f97316;outline-offset:2px}
    .public-form-page .text-ink,.public-form-page .text-ink-2{color:var(--form-text)}
    .public-form-page .text-ink-soft{color:var(--form-muted)}
    .public-form-page .form-section-heading{border-color:var(--form-border)}
    .public-form-page .form-section-heading h2{color:var(--form-text)}
    .public-form-page .field-description,.public-form-page .field-example{color:var(--form-muted)}
