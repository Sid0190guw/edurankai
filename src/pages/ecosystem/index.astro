---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Products from '@/components/home/Products.astro';
---
<BaseLayout title="Ecosystem - EduRankAI" description="Foundational research anchors the lab. Around it, we incubate ventures where our reasoning systems can meet the real world — education, travel, relationships, work. Explore the full EduRankAI ecosystem.">
  <section class="px-[5vw] pt-9 md:pt-12 pb-3 max-w-7xl mx-auto">
    <p class="eyebrow mb-2">EduRankAI</p>
    <h1 class="font-display text-[clamp(2rem,5.5vw,3.4rem)] font-semibold text-ink leading-[1.04] tracking-tight">
      One foundation. <em class="italic text-burn font-medium">Many ventures.</em>
    </h1>
  </section>
  <Products />
</BaseLayout>
