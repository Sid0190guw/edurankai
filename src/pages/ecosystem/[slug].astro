---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { products } from '@/lib/db/schema';
import { eq, and } from 'drizzle-orm';
import { getRolesForProduct, getProductTeamBreakdown } from '@/lib/role-products';
import { domainForProduct } from '@/lib/product-domains';
import { ensureVentureCopy, VENTURE_COPY } from '@/lib/products-seed';
import SambandhHero from '@/components/ecosystem-heroes/SambandhHero.astro';
import SamparkHero from '@/components/ecosystem-heroes/SamparkHero.astro';
import SancharanHero from '@/components/ecosystem-heroes/SancharanHero.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/ecosystem');

// Self-heal the three consumer-venture rows (travel / CRM / matchmaking copy)
// before reading — replaces stale education-placeholder text in the DB once.
await ensureVentureCopy();

// Canonical-known products get rendered even when the DB seed has not run
// yet. Copy comes from the same VENTURE_COPY source of truth as the DB sync.
const KNOWN: Record<string, any> = {};
for (const v of VENTURE_COPY) {
  KNOWN[v.slug] = {
    slug: v.slug,
    name: v.name,
    status: 'in_development',
    shortDescription: v.short,
    longDescription: v.long,
    externalUrl: null,
  };
}

const found = await db.select().from(products)
  .where(and(eq(products.slug, slug), eq(products.isVisible, true)))
  .limit(1);

const product: any = found[0] || KNOWN[slug] || null;
if (!product) return Astro.redirect('/ecosystem');

// Open roles that build THIS venture: explicitly tagged to it, OR posted by one of the teams whose
// work IS this venture (src/lib/product-domains.ts). The cross-company teams — engineering,
// ai-research, design, growth — are mapped to no venture at all, so AquinTutor and Karate.support
// still never show each other's openings, which is what the tag-only rule was protecting.
//
// It was protecting it by showing nothing. Two of ~630 catalogue roles carry a tag, so this section
// read "no roles are open right now" on every venture page while the aerospace, sports-tech and
// learning-design teams were all hiring.
const ROLE_PREVIEW = 8;
const roleResult = await getRolesForProduct(product.slug, ROLE_PREVIEW);
const relatedRoles = roleResult.roles;
const domain = domainForProduct(product.slug);

// The honest total and the per-team split, in one round trip. Without the total this section would
// show eight cards and say nothing about the ones behind them — the same understatement in a
// smaller size.
const breakdown = await getProductTeamBreakdown(product.slug);
const totalOpen = breakdown.total;
const shownCount = relatedRoles.length;
const moreCount = totalOpen > shownCount ? totalOpen - shownCount : 0;
const totalLabel = totalOpen === 1 ? '1 open role' : totalOpen + ' open roles';

// A FAILED READ IS NOT AN EMPTY CATALOGUE, and this page must never print the second when it means
// the first. That confusion is the entire bug this section was rewritten to fix; reintroducing it
// one layer down — where the sentence is produced by a swallowed exception instead of by an empty
// tag column — would be the same false claim with a new cause.
const rolesReadable = roleResult.readable && breakdown.readable;
const rolesDegraded = roleResult.degraded || breakdown.degraded;

// Said in the page's own voice: a visitor should understand what they are looking at without
// knowing the word "department".
const teamNames = breakdown.teams.map((t) => t.name);
const rolesBlurb = !rolesReadable
  ? 'We could not load our openings just now.'
  : teamNames.length
    ? totalLabel + ' on the ' + (teamNames.length === 1 ? 'team' : 'teams') + ' building it.'
    : 'Open roles building this product specifically.';

// Three different facts, three different sentences. An unstaffed venture, an empty catalogue and a
// database that would not answer are not the same thing and must not read the same.
const emptyReason = !rolesReadable
  ? 'We could not load our openings just now. This is a problem on our side, not a statement that '
    + 'nothing is open — please try again shortly, or browse every role below.'
  : domain && domain.departments.length === 0
    ? 'No team is hiring against ' + product.name + ' right now — the people building it come from across the company.'
    : 'No ' + product.name + ' roles are open right now.';

const STATUS_LABELS: Record<string, string> = {
  live: 'Live',
  coming_soon: 'Coming Soon',
  in_development: 'In Development',
  research: 'Research',
  stealth: 'Stealth'
};

const STATUS_COLORS: Record<string, string> = {
  live: 'bg-leaf-bg text-leaf border-leaf-border',
  coming_soon: 'bg-burn-pale text-burn border-burn-dim',
  in_development: 'bg-sky-bg text-sky border-sky-border',
  research: 'bg-plum-bg text-plum border-plum-border',
  stealth: 'bg-ink/5 text-ink-soft border-ink/15'
};

const statusClass = STATUS_COLORS[product.status] || 'bg-cream-2 text-ink-soft border-ink/15';
const statusLabel = STATUS_LABELS[product.status] || product.status;

// On-site products live at real routes — link ecosystem → the actual product
// even when external_url isn't set in the DB, so HEI / AquinTutor / Research are
// reachable from the ecosystem instead of dead-ending on this marketing page.
const LIVE_ROUTE: Record<string, string> = {
  'hei': '/hei',
  'aquintutor-ai': '/aquintutor',
  'foundational-models': '/research',
};
const visitUrl: string | null = product.externalUrl || LIVE_ROUTE[slug] || null;
const visitExternal = !!visitUrl && /^https?:\/\//i.test(visitUrl);
const visitLabel = (visitExternal ? 'Visit ' : 'Open ') + product.name;
---
<BaseLayout title={product.name + ' - EduRankAI'} description={product.shortDescription || ''}>

  {slug === 'sambandh' && <SambandhHero />}
  {slug === 'sampark' && <SamparkHero />}
  {slug === 'sancharan' && <SancharanHero />}

  <section class="px-[5vw] py-10 md:py-16 max-w-3xl mx-auto">

    <div class="mb-6">
      <a href="/ecosystem" class="text-[0.82rem] text-ink-soft hover:text-burn font-mono">Back to ecosystem</a>
    </div>

    <div class="mb-8 pb-8 border-b border-ink/8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class={'inline-block text-[0.7rem] font-bold uppercase tracking-wider border px-3 py-1 rounded-full ' + statusClass}>
          {statusLabel}
        </span>
      </div>
      <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-semibold text-ink leading-[1.05] tracking-tight mb-4">
        {product.name}
      </h1>
      <p class="text-[1.05rem] text-ink-soft leading-relaxed">
        {product.shortDescription}
      </p>
      {visitUrl && (
        <a href={visitUrl} target={visitExternal ? '_blank' : undefined} rel={visitExternal ? 'noopener' : undefined} class="mt-5 inline-flex items-center gap-2 bg-burn hover:bg-burn/90 text-white font-semibold py-2.5 px-5 rounded-lg text-[0.88rem] transition-all">
          {visitLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17l10-10M7 7h10v10"/></svg>
        </a>
      )}
    </div>

    {product.longDescription && (
      <div class="mb-10">
        <h2 class="font-display text-[1.3rem] font-semibold text-ink mb-3">About</h2>
        <div class="text-[0.95rem] text-ink-2 leading-relaxed whitespace-pre-wrap">
          {product.longDescription}
        </div>
      </div>
    )}

    {product.status === 'in_development' && (
      <div class="bg-sky-bg/40 border border-sky-border rounded-2xl p-5 md:p-6 mb-10">
        <p class="font-semibold text-sky mb-2 text-[0.95rem]">In active development</p>
        <p class="text-[0.88rem] text-ink-2 leading-relaxed">
          We are building this product right now. If you would like to contribute, see our open roles or get in touch directly.
        </p>
      </div>
    )}

    {product.status === 'research' && (
      <div class="bg-plum-bg/40 border border-plum-border rounded-2xl p-5 md:p-6 mb-10">
        <p class="font-semibold text-plum mb-2 text-[0.95rem]">Research stage</p>
        <p class="text-[0.88rem] text-ink-2 leading-relaxed">
          This is exploratory research, not a product. We share findings as they mature. Collaborators and researchers welcome to reach out.
        </p>
      </div>
    )}

    {product.status === 'coming_soon' && (
      <div class="bg-burn-pale/60 border border-burn-dim rounded-2xl p-5 md:p-6 mb-10">
        <p class="font-semibold text-burn mb-2 text-[0.95rem]">Launching soon</p>
        <p class="text-[0.88rem] text-ink-2 leading-relaxed">
          This product has a scheduled launch. Visit the link above for the live status, or reach out via Contact for early access.
        </p>
      </div>
    )}

    <div class="mb-10">
      <h2 class="font-display text-[1.3rem] font-semibold text-ink mb-1">Work on {product.name}</h2>
      <p class="text-[0.85rem] text-ink-soft italic mb-4">{rolesBlurb}</p>
      {rolesReadable && rolesDegraded && (
        <p class="text-[0.78rem] text-ink-2 bg-cream-2 border border-ink/10 rounded-lg px-3 py-2 mb-4">
          Partial list: some of our role data was unavailable, so this may miss openings or include one
          that has just closed. <a href="/careers" class="text-burn font-semibold hover:underline">The full careers listing</a> is authoritative.
        </p>
      )}
      {relatedRoles.length > 0 ? (
        <Fragment>
          <div class="flex flex-col gap-2">
            {relatedRoles.map((r) => (
              <a href={'/careers/' + r.slug} class="bg-white border border-ink/10 hover:border-burn-dim rounded-lg p-3.5 flex items-center justify-between gap-3 transition-all group">
                <div>
                  <p class="font-semibold text-ink text-[0.92rem] group-hover:text-burn transition-colors">{r.title}</p>
                  <p class="text-[0.75rem] text-ink-soft mt-0.5">{r.level} - {r.department_name || r.department_id}{r.openings > 0 ? ' · ' + r.openings + (r.openings === 1 ? ' opening' : ' openings') : ''}</p>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-ink-soft group-hover:text-burn transition-colors"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            ))}
          </div>
          {breakdown.teams.length > 0 && (
            <div class="mt-4">
              <p class="text-[0.72rem] font-mono uppercase tracking-[0.12em] text-ink-soft mb-2">
                {moreCount > 0 ? 'Teams building this, with all ' + totalLabel : 'Teams building this'}
              </p>
              <div class="flex flex-wrap gap-2">
                {breakdown.teams.map((t) => (
                  <a href={'/careers/department/' + t.id} class="inline-flex items-center gap-1.5 bg-cream-2 hover:bg-burn-pale border border-ink/10 hover:border-burn-dim rounded-full px-3 py-1.5 text-[0.78rem] text-ink-2 hover:text-burn transition-all">
                    <span>{t.name}</span>
                    <span class="font-mono text-[0.7rem] text-ink-soft">{t.openCount}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </Fragment>
      ) : (
        <div class="bg-cream-2 border border-dashed border-ink/15 rounded-xl p-5 text-center">
          <p class="text-[0.88rem] text-ink-2 mb-1">{emptyReason}</p>
          <a href="/careers" class="text-[0.85rem] text-burn font-semibold hover:underline">Browse all open roles -&gt;</a>
        </div>
      )}
    </div>

  </section>

</BaseLayout>