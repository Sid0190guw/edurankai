---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { users } from '@/lib/db/schema';
import { eq, sql } from 'drizzle-orm';
import { generateSessionToken, createSession } from '@/lib/auth/session';
import { setSessionCookie } from '@/lib/auth/cookie';
import { findUserByLoginIdentifier, verifyPasswordForLogin } from '@/lib/auth/handle';
import {
  isSecondStepRequired, availableSecondFactors, startPendingChallenge,
  resolvePendingChallenge, verifySecondFactor, dropPendingChallenge,
  pendingCookieName, verifyFaceSecondFactor, canCompleteSecondStep,
  passwordAttemptsBlocked, recordFailedPassword, clearPasswordAttempts,
  PASSWORD_THROTTLED_MESSAGE,
  PENDING_TTL_SECONDS, PENDING_COOKIE_SECURE,
  type SecondFactorMethod,
} from '@/lib/auth/two-factor';

// 'institution_admin' IS A LIVE ROLE VALUE THAT src/lib/db/schema.ts DOES NOT LIST.
// scripts/fix-user-role-enum.mjs adds it to the Postgres `user_role` enum alongside recruiter /
// reviewer / department_head / marketing, but userRoleEnum in schema.ts stops short of it — so
// TypeScript types users.role as a union that cannot contain it and every comparison below reads as
// dead code (ts2367) while working perfectly at runtime. Comparing as a string is the mechanism fix:
// it changes nothing that executes and stops the type system asserting something untrue about the
// data. Adding the value to userRoleEnum is the real repair, and it is NOT a mechanism change —
// ROLE_LABELS, PERMS_BY_ROLE and ROLE_SECTIONS in src/lib/auth/permissions.ts are typed
// Record<User['role'], ...>, so the compiler would immediately demand a decision about what an
// institution admin may do inside the main admin panel. That is a policy call for a person.
if (Astro.locals.user && String(Astro.locals.user.role) === 'institution_admin') {
  return Astro.redirect('/hei/portal');
}

// Declared before the handler that uses them - `const` is not hoisted.
const SURFACE = 'hei' as const;
const PENDING_COOKIE = pendingCookieName(SURFACE);
const LEGACY_FACE_COOKIE = 'hei_face_pending';
/** The source address, in the shape every limiter on this project keys on. */
const CLIENT_IP = (Astro.clientAddress || Astro.request.headers.get('x-forwarded-for') || 'unknown')
  .toString().split(',')[0].trim().slice(0, 64);

function setPendingCookie(cookies: any, token: string) {
  cookies.set(PENDING_COOKIE, token, {
    path: '/', httpOnly: true, sameSite: 'lax', secure: PENDING_COOKIE_SECURE, maxAge: PENDING_TTL_SECONDS,
  });
}
function clearPendingCookies(cookies: any) {
  cookies.delete(PENDING_COOKIE, { path: '/' });
  cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
}

let errorMsg = '';
let noticeMsg = '';
let requireSecondStep = false;
let pendingUserName = '';
let offerFace = false;
let offerCode = false;

// The half-finished sign-in is named by an opaque server-minted token, not by a
// user id the client can set.
let pendingToken = Astro.cookies.get(PENDING_COOKIE)?.value || '';

if (Astro.request.method === 'POST') {
  const fd2 = await Astro.request.formData();
  const action = (fd2.get('action') as string) || '';

  if (action === 'second_factor') {
    const method = ((fd2.get('method') as string) || 'totp') as SecondFactorMethod;
    const payload = method === 'face'
      ? ((fd2.get('live_descriptor') as string) || '')
      : ((fd2.get('code') as string) || '').trim();
    try {
      if (method === 'face') {
        const peek = await resolvePendingChallenge(pendingToken, SURFACE);
        if (peek) {
          const r = await verifyFaceSecondFactor(peek.userId, payload);
          await db.execute(sql`
            INSERT INTO identity_verifications (user_id, email, claimed_name, method, face_match_distance, face_match_passed, verdict, ip_address, user_agent)
            VALUES (${peek.userId}, ${''}, ${''}, 'face_login', ${Number.isFinite(r.distance) ? r.distance : null}, ${r.matched}, ${r.matched ? 'verified' : 'rejected'}, ${(Astro.clientAddress || '').toString().slice(0, 64) || null}, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500)})
          `).catch(() => {});
        }
      }
      const result = await verifySecondFactor(pendingToken, SURFACE, method, payload);
      if (!result.ok) {
        errorMsg = result.error;
        if (result.locked) { clearPendingCookies(Astro.cookies); pendingToken = ''; }
      } else {
        if (method === 'face') {
          await db.execute(sql`UPDATE user_face_enrollments SET last_used_at = NOW() WHERE user_id = ${result.userId}`).catch(() => {});
        }
        const token = generateSessionToken();
        const session = await createSession(token, result.userId, {
          userAgent: Astro.request.headers.get('user-agent') || undefined,
          ipAddress: Astro.clientAddress,
        });
        setSessionCookie(Astro.cookies, token, session.expiresAt);
        await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, result.userId)).catch(() => {});
        clearPendingCookies(Astro.cookies);
        return Astro.redirect('/hei/portal');
      }
    } catch (e: any) {
      // Never swallowed - a bare catch in a login path hid an outage here once.
      console.error('[hei/login second_factor]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Verification is temporarily unavailable. Please try again.';
    }
  } else if (action === 'cancel_face' || action === 'cancel_second_step') {
    await dropPendingChallenge(pendingToken).catch(() => {});
    clearPendingCookies(Astro.cookies);
    return Astro.redirect('/hei/login');
  } else {
    const identifier = (fd2.get('email') as string || '').trim();
    const password = fd2.get('password') as string || '';

    if (!identifier || !password) {
      errorMsg = 'Enter your email or internal handle, and your password.';
    } else if (await passwordAttemptsBlocked(identifier, CLIENT_IP)) {
      // Failures only are counted, the count is cleared the moment the right password arrives, and
      // nothing durable is written to the account — so a person typing their own password never sees
      // this. Without it, the only cost of a guess was one scrypt.
      errorMsg = PASSWORD_THROTTLED_MESSAGE;
    } else {
      try {
        const user = await findUserByLoginIdentifier(identifier);
        // scrypt runs whether or not the account exists, so an unknown handle
        // and a wrong password cost the same and answer the same.
        const ok = await verifyPasswordForLogin(user, password);
        if (!ok || !user || !user.isActive) {
          await recordFailedPassword(identifier, CLIENT_IP);
          errorMsg = 'Invalid email or password.';
        } else if (String(user.role) !== 'institution_admin') {
          errorMsg = 'This account does not have institution portal access. Visit /admin/login for admin or /portal/login for applicant.';
        } else {
          await clearPasswordAttempts(identifier, CLIENT_IP);
          const methods = await availableSecondFactors(user.id);
          const optedIn = await isSecondStepRequired(user.id);
          // Pre-existing posture: a face on file meant a face challenge.
          const legacyFaceRule = methods.indexOf('face') >= 0;
          // A remaining recovery code is a completable second step too, so an
          // account whose only enrolled factor was cleared is still challenged
          // instead of being waved through on one factor. False only when nothing
          // is left at all - the one case where challenging would be a lockout.
          if ((optedIn || legacyFaceRule) && await canCompleteSecondStep(user.id)) {
            const t = await startPendingChallenge(user.id, SURFACE, 'password');
            setPendingCookie(Astro.cookies, t);
            return Astro.redirect('/hei/login');
          }
          const token = generateSessionToken();
          const session = await createSession(token, user.id, {
            userAgent: Astro.request.headers.get('user-agent') || undefined,
            ipAddress: Astro.clientAddress,
          });
          setSessionCookie(Astro.cookies, token, session.expiresAt);
          await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, user.id)).catch(() => {});
          clearPendingCookies(Astro.cookies);
          return Astro.redirect('/hei/portal');
        }
      } catch (e: any) {
        console.error('[hei/login password]', e?.cause?.message || e?.message, e?.stack);
        errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
      }
    }
  }
}

if (pendingToken) {
  try {
    const pending = await resolvePendingChallenge(pendingToken, SURFACE);
    if (pending) {
      requireSecondStep = true;
      const u = await db.select({ name: users.name }).from(users).where(eq(users.id, pending.userId)).limit(1);
      pendingUserName = u[0]?.name || '';
      const methods = await availableSecondFactors(pending.userId);
      offerFace = methods.indexOf('face') >= 0;
      offerCode = methods.indexOf('totp') >= 0;
    } else {
      clearPendingCookies(Astro.cookies);
      pendingToken = '';
      if (!errorMsg) noticeMsg = 'That sign-in step expired. Please sign in again.';
    }
  } catch (e: any) {
    console.error('[hei/login pending]', e?.cause?.message || e?.message, e?.stack);
    clearPendingCookies(Astro.cookies);
    pendingToken = '';
    errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
  }
}

// The enrolled descriptor is never sent to the browser; the server compares.
const showCamera = requireSecondStep && offerFace;
const showPasswordForm = !requireSecondStep;
---
<BaseLayout title="Institution Sign-in - EduRankAI HEI" description="Sign in to your institution portal">
  <style>
    .face-card { background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; overflow: hidden; max-width: 420px; margin: 0 auto; }
    .cam-wrap { background: #000; aspect-ratio: 3/4; position: relative; max-height: 380px; }
    .cam-wrap video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .oval-ring { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
    .oval-inner { width: 55%; aspect-ratio: 3/4; border: 2.5px solid rgba(220,80,0,0.7); border-radius: 50%; }
    .cam-status { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; }
    .cam-status span { background: rgba(0,0,0,0.75); color: #fff; font-size: 12px; padding: 4px 14px; border-radius: 100px; }
    .face-btn { width: 100%; border: none; font-size: 15px; font-weight: 700; padding: 14px; min-height: 48px; cursor: pointer; border-radius: 0; }
    .face-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>

  <section class="px-[5vw] py-14 md:py-20 max-w-md mx-auto">

    <div class="mb-7 text-center">
      <p class="eyebrow mb-3">Institution Portal</p>
      <h1 class="font-display text-3xl font-semibold text-ink mb-2">{requireSecondStep ? 'One more step' : 'Sign in'}</h1>
      {showPasswordForm && <p class="text-[0.88rem] text-ink-soft">Don't have an account? <a href="/hei/register" class="text-burn font-semibold hover:underline">Register</a></p>}
      {requireSecondStep && <p class="text-[0.88rem] text-ink-soft">Welcome back, <strong>{pendingUserName}</strong>. Confirm it is you to finish signing in.</p>}
    </div>

    {errorMsg && <div style="background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.2);color:#b91c1c;font-size:0.85rem;padding:11px 14px;border-radius:8px;margin-bottom:18px;">{errorMsg}</div>}
    {noticeMsg && <div style="background:rgba(220,80,0,0.06);border:1px solid rgba(220,80,0,0.2);color:#9a3412;font-size:0.85rem;padding:11px 14px;border-radius:8px;margin-bottom:18px;">{noticeMsg}</div>}

    {showPasswordForm && (
      <form method="POST" class="bg-white border border-ink/10 rounded-2xl p-7 flex flex-col gap-5">
        <div>
          <label class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Official email or internal handle</label>
          <input type="text" name="email" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" required autofocus style="min-height:48px;" class="w-full px-4 py-3 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
        </div>
        <div>
          <label class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Password</label>
          <input type="password" name="password" autocomplete="current-password" required style="min-height:48px;" class="w-full px-4 py-3 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
        </div>
        <button type="submit" style="min-height:48px;" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 px-6 rounded-lg text-[0.95rem]">Sign in</button>
      </form>
    )}

    {showCamera && (
      <div class="face-card">
        <div class="cam-wrap">
          <video id="videoEl" autoplay playsinline muted></video>
          <div class="oval-ring"><div class="oval-inner" id="ovalRing"></div></div>
          <div class="cam-status"><span id="camStatus">Loading face model...</span></div>
        </div>
        <button id="verifyBtn" class="face-btn" disabled style="background:#DC5000;color:#fff;">Preparing camera...</button>
      </div>
    )}

    {showCamera && (
      <form id="faceSuccessForm" method="POST" style="display:none;">
        <input type="hidden" name="action" value="second_factor"/>
        <input type="hidden" name="method" value="face"/>
        <input type="hidden" name="live_descriptor" id="liveDescriptorField" value=""/>
      </form>
    )}

    {requireSecondStep && offerFace && offerCode && (
      <div style="display:flex;align-items:center;gap:10px;color:#9ca3af;font-size:12px;margin:16px 0;">
        <span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>OR<span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>
      </div>
    )}

    {requireSecondStep && (
      <form method="POST" class="bg-white border border-ink/10 rounded-2xl p-7 flex flex-col gap-5" style="margin-top:16px;">
        <input type="hidden" name="action" value="second_factor"/>
        <input type="hidden" name="method" value="totp"/>
        <div>
          <label class="block text-[0.7rem] font-bold uppercase tracking-wider text-ink-soft mb-2">{offerCode ? 'Authenticator code, or a recovery code' : 'Recovery code'}</label>
          <input type="text" name="code" inputmode="text" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="one-time-code" maxlength="16" required style="min-height:48px;text-align:center;letter-spacing:0.18em;font-size:18px;" class="w-full px-4 py-3 border border-ink/15 rounded-lg outline-none focus:border-burn bg-cream-2" />
        </div>
        <button type="submit" style="min-height:48px;" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 px-6 rounded-lg text-[0.95rem]">Verify</button>
        <p class="text-[0.75rem] text-ink-soft text-center">Lost your phone? Use one of the recovery codes you saved. Each one works once.</p>
      </form>
    )}

    {requireSecondStep && (
      <div style="text-align:center;margin-top:16px;">
        <form method="POST" style="display:inline;">
          <input type="hidden" name="action" value="cancel_second_step"/>
          <button type="submit" style="background:transparent;border:none;color:#6b7280;font-size:13px;cursor:pointer;text-decoration:underline;padding:12px;min-height:44px;">Use a different account</button>
        </form>
      </div>
    )}

  </section>

  {showCamera && (
    <script is:inline src="/vendor/face-api/face-api.min.js"></script>
    <script is:inline>
    // The enrolled descriptor is NEVER sent to the browser. This captures a live
    // descriptor and posts it; the comparison and verdict happen server-side.
    (function () {
      var video = document.getElementById('videoEl');
      var verifyBtn = document.getElementById('verifyBtn');
      var statusEl = document.getElementById('camStatus');
      var form = document.getElementById('faceSuccessForm');
      var field = document.getElementById('liveDescriptorField');
      if (!video || !verifyBtn || !form || !field) return;
      var submitted = false;
      var stream = null;

      function setStatus(msg) { if (statusEl) statusEl.textContent = msg; }

      // THE CAMERA IS TURNED OFF EXPLICITLY, ON EVERY EXIT - before the descriptor
      // is posted, and whenever this page is left. Leaving it to the navigation
      // keeps the light on through the POST and the next render, and keeps it on
      // indefinitely for anyone who abandons the face step and types a code
      // instead. Nothing is stored either way; a camera still running after the
      // moment it was granted for is its own trust failure.
      function shutCamera() {
        try {
          if (stream) { stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); }
        } catch (_) {}
        stream = null;
        try { video.pause(); } catch (_) {}
        try { video.srcObject = null; } catch (_) {}
        try { video.removeAttribute('src'); } catch (_) {}
      }
      window.addEventListener('pagehide', shutCamera);

      async function init() {
        setStatus('Loading face model...');
        var MODEL_URL = '/vendor/face-api/models';
        await Promise.all([
          faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
          faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        video.srcObject = stream;
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify my face';
        verifyBtn.onclick = capture;
        setStatus('Position your face in the oval');
      }

      async function capture() {
        if (submitted) return;
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Checking...';
        setStatus('Scanning...');
        try {
          var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
            .withFaceLandmarks(true).withFaceDescriptor();
          if (!det) {
            setStatus('No face detected. Try again in better light.');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Try again';
            return;
          }
          submitted = true;
          field.value = JSON.stringify(Array.prototype.slice.call(det.descriptor));
          // Camera off BEFORE anything is posted. The frame it came from is never
          // drawn to a canvas, never uploaded, and does not outlive this line.
          shutCamera();
          setStatus('Sending for verification...');
          form.submit();
        } catch (e) {
          setStatus('Camera error. Use a code instead.');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Try again';
        }
      }

      init().catch(function () {
        setStatus('Camera unavailable. Use a code instead.');
        verifyBtn.textContent = 'Camera unavailable';
      });
    })();
    </script>
  )}
</BaseLayout>
