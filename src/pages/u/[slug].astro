---
// /u/[slug] — one public profile from the professional directory.
//
// TWO THINGS WERE REMOVED HERE RATHER THAN STYLED. The "Connect" and "Message" buttons had no
// handler, no form and no endpoint: network_connections and network_messages were CREATEd by
// src/lib/network.ts and never read or written by anything in the repository, so both buttons were
// decoration on a feature that did not exist. The "Connections" stat read a column nothing
// increments, so it was a permanent 0 presented as a social fact. A visitor now gets the contact
// routes that actually work — the website and email the person chose to publish.
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProfile } from '@/lib/network';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const res = await getProfile(slug);
// A read failure is NOT a missing profile. Redirecting on both told a visitor "this person is not
// here" when the truth was "we could not look".
const p = res.ok ? res.value : null;
const readFailed = !res.ok;
if (res.ok && p === null) return Astro.redirect('/aquintutor/careerflow/network');
---
<BaseLayout title={(p ? p.displayName : 'Profile') + ' · EduRankAI'} description={p?.tagline || 'EduRankAI profile.'}>

<style>
  body { background: #FAF8F5; }
  .pf-wrap { max-width: 980px; margin: 0 auto; padding: 0 16px 80px; }
  .pf-cover { background: linear-gradient(135deg, #FF4F00 0%, #FF7040 100%); height: 180px; border-radius: 0 0 16px 16px; position: relative; }
  .pf-avatar { width: 130px; height: 130px; border-radius: 50%; background: #fff; border: 6px solid #FAF8F5; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', serif; font-size: 54px; font-weight: 600; color: #FF4F00; position: absolute; bottom: -50px; left: 32px; }
  .pf-meta-line { display: flex; justify-content: space-between; align-items: flex-end; padding: 60px 32px 24px; flex-wrap: wrap; gap: 16px; }
  .pf-name { font-family: 'Cormorant Garamond', serif; font-size: 38px; font-weight: 600; color: #0E0B08; margin: 0; letter-spacing: -0.02em; line-height: 1.1; }
  .pf-name em { font-size: 16px; color: #1A6B35; margin-left: 10px; }
  .pf-tagline { font-size: 16px; color: #2E2520; margin: 6px 0 0; }
  .pf-actions { display: flex; gap: 8px; }
  .pf-btn { background: #FF4F00; color: #fff; padding: 10px 20px; border-radius: 10px; text-decoration: none; font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; border: none; cursor: pointer; }
  .pf-btn-ghost { background: transparent; color: #0E0B08; border: 1px solid rgba(14,11,8,0.15); }

  .pf-info-bar { display: flex; gap: 24px; flex-wrap: wrap; padding: 0 32px 24px; font-family: 'Geist Mono', monospace; font-size: 12px; color: #7A6F68; border-bottom: 1px solid rgba(14,11,8,0.08); }
  .pf-info-bar strong { color: #0E0B08; }
  .pf-info-bar a { color: #FF4F00; text-decoration: none; }

  .pf-grid { display: grid; grid-template-columns: 1fr 320px; gap: 32px; padding: 32px 32px 0; }
  @media (max-width: 800px) { .pf-grid { grid-template-columns: 1fr; padding: 24px 16px 0; } }

  .pf-section { margin-bottom: 28px; }
  .pf-section h2 { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #FF4F00; font-weight: 700; margin: 0 0 12px; }
  .pf-bio { font-size: 15.5px; color: #2E2520; line-height: 1.7; white-space: pre-wrap; }

  .pf-side-panel { background: #fff; border: 1px solid rgba(14,11,8,0.10); border-radius: 14px; padding: 18px; margin-bottom: 14px; }
  .pf-side-panel h3 { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #7A6F68; font-weight: 700; margin: 0 0 10px; }
  .pf-chip-row { display: flex; gap: 4px; flex-wrap: wrap; }
  .pf-chip { background: #F3EFE8; padding: 4px 10px; border-radius: 100px; font-size: 12px; color: #2E2520; }
  .pf-chip-burn { background: #FFF3EE; color: #FF4F00; }
  .pf-stat { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(14,11,8,0.06); font-size: 13px; }
  .pf-stat:last-child { border-bottom: none; }
  .pf-stat-label { color: #7A6F68; }
  .pf-stat-val { font-weight: 700; color: #0E0B08; }
</style>

<main class="pf-wrap">
  {readFailed && (
    <div style="max-width:640px;margin:60px auto;background:#fff;border:1px solid rgba(255,79,0,0.35);border-radius:14px;padding:32px;">
      <h1 style="font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;margin:0 0 10px;">This profile could not be loaded.</h1>
      <p style="font-size:15px;color:#2E2520;line-height:1.7;margin:0;">
        The directory did not answer. That is different from this person not existing — we could not look,
        so we are not going to tell you they are not here.
      </p>
      <p style="font-family:'Geist Mono',monospace;font-size:11px;color:#7A6F68;margin:14px 0 0;">Reason recorded: {res.ok ? '' : res.reason}</p>
    </div>
  )}

  {p && (
  <div>
  <div class="pf-cover">
    <div class="pf-avatar">{p.displayName.charAt(0).toUpperCase() || '?'}</div>
  </div>

  <div class="pf-meta-line">
    <div>
      <h1 class="pf-name">{p.displayName}{p.isVerified && <em>Verified</em>}</h1>
      {p.tagline && <p class="pf-tagline">{p.tagline}</p>}
    </div>
    <div class="pf-actions">
      {/* Real routes only. The former Connect / Message buttons had no handler and no table behind
          them; a contact link that opens the person's own inbox is a thing that works. */}
      {p.contactEmail && <a class="pf-btn" href={'mailto:' + p.contactEmail}>Get in touch</a>}
      {p.websiteUrl && <a class="pf-btn pf-btn-ghost" href={p.websiteUrl} target="_blank" rel="noopener">Visit website</a>}
    </div>
  </div>

  <div class="pf-info-bar">
    <span><strong>{p.kind.charAt(0).toUpperCase() + p.kind.slice(1)}</strong></span>
    {p.location && <span style="display:inline-flex;align-items:center;gap:5px;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{p.location}</span>}
    {p.seniority && <span>{p.seniority}{p.yearsExperience == null ? '' : ' · ' + p.yearsExperience + ' yrs'}</span>}
    {p.websiteUrl && <a href={p.websiteUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>Website</a>}
    {p.contactEmail && <a href={'mailto:' + p.contactEmail} style="display:inline-flex;align-items:center;gap:5px;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>{p.contactEmail}</a>}
  </div>

  <div class="pf-grid">

    <main>
      {p.bio && (
        <div class="pf-section">
          <h2>About</h2>
          <p class="pf-bio">{p.bio}</p>
        </div>
      )}

      {p.skills.length > 0 && (
        <div class="pf-section">
          <h2>Skills</h2>
          <div class="pf-chip-row">
            {p.skills.map((s) => <span class="pf-chip pf-chip-burn">{s}</span>)}
          </div>
        </div>
      )}

      {p.servicesOffered.length > 0 && (
        <div class="pf-section">
          <h2>Services offered</h2>
          <div class="pf-chip-row">
            {p.servicesOffered.map((s) => <span class="pf-chip">{s}</span>)}
          </div>
        </div>
      )}

      {p.openTo.length > 0 && (
        <div class="pf-section">
          <h2>Open to</h2>
          <div class="pf-chip-row">
            {p.openTo.map((s) => <span class="pf-chip">{s}</span>)}
          </div>
        </div>
      )}
    </main>

    <aside>
      <div class="pf-side-panel">
        <h3>Stats</h3>
        {/* Profile views is a real counter: getProfile() increments it on every load. The
            "Connections" row that used to sit here read a column nothing in the codebase ever
            increments, so it was a permanent 0 dressed up as a social signal. */}
        <div class="pf-stat"><span class="pf-stat-label">Profile views</span><span class="pf-stat-val">{p.viewCount}</span></div>
      </div>

      {p.languages.length > 0 && (
        <div class="pf-side-panel">
          <h3>Languages</h3>
          <div class="pf-chip-row">
            {p.languages.map((l) => <span class="pf-chip">{l}</span>)}
          </div>
        </div>
      )}
    </aside>

  </div>
  </div>
  )}
</main>
</BaseLayout>
