---
// /onboarding/submitted — what happens next, in plain words.
//
// EXEMPT FROM THE GATE, deliberately (see GATE_EXEMPT_EXACT in src/lib/talent/gate-pass.ts). An
// onboarding code is single-use and is spent at submit, so bouncing somebody off this screen would
// send them to a gate their code can no longer open — a dead end whose only exit is a support call.
// The page holds no data of its own, so there is nothing here to protect.
import BaseLayout from '@/layouts/BaseLayout.astro';

// Declared before use: `const` is not hoisted.
const state = Astro.url.searchParams.get('state') || 'submitted';
const isApproved = state === 'approved';
const isRejected = state === 'rejected';

const heading = isApproved
  ? 'Your onboarding has been approved'
  : isRejected
    ? 'This onboarding was not approved'
    : 'Your details are with the people desk';

const body = isApproved
  ? 'Your organizational identity has been created and your joining details are confirmed. You will receive your access details separately.'
  : isRejected
    ? 'A written reason was sent to the address on your record. If you believe this is a mistake, reply to that message.'
    : 'We have everything you submitted. The people desk verifies the documents you linked, then confirms your joining. You do not need to do anything else, and you will hear back in writing either way.';
---

<BaseLayout title="Onboarding submitted" description="Your onboarding details have been received." noindex={true}>
  <main class="mx-auto w-full max-w-xl px-5 py-16">
    <svg class="h-8 w-8 text-neutral-900" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
      <path d="M22 4L12 14.01l-3-3" />
    </svg>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-neutral-900">{heading}</h1>
    <p class="mt-3 text-base leading-relaxed text-neutral-600">{body}</p>

    <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5">
      <h2 class="text-sm font-semibold text-neutral-900">Your onboarding code</h2>
      <p class="mt-1 text-sm leading-relaxed text-neutral-600">
        It has now been used and cannot be used again. That is expected. If you are asked to change
        something, the people desk will send you a fresh one.
      </p>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>
