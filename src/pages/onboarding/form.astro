---
// /onboarding/form — THE STANDARD ONBOARDING FORM.
//
// Resolved from the ONBOARDING SESSION (a server-side, revocable session in
// tal_onboarding_application), not from the gate pass and never from anything in the URL.
//
// THREE THINGS THIS PAGE IS CAREFUL ABOUT
//  1. It has three distinct states and none of them look alike: a live session renders the form; an
//     ended or expired session renders an explanation with a way forward; a failed read renders the
//     reason. A blank page or a bare 500 is the defect this project has paid for before.
//  2. The organisation-controlled block renders READ-ONLY and is not posted back. The server strips
//     those keys anyway (stripOrgControlled) — the read-only rendering is the courtesy, the strip is
//     the control.
//  3. Documents are Google Drive LINKS. This platform accepts no document uploads of any kind.
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  resolveSession, prefillFor, listDocuments, requiredFormFields, identityTypeFromEmployment,
  DECLARATIONS, ONBOARDING_COOKIE, DOC_TYPES, ACCESS_FORMAT, MAX_DOCS,
} from '@/lib/talent/onboarding';

// Declared before use: `const` is not hoisted.
const sessionSecret = Astro.cookies.get(ONBOARDING_COOKIE)?.value ?? null;
const app = await resolveSession(sessionSecret);

if (!app) {
  return Astro.redirect('/onboarding/expired');
}
if (app.status !== 'in_progress' && app.status !== 'changes_requested') {
  return Astro.redirect('/onboarding/submitted?state=' + encodeURIComponent(app.status));
}

const prefill = await prefillFor(app);
const documents = await listDocuments(app.id);
const identityType = identityTypeFromEmployment(prefill.org.employmentType);
const fields = requiredFormFields(identityType);
const saved = app.formData || {};

// A NAMED FUNCTION RATHER THAN AN INLINE `as`. `kind` carries 'textarea' and 'select' too, and
// handing that union to an <input type> is a type error the compiler is right about. The obvious fix
// — an `as` assertion inside the map below — does not survive this project's build: esbuild parses
// .astro frontmatter and rejects `as` in that position with "Expected ) but found as". A function
// with a declared return type narrows it with no assertion at all.
//
// Declared BEFORE the map that calls it: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
type InputKind = 'text' | 'email' | 'tel' | 'date';
function inputTypeFor(kind: string): InputKind {
  if (kind === 'email' || kind === 'tel' || kind === 'date') return kind;
  return 'text';
}

// Sections in declaration order, with their fields resolved in frontmatter. Doing this here rather
// than in JSX keeps every comparison out of the template — no < or <= may appear inside a JSX
// expression on this project.
const sections = [
  { key: 'personal', label: 'Personal information' },
  { key: 'identity', label: 'Identity information' },
  { key: 'academic', label: 'Academic information' },
  { key: 'professional', label: 'Professional information' },
].map((s) => ({
  key: s.key,
  label: s.label,
  fields: fields.filter((f) => f.section === s.key).map((f) => ({
    ...f,
    value: String(saved[f.key] ?? prefill.person[f.key] ?? ''),
    // Narrowed HERE rather than in the template. `kind` carries 'textarea' and 'select' too, and
    // handing that union straight to an <input type> is a type error — the compiler is right, since
    // type="textarea" is not a thing. The textarea branch is chosen separately below.
    inputType: inputTypeFor(f.kind),
  })),
})).filter((s) => s.fields.length > 0);

const docCount = documents.length;
const docsRemaining = MAX_DOCS - docCount;
const atDocLimit = docsRemaining < 1;
const hasChangesRequested = app.status === 'changes_requested';
const orgRows = [
  { label: 'Position', value: String(prefill.org.position || 'Not recorded') },
  { label: 'Engagement', value: String(prefill.org.employmentType || 'Not recorded') },
  { label: 'Level', value: String(prefill.org.level || 'Not recorded') },
  { label: 'Proposed joining date', value: String(prefill.org.joiningDate || 'To be confirmed') },
  { label: 'Compensation note', value: String(prefill.org.compensation || 'As recorded on your engagement') },
];
---

<BaseLayout title="Onboarding" description="Complete your onboarding with EduRankAI." noindex={true}>
  <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:py-16">

    <p class="text-xs uppercase tracking-[0.18em] text-neutral-500">Onboarding {app.onboardingCodeRef}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">Your joining details</h1>
    <p class="mt-3 text-base leading-relaxed text-neutral-600">
      Your selection is confirmed, so there is no application to fill in. This form collects what the
      people desk needs to complete your joining. Your answers save as you go.
    </p>

    {hasChangesRequested && (
      <div class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-4">
        <p class="text-sm font-medium text-amber-900">Changes were requested</p>
        <p class="mt-1 text-sm leading-relaxed text-amber-800">{app.reviewNote}</p>
      </div>
    )}

    <div id="ob-error" class="mt-6 hidden rounded-lg border border-rose-300 bg-rose-50 p-4">
      <p class="text-sm font-medium text-rose-900">Some answers still need attention</p>
      <ul id="ob-error-list" class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-800"></ul>
    </div>
    <div id="ob-ok" class="mt-6 hidden rounded-lg border border-emerald-300 bg-emerald-50 p-4">
      <p id="ob-ok-text" class="text-sm font-medium text-emerald-900"></p>
    </div>

    <!-- ORGANISATION-CONTROLLED. Read-only, and stripped server-side if posted anyway. -->
    <section class="mt-8 rounded-xl border border-neutral-300 bg-neutral-50 p-5 sm:p-6">
      <h2 class="text-base font-semibold text-neutral-900">Your position at EduRankAI</h2>
      <p class="mt-1 text-sm text-neutral-600">
        Set by the people desk from your selection. If anything here is wrong, reply to your selection
        message rather than working around it.
      </p>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
        {orgRows.map((row) => (
          <div>
            <dt class="text-xs uppercase tracking-wide text-neutral-500">{row.label}</dt>
            <dd class="mt-0.5 text-sm text-neutral-900">{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <form id="ob-form" class="mt-8 space-y-8" novalidate>
      {sections.map((section) => (
        <section class="rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
          <h2 class="text-base font-semibold text-neutral-900">{section.label}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {section.fields.map((f) => (
              <div class={f.kind === 'textarea' ? 'sm:col-span-2' : ''}>
                <label for={'f-' + f.key} class="block text-sm font-medium text-neutral-800">
                  {f.label}{f.required ? ' *' : ''}
                </label>
                {f.kind === 'textarea' ? (
                  <textarea id={'f-' + f.key} name={f.key} rows="3"
                    class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
                  >{f.value}</textarea>
                ) : (
                  <input id={'f-' + f.key} name={f.key} type={f.inputType} value={f.value}
                    class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
                  />
                )}
                {f.hint && <p class="mt-1 text-xs text-neutral-500">{f.hint}</p>}
              </div>
            ))}
          </div>
        </section>
      ))}

      <!-- DOCUMENTS — links only. -->
      <section class="rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
        <h2 class="text-base font-semibold text-neutral-900">Documents</h2>
        <p class="mt-1 text-sm leading-relaxed text-neutral-600">
          Share each document from Google Drive with access set to "{ACCESS_FORMAT}" and paste the
          link. Nothing is uploaded to us and no file leaves your Drive. You can link up to {MAX_DOCS}.
        </p>

        <ul class="mt-4 space-y-2">
          {documents.map((d) => (
            <li class="flex items-start justify-between gap-3 rounded-lg border border-neutral-200 px-3 py-2.5">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-neutral-900">{d.title || d.docType}</p>
                <p class="truncate text-xs text-neutral-500">{d.driveUrl}</p>
              </div>
              <button type="button" data-remove-doc={d.id}
                class="flex-none rounded-md border border-neutral-300 px-2.5 py-1 text-xs text-neutral-700 transition hover:bg-neutral-50">
                Remove
              </button>
            </li>
          ))}
        </ul>

        {docCount === 0 && (
          <p class="mt-4 rounded-lg border border-dashed border-neutral-300 px-3 py-4 text-sm text-neutral-500">
            No documents linked yet. At least one is needed before you can submit.
          </p>
        )}

        <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,10rem)_minmax(0,1fr)_auto]">
          <select id="doc-type" disabled={atDocLimit}
            class="rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 disabled:opacity-50">
            {DOC_TYPES.map((t) => <option value={t.key}>{t.label}</option>)}
          </select>
          <input id="doc-url" type="url" placeholder="https://drive.google.com/..." disabled={atDocLimit}
            class="rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 disabled:opacity-50" />
          <button type="button" id="doc-add" disabled={atDocLimit}
            class="rounded-lg border border-neutral-900 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50 disabled:cursor-not-allowed disabled:opacity-50">
            Link document
          </button>
        </div>
        {atDocLimit && <p class="mt-2 text-xs text-neutral-500">You have linked the maximum of {MAX_DOCS} documents.</p>}
      </section>

      <!-- DECLARATIONS -->
      <section class="rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
        <h2 class="text-base font-semibold text-neutral-900">Declarations</h2>
        <div class="mt-4 space-y-3">
          {DECLARATIONS.map((d) => (
            <label class="flex items-start gap-3">
              <input type="checkbox" data-declaration={d.key}
                checked={app.declarations[d.key] === true}
                class="mt-0.5 h-4 w-4 flex-none rounded border-neutral-400 text-neutral-900 focus:ring-neutral-900" />
              <span class="text-sm leading-relaxed text-neutral-700">
                {d.label}{d.required ? ' *' : ''}
              </span>
            </label>
          ))}
        </div>
      </section>

      <div class="flex flex-wrap gap-3">
        <button type="button" id="ob-save"
          class="rounded-lg border border-neutral-900 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50">
          Save and continue later
        </button>
        <button type="submit" id="ob-submit"
          class="rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800">
          Submit for review
        </button>
      </div>
    </form>

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>

<script is:inline>
  // is:inline, matching how the gate screen's script is treated (define:vars implies the same
  // thing). These handlers are plain DOM glue against elements this page just rendered; running
  // them through the bundler's typechecker produces forty "possibly null" complaints about ids that
  // are guaranteed to exist three lines above, and this project's typecheck ratchet fails on new
  // errors. Nothing here imports, so there is nothing for the bundler to resolve either.
  //
  // Top level and outside every conditional: a script inside a JSX conditional breaks the Astro
  // parser on this project.
  const form = document.getElementById('ob-form');
  const errBox = document.getElementById('ob-error');
  const errList = document.getElementById('ob-error-list');
  const okBox = document.getElementById('ob-ok');
  const okText = document.getElementById('ob-ok-text');

  function showProblems(list) {
    okBox.classList.add('hidden');
    errList.innerHTML = '';
    (list && list.length ? list : ['Something went wrong. Please try again.']).forEach(function (msg) {
      const li = document.createElement('li');
      li.textContent = msg;
      errList.appendChild(li);
    });
    errBox.classList.remove('hidden');
    errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function showOk(msg) {
    errBox.classList.add('hidden');
    okText.textContent = msg;
    okBox.classList.remove('hidden');
  }

  function collect() {
    const data = {};
    form.querySelectorAll('input[name], textarea[name]').forEach(function (el) {
      data[el.name] = el.value;
    });
    const declarations = {};
    document.querySelectorAll('[data-declaration]').forEach(function (el) {
      declarations[el.getAttribute('data-declaration')] = el.checked;
    });
    return { form: data, declarations: declarations };
  }

  async function post(payload) {
    const res = await fetch('/api/talent/onboarding', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    let data = {};
    try { data = await res.json(); } catch (_) { data = {}; }
    return { res: res, data: data };
  }

  document.getElementById('ob-save').addEventListener('click', async function () {
    const payload = collect();
    const out = await post({ action: 'save-draft', form: payload.form, declarations: payload.declarations });
    if (out.data.ok) { showOk('Saved. You can close this and come back with the same link.'); }
    else { showProblems([out.data.error]); }
  });

  document.getElementById('doc-add').addEventListener('click', async function () {
    const docType = document.getElementById('doc-type').value;
    const driveUrl = document.getElementById('doc-url').value.trim();
    const out = await post({ action: 'add-document', docType: docType, driveUrl: driveUrl, title: '' });
    if (out.data.ok) { window.location.reload(); }
    else { showProblems([out.data.error]); }
  });

  document.querySelectorAll('[data-remove-doc]').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const out = await post({ action: 'remove-document', documentId: btn.getAttribute('data-remove-doc') });
      if (out.data.ok) { window.location.reload(); }
      else { showProblems([out.data.error]); }
    });
  });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const payload = collect();
    const btn = document.getElementById('ob-submit');
    btn.disabled = true;
    btn.textContent = 'Submitting...';
    const out = await post({ action: 'submit', form: payload.form, declarations: payload.declarations });
    btn.disabled = false;
    btn.textContent = 'Submit for review';
    if (out.data.ok) { window.location.href = '/onboarding/submitted'; return; }
    // The server returns EVERY problem at once, so the list is shown whole rather than one per trip.
    showProblems(out.data.problems && out.data.problems.length ? out.data.problems : [out.data.error]);
  });
</script>
