---
// /onboarding/expired — the honest end of an onboarding session.
//
// Reached when the server-side session in tal_onboarding_application has passed session_expires_at,
// or has been ended deliberately because the selection behind it was withdrawn. Those two are NOT
// distinguished here on purpose: the page cannot tell them apart without disclosing a decision the
// people desk may not have communicated yet, and the action is the same either way.
//
// NOTHING IS LOST. Saved answers are in form_data and the code has not been consumed unless the form
// was actually submitted, so re-entering the code at the gate resumes exactly where they left off.
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Onboarding session ended" description="Your onboarding session has ended." noindex={true}>
  <main class="mx-auto w-full max-w-xl px-5 py-16">
    <svg class="h-8 w-8 text-neutral-700" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </svg>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-neutral-900">Your onboarding session has ended</h1>
    <p class="mt-3 text-base leading-relaxed text-neutral-600">
      Sessions close after a period of inactivity. Anything you had already saved is kept.
    </p>
    <p class="mt-3 text-base leading-relaxed text-neutral-600">
      Enter your onboarding code again to carry on from where you stopped. If it no longer works,
      reply to the message you received from EduRankAI and the people desk will issue a new one.
    </p>
    <a href="/apply/gateway"
       class="mt-6 inline-block rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800">
      Enter your code
    </a>
  </main>
</BaseLayout>
