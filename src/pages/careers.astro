  <!--
    ================================ is:global, AND IT HAS TO BE ================================

    THIS PAGE HAD NO UI BELOW THE SEARCH BOX, AND THIS ONE WORD IS WHY.

    An Astro <style> block is SCOPED: every selector is rewritten to `.ci-card[data-astro-cid-xxx]`
    and that attribute is stamped onto the elements in THIS TEMPLATE at build time. Everything below
    the search box is built at runtime by public/career-intel.js — the understanding panel, the
    conversation, the count line, the result cards, the career map — so none of it carries the
    attribute, and not one rule below ever matched any of it.

    The result was not a slightly plain page. Tailwind's preflight strips button chrome and borders,
    so the entire intelligence surface rendered as unstyled paragraphs of serif text with "Read the
    full posting" and "Not for me" run together into one word.

    Scoping is the wrong tool for a stylesheet whose elements are created by a script. Every selector
    in here is prefixed `.ci-`, this block ships only on /careers, and those classes exist nowhere
    else in the site — so global is both correct and contained.
  -->
  <style is:global>
    /* ------------------------------------------------------------ the gone notice */
    .ci-gone { display:flex; align-items:flex-start; gap:0.5rem; font-size:0.86rem; line-height:1.55; color:#8a5a00; background:#FBF3E2; border:1px solid #EDD96A; border-radius:12px; padding:0.7rem 0.9rem; margin:0 0 1rem; }
    .ci-gone svg { flex-shrink:0; margin-top:0.15rem; }

    /* ---------------------------------------------------------------- the input */
    .ci-form { margin: 0 0 1.35rem; }
    .ci-label { display:block; font-size:0.74rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#8a8078; margin-bottom:0.5rem; }
    .ci-input-wrap { display:flex; align-items:center; gap:0.65rem; background:#fff; border:1.5px solid rgba(14,11,8,0.12); border-radius:16px; padding:0.55rem 0.55rem 0.55rem 1rem; box-shadow:0 2px 14px rgba(14,11,8,0.04); transition:border-color .18s ease, box-shadow .18s ease; }
    .ci-input-wrap:focus-within { border-color:#FF4F00; box-shadow:0 4px 22px rgba(255,79,0,0.10); }
    .ci-input-icon { color:rgba(122,111,104,0.6); flex-shrink:0; }
    .ci-input { flex:1; min-width:0; border:0; outline:none; background:transparent; font:inherit; font-size:1rem; color:#0E0B08; padding:0.55rem 0; }
    .ci-input::placeholder { color:rgba(122,111,104,0.62); }
    .ci-go { display:inline-flex; align-items:center; gap:0.45rem; flex-shrink:0; background:#FF4F00; color:#fff; border:0; border-radius:12px; padding:0.7rem 1.1rem; font:inherit; font-size:0.9rem; font-weight:650; cursor:pointer; transition:background .18s ease, transform .18s ease; }
    .ci-go:hover { background:#e64700; }
    .ci-go:disabled { opacity:0.55; cursor:progress; }
    .ci-go:focus-visible, .ci-chip:focus-visible, .ci-btn:focus-visible, .ci-opt:focus-visible, .ci-team:focus-visible { outline:3px solid #1045BB; outline-offset:2px; }

    /* Rotating examples. CSS only, and stationary under reduced motion. */
    .ci-examples { position:relative; height:1.3rem; margin:0.6rem 0 0; overflow:hidden; }
    .ci-example { position:absolute; inset:0; font-size:0.85rem; color:rgba(122,111,104,0.85); font-style:italic; opacity:0; animation:ci-cycle 20s linear infinite; }
    @keyframes ci-cycle { 0%,2% { opacity:0; } 4%,18% { opacity:1; } 20%,100% { opacity:0; } }
    .ci-help { font-size:0.84rem; color:#7A6F68; margin:0.55rem 0 0; line-height:1.6; }
    .ci-help a { color:#1045BB; font-weight:600; }

    /* ------------------------------------------------------------- pathway chips */
    .ci-pathways { margin-bottom:1.4rem; }
    .ci-pathways-label { font-size:0.82rem; color:#7A6F68; margin:0 0 0.7rem; }
    .ci-chips { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:0.55rem; }
    .ci-chip { display:flex; flex-direction:column; gap:0.15rem; padding:0.75rem 0.9rem; background:#fff; border:1px solid rgba(14,11,8,0.10); border-radius:14px; text-decoration:none; color:inherit; transition:border-color .18s ease, transform .18s ease; min-height:44px; }
    .ci-chip:hover { border-color:#FFD4BC; transform:translateY(-2px); }
    .ci-chip-open { background:#F3EFE8; }
    .ci-chip-label { font-weight:650; font-size:0.9rem; color:#0E0B08; }
    .ci-chip-blurb { font-size:0.76rem; color:#7A6F68; line-height:1.45; }

    /* ------------------------------------------------------------------ status */
    .ci-status { font-size:0.85rem; color:#7A6F68; margin:0 0 0.8rem; min-height:1.2rem; }
    .ci-status.is-warn { color:#9a3412; font-weight:600; }
    .ci-status.is-ok { color:#15803d; font-weight:600; }

    /* ------------------------------------------------------------ the conversation */
    .ci-thread { display:flex; flex-direction:column; gap:0.8rem; margin-bottom:1rem; }
    .ci-card { background:#fff; border:1px solid rgba(14,11,8,0.10); border-radius:16px; padding:1.1rem 1.15rem; }
    .ci-understood { border-left:4px solid #1045BB; }
    .ci-offer { border-left:4px solid #C49A00; background:#FFFBEA; }
    .ci-eyebrow { font-size:0.7rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#8a8078; margin:0 0 0.55rem; }
    .ci-list { margin:0 0 0.85rem; padding-left:1.15rem; display:flex; flex-direction:column; gap:0.3rem; }
    .ci-list li { font-size:0.9rem; color:#2E2520; line-height:1.55; }
    .ci-offer-text { font-size:0.9rem; color:#2E2520; line-height:1.6; margin:0 0 0.85rem; }

    .ci-q-head { display:flex; align-items:baseline; gap:0.6rem; flex-wrap:wrap; }
    .ci-q-prompt { font-family:"Cormorant Garamond",serif; font-size:1.2rem; font-weight:600; color:#0E0B08; margin:0 0 0.2rem; line-height:1.3; }
    .ci-q-why { font-size:0.8rem; color:#7A6F68; margin:0 0 0.85rem; font-style:italic; }
    .ci-chip-quiet { font-size:0.66rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#8a5a00; background:#FBF3E2; border:1px solid #EDD96A; border-radius:99px; padding:0.1rem 0.5rem; }
    .ci-options { display:flex; flex-wrap:wrap; gap:0.45rem; margin-bottom:0.75rem; }
    .ci-opt { font:inherit; font-size:0.86rem; padding:0.5rem 0.85rem; min-height:44px; border-radius:99px; border:1px solid rgba(14,11,8,0.14); background:#FAF8F5; color:#2E2520; cursor:pointer; transition:background .16s ease, border-color .16s ease, color .16s ease; }
    .ci-opt:hover { border-color:#FFD4BC; }
    .ci-opt.is-on { background:#FF4F00; border-color:#FF4F00; color:#fff; font-weight:600; }
    .ci-q-text { width:100%; border:1px solid rgba(14,11,8,0.12); border-radius:12px; padding:0.6rem 0.75rem; font:inherit; font-size:0.9rem; resize:vertical; background:#FAF8F5; }
    .ci-q-text:focus { outline:none; border-color:#FF4F00; }

    .ci-actions { display:flex; flex-wrap:wrap; gap:0.45rem; margin-top:0.75rem; }
    .ci-btn { display:inline-flex; align-items:center; justify-content:center; gap:0.35rem; font:inherit; font-size:0.85rem; font-weight:600; padding:0.55rem 0.95rem; min-height:44px; border-radius:11px; border:1px solid rgba(14,11,8,0.14); background:#fff; color:#2E2520; cursor:pointer; text-decoration:none; transition:border-color .16s ease, background .16s ease; }
    .ci-btn:hover { border-color:#FFD4BC; background:#FFF3EE; }
    .ci-btn-primary { background:#FF4F00; border-color:#FF4F00; color:#fff; }
    .ci-btn-primary:hover { background:#e64700; border-color:#e64700; color:#fff; }
    .ci-btn-quiet { background:transparent; border-color:transparent; color:#7A6F68; text-decoration:underline; text-underline-offset:3px; }
    .ci-btn-quiet:hover { background:transparent; color:#0E0B08; border-color:transparent; }
    .ci-btn-danger { border-color:#FFD4BC; color:#9a3412; background:#FFF3EE; margin-top:0.9rem; }

    /* ------------------------------------------------------------------ the panel */
    .ci-panel-wrap { margin-bottom:1.1rem; }
    .ci-panel-toggle { display:inline-flex; align-items:center; gap:0.4rem; font:inherit; font-size:0.82rem; font-weight:600; color:#1045BB; background:transparent; border:0; padding:0.35rem 0; cursor:pointer; }
    .ci-panel { margin-top:0.7rem; background:#F3EFE8; border:1px solid rgba(14,11,8,0.10); border-radius:16px; padding:1.05rem 1.1rem; }
    .ci-panel-intro { font-size:0.82rem; color:#2E2520; line-height:1.6; margin:0 0 0.9rem; }
    .ci-panel-h { font-size:0.7rem; font-weight:700; letter-spacing:0.09em; text-transform:uppercase; color:#8a8078; margin:0.9rem 0 0.4rem; }
    .ci-panel-note { font-size:0.78rem; color:#7A6F68; line-height:1.55; margin:0 0 0.5rem; }
    .ci-panel-line { font-size:0.86rem; color:#2E2520; margin:0 0 0.35rem; line-height:1.5; }
    .ci-panel-quote { display:flex; align-items:flex-start; gap:0.5rem; font-size:0.84rem; color:#2E2520; background:#fff; border:1px solid rgba(14,11,8,0.08); border-radius:10px; padding:0.5rem 0.6rem; margin-bottom:0.35rem; line-height:1.5; }
    .ci-tags { display:flex; flex-wrap:wrap; gap:0.35rem; }
    .ci-tag { display:inline-flex; align-items:center; gap:0.3rem; font-size:0.8rem; background:#fff; border:1px solid rgba(14,11,8,0.12); border-radius:99px; padding:0.25rem 0.35rem 0.25rem 0.7rem; color:#2E2520; }
    .ci-tag-x { font:inherit; font-size:0.95rem; line-height:1; background:transparent; border:0; color:#7A6F68; cursor:pointer; padding:0.35rem; min-width:32px; min-height:32px; border-radius:8px; }
    .ci-tag-x:hover { color:#9a3412; background:rgba(255,79,0,0.08); }
    .ci-dim { display:flex; align-items:center; justify-content:space-between; gap:0.6rem; font-size:0.84rem; color:#2E2520; padding:0.3rem 0; border-bottom:1px solid rgba(14,11,8,0.06); }
    .ci-dim.is-confirmed .ci-dim-label { font-weight:650; }
    .ci-dim-actions { display:flex; gap:0.1rem; flex-shrink:0; }
    .ci-personal { margin-top:1.1rem; border-top:1px solid rgba(14,11,8,0.10); padding-top:0.8rem; }
    .ci-personal summary { font-size:0.84rem; font-weight:600; color:#6B1FBE; cursor:pointer; padding:0.35rem 0; }
    .ci-personal-form { margin-top:0.6rem; }
    .ci-fieldset { border:0; padding:0; margin:0 0 0.95rem; min-width:0; }
    .ci-legend { display:block; font-size:0.78rem; font-weight:650; color:#2E2520; padding:0; margin:0 0 0.45rem; }
    .ci-choices { display:flex; flex-wrap:wrap; gap:0.4rem; }
    .ci-choice { display:inline-flex; align-items:center; gap:0.4rem; font-size:0.82rem; line-height:1.3; color:#2E2520; background:#fff; border:1px solid rgba(14,11,8,0.12); border-radius:99px; padding:0.4rem 0.85rem; min-height:40px; cursor:pointer; }
    .ci-choice:hover { border-color:#FFD4BC; }
    .ci-choice:focus-within { border-color:#1045BB; }
    .ci-choice input { accent-color:#FF4F00; width:16px; height:16px; flex-shrink:0; margin:0; }
    .ci-measures { display:flex; flex-wrap:wrap; gap:0.75rem; }
    .ci-measure { display:inline-flex; align-items:center; gap:0.4rem; }
    .ci-measure label { font-size:0.8rem; color:#7A6F68; }
    .ci-measure input { font:inherit; font-size:0.85rem; width:7.5rem; padding:0.5rem 0.6rem; min-height:44px; border:1px solid rgba(14,11,8,0.14); border-radius:10px; background:#fff; }
    .ci-measure input:focus { outline:none; border-color:#FF4F00; }
    .ci-personal-line { display:flex; flex-wrap:wrap; gap:0.35rem; font-size:0.84rem; color:#2E2520; margin:0 0 0.25rem; line-height:1.5; }
    .ci-personal-line strong { font-weight:650; color:#0E0B08; }

    /* ---------------------------------------------------------------- career map */
    .ci-map { margin:1.1rem 0; background:#fff; border:1px solid rgba(14,11,8,0.10); border-radius:16px; padding:1.05rem 1.1rem; }
    .ci-map-title { font-family:"Cormorant Garamond",serif; font-size:1.25rem; font-weight:650; color:#0E0B08; margin:0 0 0.2rem; }
    .ci-map-caption { font-size:0.82rem; color:#7A6F68; margin:0 0 0.9rem; line-height:1.55; }
    .ci-map-band { margin-bottom:0.9rem; }
    .ci-map-band-h { font-size:0.7rem; font-weight:700; letter-spacing:0.09em; text-transform:uppercase; color:#8a8078; margin:0 0 0.15rem; }
    .ci-map-band-note { font-size:0.76rem; color:#7A6F68; margin:0 0 0.45rem; line-height:1.5; }
    .ci-map-nodes { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:0.45rem; }
    .ci-map-node { display:flex; flex-direction:column; gap:0.1rem; align-items:flex-start; text-align:left; font:inherit; cursor:pointer; background:#FAF8F5; border:1px solid rgba(14,11,8,0.12); border-radius:13px; padding:0.6rem 0.8rem; min-height:44px; color:inherit; text-decoration:none; transition:border-color .16s ease; }
    .ci-map-node:hover { border-color:#FFD4BC; }
    .ci-map-node.is-on { border-color:#FF4F00; background:#FFF3EE; }
    .ci-map-node[data-band="strong"] { border-left:4px solid #128a3f; }
    .ci-map-node[data-band="emerging"] { border-left:4px solid #C49A00; }
    .ci-map-node[data-band="adjacent"] { border-left:4px solid #6B1FBE; }
    .ci-map-node-label { font-size:0.88rem; font-weight:650; }
    .ci-map-node-why { font-size:0.74rem; color:#7A6F68; line-height:1.45; }
    .ci-map-clear { margin-top:0.3rem; }

    /* ------------------------------------------------------------------ results */
    .ci-results:focus { outline:none; }
    .ci-results-head { margin:1.2rem 0 0.5rem; }
    .ci-count { font-size:0.95rem; color:#2E2520; margin:0; }
    .ci-count strong { color:#0E0B08; font-weight:700; }
    .ci-note { font-size:0.84rem; line-height:1.6; border-radius:12px; padding:0.65rem 0.85rem; margin:0.4rem 0; }
    .ci-note-quiet { color:#7A6F68; background:#F3EFE8; }
    .ci-note-warn { color:#9a3412; background:#FFF3EE; border:1px solid #FFD4BC; }
    .ci-note a { color:inherit; font-weight:600; }
    .ci-group { margin-top:1.6rem; }
    .ci-group-title { font-family:"Cormorant Garamond",serif; font-size:1.35rem; font-weight:600; color:#0E0B08; margin:0 0 0.15rem; }
    .ci-group-meaning { font-size:0.82rem; color:#7A6F68; margin:0 0 0.85rem; }
    /* align-items:start — a grid row is as tall as its tallest item by default, so opening one
       card's "Why this opportunity?" stretched every card beside it and left them half empty. Each
       card is now its own height. */
    .ci-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr)); gap:0.7rem; align-items:start; }
    .ci-role { display:flex; flex-direction:column; gap:0.35rem; background:#fff; border:1px solid rgba(14,11,8,0.10); border-left:4px solid rgba(14,11,8,0.10); border-radius:16px; padding:1rem 1.05rem; min-width:0; }
    .ci-role-strong { border-left-color:#128a3f; }
    .ci-role-potential { border-left-color:#1045BB; }
    .ci-role-adjacent { border-left-color:#C49A00; }
    .ci-role-explore { border-left-color:rgba(14,11,8,0.15); }
    .ci-role.is-dismissed { opacity:0.4; }
    .ci-role-title { font-family:"Cormorant Garamond",serif; font-size:1.12rem; font-weight:650; color:#0E0B08; text-decoration:none; line-height:1.3; }
    .ci-role-title:hover { color:#FF4F00; }
    .ci-role-meta { font-size:0.74rem; color:#7A6F68; margin:0; }
    .ci-role-fn { font-size:0.83rem; color:#2E2520; line-height:1.55; margin:0.15rem 0 0; }
    .ci-role-why { font-size:0.82rem; color:#15803d; background:#EBF5EF; border-radius:9px; padding:0.45rem 0.6rem; margin:0.35rem 0 0; line-height:1.5; }
    .ci-why { margin-top:0.4rem; }
    .ci-why summary { font-size:0.8rem; font-weight:600; color:#1045BB; cursor:pointer; padding:0.35rem 0; }
    .ci-why-h { font-size:0.68rem; font-weight:700; letter-spacing:0.09em; text-transform:uppercase; color:#8a8078; margin:0.6rem 0 0.3rem; }
    .ci-why-signal { font-weight:650; color:#0E0B08; }
    .ci-why-note { font-size:0.8rem; color:#7A6F68; line-height:1.55; margin:0 0 0.3rem; }
    .ci-why-caveat { font-style:italic; }
    .ci-why-none { font-size:0.8rem; color:#7A6F68; line-height:1.55; }
    .ci-role-actions { display:flex; flex-wrap:wrap; gap:0.4rem; margin-top:0.6rem; }
    .ci-more { margin-top:1.1rem; }

    /* -------------------------------------------------------------------- teams */
    .ci-teams { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,210px),1fr)); gap:0.5rem; }
    .ci-team { display:flex; align-items:center; justify-content:space-between; gap:0.6rem; background:#fff; border:1px solid rgba(14,11,8,0.10); border-radius:13px; padding:0.7rem 0.9rem; min-height:44px; text-decoration:none; color:inherit; transition:border-color .16s ease, transform .16s ease; }
    .ci-team:hover { border-color:#FFD4BC; transform:translateY(-2px); }
    .ci-team-name { font-size:0.86rem; font-weight:600; color:#2E2520; min-width:0; overflow-wrap:anywhere; }
    .ci-team-count { font-family:ui-monospace,monospace; font-size:0.72rem; color:#FF4F00; background:#FFF3EE; border:1px solid #FFD4BC; border-radius:99px; padding:0.1rem 0.55rem; flex-shrink:0; }
    .ci-link-btn { display:inline-flex; align-items:center; font-size:0.79rem; font-weight:600; color:#2E2520; background:#F3EFE8; border:1px solid rgba(14,11,8,0.12); border-radius:11px; padding:0.5rem 0.85rem; min-height:44px; text-decoration:none; transition:border-color .16s ease; }
    .ci-link-btn:hover { border-color:rgba(14,11,8,0.28); }

    /* ---------------------------------------------------------------- how it works */
    .ci-how { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr)); gap:0.7rem; }
    .ci-how-card { background:#fff; border:1px solid rgba(14,11,8,0.10); border-radius:16px; padding:1rem 1.05rem; }
    .ci-how-card h3 { font-family:"Cormorant Garamond",serif; font-size:1.06rem; font-weight:650; color:#0E0B08; margin:0 0 0.35rem; }
    .ci-how-card p { font-size:0.83rem; color:#7A6F68; line-height:1.6; margin:0; }

    /* ------------------------------------------------------------------- motion */
    @media (prefers-reduced-motion: reduce) {
      .ci-example { animation:none; opacity:0; }
      .ci-example:first-child { opacity:1; }
      .ci-chip, .ci-team, .ci-btn, .ci-opt, .ci-go { transition:none; }
      .ci-chip:hover, .ci-team:hover { transform:none; }
    }
    @media (max-width: 640px) {
      .ci-go-label { display:none; }
      .ci-go { padding:0.75rem 0.85rem; }
      .ci-chips { grid-template-columns:1fr 1fr; }
      .ci-chip-blurb { display:none; }
    }
  </style>
</BaseLayout>
