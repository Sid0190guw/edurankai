---
// /careers — EDURANKAI CAREER INTELLIGENCE.
//
// =================================================================================================
// WHAT CHANGED, AND WHY IT HAD TO
// =================================================================================================
//
// This page used to SELECT up to five thousand postings and write every one of them into the
// initial HTML, grouped by team. It worked. It was also a multi-megabyte document that grew with
// the catalogue, and the number at the top of it was measured off the array it had managed to
// fetch — so once the catalogue passed the fetch cap, the page reported the cap as the size of the
// catalogue. It said "500 open roles" beside a team sidebar that already added up to more.
//
// Nothing on this page now renders a list of every posting. What loads is:
//
//   the hero, one input, seven suggestions, a team directory with SQL counts, six featured
//   postings, and the static sections about applying.
//
// Everything else is fetched, a page at a time, from /api/careers/search (plain) and
// /api/careers/intel/matches (personalised). Ten thousand postings would cost this page nothing.
//
// =================================================================================================
// THIS PAGE IS COMPLETE BEFORE ANY SCRIPT RUNS
// =================================================================================================
//
// The search box is a real <form method="GET"> that lands on /careers/opportunities, which is a
// fully server-rendered, filterable, paginated catalogue. The seven pathway suggestions are real
// links to filtered queries. The team directory is real links. public/career-intel.js upgrades all
// of that into a conversation; if it never loads, every one of those controls still works.
//
// That is section 31 of the brief honoured structurally rather than with an error handler: the
// careers page cannot be taken down by an intelligence endpoint, because the intelligence is not
// what makes it a careers page.
//
// =================================================================================================
// IT IS ALSO STILL EDGE-CACHEABLE
// =================================================================================================
//
// /careers is in PUBLIC_CACHEABLE_EXACT in src/middleware.ts. This document is identical for every
// visitor — the personalisation happens in the browser after it loads and is posted to a no-store
// endpoint — so that stays true, and a repeat visit costs the database nothing at all.
//
// .astro RULES OBSERVED THROUGHOUT: every comparison is in the frontmatter, there is no typed
// Record in the markup, no arrow characters inside JSX strings, and no emoji anywhere.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { discoverTeams, featuredPostings, openPostingCount } from '@/lib/career-intel/retrieve';
import { openingPathways } from '@/lib/career-intel/questions';
import { toCard } from '@/lib/career-intel/wire';
import { PERSONAL_DISCLAIMER, PERSONAL_TITLE, WAKE_CHOICES, NATURE_CHOICES } from '@/lib/career-intel/personal';
import { MATCHED_NOTHING } from '@/lib/career-intel/explain';
import { legacyCareersDecision, goneMessage } from '@/lib/career-intel/legacy-links';
import { PRIMARY_SITE_TEXT } from '@/lib/work-mode';

// =================================================================================================
// LINKS THAT WERE SHARED BEFORE THIS PAGE WAS REBUILT
// =================================================================================================
//
// The old /careers read q, dept, level and product and rendered a filtered list. This one reads no
// query parameters at all, so every link anybody had already shared — /careers?level=Intern and its
// relatives — kept returning 200 and silently ignored the filter. Measured on the live site: the
// response was BYTE-IDENTICAL to /careers with no query string. A 404 tells somebody; a 200 that
// quietly drops the filter tells nobody.
//
// BEFORE ANY DATABASE WORK. A redirect that runs after three queries is three wasted queries on
// every legacy link, and this is the first thing in the frontmatter for that reason.
const legacy = legacyCareersDecision(Astro.request.url);
if (legacy.redirectTo) return Astro.redirect(legacy.redirectTo, 302);

// Not redirected: somebody followed a link to a specific posting that no longer exists
// (/careers/[slug] 302s here with ?gone=<slug>). They are owed the reason, and a second redirect
// would swallow it.
const goneNotice = legacy.goneSlug ? goneMessage(legacy.goneSlug) : '';
const hasGoneNotice = !!goneNotice;

// THREE READS FOR THE WHOLE PAGE, AND NO DDL IN ITS OWN FRONTMATTER.
//
// The old one called ensureRoleProductColumn() and ensureRoleAicteColumns() before its first
// SELECT — eighteen ALTER TABLE statements against `roles` on every cold instance. Measured on the
// live site on 2026-08-23 that was the difference between a homepage that answered twenty
// concurrent requests and a careers page that answered four of them: ALTER TABLE takes ACCESS
// EXCLUSIVE, a pending exclusive lock is granted ahead of the shared locks requested after it, and
// every reader of `roles` queued behind it. Both calls are gone; the columns they created are
// tolerated as absent by the queries below instead.
//
// listOpportunities() still calls ensureXscaleSchema() internally, which is pre-existing and is a
// resolved promise in production (SCHEMA_BOOTSTRAP is off there by default). This page adds none of
// its own.
const discovery = await discoverTeams();
const featured = await featuredPostings(6);
const countedOpen = await openPostingCount();

// openPostingCount returns -1 when it could not count. That is NOT zero, and the difference is the
// whole point: "there are no openings" is a claim this page must never make on a failed query.
const countKnown = countedOpen >= 0;
const openCount = countKnown ? countedOpen : discovery.total;
const haveCount = countKnown || discovery.readable;
const countText = haveCount ? String(openCount) : '';

const teams = discovery.teams;
const teamsReadable = discovery.readable;
const hasTeams = teams.length > 0;
const featuredCards = featured.rows.map(toCard);
const hasFeatured = featuredCards.length > 0;

const pathways = openingPathways();

// The rotating examples under the input. Plain text, rendered server-side, cycled by CSS only —
// no script needed and nothing moves for anybody who has asked for reduced motion.
const EXAMPLES = [
  'I want to work on difficult AI problems.',
  'I like maths and coding but do not know which role fits me.',
  'I want to build something meaningful.',
  'I am interested in research and education.',
  'I know exactly what role I want.',
];

// Handed to the client script as JSON rather than through define:vars, which cannot be combined
// with is:inline on this project.
//
// `</` IS ESCAPED. Everything in here is a constant today, but a JSON blob written into a <script>
// element ends that element the moment its text contains a closing tag, and the day somebody puts
// a database string in this object is not the day to discover that.
const bootJson = JSON
  .stringify({ matchedNothing: MATCHED_NOTHING, openCount: haveCount ? openCount : null })
  .replace(/</g, '\\u003c');

const updated = new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Careers - EduRankAI"
  description="Explore opportunities across research, engineering, education, design and operations at EduRankAI. Start with what interests you, or search the full catalogue. Every application is read by a human."
>
  <!-- ================================ HERO ================================ -->
  <section class="px-[5vw] pt-10 md:pt-14 pb-2 max-w-6xl mx-auto">
    {hasGoneNotice && (
      <p class="ci-gone" role="status">
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <span>{goneNotice}</span>
      </p>
    )}

    <p class="eyebrow mb-3">Careers &middot; On-site in Bharat &middot; {PRIMARY_SITE_TEXT}</p>

    <h1 class="font-display text-[clamp(2.1rem,6vw,3.6rem)] font-semibold text-ink leading-[1.03] tracking-tight mb-4">
      Find your <em class="italic text-burn font-medium">place.</em>
    </h1>

    {haveCount ? (
      <p class="text-[1.02rem] md:text-[1.14rem] text-ink-soft font-light leading-[1.55] max-w-2xl mb-7">
        <strong class="text-ink font-semibold">{countText}</strong> open positions across research, engineering,
        education, design and operations. Start with what interests you &mdash; not with a job title you
        already know.
      </p>
    ) : (
      <p class="text-[1.02rem] md:text-[1.14rem] text-ink-soft font-light leading-[1.55] max-w-2xl mb-7">
        Openings across research, engineering, education, design and operations.
        <span class="text-ink-2"> We could not count them just now &mdash; the catalogue itself is still browsable below.</span>
      </p>
    )}

    <!-- ============================ THE INPUT ============================ -->
    <!--
      A REAL FORM. method=GET, action=/careers/opportunities. Typing a sentence and pressing enter
      with no JavaScript at all runs a server-side search and returns a paginated, filterable page.
      career-intel.js intercepts the submit and answers in place instead.
    -->
    <div id="ci-root" data-busy="0">
      <form id="ci-form" method="GET" action="/careers/opportunities" class="ci-form" role="search">
        <label class="ci-label" for="ci-input">Tell us what you want to explore</label>
        <div class="ci-input-wrap">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ci-input-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="ci-input"
            name="q"
            type="text"
            class="ci-input"
            autocomplete="off"
            placeholder="Describe what you enjoy, what you are good at, or what you are unsure about..."
          />
          <button id="ci-submit" type="submit" class="ci-go">
            <span class="ci-go-label">Explore</span>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
        <p class="ci-examples" aria-hidden="true">
          {EXAMPLES.map((e, i) => (
            <span class="ci-example" style={'animation-delay:' + (i * 4) + 's'}>{e}</span>
          ))}
        </p>
        <p class="ci-help">
          Say it however you like &mdash; a sentence, a subject, a job title, or that you have no idea yet.
          You can also <a href="/careers/opportunities">browse every opening</a> without telling us anything.
        </p>
      </form>

      <!-- ===================== PATHWAY SUGGESTIONS ===================== -->
      <!--
        SUGGESTIONS, AND THE PAGE SAYS SO. Each is a genuine filtered query on the catalogue, so
        they work with this page's script absent; with it present they open the conversation.
      -->
      <div class="ci-pathways">
        <p class="ci-pathways-label">Or start from one of these. They are suggestions, not categories &mdash; you are not choosing a box.</p>
        <div class="ci-chips">
          {pathways.map((p) => (
            <a
              class="ci-chip"
              href={'/careers/opportunities?q=' + encodeURIComponent(p.label)}
              data-ci-pathway="1"
              data-ci-text={'I want to do work about ' + p.label.toLowerCase() + '. ' + p.blurb}
            >
              <span class="ci-chip-label">{p.label}</span>
              <span class="ci-chip-blurb">{p.blurb}</span>
            </a>
          ))}
          <a class="ci-chip ci-chip-open" href="/careers/opportunities">
            <span class="ci-chip-label">I am not sure yet</span>
            <span class="ci-chip-blurb">Browse everything and see what stands out</span>
          </a>
        </div>
      </div>

      <p class="ci-status" id="ci-status" role="status" aria-live="polite"></p>

      <!-- The conversation. Empty and invisible until something is said. -->
      <div id="ci-thread" class="ci-thread"></div>

      <!-- ======================= WHAT WE UNDERSTAND ======================= -->
      <div class="ci-panel-wrap">
        <button
          id="ci-panel-toggle"
          type="button"
          class="ci-panel-toggle"
          aria-expanded="false"
          aria-controls="ci-panel"
        >
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          What we currently understand
        </button>
        <div id="ci-panel" class="ci-panel" hidden tabindex="-1" aria-label="What we currently understand about you">
          <p class="ci-panel-intro">
            Everything below is held in this browser only. Nothing here is sent to us unless you press
            something, and nothing about you is stored on our servers.
            Change anything that is wrong, remove anything you would rather we did not keep.
          </p>
          <div id="ci-panel-body"></div>

          <!-- ==================== OPTIONAL PERSONAL LAYER ==================== -->
          <!--
            THIS ASKED FOR A DATE OF BIRTH AND ANSWERED WITH A STAR SIGN. It does not any more.

            A careers page has no use for somebody's birth date, and a sentence chosen by the
            calendar is not a sentence about them. What it asks for now is what a person actually
            knows about themselves: when their day starts, how they would describe their own nature,
            and height and weight, because those were asked for.

            SEPARATE, IN THE MARKUP AS WELL AS IN THE CODE. It sits inside the panel, below
            everything that matters, behind its own control, with its disclaimer above the fields
            rather than under them. src/lib/career-intel/personal.ts is not imported by the ranker,
            by retrieval, by the explanation builder or by the map, and separation.test.ts fails if
            it ever is — under that name or under the old one.

            WHAT IS JOB-RELEVANT IS NOT IN HERE. Skills and the subjects somebody enjoyed are real
            evidence and they rank: they are questions in the conversation above
            (experience.skills, direction.subject) and they are quoted back as the reason a posting
            was shown. Height and weight are in this block precisely BECAUSE the ranking code
            cannot reach it.
          -->
          <details class="ci-personal">
            <summary>{PERSONAL_TITLE}</summary>
            <p class="ci-panel-note">{PERSONAL_DISCLAIMER}</p>
            <form id="ci-personal-form" class="ci-personal-form">
              <fieldset class="ci-fieldset">
                <legend class="ci-legend">When do you usually wake?</legend>
                <div class="ci-choices">
                  {WAKE_CHOICES.map((c) => (
                    <label class="ci-choice">
                      <input type="radio" name="wake" value={c.id} />
                      <span>{c.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="ci-fieldset">
                <legend class="ci-legend">Which of these are true of you? As many as you like.</legend>
                <div class="ci-choices">
                  {NATURE_CHOICES.map((c) => (
                    <label class="ci-choice">
                      <input type="checkbox" name="nature" value={c.id} />
                      <span>{c.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="ci-fieldset">
                <legend class="ci-legend">Height and weight, if you want them written down</legend>
                <p class="ci-panel-note">
                  We do not use these for anything at all. They are here because you asked to be able
                  to record them, they stay in this browser, and no opportunity is ever shown,
                  hidden or ordered because of them.
                </p>
                <div class="ci-measures">
                  <span class="ci-measure">
                    <label for="ci-height">Height (cm)</label>
                    <input id="ci-height" name="heightCm" type="number" min="50" max="260" step="0.5" inputmode="decimal" />
                  </span>
                  <span class="ci-measure">
                    <label for="ci-weight">Weight (kg)</label>
                    <input id="ci-weight" name="weightKg" type="number" min="20" max="400" step="0.5" inputmode="decimal" />
                  </span>
                </div>
              </fieldset>

              <label class="ci-legend" for="ci-personal-note">Anything else you want written down</label>
              <textarea
                id="ci-personal-note"
                name="note"
                class="ci-q-text"
                rows="2"
                placeholder="In your own words. Nothing here is read by matching."
              ></textarea>

              <div class="ci-actions">
                <button type="submit" class="ci-btn ci-btn-primary">Save this to my browser</button>
                <button type="button" id="ci-personal-clear" class="ci-btn ci-btn-quiet">Remove all of it</button>
              </div>
            </form>
          </details>
        </div>
      </div>

      <!-- ============================ THE CAREER MAP ============================ -->
      <!--
        Empty until there is something to map. Rendered as headed LISTS, not as a diagram with a
        list bolted on underneath: the same markup is what a screen reader reads, what somebody
        gets under reduced motion, and what everybody gets on a phone. Every node is a link to a
        real filtered query, so it works with this page's script absent too.
      -->
      <section id="ci-map" class="ci-map" hidden aria-label="Your career map"></section>

      <!-- Results. Server-rendered nothing; filled by the client, and by nothing else. -->
      <div id="ci-results" class="ci-results" aria-live="polite"></div>

      <!-- The introduction that the results replace. Visible until a conversation starts. -->
      <div id="ci-intro" class="ci-intro">
        <noscript>
          <p class="ci-note ci-note-quiet">
            The guided exploration needs JavaScript. Everything else on this page works without it:
            the search box above runs a full server-side search, and every link below is a real
            filtered query.
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <!-- ============================ EXPLORE BY TEAM ============================ -->
  <section class="px-[5vw] py-10 max-w-6xl mx-auto">
    <div class="flex items-baseline justify-between gap-4 mb-1">
      <h2 class="font-display text-xl md:text-2xl font-semibold text-ink">Explore by team</h2>
      <span class="text-[0.72rem] font-mono text-ink-soft/60">Updated {updated}</span>
    </div>
    <p class="text-[0.9rem] text-ink-soft mb-6 max-w-2xl">
      Every count below is the number of positions genuinely open in that team right now, counted in
      the database rather than measured off this page.
    </p>

    {teamsReadable ? (
      hasTeams ? (
        <div class="ci-teams">
          {teams.map((t) => (
            <a class="ci-team" href={'/careers/opportunities?dept=' + encodeURIComponent(t.id)}>
              <span class="ci-team-name">{t.name}</span>
              <span class="ci-team-count">{t.openCount}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="ci-note ci-note-quiet">
          There are no open positions in any team at the moment. Write to us anyway &mdash;
          <a href="mailto:hr@edurankai.in?subject=Open Application">hr@edurankai.in</a>.
        </p>
      )
    ) : (
      <p class="ci-note ci-note-warn">
        We could not read the team directory just now. This is a problem at our end, not an empty
        catalogue &mdash; <a href="/careers/opportunities">the full search</a> may still work.
      </p>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      <a href="/careers/opportunities" class="ci-link-btn">Search every opening &rarr;</a>
      <a href="/careers/departments" class="ci-link-btn">Department directory &rarr;</a>
      <a href="/careers/opportunities?classification=COMPUTATIONAL" class="ci-link-btn">By research classification &rarr;</a>
      <a href="/careers/opportunities?skillcat=MATHEMATICS" class="ci-link-btn">By discipline &rarr;</a>
      <a href="/careers/opportunities?band=BAND_05" class="ci-link-btn">By scale band &rarr;</a>
    </div>
  </section>

  <!-- ============================ FEATURED OPENINGS ============================ -->
  {hasFeatured && (
    <section class="px-[5vw] py-8 max-w-6xl mx-auto">
      <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-1">A few we are especially keen to fill</h2>
      <p class="text-[0.9rem] text-ink-soft mb-6 max-w-2xl">
        Six of them, not six hundred. The rest are one search away.
      </p>
      <div class="ci-cards">
        {featuredCards.map((c) => (
          <article class="ci-role">
            <a class="ci-role-title" href={c.href}>{c.title}</a>
            <p class="ci-role-meta">{[c.level, c.department, c.engagementType, c.location].filter(Boolean).join(' · ')}</p>
            <p class="ci-role-fn">{c.functionText}</p>
            <div class="ci-role-actions">
              <a class="ci-btn ci-btn-primary" href={c.href}>Read the full posting</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ============================ HOW THIS WORKS ============================ -->
  <section class="px-[5vw] py-10 max-w-6xl mx-auto">
    <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-1">How the guided exploration works</h2>
    <p class="text-[0.9rem] text-ink-soft mb-6 max-w-2xl">
      Written down here rather than left to be inferred, because a system that reads what you say
      about yourself owes you a plain account of what it does with it.
    </p>
    <div class="ci-how">
      <div class="ci-how-card">
        <h3>It reads, it does not decide</h3>
        <p>
          What you write is turned into signals, which order the openings and explain why each one
          is there. Nothing you tell us can make a posting disappear &mdash; whether a position is
          open is decided by the position, never by anything about you.
        </p>
      </div>
      <div class="ci-how-card">
        <h3>You can correct it</h3>
        <p>
          Everything it concludes is shown back before it is used, and can be confirmed, adjusted or
          rejected. Your own words are kept exactly as typed, separately from our reading of them.
        </p>
      </div>
      <div class="ci-how-card">
        <h3>Nothing is stored on our servers</h3>
        <p>
          Your answers live in this browser. Clearing them is one button, and it is a real delete.
          Sign in only if you want them kept across devices, and even then only when you ask.
        </p>
      </div>
      <div class="ci-how-card">
        <h3>Some of it is only for you</h3>
        <p>
          Energy rhythm, self-reported working tendencies, and anything you put in the optional
          personal section &mdash; when you wake, how you would describe yourself, height and weight
          &mdash; are for your own picture. They play no part in which openings you see or in what
          order, and no part in any application. Nothing here is a psychological assessment.
        </p>
      </div>
      <div class="ci-how-card">
        <h3>No CV required, ever</h3>
        <p>
          There is no upload wall. If more context would genuinely sharpen the ranking we say so and
          offer it &mdash; and every path past that offer carries on without one.
        </p>
      </div>
      <div class="ci-how-card">
        <h3>A person reads every application</h3>
        <p>
          Ranking is a way of finding things. It is not a screen, not a score, and not a decision.
          Hiring decisions here are made by named people, and automated signals are advisory only.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================ APPLYING & SUPPORT ============================ -->
  <section id="applying" class="px-[5vw] py-10 max-w-6xl mx-auto scroll-mt-24">
    <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-6">Applying &amp; support</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="bg-white rounded-2xl p-5" style="border:1px solid rgba(14,11,8,0.10);border-left:4px solid #128a3f;">
        <h3 class="font-display text-[1.05rem] font-semibold text-ink leading-tight m-0 mb-1.5">Free to apply</h3>
        <p class="text-[0.84rem] text-ink-soft leading-relaxed m-0">Every position is free to apply to, at every level. Money is never the reason you cannot apply.</p>
      </div>
      <a href="/careers/hr-support" class="group bg-white rounded-2xl p-5 no-underline transition-all hover:-translate-y-0.5" style="color:inherit;border:1px solid rgba(14,11,8,0.10);border-left:4px solid #1045BB;">
        <h3 class="font-display text-[1.05rem] font-semibold text-ink leading-tight m-0 mb-1.5">Want help applying?</h3>
        <p class="text-[0.84rem] text-ink-soft leading-relaxed m-0 mb-3">Book a 30-minute call with our HR team and we walk you through it. Entirely optional.</p>
        <span class="text-sky font-semibold text-[0.82rem]">Book a call &rarr;</span>
      </a>
      <a href="/policy/candidate-transparency" class="group bg-white rounded-2xl p-5 no-underline transition-all hover:-translate-y-0.5" style="color:inherit;border:1px solid rgba(14,11,8,0.10);border-left:4px solid #DC5000;">
        <h3 class="font-display text-[1.05rem] font-semibold text-ink leading-tight m-0 mb-1.5">Your data, plainly</h3>
        <p class="text-[0.84rem] text-ink-soft leading-relaxed m-0 mb-3">What we collect, what it is for, and what we will never do &mdash; no ads, no selling, no training models on your data.</p>
        <span class="text-burn font-semibold text-[0.82rem]">2-minute read &rarr;</span>
      </a>
    </div>

    <div class="mt-6 grid grid-cols-2 md:grid-cols-5 gap-2.5">
      {[
        ['Apply', 'Pick a position and submit. Minutes, not hours.'],
        ['Human review', 'A real person reads every application.'],
        ['Assessment', 'A focused task that mirrors the real work.'],
        ['Interviews', 'Technical depth, then values and fit.'],
        ['Offer', 'Decision and written feedback within 5 days.'],
      ].map((step: any, i: number) => (
        <div class="bg-white border border-ink/10 rounded-2xl p-4 flex flex-col">
          <span class="font-mono text-[0.72rem] font-bold text-burn">{'0' + (i + 1)}</span>
          <h3 class="font-display text-[0.96rem] font-semibold text-ink mt-1.5 mb-1">{step[0]}</h3>
          <p class="text-[0.76rem] text-ink-soft leading-relaxed">{step[1]}</p>
        </div>
      ))}
    </div>

    <div class="mt-4 bg-white rounded-2xl px-5 py-4" style="border:1px solid rgba(14,11,8,0.08);border-left:4px solid #DC5000;">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink m-0 mb-2">Our merit-first hiring policy</h3>
      <p class="text-[0.88rem] text-ink-2 leading-[1.7] m-0">
        We select on capability, merit, innovation, research potential, leadership, execution and
        impact. In line with our focus on nurturing talent from institutions and communities
        traditionally underrepresented in highly competitive recruitment, we do not give &mdash; or
        consider requests for &mdash; preferential treatment based on affiliation with any
        centrally-funded premier institution. Your work speaks; your badge does not.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mt-3">
      <a href="/policy/hiring" class="ci-link-btn">Hiring policy &rarr;</a>
      <a href="/policy/recruitment" class="ci-link-btn">Recruitment &amp; work &rarr;</a>
      <a href="/policy/work-culture" class="ci-link-btn">Work culture &rarr;</a>
    </div>
  </section>

  <!-- ============================ OPEN APPLICATION ============================ -->
