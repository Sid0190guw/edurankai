---
// /invite — type the code from an invitation email.
//
// WHY THIS PAGE EXISTS. The link in an invitation is a 43-character URL token, and a link is only
// useful to somebody who can click it. Mail clients mangle long URLs, people read a message on a
// phone and want to apply on a laptop, and somebody forwarding an invitation by hand copies the
// short thing rather than the long one. So every invitation also carries ERA-INV-XXXXX-XXXXX-XXXXX,
// and this is where it is typed.
//
// NOTHING IS DECIDED HERE. The form navigates to /invite/<code>, which is the same landing page a
// link opens — one lookup, one attempt limit, one set of rules. A second code-checking path is how
// two answers to "is this valid" end up disagreeing.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INVITE_CODE_PREFIX } from '@/lib/hiring/invitations';

export const prerender = false;

// Declared before anything below uses it: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
const placeholder = INVITE_CODE_PREFIX + '-XXXXX-XXXXX-XXXXX';
---

<BaseLayout
  title="Enter your invitation code"
  description="Enter the code from your EduRankAI invitation."
  noindex={true}
>
  <main class="mx-auto w-full max-w-2xl px-5 py-12 sm:py-16">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500">Invitation</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">Enter your code</h1>
    <p class="mt-3 text-base leading-relaxed text-neutral-600">
      Your invitation email has a code beginning {INVITE_CODE_PREFIX}. Type it here if the link in
      that email does not open.
    </p>

    <form id="code-form" class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6" novalidate>
      <label for="code" class="block text-sm font-medium text-neutral-800">Invitation code</label>
      <input
        id="code" name="code" type="text" autocomplete="one-time-code" spellcheck="false"
        autocapitalize="characters" required placeholder={placeholder}
        class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 font-mono text-base tracking-wider text-neutral-900 placeholder:font-sans placeholder:text-sm placeholder:tracking-normal placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
      />
      <p class="mt-2 text-xs text-neutral-500">
        Codes never contain the characters O, I, L, 0 or 1. Spacing and dashes do not matter.
      </p>

      <p id="code-error" class="mt-3 hidden text-sm text-red-700" role="status" aria-live="polite"></p>

      <button
        type="submit" id="code-submit"
        class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
      >Continue</button>
    </form>

    <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
      <h2 class="text-base font-semibold text-neutral-900">No code, or it does not work?</h2>
      <p class="mt-2 text-sm leading-relaxed text-neutral-600">
        Nothing here is only reachable by invitation. Every open opportunity is listed publicly, and
        the ordinary application is the same one an invitation leads to.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a
          href="/careers"
          class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800"
        >See open opportunities</a>
        <a
          href="/apply"
          class="inline-flex items-center justify-center rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50"
        >Start an application</a>
      </div>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>

<script>
  // Kept at the top level and out of any conditional: a script inside a JSX conditional breaks the
  // Astro parser on this project.
  const form = document.getElementById('code-form');
  const input = document.getElementById('code');
  const err = document.getElementById('code-error');
  const btn = document.getElementById('code-submit');

  // The alphabet, mirrored from CODE_ALPHABET. Only used to decide when the field LOOKS complete —
  // the server is what actually validates, and it is deliberately the only thing that does.
  const ALPHABET = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  const BODY_LEN = 15;

  function body(value) {
    return String(value || '')
      .toUpperCase()
      .replace(/^\s*ERA[\s-]*INV[\s-]*/, '')
      .split('')
      .filter((c) => ALPHABET.indexOf(c) !== -1)
      .join('');
  }

  function show(message) {
    if (!err) return;
    err.textContent = message;
    err.classList.remove('hidden');
  }

  if (form && input && btn) {
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      err && err.classList.add('hidden');
      const b = body(input.value);
      if (b.length !== BODY_LEN) {
        // A local length check only. It never says a code is WRONG — that answer comes from the
        // server, in one sentence, so this page cannot become a way to test guesses for free.
        show('That does not look like a complete code. It has 15 characters after ERA-INV.');
        input.focus();
        return;
      }
      btn.disabled = true;
      window.location.href = '/invite/' + encodeURIComponent(b);
    });
  }
</script>
