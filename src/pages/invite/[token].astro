---
// /invite/<token> — the landing page for an invitation an administrator sent.
//
// WHAT THIS PAGE IS ALLOWED TO DO. It reads the token, records that the link was opened, and shows
// the person what they were invited to. It does NOT grant anything: the invitation is bound to an
// email address, and every decision that depends on it — the fee waiver, the link back to the
// invitation record — is taken later, server-side, from that email. So a forwarded link gets
// somebody to the application form, which is a page anyone can reach from /careers anyway, and gets
// them nothing else.
//
// ONE SENTENCE FOR EVERY FAILURE. Used, withdrawn, expired and never-existed all render INVALID_LINK.
// Telling the outside which one it was answers a question we have no reason to answer.
//
// AND IT CARRIES THE PERSON THROUGH THE GATE. /apply is behind the application gate, so before this
// page signed a pass, pressing Continue bounced the invited person to /apply/gateway - a screen
// asking for an ERA-SEL onboarding code, which an invitation is not. The only code they held was the
// ERA-INV one in their email, so they typed that and were told to go to /invite: the page they were
// standing on. The pass this page signs is the ORDINARY 'open' door, bound to the email address the
// invitation names, carrying nothing an anonymous visitor could not get from /careers. It removes a
// question we already knew the answer to; it does not open onboarding, and it cannot.
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  resolveInvitation, markOpened, isLive, INVALID_LINK, INVALID_CODE, RATE_LIMITED_CODE,
  ensureInvitationSchema, hasVisibleNote, invitationPass, invitationPassTtlSeconds,
  inviteApplyHref, livePosting, displayRoleTitle, type LivePosting,
} from '@/lib/hiring/invitations';
import { GATE_COOKIE } from '@/lib/talent/gate-pass';
import { sanitizeEmailHtmlString, ORIGIN } from '@/lib/mailsec/html';

export const prerender = false;

// Declared before anything below uses them: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
// The segment is EITHER a URL token or a typed code — resolveInvitation() decides which, applies the
// attempt limit to the code shape only, and is the single lookup both this page and /invite use.
const typed = String(Astro.params.token || '');

try { await ensureInvitationSchema(); } catch { /* production has this from the hand-run .sql */ }

const resolved = await resolveInvitation(typed, String(Astro.clientAddress || ''));
const invitation = resolved.invitation;
const rateLimited = resolved.rateLimited;
// Word the refusal the way the person experienced it. Telling somebody who carefully typed
// ERA-INV-... that their LINK expired reads as our bug, and sends them hunting for a link they may
// never have had. Same one-sentence rule either way: which of wrong, spent, withdrawn or expired it
// was stays unsaid.
const wasCode = resolved.wasCode;
const refusal = rateLimited ? RATE_LIMITED_CODE : (wasCode ? INVALID_CODE : INVALID_LINK);
const refusalHeading = wasCode ? 'That code did not work' : 'This link is not usable';
const valid = !!invitation && isLive(invitation.status);

// Recording that it opened must never be able to stop the person walking through the door.
if (valid && invitation) {
  await markOpened(invitation.id);
}

// THE GATE PASS. Signed here so Continue leads to the application and not to a code box. door stays
// 'open', so applyGateRedirect() keeps this pass out of /onboarding exactly as it did before.
//
// A pass that could not be signed is not fatal to this page: the person still sees what they were
// invited to, and Continue still goes to /apply, which sends them to the gate screen - where the
// "not available" state is rendered honestly instead of being guessed at here.
let passIssued = false;
if (valid && invitation) {
  const token = invitationPass(invitation);
  if (token) {
    Astro.cookies.set(GATE_COOKIE, token, {
      httpOnly: true,
      secure: Astro.url.protocol === 'https:',
      sameSite: 'lax',
      path: '/',
      maxAge: invitationPassTtlSeconds(),
    });
    passIssued = true;
  }
}

// THE POSTING, READ FROM THE CATALOGUE RATHER THAN FROM THE INVITATION'S SNAPSHOT.
//
// role_title on the row is what the posting was called on the day the invitation was sent, which is
// the right thing to keep in the record and the wrong thing to show on a page somebody opens weeks
// later. Asking `roles` means a renamed posting reads correctly, an invitation written before the
// title was stored still names the position, and a posting that has since closed says so here rather
// than at the end of the form. One query, only when there is a slug to ask about.
const live: LivePosting | null = invitation?.roleSlug ? await livePosting(invitation.roleSlug) : null;
const roleTitle = invitation ? displayRoleTitle(invitation, live) : '';
// null means the read failed or there is no slug - neither is "closed", and neither may render as it.
const roleClosed = !!live && !live.acceptsApplications;
const roleNote = live?.publicNote || '';
const applyHref = inviteApplyHref(invitation?.roleSlug || '');
const careersHref = invitation?.roleSlug ? '/careers/' + encodeURIComponent(invitation.roleSlug) : '/careers';
const invitedBy = invitation?.invitedByName || '';
const expiresOn = invitation?.expiresAt ? String(invitation.expiresAt).slice(0, 10) : '';

// Comparisons are resolved here: a `<` inside a JSX expression breaks the Astro parser on this
// project, and so does an arrow character inside a JSX string.
//
// THE BUTTON SAYS WHERE IT GOES. "Continue to the application for Executive Assistant to CEO" is the
// promise the email made; a bare "Continue" was true of a page that then asked for a different code.
const continueLabel = roleTitle
  ? 'Continue to the application for ' + roleTitle
  : 'Continue to the application';
// passIssued is the honest half. When the gate could not sign, the next screen is the gate itself,
// and saying so beforehand is better than a button that silently goes somewhere else.
const continueNote = passIssued
  ? 'No code needed - this link is your way in. You will be asked to create or sign in to an applicant account, and the application opens on the posting above.'
  : 'You will be asked one question at the application gate before the form opens. Choose the option for not holding an onboarding code - an invitation is not one.';
const headline = roleTitle ? 'You are invited to apply' : 'You are invited to apply';
const subhead = roleTitle
  ? 'for ' + roleTitle
  : 'You can choose which opportunity to apply for.';

// The note is written in a composer now, so it is markup rather than a sentence. Rendered with the
// ORIGIN profile, NOT OUTBOUND: this is our own document, so anything that could lift content out of
// its box has to go - a message body that can cover the page can put a fake dialog over the real one.
// The two profiles happen to be identical today; naming the right one is what keeps that a choice
// rather than a coincidence.
//
// An older note is plain prose and passes through unchanged, which is why this is safe to apply to
// every row rather than only to notes written after the composer shipped.
// hasVisibleNote() decides, on the SANITISED output, not on whether the column is a non-empty
// string. A composer that was focused and emptied stores '<p><br></p>', and a note whose whole
// content the sanitiser removed leaves '' - both used to render as a bordered box with nothing in it.
const noteSanitised = invitation && invitation.note ? sanitizeEmailHtmlString(invitation.note, ORIGIN) : '';
const noteHtml = hasVisibleNote(noteSanitised) ? noteSanitised : '';
const showNote = noteHtml !== '';
---

<BaseLayout
  title={valid ? 'An invitation to apply' : 'Invitation link'}
  description="An invitation to apply at EduRankAI."
  noindex={true}
>
  <main class="mx-auto w-full max-w-2xl px-5 py-12 sm:py-16">

    {valid ? (
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500">Invitation</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">{headline}</h1>
        <p class="mt-2 text-lg text-neutral-600">{subhead}</p>

        {invitedBy ? (
          <p class="mt-6 text-sm text-neutral-600">
            {invitedBy} asked us to send you this.
          </p>
        ) : null}

        {showNote ? (
          <blockquote class="invite-note mt-5 rounded-lg border-l-4 border-[#FF4F00] bg-neutral-50 px-4 py-3 text-sm leading-relaxed text-neutral-700" set:html={noteHtml} />
        ) : null}

        {roleClosed ? (
          <p class="mt-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-900">
            {roleNote || 'This posting is not accepting applications at the moment.'}
            {' '}You can still see everything that is open on the
            <a href="/careers" class="font-medium underline underline-offset-2"> careers page</a>.
          </p>
        ) : null}

        {invitation && invitation.waiveFee ? (
          <p class="mt-5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            The application fee has been waived for you. It is applied automatically when you reach
            that step, as long as you apply with <strong>{invitation.email}</strong>.
          </p>
        ) : null}

        <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
          <h2 class="text-base font-semibold text-neutral-900">What happens next</h2>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-neutral-600">
            <li>You fill in the application, the same one everybody fills in.</li>
            <li>A person reads it. An invitation is not an offer and does not decide the outcome.</li>
            <li>
              Apply with the address this was sent to
              {invitation ? <strong> {invitation.email}</strong> : null}
              , so we can connect your application to this invitation.
            </li>
          </ul>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={applyHref}
              class="inline-flex w-full items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 sm:w-auto"
            >{continueLabel}</a>
            {roleTitle ? (
              <a
                href={careersHref}
                class="inline-flex w-full items-center justify-center rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50 sm:w-auto"
              >Read the full posting</a>
            ) : null}
          </div>

          <p class="mt-3 text-xs leading-relaxed text-neutral-500">{continueNote}</p>

          {expiresOn ? (
            <p class="mt-1 text-xs text-neutral-500">This link stops working after {expiresOn}.</p>
          ) : null}
        </div>
      </div>
    ) : (
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500">Invitation</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">{refusalHeading}</h1>
        <p class="mt-3 text-base leading-relaxed text-neutral-600">{refusal}</p>

        <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
          <h2 class="text-base font-semibold text-neutral-900">You can still apply</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            Nothing here is only reachable by invitation. Every open opportunity is listed publicly,
            and the ordinary application is the same one an invitation leads to.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href="/careers"
              class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800"
            >See open opportunities</a>
            <a
              href="/apply"
              class="inline-flex items-center justify-center rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50"
            >Start an application</a>
          </div>
        </div>

        <p class="mt-6 text-sm text-neutral-600">
          If you believe this link should work, reply to the email it came in and ask for a new one.
        </p>
      </div>
    )}

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>
