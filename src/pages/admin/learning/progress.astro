---
// /admin/learning/progress — PROGRESS PER COHORT, AND ONE PERSON OPENED FROM INSIDE IT.
//
// WHAT THE "COMPLETE" COLUMN IS READING. training_enrollments.completed_at — a column that, before
// this build, was read in two places and WRITTEN BY NOTHING in the entire repository. Every figure in
// it is therefore a figure this administration wrote, from evidence, under a rule somebody chose.
// A course finished in the AquinTutor runner or the portal player still shows nothing here until it
// is reconciled on the person's own screen; that is stated below rather than left to be discovered.
//
// WHO SEES WHAT. `learning.progress.view` is the whole organization. A DEPARTMENT HEAD sees their own
// department with no key at all, and the scope is resolved from the Organization Graph and applied to
// every query as a WHERE clause. No users.role test appears on this page.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { clip } from '@/lib/page-safety';
import {
  resolveLearningScope,
  cohortRollup,
  peopleWithLearning,
  departmentNameMap,
  LEARNING_PROGRESS_VIEW,
  type CohortRow,
  type LearningScope,
  type PersonRow,
} from '@/lib/learning-admin';

const PATH = '/admin/learning/progress';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

// Every const above anything that reads it — `const` is not hoisted.
const holds = (k: string) => can(user as any, k as any);
const scope: LearningScope = await resolveLearningScope(String(user.id), holds, LEARNING_PROGRESS_VIEW);

const params = Astro.url.searchParams;
const departmentId = String(params.get('department') || '');
const overdueOnly = params.get('overdue') === '1';

let rollup: CohortRow[] = [];
let rollupError = '';
let people: PersonRow[] = [];
let peopleError = '';
let departments = new Map<string, string>();

if (scope.canSeeAnything) {
  const agg = await cohortRollup(scope);
  rollup = agg.rows;
  rollupError = agg.ok ? '' : (agg.error || '');
  const list = await peopleWithLearning(scope, { departmentId: departmentId || null, overdueOnly });
  people = list.rows;
  peopleError = list.ok ? '' : (list.error || '');
  departments = await departmentNameMap();
}

const totals = rollup.reduce(
  (acc, r) => ({
    people: acc.people + r.people,
    assignments: acc.assignments + r.assignments,
    complete: acc.complete + r.complete,
    inProgress: acc.inProgress + r.inProgress,
    notStarted: acc.notStarted + r.notStarted,
    overdue: acc.overdue + r.overdue,
    unlinked: acc.unlinked + r.unlinked,
  }),
  { people: 0, assignments: 0, complete: 0, inProgress: 0, notStarted: 0, overdue: 0, unlinked: 0 },
);

const departmentLabel = departmentId ? (departments.get(departmentId) || departmentId) : '';
---

<AdminLayout title="Learning progress" activeNav="hr">
  <style>
    .lp{max-width:1100px;padding:16px 16px 80px;margin:0 auto}
    .lp h1{font-size:21px;font-weight:700;letter-spacing:-.01em;margin:0 0 4px;color:var(--o-hi,#fff)}
    .lp .lede{font-size:13px;line-height:1.6;color:#9aa6b6;margin:0 0 16px;max-width:74ch}
    .lp .flash.warn{background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.36);color:#fca5a5;
      border-radius:10px;padding:11px 13px;font-size:13px;line-height:1.5;margin-bottom:14px;overflow-wrap:anywhere}
    .lp .notice{background:rgba(255,79,0,.07);border:1px solid rgba(255,79,0,.26);color:#ffb08a;
      border-radius:11px;padding:12px 14px;font-size:12.5px;line-height:1.6;margin-bottom:12px;max-width:78ch}
    .lp .card{background:var(--o-bg2,#11151c);border:1px solid var(--o-stroke,#1a1a1f);border-radius:14px;
      padding:15px;margin-bottom:13px}
    .lp .card h2{font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.13em;
      text-transform:uppercase;color:#FF7040;font-weight:700;margin:0 0 11px}
    .lp .muted{font-size:12.5px;line-height:1.6;color:#9aa6b6;overflow-wrap:anywhere}
    .lp .tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px}
    .lp .tab{flex:none;display:inline-flex;align-items:center;min-height:40px;padding:8px 14px;
      border:1px solid var(--o-stroke,#2a2a32);border-radius:999px;background:transparent;color:#9aa6b6;
      font-size:12.5px;font-weight:600;text-decoration:none;white-space:nowrap}
    .lp .tab[aria-current="page"]{background:#FF4F00;border-color:#FF4F00;color:#fff}
    .lp .tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:10px}
    .lp table{border-collapse:collapse;width:100%;min-width:700px;font-size:13px}
    .lp th{text-align:left;font-family:'Geist Mono',ui-monospace,monospace;font-size:9.5px;
      letter-spacing:.1em;text-transform:uppercase;color:#8a8a94;font-weight:700;padding:8px 10px;
      border-bottom:1px solid var(--o-stroke,#1a1a1f);white-space:nowrap}
    .lp td{padding:10px;border-bottom:1px solid rgba(255,255,255,.05);vertical-align:top;color:#c9ccd4}
    .lp .stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:6px}
    .lp .stat{background:var(--o-bg0,#08080a);border:1px solid var(--o-stroke,#1a1a1f);border-radius:11px;padding:12px}
    .lp .stat b{display:block;font-size:22px;font-weight:800;color:var(--o-hi,#fff);letter-spacing:-.02em}
    .lp .stat span{font-family:'Geist Mono',ui-monospace,monospace;font-size:9px;letter-spacing:.1em;
      text-transform:uppercase;color:#8a8a94;font-weight:700}
    .lp .pill{font-family:'Geist Mono',ui-monospace,monospace;font-size:9px;font-weight:700;padding:3px 8px;
      border-radius:99px;text-transform:uppercase;letter-spacing:.05em;background:rgba(255,255,255,.07);
      color:#9aa6b6;display:inline-block;white-space:nowrap}
    .lp .pill.late{background:rgba(220,38,38,.13);color:#fca5a5}
    .lp a.lnk{color:#FF7040;text-decoration:none}
    @media (min-width:640px){ .lp .stats{grid-template-columns:repeat(4,minmax(0,1fr))} }
  </style>

  <div class="lp">
    <h1>Learning progress</h1>
    <p class="lede">
      The aggregate, and any one person inside it. Everything here counts assignments, so a course
      somebody took on their own is not in these figures — that is a catalogue of work, not a record
      of what was asked for.
    </p>

    <div class="tabs">
      <a class="tab" href="/admin/learning/catalogue">Catalogue</a>
      <a class="tab" href="/admin/learning/assign">Assign</a>
      <a class="tab" href={PATH} aria-current="page">Progress</a>
    </div>

    {!scope.canSeeAnything && (
      <div class="notice">
        <p><b>This is the learning record.</b> {scope.explanation}</p>
        <p style="margin-top:8px">Reading it across the organization is
        <code> learning.progress.view</code>. Reading your own department needs no key at all — it
        needs a <code>department_head</code> edge in the Organization Graph.</p>
      </div>
    )}

    {scope.canSeeAnything && (
      <>
        <p class="muted" style="margin-bottom:12px">{scope.explanation}</p>

        {rollupError && (
          <p class="flash warn" role="alert">The aggregate could not be read: {rollupError}. Nothing
            below is a complete picture.</p>
        )}

        <div class="card">
          <h2>Across your scope</h2>
          <div class="stats">
            <div class="stat"><b>{totals.assignments}</b><span>Assignments</span></div>
            <div class="stat"><b>{totals.complete}</b><span>Recorded complete</span></div>
            <div class="stat"><b>{totals.inProgress}</b><span>In progress</span></div>
            <div class="stat"><b>{totals.overdue}</b><span>Overdue</span></div>
          </div>
          {totals.unlinked > 0 && (
            <p class="notice" style="margin-top:12px">
              {totals.unlinked} assignment{totals.unlinked === 1 ? '' : 's'} belong to an employee
              record with no platform account. Their progress joins on the account, so those will read
              as "not started" for as long as the account is missing, whatever the person does.
            </p>
          )}
          <p class="muted" style="margin-top:11px">
            "Recorded complete" reads the completion date on the enrolment. Finishing a course in
            either player does not write that date by itself — open a person and recompute their
            record to have the evidence read and the date written.
          </p>
        </div>

        <div class="card">
          <h2>By department</h2>
          {rollup.length === 0 && !rollupError && (
            <p class="muted">Nothing has been assigned inside your scope yet, so there is no aggregate
              to show. That is an empty record, not a failed read.</p>
          )}
          {rollup.length > 0 && (
            <div class="tablewrap">
              <table>
                <thead>
                  <tr><th>Department</th><th>People</th><th>Assigned</th><th>Complete</th>
                    <th>In progress</th><th>Not started</th><th>Overdue</th><th></th></tr>
                </thead>
                <tbody>
                  {rollup.map((r) => (
                    <tr>
                      <td>{clip(r.label, 40)}</td>
                      <td>{r.people}</td>
                      <td>{r.assignments}</td>
                      <td>{r.complete}</td>
                      <td>{r.inProgress}</td>
                      <td>{r.notStarted}</td>
                      <td>{r.overdue > 0 ? <span class="pill late">{r.overdue}</span> : '0'}</td>
                      <td>
                        {r.key
                          ? <a class="lnk" href={PATH + '?department=' + encodeURIComponent(r.key)}>Open</a>
                          : <span class="muted">No department</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        <div class="card">
          <h2>{departmentLabel ? 'People in ' + departmentLabel : 'People'}</h2>
          {peopleError && (
            <p class="flash warn" role="alert">The list could not be read: {peopleError}.</p>
          )}
          <p class="muted">
            {people.length} shown ·
            {' '}
            <a class="lnk" href={PATH + (departmentId ? '?department=' + encodeURIComponent(departmentId) : '?') + (overdueOnly ? '' : '&overdue=1')}>
              {overdueOnly ? 'Show everybody' : 'Show only people with something overdue'}
            </a>
            {departmentId ? ' · ' : ''}
            {departmentId && <a class="lnk" href={PATH}>Clear the department filter</a>}
          </p>
          {people.length === 0 && !peopleError && (
            <p class="muted" style="margin-top:12px">Nobody in this view has assigned learning.</p>
          )}
          {people.length > 0 && (
            <div class="tablewrap">
              <table>
                <thead>
                  <tr><th>Person</th><th>Department</th><th>Assigned</th><th>Complete</th><th>Overdue</th><th></th></tr>
                </thead>
                <tbody>
                  {people.map((p) => (
                    <tr>
                      <td>
                        {clip(p.name, 40)}
                        {!p.userId && <><br /><span class="pill">No account</span></>}
                      </td>
                      <td>{p.departmentName ? clip(p.departmentName, 30) : '—'}</td>
                      <td>{p.assignments}</td>
                      <td>{p.complete}</td>
                      <td>{p.overdue > 0 ? <span class="pill late">{p.overdue}</span> : '0'}</td>
                      <td><a class="lnk" href={'/admin/learning/person/' + p.employeeId}>Open the record</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </>
    )}
  </div>
</AdminLayout>
