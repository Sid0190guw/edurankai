---
// /admin/learning/catalogue — THE COURSE CATALOGUE, AND WHAT COUNTS AS FINISHING ONE.
//
// THIS IS THE SAME training_courses TABLE the four existing editors write (/admin/hr/training,
// /admin/courses, /admin/aquintutor/courses, /aquintutor/admin/courses). Nothing here creates a
// second catalogue and nothing here may. What it adds is what none of those four can do:
//
//   ARCHIVE INSTEAD OF DELETE. All four offer a hard DELETE and nothing else, and a course row is
//   what every enrolment, completion and certificate points at. Archiving keeps the evidence.
//
//   SAY WHAT COUNTS AS COMPLETE. Until this build, "complete" was hard-coded as 100% of lessons in
//   one player and nothing at all in the other, and training_enrollments.completed_at was written by
//   nothing in the entire repository.
//
// THE GATE IS A CAPABILITY, NEVER A ROLE NAME. The four existing editors gate on
// `user.role === 'applicant'`, which is a role-name test with no key to grant or withhold. This page
// asks `lessons.author` to write, `lessons.publish` to publish or archive, and
// `learning.rules.manage` to change a completion rule — all through can() from
// src/lib/auth/permissions.ts.
//
// EduRankAI is the technology platform; accredited partners award credentials. A course here records
// work done on this platform and claims nothing more.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { can } from '@/lib/auth/permissions';
import { confirmAttr, clip } from '@/lib/page-safety';
import {
  adminCourses,
  createCourse,
  editCourse,
  setCoursePublished,
  setCourseArchived,
  lessonsForCourse,
  createLesson,
  editLesson,
  setCompletionRule,
  completionRuleFor,
  testOptions,
  ACCESS_TYPES,
  COMPLETION_KINDS,
  COMPLETION_KIND_LABELS,
  LEARNING_RULES_MANAGE,
  type AdminCourse,
  type AdminLesson,
  type CompletionRule,
} from '@/lib/learning-admin';

const PATH = '/admin/learning/catalogue';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

// EVERY const ABOVE THE HANDLER. `const` is not hoisted and a const read before its declaration
// throws on the first line of the handler that reads it — that has taken pages down on this project.
const canAuthor = can(user as any, 'lessons.author');
const canPublish = can(user as any, 'lessons.publish');
const canRules = can(user as any, LEARNING_RULES_MANAGE as any);
const canAnything = canAuthor || canPublish || canRules;

const CATEGORIES = ['general', 'technology', 'business', 'design', 'compliance', 'communication', 'hr'];
const LEVELS = ['beginner', 'intermediate', 'advanced'];

const back = (msg: string, courseId?: string) =>
  Astro.redirect(PATH + '?msg=' + encodeURIComponent(msg.slice(0, 400))
    + (courseId ? '&course=' + encodeURIComponent(courseId) : ''));

const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const ruleSentence = (rule: CompletionRule, testTitle: string | null): string => {
  if (rule.kind === 'lessons_viewed') {
    return rule.lessonsPct + '% of the lessons viewed' + (rule.isDefault ? ' (the default — no rule has been set)' : '');
  }
  if (rule.kind === 'mark_threshold') {
    return 'a mark of ' + (rule.markPct === null ? 50 : rule.markPct) + '% or more on '
      + (testTitle || 'the chosen assessment');
  }
  return 'a pass on ' + (testTitle || 'the chosen assessment');
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  const courseId = String(fd.get('course_id') || '');

  if (action === 'create_course') {
    if (!canAuthor) return back('You do not hold the ability to write courses, so nothing was created.');
    const r = await createCourse(String(user.id), {
      title: String(fd.get('title') || ''),
      slug: String(fd.get('slug') || ''),
      category: String(fd.get('category') || ''),
      level: String(fd.get('level') || ''),
      accessType: String(fd.get('access_type') || ''),
    });
    return back(r.ok ? (r.info || 'Course created.') : (r.error || 'Could not create that.'), r.id);
  }

  if (action === 'edit_course') {
    if (!canAuthor) return back('You do not hold the ability to write courses, so nothing was changed.');
    const r = await editCourse(String(user.id), {
      courseId,
      title: String(fd.get('title') || ''),
      category: String(fd.get('category') || ''),
      level: String(fd.get('level') || ''),
      accessType: String(fd.get('access_type') || ''),
    });
    return back(r.ok ? (r.info || 'Course updated.') : (r.error || 'Could not save that.'), courseId);
  }

  if (action === 'publish' || action === 'unpublish') {
    if (!canPublish) return back('You do not hold the ability to publish, so nothing was changed.');
    const r = await setCoursePublished(String(user.id), courseId, action === 'publish');
    return back(r.ok ? (r.info || 'Saved.') : (r.error || 'Could not change that.'), courseId);
  }

  if (action === 'archive' || action === 'unarchive') {
    if (!canPublish) return back('You do not hold the ability to archive a course, so nothing was changed.');
    const r = await setCourseArchived(String(user.id), courseId, action === 'archive');
    return back(r.ok ? (r.info || 'Saved.') : (r.error || 'Could not change that.'), courseId);
  }

  if (action === 'create_lesson') {
    if (!canAuthor) return back('You do not hold the ability to write lessons, so nothing was created.', courseId);
    const r = await createLesson(String(user.id), {
      courseId,
      title: String(fd.get('title') || ''),
      content: String(fd.get('content') || ''),
      sortOrder: String(fd.get('sort_order') || '0'),
    });
    return back(r.ok ? (r.info || 'Lesson added.') : (r.error || 'Could not add that lesson.'), courseId);
  }

  if (action === 'edit_lesson') {
    if (!canAuthor) return back('You do not hold the ability to write lessons, so nothing was changed.', courseId);
    const r = await editLesson(String(user.id), {
      lessonId: String(fd.get('lesson_id') || ''),
      title: String(fd.get('title') || ''),
      content: String(fd.get('content') || ''),
      sortOrder: String(fd.get('sort_order') || '0'),
    });
    return back(r.ok ? (r.info || 'Lesson updated.') : (r.error || 'Could not save that lesson.'), courseId);
  }

  if (action === 'set_rule') {
    if (!canRules) return back('You do not hold the ability to change a completion rule, so nothing was changed.', courseId);
    const r = await setCompletionRule(String(user.id), {
      courseId,
      kind: String(fd.get('kind') || ''),
      lessonsPct: String(fd.get('lessons_pct') || '100'),
      testId: String(fd.get('test_id') || '') || null,
      markPct: String(fd.get('mark_pct') || ''),
    });
    return back(r.ok ? (r.info || 'Rule saved.') : (r.error || 'Could not save that rule.'), courseId);
  }

  return back('That action is not one this page performs.');
}

const params = Astro.url.searchParams;
const msg = String(params.get('msg') || '').slice(0, 400);
const showArchived = params.get('archived') === '1';
const selectedId = String(params.get('course') || '');

let courses: AdminCourse[] = [];
let listError = '';
let lessons: AdminLesson[] = [];
let lessonsError = '';
let selected: AdminCourse | null = null;
let selectedRule: CompletionRule | null = null;
let tests: { id: string; title: string }[] = [];

if (canAnything) {
  const list = await adminCourses({ includeArchived: showArchived });
  courses = list.courses;
  listError = list.ok ? '' : (list.error || '');
  selected = courses.find((c) => c.id === selectedId) || null;
  if (selected) {
    const ls = await lessonsForCourse(selected.id);
    lessons = ls.lessons;
    lessonsError = ls.ok ? '' : (ls.error || '');
    selectedRule = await completionRuleFor(selected.id);
    tests = await testOptions();
  }
}

const testTitleFor = (id: string | null): string | null => {
  if (!id) return null;
  const t = tests.find((x) => x.id === id);
  return t ? t.title : null;
};

// `const`, not the `let` above: TypeScript keeps a narrowing across a closure for a const and drops
// it for a let, and every option list below reads these inside a .map callback.
const sel = selected;
const rule = selectedRule;

const publishedCount = courses.filter((c) => c.isPublished && !c.archivedAt).length;
const blankCount = lessons.filter((l) => !l.hasInlineContent && l.blockCount === 0).length;
const blocksOnlyCount = lessons.filter((l) => !l.hasInlineContent && l.blockCount > 0).length;
---

<AdminLayout title="Learning catalogue" activeNav="courses">
  <style>
    .lc{max-width:1100px;padding:16px 16px 80px;margin:0 auto}
    .lc h1{font-size:21px;font-weight:700;letter-spacing:-.01em;margin:0 0 4px;color:var(--o-hi,#fff)}
    .lc .lede{font-size:13px;line-height:1.6;color:#9aa6b6;margin:0 0 16px;max-width:74ch}
    .lc .flash{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.34);color:#34d399;
      border-radius:10px;padding:11px 13px;font-size:13px;line-height:1.5;margin-bottom:14px;overflow-wrap:anywhere}
    .lc .flash.warn{background:rgba(220,38,38,.1);border-color:rgba(220,38,38,.36);color:#fca5a5}
    .lc .notice{background:rgba(255,79,0,.07);border:1px solid rgba(255,79,0,.26);color:#ffb08a;
      border-radius:11px;padding:12px 14px;font-size:12.5px;line-height:1.6;margin-bottom:12px;max-width:78ch}
    .lc .card{background:var(--o-bg2,#11151c);border:1px solid var(--o-stroke,#1a1a1f);border-radius:14px;
      padding:15px;margin-bottom:13px}
    .lc .card h2{font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.13em;
      text-transform:uppercase;color:#FF7040;font-weight:700;margin:0 0 11px}
    .lc .muted{font-size:12.5px;line-height:1.6;color:#9aa6b6;overflow-wrap:anywhere}
    .lc label{font-family:'Geist Mono',ui-monospace,monospace;font-size:9.5px;letter-spacing:.1em;
      text-transform:uppercase;color:#8a8a94;font-weight:700;display:block;margin:11px 0 4px}
    .lc input,.lc select,.lc textarea{width:100%;background:var(--o-bg0,#08080a);
      border:1px solid var(--o-stroke,#2a2a32);border-radius:9px;padding:10px 12px;font-size:14px;
      font-family:inherit;color:var(--o-hi,#fff);outline:none;min-height:44px;box-sizing:border-box}
    .lc textarea{min-height:96px;resize:vertical;font-size:13px;line-height:1.55}
    .lc input:focus,.lc select:focus,.lc textarea:focus{border-color:#FF4F00}
    .lc .row2{display:grid;grid-template-columns:1fr;gap:9px}
    .lc .btn{background:#FF4F00;color:#fff;border:none;border-radius:10px;padding:11px 17px;font-size:14px;
      font-weight:650;cursor:pointer;font-family:inherit;min-height:44px;margin-top:12px}
    .lc .btn.ghost{background:transparent;color:#c9ccd4;border:1px solid var(--o-stroke,#2a2a32)}
    .lc .btn.slim{padding:9px 13px;font-size:12.5px;margin-top:0;min-height:40px}
    .lc .tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px}
    .lc .tab{flex:none;display:inline-flex;align-items:center;min-height:40px;padding:8px 14px;
      border:1px solid var(--o-stroke,#2a2a32);border-radius:999px;background:transparent;color:#9aa6b6;
      font-size:12.5px;font-weight:600;text-decoration:none;white-space:nowrap}
    .lc .tab[aria-current="page"]{background:#FF4F00;border-color:#FF4F00;color:#fff}
    .lc .tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:10px}
    .lc table{border-collapse:collapse;width:100%;min-width:680px;font-size:13px}
    .lc th{text-align:left;font-family:'Geist Mono',ui-monospace,monospace;font-size:9.5px;
      letter-spacing:.1em;text-transform:uppercase;color:#8a8a94;font-weight:700;padding:8px 10px;
      border-bottom:1px solid var(--o-stroke,#1a1a1f);white-space:nowrap}
    .lc td{padding:10px;border-bottom:1px solid rgba(255,255,255,.05);vertical-align:top;color:#c9ccd4}
    .lc .pill{font-family:'Geist Mono',ui-monospace,monospace;font-size:9px;font-weight:700;padding:3px 8px;
      border-radius:99px;text-transform:uppercase;letter-spacing:.05em;background:rgba(255,255,255,.07);
      color:#9aa6b6;display:inline-block;white-space:nowrap}
    .lc .pill.live{background:rgba(16,185,129,.15);color:#34d399}
    .lc .pill.warn{background:rgba(234,179,8,.15);color:#facc15}
    .lc .pill.off{background:rgba(220,38,38,.13);color:#fca5a5}
    .lc a.lnk{color:#FF7040;text-decoration:none}
    .lc .inline{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
    @media (min-width:760px){ .lc .row2{grid-template-columns:1fr 1fr} }
  </style>

  <div class="lc">
    <h1>Learning catalogue</h1>
    <p class="lede">
      One catalogue, administered. These are the same courses the portal player and the AquinTutor
      runner both read — this screen does not hold a second copy of anything. It adds the two things
      no existing course screen can do: retire a course without destroying the record of who did it,
      and say what finishing it actually means.
    </p>

    <div class="tabs">
      <a class="tab" href={PATH} aria-current="page">Catalogue</a>
      <a class="tab" href="/admin/learning/assign">Assign</a>
      <a class="tab" href="/admin/learning/progress">Progress</a>
    </div>

    {msg && <p class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</p>}

    {!canAnything && (
      <div class="notice">
        <p><b>This is the learning catalogue.</b> You hold the admin console but none of the three
        abilities this screen uses: <code>lessons.author</code> to write a course,
        <code> lessons.publish</code> to publish or archive one, and
        <code> learning.rules.manage</code> to say what counts as completing one.</p>
      </div>
    )}

    {canAnything && (
      <>
        {listError && (
          <p class="flash warn" role="alert">
            The catalogue could not be read: {listError}. That is a failed read, not an empty
            catalogue — nothing below is a complete list.
          </p>
        )}

        <div class="card">
          <h2>Courses</h2>
          <p class="muted">
            {courses.length} shown, {publishedCount} published.
            {' '}
            <a class="lnk" href={PATH + (showArchived ? '' : '?archived=1')}>
              {showArchived ? 'Hide archived' : 'Show archived too'}
            </a>
          </p>

          {courses.length === 0 && !listError && (
            <p class="muted" style="margin-top:12px">
              No courses yet. Create one below; it stays a draft until it is published.
            </p>
          )}

          {courses.length > 0 && (
            <div class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Course</th><th>State</th><th>Who it reaches</th><th>Lessons</th>
                    <th>Enrolled</th><th>Complete</th><th>Counts as complete</th><th></th>
                  </tr>
                </thead>
                <tbody>
                  {courses.map((c) => (
                    <tr>
                      <td>
                        <b style="color:var(--o-hi,#fff)">{clip(c.title, 70)}</b>
                        {c.slug && <><br /><span class="muted" style="font-size:11px">/{c.slug}</span></>}
                      </td>
                      <td>
                        {c.archivedAt
                          ? <span class="pill off">Archived</span>
                          : c.isPublished
                            ? <span class="pill live">Published</span>
                            : <span class="pill">Draft</span>}
                      </td>
                      <td><span class="pill">{c.accessType || 'not set'}</span></td>
                      <td>{c.lessonCount}</td>
                      <td>{c.enrolments}</td>
                      <td>{c.completions}</td>
                      <td class="muted">{COMPLETION_KIND_LABELS[c.rule.kind] || c.rule.kind}{c.rule.isDefault ? ' (default)' : ''}</td>
                      <td>
                        <a class="btn ghost slim" style="display:inline-block;text-decoration:none"
                          href={PATH + '?course=' + c.id + (showArchived ? '&archived=1' : '')}>Open</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {canAuthor && (
          <div class="card">
            <h2>Create a course</h2>
            <form method="post">
              <input type="hidden" name="action" value="create_course" />
              <div class="row2">
                <div>
                  <label for="nt">Title</label>
                  <input id="nt" name="title" required maxlength="200" />
                </div>
                <div>
                  <label for="ns">Web address</label>
                  <input id="ns" name="slug" required maxlength="120" placeholder="fire-safety-basics" />
                </div>
              </div>
              <div class="row2">
                <div>
                  <label for="ncat">Category</label>
                  <select id="ncat" name="category">
                    {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
                  </select>
                </div>
                <div>
                  <label for="nlvl">Level</label>
                  <select id="nlvl" name="level">
                    {LEVELS.map((l) => <option value={l}>{l}</option>)}
                  </select>
                </div>
              </div>
              <label for="nacc">Who it reaches</label>
              <select id="nacc" name="access_type">
                {ACCESS_TYPES.map((a) => <option value={a.value} selected={a.value === 'employees'}>{a.label}</option>)}
              </select>
              <p class="muted" style="margin-top:7px">
                This setting is enforced by the player, not by the assignment picker. A course set to
                <b> Applicants only</b> can still be assigned to an employee, who is then sent back to
                the catalogue when they open it. A course set to <b>Employees only</b> does not appear
                in the public AquinTutor catalogue at all.
              </p>
              <button class="btn" type="submit">Create as a draft</button>
            </form>
          </div>
        )}

        {sel && (
          <>
            <div class="card">
              <h2>{clip(sel.title, 60)}</h2>
              <p class="muted">
                {sel.lessonCount} lessons in {sel.moduleCount} modules ·
                {' ' + sel.enrolments} enrolled · {sel.completions} recorded complete
                {sel.archivedAt ? ' · archived ' + fmtDate(sel.archivedAt) : ''}
              </p>

              {canAuthor && (
                <form method="post" style="margin-top:10px">
                  <input type="hidden" name="action" value="edit_course" />
                  <input type="hidden" name="course_id" value={sel.id} />
                  <label for="et">Title</label>
                  <input id="et" name="title" required maxlength="200" value={sel.title} />
                  <div class="row2">
                    <div>
                      <label for="ecat">Category</label>
                      <select id="ecat" name="category">
                        {CATEGORIES.map((c) => <option value={c} selected={c === sel.category}>{c}</option>)}
                      </select>
                    </div>
                    <div>
                      <label for="elvl">Level</label>
                      <select id="elvl" name="level">
                        {LEVELS.map((l) => <option value={l} selected={l === sel.level}>{l}</option>)}
                      </select>
                    </div>
                  </div>
                  <label for="eacc">Who it reaches</label>
                  <select id="eacc" name="access_type">
                    {ACCESS_TYPES.map((a) => <option value={a.value} selected={a.value === sel.accessType}>{a.label}</option>)}
                  </select>
                  <button class="btn" type="submit">Save</button>
                </form>
              )}

              {canPublish && (
                <div class="inline" style="margin-top:14px">
                  <form method="post">
                    <input type="hidden" name="action" value={sel.isPublished ? 'unpublish' : 'publish'} />
                    <input type="hidden" name="course_id" value={sel.id} />
                    <button class="btn slim ghost" type="submit">
                      {sel.isPublished ? 'Unpublish' : 'Publish'}
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="action" value={sel.archivedAt ? 'unarchive' : 'archive'} />
                    <input type="hidden" name="course_id" value={sel.id} />
                    <button class="btn slim ghost" type="submit"
                      onclick={sel.archivedAt ? null : confirmAttr('Archive "' + sel.title + '"? It is unpublished and hidden from the catalogue. No enrolment, completion or certificate is deleted.')}>
                      {sel.archivedAt ? 'Take out of the archive' : 'Archive'}
                    </button>
                  </form>
                </div>
              )}
              <p class="muted" style="margin-top:11px">
                There is no delete on this screen, deliberately. Every enrolment, completion and
                certificate points at this course row; deleting it destroys the record that people did
                the work. Archiving keeps all of it and takes the course out of circulation.
              </p>
            </div>

            {canRules && rule && (
              <div class="card">
                <h2>What counts as completing this course</h2>
                <p class="muted">
                  Currently: <b style="color:var(--o-hi,#fff)">{ruleSentence(rule, testTitleFor(rule.testId))}</b>.
                  {rule.updatedAt ? ' Last changed ' + fmtDate(rule.updatedAt) + '.' : ''}
                </p>
                <form method="post">
                  <input type="hidden" name="action" value="set_rule" />
                  <input type="hidden" name="course_id" value={sel.id} />
                  <label for="rk">The rule</label>
                  <select id="rk" name="kind">
                    {COMPLETION_KINDS.map((k) => (
                      <option value={k} selected={k === rule.kind}>{COMPLETION_KIND_LABELS[k]}</option>
                    ))}
                  </select>
                  <div class="row2">
                    <div>
                      <label for="rp">Share of lessons required</label>
                      <input id="rp" name="lessons_pct" type="number" min="1" max="100" value={String(rule.lessonsPct)} />
                    </div>
                    <div>
                      <label for="rm">Mark required</label>
                      <input id="rm" name="mark_pct" type="number" min="0" max="100"
                        value={rule.markPct === null ? '' : String(rule.markPct)} />
                    </div>
                  </div>
                  <label for="rt">Assessment</label>
                  <select id="rt" name="test_id">
                    <option value="">None</option>
                    {tests.map((t) => <option value={t.id} selected={t.id === rule.testId}>{clip(t.title, 70)}</option>)}
                  </select>
                  <p class="muted" style="margin-top:7px">
                    Changing this rewrites nobody's record on its own. It changes how the evidence is
                    read the next time a record is recomputed, and every recomputation is audited.
                  </p>
                  <button class="btn" type="submit">Save the rule</button>
                </form>
              </div>
            )}

            <div class="card">
              <h2>Lessons</h2>
              {lessonsError && (
                <p class="flash warn" role="alert">The lessons could not be read: {lessonsError}.</p>
              )}
              {(blankCount > 0 || blocksOnlyCount > 0) && (
                <div class="notice">
                  <p><b>Two editors write two different places, and the players do not agree.</b></p>
                  <p style="margin-top:6px">
                    The portal player at /portal/courses renders the lesson's own text and nothing
                    else. The AquinTutor runner renders authored blocks. On this course
                    {' ' + blocksOnlyCount} lesson{blocksOnlyCount === 1 ? '' : 's'} have blocks but no
                    text, so they render blank in the player an HR assignment links to, and
                    {' ' + blankCount} have neither.
                  </p>
                </div>
              )}
              {lessons.length === 0 && !lessonsError && (
                <p class="muted">No lessons yet. A course with no lessons can never be completed by
                  viewing lessons, whatever the rule says.</p>
              )}
              {lessons.length > 0 && (
                <div class="tablewrap">
                  <table>
                    <thead><tr><th>Order</th><th>Lesson</th><th>Text</th><th>Blocks</th></tr></thead>
                    <tbody>
                      {lessons.map((l) => (
                        <tr>
                          <td>{l.sortOrder}</td>
                          <td>{clip(l.title, 70)}</td>
                          <td>{l.hasInlineContent ? <span class="pill live">Yes</span> : <span class="pill warn">None</span>}</td>
                          <td>{l.blockCount}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {canAuthor && (
                <form method="post" style="margin-top:14px">
                  <input type="hidden" name="action" value="create_lesson" />
                  <input type="hidden" name="course_id" value={sel.id} />
                  <div class="row2">
                    <div>
                      <label for="lt">New lesson title</label>
                      <input id="lt" name="title" required maxlength="200" />
                    </div>
                    <div>
                      <label for="lo">Order</label>
                      <input id="lo" name="sort_order" type="number" min="0" value={String(lessons.length)} />
                    </div>
                  </div>
                  <label for="lcnt">Lesson text</label>
                  <textarea id="lcnt" name="content" maxlength="20000"
                    placeholder="What the learner reads. This is the column the portal player renders."></textarea>
                  <button class="btn" type="submit">Add the lesson</button>
                </form>
              )}
            </div>
          </>
        )}

        {!sel && courses.length > 0 && (
          <p class="muted">Open a course above to edit it, set what counts as completing it, and see
            its lessons.</p>
        )}
      </>
    )}
  </div>
</AdminLayout>
