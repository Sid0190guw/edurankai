---
// /admin/samarth/events - organise SAMARTH events and bring their best participants into SAMARTH X.
//
// Events are platform events tagged 'samarth' (src/lib/samarth/events.ts): created here, then fully
// edited (levels, fees, certificates, registrations) in the existing event editor /admin/events/<id>,
// with registration open at /events/register/<slug>. Gated on either SAMARTH section; creating an
// event needs edit on one of them, nominating into SAMARTH X needs edit on samarth_x.
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { listSamarthEvents, createSamarthEvent, registrantsFor, nominateRegistrants, SAMARTH_EVENT_KINDS, eventKindLabel } from '@/lib/samarth/events';
import { isUuid } from '@/lib/samarth/store-core';
import { COMMON_TIME_ZONES } from '@/lib/samarth/validate';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const desk = await canAccessSection(user, 'samarth', 'view');
const xDesk = await canAccessSection(user, 'samarth_x', 'view');
if (!desk && !xDesk) return Astro.redirect('/admin?denied=samarth');
const PAGE = '/admin/samarth/events';
const mayCreate = (await canAccessSection(user, 'samarth', 'edit')) || (await canAccessSection(user, 'samarth_x', 'edit'));
const mayNominate = await canAccessSection(user, 'samarth_x', 'edit');
const who = { userId: user.id, name: user.name || user.email || 'SAMARTH team' };
const done = (m: string, ok = true, extra = '') => Astro.redirect(PAGE + '?' + (ok ? 'msg=' : 'err=') + encodeURIComponent(m.slice(0, 600)) + extra);

if (Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const get = (n: string) => String(fd.get(n) ?? '');
  const action = get('action');
  if (action === 'create') {
    if (!mayCreate) return done('Creating an event needs edit rights on a SAMARTH desk.', false);
    const r = await createSamarthEvent({
      title: get('title'), kind: get('kind'), description: get('description'), longDescription: get('long_description'), mode: get('mode'),
      status: get('publish') === 'yes' ? 'upcoming' : 'draft', startsAt: get('starts_at'), endsAt: get('ends_at'), location: get('location'), capacity: get('capacity'), timezone: get('timezone'),
    }, who);
    return r.ok ? done('Event created' + (get('publish') === 'yes' ? ' and published' : ' as a draft') + '. Add levels, fees or certificates in the event editor if you need them.', true, '&event=' + r.id) : done(r.error, false);
  }
  if (action === 'nominate') {
    if (!mayNominate) return done('Nominating into SAMARTH X needs edit rights on the SAMARTH X desk.', false);
    const eventId = get('event_id');
    if (!isUuid(eventId)) return done('Choose an event.', false);
    const ids = fd.getAll('registration').map(String);
    if (!ids.length) return done('Tick the participants to nominate.', false, '&event=' + eventId);
    const r = await nominateRegistrants(eventId, ids, who);
    const parts = [r.added.length + ' nominated into SAMARTH X' + (r.added.length ? ' (' + r.added.join(', ') + ')' : '')];
    if (r.skipped) parts.push(r.skipped + ' already nominated, skipped');
    if (r.failed.length) parts.push('not nominated: ' + r.failed.join('; '));
    return done(parts.join('. ') + '.', !r.failed.length, '&event=' + eventId);
  }
  return done('Unknown action.', false);
}

const events = await listSamarthEvents(false);
const focusId = Astro.url.searchParams.get('event') || '';
const focus = events.ready ? events.value.find((e) => e.id === focusId) || null : null;
const regs = focus ? await registrantsFor(focus.id) : null;
const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString('en-GB', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' IST' : 'Not set');
const STATUS_TONE: Record<string, string> = { upcoming: 'sa-chip ok', draft: 'sa-chip', past: 'sa-chip', cancelled: 'sa-chip bad' };
---
<AdminFrame title="SAMARTH events" active="events" showX={xDesk} showDesk={desk} msg={Astro.url.searchParams.get('msg') || ''} err={Astro.url.searchParams.get('err') || ''}>
  <p class="sa-lede">Hackathons, AI challenges, competitions, technology and research events, and institutional programmes. Each is a normal platform event tagged for SAMARTH: it gets its own public page and registration, and its levels, fees and certificates are edited in the event editor. Outstanding participants can be nominated into the SAMARTH X evaluation pipeline from here. Published events appear on <a href="/samarth/events">/samarth/events</a> and <a href="/events">/events</a>.</p>

  {!events.ready && <div class="sa-flash warn">{events.error}</div>}

  {events.ready && events.value.length === 0 && <div class="sa-empty">No SAMARTH events yet. Create the first one below.</div>}
  {events.ready && events.value.length > 0 && (
    <div class="sa-scroll"><table class="sa-table">
      <thead><tr><th>Event</th><th>Kind</th><th>When</th><th>Status</th><th>Registered</th><th></th></tr></thead>
      <tbody>{events.value.map((e) => (
        <tr>
          <td><strong style="color:#fff;">{e.title}</strong><br /><span class="hint">{e.mode.replace('_', ' ')}{e.location ? ' · ' + e.location : ''}{e.capacity ? ' · capacity ' + e.capacity : ''}</span></td>
          <td class="hint">{eventKindLabel(e.tags)}</td>
          <td class="hint">{when(e.startsAt)}</td>
          <td><span class={STATUS_TONE[e.status] || 'sa-chip'}>{e.status}</span></td>
          <td>{e.registrations}</td>
          <td style="white-space:nowrap;"><a href={PAGE + '?event=' + e.id}>Participants</a> · <a href={'/admin/events/' + e.id}>Edit</a> · <a href={'/events/' + e.slug} target="_blank" rel="noopener">Page</a></td>
        </tr>
      ))}</tbody>
    </table></div>
  )}

  {focus && (
    <section class="sa-panel" style="margin-top:14px;" id="participants">
      <h2 class="sa-h2">{focus.title}: participants</h2>
      <p class="hint" style="margin:0 0 10px;">Registration link to share: <a href={'/events/register/' + focus.slug} target="_blank" rel="noopener">/events/register/{focus.slug}</a>{focus.status === 'draft' ? ' (publish the event in the editor first)' : ''}. Nominating creates a SAMARTH X candidate in the event channel; a reviewer then assesses them. Nobody is admitted by being nominated.</p>
      {regs && !regs.ready && <div class="sa-flash warn">{regs.error}</div>}
      {regs && regs.ready && regs.value.length === 0 && <p class="hint">Nobody has registered yet.</p>}
      {regs && regs.ready && regs.value.length > 0 && (
        <form method="POST">
          <input type="hidden" name="action" value="nominate" /><input type="hidden" name="event_id" value={focus.id} />
          <div class="sa-scroll"><table class="sa-table">
            <thead><tr><th>Nominate</th><th>Participant</th><th>Institution</th><th>Registered</th><th>SAMARTH X</th></tr></thead>
            <tbody>{regs.value.map((r) => (
              <tr>
                <td>{r.nominatedRef ? '' : <input type="checkbox" name="registration" value={r.id} disabled={!mayNominate} aria-label={'Nominate ' + r.name} />}</td>
                <td>{r.name}<br /><span class="hint">{r.email}</span></td>
                <td class="hint">{r.institution || '-'}{r.city ? ', ' + r.city : ''}</td>
                <td class="hint">{(r.createdAt || '').slice(0, 10)}</td>
                <td>{r.nominatedRef ? <span class="sa-chip ok">{r.nominatedRef}</span> : <span class="hint">Not nominated</span>}</td>
              </tr>
            ))}</tbody>
          </table></div>
          {mayNominate && <button class="sa-btn" type="submit" style="margin-top:10px;">Nominate ticked participants into SAMARTH X</button>}
        </form>
      )}
    </section>
  )}

  {mayCreate && (
    <section class="sa-panel" style="margin-top:14px;">
      <h2 class="sa-h2">Organise a SAMARTH event</h2>
      <form method="POST" class="sa-form">
        <input type="hidden" name="action" value="create" />
        <div class="sa-row">
          <label>Title<input type="text" name="title" required maxlength="300" placeholder="For example SAMARTH AI Systems Challenge 2027" /></label>
          <label>Kind<select name="kind" required>{SAMARTH_EVENT_KINDS.map((k) => <option value={k.value}>{k.label}</option>)}</select></label>
          <label>Mode<select name="mode"><option value="online">Online</option><option value="in_person">In person</option><option value="hybrid">Hybrid</option></select></label>
        </div>
        <div class="sa-row">
          <label>Starts<input type="datetime-local" name="starts_at" required /></label>
          <label>Ends (optional)<input type="datetime-local" name="ends_at" /></label>
          <label>Location (optional)<input type="text" name="location" maxlength="300" placeholder="City and venue, or Online" /></label>
          <label>Capacity (optional)<input type="number" name="capacity" min="1" /></label>
          <label>Times are in<select name="timezone">{COMMON_TIME_ZONES.map((z) => <option value={z} selected={z === 'Asia/Kolkata'}>{z}</option>)}</select></label>
        </div>
        <label>Short description<textarea name="description" required maxlength="2000" placeholder="One or two sentences shown in event listings"></textarea></label>
        <label>Full description (optional)<textarea name="long_description" maxlength="20000" style="min-height:140px;" placeholder="Themes, eligibility, format, judging, what participants receive, how the best are considered for SAMARTH X"></textarea></label>
        <label class="sa-check"><input type="checkbox" name="publish" value="yes" /> Publish now (otherwise saved as a draft)</label>
        <button class="sa-btn" type="submit">Create event</button>
      </form>
    </section>
  )}
</AdminFrame>
