---
// /admin/samarth/search - one search over every SAMARTH record the administrator may see:
// consultation requests, engagements and partners (samarth section) and SAMARTH X (samarth_x).
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { searchAll } from '@/lib/samarth/stats';
import { statusLabel } from '@/lib/samarth/workflow';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const desk = await canAccessSection(user, 'samarth', 'view');
const xDesk = await canAccessSection(user, 'samarth_x', 'view');
if (!desk && !xDesk) return Astro.redirect('/admin?denied=samarth');
const q = (Astro.url.searchParams.get('q') || '').trim();
const res = await searchAll(q, { samarth: desk, x: xDesk });
const hits = res.ready ? res.value : [];
const KIND: Record<string, { label: string; base: string; machine: 'application' | 'engagement' | 'partner' | 'x' }> = {
  application: { label: 'Consultation request', base: '/admin/samarth/applications/', machine: 'application' },
  engagement: { label: 'Engagement', base: '/admin/samarth/engagements/', machine: 'engagement' },
  partner: { label: 'Partner', base: '/admin/samarth/partners/', machine: 'partner' },
  x: { label: 'SAMARTH X', base: '/admin/samarth/x/', machine: 'x' },
};
---
<AdminFrame title="Search SAMARTH" active="search" showX={xDesk} showDesk={desk}>
  <form method="GET" class="sa-inline" style="margin-bottom:14px;">
    <input type="search" name="q" value={q} placeholder="Reference, name, email, organisation, department, order id" aria-label="Search" style="flex:1;min-width:240px;" autofocus />
    <button class="sa-btn" type="submit">Search</button>
  </form>
  <p class="hint">Searches every record you may see{!xDesk ? ' (SAMARTH X is not included: you do not hold that section)' : ''}{!desk ? ' (only SAMARTH X: you do not hold the SAMARTH section)' : ''}. Up to 25 results of each kind, newest first.</p>
  {!res.ready && <div class="sa-flash warn">{res.error}</div>}
  {q.length > 0 && q.length < 2 && <p class="hint">Type at least two characters.</p>}
  {q.length >= 2 && res.ready && hits.length === 0 && <div class="sa-empty">Nothing matches "{q}".</div>}
  {hits.length > 0 && (
    <div class="sa-scroll"><table class="sa-table">
      <thead><tr><th>Kind</th><th>Reference</th><th>Name</th><th>Detail</th><th>Status</th><th>Created</th></tr></thead>
      <tbody>{hits.map((h) => (
        <tr>
          <td class="hint">{KIND[h.kind].label}</td>
          <td><a href={KIND[h.kind].base + h.id}>{h.ref}</a></td>
          <td>{h.title}</td>
          <td class="hint">{h.detail}</td>
          <td><span class="sa-chip">{statusLabel(KIND[h.kind].machine, h.status)}</span></td>
          <td class="hint">{(h.createdAt || '').slice(0, 10)}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}
</AdminFrame>
