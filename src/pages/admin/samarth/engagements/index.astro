---
// /admin/samarth/engagements - every quotation and engagement after a consultation. Search and
// filters run in SQL over all of them.
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { listEngagements } from '@/lib/samarth/engagements';
import { ENGAGEMENT_STATUSES, ENGAGEMENT_KINDS, statusLabel, engagementKindLabel, isContracted } from '@/lib/samarth/workflow';
import { formatMoney } from '@/lib/samarth/currency';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!(await canAccessSection(user, 'samarth', 'view'))) return Astro.redirect('/admin?denied=samarth');
const xDesk = await canAccessSection(user, 'samarth_x', 'view');
const u = Astro.url.searchParams;
const f = { q: u.get('q') || '', status: u.get('status') || '', kind: u.get('kind') || '', cursor: u.get('cursor') || '' };
const list = await listEngagements({ ...f, limit: 50 });
const items = list.ready ? list.value.items : [];
const next = list.ready ? list.value.next : null;
const more = (cursor: string) => '?' + new URLSearchParams(Object.entries({ ...f, cursor }).filter(([, v]) => v) as [string, string][]).toString();
---
<AdminFrame title="Engagements and quotations" active="engagements" showX={xDesk} msg={u.get('msg') || ''} err={u.get('err') || ''}>
  <p class="sa-lede">Consultancy packages, engineering, government proposals, infrastructure, technology transfer, implementation and support: each its own quotation, approved internally with a note, then accepted or declined by the client. Draft a new one from a consultation request.</p>
  <form method="GET" class="sa-panel sa-form">
    <div class="sa-row">
      <label>Search<input type="search" name="q" value={f.q} placeholder="Reference, title, client, award reference" /></label>
      <label>Status<select name="status"><option value="">Any</option>{ENGAGEMENT_STATUSES.map((s) => <option value={s.value} selected={f.status === s.value}>{s.label}</option>)}</select></label>
      <label>Kind<select name="kind"><option value="">Any</option>{ENGAGEMENT_KINDS.map((k) => <option value={k.value} selected={f.kind === k.value}>{k.label}</option>)}</select></label>
    </div>
    <div class="sa-inline"><button class="sa-btn" type="submit">Apply</button><a class="sa-btn ghost" href="/admin/samarth/engagements">Clear</a></div>
  </form>
  {!list.ready && <div class="sa-flash warn">{list.error}</div>}
  {list.ready && items.length === 0 && <div class="sa-empty">No engagements match. Quotations are drafted from a consultation request once a consultant is assigned.</div>}
  {items.length > 0 && (
    <div class="sa-scroll"><table class="sa-table">
      <thead><tr><th>Engagement</th><th>Client</th><th>Status</th><th>Total</th><th>Payment</th></tr></thead>
      <tbody>{items.map((e) => (
        <tr>
          <td><a href={'/admin/samarth/engagements/' + e.id}><strong>{e.ref}</strong></a><br />{e.title}<br /><span class="hint">{engagementKindLabel(e.kind)}</span></td>
          <td>{e.client}<br /><span class="hint">{e.appRef}</span></td>
          <td><span class="sa-chip">{statusLabel('engagement', e.status)}</span>{isContracted(e.status, e.awardReference, e.paymentState === 'paid') && <span class="sa-chip ok" style="margin-left:4px;">Contracted</span>}</td>
          <td>{e.totalMinor ? formatMoney(e.totalMinor, e.currency) : '-'}</td>
          <td>{e.paymentState === 'paid' ? 'Paid' : e.paymentState === 'pending' ? 'Due' : '-'}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}
  {next && <p style="margin-top:12px;"><a class="sa-btn ghost" href={more(next)}>Older</a></p>}
</AdminFrame>
