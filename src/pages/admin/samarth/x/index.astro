---
// /admin/samarth/x - SAMARTH X: every candidate from all three channels in one pipeline, staff entry
// for event nominations and recruitment referrals, and the advisory best-six ranking per cohort.
// Gated on the `samarth_x` section.
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { listX, parseX, createX, X_DOMAINS } from '@/lib/samarth/x';
import { rankForIncubation, MAX_TOTAL } from '@/lib/samarth/x-scoring';
import { X_STATUSES, X_CHANNELS, INCUBATION_PLACES, statusLabel } from '@/lib/samarth/workflow';
import { countryOptions, countryName } from '@/lib/samarth/validate';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!(await canAccessSection(user, 'samarth_x', 'view'))) return Astro.redirect('/admin?denied=samarth_x');
const PAGE = '/admin/samarth/x';
const mayWrite = await canAccessSection(user, 'samarth_x', 'edit');
const desk = await canAccessSection(user, 'samarth', 'view');
const COUNTRIES = countryOptions();
const who = { userId: user.id, name: user.name || user.email || 'SAMARTH team' };

if (Astro.request.method === 'POST') {
  if (!mayWrite) return Astro.redirect(PAGE + '?err=' + encodeURIComponent('Needs the SAMARTH X edit permission.'));
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const get = (n: string) => String(fd.get(n) ?? '');
  const channel = get('channel') === 'recruitment' ? 'recruitment' : 'event';
  const p = parseX(get, true);
  if (p.problems.length) return Astro.redirect(PAGE + '?err=' + encodeURIComponent(p.problems.join(' ')));
  const r = await createX(p.value, channel, who);
  return Astro.redirect(r.ok ? '/admin/samarth/x/' + r.id + '?msg=' + encodeURIComponent('Added ' + r.ref + ' to the evaluation pipeline.') : PAGE + '?err=' + encodeURIComponent(r.error));
}

const u = Astro.url.searchParams;
const f = { q: u.get('q') || '', status: u.get('status') || '', channel: u.get('channel') || '', cohort: u.get('cohort') || '', cursor: u.get('cursor') || '' };
const list = await listX({ ...f, limit: 60 });
const items = list.ready ? list.value.items : [];
const ranked = f.cohort ? rankForIncubation(items.filter((c) => ['SHORTLISTED', 'SELECTED', 'INCUBATING'].includes(c.status)).map((c) => ({ ...c, createdAt: c.createdAt || '' })), INCUBATION_PLACES) : [];
const incubating = f.cohort ? items.filter((c) => c.status === 'INCUBATING').length : 0;
const more = (cursor: string) => '?' + new URLSearchParams(Object.entries({ ...f, cursor }).filter(([, v]) => v) as [string, string][]).toString();
---
<AdminFrame title="SAMARTH X" active="x" showDesk={desk} eyebrow="SAMARTH X · Venture building and incubation" msg={u.get('msg') || ''} err={u.get('err') || ''}>
  <p class="sa-lede">Expressions of interest, event nominations and recruitment referrals in one evaluation pipeline. No fee at any stage. The best six ventures per cohort may enter formal incubation once a written agreement is recorded. Rankings are advisory; a person decides.</p>
  <form method="GET" class="sa-panel sa-form">
    <div class="sa-row">
      <label>Search<input type="search" name="q" value={f.q} placeholder="Reference, name, venture, problem, event" /></label>
      <label>Status<select name="status"><option value="">Any</option>{X_STATUSES.map((s) => <option value={s.value} selected={f.status === s.value}>{s.label}</option>)}</select></label>
      <label>Channel<select name="channel"><option value="">Any</option>{X_CHANNELS.map((c) => <option value={c.value} selected={f.channel === c.value}>{c.label}</option>)}</select></label>
      <label>Cohort<input type="text" name="cohort" value={f.cohort} placeholder="For example 2027-A" /></label>
    </div>
    <div class="sa-inline"><button class="sa-btn" type="submit">Apply</button><a class="sa-btn ghost" href={PAGE}>Clear</a></div>
  </form>

  {f.cohort && (
    <section class="sa-panel">
      <h2 class="sa-h2">Cohort {f.cohort}: incubation places {incubating} of {INCUBATION_PLACES} taken</h2>
      <p class="hint" style="margin:0 0 8px;">Advisory order by mean reviewer score (out of {MAX_TOTAL}). The top {INCUBATION_PLACES} with reviews are marked; nothing moves without a person.</p>
      {ranked.length === 0 && <p class="hint">No shortlisted, selected or incubating candidates in this cohort yet.</p>}
      {ranked.length > 0 && <div class="sa-scroll"><table class="sa-table"><tbody>{ranked.map((c) => <tr><td>{c.rank}</td><td><a href={'/admin/samarth/x/' + c.id}>{c.ventureName || c.name}</a></td><td>{c.mean ?? 'No reviews'}</td><td>{c.reviews} review(s)</td><td>{statusLabel('x', c.status)}</td><td>{c.inTopPlaces ? <span class="sa-chip ok">Top {INCUBATION_PLACES}</span> : ''}</td></tr>)}</tbody></table></div>}
    </section>
  )}

  {!list.ready && <div class="sa-flash warn">{list.error}</div>}
  {list.ready && items.length === 0 && <div class="sa-empty">No candidates match. Public applications arrive from /samarth/x/apply; add nominations and referrals below.</div>}
  {items.length > 0 && (
    <div class="sa-scroll"><table class="sa-table">
      <thead><tr><th>Candidate</th><th>Channel</th><th>Domain</th><th>Status</th><th>Reviews</th><th>Cohort</th></tr></thead>
      <tbody>{items.map((c) => (
        <tr>
          <td><a href={'/admin/samarth/x/' + c.id}><strong>{c.ventureName || c.name}</strong></a><br /><span class="hint">{c.ref} · {c.name}{c.applicantKind === 'team' ? ' (team of ' + (c.team.length + 1) + ')' : ''} · {countryName(c.country)}</span></td>
          <td class="hint">{X_CHANNELS.find((x) => x.value === c.channel)?.label}{c.sourceEvent ? ': ' + c.sourceEvent : ''}</td>
          <td class="hint">{c.domain || '-'}</td>
          <td><span class={c.status === 'INCUBATING' ? 'sa-chip ok' : c.status === 'SHORTLISTED' || c.status === 'SELECTED' ? 'sa-chip hot' : 'sa-chip'}>{statusLabel('x', c.status)}</span></td>
          <td>{c.reviews ? c.reviews + ' · mean ' + c.mean : '-'}</td>
          <td class="hint">{c.cohort || '-'}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}
  {list.ready && list.value.next && <p style="margin-top:12px;"><a class="sa-btn ghost" href={more(list.value.next)}>Older</a></p>}

  {mayWrite && (
    <details class="sa-panel" style="margin-top:14px;">
      <summary>Add an event nomination or a recruitment referral</summary>
      <form method="POST" class="sa-form" style="margin-top:12px;">
        <div class="sa-row">
          <label>Channel<select name="channel"><option value="event">Event or competition</option><option value="recruitment">Recruitment</option></select></label>
          <label>Name<input type="text" name="name" required maxlength="200" /></label>
          <label>Email<input type="email" name="email" required maxlength="254" /></label>
          <label>Country<select name="country" required><option value="">Choose</option>{COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}</select></label>
        </div>
        <div class="sa-row">
          <label>Event, competition or source<input type="text" name="source_event" maxlength="300" placeholder="For example the hackathon name" /></label>
          <label>Reference (event entry or recruitment application id)<input type="text" name="source_reference" maxlength="300" /><span class="hint">Recruitment and venture decisions stay separate; this is only a pointer.</span></label>
          <label>Nominated by<input type="text" name="nominated_by" maxlength="200" value={who.name} /></label>
          <label>Domain<select name="domain"><option value="">Choose</option>{X_DOMAINS.map((d) => <option value={d}>{d}</option>)}</select></label>
        </div>
        <label>What they are working on<textarea name="problem" required maxlength="4000"></textarea></label>
        <label>Proposed system (optional)<textarea name="proposed_system" maxlength="4000"></textarea></label>
        <div class="sa-row"><label>Code repository (optional)<input type="url" name="github_url" maxlength="800" /></label><label>Prototype (optional)<input type="url" name="prototype_url" maxlength="800" /></label></div>
        <button class="sa-btn" type="submit">Add to the pipeline</button>
      </form>
    </details>
  )}
</AdminFrame>
