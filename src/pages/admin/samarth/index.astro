---
// /admin/samarth - the SAMARTH overview: pipeline, revenue, distribution, readiness and the module
// register. Gated on the `samarth` section (src/lib/admin-sections.ts; middleware PATH_SECTION),
// which no built-in role below super admin holds.
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { overview } from '@/lib/samarth/stats';
import { readiness } from '@/lib/samarth/payments';
import { approvedFees, waitingForFee } from '@/lib/samarth/fees';
import { MODULES, moduleCounts } from '@/lib/samarth/registry';
import { APPLICATION_STATUSES, ENGAGEMENT_STATUSES, PARTNER_STATUSES, X_STATUSES } from '@/lib/samarth/workflow';
import { categoryLabel, governmentLevelLabel } from '@/lib/samarth/categories';
import { formatMoney } from '@/lib/samarth/currency';
import { countryName } from '@/lib/samarth/validate';
import { pathwayById } from '@/lib/samarth/pathways';
import SegmentBar from '@/components/samarth/SegmentBar.astro';
import StageColumns from '@/components/samarth/StageColumns.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const desk = await canAccessSection(user, 'samarth', 'view');
const xDesk = await canAccessSection(user, 'samarth_x', 'view');
if (!desk && !xDesk) return Astro.redirect('/admin?denied=samarth');
if (!desk) return Astro.redirect('/admin/samarth/x');

const stats = await overview({ samarth: desk, x: xDesk });
const ready = await readiness();
const fees = await approvedFees();
const waiting = await waitingForFee();
const counts = moduleCounts();
const s = stats.ready ? stats.value : null;
const sum = (m: Record<string, number> | undefined) => Object.values(m || {}).reduce((a, b) => a + b, 0);
const chip = (ok: boolean) => (ok ? 'sa-chip ok' : 'sa-chip warn');
// The pipeline in workflow order, coloured by phase from a validated four-step ordinal blue ramp
// (dataviz validator: monotone lightness, visible gaps, light end >= 2:1 on the #0f0f14 panel).
const PIPELINE_PHASES = [
  { key: 'intake', label: 'Intake', color: '#184f95' },
  { key: 'fee', label: 'Booking fee', color: '#3987e5' },
  { key: 'call', label: 'Consultation call', color: '#6da7ec' },
  { key: 'done', label: 'Completed', color: '#b7d3f6' },
];
const PHASE_OF: Record<string, string> = {
  DRAFT: 'intake', DETAILS_COMPLETE: 'intake', REQUIREMENTS_COMPLETE: 'intake',
  FEE_PENDING: 'fee', FEE_PAID: 'fee',
  BOOKING_REQUESTED: 'call', CONSULTANT_ASSIGNED: 'call', CALL_SCHEDULED: 'call',
  CALL_COMPLETED: 'done', CLOSED: 'done',
};
const pipelineStages = s ? APPLICATION_STATUSES.filter((st) => PHASE_OF[st.value]).map((st) => ({
  key: st.value, label: st.label, value: s!.applicationsByStatus[st.value] || 0, phase: PHASE_OF[st.value],
  href: '/admin/samarth/applications?status=' + st.value,
})) : [];
const closedStatuses = APPLICATION_STATUSES.filter((st) => !PHASE_OF[st.value]);
const closedCount = s ? closedStatuses.reduce((n, st) => n + (s!.applicationsByStatus[st.value] || 0), 0) : 0;
const closedSummary = s ? closedStatuses.map((st) => st.label.toLowerCase() + ' ' + (s!.applicationsByStatus[st.value] || 0)).join(', ') : '';
---
<AdminFrame title="SAMARTH overview" active="overview" showX={xDesk} eyebrow="SAMARTH · Research, consulting, engineering and venture building">
  <p class="sa-lede">Every consultation request, quotation, partner and SAMARTH X application, in one place. Figures are read live from the SAMARTH tables and the shared payments ledger.</p>
  <form method="GET" action="/admin/samarth/search" class="sa-inline" style="margin-bottom:14px;">
    <input type="search" name="q" placeholder="Search every SAMARTH record: reference, name, email, organisation, department, order id" aria-label="Search SAMARTH" style="flex:1;min-width:240px;" />
    <button class="sa-btn" type="submit">Search</button>
  </form>

  {!stats.ready && <div class="sa-flash warn">{stats.error}</div>}

  <section class="sa-panel">
    <h2 class="sa-h2">Readiness</h2>
    <div class="sa-scroll"><table class="sa-table">
      <tbody>
        <tr><td>Payment gateway connected</td><td><span class={chip(ready.gatewayConnected)}>{ready.gatewayConnected ? 'Connected (' + (ready.keyMode === 'test' ? 'test key' : 'live key') + ')' : 'Not configured'}</span></td><td class="hint">Razorpay keys in the deployment environment. Never shown here.</td></tr>
        <tr><td>Webhook secret</td><td><span class={chip(ready.webhookSecret)}>{ready.webhookSecret ? 'Set' : 'Missing'}</span></td><td class="hint">Without it a payment confirms only through the browser return or reconciliation.</td></tr>
        <tr><td>Sandbox-tested</td><td><span class={chip(ready.sandboxTested)}>{ready.sandboxTested ? 'Yes' : 'Not yet'}</span></td><td class="hint">At least one SAMARTH payment captured with a test key.</td></tr>
        <tr><td>Production-verified</td><td><span class={chip(ready.productionVerified)}>{ready.productionVerified ? 'Yes' : 'Not yet'}</span></td><td class="hint">At least one SAMARTH payment captured with a live key.</td></tr>
        <tr><td>Online booking-fee checkout</td><td><span class={ready.feeCheckoutOn ? 'sa-chip ok' : 'sa-chip'}>{ready.feeCheckoutOn ? 'On' : 'Off'}</span></td><td class="hint">Feature flag samarthFeeCheckout at <a href="/admin/feature-flags">Feature flags</a>. Off: payment against an invoice.</td></tr>
        <tr><td>Online engagement checkout</td><td><span class={ready.engagementCheckoutOn ? 'sa-chip ok' : 'sa-chip'}>{ready.engagementCheckoutOn ? 'On' : 'Off'}</span></td><td class="hint">Feature flag samarthEngagementCheckout.</td></tr>
        <tr><td>Published booking fees</td><td><span class={chip(fees.ready && fees.value.length > 0)}>{fees.ready ? fees.value.length + ' approved' : 'Unreadable'}</span></td><td class="hint">No fee is ever assumed. <a href="/admin/samarth/fees">Set and approve fees</a>.</td></tr>
        <tr><td>Outgoing mail</td><td><span class={chip(ready.mailConfigured)}>{ready.mailConfigured ? 'Configured' : 'Not confirmed'}</span></td><td class="hint">Applicants also see every link and update on screen.</td></tr>
      </tbody>
    </table></div>
    {waiting.ready && waiting.value.length > 0 && (
      <div class="sa-flash warn" style="margin-top:12px;">Waiting for a published fee: {waiting.value.map((w) => categoryLabel(w.category) + ' (' + w.count + ')').join(', ')}. These applicants cannot book until a fee for their category is approved.</div>
    )}
  </section>

  {s && (
    <div>
      <div class="sa-tiles">
        <a class="sa-tile" href="/admin/samarth/applications"><span class="v">{sum(s.applicationsByStatus)}</span><span class="l">Consultation requests</span></a>
        <a class="sa-tile" href="/admin/samarth/applications?status=BOOKING_REQUESTED"><span class="v">{s.applicationsByStatus['BOOKING_REQUESTED'] || 0}</span><span class="l">Need a consultant</span></a>
        <a class="sa-tile" href="/admin/samarth/applications?status=FEE_PENDING"><span class="v">{s.applicationsByStatus['FEE_PENDING'] || 0}</span><span class="l">Booking fee due</span></a>
        <a class="sa-tile" href="/admin/samarth/engagements"><span class="v">{sum(s.engagementsByStatus)}</span><span class="l">Engagements</span></a>
        <a class="sa-tile" href="/admin/samarth/partners"><span class="v">{sum(s.partnersByStatus)}</span><span class="l">Partners</span></a>
        {xDesk && <a class="sa-tile" href="/admin/samarth/x"><span class="v">{sum(s.xByStatus)}</span><span class="l">SAMARTH X</span></a>}
        <div class="sa-tile"><span class="v">{s.last30}</span><span class="l">New requests, 30 days</span></div>
      </div>

      <div class="sa-money">
        <div class="sa-tile money"><span class="v">{formatMoney(s.gatewayPaise.fee, 'INR')}</span><span class="l">Booking fees received online</span></div>
        <div class="sa-tile money"><span class="v">{formatMoney(s.gatewayPaise.engagement, 'INR')}</span><span class="l">Engagements paid online</span></div>
        <div class="sa-tile money"><span class="v">{s.offline.length ? s.offline.map((o) => formatMoney(o.feeMinor, o.currency || 'INR')).join(' + ') : formatMoney(0, 'INR')}</span><span class="l">Booking fees recorded offline{s.offline.length ? ' (' + s.offline.reduce((n, o) => n + o.count, 0) + ')' : ''}</span></div>
        <div class="sa-tile money"><span class="v">{s.gatewayPaise.refundedCount}</span><span class="l">Online payments refunded</span></div>
      </div>
      <p class="hint" style="margin:-4px 0 14px;">Online figures are captured, non-refunded gateway payments in rupees. Refunds are issued from <a href="/admin/finance">Finance</a>.</p>

      <section class="sa-panel">
        <h2 class="sa-h2">Consultation pipeline</h2>
        <p class="hint" style="margin:0 0 12px;">Every open request by its current stage, left to right in workflow order. Select a column to see those requests.{closedCount ? ' Closed out: ' + closedSummary + '.' : ''}</p>
        <StageColumns stages={pipelineStages} phases={PIPELINE_PHASES} caption="Consultation requests by stage" />
      </section>

      <div class="sa-grid2">
        <section class="sa-panel">
          <h2 class="sa-h2">Who is applying</h2>
          <SegmentBar tall parts={s.applicationsByCategory.map((x) => ({ label: categoryLabel(x.key), value: x.n }))} caption="Applicants by category" />
          <h2 class="sa-h2" style="margin-top:18px;">Government and public bodies, by level</h2>
          <SegmentBar parts={s.officialByLevel.map((x) => ({ label: governmentLevelLabel(x.key) || 'Not stated', value: x.n }))} caption="Official applicants by level of government" />
        </section>
        <section class="sa-panel">
          <h2 class="sa-h2">Where they are</h2>
          <SegmentBar tall parts={s.applicationsByCountry.map((x) => ({ label: countryName(x.key), value: x.n }))} caption="Applicants by country" />
          <h2 class="sa-h2" style="margin-top:18px;">Kinds of project</h2>
          <SegmentBar parts={s.applicationsByPathway.map((x) => ({ label: pathwayById(x.key)?.label || 'Not chosen yet', value: x.n }))} caption="Requests by kind of project" />
        </section>
      </div>

      <div class="sa-grid2">
        <section class="sa-panel">
          <h2 class="sa-h2">Engagements</h2>
          {ENGAGEMENT_STATUSES.filter((st) => s!.engagementsByStatus[st.value]).map((st) => <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;"><a href={'/admin/samarth/engagements?status=' + st.value}>{st.label}</a><span style="color:#fff;">{s!.engagementsByStatus[st.value]}</span></div>)}
          {sum(s.engagementsByStatus) === 0 && <p class="hint">No quotations yet. They are drafted from a consultation request after the call.</p>}
          <h2 class="sa-h2" style="margin-top:14px;">Partners</h2>
          {PARTNER_STATUSES.filter((st) => s!.partnersByStatus[st.value]).map((st) => <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;"><a href={'/admin/samarth/partners?status=' + st.value}>{st.label}</a><span style="color:#fff;">{s!.partnersByStatus[st.value]}</span></div>)}
          {sum(s.partnersByStatus) === 0 && <p class="hint">No partner registrations yet.</p>}
        </section>
        {xDesk && (
          <section class="sa-panel">
            <h2 class="sa-h2">SAMARTH X</h2>
            {X_STATUSES.filter((st) => s!.xByStatus[st.value]).map((st) => <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;"><a href={'/admin/samarth/x?status=' + st.value}>{st.label}</a><span style="color:#fff;">{s!.xByStatus[st.value]}</span></div>)}
            {s.xByChannel.map((x) => <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;color:#9aa6b6;"><span>Channel: {x.key}</span><span>{x.n}</span></div>)}
            {sum(s.xByStatus) === 0 && <p class="hint">No applications yet.</p>}
          </section>
        )}
      </div>
    </div>
  )}

  <section class="sa-panel">
    <h2 class="sa-h2">Module register</h2>
    <p class="hint" style="margin:0 0 10px;">{counts.built} built, {counts.partial} partial, {counts.planned} planned, {counts.reserved} reserved. "Built" means in the repository and passing its gates, not verified in production. The same register is kept in docs/samarth/MODULE_REGISTER.md.</p>
    <div class="sa-scroll"><table class="sa-table">
      <thead><tr><th>Module</th><th>Status</th><th>Built</th><th>Pending</th></tr></thead>
      <tbody>
        {MODULES.map((m) => (
          <tr>
            <td><strong style="color:#fff;">{m.id}</strong> {m.name}</td>
            <td><span class={m.status === 'built' ? 'sa-chip ok' : m.status === 'partial' ? 'sa-chip warn' : 'sa-chip'}>{m.status}</span></td>
            <td style="font-size:11.5px;color:#9aa6b6;">{m.built.join('; ')}</td>
            <td style="font-size:11.5px;color:#9aa6b6;">{m.pending.join('; ')}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </section>
</AdminFrame>
