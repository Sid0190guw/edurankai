---
// /admin/samarth/partners - the partner registry: search, filter, and compare partners side by side
// (?compare=<id>,<id>,...). Comparison informs a person's selection; nothing is awarded here.
import AdminFrame from '@/components/samarth/AdminFrame.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { listPartners, partnersByIds, PARTNER_DOMAINS, PARTNER_KINDS } from '@/lib/samarth/partners';
import { PARTNER_STATUSES, DUE_DILIGENCE_ITEMS, dueDiligenceComplete, statusLabel } from '@/lib/samarth/workflow';
import { countryName } from '@/lib/samarth/validate';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!(await canAccessSection(user, 'samarth', 'view'))) return Astro.redirect('/admin?denied=samarth');
const xDesk = await canAccessSection(user, 'samarth_x', 'view');
const u = Astro.url.searchParams;
const f = { q: u.get('q') || '', status: u.get('status') || '', domain: u.get('domain') || '', cursor: u.get('cursor') || '' };
const list = await listPartners({ ...f, limit: 50 });
const items = list.ready ? list.value.items : [];
const compareIds = (u.get('compare') || '').split(',').filter(Boolean).slice(0, 4);
let compared: Awaited<ReturnType<typeof partnersByIds>> = [];
let compareError = '';
if (compareIds.length) { try { compared = await partnersByIds(compareIds); } catch (e: any) { compareError = 'The comparison could not be loaded: ' + String(e?.cause?.message || e?.message); } }
const domainLabel = (d: string) => PARTNER_DOMAINS.find((x) => x.value === d)?.label || d;
const more = (cursor: string) => '?' + new URLSearchParams(Object.entries({ ...f, cursor }).filter(([, v]) => v) as [string, string][]).toString();
---
<AdminFrame title="Technology partners" active="partners" showX={xDesk} msg={u.get('msg') || ''} err={u.get('err') || compareError}>
  <p class="sa-lede">Registration is not approval, and approval is not an award. Partners reach Approved only through due diligence, and are then eligible to be named on a quotation by a person. Public registration is at <a href="/samarth/partners">/samarth/partners</a>.</p>
  <form method="GET" class="sa-panel sa-form">
    <div class="sa-row">
      <label>Search<input type="search" name="q" value={f.q} placeholder="Name, email, capability, certification, project" /></label>
      <label>Status<select name="status"><option value="">Any</option>{PARTNER_STATUSES.map((s) => <option value={s.value} selected={f.status === s.value}>{s.label}</option>)}</select></label>
      <label>Domain<select name="domain"><option value="">Any</option>{PARTNER_DOMAINS.map((d) => <option value={d.value} selected={f.domain === d.value}>{d.label}</option>)}</select></label>
    </div>
    <div class="sa-inline"><button class="sa-btn" type="submit">Apply</button><a class="sa-btn ghost" href="/admin/samarth/partners">Clear</a></div>
  </form>

  {compared.length > 0 && (
    <section class="sa-panel">
      <h2 class="sa-h2">Comparison</h2>
      <div class="sa-scroll"><table class="sa-table">
        <thead><tr><th></th>{compared.map((p) => <th><a href={'/admin/samarth/partners/' + p.id}>{p.orgName}</a></th>)}</tr></thead>
        <tbody>
          <tr><td>Status</td>{compared.map((p) => <td>{statusLabel('partner', p.status)}</td>)}</tr>
          <tr><td>Kind and country</td>{compared.map((p) => <td>{PARTNER_KINDS.find((k) => k.value === p.orgKind)?.label}, {countryName(p.country)}</td>)}</tr>
          <tr><td>Domains</td>{compared.map((p) => <td>{p.domains.map(domainLabel).join(', ')}</td>)}</tr>
          <tr><td>Capabilities</td>{compared.map((p) => <td style="white-space:pre-wrap;">{p.capabilities}</td>)}</tr>
          <tr><td>Certifications (claimed)</td>{compared.map((p) => <td style="white-space:pre-wrap;">{p.certifications || '-'}</td>)}</tr>
          <tr><td>Previous projects</td>{compared.map((p) => <td style="white-space:pre-wrap;">{p.previousProjects || '-'}</td>)}</tr>
          <tr><td>Regulatory eligibility</td>{compared.map((p) => <td style="white-space:pre-wrap;">{p.regulatory || '-'}</td>)}</tr>
          <tr><td>Due diligence</td>{compared.map((p) => <td>{dueDiligenceComplete(p.ddChecklist) ? 'Complete' : DUE_DILIGENCE_ITEMS.filter((i) => (p.ddChecklist[i.key] || 'pending') === 'pending').length + ' checks pending'}</td>)}</tr>
          <tr><td>Performance</td>{compared.map((p) => <td>{p.rating ? p.rating + ' of 5' : 'Not rated'}</td>)}</tr>
        </tbody>
      </table></div>
    </section>
  )}

  {!list.ready && <div class="sa-flash warn">{list.error}</div>}
  {list.ready && items.length === 0 && <div class="sa-empty">No partners match.</div>}
  {items.length > 0 && (
    <form method="GET" action="/admin/samarth/partners">
      <div class="sa-scroll"><table class="sa-table">
        <thead><tr><th>Compare</th><th>Partner</th><th>Domains</th><th>Status</th><th>Due diligence</th></tr></thead>
        <tbody>{items.map((p) => (
          <tr>
            <td><input type="checkbox" class="cmp" value={p.id} aria-label={'Compare ' + p.orgName} /></td>
            <td><a href={'/admin/samarth/partners/' + p.id}><strong>{p.orgName}</strong></a><br /><span class="hint">{p.ref} · {countryName(p.country)}</span></td>
            <td class="hint">{p.domains.map(domainLabel).join(', ')}</td>
            <td><span class={p.status === 'APPROVED' ? 'sa-chip ok' : 'sa-chip'}>{statusLabel('partner', p.status)}</span></td>
            <td class="hint">{dueDiligenceComplete(p.ddChecklist) ? 'Complete' : 'Incomplete'}</td>
          </tr>
        ))}</tbody>
      </table></div>
      <input type="hidden" name="compare" id="cmpField" value="" />
      <p style="margin-top:10px;" class="sa-inline"><button class="sa-btn ghost" type="submit" id="cmpBtn">Compare selected (up to 4)</button>{list.ready && list.value.next && <a class="sa-btn ghost" href={more(list.value.next)}>Older</a>}</p>
    </form>
  )}
  <script is:inline>
    (function () {
      var btn = document.getElementById('cmpBtn'), field = document.getElementById('cmpField');
      if (!btn || !field) return;
      btn.addEventListener('click', function () {
        var ids = Array.prototype.slice.call(document.querySelectorAll('.cmp:checked')).map(function (c) { return c.value; }).slice(0, 4);
        field.value = ids.join(',');
      });
    })();
  </script>
</AdminFrame>
