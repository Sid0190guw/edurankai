---
// /admin/chat — the Discussion channels, now a READ-ONLY ARCHIVE.
//
// WHY. `chat_messages` was CREATEd by two modules with two incompatible shapes (channel + body here,
// thread + ciphertext at /portal/messages). CREATE TABLE IF NOT EXISTS is a no-op on an existing
// table, so one of the two systems has been throwing on every INSERT since 2026-06-09 while looking
// completely implemented. The repair keeps ONE messenger. It is /portal/messages, decided from the
// code and not from taste:
//
//   * REACH. src/lib/workforce/navigation.ts:204 offers Messages to every composed workspace member.
//     This page is reachable only by an account that passes canOpenAdmin AND holds the `discussion`
//     section (src/middleware.ts:57) — a strict subset of staff. An employee without admin.access is
//     redirected off /admin entirely, so for most of the company /portal/messages is the only
//     messaging surface that exists.
//   * DEPENDENTS. src/lib/legal-hold.ts and src/pages/portal/employee.astro both read chat_messages
//     through thread_id. Only this page and its endpoints read channel_id.
//   * GUARANTEE. legal-hold.ts:214-223 states that direct-message content is not recoverable
//     server-side. That is a property of the thread messenger's storage (ciphertext + iv, keys never
//     leave the browser). It is false of a plaintext `body` column. Keeping the channel system as
//     the survivor would have turned a privacy guarantee into a false statement.
//
// WHAT HAPPENS TO WHAT IS HERE. Nothing is deleted. Every channel and every message stays in place
// and stays readable on this page; src/lib/chat-schema.ts adds columns and drops no data. The
// composer, the attach button, "create channel" and "start DM" are gone, and their endpoints refuse
// with 410 after the authorization check. Live rows must never be silently orphaned — this page is
// how they remain reachable.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { chatChannels, chatMemberships, chatMessages } from '@/lib/db/schema';
import { asc, eq, and, isNull } from 'drizzle-orm';
import { ensureChatSchema, CHAT_CANONICAL_HREF } from '@/lib/chat-schema';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// Function declarations, hoisted, so they are safe wherever they are used below. `const` is not
// hoisted and has taken pages down on this project.
function shortTime(v: any): string {
  if (!v) return '';
  const d = new Date(v);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
}
function dayLabel(v: any): string {
  if (!v) return '';
  const d = new Date(v);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric' });
}

await ensureChatSchema();

// Private channels are visible only to their members — unchanged.
const myMemberships = await db.select({ channelId: chatMemberships.channelId })
  .from(chatMemberships).where(eq(chatMemberships.userId, user.id));
const myMemberChannelIds = myMemberships.map((m) => m.channelId);

const allChannels = await db.select().from(chatChannels).orderBy(asc(chatChannels.sortOrder), asc(chatChannels.name));
const channels = allChannels.filter((c) => !c.isPrivate || myMemberChannelIds.includes(c.id));

const url = new URL(Astro.request.url);
const activeChannel = url.searchParams.get('c') || (channels[0]?.slug || 'general');
const currentChannel = channels.find((c) => c.slug === activeChannel) || channels[0] || null;

// Server-rendered, not polled. An archive does not change, so a 1.5-second poll was paying database
// compute for a screen that cannot receive anything — and it also means this page reads with
// JavaScript off. currentChannel comes from the membership-filtered list above, so a private channel
// this reader is not in can never be the one loaded.
let archive: any[] = [];
let archiveError = '';
if (currentChannel) {
  try {
    archive = await db.select({
      id: chatMessages.id,
      body: chatMessages.body,
      senderUserId: chatMessages.senderUserId,
      senderName: chatMessages.senderName,
      createdAt: chatMessages.createdAt,
      editedAt: chatMessages.editedAt,
    }).from(chatMessages)
      .where(and(eq(chatMessages.channelId, currentChannel.id), isNull(chatMessages.deletedAt)))
      .orderBy(asc(chatMessages.createdAt))
      .limit(500);
  } catch (e: any) {
    // Never swallowed: an archive that renders empty because the query failed is indistinguishable
    // from an archive that is genuinely empty, and this page exists to prove what was said.
    archiveError = String(e?.cause?.message || e?.message || 'unknown error');
    console.error('[admin/chat] archive read', archiveError);
  }
}
---
<AdminLayout title="Discussion archive" description="The team channels, read-only. New messages are written in the portal messenger.">
  <style>
    #eraFab, #eraFabMenu { display: none !important; }
    body.era-has-fab { padding-bottom: 0 !important; }

    .arc-shell { display: grid; grid-template-columns: 240px 1fr; height: calc(100vh - 70px); background: #0a0a0c; overflow: hidden; border-top: 1px solid #1f1f26; }
    .arc-side { background: #08080a; border-right: 1px solid #1f1f26; overflow-y: auto; }
    .arc-main { display: flex; flex-direction: column; background: #0a0a0c; min-width: 0; }
    .arc-scrim { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 199; display: none; }
    .arc-scrim.open { display: block; }
    .arc-toggle { display: none; background: #15151a; border: 1px solid #1f1f26; color: #fff; width: 44px; height: 44px; border-radius: 8px; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }

    .arc-chan { display: block; padding: 12px 14px; text-decoration: none; font-size: 13px; border-left: 3px solid transparent; color: #a0a0ab; min-height: 44px; }
    .arc-chan.on { border-left-color: #FF4F00; background: rgba(255,79,0,0.08); color: #fff; }

    .arc-stream { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
    .arc-day { text-align: center; font-family: 'Geist Mono', monospace; font-size: 10px; color: #6e6e78; letter-spacing: 0.1em; text-transform: uppercase; }
    .arc-row { display: flex; flex-direction: column; align-items: flex-start; }
    .arc-row.me { align-items: flex-end; }
    .arc-meta { font-size: 10.5px; color: #6e6e78; margin-bottom: 3px; font-family: 'Geist Mono', monospace; }
    .arc-body { max-width: 75%; padding: 9px 13px; border-radius: 14px; font-size: 13.5px; line-height: 1.5; color: #d8d8de; background: #15151a; border: 1px solid #1f1f26; white-space: pre-wrap; overflow-wrap: anywhere; }
    .arc-row.me .arc-body { color: #fff; background: #FF4F00; border-color: #FF4F00; }

    .arc-note { border-top: 1px solid #1f1f26; background: #0a0a0c; padding: 14px 18px; display: flex; gap: 12px; align-items: flex-start; }
    .arc-note svg { width: 18px; height: 18px; flex-shrink: 0; color: #FF7040; margin-top: 1px; }
    .arc-note p { font-size: 12.5px; color: #a0a0ab; line-height: 1.6; margin: 0; }
    .arc-cta { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px; margin-top: 10px; background: #FF4F00; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; }
    .arc-pill { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #3a2a20; background: rgba(255,79,0,0.10); color: #FF7040; border-radius: 999px; padding: 3px 10px; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
    .arc-fail { margin: 18px; padding: 12px 14px; border: 1px solid #4a1f1f; background: rgba(239,68,68,0.10); color: #fca5a5; border-radius: 8px; font-family: 'Geist Mono', monospace; font-size: 11.5px; line-height: 1.6; overflow-wrap: anywhere; }

    @media (max-width: 768px) {
      .arc-shell { grid-template-columns: 1fr; height: calc(100vh - 110px); }
      .arc-side { position: fixed; top: 0; left: -100%; bottom: 0; width: 78vw; max-width: 320px; z-index: 200; transition: left 0.22s ease; box-shadow: 4px 0 22px rgba(0,0,0,0.55); }
      .arc-side.open { left: 0; }
      .arc-toggle { display: inline-flex; }
      .arc-body { max-width: 88%; }
      .arc-stream { padding: 14px 12px; }
      .arc-note { flex-direction: column; gap: 8px; }
    }
  </style>

  <div class="admin-page" style="max-width:100%;padding:0;">
    <div class="arc-shell">
      <div class="arc-scrim" id="arcScrim"></div>

      <aside class="arc-side" id="arcSide">
        <div style="padding:14px 14px 10px;border-bottom:1px solid #1f1f26;">
          <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;font-weight:700;text-transform:uppercase;">Discussion archive</p>
          <p style="font-size:11px;color:#6e6e78;margin-top:2px;">{channels.length} channels, read-only</p>
        </div>
        <div style="padding:8px 0;">
          {channels.map((c) => (
            <a href={'/admin/chat?c=' + c.slug} class={'arc-chan' + (c.slug === activeChannel ? ' on' : '')}>
              <span style={'color:' + (c.isPrivate ? '#fbbf24' : '#6e6e78') + ';'}>{c.isPrivate ? '*' : '#'}</span> {c.name}
            </a>
          ))}
        </div>
      </aside>

      <section class="arc-main">
        <header style="padding:14px 18px;border-bottom:1px solid #1f1f26;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:10px;">
              <button type="button" class="arc-toggle" id="arcToggle" aria-label="Open channels">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
              </button>
              <div>
                <h1 style="font-size:16px;font-weight:600;color:#fff;margin:0;"><span style="color:#6e6e78;">#</span> {currentChannel?.name || activeChannel}</h1>
                {currentChannel?.description && <p style="font-size:11.5px;color:#6e6e78;margin-top:2px;">{currentChannel.description}</p>}
              </div>
            </div>
            <span class="arc-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              read-only
            </span>
          </div>
        </header>

        {archiveError && (
          <div class="arc-fail">
            This channel could not be read, so what you see below is not the whole record: {archiveError}
          </div>
        )}

        <div class="arc-stream">
          {archive.length === 0 && !archiveError && (
            <p style="text-align:center;color:#6e6e78;font-size:12px;padding:20px 0;">No messages were ever posted in this channel.</p>
          )}
          {archive.map((m, i) => (
            <>
              {(i === 0 || dayLabel(archive[i - 1].createdAt) !== dayLabel(m.createdAt)) && (
                <p class="arc-day">{dayLabel(m.createdAt)}</p>
              )}
              <div class={'arc-row' + (m.senderUserId === user.id ? ' me' : '')}>
                <p class="arc-meta">{m.senderUserId === user.id ? 'You' : (m.senderName || 'Unknown')} at {shortTime(m.createdAt)}{m.editedAt ? ' (edited)' : ''}</p>
                <div class="arc-body">{m.body || ''}</div>
              </div>
            </>
          ))}
        </div>

        <footer class="arc-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <div>
            <p>
              These channels are kept for their history and no longer accept new messages. Every
              conversation now happens in one place, where messages are encrypted in your browser and
              cannot be read off the server.
            </p>
            <a class="arc-cta" href={CHAT_CANONICAL_HREF}>Open Messages</a>
          </div>
        </footer>
      </section>
    </div>
  </div>

  <script is:inline>
    (function () {
      var side = document.getElementById('arcSide');
      var scrim = document.getElementById('arcScrim');
      var toggle = document.getElementById('arcToggle');
      if (!side || !scrim || !toggle) return;
      function close() { side.classList.remove('open'); scrim.classList.remove('open'); }
      toggle.addEventListener('click', function () {
        side.classList.toggle('open');
        scrim.classList.toggle('open');
      });
      scrim.addEventListener('click', close);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
  </script>
</AdminLayout>
