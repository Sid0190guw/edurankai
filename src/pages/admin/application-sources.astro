---
// Admin control for "where did this application come from".
// The list the application form shows is data, not code — add, edit, reorder, activate, deactivate
// and bulk-select here, no deploy needed.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  listAllSources, createSource, updateSource, setActiveBulk, deleteSources,
  listSuggestions, publishSuggestion, setSuggestionStatus,
} from '@/lib/application-sources';
import { logAudit } from '@/lib/audit';

const user = Astro.locals.user!;
if (!can(user, 'roles.edit')) return Astro.redirect('/admin');

let msg = '';
let err = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('_action');
  const ids = fd.getAll('ids').map((x) => String(x)).filter(Boolean);

  try {
    if (action === 'create') {
      const r = await createSource({
        label: String(fd.get('label') || ''),
        category: String(fd.get('category') || 'other'),
        detailLabel: String(fd.get('detailLabel') || '').trim() || null,
        detailRequired: fd.get('detailRequired') === 'on',
        sortOrder: parseInt(String(fd.get('sortOrder') || '500')) || 500,
      });
      msg = r.ok ? 'Option added.' : ''; err = r.ok ? '' : (r.error || 'Could not add.');
    } else if (action === 'update') {
      const r = await updateSource(String(fd.get('id')), {
        label: String(fd.get('label') || ''),
        category: String(fd.get('category') || 'other'),
        detailLabel: String(fd.get('detailLabel') || '').trim() || null,
        detailRequired: fd.get('detailRequired') === 'on',
        sortOrder: parseInt(String(fd.get('sortOrder') || '500')) || 500,
      });
      msg = r.ok ? 'Saved.' : ''; err = r.ok ? '' : (r.error || 'Could not save.');
    } else if (action === 'activate' || action === 'deactivate') {
      const n = await setActiveBulk(ids, action === 'activate');
      msg = `${n} option(s) ${action === 'activate' ? 'activated' : 'deactivated'}.`;
    } else if (action === 'delete') {
      const r = await deleteSources(ids);
      // Used options are deactivated instead of removed, so applications keep saying what they said.
      msg = `${r.deleted} deleted. Any option already chosen by an applicant was deactivated instead, so existing applications keep their answer.`;
    } else if (action === 'publish_suggestion') {
      const r = await publishSuggestion(String(fd.get('id')));
      msg = r.ok ? 'Published as an option.' : ''; err = r.ok ? '' : (r.error || 'Could not publish.');
    } else if (action === 'reject_suggestions') {
      const n = await setSuggestionStatus(ids, 'rejected');
      msg = `${n} suggestion(s) dismissed.`;
    }
    if (msg) await logAudit({ userId: user.id, action: 'application_source.' + String(action), entity: 'application_source', entityId: ids.join(',') || String(fd.get('id') || ''), ipAddress: Astro.clientAddress });
  } catch (e: any) {
    err = e?.cause?.message || e?.message || 'Something went wrong.';
  }
}

const sources = await listAllSources();
const suggestions = await listSuggestions('pending');
const CATEGORIES = ['platform', 'government', 'institution', 'event', 'referral', 'other'];
const inp = 'width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:7px 9px;border-radius:6px;font-size:12.5px;';
---
<AdminLayout title="Application sources">
  <div style="max-width:1100px;">
    <h1 style="font-family:'Fraunces',serif;font-size:26px;margin:0 0 4px;">Application sources</h1>
    <p style="font-size:13px;color:#8a8a94;margin:0 0 18px;">
      What applicants pick for &ldquo;where are you applying from&rdquo;. This is data &mdash; changes
      take effect immediately, with no deploy.
    </p>

    {msg && <div style="padding:10px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #14532d;background:rgba(20,83,45,0.2);font-size:13px;">{msg}</div>}
    {err && <div style="padding:10px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #7f1d1d;background:rgba(127,29,29,0.2);font-size:13px;">{err}</div>}

    {suggestions.length > 0 && (
      <div style="border:1px solid #b45309;background:rgba(180,83,9,0.12);border-radius:12px;padding:14px;margin-bottom:20px;">
        <p style="font-size:13px;font-weight:700;color:#fbbf24;margin:0 0 4px;">{suggestions.length} thing(s) applicants typed under &ldquo;Other&rdquo;</p>
        <p style="font-size:11.5px;color:#a0a0a8;margin:0 0 10px;line-height:1.5;">
          Not shown on the form until you publish one. Applicant-typed text goes in front of every
          future applicant, so it is reviewed first rather than published automatically. Repeats are
          counted, so genuinely common sources rise to the top.
        </p>
        <form method="POST">
          <input type="hidden" name="_action" value="reject_suggestions" />
          <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
            <tbody>
              {suggestions.map((s) => (
                <tr style="border-top:1px solid #2a2a30;">
                  <td style="padding:6px 8px;width:26px;"><input type="checkbox" name="ids" value={s.id} /></td>
                  <td style="padding:6px 8px;color:#e8e8ee;">{s.text}</td>
                  <td style="padding:6px 8px;color:#8a8a94;white-space:nowrap;">seen {s.timesSeen}x</td>
                  <td style="padding:6px 8px;text-align:right;">
                    <button type="submit" form={'pub-' + s.id} style="background:#166534;border:0;color:#fff;font-size:11px;padding:5px 10px;border-radius:5px;cursor:pointer;">Publish</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <button type="submit" style="margin-top:10px;background:#1a1a22;border:1px solid #2a2a30;color:#a0a0a8;font-size:11.5px;padding:6px 12px;border-radius:6px;cursor:pointer;">Dismiss selected</button>
        </form>
        {suggestions.map((s) => (
          <form method="POST" id={'pub-' + s.id} style="display:none;">
            <input type="hidden" name="_action" value="publish_suggestion" />
            <input type="hidden" name="id" value={s.id} />
          </form>
        ))}
      </div>
    )}

    {/* Add */}
    <details style="border:1px solid #2a2a30;border-radius:12px;background:#0f0f14;margin-bottom:20px;">
      <summary style="padding:12px 14px;cursor:pointer;font-size:13px;font-weight:600;color:#e8e8ee;">Add an option</summary>
      <form method="POST" style="padding:0 14px 14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;align-items:end;">
        <input type="hidden" name="_action" value="create" />
        <label style="font-size:11px;color:#8a8a94;">Label<input name="label" required style={inp} placeholder="e.g. Naukri" /></label>
        <label style="font-size:11px;color:#8a8a94;">Category
          <select name="category" style={inp}>{CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select>
        </label>
        <label style="font-size:11px;color:#8a8a94;">Follow-up question (optional)<input name="detailLabel" style={inp} placeholder="e.g. Which platform" /></label>
        <label style="font-size:11px;color:#8a8a94;">Order<input name="sortOrder" type="number" value="500" style={inp} /></label>
        <label style="font-size:11.5px;color:#a0a0a8;display:flex;align-items:center;gap:6px;"><input type="checkbox" name="detailRequired" /> Follow-up required</label>
        <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:12.5px;padding:8px 16px;border-radius:6px;cursor:pointer;">Add</button>
      </form>
    </details>

    {/* Bulk actions + list */}
    <form method="POST">
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap;">
        <label style="font-size:12px;color:#a0a0a8;display:flex;align-items:center;gap:6px;">
          <input type="checkbox" id="selAll" /> Select all
        </label>
        <button type="submit" name="_action" value="activate" style="background:#166534;border:0;color:#fff;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Activate</button>
        <button type="submit" name="_action" value="deactivate" style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Deactivate</button>
        <button type="submit" name="_action" value="delete"
          onclick="return confirm('Delete the selected options? Any that applicants have already chosen will be DEACTIVATED instead of deleted, so existing applications keep their answer.');"
          style="background:#7f1d1d;border:0;color:#fff;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Delete</button>
        <span style="font-size:11.5px;color:#6e6e78;margin-left:auto;">{sources.filter((s) => s.isActive).length} of {sources.length} active</span>
      </div>

      <div style="border:1px solid #2a2a30;border-radius:12px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
          <thead>
            <tr style="background:#12121a;">
              {['', 'Label', 'Category', 'Follow-up', 'Req', 'Order', 'Used', 'Status', ''].map((h) => (
                <th style="text-align:left;padding:8px 9px;font-size:9.5px;text-transform:uppercase;letter-spacing:0.08em;color:#6e6e78;font-weight:700;">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {sources.map((s) => (
              <tr style="border-top:1px solid #1a1a22;">
                <td style="padding:6px 9px;"><input type="checkbox" name="ids" value={s.id} class="rowChk" /></td>
                <td style="padding:6px 9px;"><input name="label" value={s.label} form={'ed-' + s.id} style={inp} /></td>
                <td style="padding:6px 9px;">
                  <select name="category" form={'ed-' + s.id} style={inp}>
                    {CATEGORIES.map((c) => <option value={c} selected={c === s.category}>{c}</option>)}
                  </select>
                </td>
                <td style="padding:6px 9px;"><input name="detailLabel" value={s.detailLabel || ''} form={'ed-' + s.id} style={inp} placeholder="none" /></td>
                <td style="padding:6px 9px;text-align:center;"><input type="checkbox" name="detailRequired" form={'ed-' + s.id} checked={s.detailRequired} /></td>
                <td style="padding:6px 9px;width:70px;"><input name="sortOrder" type="number" value={s.sortOrder} form={'ed-' + s.id} style={inp} /></td>
                <td style="padding:6px 9px;color:#8a8a94;font-family:monospace;">{s.usageCount}</td>
                <td style="padding:6px 9px;">
                  <span style={`font-size:10px;font-weight:700;padding:2px 7px;border-radius:100px;color:${s.isActive ? '#4ade80' : '#6e6e78'};background:${s.isActive ? 'rgba(74,222,128,0.14)' : 'rgba(110,110,120,0.14)'};`}>
                    {s.isActive ? 'ACTIVE' : 'OFF'}
                  </span>
                </td>
                <td style="padding:6px 9px;text-align:right;">
                  <button type="submit" form={'ed-' + s.id} style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;font-size:11px;padding:5px 10px;border-radius:5px;cursor:pointer;">Save</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </form>

    {/* One form per row, referenced by the inputs above via form= so each saves independently. */}
    {sources.map((s) => (
      <form method="POST" id={'ed-' + s.id} style="display:none;">
        <input type="hidden" name="_action" value="update" />
        <input type="hidden" name="id" value={s.id} />
      </form>
    ))}
  </div>

  <script>
    const all = document.getElementById('selAll') as HTMLInputElement | null;
    all?.addEventListener('change', () => {
      document.querySelectorAll('.rowChk').forEach((c) => { (c as HTMLInputElement).checked = all.checked; });
    });
  </script>
</AdminLayout>
