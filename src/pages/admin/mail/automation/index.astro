---
/**
 * /admin/mail/automation - the ENGINE's own screen: what is running, what is waiting, and what
 * stopped and needs a person.
 *
 * THE BUILDER IS NOT HERE. Automations are drawn and published at /mail/automations
 * (src/lib/mail-product/automations.ts owns the graph, its validation and its Publish gate). This
 * page is the half that did not exist until the executor did: runs, the events that started them,
 * the dead letters, and whether anything is actually running on a timetable.
 *
 * FAILED READS ARE STATED, NOT SWALLOWED. An unreadable list rendered as "nothing here" reads as
 * "nothing is set up", and the natural response is to build a second copy of something that already
 * exists and is already mailing people.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { pgStore } from '@/lib/mailplatform/pg-store';
import { ORG_ID, checkReadyToActivate, installExample, listExamples } from '@/lib/mailplatform/service';
import { controlRun } from '@/lib/mailplatform/worker';
import { triggerNode } from '@/lib/mailplatform/graph';
import { canonicalEventType } from '@/lib/mailplatform/triggers';
import { channelStatus } from '@/lib/mailplatform/adapters';
import { cronSecretConfigured } from '@/lib/auth/cron-auth';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') || '');
  try {
    if (action === 'install') {
      const r = await installExample(pgStore, ORG_ID, String(fd.get('key') || ''), user.id);
      if (r.ok) okMsg = r.message;
      else errMsg = r.message;
    } else if (action === 'run_control') {
      const r = await controlRun(pgStore, ORG_ID, String(fd.get('runId') || ''), String(fd.get('control') || '') as any);
      // changed:false is reported as a refusal, not as success. Telling somebody a run was cancelled
      // when it had already been sent is the failure that matters on this screen.
      if (r.ok) okMsg = r.message;
      else errMsg = r.message;
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the failed SQL.
    errMsg = 'Nothing was changed: ' + String(e?.cause?.message || e?.message || e);
    console.error('[admin/mail/automation] ' + action + ' failed:', e?.cause?.message || e?.message);
  }
}

let loadError = '';
let automations: any[] = [];
let counts: any = { running: 0, waiting: 0, completed: 0, failed: 0, cancelled: 0, paused: 0 };
let deadLetters: any[] = [];
let recentRuns: any[] = [];
let recentEvents: any[] = [];
try {
  automations = await pgStore.listAutomations(ORG_ID, {});
  counts = await pgStore.countRuns(ORG_ID);
  deadLetters = await pgStore.listRuns(ORG_ID, { deadLetterOnly: true, limit: 20 });
  recentRuns = await pgStore.listRuns(ORG_ID, { limit: 15 });
  recentEvents = await pgStore.listEvents(ORG_ID, { limit: 15 });
} catch (e: any) {
  loadError = String(e?.cause?.message || e?.message || e);
  console.error('[admin/mail/automation] read failed:', loadError);
}

// Whether each ACTIVE automation could actually run right now. An automation that is on and cannot
// send is worse than one that is off: it looks live, enters contacts, and fails every one at the send.
const readiness = new Map<string, string>();
for (const a of automations.filter((x: any) => x.status === 'active')) {
  try {
    const r = await checkReadyToActivate(pgStore, ORG_ID, a.id);
    if (!r.ok) readiness.set(a.id, r.channelProblem || r.problems.map((p: any) => p.message).join(' '));
  } catch (e: any) {
    readiness.set(a.id, 'It could not be checked: ' + String(e?.cause?.message || e?.message || e));
  }
}

const channels = await channelStatus().catch(() => []);
const examples = listExamples();
const installedNames = new Set(automations.map((a: any) => a.name));
const cronReady = cronSecretConfigured();
const nameOf = new Map(automations.map((a: any) => [a.id, a.name]));

function when(d: any) {
  if (!d) return '';
  const t = d instanceof Date ? d : new Date(d);
  return Number.isFinite(t.getTime()) ? t.toISOString().replace('T', ' ').slice(0, 16) : '';
}
function listensFor(a: any) {
  try { return canonicalEventType(String((triggerNode(a.graph)?.config || {}).event || '')) || 'nothing'; }
  catch { return 'nothing'; }
}
---
<AdminLayout title="Automation runs" activeNav="mail">
  <section class="page">
    <div class="page-head">
      <div>
        <p class="eyebrow">Mail</p>
        <h1>Automation</h1>
        <p class="sub">
          Event, condition, action, delay. Automations are drawn at <a href="/mail/automations">the builder</a>;
          this page is what happened when they ran. <a href="/admin/mail">Back to inbox</a>
        </p>
      </div>
    </div>

    {okMsg && <div class="flash ok">{okMsg}</div>}
    {errMsg && <div class="flash err">{errMsg}</div>}
    {loadError && (
      <div class="flash err">
        The automation tables could not be read, so anything empty below is empty for a reason that is not
        "you have none": {loadError}. If this says a relation does not exist, run db/mail-automation-schema.sql.
      </div>
    )}

    {!cronReady && (
      <div class="flash err">
        CRON_SECRET is not set on this deployment, so <strong>nothing runs on a timetable</strong>: an automation
        can start, but every delay stays parked and no scheduled trigger fires. Nothing is lost — each waiting
        run keeps its appointment and continues once the secret is set and /api/mail/automation/tick is called.
      </div>
    )}

    <div class="card">
      <h2>Runs</h2>
      <p class="card-sub">A run is one contact moving through one automation.</p>
      <div class="stat-row">
        <div class="stat"><span class="n">{counts.running}</span><span class="l">Running</span></div>
        <div class="stat"><span class="n">{counts.waiting}</span><span class="l">Waiting on a delay</span></div>
        <div class="stat"><span class="n">{counts.paused}</span><span class="l">Paused</span></div>
        <div class="stat"><span class="n">{counts.completed}</span><span class="l">Completed</span></div>
        <div class="stat"><span class="n">{counts.failed}</span><span class="l">Failed</span></div>
        <div class="stat"><span class="n">{counts.cancelled}</span><span class="l">Cancelled</span></div>
      </div>
    </div>

    {deadLetters.length > 0 && (
      <div class="card">
        <h2>Stopped, and waiting for a person</h2>
        <p class="card-sub">
          These runs stopped in a way the engine would not resolve on its own. A step that was interrupted
          part-way through a send is never repeated automatically, because a message cannot be recalled.
          Check whether it went out, then retry or cancel.
        </p>
        <table class="tbl">
          <thead><tr><th>Run</th><th>Automation</th><th>Stopped at</th><th>Why</th><th></th></tr></thead>
          <tbody>
            {deadLetters.map((r: any) => (
              <tr>
                <td class="mono small">{r.runId.slice(0, 8)}</td>
                <td class="small">{nameOf.get(r.automationId) || r.automationId}</td>
                <td class="mono small">{r.currentNode || ''}</td>
                <td class="wrap small">{r.error || ''}</td>
                <td class="right">
                  <form method="post" class="inline">
                    <input type="hidden" name="_action" value="run_control" />
                    <input type="hidden" name="runId" value={r.runId} />
                    <button class="btn small" name="control" value="retry">Retry</button>
                    <button class="btn small" name="control" value="cancel">Cancel</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="card">
      <h2>Automations</h2>
      {automations.length === 0 ? (
        <p class="muted">None yet. Install an example below, or draw one at <a href="/mail/automations">the builder</a>.</p>
      ) : (
        <table class="tbl">
          <thead><tr><th>Name</th><th>Starts on</th><th>Status</th><th>Version</th><th>Updated</th></tr></thead>
          <tbody>
            {automations.map((a: any) => (
              <tr>
                <td>
                  <a href={'/mail/automations/' + a.id}><strong>{a.name}</strong></a>
                  {readiness.get(a.id) && <div class="small err-text">On, but it cannot run: {readiness.get(a.id)}</div>}
                </td>
                <td class="mono small">{listensFor(a)}</td>
                <td>{a.status}</td>
                <td>{a.version}</td>
                <td class="small">{when(a.updatedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <div class="card">
      <h2>Start from an example</h2>
      <p class="card-sub">
        Installed as a draft, always. An example that switched itself on would begin mailing candidates the
        moment somebody clicked it to see what it looked like. Its send steps name no template on purpose —
        choose one in the builder before switching it on.
      </p>
      <table class="tbl">
        <thead><tr><th>Example</th><th>Steps</th><th></th></tr></thead>
        <tbody>
          {examples.map((ex: any) => (
            <tr>
              <td><strong>{ex.name}</strong><div class="muted small">{ex.description}</div></td>
              <td>{ex.steps}</td>
              <td class="right">
                {installedNames.has(ex.name) ? (
                  <span class="muted small">Installed</span>
                ) : (
                  <form method="post" class="inline">
                    <input type="hidden" name="key" value={ex.key} />
                    <button class="btn small" name="_action" value="install">Install</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Channels</h2>
      <p class="card-sub">A step pointing at a channel that is not built refuses to send rather than quietly sending nothing.</p>
      <table class="tbl">
        <thead><tr><th>Channel</th><th>Usable</th><th>Why not</th></tr></thead>
        <tbody>
          {channels.map((c: any) => (
            <tr>
              <td>{c.label}</td>
              <td>{c.available ? 'Yes' : 'No'}</td>
              <td class="wrap muted small">{c.reason}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Recent runs</h2>
      {recentRuns.length === 0 ? (
        <p class="muted">Nothing has run yet.</p>
      ) : (
        <table class="tbl">
          <thead><tr><th>Run</th><th>Automation</th><th>State</th><th>At step</th><th>Waiting until</th><th>Note</th><th></th></tr></thead>
          <tbody>
            {recentRuns.map((r: any) => (
              <tr>
                <td class="mono small">{r.runId.slice(0, 8)}</td>
                <td class="small">{nameOf.get(r.automationId) || ''}</td>
                <td>{r.state}</td>
                <td class="mono small">{r.currentNode || ''}</td>
                <td class="small">{when(r.waitUntil)}</td>
                <td class="wrap small">{r.errorKind === 'business' ? 'Ended: ' + (r.error || '') : (r.error || '')}</td>
                <td class="right">
                  <form method="post" class="inline">
                    <input type="hidden" name="_action" value="run_control" />
                    <input type="hidden" name="runId" value={r.runId} />
                    {r.state === 'waiting' && <button class="btn small" name="control" value="pause">Pause</button>}
                    {r.state === 'paused' && <button class="btn small" name="control" value="resume">Resume</button>}
                    {(r.state === 'waiting' || r.state === 'paused' || r.state === 'running') && <button class="btn small" name="control" value="cancel">Cancel</button>}
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <div class="card">
      <h2>Recent events</h2>
      <p class="card-sub">
        Every event is recorded whether or not it started anything. "Started 0 runs" is a normal answer and
        usually the one you are looking for.
      </p>
      {recentEvents.length === 0 ? (
        <p class="muted">No events yet.</p>
      ) : (
        <table class="tbl">
          <thead><tr><th>Type</th><th>Source</th><th>Started</th><th>Received</th><th>Note</th></tr></thead>
          <tbody>
            {recentEvents.map((e: any) => (
              <tr>
                <td class="mono small">{e.type}</td>
                <td class="small">{e.source}</td>
                <td>{e.startedRuns}</td>
                <td class="small">{when(e.receivedAt)}</td>
                <td class="wrap small">{e.error || ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>
</AdminLayout>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 1rem; }
  .page-head { margin-bottom: 1rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .7rem; opacity: .7; margin: 0; }
  h1 { margin: .2rem 0; font-size: 1.6rem; }
  .sub { opacity: .8; margin: 0; }
  .card { border: 1px solid rgba(128,128,128,.28); border-radius: 10px; padding: 1rem; margin: 1rem 0; }
  .card h2 { margin: 0 0 .2rem; font-size: 1.1rem; }
  .card-sub { margin: 0 0 .8rem; opacity: .8; font-size: .9rem; }
  .flash { padding: .7rem .9rem; border-radius: 8px; margin: .6rem 0; font-size: .92rem; }
  .flash.ok { background: rgba(34,197,94,.14); border: 1px solid rgba(34,197,94,.4); }
  .flash.err { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.4); }
  .stat-row { display: flex; flex-wrap: wrap; gap: .8rem; }
  .stat { border: 1px solid rgba(128,128,128,.25); border-radius: 8px; padding: .6rem .9rem; min-width: 7.5rem; }
  .stat .n { display: block; font-size: 1.5rem; font-weight: 600; }
  .stat .l { display: block; font-size: .75rem; opacity: .75; }
  .tbl { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .tbl th, .tbl td { text-align: left; padding: .45rem .5rem; border-bottom: 1px solid rgba(128,128,128,.18); vertical-align: top; }
  .tbl th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; opacity: .7; }
  .right { text-align: right; }
  .wrap { max-width: 30rem; white-space: normal; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .small { font-size: .8rem; }
  .muted { opacity: .7; }
  .err-text { color: #ef4444; }
  .inline { display: inline; }
  .btn { border: 1px solid rgba(128,128,128,.4); background: transparent; color: inherit; border-radius: 6px; padding: .3rem .6rem; cursor: pointer; font: inherit; }
  .btn.small { font-size: .82rem; }
</style>
