---
/**
 * /admin/mail/campaigns — every campaign, and the button that starts a new one.
 *
 * The status column is the whole point of this screen, so it never shows a bare word: a sending
 * campaign shows how far through it is, a scheduled one shows when and in which zone, and a failed
 * one shows why on the row rather than three clicks away.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { ensureCampaignSchema, listCampaigns, createCampaign, DEFAULT_CAMPAIGN_FROM } from '@/lib/mail-campaigns';
import { dbReason, type Actor } from '@/lib/mail-contacts';
import { stateLabel, stateTone, CAMPAIGN_STATES } from '@/lib/mail-campaign-state';
import { formatInZone } from '@/lib/mail-schedule';
import { transportStatus } from '@/lib/mail-transport';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const actor: Actor = { userId: user.id, name: user.name || user.email };

const readFailures: { source: string; reason: string }[] = [];
// No okMsg here on purpose: the only write on this page is "create", and a successful create
// redirects into the new campaign. A success banner would only ever be shown for a failure.
let errMsg = '';

await ensureCampaignSchema().catch((e: any) => { errMsg = 'The campaign tables could not be prepared: ' + dbReason(e); });

if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    if (String(fd.get('_action')) === 'create') {
      const r = await createCampaign({
        name: String(fd.get('name') || ''),
        subject: String(fd.get('subject') || ''),
        stream: String(fd.get('stream') || 'campaign') === 'transactional' ? 'transactional' : 'campaign',
      }, actor);
      if (r.ok && r.id) return Astro.redirect('/admin/mail/campaigns/' + r.id);
      errMsg = r.error || 'The campaign was not created.';
    }
  } catch (e: any) {
    console.error('[admin/mail/campaigns] write failed:', dbReason(e));
    errMsg = 'Nothing was saved: ' + dbReason(e);
  }
}

const filter = Astro.url.searchParams.get('status') || 'any';
const campaigns = await listCampaigns({ status: filter }).catch((e: any) => {
  readFailures.push({ source: 'Campaigns', reason: dbReason(e) });
  console.error('[admin/mail/campaigns] list failed:', dbReason(e));
  return [] as any[];
});

const transport = await transportStatus().catch((e: any) => {
  readFailures.push({ source: 'Mail transport', reason: dbReason(e) });
  return { mode: 'none' as const, detail: 'could not be read' };
});

function toneStyle(s: string): string {
  const t = stateTone(s);
  if (t === 'ok') return 'background:rgba(16,185,129,.15);color:#6ee7b7;';
  if (t === 'live') return 'background:rgba(255,106,61,.15);color:#FF7040;';
  if (t === 'warn') return 'background:rgba(245,158,11,.15);color:#fcd34d;';
  if (t === 'bad') return 'background:rgba(239,68,68,.15);color:#fca5a5;';
  return 'background:rgba(148,163,184,.15);color:#94a3b8;';
}
const nothingMatched = campaigns.length === 0 && readFailures.length === 0;
---
<AdminLayout title="Campaigns" activeNav="mail">
  <style>
    .cw { padding: 18px; max-width: 1400px; }
    .card { background: var(--o-panel2,#141418); border: 1px solid var(--o-stroke,#26262e); border-radius: 12px; padding: 16px; }
    .lbl { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #8a8a94; display: block; margin-bottom: 5px; }
    .inp { width: 100%; background: #fff; color: #17181d; border: 1.5px solid #cbd0da; border-radius: 8px; padding: 8px 10px; font-size: 13px; }
    .drop { background: #fff; color: #17181d; border: 1.5px solid #cbd0da; border-radius: 8px; padding: 8px 10px; font-size: 13px; }
    .prim { background: #FF6A3D; color: #fff; border: none; font-weight: 700; padding: 9px 18px; border-radius: 8px; cursor: pointer; font-size: 13px; }
    .ghost { background: #262832; color: #e6e7ec; border: 1px solid #3a3c48; font-weight: 600; padding: 7px 13px; border-radius: 8px; cursor: pointer; font-size: 12.5px; }
    .muted { color: #8a8a94; font-size: 11.5px; }
    .pill { font-size: 9.5px; font-weight: 700; padding: 2px 7px; border-radius: 100px; text-transform: uppercase; letter-spacing: .05em; }
    .banner { font-size: 12.5px; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; }
    .b-ok { background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.3); color: #6ee7b7; }
    .b-err { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: #fca5a5; }
    .b-warn { background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.3); color: #fcd34d; }
    table.ct { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.ct th { text-align: left; padding: 9px 10px; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: #8a8a94; border-bottom: 1px solid var(--o-stroke,#26262e); }
    table.ct td { padding: 10px; border-bottom: 1px solid rgba(255,255,255,.04); color: #d4d4d8; vertical-align: top; }
    .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--o-stroke,#26262e); margin-bottom: 16px; flex-wrap: wrap; }
    .tab { padding: 9px 14px; font-size: 12.5px; font-weight: 600; color: #8a8a94; border-bottom: 2px solid transparent; text-decoration: none; }
  </style>

  <div class="cw">
    <div class="admin-page-header" style="margin-bottom:14px;">
      <div class="admin-page-eyebrow">Mail</div>
      <h1 class="admin-page-title">Campaigns</h1>
      <p class="admin-page-sub">
        Bulk mail with a resolved audience, per-person merge fields and a real report. Campaign sending is kept apart from
        transactional mail (password resets, offer letters): a different From address, its own unsubscribe headers, and its own
        logs, so a bounce on a newsletter does not sit in the same record as a sign-in email.
      </p>
    </div>

    <div class="tabs">
      <a class="tab" href="/admin/mail/contacts">Contacts</a>
      <a class="tab" href="/admin/mail/lists">Lists &amp; segments</a>
      <a class="tab" style="color:#fff;border-bottom-color:#FF6A3D;" href="/admin/mail/campaigns">Campaigns</a>
    </div>

    {errMsg && <div class="banner b-err">{errMsg}</div>}
    {readFailures.length > 0 && (
      <div class="banner b-warn">
        <strong>Some of this page could not be read, so the list below may be incomplete.</strong>
        <ul style="margin:6px 0 0 16px;padding:0;">{readFailures.map((f) => <li>{f.source}: {f.reason}</li>)}</ul>
      </div>
    )}
    {transport.mode === 'none' && (
      <div class="banner b-warn">
        <strong>No outbound mail server is configured, so no campaign can send.</strong> {transport.detail}.
        Set it up in <a href="/admin/mail/settings" style="color:#fcd34d;">Mail settings</a> first.
      </div>
    )}

    <div style="display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start;">
      <div>
        <form method="GET" style="display:flex;gap:8px;align-items:end;margin-bottom:12px;">
          <div>
            <label class="lbl">Status</label>
            <select class="drop" name="status" onchange="this.form.submit()">
              <option value="any" selected={filter === 'any'}>All</option>
              {CAMPAIGN_STATES.map((s) => <option value={s} selected={filter === s}>{stateLabel(s)}</option>)}
            </select>
          </div>
        </form>

        <div class="card" style="padding:0;overflow:auto;">
          <table class="ct">
            <thead><tr><th>Campaign</th><th>Status</th><th>Progress</th><th>When</th></tr></thead>
            <tbody>
              {campaigns.map((c: any) => (
                <tr>
                  <td>
                    <a href={'/admin/mail/campaigns/' + c.id} style="color:#fff;font-weight:600;text-decoration:none;">{c.name}</a>
                    <div class="muted">{c.subject || 'no subject yet'}</div>
                    {c.stream === 'transactional' ? <div class="muted">transactional stream</div> : null}
                    {c.last_error ? <div style="color:#fca5a5;font-size:11.5px;margin-top:3px;">{c.last_error}</div> : null}
                  </td>
                  <td><span class="pill" style={toneStyle(c.status)}>{stateLabel(c.status)}</span></td>
                  <td>
                    {c.recipient_count > 0
                      ? <span>{c.sent_count} of {c.recipient_count} sent</span>
                      : <span class="muted">audience not resolved yet</span>}
                  </td>
                  <td class="muted">
                    {c.scheduled_at ? formatInZone(new Date(c.scheduled_at), c.time_zone || 'Asia/Kolkata') : ''}
                    {!c.scheduled_at && c.completed_at ? 'finished ' + new Date(c.completed_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : ''}
                    {!c.scheduled_at && !c.completed_at ? 'created ' + new Date(c.created_at).toLocaleDateString('en-GB') : ''}
                    {c.recurrence ? <div>repeats</div> : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {nothingMatched && <div style="padding:26px;text-align:center;color:#6e6e78;font-size:12.5px;">No campaign matches this filter. Every read on this page answered, so this is genuinely empty.</div>}
        </div>
      </div>

      <form method="POST" class="card">
        <input type="hidden" name="_action" value="create" />
        <h2 style="font-size:14px;font-weight:700;color:#fff;margin:0 0 10px;">New campaign</h2>
        <div style="display:grid;gap:10px;">
          <div><label class="lbl">Internal name</label><input class="inp" name="name" placeholder="e.g. Stage 3 progression, August" required /></div>
          <div><label class="lbl">Subject line</label><input class="inp" name="subject" placeholder="what the recipient sees" /></div>
          <div>
            <label class="lbl">Stream</label>
            <select class="drop" name="stream" style="width:100%;">
              <option value="campaign">Campaign — bulk, opt-out honoured, unsubscribe header</option>
              <option value="transactional">Transactional — one-to-one, tied to an application or account</option>
            </select>
          </div>
        </div>
        <p class="muted" style="margin:10px 0 0;">
          Campaign mail sends from <code>{DEFAULT_CAMPAIGN_FROM}</code> by default and requires an unsubscribe link in the body.
          Transactional mail does not, because an application update is not marketing and unsubscribing from it would leave
          somebody uninformed about their own application.
        </p>
        <div style="margin-top:12px;"><button class="prim" type="submit">Create and open</button></div>
      </form>
    </div>
  </div>
</AdminLayout>
