---
/**
 * /admin/mail/templates - create, edit and manage reusable email bodies.
 *
 * THIS SCREEN WROTE TO A TABLE NOTHING READ. `email_templates` appeared in exactly one file in the
 * repository - this one. The composer did not read it, /api/mail/send did not read it, mail.ts did
 * not read it. So the editor, the live preview, Duplicate, and the active/off toggle all worked
 * perfectly and produced rows that no send path could ever reach: a whole feature that could be
 * maintained but not used, with its own copy telling the operator to "load a template into the
 * composer" as though that were possible.
 *
 * The reader is now src/components/MailClient.astro, which takes `?template=<id>` on /admin/mail,
 * refuses a template that is switched off (which is what finally gives `is_active` a consumer), and
 * puts the body in the composer as HTML. The per-template "Use in composer" button below is the
 * link that was described here and did not exist.
 *
 * THE {{variables}} PROMISE WAS ALSO EMPTY, and the copy has been corrected rather than the
 * mechanism invented: nothing anywhere in the mail path substitutes a placeholder, and one message
 * row is addressed to many recipients, so a per-person merge is not a wording change - it is a
 * different send model. Until somebody builds it, the page says plainly that placeholders go out
 * literally. Telling the truth about a feature that does not exist is cheaper than an operator
 * discovering it in a mail to five hundred applicants addressed to {{first_name}}.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ensureOnce } from '@/lib/ensure-once';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// Declared before the POST handler that uses them: `const` is not hoisted, and a handler reaching a
// later declaration throws on its first line.
function rowsOf(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }
// The real Postgres reason is on e.cause; e.message is only the SQL that failed.
const dbReason = (e: any): string => String(e?.cause?.message || e?.message || 'unknown error');
// Every id on this page goes into a uuid column. Bound blind, a stale or hand-edited value raised
// 22P02, which reaches the operator as a database complaint about their own click.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// ONCE PER PROCESS, AND NOT IN SILENCE. The CREATE used to run on EVERY load of this page, and
// `.catch(() => {})` meant a bootstrap that failed left no trace at all while every statement after
// it failed for a reason nobody could see. ensureOnce() drops a failed run from its cache, so a
// transient hiccup is retried on the next request rather than poisoning the process; re-throwing
// inside is what makes that happen, and the log line is what makes it investigable.
await ensureOnce('mail.email_templates', async () => {
  try {
    // Additive, never DROP - live rows exist.
    await db.execute(sql`CREATE TABLE IF NOT EXISTS email_templates (
      id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
      template_key text NOT NULL,
      subject text NOT NULL,
      body_html text NOT NULL DEFAULT '',
      body_text text,
      description text,
      is_active boolean NOT NULL DEFAULT true,
      created_at timestamptz NOT NULL DEFAULT now(),
      updated_at timestamptz NOT NULL DEFAULT now()
    )`);
  } catch (e: any) {
    console.error('[admin/mail/templates] schema bootstrap failed:', dbReason(e));
    throw e;
  }
});

function slugify(s: string) { return (s || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 60); }
function htmlToText(h: string) { return (h || '').replace(/<style[\s\S]*?<\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim(); }

let okMsg = '', errMsg = '';
if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    const action = fd.get('_action') as string;
    if (action === 'save') {
      const id = (fd.get('id') as string || '').trim();
      const name = (fd.get('template_key') as string || '').trim();
      const subject = (fd.get('subject') as string || '').trim();
      const bodyHtml = (fd.get('body_html') as string || '').trim();
      const description = (fd.get('description') as string || '').trim() || null;
      const bodyText = htmlToText(bodyHtml) || null;
      if (!name || !subject || !bodyHtml) {
        errMsg = 'Name, subject and body are all required.';
      } else if (id) {
        // RETURNING, FOR THE SAME REASON THE `duplicate` ARM BELOW ALREADY HAS ITS GUARD. This was a
        // fire-and-forget UPDATE under an unconditional 'Template updated.', so an id from a list
        // rendered before somebody else deleted the row reported an edit that changed nothing, and
        // the operator left believing their new wording was what the composer would load.
        if (!UUID_RE.test(id)) errMsg = 'That template id is not valid, so nothing was saved.';
        else {
          const wrote = rowsOf(await db.execute(sql`UPDATE email_templates SET template_key=${slugify(name)}, subject=${subject}, body_html=${bodyHtml}, body_text=${bodyText}, description=${description}, updated_at=now() WHERE id=${id} RETURNING id`));
          if (wrote.length) okMsg = 'Template updated.';
          else errMsg = 'Nothing was updated: that template no longer exists. Reload the list before editing again.';
        }
      } else {
        const made = rowsOf(await db.execute(sql`INSERT INTO email_templates (template_key, subject, body_html, body_text, description) VALUES (${slugify(name)}, ${subject}, ${bodyHtml}, ${bodyText}, ${description}) RETURNING id`));
        if (made.length) okMsg = 'Template created.';
        else errMsg = 'The template was not created. Nothing has been saved; try again.';
      }
    } else if (action === 'delete') {
      const delId = (fd.get('id') as string || '').trim();
      if (!UUID_RE.test(delId)) errMsg = 'That template id is not valid, so nothing was deleted.';
      else {
        const gone = rowsOf(await db.execute(sql`DELETE FROM email_templates WHERE id=${delId} RETURNING id`));
        if (gone.length) okMsg = 'Template deleted.';
        else errMsg = 'Nothing was deleted: that template is already gone. Reload the list.';
      }
    } else if (action === 'toggle') {
      // THE MOST LOAD-BEARING OF THE THREE. is_active is what MailClient reads to REFUSE a
      // switched-off template in the composer, so 'Template visibility updated.' over an UPDATE that
      // matched no row left an operator believing a template was available to send when it was not,
      // or off when it was still live. The new state is now read back and named.
      const togId = (fd.get('id') as string || '').trim();
      if (!UUID_RE.test(togId)) errMsg = 'That template id is not valid, so nothing was changed.';
      else {
        const flipped = rowsOf(await db.execute(sql`UPDATE email_templates SET is_active = NOT is_active, updated_at=now() WHERE id=${togId} RETURNING id, is_active`));
        if (flipped.length) okMsg = 'Template is now ' + ((flipped[0] as any).is_active ? 'active and available in the composer.' : 'switched off, so the composer will refuse it.');
        else errMsg = 'Nothing was changed: that template no longer exists. Reload the list.';
      }
    } else if (action === 'duplicate') {
      // `okMsg = 'Template duplicated.'` used to sit OUTSIDE the `if (t)`, so duplicating a template
      // that had just been deleted in another tab reported success having inserted nothing at all.
      const id = (fd.get('id') as string || '').trim();
      const t = UUID_RE.test(id)
        ? (rowsOf(await db.execute(sql`SELECT template_key, subject, body_html, body_text, description FROM email_templates WHERE id=${id} LIMIT 1`))[0] as any)
        : null;
      if (t) {
        await db.execute(sql`INSERT INTO email_templates (template_key, subject, body_html, body_text, description) VALUES (${t.template_key + '_copy'}, ${t.subject}, ${t.body_html}, ${t.body_text}, ${t.description})`);
        okMsg = 'Template duplicated.';
      } else {
        errMsg = 'That template no longer exists, so nothing was copied.';
      }
    }
  } catch (e: any) {
    okMsg = '';
    console.error('[admin/mail/templates] write failed:', dbReason(e));
    errMsg = 'Nothing was saved: ' + dbReason(e);
  }
}

const templates = rowsOf(await db.execute(sql`SELECT id, template_key, subject, body_html, description, is_active, updated_at FROM email_templates ORDER BY updated_at DESC`));
const VARS = ['first_name', 'last_name', 'full_name', 'email', 'role_title', 'company', 'link'];
---
<AdminLayout title="Email Templates" activeNav="mail">
  <style>
    .tpl-wrap { padding: 18px; max-width: 1300px; }
    .tpl-grid { display: grid; grid-template-columns: 320px minmax(0,1fr); gap: 18px; align-items: start; }
    @media (max-width: 900px) { .tpl-grid { grid-template-columns: 1fr; } }
    .tpl-card { background: var(--o-panel2,#141418); border: 1px solid var(--o-stroke,#26262e); border-radius: 12px; }
    .tpl-item { padding: 12px 14px; border-bottom: 1px solid var(--o-stroke,#26262e); cursor: pointer; transition: background .1s; }
    .tpl-item:hover { background: rgba(255,255,255,0.03); }
    .tpl-item:last-child { border-bottom: none; }
    .tpl-name { font-size: 13px; font-weight: 600; color: #fff; }
    .tpl-sub { font-size: 11.5px; color: #8a8a94; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tpl-badge { font-size: 9px; font-weight: 700; padding: 1px 6px; border-radius: 100px; text-transform: uppercase; letter-spacing: .05em; }
    .lbl { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #8a8a94; display: block; margin-bottom: 5px; }
    .inp { width: 100%; background: #fff; color: #17181d; border: 1.5px solid #cbd0da; border-radius: 8px; padding: 9px 11px; font-size: 13.5px; }
    .inp:focus { border-color: #FF6A3D; outline: none; box-shadow: 0 0 0 3px rgba(255,106,61,.2); }
    .editor { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 1050px) { .editor { grid-template-columns: 1fr; } }
    .code { width: 100%; min-height: 320px; background: #0d0e13; color: #e6e7ec; border: 1px solid #2a2a33; border-radius: 8px; padding: 11px; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12.5px; line-height: 1.55; resize: vertical; }
    .prev { min-height: 320px; background: #fff; border: 1px solid #cbd0da; border-radius: 8px; overflow: auto; }
    .prev iframe { width: 100%; height: 100%; min-height: 320px; border: 0; }
    .tbtn { background: #262832; border: 1px solid #3a3c48; color: #e6e7ec; font-size: 11.5px; font-weight: 600; padding: 5px 9px; border-radius: 6px; cursor: pointer; }
    .tbtn:hover { background: #30323e; }
    .var { background: rgba(255,106,61,.12); border: 1px solid rgba(255,106,61,.3); color: #FF7040; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 100px; cursor: pointer; }
    .var:hover { background: rgba(255,106,61,.2); }
    .prim { background: #FF6A3D; color: #fff; border: none; font-weight: 700; padding: 9px 20px; border-radius: 8px; cursor: pointer; font-size: 13px; }
    .prim:hover { background: #ff5a28; }
    .ghost { background: #262832; color: #e6e7ec; border: 1px solid #3a3c48; font-weight: 600; padding: 9px 16px; border-radius: 8px; cursor: pointer; font-size: 12.5px; }
  </style>

  <div class="tpl-wrap">
    <div class="admin-page-header" style="margin-bottom:16px;">
      <div class="admin-page-eyebrow">Mail</div>
      <h1 class="admin-page-title">Email Templates</h1>
      <p class="admin-page-sub">Build reusable emails for marketing and updates. Edit the HTML with a live preview, then use <strong>Use in composer</strong> to open it in the mail composer, addressed to whoever you like (including an <code style="color:#FF7040;">@group:slug</code>). A template switched <em>off</em> will not load.</p>
      <p class="admin-page-sub" style="color:#fbbf24;">Placeholders such as <code style="color:#FF7040;">{'{{first_name}}'}</code> are <strong>not</strong> filled in by the composer - one message goes to all its recipients, so there is nothing to merge per person. Anything you leave in the body is sent literally here. Replace it before you send.</p>
      {/* This warning was written when nothing in the mail path merged anything, and that stopped
          being true when campaigns arrived. A blanket "never filled in" now sends people to strip
          placeholders out of copy that a campaign would have filled correctly. */}
      <p class="admin-page-sub"><a href="/admin/mail/campaigns" style="color:#FF7040;">Campaigns</a> <em>do</em> merge them, per person, with a fallback: write <code style="color:#FF7040;">{'{{first_name | default:"there"}}'}</code> there and nobody receives a blank or a raw placeholder.</p>
    </div>

    {okMsg && <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;font-size:12.5px;padding:10px 14px;border-radius:8px;margin-bottom:14px;">{okMsg}</div>}
    {errMsg && <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;font-size:12.5px;padding:10px 14px;border-radius:8px;margin-bottom:14px;">{errMsg}</div>}

    <div class="tpl-grid">
      <!-- List -->
      <div>
        <button type="button" class="prim" style="width:100%;margin-bottom:12px;" onclick="tplNew()">+ New template</button>
        <div class="tpl-card">
          {templates.length === 0 && <div style="padding:20px;text-align:center;color:#8a8a94;font-size:12.5px;">No templates yet. Create your first one.</div>}
          {templates.map((t: any) => (
            <div class="tpl-item" onclick={`tplLoad(${JSON.stringify(JSON.stringify(t)).replace(/"/g, '&quot;')})`}>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                <span class="tpl-name">{t.template_key}</span>
                <span class={'tpl-badge'} style={t.is_active ? 'background:rgba(16,185,129,.15);color:#6ee7b7;' : 'background:rgba(148,163,184,.15);color:#94a3b8;'}>{t.is_active ? 'active' : 'off'}</span>
              </div>
              <div class="tpl-sub">{t.subject}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Editor -->
      <form method="POST" class="tpl-card" style="padding:16px;" id="tplForm">
        <input type="hidden" name="_action" value="save" />
        <input type="hidden" name="id" id="f_id" value="" />

        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px;">
          <span id="f_title" style="font-size:15px;font-weight:700;color:#fff;">New template</span>
          <div style="display:flex;gap:8px;">
            <button type="button" class="ghost" id="dupBtn" style="display:none;" onclick="tplAction('duplicate')">Duplicate</button>
            <button type="button" class="ghost" id="toggleBtn" style="display:none;" onclick="tplAction('toggle')">Toggle active</button>
            <button type="button" class="ghost" id="delBtn" style="display:none;color:#fca5a5;border-color:rgba(239,68,68,.3);" data-danger="Delete this template?" onclick="tplAction('delete')">Delete</button>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div><label class="lbl">Template name</label><input class="inp" name="template_key" id="f_key" placeholder="e.g. diwali_offer" required /></div>
          <div><label class="lbl">Description (optional)</label><input class="inp" name="description" id="f_desc" placeholder="internal note" /></div>
        </div>
        <div style="margin-bottom:12px;"><label class="lbl">Subject line</label><input class="inp" name="subject" id="f_subject" placeholder="e.g. A special update for {{first_name}}" required /></div>

        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:6px;">
          <label class="lbl" style="margin:0;">Body (HTML) &amp; live preview</label>
          <div style="display:flex;gap:5px;flex-wrap:wrap;">
            <button type="button" class="tbtn" onclick="ins('<h2 style=\'font-family:Georgia,serif;color:#111;\'>Heading</h2>')">H</button>
            <button type="button" class="tbtn" onclick="ins('<p style=\'font-size:15px;line-height:1.6;color:#333;\'>Your text here.</p>')">P</button>
            <button type="button" class="tbtn" onclick="wrap('<strong>','</strong>')">B</button>
            <button type="button" class="tbtn" onclick="ins('<a href=\'{{link}}\'>Link text</a>')">Link</button>
            <button type="button" class="tbtn" onclick="ins('<a href=\'{{link}}\' style=\'display:inline-block;background:#FF4F00;color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:700;\'>Button</a>')">Button</button>
            <button type="button" class="tbtn" onclick="ins('<img src=\'https://\' alt=\'\' style=\'max-width:100%;\' />')">Img</button>
            <button type="button" class="tbtn" onclick="ins('<hr style=\'border:none;border-top:1px solid #eee;margin:20px 0;\' />')">HR</button>
          </div>
        </div>
        <div style="margin-bottom:8px;display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
          <span style="font-size:10.5px;color:#8a8a94;">Insert placeholder (NOT auto-filled - edit before sending):</span>
          {VARS.map((v) => <span class="var" onclick={`ins('{{${v}}}')`}>{'{{' + v + '}}'}</span>)}
        </div>

        <div class="editor">
          <textarea class="code" name="body_html" id="f_body" placeholder="<p>Hi {{first_name}}, ...</p>" oninput="renderPrev()"></textarea>
          <div class="prev"><iframe id="prevFrame" title="preview"></iframe></div>
        </div>

        <div style="display:flex;gap:10px;margin-top:14px;align-items:center;flex-wrap:wrap;">
          <button type="submit" class="prim">Save template</button>
          <button type="button" class="ghost" onclick="tplNew()">Clear</button>
          <!-- The link that this page promised and did not have. Hidden until a saved template is
               loaded, because there is nothing to carry into the composer before that. -->
          <a href="/admin/mail" class="ghost" id="useBtn" style="text-decoration:none;display:none;">Use in composer</a>
          <a href="/admin/mail" class="ghost" style="text-decoration:none;">Open composer empty</a>
        </div>
      </form>
    </div>
  </div>

  <!-- hidden helper forms for delete/toggle/duplicate -->
  <form method="POST" id="actionForm" style="display:none;"><input type="hidden" name="_action" id="a_action" /><input type="hidden" name="id" id="a_id" /></form>

  <script is:inline>
    var cur = null;
    function renderPrev() {
      var html = document.getElementById('f_body').value || '<p style="color:#999;font-family:sans-serif;padding:16px;">Preview appears here…</p>';
      var f = document.getElementById('prevFrame');
      f.srcdoc = '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head><body style="margin:0;padding:16px;font-family:Arial,sans-serif;">' + html + '</body></html>';
    }
    function tplNew() {
      cur = null;
      document.getElementById('f_id').value = '';
      document.getElementById('f_key').value = '';
      document.getElementById('f_desc').value = '';
      document.getElementById('f_subject').value = '';
      document.getElementById('f_body').value = '';
      document.getElementById('f_title').textContent = 'New template';
      ['dupBtn','toggleBtn','delBtn'].forEach(function(id){ document.getElementById(id).style.display = 'none'; });
      document.getElementById('useBtn').style.display = 'none';
      renderPrev();
    }
    function tplLoad(json) {
      var t = JSON.parse(json);
      cur = t;
      document.getElementById('f_id').value = t.id;
      document.getElementById('f_key').value = t.template_key || '';
      document.getElementById('f_desc').value = t.description || '';
      document.getElementById('f_subject').value = t.subject || '';
      document.getElementById('f_body').value = t.body_html || '';
      document.getElementById('f_title').textContent = 'Editing: ' + t.template_key;
      ['dupBtn','toggleBtn','delBtn'].forEach(function(id){ document.getElementById(id).style.display = 'inline-block'; });
      // Carries the SAVED template into the composer by id. Unsaved edits in the box are not sent
      // along - the composer reads the row, so what you get is what is stored.
      var use = document.getElementById('useBtn');
      use.href = '/admin/mail?template=' + encodeURIComponent(t.id);
      use.style.display = 'inline-block';
      renderPrev();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function tplAction(action) {
      if (!cur) return;
      document.getElementById('a_action').value = action;
      document.getElementById('a_id').value = cur.id;
      document.getElementById('actionForm').submit();
    }
    function ins(text) {
      var ta = document.getElementById('f_body');
      var s = ta.selectionStart, e = ta.selectionEnd;
      ta.value = ta.value.slice(0, s) + text + ta.value.slice(e);
      ta.focus(); ta.selectionStart = ta.selectionEnd = s + text.length;
      renderPrev();
    }
    function wrap(a, b) {
      var ta = document.getElementById('f_body');
      var s = ta.selectionStart, e = ta.selectionEnd;
      var sel = ta.value.slice(s, e) || 'text';
      ta.value = ta.value.slice(0, s) + a + sel + b + ta.value.slice(e);
      ta.focus(); renderPrev();
    }
    renderPrev();
  </script>
<script src="/admin-danger.js" defer></script>
<script is:inline>
  /* FAIL CLOSED. If /admin-danger.js did not load — cached 404, blocked request, parse error —
     every data-danger control above would submit on the FIRST click with no confirmation at all.
     These are delete and revoke buttons, so the safe direction when the guard is missing is a
     dialog, not nothing. This runs only in that case and adds no behaviour when the guard is
     present. */
  window.addEventListener('load', function () {
    if (window.installDanger) return;
    console.warn('[admin-danger] guard script did not load; falling back to confirm()');
    Array.prototype.forEach.call(document.querySelectorAll('[data-danger]'), function (el) {
      var q = el.getAttribute('data-danger');
      var form = el.tagName === 'FORM' ? el : el.form;
      if (form) form.addEventListener('submit', function (e) { if (!confirm(q)) e.preventDefault(); });
      else el.addEventListener('click', function (e) { if (!confirm(q)) e.preventDefault(); });
    });
  });
</script>
</AdminLayout>
