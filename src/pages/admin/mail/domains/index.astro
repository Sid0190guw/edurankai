---
// /admin/mail/domains — every domain this organization has added, and what state each one is in.
//
// The list answers three questions per row that people usually have to ask support: is it verified,
// can it send, and what is the next thing to do. The "next thing" is derived from the last check,
// never stored, so a domain whose SPF record was deleted last month stops saying "all set".
import AdminLayout from '@/layouts/AdminLayout.astro';
import { platformAuth } from '@/lib/mailplatform/adapters/auth-platform';
import { listDomains } from '@/lib/mailplatform/domains/store';
import { domainListView, WIZARD_STEPS } from '@/lib/mailplatform/domains/service';
import { getProfile, profileCapabilities } from '@/lib/mailplatform/profile';
import { can } from '@/lib/mailplatform/permissions';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// Every const is declared before anything that reads it. `const` is not hoisted, and a const used
// above its declaration has taken pages on this project down on their first line.
const causeOf = (e: any): string => String(e?.cause?.message || e?.message || 'unknown error');
const profile = getProfile();
const caps = profileCapabilities(profile);

const principal = await platformAuth().authenticate({ request: Astro.request, locals: Astro.locals });
const mayRead = can(principal, 'domains.read');
const mayManage = can(principal, 'domains.manage');

let rowsView: Awaited<ReturnType<typeof domainListView>> = [];
let readError = '';
if (principal && mayRead) {
  try {
    const domains = await listDomains(principal.orgId);
    rowsView = await domainListView({ principal }, domains);
  } catch (e: any) {
    // A failed read is shown as a failed read. An empty list drawn over a database error would say
    // "you have no domains" to somebody who has twelve.
    readError = causeOf(e);
    console.error('[admin/mail/domains] list failed -', readError);
  }
}

// Display values are resolved HERE, not in the markup. `.astro` will not accept a
// Record<string,string> indexed inside JSX, and beyond that rule, a template that only maps over
// arrays of already-decided values is a template with no logic left to get wrong.
const LIFECYCLE_LEGEND = [
  { key: 'ACTIVE', fg: '#6ee7b7', bg: 'rgba(16,185,129,0.14)', note: 'Verified and sending.' },
  { key: 'VERIFIED', fg: '#7dd3fc', bg: 'rgba(56,189,248,0.14)', note: 'Ownership confirmed. Sending is not switched on yet.' },
  { key: 'PENDING', fg: '#fbbf24', bg: 'rgba(251,191,36,0.14)', note: 'Waiting for the ownership record.' },
  { key: 'VERIFYING', fg: '#fbbf24', bg: 'rgba(251,191,36,0.14)', note: 'Checks have not completed.' },
  { key: 'SUSPENDED', fg: '#a1a1aa', bg: 'rgba(161,161,170,0.14)', note: 'Switched off by an administrator.' },
  { key: 'FAILED', fg: '#fca5a5', bg: 'rgba(239,68,68,0.14)', note: 'The last check did not pass.' },
];
function lifecycleStyle(key: string) {
  return LIFECYCLE_LEGEND.find((l) => l.key === key) || LIFECYCLE_LEGEND[2];
}
function summaryColor(level: string): string {
  if (level === 'pass') return '#6ee7b7';
  if (level === 'warn') return '#fbbf24';
  if (level === 'fail') return '#fca5a5';
  return '#a1a1aa';
}
const fmt = (d: string | null): string => {
  if (!d) return 'never';
  try {
    return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  } catch { return ''; }
};

const cards = rowsView.map((row) => {
  const style = lifecycleStyle(row.domain.lifecycle);
  const step = WIZARD_STEPS.find((s) => s.step === row.step);
  return {
    href: '/admin/mail/domains/' + row.domain.id,
    name: row.domain.domain,
    purposeLabel: row.domain.purpose === 'both' ? 'Sending and receiving' : row.domain.purpose === 'sending' ? 'Sending only' : 'Receiving only',
    checkedLabel: fmt(row.domain.lastCheckedAt),
    lifecycle: row.domain.lifecycle,
    badgeStyle: 'font-size:10.5px;font-weight:700;letter-spacing:0.08em;padding:4px 10px;border-radius:999px;color:' + style.fg + ';background:' + style.bg + ';',
    summaryText: row.summary ? row.summary.text : '',
    summaryStyle: 'font-size:11.5px;font-weight:600;color:' + (row.summary ? summaryColor(row.summary.level) : '#a1a1aa') + ';',
    stepLabel: 'Step ' + row.step + ' of 6 - ' + (step ? step.title : 'Review'),
  };
});
---
<AdminLayout title="Mail Domains" activeNav="mail">
<div class="admin-page" style="max-width:1000px;">
  <div class="admin-page-header" style="margin-bottom:18px;">
    <div class="admin-page-title-block">
      <div class="admin-page-eyebrow">Mail</div>
      <h1 class="admin-page-title">Domains</h1>
      <p class="admin-page-sub">
        Connect a domain so mail can be sent and received from it.
        <a href="/admin/mail/mailboxes" style="color:#FF7040;text-decoration:none;">Mailboxes</a> &middot;
        <a href="/admin/mail/health" style="color:#FF7040;text-decoration:none;">Mail Health</a> &middot;
        <a href="/admin/mail/settings" style="color:#FF7040;text-decoration:none;">Settings</a>
      </p>
    </div>
  </div>

  {!principal && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 4px;">This account is not a member of a mail organization.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">Signing in to the admin console does not by itself grant access to the mail platform. An owner has to add you as a member.</p>
    </div>
  )}

  {principal && !mayRead && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0;">Your role does not include permission to view domains.</p>
    </div>
  )}

  {principal && mayRead && (
    <>
      {profile.source === 'fallback' && (
        <div style="background:rgba(251,191,36,0.10);border:1px solid rgba(251,191,36,0.30);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
          <p style="font-size:12.5px;font-weight:700;color:#fbbf24;margin:0 0 6px;">This deployment has not been told where its mail leaves from.</p>
          <p style="font-size:12px;color:#d8d8de;margin:0 0 8px;line-height:1.6;">Domains can still be added and their ownership verified. The DNS records for sending and receiving cannot be generated, because doing so would mean printing a hostname for infrastructure nobody runs — and a customer who published it would break their own mail.</p>
          <ul style="font-size:11.5px;color:#fbbf24;margin:0;padding-left:18px;line-height:1.7;font-family:'Geist Mono',monospace;">
            {caps.missing.map((m: string) => <li>{m}</li>)}
          </ul>
        </div>
      )}

      {readError && (
        <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
          <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 4px;">The domain list could not be read, so nothing below is a statement about your domains.</p>
          <p style="font-size:11.5px;color:#fca5a5;margin:0;font-family:'Geist Mono',monospace;">{readError}</p>
        </div>
      )}

      {mayManage && (
        <div class="admin-card" style="margin-bottom:18px;">
          <div class="admin-card-title" style="margin-bottom:8px;">Add a domain</div>
          <p style="font-size:12px;color:#8a8a94;margin:0 0 12px;line-height:1.6;">
            Enter it the way it appears after the @ in an email address. A subdomain such as
            <code style="font-family:'Geist Mono',monospace;background:#08080a;padding:1px 6px;border-radius:4px;color:#FF7040;">careers.edurankai.in</code>
            is a domain in its own right here. Adding one changes nothing about mail you already receive.
          </p>
          <form id="addForm" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <input id="domainInput" type="text" placeholder="example.com" autocomplete="off" required
              style="flex:1;min-width:220px;background:#08080a;border:1px solid #2a2a2f;color:#fff;font-size:13px;font-family:'Geist Mono',monospace;padding:9px 12px;border-radius:8px;" />
            <select id="purposeInput" style="background:#08080a;border:1px solid #2a2a2f;color:#d8d8de;font-size:12.5px;padding:9px 12px;border-radius:8px;">
              <option value="both">Send and receive</option>
              <option value="sending">Send only</option>
              <option value="receiving">Receive only</option>
            </select>
            <button type="submit" id="addBtn" style="background:#FF4F00;color:#fff;border:none;font-size:12.5px;font-weight:700;padding:9px 18px;border-radius:8px;cursor:pointer;">Add domain</button>
          </form>
          <p id="addError" style="display:none;font-size:12px;color:#fca5a5;margin:10px 0 0;line-height:1.6;"></p>
        </div>
      )}

      {rowsView.length === 0 && !readError ? (
        <div class="admin-card">
          <p style="font-size:13px;color:#d8d8de;margin:0 0 6px;font-weight:600;">No domains yet.</p>
          <p style="font-size:12px;color:#8a8a94;margin:0;line-height:1.6;">Add the domain your mail comes from. You will be walked through six steps, and nothing you do changes your existing mail until the last one.</p>
        </div>
      ) : (
        <div style="display:flex;flex-direction:column;gap:10px;">
          {cards.map((c) => (
            <a href={c.href} style="display:block;text-decoration:none;background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px 16px;">
              <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;">
                <div style="min-width:0;">
                  <p style="font-size:14.5px;font-weight:700;color:#fff;margin:0 0 4px;font-family:'Geist Mono',monospace;">{c.name}</p>
                  <p style="font-size:11.5px;color:#8a8a94;margin:0;">{c.purposeLabel} &middot; last checked {c.checkedLabel}</p>
                </div>
                <div style="display:flex;align-items:center;gap:10px;">
                  {c.summaryText && <span style={c.summaryStyle}>{c.summaryText}</span>}
                  <span style={c.badgeStyle}>{c.lifecycle}</span>
                </div>
              </div>
              <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
                <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#6e6e78;">Next</span>
                <span style="font-size:12px;color:#d8d8de;">{c.stepLabel}</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="admin-card" style="margin-top:18px;">
        <div class="admin-card-title" style="margin-bottom:8px;">What the states mean</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px;">
          {LIFECYCLE_LEGEND.map((l) => (
            <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:9px 11px;">
              <span style={'font-size:10.5px;font-weight:700;letter-spacing:0.08em;color:' + l.fg + ';'}>{l.key}</span>
              <p style="font-size:11.5px;color:#8a8a94;margin:4px 0 0;line-height:1.5;">{l.note}</p>
            </div>
          ))}
        </div>
      </div>
    </>
  )}
</div>

<script>
  // Kept at the top level of the file, never inside a conditional block: a <script> inside a JSX
  // conditional breaks .astro parsing on this project.
  const form = document.getElementById('addForm');
  const errorEl = document.getElementById('addError') as HTMLElement | null;
  const btn = document.getElementById('addBtn') as HTMLButtonElement | null;
  if (form && errorEl && btn) {
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const domain = (document.getElementById('domainInput') as HTMLInputElement).value.trim();
      const purpose = (document.getElementById('purposeInput') as HTMLSelectElement).value;
      if (!domain) return;
      errorEl.style.display = 'none';
      btn.textContent = 'Adding...';
      btn.setAttribute('disabled', 'true');
      try {
        const r = await fetch('/api/mail/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain, purpose }),
        });
        const d = await r.json();
        if (d.ok && d.data?.id) {
          window.location.href = '/admin/mail/domains/' + d.data.id;
          return;
        }
        // The server's sentence is shown as written. Rewriting it here would mean two places to fix
        // when the reason changes.
        errorEl.textContent = d.error || 'The domain could not be added.';
        errorEl.style.display = 'block';
      } catch (err) {
        errorEl.textContent = 'The request did not reach the server: ' + String(err);
        errorEl.style.display = 'block';
      }
      btn.textContent = 'Add domain';
      btn.removeAttribute('disabled');
    });
  }
</script>
</AdminLayout>
