---
// /admin/mail/enterprise/holds — records that must survive the retention policy.
//
// A HOLD STOPS DELETION. IT DOES NOT GRANT ACCESS. That distinction is collapsed in most systems and
// is the difference between a retention control and a surveillance tool: if placing a hold let
// somebody read the held mail, then anybody who can type a matter reference could read a customer's
// correspondence. Reading content needs a support authorisation, from a different person, under a
// different capability, audited on every use.
//
// PLACING IS A PLATFORM ACT; RELEASING IS THE OWNER'S. Placing over-preserves, which is recoverable.
// Releasing makes records deletable, which is not.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { HOLD_SCOPES, listHolds } from '@/lib/mailgov/holds';
import { getOrg, listOrgs } from '@/lib/mailgov/orgs';
import { authorizeGov } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'hold.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;

let holds: any[] = [];
let readError: string | null = null;
let org: any = null;
let orgs: any[] = [];

if (decision.allowed) {
  const list = await listHolds({ orgId, limit: 200 });
  if (list.ok) holds = list.rows; else readError = list.reason;
  if (orgId) {
    const one = await getOrg(orgId);
    if (one.ok) org = one.org;
  } else {
    const l = await listOrgs({ orgId: actor.orgId, limit: 200 });
    if (l.ok) orgs = l.rows;
  }
}

const mayPlace = authorizeGov(actor, 'hold.place', { orgId: orgId || undefined }).allowed;
const mayRelease = authorizeGov(actor, 'hold.release', { orgId: orgId || undefined }).allowed;
const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:6px 9px;border-radius:6px;font-size:12px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11px;font-weight:700;padding:6px 12px;border-radius:6px;cursor:pointer;';
---

<GovShell
  title="Legal holds"
  actor={actor}
  capability="hold.view"
  org={org ? { id: org.id, name: org.name } : null}
  subtitle="Preservation despite the retention policy. Preservation only — never access."
>
  {readError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">The hold list could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0 0 6px;font-family:'Geist Mono',monospace;">{readError}</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">
        The retention sweep treats this same failure as "everything is held" and deletes nothing, so no
        records are at risk while it persists.
      </p>
    </div>
  )}

  {!orgId && (
    <div class="admin-card" style="margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:10px;">Choose an organization</div>
      {orgs.map((o: any) => (
        <a href={'/admin/mail/enterprise/holds?org=' + o.id}
           style="display:block;padding:9px 0;border-bottom:1px solid #17171c;text-decoration:none;font-size:12.5px;color:#fff;">{o.name}</a>
      ))}
    </div>
  )}

  {orgId && mayPlace && (
    <div class="admin-card" style="margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:8px;">Place a hold</div>
      <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
        A matter reference is required and can be the customer's own — most matters will not exist in our
        matter register. Any scope other than "organization" needs the exact record it covers; a narrow
        label with no reference would pin everything while appearing not to.
      </p>
      <form data-gov-post="/api/mail/gov/holds" data-gov-confirm="Place this hold? The records it covers stop being deletable.">
        <input type="hidden" name="action" value="place" />
        <input type="hidden" name="orgId" value={orgId} />
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
          <input name="matterRef" placeholder="Matter reference" style={inputStyle + 'width:180px;'} required />
          <select name="scope" style={inputStyle}>
            {HOLD_SCOPES.map((s) => <option value={s}>{s}</option>)}
          </select>
          <input name="scopeRef" placeholder="the exact record (blank for organization-wide)" style={inputStyle + 'flex:1;min-width:220px;'} />
        </div>
        <input name="reason" placeholder="Why (at least 20 characters) — this is what the organization is shown when their deletion is refused" style={inputStyle + 'width:100%;margin-top:8px;'} required minlength="20" />
        <button type="submit" style={btn('#b45309') + 'margin-top:8px;'}>Place hold</button>
      </form>
    </div>
  )}

  <div class="admin-card">
    <div class="admin-card-title" style="margin-bottom:10px;">{holds.length} hold{holds.length === 1 ? '' : 's'}</div>
    {holds.length === 0 && !readError && (
      <p style="font-size:12px;color:#9aa6b6;margin:0;">No holds have been placed.</p>
    )}
    {holds.map((h: any) => (
      <div style="padding:11px 0;border-bottom:1px solid #17171c;">
        <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
          <span style={'width:8px;height:8px;border-radius:50%;flex-shrink:0;background:' + (h.status === 'active' ? '#fbbf24' : '#6e6e78') + ';'}></span>
          <span style="font-size:12.5px;font-weight:700;color:#fff;font-family:'Geist Mono',monospace;">{h.matterRef}</span>
          <span style="font-size:11.5px;color:#9aa6b6;">{h.scope}{h.scopeRef ? ': ' + h.scopeRef : ' (everything)'}</span>
          <span style="font-size:10.5px;color:#6e6e78;">{h.status}</span>
          <span style="margin-left:auto;font-size:10.5px;color:#6e6e78;font-family:'Geist Mono',monospace;">{h.placedAt.slice(0, 19).replace('T', ' ')}</span>
        </div>
        <p style="font-size:11.5px;color:#d8d8de;margin:5px 0 0;line-height:1.6;">{h.reason}</p>
        {h.releaseReason && <p style="font-size:11px;color:#9aa6b6;margin:4px 0 0;">Released: {h.releaseReason}</p>}
        {mayRelease && h.status === 'active' && (
          <form data-gov-post="/api/mail/gov/holds" data-gov-confirm="Release this hold? The records it covers become deletable again." style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
            <input type="hidden" name="action" value="release" />
            <input type="hidden" name="orgId" value={h.orgId} />
            <input type="hidden" name="id" value={h.id} />
            <input name="reason" placeholder="Why it is being released (at least 20 characters)" style={inputStyle + 'flex:1;min-width:260px;'} required minlength="20" />
            <button type="submit" style={btn('#dc2626')}>Release</button>
          </form>
        )}
      </div>
    ))}
  </div>

  <GovActions />
</GovShell>
