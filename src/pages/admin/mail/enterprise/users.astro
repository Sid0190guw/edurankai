---
// /admin/mail/enterprise/users — memberships, roles, sessions, and platform appointments.
//
// THE ROLE PICKER ONLY OFFERS ROLES THE VIEWER MAY ACTUALLY GRANT. assignableRoles() is the same rank
// rule authorizeGov() enforces on the way in, so the form cannot present a choice the server will
// refuse — an escalation attempt should be impossible to make by accident, and a refusal should mean
// somebody tried.
//
// "Revoke sessions" is labelled as what it is: this repository has ONE session store, so it signs the
// person out of EduRankAI entirely, not only out of the mail platform. That belongs on the button,
// not in a document nobody opens.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { listMembers, listPlatformGrants } from '@/lib/mailgov/users';
import { getOrg } from '@/lib/mailgov/orgs';
import { assignableRoles, authorizeGov, GOV_ROLE_LABEL, ORG_MEMBER_ROLES, govRoleForMembership } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'user.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;

let members: any[] = [];
let readError: string | null = null;
let org: any = null;
let grants: any[] = [];
let grantsError: string | null = null;

if (decision.allowed) {
  const list = await listMembers({ orgId, q: Astro.url.searchParams.get('q'), limit: 200 });
  if (list.ok) members = list.rows; else readError = list.reason;

  if (orgId) {
    const one = await getOrg(orgId);
    if (one.ok) org = one.org;
  }

  if (authorizeGov(actor, 'platform.grant', { platformWide: true }).allowed) {
    const g = await listPlatformGrants(false);
    if (g.ok) grants = g.rows; else grantsError = g.reason;
  }
}

const may = (cap: any): boolean => authorizeGov(actor, cap, { orgId: orgId || undefined }).allowed;
const grantable = assignableRoles(actor).filter((r) => r === 'platform_admin' || r === 'support' || r === 'auditor');

// Membership roles this viewer may assign: a role whose governance meaning is at or above their own
// is filtered out here as well as refused at the door.
const assignableMemberships = ORG_MEMBER_ROLES.filter((m) => {
  const gov = govRoleForMembership(m);
  return gov === 'none' || assignableRoles(actor).includes(gov);
});

const inputStyle = 'width:100%;background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:7px 10px;border-radius:6px;font-size:12px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11px;font-weight:700;padding:5px 10px;border-radius:6px;cursor:pointer;';
---

<GovShell
  title="Users and memberships"
  actor={actor}
  capability="user.view"
  org={org ? { id: org.id, name: org.name } : null}
  subtitle="Membership, roles, suspension and sessions. This platform does not create sign-in accounts."
>
  {readError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">The membership list could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;font-family:'Geist Mono',monospace;">{readError}</p>
    </div>
  )}

  {orgId && may('user.create') && (
    <div class="admin-card" style="margin-bottom:16px;">
      <div class="admin-card-title" style="margin-bottom:8px;">Add somebody to this organization</div>
      <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
        The person needs an EduRankAI account already. This platform deliberately does not create sign-in
        accounts: a second identity system would mean a second password policy and a second recovery path.
      </p>
      <form data-gov-post="/api/mail/gov/users" style="display:grid;grid-template-columns:2fr 1fr auto;gap:8px;align-items:end;">
        <input type="hidden" name="action" value="create" />
        <input type="hidden" name="orgId" value={orgId} />
        <input name="email" type="email" placeholder="their@address" style={inputStyle} required />
        <select name="role" style={inputStyle}>
          {assignableMemberships.map((r) => <option value={r}>{r}</option>)}
        </select>
        <button type="submit" style={btn('#FF4F00') + 'padding:7px 14px;'}>Add</button>
      </form>
    </div>
  )}

  <div class="admin-card" style="margin-bottom:16px;">
    <div class="admin-card-title" style="margin-bottom:10px;">
      {orgId ? 'Members' : 'Memberships across every organization'}
    </div>
    {members.length === 0 && !readError && (
      <p style="font-size:12px;color:#9aa6b6;margin:0;">No memberships recorded.</p>
    )}
    {members.map((m: any) => (
      <div style="padding:12px 0;border-bottom:1px solid #17171c;">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <span style={'width:8px;height:8px;border-radius:50%;flex-shrink:0;background:'
            + (m.status === 'active' ? '#34d399' : m.status === 'removed' ? '#6e6e78' : '#fbbf24') + ';'}></span>
          <span style="font-size:12.5px;font-weight:700;color:#fff;">{m.name || m.email || m.userId}</span>
          <span style="font-size:11px;color:#6e6e78;font-family:'Geist Mono',monospace;">{m.email}</span>
          <span style="font-size:11px;color:#FF7040;">{m.role}</span>
          <span style="font-size:10.5px;color:#9aa6b6;">{GOV_ROLE_LABEL[m.govRole]}</span>
          <span style="font-size:10.5px;color:#9aa6b6;">{m.status}</span>
          {!orgId && m.orgName && <span style="font-size:10.5px;color:#6e6e78;">{m.orgName}</span>}
          <span style="margin-left:auto;font-size:10.5px;color:#6e6e78;font-family:'Geist Mono',monospace;">
            {m.activeSessions === null ? 'sessions unknown' : m.activeSessions + ' active session(s)'}
          </span>
        </div>
        {m.suspendedReason && (
          <p style="font-size:11px;color:#fbbf24;margin:6px 0 0;line-height:1.6;">Reason on record: {m.suspendedReason}</p>
        )}
        {m.accountActive === false && (
          <p style="font-size:11px;color:#fca5a5;margin:6px 0 0;">Their EduRankAI account is deactivated, so they cannot sign in at all.</p>
        )}

        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
          {may('user.suspend') && m.status === 'active' && (
            <form data-gov-post="/api/mail/gov/users" data-gov-confirm="Suspend this person from the organization?" style="display:flex;gap:4px;">
              <input type="hidden" name="action" value="suspend" />
              <input type="hidden" name="orgId" value={m.orgId} />
              <input type="hidden" name="userId" value={m.userId} />
              <input name="reason" placeholder="reason" style={inputStyle + 'width:150px;padding:4px 8px;'} required minlength="5" />
              <button type="submit" style={btn('#b45309')}>Suspend</button>
            </form>
          )}
          {may('user.restore') && m.status !== 'active' && m.status !== 'removed' && (
            <form data-gov-post="/api/mail/gov/users" style="display:flex;gap:4px;">
              <input type="hidden" name="action" value="restore" />
              <input type="hidden" name="orgId" value={m.orgId} />
              <input type="hidden" name="userId" value={m.userId} />
              <button type="submit" style={btn('#059669')}>Restore</button>
            </form>
          )}
          {may('user.role.change') && m.status !== 'removed' && (
            <form data-gov-post="/api/mail/gov/users" style="display:flex;gap:4px;">
              <input type="hidden" name="action" value="change_role" />
              <input type="hidden" name="orgId" value={m.orgId} />
              <input type="hidden" name="userId" value={m.userId} />
              <select name="role" style={inputStyle + 'width:auto;padding:4px 8px;'}>
                {assignableMemberships.map((r) => <option value={r} selected={r === m.role}>{r}</option>)}
              </select>
              <button type="submit" style={btn('#2563eb')}>Set role</button>
            </form>
          )}
          {may('user.sessions.revoke') && (
            <form data-gov-post="/api/mail/gov/users" data-gov-confirm="Sign this person out of EduRankAI everywhere? This is account-wide, not mail-only." style="display:flex;gap:4px;">
              <input type="hidden" name="action" value="revoke_sessions" />
              <input type="hidden" name="orgId" value={m.orgId} />
              <input type="hidden" name="userId" value={m.userId} />
              <button type="submit" style={btn('#7c3aed')}>Revoke sessions (account-wide)</button>
            </form>
          )}
          {may('user.membership.remove') && m.status !== 'removed' && (
            <form data-gov-post="/api/mail/gov/users" data-gov-confirm="Remove this membership?" style="display:flex;gap:4px;">
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="orgId" value={m.orgId} />
              <input type="hidden" name="userId" value={m.userId} />
              <input name="reason" placeholder="reason" style={inputStyle + 'width:150px;padding:4px 8px;'} />
              <button type="submit" style={btn('#dc2626')}>Remove</button>
            </form>
          )}
        </div>
      </div>
    ))}
  </div>

  {may('platform.grant') && (
    <div class="admin-card">
      <div class="admin-card-title" style="margin-bottom:8px;">Platform appointments</div>
      <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
        Support engineers and auditors are appointed here and nowhere else. Holding an EduRankAI admin role
        does not make somebody a support engineer on this platform. Platform ownership is not grantable at
        all: it is a deployment setting, so one compromised administrator cannot become every administrator.
      </p>
      <p style="font-size:11.5px;color:#fbbf24;margin:0 0 10px;line-height:1.6;">
        A grant on its own does not open these SCREENS. src/middleware.ts puts canOpenAdmin() in front of
        every /admin path, so somebody appointed support or auditor also needs an admin-capable EduRankAI
        role to load the console in a browser; without one they can still use the governance API, which
        middleware exempts. That is the existing door and this patch did not widen it — say so when you
        appoint somebody, rather than letting them discover it.
      </p>
      {grantsError && <p style="font-size:12px;color:#fca5a5;margin:0 0 8px;">The grant list could not be read: {grantsError}</p>}

      {grants.map((g: any) => (
        <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #17171c;flex-wrap:wrap;">
          <span style="font-size:12px;color:#fff;font-weight:600;">{g.name || g.email}</span>
          <span style="font-size:11px;color:#FF7040;font-family:'Geist Mono',monospace;">{g.role}</span>
          <span style="font-size:10.5px;color:#6e6e78;">{g.reason}</span>
          <form data-gov-post="/api/mail/gov/users" data-gov-confirm="Revoke this appointment?" style="margin-left:auto;display:flex;gap:4px;">
            <input type="hidden" name="action" value="revoke_platform_role" />
            <input type="hidden" name="grantId" value={g.id} />
            <input name="reason" placeholder="reason" style={inputStyle + 'width:150px;padding:4px 8px;'} />
            <button type="submit" style={btn('#dc2626')}>Revoke</button>
          </form>
        </div>
      ))}

      <form data-gov-post="/api/mail/gov/users" style="display:grid;grid-template-columns:2fr 1fr 2fr auto;gap:8px;align-items:end;margin-top:12px;">
        <input type="hidden" name="action" value="grant_platform_role" />
        <input name="email" type="email" placeholder="their@address" style={inputStyle} required />
        <select name="role" style={inputStyle}>
          {grantable.map((r) => <option value={r}>{r}</option>)}
        </select>
        <input name="reason" placeholder="Why (at least 10 characters)" style={inputStyle} required minlength="10" />
        <button type="submit" style={btn('#FF4F00') + 'padding:7px 14px;'}>Appoint</button>
      </form>
    </div>
  )}

  <GovActions />
</GovShell>
