---
// /admin/mail/enterprise/organizations — organization administration.
//
// Four separate stops rather than one big switch, because "suspend the tenant" is almost never what
// an incident actually calls for. A campaign generating complaints needs campaigns stopped while
// receipts and password resets keep flowing; a leaked key needs rotation, not an outage. Each control
// is its own button with its own capability and its own audit action.
//
// ROTATION IS LABELLED AS AN OUTAGE, on the button, before it is pressed. Every integration using an
// older key starts failing the moment it completes — that is what rotation means, and a screen that
// does not say so produces an incident an hour later.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { getOrg, listOrgs, orgUsage } from '@/lib/mailgov/orgs';
import { authorizeGov } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'org.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;

let orgs: any[] = [];
let listError: string | null = null;
let current: any = null;
let usage: Awaited<ReturnType<typeof orgUsage>> | null = null;

if (decision.allowed) {
  const list = await listOrgs({ orgId: actor.orgId, limit: 200 });
  if (list.ok) orgs = list.rows; else listError = list.reason;

  if (orgId) {
    const one = await getOrg(orgId);
    if (one.ok) {
      current = one.org;
      usage = await orgUsage(orgId);
    } else {
      listError = one.reason || null;
    }
  }
}

const may = (cap: any): boolean => authorizeGov(actor, cap, { orgId: orgId || undefined }).allowed;

const inputStyle = 'width:100%;background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:7px 10px;border-radius:6px;font-size:12px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11.5px;font-weight:700;padding:7px 14px;border-radius:6px;cursor:pointer;';
const statNum = (v: number | null): string => (v === null ? 'not available here' : String(v));
---

<GovShell
  title="Organizations"
  actor={actor}
  capability="org.view"
  org={current ? { id: current.id, name: current.name } : null}
  subtitle="Suspend, restore, stop sending, stop receiving, stop campaigns, rotate credentials."
>
  {listError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">Something on this page could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;font-family:'Geist Mono',monospace;">{listError}</p>
    </div>
  )}

  {!current && (
    <div class="admin-card">
      <div class="admin-card-title" style="margin-bottom:10px;">Choose an organization</div>
      {orgs.length === 0 && !listError && (
        <p style="font-size:12px;color:#9aa6b6;margin:0;">No organizations exist on this deployment yet.</p>
      )}
      {orgs.map((o: any) => (
        <a href={'/admin/mail/enterprise/organizations?org=' + o.id}
           style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #17171c;text-decoration:none;">
          <span style={'width:8px;height:8px;border-radius:50%;flex-shrink:0;background:'
            + (o.status === 'suspended' || !o.isActive ? '#f87171' : '#34d399') + ';'}></span>
          <span style="font-size:13px;color:#fff;font-weight:600;">{o.name}</span>
          <span style="font-size:11px;color:#8a8a94;font-family:'Geist Mono',monospace;">{o.slug}</span>
          <span style="margin-left:auto;font-size:11px;color:#9aa6b6;">{o.status}</span>
        </a>
      ))}
    </div>
  )}

  {current && (
    <div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px;">
        {[
          { label: 'Status', value: current.status, warn: current.status !== 'active' },
          { label: 'Sending', value: current.sendingEnabled ? 'on' : 'stopped', warn: !current.sendingEnabled },
          { label: 'Receiving', value: current.receivingEnabled ? 'on' : 'stopped', warn: !current.receivingEnabled },
          { label: 'Campaigns', value: current.campaignsEnabled ? 'on' : 'stopped', warn: !current.campaignsEnabled },
        ].map((t) => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
            <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 4px;">{t.label}</p>
            <p style={'font-size:15px;font-weight:700;margin:0;font-family:Geist Mono,monospace;color:' + (t.warn ? '#fbbf24' : '#34d399') + ';'}>{t.value}</p>
          </div>
        ))}
      </div>

      {current.suspensionReason && (
        <div style="background:rgba(251,191,36,0.10);border:1px solid rgba(251,191,36,0.30);border-radius:12px;padding:12px 14px;margin-bottom:16px;">
          <p style="font-size:12px;color:#fbbf24;margin:0 0 4px;font-weight:700;">Recorded suspension reason</p>
          <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">{current.suspensionReason}</p>
          <p style="font-size:11px;color:#8a8a94;margin:6px 0 0;">Kept after a restore on purpose: the next administrator should know this has happened before.</p>
        </div>
      )}

      {usage && (
        <div class="admin-card" style="margin-bottom:16px;">
          <div class="admin-card-title" style="margin-bottom:10px;">Usage</div>
          {!usage.ok && <p style="font-size:12px;color:#fca5a5;margin:0 0 8px;">These figures could not be read: {usage.reason}</p>}
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;font-family:'Geist Mono',monospace;">
            {[
              { label: 'Members', value: String(usage.members) },
              { label: 'Domains', value: String(usage.domains) },
              { label: 'Active keys', value: String(usage.activeKeys) },
              { label: 'API requests', value: String(usage.apiRequests) },
              { label: 'Sent 24h', value: String(usage.messages24h) },
              { label: 'Sent 30d', value: String(usage.messages30d) },
              { label: 'Failed 24h', value: String(usage.failed24h) },
              { label: 'Suppressed', value: String(usage.suppressions) },
              { label: 'Campaigns', value: statNum(usage.campaigns) },
              { label: 'Open security events', value: String(usage.openSecurityEvents) },
            ].map((t) => (
              <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;">
                <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 3px;">{t.label}</p>
                <p style="font-size:16px;font-weight:700;color:#fff;margin:0;">{t.value}</p>
              </div>
            ))}
          </div>
          {usage.campaigns === null && (
            <p style="font-size:11px;color:#8a8a94;margin:10px 0 0;line-height:1.6;">
              "not available here" is not zero: this deployment has no campaigns table yet, so the count cannot be taken.
            </p>
          )}
        </div>
      )}

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;">
        {may('org.suspend') && current.status !== 'suspended' && (
          <div class="admin-card">
            <div class="admin-card-title" style="margin-bottom:8px;">Suspend</div>
            <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
              Stops sending, receiving and campaigns at once, and marks the tenant suspended. Reversible.
            </p>
            <form data-gov-post="/api/mail/gov/orgs" data-gov-confirm="Suspend this organization? All of its mail stops.">
              <input type="hidden" name="action" value="suspend" />
              <input type="hidden" name="orgId" value={current.id} />
              <input name="reason" placeholder="Why (at least 10 characters)" style={inputStyle} required minlength="10" />
              <button type="submit" style={btn('#dc2626') + 'margin-top:8px;'}>Suspend organization</button>
            </form>
          </div>
        )}

        {may('org.restore') && current.status === 'suspended' && (
          <div class="admin-card">
            <div class="admin-card-title" style="margin-bottom:8px;">Restore</div>
            <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
              Puts sending, receiving and campaigns back on. The suspension reason stays on the record.
            </p>
            <form data-gov-post="/api/mail/gov/orgs" data-gov-confirm="Restore this organization?">
              <input type="hidden" name="action" value="restore" />
              <input type="hidden" name="orgId" value={current.id} />
              <input name="reason" placeholder="Why it is being restored" style={inputStyle} />
              <button type="submit" style={btn('#059669') + 'margin-top:8px;'}>Restore organization</button>
            </form>
          </div>
        )}

        {may('org.sending.disable') && (
          <div class="admin-card">
            <div class="admin-card-title" style="margin-bottom:8px;">Sending</div>
            <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
              Stops outbound mail only. Inbound still arrives, so nothing is lost while this is off.
            </p>
            <form data-gov-post="/api/mail/gov/orgs">
              <input type="hidden" name="action" value={current.sendingEnabled ? 'disable_sending' : 'enable_sending'} />
              <input type="hidden" name="orgId" value={current.id} />
              <input name="reason" placeholder="Reason" style={inputStyle} />
              <button type="submit" style={btn(current.sendingEnabled ? '#b45309' : '#059669') + 'margin-top:8px;'}>
                {current.sendingEnabled ? 'Stop sending' : 'Allow sending'}
              </button>
            </form>
          </div>
        )}

        {may('org.receiving.disable') && (
          <div class="admin-card">
            <div class="admin-card-title" style="margin-bottom:8px;">Receiving</div>
            <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
              Stops inbound acceptance. Mail sent to this tenant while it is off is refused at the edge, not silently dropped.
            </p>
            <form data-gov-post="/api/mail/gov/orgs">
              <input type="hidden" name="action" value={current.receivingEnabled ? 'disable_receiving' : 'enable_receiving'} />
              <input type="hidden" name="orgId" value={current.id} />
              <input name="reason" placeholder="Reason" style={inputStyle} />
              <button type="submit" style={btn(current.receivingEnabled ? '#b45309' : '#059669') + 'margin-top:8px;'}>
                {current.receivingEnabled ? 'Stop receiving' : 'Allow receiving'}
              </button>
            </form>
          </div>
        )}

        {may('org.campaigns.disable') && (
          <div class="admin-card">
            <div class="admin-card-title" style="margin-bottom:8px;">Campaigns</div>
            <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
              The usual first move in a complaint incident: bulk stops, transactional mail keeps working.
            </p>
            <form data-gov-post="/api/mail/gov/orgs">
              <input type="hidden" name="action" value={current.campaignsEnabled ? 'disable_campaigns' : 'enable_campaigns'} />
              <input type="hidden" name="orgId" value={current.id} />
              <input name="reason" placeholder="Reason" style={inputStyle} />
              <button type="submit" style={btn(current.campaignsEnabled ? '#b45309' : '#059669') + 'margin-top:8px;'}>
                {current.campaignsEnabled ? 'Stop campaigns' : 'Allow campaigns'}
              </button>
            </form>
          </div>
        )}

        {may('org.credentials.rotate') && (
          <div class="admin-card" style="border-color:rgba(239,68,68,0.35);">
            <div class="admin-card-title" style="margin-bottom:8px;">Rotate credentials</div>
            <p style="font-size:11.5px;color:#fca5a5;margin:0 0 10px;line-height:1.6;">
              Revokes every active key for the environment and issues one replacement. Every integration
              still using an old key starts failing immediately. The new key is shown once and cannot be recovered.
            </p>
            <form data-gov-post="/api/mail/gov/orgs" data-gov-confirm="Rotate credentials? Every integration using an existing key will start failing at once.">
              <input type="hidden" name="action" value="rotate_credentials" />
              <input type="hidden" name="orgId" value={current.id} />
              <select name="environment" style={inputStyle + 'margin-bottom:8px;'}>
                <option value="production">production</option>
                <option value="development">development</option>
              </select>
              <input name="reason" placeholder="Why (at least 10 characters)" style={inputStyle} required minlength="10" />
              <button type="submit" style={btn('#dc2626') + 'margin-top:8px;'}>Rotate now</button>
            </form>
          </div>
        )}
      </div>
    </div>
  )}

  <GovActions />
</GovShell>
