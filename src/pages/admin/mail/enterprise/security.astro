---
// /admin/mail/enterprise/security — every security signal on the platform, in one place.
//
// Failed sign-ins, API abuse, SMTP abuse, suspicious campaigns, credential anomalies, permission
// changes and domain changes. Before this, each of those logged a line in its own format in its own
// file, which is a signal nobody is watching — because nobody watches log files on an ordinary
// Tuesday.
//
// NOTHING ON THIS SCREEN HAS ACTED ON ANYBODY. Every entry is a report for a person to decide about;
// no score here suspends an account or pauses a campaign. That is a product rule on this platform,
// stated on the screen rather than only in a document, and it is why every event carries a
// recommendation instead of a verdict.
//
// TRIAGE REQUIRES A NOTE. "Resolved" with nothing written down is a badge somebody cleared; six weeks
// later nobody can tell an investigated event from a dismissed one.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { listSecurityEvents, securitySummary } from '@/lib/mailgov/security-events';
import { SECURITY_FAMILIES } from '@/lib/mailgov/security-policy';
import { getOrg } from '@/lib/mailgov/orgs';
import { authorizeGov } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'security.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;

const family = Astro.url.searchParams.get('family') || null;
const status = Astro.url.searchParams.get('status') || null;

let events: any[] = [];
let readError: string | null = null;
let summary: Awaited<ReturnType<typeof securitySummary>> | null = null;
let org: any = null;

if (decision.allowed) {
  const list = await listSecurityEvents({ orgId, family, status: status as any, limit: 200 });
  if (list.ok) events = list.rows; else readError = list.reason;
  summary = await securitySummary(orgId, 168);
  if (orgId) {
    const one = await getOrg(orgId);
    if (one.ok) org = one.org;
  }
}

const mayResolve = authorizeGov(actor, 'security.resolve', { orgId: orgId || undefined }).allowed;
const sevColour = (s: string): string =>
  s === 'critical' ? '#f87171' : s === 'high' ? '#fb923c' : s === 'medium' ? '#fbbf24' : s === 'low' ? '#9aa6b6' : '#6e6e78';
const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:5px 8px;border-radius:6px;font-size:11.5px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11px;font-weight:700;padding:5px 10px;border-radius:6px;cursor:pointer;';
const qs = (k: string, v: string | null): string => {
  const p = new URLSearchParams(Astro.url.search);
  if (v) p.set(k, v); else p.delete(k);
  return '/admin/mail/enterprise/security?' + p.toString();
};
---

<GovShell
  title="Security events"
  actor={actor}
  capability="security.view"
  org={org ? { id: org.id, name: org.name } : null}
  subtitle="Advisory only. Every entry is a report for a person to decide about."
>
  {readError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">The security log could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0 0 6px;font-family:'Geist Mono',monospace;">{readError}</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">An empty board here would mean "nothing is happening". This is not that.</p>
    </div>
  )}

  {summary && summary.ok && (
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:16px;">
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
        <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 4px;">Last 7 days</p>
        <p style="font-size:20px;font-weight:700;color:#fff;margin:0;font-family:'Geist Mono',monospace;">{summary.total}</p>
      </div>
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
        <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 4px;">Open</p>
        <p style={'font-size:20px;font-weight:700;margin:0;font-family:Geist Mono,monospace;color:' + (summary.open > 0 ? '#fbbf24' : '#34d399') + ';'}>{summary.open}</p>
      </div>
      {Object.keys(summary.bySeverity).map((s) => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
          <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 4px;">{s}</p>
          <p style={'font-size:20px;font-weight:700;margin:0;font-family:Geist Mono,monospace;color:' + sevColour(s) + ';'}>{summary.bySeverity[s]}</p>
        </div>
      ))}
    </div>
  )}

  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">
    <a href={qs('family', null)} style={'font-size:11px;padding:4px 10px;border-radius:999px;text-decoration:none;' + (!family ? 'background:#FF4F00;color:#fff;' : 'background:#0f0f14;color:#9aa6b6;border:1px solid #1a1a1f;')}>every family</a>
    {SECURITY_FAMILIES.map((f) => (
      <a href={qs('family', f)} style={'font-size:11px;padding:4px 10px;border-radius:999px;text-decoration:none;font-family:Geist Mono,monospace;' + (family === f ? 'background:#FF4F00;color:#fff;' : 'background:#0f0f14;color:#9aa6b6;border:1px solid #1a1a1f;')}>{f}</a>
    ))}
    <a href={qs('status', 'new')} style={'font-size:11px;padding:4px 10px;border-radius:999px;text-decoration:none;margin-left:8px;' + (status === 'new' ? 'background:#1f1f26;color:#fff;' : 'background:#0f0f14;color:#9aa6b6;border:1px solid #1a1a1f;')}>unhandled only</a>
  </div>

  <div class="admin-card">
    <div class="admin-card-title" style="margin-bottom:10px;">{events.length} event{events.length === 1 ? '' : 's'}</div>
    {events.length === 0 && !readError && <p style="font-size:12px;color:#9aa6b6;margin:0;">Nothing matches this filter.</p>}
    {events.map((e: any) => (
      <div style="padding:11px 0;border-bottom:1px solid #17171c;">
        <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
          <span style={'width:8px;height:8px;border-radius:50%;flex-shrink:0;background:' + sevColour(e.severity) + ';'}></span>
          <span style="font-size:12.5px;font-weight:700;color:#fff;">{e.label}</span>
          <span style="font-size:10.5px;color:#6e6e78;font-family:'Geist Mono',monospace;">{e.type}</span>
          {e.subject && <span style="font-size:11px;color:#9aa6b6;">{e.subject}</span>}
          {e.ip && <span style="font-size:10.5px;color:#6e6e78;font-family:'Geist Mono',monospace;">{e.ip}</span>}
          <span style={'font-size:10.5px;color:' + (e.status === 'new' ? '#fbbf24' : '#6e6e78') + ';'}>{e.status}</span>
          <span style="margin-left:auto;font-size:10.5px;color:#6e6e78;font-family:'Geist Mono',monospace;">{e.occurredAt.slice(0, 19).replace('T', ' ')}</span>
        </div>
        <p style="font-size:11.5px;color:#d8d8de;margin:5px 0 0;line-height:1.6;">{e.recommendation}</p>
        {e.resolutionNote && <p style="font-size:11px;color:#9aa6b6;margin:4px 0 0;">Note on file: {e.resolutionNote}</p>}
        {mayResolve && (e.status === 'new' || e.status === 'acknowledged') && (
          <form data-gov-post="/api/mail/gov/security" style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
            <input type="hidden" name="action" value="resolve" />
            <input type="hidden" name="id" value={e.id} />
            <input type="hidden" name="orgId" value={e.orgId || ''} />
            <select name="status" style={inputStyle}>
              <option value="acknowledged">acknowledged</option>
              <option value="resolved">resolved</option>
              <option value="false_positive">false positive</option>
            </select>
            <input name="note" placeholder="What was found (at least 10 characters)" style={inputStyle + 'flex:1;min-width:220px;'} />
            <button type="submit" style={btn('#2563eb')}>Record</button>
          </form>
        )}
      </div>
    ))}
  </div>

  <GovActions />
</GovShell>
