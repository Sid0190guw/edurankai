---
// /admin/mail/enterprise/search — one box across organizations, people, messages, domains, keys,
// security events, audit entries, consent and suppressions.
//
// IT EXPLAINS ITSELF. The classification is printed under the box, so a search that finds nothing
// says WHY it looked where it looked — an angle-bracketed value is a message identifier and not an
// address, an unbracketed one is the reverse, and those two are the same characters apart from two
// brackets.
//
// A STORE THAT FAILED IS NAMED. Returning the hits that worked and hiding the store that timed out
// produces a confident "not found" for a record that is right there.
//
// SUBJECTS AND BODIES ARE NEVER SEARCHED. Matching on a subject line would let anybody with this
// console reconstruct what customers write about by guessing words, with no authorisation, no
// approval and nothing on the security screen.
import GovShell from '@/components/mailgov/GovShell.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { runSearch } from '@/lib/mailgov/search';

const { actor, decision } = await pageGate(Astro.locals, 'search.run', {}, Astro.request);
const q = (Astro.url.searchParams.get('q') || '').trim();

let outcome: Awaited<ReturnType<typeof runSearch>> | null = null;
if (decision.allowed && q) {
  outcome = await runSearch({ q, scopeOrgId: actor.orgId, limitPerTarget: 10 });
}

const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:9px 12px;border-radius:8px;font-size:13px;';
---

<GovShell
  title="Search"
  actor={actor}
  capability="search.run"
  subtitle="Identifiers, addresses and envelopes. Never message subjects or bodies."
>
  <form method="get" style="display:flex;gap:8px;margin-bottom:16px;">
    <input name="q" value={q} placeholder="An address, a UUID, a domain, a key prefix, an IP, or a message id in angle brackets"
           style={inputStyle + 'flex:1;'} autofocus />
    <button type="submit" style="background:#FF4F00;color:#fff;border:none;font-size:12px;font-weight:700;padding:9px 20px;border-radius:8px;cursor:pointer;">Search</button>
  </form>

  {outcome && (
    <div style="margin-bottom:14px;">
      <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 4px;line-height:1.6;">
        Read as <strong style="color:#FF7040;font-family:'Geist Mono',monospace;">{outcome.query.kind}</strong>. {outcome.query.explain}
      </p>
      {actor.orgId && (
        <p style="font-size:11px;color:#8a8a94;margin:0;">
          Every query carried your organization scope. A record belonging to another organization would not
          appear here even if you searched for its exact identifier.
        </p>
      )}
    </div>
  )}

  {outcome && !outcome.ok && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;color:#fca5a5;margin:0;">{outcome.error}</p>
    </div>
  )}

  {outcome && outcome.failed.length > 0 && (
    <div style="background:rgba(251,191,36,0.10);border:1px solid rgba(251,191,36,0.30);border-radius:12px;padding:12px 14px;margin-bottom:16px;">
      <p style="font-size:12px;font-weight:700;color:#fbbf24;margin:0 0 6px;">These results are incomplete.</p>
      <ul style="margin:0;padding-left:18px;font-size:11.5px;color:#d8d8de;line-height:1.7;">
        {outcome.failed.map((f) => <li>{f.target}: {f.reason}</li>)}
      </ul>
    </div>
  )}

  {outcome && outcome.ok && (
    <div class="admin-card">
      <div class="admin-card-title" style="margin-bottom:10px;">
        {outcome.hits.length} result{outcome.hits.length === 1 ? '' : 's'}
      </div>
      {outcome.hits.length === 0 && (
        <p style="font-size:12px;color:#9aa6b6;margin:0;line-height:1.6;">
          Nothing matched, in {outcome.query.targets.length} store(s){outcome.skipped.length ? ' (' + outcome.skipped.length + ' skipped as absent on this deployment)' : ''}.
        </p>
      )}
      {outcome.hits.map((h) => (
        <div style="padding:9px 0;border-bottom:1px solid #17171c;">
          <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
            <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;">{h.kind}</span>
            {h.href
              ? <a href={h.href} style="font-size:12.5px;color:#fff;font-weight:600;text-decoration:none;">{h.title}</a>
              : <span style="font-size:12.5px;color:#fff;font-weight:600;">{h.title}</span>}
            <span style="font-size:11px;color:#9aa6b6;">{h.subtitle}</span>
            {h.occurredAt && (
              <span style="margin-left:auto;font-size:10.5px;color:#8a8a94;font-family:'Geist Mono',monospace;">{h.occurredAt.slice(0, 19).replace('T', ' ')}</span>
            )}
          </div>
        </div>
      ))}
      {outcome.skipped.length > 0 && (
        <p style="font-size:11px;color:#8a8a94;margin:10px 0 0;line-height:1.6;">
          Not searched: {outcome.skipped.map((s) => s.target).join(', ')} — those record types have no table on this
          deployment yet, which is different from having no rows.
        </p>
      )}
    </div>
  )}
</GovShell>
