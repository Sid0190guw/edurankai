---
// /admin/mail/enterprise/consent — what each address agreed to, per category.
//
// THE CATEGORIES ARE SEPARATE ROWS, NOT FLAGS ON ONE ROW, and this screen shows them that way on
// purpose. It is what makes it structurally impossible for a marketing unsubscribe to stop somebody's
// password reset: they are different records, and there is no update path that touches both.
//
// The per-address view is the one that gets used in anger — somebody writes in saying "I unsubscribed
// and you keep emailing me", and this answers exactly which category they left, when, and from where.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { consentFor, consentSummary, listConsent } from '@/lib/mailgov/consent';
import { CATEGORY_SPECS, CONSENT_CATEGORIES } from '@/lib/mailgov/consent-policy';
import { getOrg, listOrgs } from '@/lib/mailgov/orgs';
import { authorizeGov } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'consent.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;
const email = (Astro.url.searchParams.get('email') || '').trim() || null;
const environment = Astro.url.searchParams.get('environment') || 'production';

let records: any[] = [];
let readError: string | null = null;
let summary: Awaited<ReturnType<typeof consentSummary>> | null = null;
let perAddress: any = null;
let org: any = null;
let orgs: any[] = [];

if (decision.allowed) {
  if (orgId) {
    const one = await getOrg(orgId);
    if (one.ok) org = one.org;

    if (email) {
      const c = await consentFor(orgId, environment, email);
      perAddress = c.ok ? c.records : null;
      if (!c.ok) readError = c.reason || null;
    } else {
      const list = await listConsent({ orgId, environment, limit: 150 });
      if (list.ok) records = list.rows; else readError = list.reason;
    }
    summary = await consentSummary(orgId, environment);
  } else {
    const list = await listOrgs({ orgId: actor.orgId, limit: 200 });
    if (list.ok) orgs = list.rows;
  }
}

const mayEdit = authorizeGov(actor, 'consent.edit', { orgId: orgId || undefined }).allowed;
const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:6px 9px;border-radius:6px;font-size:12px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11px;font-weight:700;padding:6px 12px;border-radius:6px;cursor:pointer;';
const statusColour = (s: string): string =>
  s === 'subscribed' ? '#34d399' : s === 'unsubscribed' ? '#f87171' : s === 'pending' ? '#fbbf24' : '#6e6e78';
---

<GovShell
  title="Consent"
  actor={actor}
  capability="consent.view"
  org={org ? { id: org.id, name: org.name } : null}
  subtitle="Per address, per category. A transactional message never inherits a marketing rule."
>
  {readError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">Consent records could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0 0 6px;font-family:'Geist Mono',monospace;">{readError}</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">
        Nothing below should be read as "no consent recorded". The send path fails closed on the same
        failure — it refuses to send rather than guessing.
      </p>
    </div>
  )}

  {!orgId && (
    <div class="admin-card">
      <div class="admin-card-title" style="margin-bottom:10px;">Choose an organization</div>
      {orgs.map((o: any) => (
        <a href={'/admin/mail/enterprise/consent?org=' + o.id}
           style="display:block;padding:9px 0;border-bottom:1px solid #17171c;text-decoration:none;font-size:12.5px;color:#fff;">{o.name}</a>
      ))}
    </div>
  )}

  {orgId && (
    <div>
      <div class="admin-card" style="margin-bottom:16px;">
        <div class="admin-card-title" style="margin-bottom:8px;">The categories</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;">
          {CONSENT_CATEGORIES.map((c) => {
            const spec = CATEGORY_SPECS[c];
            const counts = (summary && summary.counts[c]) || {};
            return (
              <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;">
                <p style="font-size:12px;font-weight:700;color:#fff;margin:0 0 4px;">{spec.label}</p>
                <p style="font-size:10.5px;color:#9aa6b6;margin:0 0 6px;line-height:1.6;">{spec.describes}</p>
                <p style="font-size:10px;color:#8a8a94;margin:0 0 6px;font-family:'Geist Mono',monospace;">
                  {spec.requiresOptIn ? 'needs opt-in' : 'no opt-in required'} · {spec.unsubscribable ? 'can be switched off' : 'cannot be switched off'}
                </p>
                <p style="font-size:11px;color:#d8d8de;margin:0;font-family:'Geist Mono',monospace;">
                  {Object.keys(counts).length ? Object.keys(counts).map((k) => k + ': ' + counts[k]).join(' · ') : 'no records'}
                </p>
              </div>
            );
          })}
        </div>
      </div>

      <form method="get" style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
        <input type="hidden" name="org" value={orgId} />
        <input name="email" placeholder="Look up one address" value={email || ''} style={inputStyle + 'flex:1;min-width:240px;'} />
        <button type="submit" style={btn('#374151')}>Look up</button>
      </form>

      {perAddress && (
        <div class="admin-card" style="margin-bottom:16px;">
          <div class="admin-card-title" style="margin-bottom:10px;">{email}</div>
          {CONSENT_CATEGORIES.map((c) => {
            const r = perAddress[c];
            const spec = CATEGORY_SPECS[c];
            return (
              <div style="padding:10px 0;border-bottom:1px solid #17171c;">
                <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
                  <span style="font-size:12px;font-weight:700;color:#fff;">{spec.label}</span>
                  <span style={'font-size:11.5px;font-family:Geist Mono,monospace;color:' + statusColour(r.status) + ';'}>{r.status}</span>
                  {r.consentAt && <span style="font-size:10.5px;color:#9aa6b6;">agreed {r.consentAt.slice(0, 10)}</span>}
                  {r.source && <span style="font-size:10.5px;color:#8a8a94;">via {r.source}</span>}
                  {r.unsubscribedAt && <span style="font-size:10.5px;color:#fca5a5;">left {r.unsubscribedAt.slice(0, 10)}</span>}
                </div>
                {r.purpose && <p style="font-size:11px;color:#9aa6b6;margin:4px 0 0;">Purpose recorded: {r.purpose}</p>}
                {mayEdit && (
                  <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                    <form data-gov-post="/api/mail/gov/consent" style="display:flex;gap:4px;">
                      <input type="hidden" name="action" value="record" />
                      <input type="hidden" name="orgId" value={orgId} />
                      <input type="hidden" name="environment" value={environment} />
                      <input type="hidden" name="email" value={email} />
                      <input type="hidden" name="category" value={c} />
                      <input name="source" placeholder="source (required)" style={inputStyle + 'width:150px;'} required />
                      <input name="purpose" placeholder="purpose" style={inputStyle + 'width:150px;'} />
                      <button type="submit" style={btn('#059669')}>Record consent</button>
                    </form>
                    {spec.unsubscribable && (
                      <form data-gov-post="/api/mail/gov/consent" style="display:flex;gap:4px;">
                        <input type="hidden" name="action" value="withdraw" />
                        <input type="hidden" name="orgId" value={orgId} />
                        <input type="hidden" name="environment" value={environment} />
                        <input type="hidden" name="email" value={email} />
                        <input type="hidden" name="category" value={c} />
                        <input type="hidden" name="source" value="admin console" />
                        <button type="submit" style={btn('#b45309')}>Withdraw</button>
                      </form>
                    )}
                  </div>
                )}
              </div>
            );
          })}
          <p style="font-size:11px;color:#8a8a94;margin:10px 0 0;line-height:1.6;">
            Withdrawing from one category never touches another. A previous unsubscribe is kept on the record
            even after re-consent — "subscribed, previously left on the 3rd" is a different fact from "never left".
          </p>
        </div>
      )}

      {!email && (
        <div class="admin-card">
          <div class="admin-card-title" style="margin-bottom:10px;">Recent consent records</div>
          {records.length === 0 && !readError && <p style="font-size:12px;color:#9aa6b6;margin:0;">No consent records yet.</p>}
          {records.map((r: any) => (
            <div style="display:flex;gap:10px;align-items:baseline;padding:7px 0;border-bottom:1px solid #17171c;font-size:11.5px;flex-wrap:wrap;">
              <a href={'/admin/mail/enterprise/consent?org=' + orgId + '&email=' + encodeURIComponent(r.email)}
                 style="color:#fff;text-decoration:none;font-family:'Geist Mono',monospace;">{r.email}</a>
              <span style="color:#9aa6b6;">{r.category}</span>
              <span style={'font-family:Geist Mono,monospace;color:' + statusColour(r.status) + ';'}>{r.status}</span>
              {r.source && <span style="color:#8a8a94;">{r.source}</span>}
              <span style="margin-left:auto;color:#8a8a94;font-family:'Geist Mono',monospace;">
                {(r.updatedAt || '').slice(0, 19).replace('T', ' ')}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <GovActions />
</GovShell>
