---
// /admin/mail/enterprise/retention — how long each class of data is kept, and what the sweep did.
//
// THE FLOOR AND CEILING ARE SHOWN NEXT TO EVERY DIAL, because a refused value with no explanation is
// a form somebody fights with. The audit log's floor is a year: a record that can be shortened to
// less than the time it takes anyone to ask about it is decoration.
//
// A DRY RUN IS THE DEFAULT BUTTON. It counts what would go and deletes nothing. The destructive one
// is separate, differently coloured, and confirms. A retention screen whose only button destroys two
// years of a customer's mail is a screen people are right to be frightened of.
//
// "CONFIGURED" AND "HAS EVER RUN" ARE DIFFERENT STATES and this page shows both. They look identical
// on most settings screens, and they are the two an operator most needs to tell apart.
import GovShell from '@/components/mailgov/GovShell.astro';
import GovActions from '@/components/mailgov/GovActions.astro';
import { pageGate } from '@/lib/mailgov/guard';
import { getPolicies, listRetentionRuns } from '@/lib/mailgov/retention';
import { RETENTION_SPECS, type RetentionClass } from '@/lib/mailgov/retention-policy';
import { aiRecordSummary } from '@/lib/mailgov/ai-records';
import { getOrg } from '@/lib/mailgov/orgs';
import { listOrgs } from '@/lib/mailgov/orgs';
import { authorizeGov } from '@/lib/mailgov/policy';

const orgParamRaw = (Astro.url.searchParams.get('org') || '').trim() || null;
const { actor, decision } = await pageGate(Astro.locals, 'retention.view', { orgId: orgParamRaw || undefined }, Astro.request);
const orgId = actor.orgId || orgParamRaw;
const environment = Astro.url.searchParams.get('environment') || 'production';

let policies: any[] = [];
let conflicts: string[] = [];
let policyError: string | null = null;
let runs: any[] = [];
let runsError: string | null = null;
let org: any = null;
let orgs: any[] = [];
let ai: Awaited<ReturnType<typeof aiRecordSummary>> | null = null;

if (decision.allowed) {
  if (orgId) {
    const got = await getPolicies(orgId, environment);
    policies = got.policies;
    conflicts = got.conflicts;
    if (!got.ok) policyError = got.reason || null;

    const r = await listRetentionRuns(orgId, 30);
    if (r.ok) runs = r.rows; else runsError = r.reason;

    const one = await getOrg(orgId);
    if (one.ok) org = one.org;

    ai = await aiRecordSummary(orgId);
  } else {
    const list = await listOrgs({ orgId: actor.orgId, limit: 200 });
    if (list.ok) orgs = list.rows; else policyError = list.reason;
  }
}

const mayEdit = authorizeGov(actor, 'retention.edit', { orgId: orgId || undefined }).allowed;
const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:5px 8px;border-radius:6px;font-size:12px;';
const btn = (bg: string): string =>
  'background:' + bg + ';color:#fff;border:none;font-size:11px;font-weight:700;padding:5px 12px;border-radius:6px;cursor:pointer;';
---

<GovShell
  title="Data retention"
  actor={actor}
  capability="retention.view"
  org={org ? { id: org.id, name: org.name } : null}
  subtitle="Per organization, per class of data. The platform sets floors; the organization sets the rest."
>
  {policyError && (
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
      <p style="font-size:12.5px;font-weight:700;color:#fca5a5;margin:0 0 6px;">Retention settings could not be read.</p>
      <p style="font-size:12px;color:#d8d8de;margin:0 0 6px;font-family:'Geist Mono',monospace;">{policyError}</p>
      <p style="font-size:12px;color:#d8d8de;margin:0;line-height:1.6;">
        The values below are the platform defaults, shown so you can see what WOULD apply. They are not a
        reading of what is stored.
      </p>
    </div>
  )}

  {!orgId && (
    <div class="admin-card">
      <div class="admin-card-title" style="margin-bottom:10px;">Choose an organization</div>
      {orgs.map((o: any) => (
        <a href={'/admin/mail/enterprise/retention?org=' + o.id}
           style="display:block;padding:9px 0;border-bottom:1px solid #17171c;text-decoration:none;font-size:12.5px;color:#fff;">
          {o.name} <span style="color:#6e6e78;font-family:'Geist Mono',monospace;font-size:11px;">{o.slug}</span>
        </a>
      ))}
    </div>
  )}

  {orgId && (
    <div>
      {conflicts.length > 0 && (
        <div style="background:rgba(251,191,36,0.10);border:1px solid rgba(251,191,36,0.30);border-radius:12px;padding:14px 16px;margin-bottom:16px;">
          <p style="font-size:12.5px;font-weight:700;color:#fbbf24;margin:0 0 6px;">These settings work against each other.</p>
          <ul style="margin:0;padding-left:18px;font-size:12px;color:#d8d8de;line-height:1.7;">
            {conflicts.map((c) => <li>{c}</li>)}
          </ul>
          <p style="font-size:11px;color:#6e6e78;margin:8px 0 0;line-height:1.6;">
            Reported rather than refused: each value is individually valid, and which combination is right
            for this organization is their decision, not this platform's.
          </p>
        </div>
      )}

      <div class="admin-card" style="margin-bottom:16px;">
        <div class="admin-card-title" style="margin-bottom:10px;">Policies ({environment})</div>
        {policies.map((p: any) => {
          const spec = RETENTION_SPECS[p.dataClass as RetentionClass];
          return (
            <div style="padding:12px 0;border-bottom:1px solid #17171c;">
              <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
                <span style="font-size:12.5px;font-weight:700;color:#fff;">{spec.label}</span>
                <span style="font-size:11px;color:#FF7040;font-family:'Geist Mono',monospace;">{p.retainDays} days</span>
                <span style="font-size:10.5px;color:#9aa6b6;">{p.action}</span>
                <span style="font-size:10.5px;color:#6e6e78;">
                  {p.updatedAt ? 'set by this organization' : 'platform default (never set here)'}
                </span>
                {!p.enabled && <span style="font-size:10.5px;color:#fbbf24;">sweep paused</span>}
              </div>
              <p style="font-size:11.5px;color:#9aa6b6;margin:5px 0 0;line-height:1.6;">{spec.describes}</p>
              <p style="font-size:10.5px;color:#6e6e78;margin:4px 0 0;font-family:'Geist Mono',monospace;">
                allowed {spec.floorDays}-{spec.ceilingDays} days{spec.holdable ? ' · a legal hold can pin individual records out of the sweep' : ' · not holdable'}
              </p>
              {mayEdit && (
                <form data-gov-post="/api/mail/gov/retention" style="display:flex;gap:6px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                  <input type="hidden" name="action" value="set" />
                  <input type="hidden" name="orgId" value={orgId} />
                  <input type="hidden" name="environment" value={environment} />
                  <input type="hidden" name="dataClass" value={p.dataClass} />
                  <input type="number" name="retainDays" value={p.retainDays} min={spec.floorDays} max={spec.ceilingDays} style={inputStyle + 'width:100px;'} />
                  <select name="retentionAction" style={inputStyle}>
                    <option value="delete" selected={p.action === 'delete'}>delete</option>
                    {(p.dataClass === 'messages' || p.dataClass === 'attachments') && (
                      <option value="redact" selected={p.action === 'redact'}>redact</option>
                    )}
                  </select>
                  <label style="font-size:11px;color:#9aa6b6;display:flex;align-items:center;gap:4px;">
                    <input type="checkbox" name="enabled" checked={p.enabled} /> sweep enabled
                  </label>
                  <input name="reason" placeholder="reason for the change" style={inputStyle + 'flex:1;min-width:160px;'} />
                  <button type="submit" style={btn('#2563eb')}>Save</button>
                </form>
              )}
            </div>
          );
        })}
      </div>

      <div class="admin-card" style="margin-bottom:16px;">
        <div class="admin-card-title" style="margin-bottom:8px;">Run the sweep</div>
        <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">
          A dry run counts what would be deleted and touches nothing. Records under a legal hold are excluded
          from both, and if the hold table cannot be read the sweep does nothing at all for that class —
          failing towards keeping data, deliberately.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <form data-gov-post="/api/mail/gov/retention">
            <input type="hidden" name="action" value="sweep" />
            <input type="hidden" name="orgId" value={orgId} />
            <input type="hidden" name="environment" value={environment} />
            <input type="hidden" name="dryRun" value="true" />
            <button type="submit" style={btn('#374151')}>Dry run</button>
          </form>
          {mayEdit && (
            <form data-gov-post="/api/mail/gov/retention" data-gov-confirm="Run the retention sweep for real? Rows past their cutoff will be deleted.">
              <input type="hidden" name="action" value="sweep" />
              <input type="hidden" name="orgId" value={orgId} />
              <input type="hidden" name="environment" value={environment} />
              <input type="hidden" name="dryRun" value="" />
              <input name="reason" placeholder="reason" style={inputStyle + 'width:200px;margin-right:6px;'} />
              <button type="submit" style={btn('#dc2626')}>Sweep for real</button>
            </form>
          )}
        </div>
      </div>

      {ai && (
        <div class="admin-card" style="margin-bottom:16px;">
          <div class="admin-card-title" style="margin-bottom:8px;">AI processing register</div>
          {!ai.ok && <p style="font-size:12px;color:#fca5a5;margin:0;">This register could not be read: {ai.reason}</p>}
          {ai.ok && ai.total === 0 && (
            <p style="font-size:12px;color:#9aa6b6;margin:0;line-height:1.6;">
              No AI processing has been recorded on this deployment. The register exists and is swept by the
              policy above; the mail platform's AI features write to it when they are built. This is not a
              count of zero from a running feature.
            </p>
          )}
          {ai.ok && ai.total > 0 && (
            <div>
              <p style="font-size:12px;color:#d8d8de;margin:0 0 6px;">{ai.total} record(s), oldest {ai.oldest}</p>
              <p style="font-size:11.5px;color:#9aa6b6;margin:0;line-height:1.6;">
                {Object.keys(ai.byPurpose).map((k) => k + ': ' + ai.byPurpose[k]).join(' · ')}
              </p>
              <p style="font-size:11px;color:#6e6e78;margin:8px 0 0;line-height:1.6;">
                The register records that content was processed, by which model and for what — never the content.
              </p>
            </div>
          )}
        </div>
      )}

      <div class="admin-card">
        <div class="admin-card-title" style="margin-bottom:10px;">Sweep history</div>
        {runsError && <p style="font-size:12px;color:#fca5a5;margin:0 0 8px;">The history could not be read: {runsError}</p>}
        {!runsError && runs.length === 0 && (
          <p style="font-size:12px;color:#fbbf24;margin:0;line-height:1.6;">
            The sweep has never run for this organization. Configured retention that never executes is the
            failure worth noticing here — check that the scheduled call to /api/mail/gov/worker is wired up.
          </p>
        )}
        {runs.map((r: any) => (
          <div style="display:flex;gap:10px;align-items:baseline;padding:7px 0;border-bottom:1px solid #17171c;font-size:11.5px;flex-wrap:wrap;">
            <span style={'font-family:Geist Mono,monospace;color:' + (r.ok ? '#9aa6b6' : '#fca5a5') + ';'}>{r.dataClass}</span>
            <span style="color:#fff;">{r.affected} affected</span>
            {r.skippedHeld > 0 && <span style="color:#fbbf24;">{r.skippedHeld} held back</span>}
            {r.error && <span style="color:#fca5a5;">{r.error}</span>}
            <span style="margin-left:auto;color:#6e6e78;font-family:'Geist Mono',monospace;">{r.startedAt.slice(0, 19).replace('T', ' ')}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <GovActions />
</GovShell>
