---
import AdminLayout from '@/layouts/AdminLayout.astro';
import {
  getSignature, setSignature, listLabels, createLabel, deleteLabel,
  listRules, createRule, deleteRule, runRulesOnMailbox,
  listScheduled, cancelScheduled,
} from '@/lib/mail-advanced';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

let okMsg = '', errMsg = '';
// What the "run rules now" pass actually did, so the result is a real number and not a reassurance.
let runReport: { scanned: number; changed: number; actions: string[]; capped: boolean } | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = (fd.get('_action') as string) || '';
  const g = (k: string) => ((fd.get(k) as string) || '').trim();
  try {
    if (action === 'save_signature') {
      await setSignature(user.id, ((fd.get('html') as string) || '').slice(0, 20000), fd.get('on') === 'on');
      okMsg = 'Signature saved.';
    } else if (action === 'add_label') {
      if (!g('name')) throw new Error('Label name required');
      await createLabel(user.id, g('name'), g('color') || '#67e8f9');
      okMsg = 'Label saved.';
    } else if (action === 'del_label') {
      // A DELETE that matched no row is not a removal. This printed 'Label removed.' whatever
      // happened, so a label id from a list rendered before another tab acted reported a removal
      // that never occurred and the label stayed on the rail.
      const removed = await deleteLabel(user.id, g('id'));
      if (removed) okMsg = 'Label removed.';
      else errMsg = 'Nothing was removed: that label is already gone, or it is not yours. Reload the page.';
    } else if (action === 'add_rule') {
      if (!g('match_value')) throw new Error('Match value required');
      await createRule(user.id, {
        matchField: g('match_field') || 'from',
        matchOp: g('match_op') || 'contains',
        matchValue: g('match_value'),
        action: g('action') || 'label',
        actionValue: g('action_value'),
      });
      okMsg = 'Rule added.';
    } else if (action === 'del_rule') {
      const removed = await deleteRule(user.id, g('id'));
      if (removed) okMsg = 'Rule removed.';
      else errMsg = 'Nothing was removed: that rule is already gone, or it is not yours. Reload the page.';
    } else if (action === 'run_rules') {
      // THE RULES NOW RUN. Until this existed, applyRules() had no caller anywhere in the
      // repository: every rule on this page was stored, listed back correctly, and evaluated
      // against nothing, ever.
      const scope = g('scope') === 'all' ? 'all' : 'inbox';
      runReport = await runRulesOnMailbox(user.id, { scope });
      okMsg = runReport.changed === 0
        ? 'Rules ran over ' + runReport.scanned + ' message' + (runReport.scanned === 1 ? '' : 's') + '. Nothing matched, so nothing was changed.'
        : 'Rules ran over ' + runReport.scanned + ' message' + (runReport.scanned === 1 ? '' : 's') + ' and changed ' + runReport.changed + '.';
    } else if (action === 'cancel_scheduled') {
      // The scheduled queue had a sender (/api/mail/scheduled-send) and no way to see or stop
      // anything in it: listScheduled and cancelScheduled had zero callers. A message could be
      // queued for a future date and then only be discovered by its recipient.
      // THE ONE PROMISE ON THIS PAGE THAT CANNOT BE WITHDRAWN LATER. cancelScheduled's DELETE is
      // narrowed by `status = 'scheduled'`, so a message /api/mail/scheduled-send had already picked
      // up matched no row — and this line told the operator it had been stopped while it went out.
      const cancelled = await cancelScheduled(user.id, g('id'));
      if (cancelled) okMsg = 'Scheduled message cancelled — it will not be sent.';
      else errMsg = 'That message was NOT cancelled: it is no longer queued, which usually means it has already been sent or is being sent now. Check the sent folder before assuming it was stopped.';
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the failed SQL, which told the
    // admin nothing about why their rule was not saved.
    okMsg = '';
    errMsg = ('Nothing was changed: ' + String(e?.cause?.message || e?.message || e)).slice(0, 240);
    console.error('[admin/mail/rules] ' + action + ' failed:', e?.cause?.message || e?.message);
  }
}

// THESE THREE READS USED TO END IN `.catch(() => [])` / `.catch(() => ({ html: '', on: false }))`,
// which is the dangerous half of none-vs-unknown on this particular page. An unreadable signature
// rendered as an EMPTY textarea, and pressing "Save signature" over that empty box would then write
// the emptiness on top of the real one — a silent data loss caused by a failed READ. An unreadable
// rule list reads as "you have no filters", and the natural response is to re-create one that
// already exists. The reads stay tolerated (a broken labels table must not take the page down) but
// the failure is stated, and the signature form is withheld while its current value is unknown.
let loadError = '';
const noteFail = (what: string, e: any) => {
  const why = String(e?.cause?.message || e?.message || 'unknown error');
  console.error('[admin/mail/rules] ' + what + ' read failed:', why);
  if (!loadError) loadError = what + ': ' + why;
};
let sigError = '';
let sig: { html: string; on: boolean } = { html: '', on: false };
try { sig = await getSignature(user.id); }
catch (e: any) { sigError = String(e?.cause?.message || e?.message || 'unknown error'); noteFail('signature', e); }
let labels: any[] = [];
try { labels = await listLabels(user.id); } catch (e: any) { noteFail('labels', e); }
let rules: any[] = [];
try { rules = await listRules(user.id); } catch (e: any) { noteFail('rules', e); }
// The scheduled-send queue, which had no reader at all until now.
let scheduled: any[] = [];
let scheduledError = '';
try { scheduled = await listScheduled(user.id); }
catch (e: any) { scheduledError = String(e?.cause?.message || e?.message || 'unknown error'); noteFail('scheduled messages', e); }
const pendingScheduled = scheduled.filter((s: any) => s.status === 'scheduled');

const SWATCHES = ['#67e8f9', '#a78bfa', '#fca5a5', '#86efac', '#fcd34d', '#f9a8d4', '#93c5fd', '#fdba74'];
function fieldLabel(f: string) { return ({ from: 'From', to: 'To', subject: 'Subject', body: 'Body' } as any)[f] || f; }
function opLabel(o: string) { return ({ contains: 'contains', equals: 'equals', startswith: 'starts with', endswith: 'ends with' } as any)[o] || o; }
function actLabel(a: string, v: string) {
  if (a === 'label') return 'apply label "' + (v || '') + '"';
  if (a === 'folder') return 'move to ' + (v || '');
  if (a === 'star') return 'star it';
  if (a === 'read') return 'mark read';
  return a;
}
---
<AdminLayout title="Mail rules" activeNav="mail">
  <section class="page">
    <div class="page-head">
      <div>
        <p class="eyebrow">Mail</p>
        <h1>Signature, labels &amp; rules</h1>
        <p class="sub">Your personal mailbox preferences. <a href="/admin/mail">Back to inbox</a></p>
      </div>
    </div>

    {okMsg && <div class="flash ok">{okMsg}</div>}
    {errMsg && <div class="flash err">{errMsg}</div>}
    {loadError && <div class="flash err">Some of your settings could not be read, so anything shown as empty below is empty for a reason that is not "you have none": {loadError}</div>}

    <!-- SIGNATURE -->
    <div class="card">
      <h2>Email signature</h2>
      <p class="card-sub">Appended to messages you send (toggle off per-message in the composer). HTML allowed.</p>
      {sigError ? (
        <p class="muted">
          Your signature could not be read, so it is not shown and cannot be edited here right now.
          Saving an empty box over a signature nobody could load would delete it. Reload in a moment.
        </p>
      ) : (
        <form method="post">
          <input type="hidden" name="_action" value="save_signature" />
          <textarea name="html" rows="6" class="ta" placeholder="e.g. <strong>Your Name</strong><br>EduRankAI">{sig.html}</textarea>
          <div class="row-between">
            <label class="chk"><input type="checkbox" name="on" checked={sig.on} /> Attach by default</label>
            <button class="btn" type="submit">Save signature</button>
          </div>
        </form>
      )}
    </div>

    <!-- LABELS -->
    <div class="card">
      <h2>Labels</h2>
      <p class="card-sub">Color-coded tags you can apply to conversations and use in rules.</p>
      <div class="chips">
        {labels.length === 0 ? <span class="muted">No labels yet.</span> : labels.map((l: any) => (
          <span class="chip" style={`background:${l.color}22;border-color:${l.color}`}>
            <span class="dot" style={`background:${l.color}`}></span>{l.name}
            <form method="post" class="inline"><input type="hidden" name="_action" value="del_label" /><input type="hidden" name="id" value={l.id} /><button class="chip-x" type="submit" title="Remove">&times;</button></form>
          </span>
        ))}
      </div>
      <form method="post" class="label-form">
        <input type="hidden" name="_action" value="add_label" />
        <input name="name" class="inp" placeholder="Label name" maxlength="60" required />
        <select name="color" class="inp sel">
          {SWATCHES.map((c) => <option value={c} style={`background:${c}`}>{c}</option>)}
        </select>
        <button class="btn" type="submit">Add label</button>
      </form>
    </div>

    <!-- RULES -->
    <div class="card">
      <h2>Mail rules</h2>
      {/* The old sub-line read "Run automatically on every incoming message" — which was not true
          of a single message ever delivered by this product. Rules are matched top to bottom, and
          the page now says exactly when that happens and when it does not. */}
      <p class="card-sub">Matched top to bottom. Run them over your existing mail with the button below.</p>

      <div class="notice">
        <p class="notice-h">These rules do not yet run on arrival.</p>
        <p>
          Filing a message the moment it lands belongs to the inbound delivery route, which does not
          call the rule engine yet. Until it does, a rule you add here changes nothing by itself:
          <b>press &ldquo;Run rules now&rdquo;</b> and it is applied to the mail already in your
          mailbox. New mail arriving after that is not filed until you run them again.
        </p>
      </div>

      {rules.length === 0 ? <p class="muted">No rules yet.</p> : (
        <ul class="rules">
          {rules.map((r: any) => (
            <li class="rule">
              <span class="rule-text">
                If <b>{fieldLabel(r.match_field)}</b> {opLabel(r.match_op)} <b>{r.match_value}</b> &rarr; {actLabel(r.action, r.action_value)}
              </span>
              <form method="post" class="inline"><input type="hidden" name="_action" value="del_rule" /><input type="hidden" name="id" value={r.id} /><button class="rule-x" type="submit">Remove</button></form>
            </li>
          ))}
        </ul>
      )}
      <form method="post" class="rule-form">
        <input type="hidden" name="_action" value="add_rule" />
        <span>If</span>
        <select name="match_field" class="inp sel"><option value="from">From</option><option value="to">To</option><option value="subject">Subject</option><option value="body">Body</option></select>
        <select name="match_op" class="inp sel"><option value="contains">contains</option><option value="equals">equals</option><option value="startswith">starts with</option><option value="endswith">ends with</option></select>
        <input name="match_value" class="inp" placeholder="value" maxlength="200" required />
        <span>then</span>
        <select name="action" class="inp sel"><option value="label">apply label</option><option value="folder">move to folder</option><option value="star">star</option><option value="read">mark read</option></select>
        <input name="action_value" class="inp" placeholder="label / folder name" maxlength="80" />
        <button class="btn" type="submit">Add rule</button>
      </form>
      <p class="hint">For "apply label", action value is the label name (created if new). For "move to folder", use inbox / archive / spam / trash &mdash; any other value is ignored rather than filing the message somewhere no folder shows. Star / mark-read need no value.</p>

      <div class="run-box">
        {rules.length === 0 ? (
          <p class="muted">Add a rule above before running &mdash; there is nothing to apply yet.</p>
        ) : (
          <form method="post" class="rule-form">
            <input type="hidden" name="_action" value="run_rules" />
            <span>Run these {rules.length} rule{rules.length === 1 ? '' : 's'} over</span>
            <select name="scope" class="inp sel">
              <option value="inbox">my inbox</option>
              <option value="all">all my mail (except drafts and trash)</option>
            </select>
            <button class="btn" type="submit">Run rules now</button>
          </form>
        )}
        {runReport && (
          <div class="run-report">
            <p>
              Scanned <b>{runReport.scanned}</b> message{runReport.scanned === 1 ? '' : 's'};
              changed <b>{runReport.changed}</b>.
              {runReport.capped ? ' This run stopped at the newest ' + runReport.scanned + ' messages — run it again to continue further back.' : ''}
            </p>
            {runReport.actions.length > 0 && (
              <ul class="run-list">
                {runReport.actions.map((a: string) => <li>{a}</li>)}
                {runReport.changed > runReport.actions.length && <li class="muted">…and {runReport.changed - runReport.actions.length} more.</li>}
              </ul>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- SCHEDULED QUEUE -->
    <div class="card">
      <h2>Scheduled messages</h2>
      {/* This panel did not exist. listScheduled() and cancelScheduled() were both written and both
          had zero callers, while /api/mail/scheduled-send happily sent from the same table — so a
          message could be queued for a future date with no way to see it and no way to stop it. */}
      <p class="card-sub">Messages waiting to be sent, and the ones already dealt with.</p>
      {scheduledError ? (
        <p class="muted">
          The scheduled queue could not be read, so nothing is listed here &mdash; that is a failure,
          not an empty queue. A message may still be waiting to send. Reason: {scheduledError}
        </p>
      ) : scheduled.length === 0 ? (
        <p class="muted">Nothing scheduled. (The queue was read successfully.)</p>
      ) : (
        <ul class="rules">
          {scheduled.map((s: any) => (
            <li class="rule">
              <span class="rule-text">
                <b>{s.subject || '(no subject)'}</b> to {s.to_list || '(no recipient)'}<br />
                <span class="muted">
                  {s.status === 'scheduled' ? 'sends ' : s.status === 'sending' ? 'being sent now, queued for ' : s.status === 'sent' ? 'sent ' : 'failed '}
                  {s.scheduled_at ? new Date(s.scheduled_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '(no date)'}
                  {s.error ? ' — ' + s.error : ''}
                </span>
              </span>
              {s.status === 'scheduled' && (
                <form method="post" class="inline">
                  <input type="hidden" name="_action" value="cancel_scheduled" />
                  <input type="hidden" name="id" value={s.id} />
                  <button class="rule-x" type="submit">Cancel</button>
                </form>
              )}
            </li>
          ))}
        </ul>
      )}
      {!scheduledError && pendingScheduled.length > 0 && (
        <p class="hint">{pendingScheduled.length} message{pendingScheduled.length === 1 ? '' : 's'} still waiting to send. Cancelling removes it from the queue permanently.</p>
      )}
    </div>
  </section>

  <style>
    .page { max-width: 880px; margin: 0 auto; padding: 4px 2px 40px; }
    .page-head { margin-bottom: 18px; }
    .eyebrow { font-size: 0.62rem; font-family: monospace; text-transform: uppercase; letter-spacing: 0.15em; color: #FF4F00; font-weight: 700; margin: 0 0 4px; }
    .page-head h1 { font-size: 1.5rem; font-weight: 600; color: #100b08; margin: 0 0 4px; }
    .sub { font-size: 0.86rem; color: #6a635c; margin: 0; }
    .sub a, .card-sub a { color: #FF4F00; text-decoration: none; }
    .flash { padding: 10px 14px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 14px; }
    .flash.ok { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .flash.err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .card { background: #fff; border: 1px solid rgba(14,11,8,0.1); border-radius: 14px; padding: 20px 22px; margin-bottom: 16px; }
    .card h2 { font-size: 1.05rem; font-weight: 600; color: #100b08; margin: 0 0 3px; }
    .card-sub { font-size: 0.82rem; color: #8a8078; margin: 0 0 14px; }
    .ta { width: 100%; border: 1px solid rgba(14,11,8,0.14); border-radius: 10px; padding: 11px 13px; font-size: 0.88rem; font-family: monospace; line-height: 1.6; outline: 0; resize: vertical; }
    .ta:focus, .inp:focus { border-color: #FF4F00; }
    .row-between { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; flex-wrap: wrap; gap: 10px; }
    .chk { font-size: 0.84rem; color: #4a443e; display: inline-flex; align-items: center; gap: 7px; }
    .btn { background: #FF4F00; color: #fff; border: 0; border-radius: 9px; padding: 9px 18px; font-weight: 700; font-size: 0.84rem; cursor: pointer; }
    .btn:hover { background: #e84800; }
    .inp { border: 1px solid rgba(14,11,8,0.14); border-radius: 9px; padding: 8px 11px; font-size: 0.85rem; outline: 0; font-family: inherit; }
    .sel { background: #fff; cursor: pointer; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .chip { display: inline-flex; align-items: center; gap: 7px; border: 1px solid; border-radius: 100px; padding: 4px 11px; font-size: 0.82rem; color: #2b2620; font-weight: 500; }
    .chip .dot { width: 9px; height: 9px; border-radius: 100px; }
    .chip-x { background: 0; border: 0; color: #6a635c; font-size: 1.05rem; cursor: pointer; line-height: 1; padding: 0 0 0 2px; }
    .inline { display: inline; }
    .label-form, .rule-form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .rule-form span { font-size: 0.84rem; color: #6a635c; }
    .rules { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-direction: column; gap: 7px; }
    .rule { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #faf7f3; border: 1px solid rgba(14,11,8,0.08); border-radius: 10px; padding: 9px 13px; }
    .rule-text { font-size: 0.85rem; color: #2b2620; }
    .rule-x { background: 0; border: 0; color: #b91c1c; font-size: 0.78rem; font-weight: 600; cursor: pointer; }
    .muted { color: #a99e94; font-size: 0.85rem; }
    .hint { font-size: 0.74rem; color: #a99e94; margin: 12px 0 0; line-height: 1.5; }
    .notice { background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 11px 14px; margin: 0 0 14px; }
    .notice-h { font-size: 0.84rem; font-weight: 700; color: #92400e; margin: 0 0 4px; }
    .notice p { font-size: 0.8rem; color: #78560f; margin: 0; line-height: 1.6; }
    .run-box { margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(14,11,8,0.08); }
    .run-report { margin-top: 10px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 13px; }
    .run-report p { font-size: 0.82rem; color: #166534; margin: 0; line-height: 1.6; }
    .run-list { margin: 7px 0 0; padding-left: 18px; }
    .run-list li { font-size: 0.78rem; color: #3f6b4c; line-height: 1.6; }
  </style>
</AdminLayout>
