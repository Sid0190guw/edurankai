---
// /admin/xp-config — gamification XP config + auditable ledger. Gated by can(audit, gamification);
// editing values needs configure. The ledger is the integrity/audit view.
//
// WHAT CHANGED, AND WHY
//
// 1. THIS PAGE IMPORTED A MODULE THAT DOES NOT EXIST. `@/lib/xp-ledger` was retired when the two XP
//    ledgers were collapsed into one (src/lib/xp.ts owns xp_events now, and its ensureSchema()
//    explains what it adopted from the old ledger and why). Nothing updated this page, so the build
//    itself could not resolve the import - the whole admin surface for gamification was gone, not
//    merely broken. Rebound onto the surviving module, with the names it actually exports.
//
// 2. `recentLedger(50).catch(() => [])` AND `weeklyLeaderboard(10).catch(() => [])` turned a failed
//    read into an empty list, and the screen then printed "No XP awarded yet." and "No weekly XP."
//    That is the exact lie the replacement functions were written to end: recentXpEvents() and
//    weeklyXpLeaderboard() return a discriminated result, so this page can say "could not be read"
//    where it used to say "nothing happened". On an AUDIT view the difference is the whole point.
//
// 3. The column names changed with the ledger and the old ones were still being rendered - `l.action`
//    and `l.xp` do not exist on a LedgerEntry, so every row would have drawn a blank action and
//    "+undefined" XP even where the import had resolved.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/rbac';
import { getXpConfig, XP_ACTION_DEFAULTS, recentXpEvents, weeklyXpLeaderboard } from '@/lib/xp';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const gate = await can(user, 'audit', { type: 'gamification' });
if (!gate.allow) return Astro.redirect('/admin');
const canConfigure = (await can(user, 'configure', { type: 'gamification' })).allow;

// getXpConfig() already falls back to the built-in defaults and logs the reason when the config row
// cannot be read, so there is nothing left for a catch here to add.
const cfg = await getXpConfig();
const ledgerRes = await recentXpEvents(50);
const weeklyRes = await weeklyXpLeaderboard(10);
const ledger = ledgerRes.ok ? ledgerRes.rows : [];
const weekly = weeklyRes.ok ? weeklyRes.rows : [];
const ledgerError = ledgerRes.ok ? '' : ledgerRes.reason;
const weeklyError = weeklyRes.ok ? '' : weeklyRes.reason;

const CARD = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px 18px;margin-bottom:16px;';
const IN = 'background:#15151a;border:1px solid #26262c;color:#fff;padding:7px 9px;border-radius:6px;font-size:12px;width:90px;';
const HD = "font-size:11px;color:#8a8a94;text-transform:uppercase;font-family:'Geist Mono',monospace;letter-spacing:0.1em;font-weight:700;margin:0 0 10px;";
const FAIL = 'font-size:12px;color:#fca5a5;margin:0;line-height:1.55;';
function fmt(d: any) { try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch { return '-'; } }
---
<AdminLayout title="Gamification" activeNav="xp-config">
  <div style="max-width:1000px;margin:0 auto;padding:24px;">
    <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 4px;">Gamification &amp; XP</h1>
    <p style="font-size:12.5px;color:#8a8a94;margin:0 0 16px;">XP comes from one ledger. An award that passes an award key can only ever pay out once, so re-doing the same lesson never double-awards. Student view: /aquintutor/xp.</p>
    <div id="msg" style="display:none;margin:0 0 12px;padding:9px 13px;border-radius:8px;font-size:13px;"></div>

    <div style={CARD}>
      <p style={HD}>XP values</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:end;">{Object.keys(XP_ACTION_DEFAULTS).map((k) => (
        <div><label style="font-size:10px;color:#8a8a94;">{k}</label><br/><input class="xpVal" data-k={k} type="number" min="0" value={(cfg as any)[k]} disabled={!canConfigure} style={IN} /></div>
      ))}
        {canConfigure ? <button id="saveCfg" type="button" style="background:#FF4F00;border:none;color:#fff;font-size:11px;font-weight:700;padding:8px 14px;border-radius:6px;cursor:pointer;">Save</button> : null}
      </div>
      <p style="font-size:11px;color:#8a8a94;margin:10px 0 0;line-height:1.5;">Only these four actions are configurable. Every other XP source in the product passes its own amount at the point of award and is not governed by this screen.</p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:16px;" class="xp-grid">
      <div style={CARD}>
        <p style={HD}>Recent XP ledger (audit)</p>
        {ledgerError
          ? <p style={FAIL}>The ledger could not be read, so this panel is not showing what is there. That is not the same as no XP having been awarded, and nothing on this screen should be used as an audit answer until it loads cleanly. Reason: {ledgerError}</p>
          : ledger.length === 0 ? <p style="font-size:12px;color:#8a8a94;margin:0;">No XP awarded yet.</p> :
        <div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:12px;">
          <thead><tr style="color:#8a8a94;font-size:9px;text-transform:uppercase;font-family:'Geist Mono',monospace;text-align:left;"><th style="padding:5px 8px;">When</th><th style="padding:5px 8px;">User</th><th style="padding:5px 8px;">Source</th><th style="padding:5px 8px;">XP</th></tr></thead>
          <tbody>{ledger.map((l) => (<tr style="border-top:1px solid #15151a;"><td style="padding:5px 8px;color:#8a8a94;font-family:'Geist Mono',monospace;white-space:nowrap;">{fmt(l.at)}</td><td style="padding:5px 8px;color:#cfd6da;">{l.userName || String(l.userId).slice(0, 8)}</td><td style="padding:5px 8px;color:#8a8a94;">{l.source}{l.reason ? ' - ' + l.reason : ''}</td><td style={'padding:5px 8px;color:' + (l.delta < 0 ? '#fca5a5' : '#6ee7b7') + ';'}>{l.delta < 0 ? '' : '+'}{l.delta}</td></tr>))}</tbody>
        </table></div>}
      </div>
      <div style={CARD}>
        <p style={HD}>This week</p>
        {weeklyError
          ? <p style={FAIL}>The weekly board could not be read. Reason: {weeklyError}</p>
          : weekly.length === 0 ? <p style="font-size:12px;color:#8a8a94;margin:0;">No weekly XP.</p> :
          <ol style="list-style:none;margin:0;padding:0;">{weekly.map((e, i: number) => <li style="display:flex;justify-content:space-between;padding:4px 0;font-size:12.5px;color:#cfd6da;"><span>{i + 1}. {e.name}</span><span style="color:#FF7040;">{e.xp}</span></li>)}</ol>}
        <p style="font-size:10.5px;color:#8a8a94;margin:10px 0 0;line-height:1.5;">Learners who opted out of the leaderboard are excluded here. They are still in the audit ledger on the left, which is not a ranking.</p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var b = document.getElementById('saveCfg'); if (!b) return; var msg = document.getElementById('msg');
      b.addEventListener('click', function () {
        var values = {}; document.querySelectorAll('.xpVal').forEach(function (i) { values[i.getAttribute('data-k')] = parseInt(i.value, 10) || 0; });
        b.disabled = true;
        fetch('/api/admin/gamification', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ values: values }) })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            b.disabled = false;
            msg.style.display = 'block';
            msg.textContent = j.ok ? 'Saved.' : (j.error || 'Nothing was saved.');
            msg.style.background = j.ok ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.12)';
            msg.style.color = j.ok ? '#6ee7b7' : '#fca5a5';
          })
          .catch(function () {
            // WAS NO .catch AT ALL: a dropped connection, a 500 answering with HTML, or an expired
            // session left the button dead and the screen silent, which reads as "saved".
            b.disabled = false;
            msg.style.display = 'block';
            msg.textContent = 'We could not reach the server, so nothing was saved.';
            msg.style.background = 'rgba(239,68,68,0.12)';
            msg.style.color = '#fca5a5';
          });
      });
    })();
  </script>
  <style>@media (max-width:720px){ .xp-grid{ grid-template-columns:1fr !important; } }</style>
</AdminLayout>
