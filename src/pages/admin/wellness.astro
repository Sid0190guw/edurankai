---
/**
 * /admin/wellness — programme oversight.
 *
 * THIS PAGE IS AGGREGATE ONLY, AND THAT IS ITS ENTIRE DESIGN.
 * There is no query on this page that returns a row per person. No name, no user id, no cycle,
 * no symptom, no request body, no reply, no drill-down and no "view as user". Everything rendered
 * here comes from the four oversight functions in src/lib/wellness.ts (activeUsers, consultLoad,
 * averageResponseHours, topTopics, gathered by programmeHealth), which are the only functions in
 * that engine that an administrator is allowed to call, and which already enforce the k-anonymity
 * floor of MIN_GROUP distinct people before publishing anything.
 *
 * SUPPRESSION IS HONOURED AS PRINTED. Where the engine says a figure is suppressed, this page
 * prints TOO_FEW_LABEL and never a small count. Where the engine reports that some categories were
 * held back, this page also drops the remaining categories, because publishing the survivors beside
 * a total lets anyone subtract their way back to the ones that were held back — the standard
 * differencing attack the engine's own comments warn about. A total with no breakdown gives nothing
 * away; a breakdown with one hole gives away the hole.
 *
 * MOTION. Nothing here animates except a 150ms lift on the period links, which are navigation.
 * Every figure is still. Reading a health programme's numbers is not an occasion for movement.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import '@/styles/wellness.css';

import Card from '@/components/wellness/Card.astro';
import Metric from '@/components/wellness/Metric.astro';
import Ring from '@/components/wellness/Ring.astro';
import Reveal from '@/components/wellness/Reveal.astro';
import Notice from '@/components/wellness/Notice.astro';
import EmptyState from '@/components/wellness/EmptyState.astro';

import {
  programmeHealth,
  MIN_GROUP,
  TOO_FEW_LABEL,
  CONSULT_TOPICS,
  type ProgrammeHealth,
} from '@/lib/wellness';

// ---------------------------------------------------------------------------
// Access. 'audit.view' is a permission that already exists in the Permission union — it is the
// oversight permission, the right to read the programme's record rather than anybody's file, and
// it is held only by super_admin. Inventing a new key here would silently evaluate to false for
// every role including super_admin and make this console unreachable, which has already happened
// once in this repo (see the comment above 'offers.view' in src/lib/auth/permissions.ts).
// ---------------------------------------------------------------------------
const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/admin/login');
if (!can(currentUser, 'audit.view')) return Astro.redirect('/admin');

const url = new URL(Astro.request.url);
const WINDOWS = [30, 90, 180, 365];
const requestedDays = Number.parseInt(url.searchParams.get('days') || '', 10);
const days = WINDOWS.includes(requestedDays) ? requestedDays : 90;

let health: ProgrammeHealth | null = null;
let readFailed = false;
try {
  health = await programmeHealth(days);
} catch (e: any) {
  readFailed = true;
  console.error('[admin/wellness] programmeHealth:', e?.cause?.message || e?.message);
}

const active = health?.active ?? null;
const load = health?.load ?? null;
const timings = health?.responseTimes ?? null;
const topics = health?.topics ?? null;

// The breakdown is published only when the engine held nothing back. See the note at the top of
// this file: a partial breakdown beside a published total is a subtraction away from the figures
// the floor exists to protect.
const showBreakdown = !!load && !load.suppressed && !load.someCategoriesSuppressed;

const totalRequests = load && !load.suppressed && load.total.count !== null ? load.total.count : null;
const answeredCount = showBreakdown && load ? load.answered.count : null;
const answeredPct =
  totalRequests !== null && totalRequests > 0 && answeredCount !== null
    ? Math.round((answeredCount / totalRequests) * 100)
    : null;

const topicMax = topics && topics.topics.length ? Math.max(...topics.topics.map((t) => t.people)) : 0;

/**
 * Defence in depth for anything printed as a bare count.
 *
 * The engine already refuses to return a figure below the floor, so today every number that
 * reaches this page is safe. This re-checks the floor at the moment of printing anyway, because
 * "the caller trusted the library" is how suppression quietly stops being enforced: a later change
 * to an early return in consultLoad() or averageResponseHours() would otherwise turn one of these
 * lines into a small number with nothing on this page to catch it.
 */
function atFloor(n: number | null | undefined): string {
  const v = Number(n);
  return Number.isFinite(v) && v >= MIN_GROUP ? String(Math.round(v)) : TOO_FEW_LABEL;
}

function hoursFigure(n: number | null | undefined): { value: string; unit: string } {
  if (n === null || n === undefined || !Number.isFinite(Number(n))) return { value: 'Not reported', unit: '' };
  const v = Number(n);
  if (v < 1) return { value: 'Under 1', unit: 'hour' };
  if (v < 48) {
    const r = Math.round(v * 10) / 10;
    return { value: String(r), unit: r === 1 ? 'hour' : 'hours' };
  }
  return { value: String(Math.round(v / 24)), unit: 'days' };
}

const medianFig = hoursFigure(timings && !timings.suppressed ? timings.medianHours : null);
const averageFig = hoursFigure(timings && !timings.suppressed ? timings.averageHours : null);
const longestFig = hoursFigure(load && !load.suppressed ? load.longestWaitHours : null);

const windowLabel = days === 365 ? 'the last year' : `the last ${days} days`;

// The line an administrator must not be able to miss. It is stated as a property of the system,
// not as a policy someone could ask to have relaxed, because that is what it is.
const BOUNDARY_LINE =
  'No individual health data appears on this page. There is no name, no user id, no cycle, no symptom, no request and no reply here, there is no screen anywhere in this console that shows them, and access to them cannot be requested, escalated or granted by anyone.';
---

<AdminLayout title="Wellness programme" activeNav="wellness">
  <div class="wa">
    <header class="wa-head">
      <p class="w-label">Wellness programme</p>
      <h1 class="wa-title">How the programme is doing</h1>
      <p class="wa-lead w-prose">
        Counts of activity for {windowLabel}, so the programme can be staffed and paid for. Nothing
        on this page describes a person.
      </p>

      <nav class="wa-win" aria-label="Reporting period">
        {WINDOWS.map((w) => (
          <a
            class:list={['wa-win__link', 'w-focusable', w === days && 'is-current']}
            href={`/admin/wellness?days=${w}`}
            aria-current={w === days ? 'page' : undefined}
          >
            {w === 365 ? '1 year' : `${w} days`}
          </a>
        ))}
      </nav>

      <p class="wa-p">
        <a class="wa-poollink w-focusable" href="/admin/wellness/consultants">The consultant pool</a>
        <span class="wa-poolnote">
          — who may read a consultation request. That is an appointment, not a figure, so it is a
          separate screen rather than a row-per-person on this one.
        </span>
      </p>
    </header>

    <div class="wa-boundary">
      <Notice kind="info" title="What this page can show, and what no page can show">
        <p class="wa-p">{BOUNDARY_LINE}</p>
        <Reveal
          summary="Why the figures are held back, and why there is no total to fill the gap"
          flush
          class="wa-reveal"
        >
          <p class="wa-p">
            A count below {MIN_GROUP} people is not a statistic, it is a description of specific
            people: in an organisation this size, a figure like "two people asked about pregnancy
            this month" plus ordinary office knowledge names them. So any group smaller than{' '}
            {MIN_GROUP} distinct people is reported as "{TOO_FEW_LABEL}" rather than as a number.
          </p>
          <p class="wa-p">
            The same reasoning removes the leftovers. Publishing a total beside a partly suppressed
            breakdown lets anyone subtract their way back to the suppressed part, so when any
            category is held back this page drops the whole breakdown and keeps only the total,
            which on its own reveals nothing.
          </p>
          <p class="wa-p">
            The floor is always counted in distinct people, never in requests. Forty requests from
            three people is still a picture of three people.
          </p>
        </Reveal>
      </Notice>
    </div>

    {readFailed && (
      <div class="wa-boundary">
        <Notice kind="guidance" title="The figures could not be read just now">
          <p class="wa-p">
            The programme counts are temporarily unavailable. Nothing has been lost and nothing else
            is affected. Reloading in a few minutes is usually enough.
          </p>
        </Notice>
      </div>
    )}

    <div class="wa-grid">
      <!-- People ------------------------------------------------------------->
      <Card module="cycle" padding="lg" as="section" label="People using the programme" class="wa-card">
        <h2 class="wa-card__title">People using it</h2>

        {active && !active.suppressed && active.people !== null ? (
          <Metric
            size="lg"
            module="cycle"
            value={active.people}
            label={`Distinct people, ${windowLabel}`}
            hint="Anyone who logged, tracked or asked something in the period. Counted once, whatever they did."
          />
        ) : (
          <div class="wa-held">
            <p class="w-label">Distinct people, {windowLabel}</p>
            <p class="wa-held__value">{TOO_FEW_LABEL}</p>
            <p class="wa-held__hint">
              Fewer than {MIN_GROUP} people have used it in this period, so no number is published.
              That is the design working, not a gap in the data.
            </p>
          </div>
        )}
      </Card>

      <!-- Demand ------------------------------------------------------------->
      <Card module="therapy" padding="lg" as="section" label="Requests for a consultant" class="wa-card">
        <h2 class="wa-card__title">Requests for a consultant</h2>

        {totalRequests !== null ? (
          <div class="wa-load">
            <div class="wa-load__figure">
              <Metric
                size="lg"
                module="therapy"
                value={totalRequests}
                label={`Requests, ${windowLabel}`}
                hint="How many were raised. What is in them is not readable from here."
              />
            </div>

            {showBreakdown && answeredPct !== null && (
              <div class="wa-load__ring">
                <Ring
                  module="therapy"
                  value={answeredPct}
                  max={100}
                  size={104}
                  display={`${answeredPct}%`}
                  label="Answered"
                />
              </div>
            )}
          </div>
        ) : (
          <div class="wa-held">
            <p class="w-label">Requests, {windowLabel}</p>
            <p class="wa-held__value">{TOO_FEW_LABEL}</p>
            <p class="wa-held__hint">{load?.note}</p>
          </div>
        )}

        {showBreakdown && load && (
          <ul class="wa-split">
            <li class="wa-split__row">
              <span class="wa-split__name">Waiting to be picked up</span>
              <span class="wa-split__val w-num">{load.waiting.label}</span>
            </li>
            <li class="wa-split__row">
              <span class="wa-split__name">With a consultant</span>
              <span class="wa-split__val w-num">{load.withConsultant.label}</span>
            </li>
            <li class="wa-split__row">
              <span class="wa-split__name">Answered</span>
              <span class="wa-split__val w-num">{load.answered.label}</span>
            </li>
          </ul>
        )}

        {load && !load.suppressed && load.someCategoriesSuppressed && (
          <p class="wa-note">
            The breakdown is not shown. Some of its categories held fewer than {MIN_GROUP} people,
            and showing the rest beside the total would give those categories away by subtraction.
          </p>
        )}

        {load && !load.suppressed && (
          <p class="wa-note">
            {load.longestWaitHours === null
              ? 'Nothing is currently waiting for a reply.'
              : `Longest anyone is currently waiting: ${longestFig.value} ${longestFig.unit}. Who they are and what they asked is not shown here or anywhere in this console.`}
          </p>
        )}
      </Card>

      <!-- Reply times -------------------------------------------------------->
      <Card module="fitness" padding="lg" as="section" label="How long a reply takes" class="wa-card">
        <h2 class="wa-card__title">How long a reply takes</h2>

        {timings && !timings.suppressed ? (
          <div>
            <Metric
              size="lg"
              module="fitness"
              value={medianFig.value}
              unit={medianFig.unit}
              label="Typical wait for an answer"
              hint="The middle of the range. Half of the replies were faster than this, half slower."
            />
            <ul class="wa-split">
              <li class="wa-split__row">
                <span class="wa-split__name">Average wait</span>
                <span class="wa-split__val w-num">
                  {averageFig.value} {averageFig.unit}
                </span>
              </li>
              <li class="wa-split__row">
                <span class="wa-split__name">Replies measured</span>
                <span class="wa-split__val w-num">{atFloor(timings.answeredCount)}</span>
              </li>
            </ul>
            <p class="wa-note">
              This is the number that says whether the programme actually works. A person who waits
              a week for an answer has not been helped, however good the answer was.
            </p>
          </div>
        ) : (
          <div class="wa-held">
            <p class="w-label">Typical wait for an answer</p>
            <p class="wa-held__value">{TOO_FEW_LABEL}</p>
            <p class="wa-held__hint">{timings?.note}</p>
          </div>
        )}
      </Card>
    </div>

    <!-- Subjects ------------------------------------------------------------->
    <section class="wa-topics" data-module="cycle" aria-labelledby="wa-topics-title">
      <Card module="cycle" padding="lg" as="div" class="wa-card">
        <h2 class="wa-card__title" id="wa-topics-title">Subjects being raised</h2>
        <p class="wa-sub">
          Which kind of consultant to arrange, by category and by how many different people raised
          it. The category is all that is counted; no question and no answer is read to produce this.
        </p>

        {topics && topics.topics.length > 0 ? (
          <div>
            <ul class="wa-bars">
              {topics.topics.map((t) => (
                <li class="wa-bar">
                  <div class="wa-bar__head">
                    <span class="wa-bar__name">{t.topic}</span>
                    <span class="wa-bar__val w-num">{atFloor(t.people)}</span>
                  </div>
                  <div class="wa-bar__track" aria-hidden="true">
                    <div
                      class="wa-bar__fill"
                      style={`width:${topicMax > 0 ? Math.max(6, Math.round((t.people / topicMax) * 100)) : 0}%`}
                    >
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="wa-note">
              Counted in distinct people, not in requests, across the {CONSULT_TOPICS.length}{' '}
              subjects a person can choose from.
            </p>
            {topics.someCategoriesSuppressed && <p class="wa-note">{topics.note}</p>}
          </div>
        ) : (
          <EmptyState
            module="cycle"
            illustration="note"
            headingLevel={3}
            title="Nothing is broken down here yet"
            body={topics?.note || `No single subject has been raised by ${MIN_GROUP} or more people, so nothing is listed.`}
          />
        )}
      </Card>
    </section>

    <footer class="wa-foot">
      <p class="wa-p w-prose">{BOUNDARY_LINE}</p>
      {health && <p class="wa-note w-prose">{health.disclaimer}</p>}
      <p class="wa-note w-prose">
        What someone writes in a request is read by the consultant it is routed to and by nobody
        else. It is not visible to a manager, to HR, to the administrators of this site, or to
        anyone reporting on the programme. This page counts requests; it cannot open one.
      </p>
    </footer>
  </div>
</AdminLayout>

<style>
  /* Everything below reads from src/styles/wellness.css. No hex is written here, which is also
     what makes the page follow the console's own light/dark toggle: AdminLayout sets
     data-theme on <html>, and the wellness tokens already answer to it. */
  .wa {
    box-sizing: border-box;
    max-width: var(--w-container);
    margin: 0 auto;
    padding: var(--w-space-6) var(--w-gutter) var(--w-space-10);
    background-color: var(--w-ground);
    color: var(--w-ink);
    font-family: var(--w-font-text);
    overflow-x: hidden;
  }

  .wa :global(*) {
    box-sizing: border-box;
  }

  /* ---- header ---------------------------------------------------------- */
  .wa-head {
    max-width: var(--w-container-readable);
  }

  .wa-title {
    margin: var(--w-space-2) 0 0;
    font-family: var(--w-font-display);
    font-size: var(--w-text-h1);
    font-weight: var(--w-weight-regular);
    line-height: var(--w-leading-tight);
    letter-spacing: var(--w-tracking-tight);
    color: var(--w-ink);
    text-wrap: balance;
  }

  .wa-lead {
    margin: var(--w-space-3) 0 0;
    color: var(--w-ink-2);
  }

  /* Navigation is the one place motion is allowed here, and it is Tier B: a 150ms lift on
     transform only, which a cheap phone renders on the compositor for nothing. */
  .wa-win {
    display: flex;
    flex-wrap: wrap;
    gap: var(--w-space-2);
    margin-top: var(--w-space-5);
  }

  .wa-win__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--w-tap-min);
    padding: 0 var(--w-space-4);
    border: var(--w-border-width) solid var(--w-hairline-strong);
    border-radius: var(--w-radius-pill);
    background-color: var(--w-surface);
    color: var(--w-ink-2);
    font-size: var(--w-text-sm);
    font-weight: var(--w-weight-medium);
    text-decoration: none;
    transition: var(--w-b-transition-tap);
  }

  .wa-win__link:hover {
    transform: translateY(var(--w-lift));
    color: var(--w-ink);
  }

  .wa-win__link.is-current {
    border-color: var(--w-hairline-heavy);
    background-color: var(--w-surface-sunk);
    color: var(--w-ink);
  }

  /* The one link off this page. Text, not a control: it leads to an appointment screen. */
  .wa-poollink {
    color: var(--w-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .wa-poolnote { color: var(--w-ink-3); }

  /* ---- boundary -------------------------------------------------------- */
  .wa-boundary {
    margin-top: var(--w-space-6);
  }

  .wa-p {
    margin: 0 0 var(--w-space-3);
    font-size: var(--w-text-base);
    line-height: var(--w-leading-relaxed);
    color: var(--w-ink);
  }

  .wa-p:last-child {
    margin-bottom: 0;
  }

  .wa-reveal {
    margin-top: var(--w-space-3);
  }

  /* ---- cards ----------------------------------------------------------- */
  .wa-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--w-space-4);
    margin-top: var(--w-space-6);
  }

  @media (min-width: 46rem) {
    .wa-grid {
      grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    }
  }

  .wa-card {
    min-width: 0;
  }

  .wa-card__title {
    margin: 0 0 var(--w-space-4);
    font-family: var(--w-font-display);
    font-size: var(--w-text-h3);
    font-weight: var(--w-weight-regular);
    line-height: var(--w-leading-snug);
    color: var(--w-ink);
  }

  .wa-sub {
    margin: calc(-1 * var(--w-space-2)) 0 var(--w-space-5);
    font-size: var(--w-text-sm);
    line-height: var(--w-leading-normal);
    color: var(--w-ink-2);
    max-width: var(--w-container-readable);
  }

  /* A figure that is not published. Deliberately the same weight as everything else on the
     card: a held-back number is a normal state, not a fault, and it should not read as one. */
  .wa-held {
    padding: var(--w-space-1) 0;
  }

  .wa-held__value {
    margin: var(--w-space-2) 0 0;
    font-size: var(--w-text-lg);
    font-weight: var(--w-weight-medium);
    line-height: var(--w-leading-snug);
    color: var(--w-ink-2);
  }

  .wa-held__hint {
    margin: var(--w-space-2) 0 0;
    font-size: var(--w-text-sm);
    line-height: var(--w-leading-normal);
    color: var(--w-ink-3);
  }

  .wa-load {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--w-space-4);
  }

  .wa-load__figure {
    flex: 1 1 11rem;
    min-width: 0;
  }

  .wa-load__ring {
    flex: 0 0 auto;
  }

  .wa-split {
    list-style: none;
    margin: var(--w-space-5) 0 0;
    padding: 0;
    border-top: var(--w-border-width) solid var(--w-hairline);
  }

  .wa-split__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--w-space-3);
    padding: var(--w-space-3) 0;
    border-bottom: var(--w-border-width) solid var(--w-hairline);
  }

  .wa-split__name {
    font-size: var(--w-text-sm);
    line-height: var(--w-leading-snug);
    color: var(--w-ink-2);
    min-width: 0;
  }

  .wa-split__val {
    font-size: var(--w-text-base);
    font-weight: var(--w-weight-medium);
    color: var(--w-ink);
    text-align: end;
    white-space: nowrap;
  }

  .wa-note {
    margin: var(--w-space-4) 0 0;
    font-size: var(--w-text-sm);
    line-height: var(--w-leading-normal);
    color: var(--w-ink-3);
  }

  /* ---- subjects -------------------------------------------------------- */
  .wa-topics {
    margin-top: var(--w-space-4);
  }

  .wa-bars {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wa-bar + .wa-bar {
    margin-top: var(--w-space-4);
  }

  .wa-bar__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--w-space-3);
    margin-bottom: var(--w-space-2);
  }

  .wa-bar__name {
    font-size: var(--w-text-sm);
    line-height: var(--w-leading-snug);
    color: var(--w-ink);
    min-width: 0;
  }

  .wa-bar__val {
    font-size: var(--w-text-sm);
    font-weight: var(--w-weight-medium);
    color: var(--w-ink-2);
    white-space: nowrap;
  }

  .wa-bar__track {
    height: 8px;
    border-radius: var(--w-radius-pill);
    background-color: var(--w-surface-sunk);
    overflow: hidden;
  }

  /* Accent is non-text by the token rules, which is exactly what a bar is. The number beside it
     carries the value, so nothing here depends on colour. The width is painted once and never
     transitions: this is a report, not a performance. */
  .wa-bar__fill {
    height: 100%;
    border-radius: var(--w-radius-pill);
    background-color: var(--w-module-accent, var(--w-ink-4));
  }

  /* ---- footer ---------------------------------------------------------- */
  .wa-foot {
    margin-top: var(--w-space-7);
    padding-top: var(--w-space-5);
    border-top: var(--w-border-width) solid var(--w-hairline);
  }

  .wa-foot .wa-note {
    margin-top: var(--w-space-3);
  }
</style>
