---
// Read-only diagnostic for the AICTE columns and the careers keyword-search clause.
//
// Exists because keyword-only searches ("Telemetry Analysis", "Multilingual AI") return zero on
// the live site and there are two very different possible causes that cannot be told apart from
// outside the database: either the runtime `keywords` column is empty/absent, or the search clause
// itself errors and the resilience fallback in careers.astro silently covers for it. This page
// runs the exact same SQL the careers page runs and reports which it is.
//
// THE CHECKS ARE SELECT-ONLY. The buttons are not: this page also carries the bulk REPAIRS for
// the same data it diagnoses (AICTE fields, work mode, venture tags), because they run inside the
// app, which already holds the right credentials, and no connection string has to be copied
// anywhere. Every repair touches only rows that are actually empty or actually contradict the
// policy, so a hand edit is never overwritten.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { can } from '@/lib/auth/permissions';
import { sql } from 'drizzle-orm';
import { correctedLocation, violatesWorkModePolicy } from '@/lib/work-mode';

// Declared HERE, above the POST handler that uses it. It previously sat below, and `const` is not
// hoisted — so every Repair run died on "Cannot access 'rows' before initialization" while the
// read-only checks beneath it, which run after the declaration, all passed. That combination is
// what made it read as "All checks passed" and "Repair failed" on the same screen.
const rows = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

const user = Astro.locals.user!;
if (!can(user, 'roles.edit')) return Astro.redirect('/admin');

// One-click repair. Runs INSIDE the app, which already holds the correct database credentials —
// no connection string has to be copied anywhere, which is the whole point: every attempt to move
// that credential by hand has ended up either a placeholder or pointed at a stale database.
//
// Uses the bulk writers, so this is a handful of statements rather than one per role.
let repairMsg = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'repair') {
    try {
      const { ROLE_CATALOG } = await import('@/data/role-catalog');
      const { setRoleAicteBulk } = await import('@/lib/role-aicte');
      const { setRoleProducts, getProductOptions, ensureRoleProductColumn } = await import('@/lib/role-products');
      await ensureRoleProductColumn().catch(() => {});

      // Only touch rows that are actually empty, so an admin's hand edits are never overwritten.
      const emptyAicte = rows(await db.execute(sql`
        SELECT slug FROM roles
        WHERE COALESCE(array_length(keywords, 1), 0) = 0
          AND COALESCE(array_length(learning_outcomes, 1), 0) = 0
          AND COALESCE(array_length(perks, 1), 0) = 0`)).map((r: any) => r.slug);
      const emptySet = new Set(emptyAicte);
      const todo = (ROLE_CATALOG as any[]).filter((c) => emptySet.has(c.slug) && (c.keywords || c.learningOutcomes || c.perks));

      const n = await setRoleAicteBulk(todo.map((c) => ({
        slug: c.slug,
        a: {
          keywords: c.keywords, learningOutcomes: c.learningOutcomes, qualificationType: c.qualificationType,
          qualifications: c.qualifications, specialisations: c.specialisations, noOfInterns: c.noOfInterns,
          perks: c.perks, internshipMode: c.internshipMode, workingDaysPerWeek: c.workingDaysPerWeek,
          hoursPerWeek: c.hoursPerWeek, projectHoursPerDay: c.projectHoursPerDay,
          wellbeingHoursPerDay: c.wellbeingHoursPerDay, engagementNotes: c.engagementNotes,
        },
      })));

      // Product tags for rows that have none.
      let tagged = 0;
      try {
        const opts = await getProductOptions();
        const emptyProd = rows(await db.execute(sql`
          SELECT id, slug FROM roles WHERE COALESCE(array_length(products, 1), 0) = 0`));
        const bySlug = new Map(emptyProd.map((r: any) => [r.slug, r.id]));
        for (const c of ROLE_CATALOG as any[]) {
          if (!c.productMatch) continue;
          const id = bySlug.get(c.slug);
          if (!id) continue;
          const tags = opts.filter((p: any) => p.slug.includes(c.productMatch) || p.name.toLowerCase().includes(c.productMatch)).map((p: any) => p.slug);
          if (tags.length) { await setRoleProducts(id as string, tags); tagged++; }
        }
      } catch (_) {}

      repairMsg = `Repaired AICTE fields on ${n} role(s) and product tags on ${tagged}. ${emptyAicte.length - n} row(s) had no catalog entry to repair from.`;
    } catch (e: any) {
      repairMsg = 'Repair failed: ' + (e?.cause?.message || e?.message || 'unknown');
    }
  }

  // Venture tags from the department mapping.
  //
  // The repair above can only tag the two catalogue entries that carry a `productMatch` — that is
  // the whole reason every venture page read "no roles are open right now". This one tags from
  // src/lib/product-domains.ts instead, which covers every department that builds a venture, and
  // it resolves the product row with the SAME matcher the pages use rather than a second copy of
  // the rule written in SQL.
  if (fd.get('_action') === 'tag-ventures') {
    try {
      const { backfillProductTagsFromDomains } = await import('@/lib/role-products');
      const res = await backfillProductTagsFromDomains();
      const per = Object.entries(res.perProduct).map(([s, n]) => s + ': ' + n).join(', ');
      repairMsg = res.tagged === 0
        ? 'No role needed a venture tag. Either every role in a mapped department already carries one, or no product row matched the mapping.'
        : `Tagged ${res.tagged} role(s) by venture${per ? ' — ' + per : ''}.`;
      if (res.unmatchedVentures.length) {
        repairMsg += ` NOT WRITTEN for ${res.unmatchedVentures.join(', ')}: the mapping has departments for `
          + 'these but no row in `products` matched the slug, so nothing was tagged for them.';
      }
      if (res.untaggedProducts.length) {
        repairMsg += ` No department mapping exists for: ${res.untaggedProducts.join(', ')} (expected for the`
          + ' ventures nobody is hired against).';
      }
    } catch (e: any) {
      // Surfaced verbatim, because the likely cause is that the three columns do not exist on this
      // database — which is a different problem with a different fix (db/product-domains-schema.sql)
      // and must not be reported as "nothing to tag".
      repairMsg = 'Venture tagging failed: ' + (e?.cause?.message || e?.message || 'unknown');
    }
  }

  // Work-mode repair. The catalogue and every rendering surface were corrected in code, but the
  // roles ALREADY in this table still carry the string they were imported with -- and that string
  // is what an exported feed, an offer letter draft and an admin export read. This rewrites only
  // the rows that contradict the policy, and leaves a role with a genuine bespoke site alone.
  if (fd.get('_action') === 'work-mode') {
    try {
      const candidates = rows(await db.execute(sql`
        SELECT slug, engagement_type, level, location FROM roles`));
      const fixes = candidates
        .filter((r: any) => violatesWorkModePolicy(r.engagement_type, r.level, r.location))
        .map((r: any) => ({
          slug: String(r.slug),
          loc: correctedLocation(r.engagement_type, r.level, r.location),
        }));

      if (!fixes.length) {
        repairMsg = 'No role advertises remote work. Nothing to repair.';
      } else {
        // ONE statement, not one per role. A round trip per row is what makes a 700-role table take
        // minutes from a serverless region; the whole correction is a single VALUES join.
        const pairs = fixes.map((f) => sql`(${f.slug}::varchar, ${f.loc}::varchar)`);
        await db.execute(sql`
          UPDATE roles AS r
             SET location = v.loc, updated_at = now()
            FROM (VALUES ${sql.join(pairs, sql`, `)}) AS v(slug, loc)
           WHERE r.slug = v.slug`);
        const hybrid = fixes.filter((f) => /hybrid/i.test(f.loc)).length;
        repairMsg = `Work mode corrected on ${fixes.length} role(s): `
          + `${fixes.length - hybrid} set to on-site, ${hybrid} to on-site / hybrid (internships and apprenticeships). `
          + `${candidates.length - fixes.length} role(s) were already correct.`;
      }
    } catch (e: any) {
      repairMsg = 'Work-mode repair failed: ' + (e?.cause?.message || e?.message || 'unknown');
    }
  }
}

type Check = { label: string; ok: boolean | null; detail: string };
const checks: Check[] = [];
const add = (label: string, ok: boolean | null, detail: string) => checks.push({ label, ok, detail });

// 0. Does any live role still advertise remote work? The careers pages clamp this at render time,
// so nothing remote is SHOWN either way -- but the stored string is what feeds exports, the public
// jobs feed's mirror and the offer-letter drafts, so it still has to be corrected.
try {
  const wm = rows(await db.execute(sql`SELECT slug, engagement_type, level, location FROM roles`));
  const bad = wm.filter((r: any) => violatesWorkModePolicy(r.engagement_type, r.level, r.location));
  add(
    'Work mode: on-site, hybrid for trainees only',
    bad.length === 0,
    bad.length === 0
      ? `All ${wm.length} role(s) store a location consistent with the policy.`
      : `${bad.length} of ${wm.length} role(s) still store a remote or wrongly-hybrid location — e.g. `
        + bad.slice(0, 3).map((r: any) => r.slug + ' ("' + r.location + '")').join(', ')
        + '. Use "Correct work mode on every role" above.',
  );
} catch (e: any) {
  add('Work mode: on-site, hybrid for trainees only', null, 'Could not read: ' + (e?.cause?.message || e?.message));
}

// 0b. THE VENTURE LINKAGE. "/ecosystem/<venture> shows no roles" has three causes that look
// identical from outside the database, and this section separates them:
//
//   (a) the three tag columns do not exist    -> run db/product-domains-schema.sql
//   (b) they exist but no role is tagged      -> press "Tag roles from the venture mapping"
//   (c) the mapped departments have no OPEN roles -> a catalogue problem, not a schema one
//
// (c) is the one that matters most: the venture pages resolve roles by department and do not need
// the tags at all, so if this check is green and the page is still empty, the postings are closed.
try {
  const { productColumnStatus } = await import('@/lib/role-products');
  const { PRODUCT_DOMAINS } = await import('@/lib/product-domains');
  const colStatus = await productColumnStatus();
  add('Venture tag columns exist on roles', colStatus.missing.length === 0,
    colStatus.missing.length === 0
      ? 'product, products and openings are all present.'
      : `MISSING: ${colStatus.missing.join(', ')}. No file in db/ creates them and SCHEMA_BOOTSTRAP is `
        + 'off in production, so they were never added. Run db/product-domains-schema.sql. Until then the '
        + 'venture pages fall back to matching by department, which still works.');

  if (colStatus.missing.length === 0) {
    const t = rows(await db.execute(sql`
      SELECT COUNT(*) FILTER (WHERE COALESCE(array_length(products, 1), 0) > 0)::int AS tagged,
             COUNT(*)::int AS total
        FROM roles WHERE is_open = true`))[0];
    add('Open roles carrying a venture tag', Number(t?.tagged || 0) > 0,
      `${t?.tagged || 0} of ${t?.total || 0} open roles are tagged. Two catalogue entries in src/data carry `
      + 'a product tag; every other tag has to come from the venture mapping. Use "Tag roles from the '
      + 'venture mapping" below.');
  }

  // Every department the mapping resolves through, and whether it actually has open postings.
  //
  // `is_open` alone, deliberately, and it is an UPPER BOUND rather than the number the venture page
  // will print. The page gates on openPostingClause() — is_open AND job_status='PUBLISHED' AND an
  // unexpired deadline — but `job_status` comes from the hand-run db/xscale-schema.sql and may not
  // exist here, and a diagnostic that errors on a missing column tells you less than one that
  // answers a slightly wider question.
  const mapped = Array.from(new Set(PRODUCT_DOMAINS.flatMap((p) => p.departments)));
  if (mapped.length) {
    const counts = rows(await db.execute(sql`
      SELECT department_id, COUNT(*)::int AS n
        FROM roles
       WHERE is_open = true AND department_id IN (SELECT jsonb_array_elements_text(${JSON.stringify(mapped)}::jsonb))
       GROUP BY department_id`));
    const byDept: Record<string, number> = {};
    for (const c of counts) byDept[String(c.department_id)] = Number(c.n) || 0;
    const dead = PRODUCT_DOMAINS
      .filter((p) => p.departments.length)
      .filter((p) => p.departments.reduce((a, d) => a + (byDept[d] || 0), 0) === 0)
      .map((p) => p.slug);
    add('Every mapped venture has open postings', dead.length === 0,
      dead.length === 0
        ? PRODUCT_DOMAINS.filter((p) => p.departments.length)
            .map((p) => p.slug + ': ' + p.departments.reduce((a, d) => a + (byDept[d] || 0), 0))
            .join(' | ')
        : `These ventures resolve to departments with ZERO open roles, so their page is empty no matter `
          + `what the tags say: ${dead.join(', ')}. The postings are closed or were never imported.`);
  }
} catch (e: any) {
  add('Venture linkage', null, 'Could not read: ' + (e?.cause?.message || e?.message));
}

const AICTE_COLS = ['keywords', 'learning_outcomes', 'qualification_type', 'qualifications', 'specialisations',
  'no_of_interns', 'perks', 'internship_mode', 'working_days_per_week', 'hours_per_week',
  'project_hours_per_day', 'wellbeing_hours_per_day', 'engagement_notes'];

// 1. Do the AICTE columns actually exist on the roles table?
let presentCols: string[] = [];
try {
  presentCols = rows(await db.execute(sql`
    SELECT column_name FROM information_schema.columns
    WHERE table_name = 'roles'
      AND column_name IN (SELECT jsonb_array_elements_text(${JSON.stringify(AICTE_COLS)}::jsonb))`)).map((r: any) => r.column_name);
  const missing = AICTE_COLS.filter((c) => !presentCols.includes(c));
  add('AICTE columns exist on roles', missing.length === 0,
    missing.length === 0 ? `all ${AICTE_COLS.length} present` : `MISSING: ${missing.join(', ')}`);
} catch (e: any) {
  add('AICTE columns exist on roles', false, 'check failed: ' + (e?.cause?.message || e?.message));
}

const hasKeywords = presentCols.includes('keywords');

// 2. How many rows actually have data in them?
if (hasKeywords) {
  try {
    const r = rows(await db.execute(sql`
      SELECT COUNT(*)::int AS total,
        COUNT(*) FILTER (WHERE COALESCE(array_length(keywords, 1), 0) > 0)::int AS with_keywords,
        COUNT(*) FILTER (WHERE COALESCE(array_length(learning_outcomes, 1), 0) > 0)::int AS with_outcomes,
        COUNT(*) FILTER (WHERE COALESCE(array_length(perks, 1), 0) > 0)::int AS with_perks,
        COUNT(*) FILTER (WHERE COALESCE(array_length(engagement_notes, 1), 0) > 0)::int AS with_terms
      FROM roles`))[0];
    add('Rows with keywords populated', r.with_keywords > 0,
      `${r.with_keywords} of ${r.total} roles. learning_outcomes: ${r.with_outcomes}, perks: ${r.with_perks}, engagement_notes (Terms of Engagement): ${r.with_terms}`);
  } catch (e: any) {
    add('Rows with keywords populated', false, 'query failed: ' + (e?.cause?.message || e?.message));
  }
}

// 3. Run the EXACT keyword clause careers.astro uses. If this throws, the clause is the bug.
let clauseWorks = false;
try {
  const r = rows(await db.execute(sql`
    SELECT COUNT(*)::int AS n FROM roles
    WHERE is_open = true
      AND EXISTS (SELECT 1 FROM unnest(COALESCE(keywords, '{}'::text[])) AS kw WHERE kw ILIKE ${'%a%'})`))[0];
  clauseWorks = true;
  add('Keyword search clause executes', true, `ran without error; ${r.n} open roles have a keyword containing "a"`);
} catch (e: any) {
  add('Keyword search clause executes', false, 'THE CLAUSE IS THE BUG -> ' + (e?.cause?.message || e?.message));
}

// 4. The specific failing searches, isolated to the keywords column only.
for (const term of ['Telemetry Analysis', 'Multilingual AI', 'Drone Systems', 'OCR']) {
  if (!clauseWorks) break;
  try {
    const r = rows(await db.execute(sql`
      SELECT title FROM roles
      WHERE is_open = true
        AND EXISTS (SELECT 1 FROM unnest(COALESCE(keywords, '{}'::text[])) AS kw WHERE kw ILIKE ${'%' + term + '%'})
      LIMIT 5`));
    add(`keywords match: "${term}"`, r.length > 0, r.length ? r.map((x: any) => x.title).join(' | ') : 'no role has this keyword stored');
  } catch (e: any) {
    add(`keywords match: "${term}"`, false, 'failed: ' + (e?.cause?.message || e?.message));
  }
}

// 5. Confirm the whole composite predicate careers.astro builds is valid SQL.
try {
  const like = '%Telemetry Analysis%';
  const r = rows(await db.execute(sql`
    SELECT COUNT(*)::int AS n FROM roles
    WHERE is_open = true AND (
      title ILIKE ${like}
      OR function ILIKE ${like}
      OR about ILIKE ${like}
      OR EXISTS (SELECT 1 FROM jsonb_array_elements_text(
           CASE WHEN jsonb_typeof(skills) = 'array' THEN skills ELSE '[]'::jsonb END) AS skill WHERE skill ILIKE ${like})
      OR EXISTS (SELECT 1 FROM departments d WHERE d.id = roles.department_id AND d.name ILIKE ${like})
      OR EXISTS (SELECT 1 FROM unnest(COALESCE(keywords, '{}'::text[])) AS kw WHERE kw ILIKE ${like})
    )`))[0];
  add('Full careers.astro search predicate', true, `valid SQL; returns ${r.n} for "Telemetry Analysis"`);
} catch (e: any) {
  add('Full careers.astro search predicate', false, 'INVALID -> ' + (e?.cause?.message || e?.message));
}

// 6. Are the newest roles present at all?
try {
  const r = rows(await db.execute(sql`
    SELECT slug FROM roles
    WHERE slug IN (SELECT jsonb_array_elements_text(${JSON.stringify(['llm-engineering-intern', 'quantum-nlp-intern', 'quantum-finance-intern'])}::jsonb))`));
  add('Newest 8 roles imported', r.length === 3, r.length ? 'found: ' + r.map((x: any) => x.slug).join(', ') : 'none of the new roles are in the database yet — click Import catalog');
} catch (e: any) {
  add('Newest 8 roles imported', false, 'check failed: ' + (e?.cause?.message || e?.message));
}

const failed = checks.filter((c) => c.ok === false).length;
---
<AdminLayout title="Role data diagnostic">
  <div style="max-width:900px;">
    <h1 style="font-family:'Fraunces',serif;font-size:26px;margin:0 0 6px;">Role data diagnostic</h1>
    <p style="font-size:13px;color:#8a8a94;margin:0 0 20px;">
      Runs the exact SQL the careers and venture pages use, to show whether the columns hold data and
      whether the clauses are valid. The checks below only read. The buttons above write, in bulk, and
      only to rows that are empty or contradict the policy.
    </p>

    <div style={`padding:12px 14px;border-radius:10px;margin-bottom:18px;border:1px solid ${failed ? '#7f1d1d' : '#14532d'};background:${failed ? 'rgba(127,29,29,0.18)' : 'rgba(20,83,45,0.18)'};`}>
      <strong style="font-size:14px;">{failed === 0 ? 'All checks passed.' : failed + ' check(s) failed — see below.'}</strong>
    </div>

    {repairMsg && (
      <div style="padding:12px 14px;border-radius:10px;margin-bottom:18px;border:1px solid #1d4ed8;background:rgba(29,78,216,0.15);">
        <strong style="font-size:13px;color:#e8e8ee;">{repairMsg}</strong>
      </div>
    )}

    <form method="POST" style="margin-bottom:18px;">
      <input type="hidden" name="_action" value="repair" />
      <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:13px;padding:10px 18px;border-radius:8px;cursor:pointer;">
        Repair empty AICTE fields &amp; product tags
      </button>
      <span style="font-size:11.5px;color:#8a8a94;margin-left:10px;">
        Runs in bulk. Only fills rows that are actually empty, so hand edits are never overwritten.
      </span>
    </form>

    <form method="POST" style="margin-bottom:18px;">
      <input type="hidden" name="_action" value="tag-ventures" />
      <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:13px;padding:10px 18px;border-radius:8px;cursor:pointer;">
        Tag roles from the venture mapping
      </button>
      <span style="font-size:11.5px;color:#8a8a94;margin-left:10px;">
        Writes the venture tag onto every role in a department that builds it (src/lib/product-domains.ts).
        One statement per venture, and only rows with no tag at all are touched. Needs the three columns above.
      </span>
    </form>

    <form method="POST" style="margin-bottom:18px;">
      <input type="hidden" name="_action" value="work-mode" />
      <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:13px;padding:10px 18px;border-radius:8px;cursor:pointer;">
        Correct work mode on every role
      </button>
      <span style="font-size:11.5px;color:#8a8a94;margin-left:10px;">
        Permanent roles become on-site; internships and apprenticeships become on-site / hybrid. One statement, and only rows that contradict the policy are touched.
      </span>
    </form>

    <div style="display:flex;flex-direction:column;gap:8px;">
      {checks.map((c) => (
        <div style={`border:1px solid ${c.ok === false ? '#7f1d1d' : '#2a2a30'};border-radius:10px;padding:12px 14px;background:#0f0f14;`}>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
            <span style={`font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:${c.ok === false ? '#f87171' : '#4ade80'};`}>
              {c.ok === false ? 'FAIL' : 'OK'}
            </span>
            <span style="font-size:13px;font-weight:600;color:#e8e8ee;">{c.label}</span>
          </div>
          <p style="font-size:12px;color:#a0a0a8;margin:0;line-height:1.5;word-break:break-word;">{c.detail}</p>
        </div>
      ))}
    </div>

    <p style="font-size:12px;color:#8a8a94;margin:20px 0 0;">
      <a href="/admin/roles" style="color:#FF4F00;">Back to roles</a>
    </p>
  </div>
</AdminLayout>
