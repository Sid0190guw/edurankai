---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { roles, departments } from '@/lib/db/schema';
import { can } from '@/lib/auth/permissions';
import { roleSchema, parseLines } from '@/lib/validators';
import { logAudit } from '@/lib/audit';
import { eq, asc, and, ne } from 'drizzle-orm';
import { getProductOptions, setRoleProducts, getRoleProducts, setRoleOpenings, getRoleOpenings } from '@/lib/role-products';
import { getRoleAicte, setRoleAicte } from '@/lib/role-aicte';
import { violatesWorkModePolicy, workModePolicyMessage } from '@/lib/work-mode';
import { getRoleExtension, setRoleExtension, setJobStatus, statusOf } from '@/lib/xscale/roles-ext';
import { listDivisions } from '@/lib/xscale/divisions';
import {
  JOB_STATUSES, RESEARCH_CLASSIFICATIONS, CAREER_LADDER, SCALE_BANDS,
  allowedTransitions, classificationEvidence, clampExp, scaleRangeText,
} from '@/lib/xscale/taxonomy';

const user = Astro.locals.user!;
const canEdit = can(user, 'roles.edit');

const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/roles');

const allDepts = await db.select().from(departments).orderBy(asc(departments.sortOrder));
const productOptions = await getProductOptions();
let currentProducts = await getRoleProducts(id);
let currentOpenings = await getRoleOpenings(id);
let currentAicte = await getRoleAicte(id);

// EVERY const BEFORE THE POST HANDLER THAT READS IT. `const` is not hoisted, and a handler placed
// above its own dependencies throws on its first line while the page still reports success — the
// failure at the top of this project's working rules, which broke apply step 5 and the roles
// Repair button.
let currentExt = await getRoleExtension(id);
const divisionOptions = (await listDivisions({ includeHidden: true })).rows;

let errorMsg = '';
let okMsg = '';

const existing = await db.select().from(roles).where(eq(roles.id, id)).limit(1);
if (existing.length === 0) {
  return Astro.redirect('/admin/roles');
}
let current = existing[0];

if (Astro.request.method === 'POST' && canEdit) {
  const fd = await Astro.request.formData();
  const intent = fd.get('_intent');

  // ---- STATUS TRANSITION. Its own intent, deliberately separate from Save. -------------------
  //
  // Publishing and closing a posting are not the same act as editing its wording, and merging them
  // into one button is how somebody closes a role while fixing a typo. setJobStatus() writes
  // `is_open` in the same statement: nine existing surfaces filter on that column and know nothing
  // about job_status, so writing only the new one would produce a Close that closed the posting on
  // this page and nowhere else.
  if (intent === 'set_status') {
    const next = String(fd.get('job_status') || '').toUpperCase();
    const permitted = allowedTransitions(currentExt.jobStatus || (current.isOpen ? 'PUBLISHED' : 'CLOSED'));
    if (!permitted.includes(next as any)) {
      errorMsg = 'That transition is not allowed from the current status. Permitted: ' + permitted.join(', ') + '.';
    } else {
      try {
        await setJobStatus(id, next as any);
        await logAudit({
          userId: user.id, action: 'role.status', entity: 'role', entityId: id,
          diff: { from: currentExt.jobStatus, to: next }, ipAddress: Astro.clientAddress,
        });
        currentExt = await getRoleExtension(id);
        const refreshed = await db.select().from(roles).where(eq(roles.id, id)).limit(1);
        current = refreshed[0];
        okMsg = next === 'PUBLISHED'
          ? 'Published. This posting is now live on the careers site and accepting applications.'
          : 'Status set to ' + next + '. It is no longer accepting applications, and the submission path refuses it server-side.';
      } catch (e: any) {
        console.error('[admin/roles/[id]] status change failed:', e?.cause?.message || e?.message);
        errorMsg = 'The status was NOT changed: ' + (e?.cause?.message || e?.message || 'unknown database error');
      }
    }
  }

  if (intent === 'delete') {
    await db.delete(roles).where(eq(roles.id, id));
    await logAudit({
      userId: user.id,
      action: 'role.delete',
      entity: 'role',
      entityId: id,
      diff: { deleted: { title: current.title, slug: current.slug } },
      ipAddress: Astro.clientAddress
    });
    return Astro.redirect('/admin/roles');
  }

  // ---- THE SAVE PATH RUNS ONLY FOR A SAVE. ---------------------------------------------------
  // The status form above posts job_status and nothing else. Without this guard the whole
  // validate-and-update block below runs on a status change too, roleSchema.safeParse() fails on
  // the empty title, and the page reports a validation error over a status change that succeeded.
  if (intent !== 'set_status') {

  // AICTE-portal-format fields (stored separately — see src/lib/role-aicte.ts)
  const aicteData = {
    keywords: parseLines(fd.get('keywords') as string),
    learningOutcomes: parseLines(fd.get('learningOutcomes') as string),
    qualificationType: (fd.get('qualificationType') as string || '').trim(),
    qualifications: parseLines(fd.get('qualifications') as string),
    specialisations: parseLines(fd.get('specialisations') as string),
    noOfInterns: (() => { const n = parseInt((fd.get('noOfInterns') as string) || '', 10); return Number.isFinite(n) && n > 0 ? n : null; })(),
    perks: parseLines(fd.get('perks') as string),
    internshipMode: (fd.get('internshipMode') as string) || 'Full-Time',
    workingDaysPerWeek: (() => { const n = parseInt((fd.get('workingDaysPerWeek') as string) || '', 10); return Number.isFinite(n) ? n : null; })(),
    hoursPerWeek: (() => { const n = parseFloat((fd.get('hoursPerWeek') as string) || ''); return Number.isFinite(n) ? n : null; })(),
    projectHoursPerDay: (() => { const n = parseFloat((fd.get('projectHoursPerDay') as string) || ''); return Number.isFinite(n) ? n : null; })(),
    wellbeingHoursPerDay: (() => { const n = parseFloat((fd.get('wellbeingHoursPerDay') as string) || ''); return Number.isFinite(n) ? n : null; })(),
    engagementNotes: parseLines(fd.get('engagementNotes') as string),
  };

  const candidate = {
    title: (fd.get('title') as string || '').trim(),
    slug: (fd.get('slug') as string || '').trim(),
    departmentId: fd.get('departmentId'),
    level: fd.get('level'),
    function: fd.get('function'),
    engagementType: fd.get('engagementType'),
    location: fd.get('location'),
    duration: fd.get('duration'),
    salary: fd.get('salary'),
    about: fd.get('about'),
    responsibilities: parseLines(fd.get('responsibilities') as string),
    skills: parseLines(fd.get('skills') as string),
    eligibility: parseLines(fd.get('eligibility') as string),
    isOpen: fd.get('isOpen') === 'on',
    isFeatured: fd.get('isFeatured') === 'on',
    sortOrder: parseInt((fd.get('sortOrder') as string) || '0', 10)
  };

  const parsed = roleSchema.safeParse(candidate);

  // Same work-mode policy as the create form: on site for permanent roles, hybrid only for
  // internships and apprenticeships, never remote. Checked on edit too, or the wording just comes
  // back one role at a time.
  const workModeProblem = violatesWorkModePolicy(
    candidate.engagementType as string, candidate.level as string, candidate.location as string,
  ) ? workModePolicyMessage(candidate.engagementType as string, candidate.level as string) : '';

  if (!parsed.success) {
    errorMsg = parsed.error.errors.map((e) => e.path.join('.') + ': ' + e.message).join('  ·  ');
  } else if (workModeProblem) {
    errorMsg = workModeProblem;
  } else {
    // ONE try/catch around every write, and the exception is reported, never swallowed. This save
    // had no catch: an update the database refused (the engagement enum holds three labels, this
    // page used to offer nine) escaped as a 500 and took the edited job description with it.
    try {
    const slugClash = await db.select({ id: roles.id }).from(roles)
      .where(and(eq(roles.slug, parsed.data.slug), ne(roles.id, id))).limit(1);

    if (slugClash.length > 0) {
      errorMsg = 'Slug "' + parsed.data.slug + '" is used by another role.';
    } else {
      await db.update(roles)
        .set({ ...parsed.data, updatedAt: new Date() })
        .where(eq(roles.id, id));
      const productTags = fd.getAll('products').map((v) => String(v).trim()).filter(Boolean);
      const openingsRaw = parseInt((fd.get('openings') as string) || '', 10);
      const openings = Number.isFinite(openingsRaw) && openingsRaw > 0 ? openingsRaw : null;
      await setRoleProducts(id, productTags);
      await setRoleOpenings(id, openings);
      await setRoleAicte(id, aicteData);

      // ---- RESEARCH FACETS ------------------------------------------------------------------
      // jobStatus is deliberately NOT taken from this form: it has its own intent above. Passing
      // null here means "leave whatever is there", so saving a wording change cannot unpublish a
      // live posting as a side effect.
      const numOrNullField = (name: string): number | null => {
        const raw = (fd.get(name) as string) || '';
        if (raw.trim() === '') return null;
        const n = parseInt(raw, 10);
        return Number.isFinite(n) ? n : null;
      };
      const rawMin = numOrNullField('scaleMinExp');
      const rawMax = numOrNullField('scaleMaxExp');
      // Clamped into the declared span, and ordered, so a transposed pair cannot publish a range
      // that reads backwards.
      const extMin = rawMin === null ? null : clampExp(rawMin);
      const extMax = rawMax === null ? null : clampExp(rawMax);
      const orderedMin = (extMin !== null && extMax !== null) ? Math.min(extMin, extMax) : extMin;
      const orderedMax = (extMin !== null && extMax !== null) ? Math.max(extMin, extMax) : extMax;
      const extData = {
        divisionId: ((fd.get('divisionId') as string) || '').trim() || null,
        researchClassification: ((fd.get('researchClassification') as string) || '').trim() || null,
        scaleMinExp: orderedMin,
        scaleMaxExp: orderedMax,
        skillCategories: fd.getAll('skillCategories').map((v) => String(v)).filter(Boolean),
        careerLevel: numOrNullField('careerLevel'),
        jobStatus: null,
        validThrough: ((fd.get('validThrough') as string) || '').trim() || null,
        preferredSkills: parseLines(fd.get('preferredSkills') as string),
        tools: parseLines(fd.get('tools') as string),
        deliverables: parseLines(fd.get('deliverables') as string),
        evaluationCriteria: parseLines(fd.get('evaluationCriteria') as string),
        reportingTo: ((fd.get('reportingTo') as string) || '').trim() || null,
        collaboratesWith: parseLines(fd.get('collaboratesWith') as string),
        applicationInstructions: ((fd.get('applicationInstructions') as string) || '').trim() || null,
        integrityNote: ((fd.get('integrityNote') as string) || '').trim() || null,
      };
      await setRoleExtension(id, { ...extData, jobStatus: currentExt.jobStatus });
      currentExt = await getRoleExtension(id);

      currentProducts = productTags;
      currentOpenings = openings || 0;
      currentAicte = aicteData;
      await logAudit({
        userId: user.id,
        action: 'role.update',
        entity: 'role',
        entityId: id,
        diff: { updated: parsed.data },
        ipAddress: Astro.clientAddress
      });
      okMsg = 'Saved.';
      const refreshed = await db.select().from(roles).where(eq(roles.id, id)).limit(1);
      current = refreshed[0];
    }
    } catch (e: any) {
      console.error('[admin/roles/[id]] update failed:', e?.cause?.message || e?.message);
      // Re-render the form with what was SUBMITTED, not with what is still in the database, so the
      // edit is not silently thrown away by the failure.
      current = { ...current, ...(candidate as any) };
      errorMsg = 'The role was NOT saved: ' + (e?.cause?.message || e?.message || 'unknown database error')
        + ' — the stored role is unchanged. Your edits are still on this form.';
    }
  }
  } // end save-path guard
}

const LEVELS = ['C-Level', 'Lead', 'Senior', 'Mid', 'Junior', 'Intern', 'Apprentice'];
// Exactly the three labels the `engagement_type` Postgres enum accepts. See the note on
// engagementSchema in src/lib/validators.ts before adding a fourth.
const ENGAGEMENTS = ['Full-Time', 'Internship', 'Apprenticeship'];

// ---- RESEARCH FACETS: view model. Every comparison is computed HERE, never in the markup — a `<`
// inside a JSX expression breaks .astro parsing, and so does a typed Record<string,string> map.
const effective = statusOf({
  jobStatus: currentExt.jobStatus, isOpen: current.isOpen, applicationDeadline: current.applicationDeadline,
});
const declaredStatus = currentExt.jobStatus || (current.isOpen ? 'PUBLISHED' : 'CLOSED');
const nextStatuses = allowedTransitions(declaredStatus);
const deadlineOverrides = effective.key !== declaredStatus;
const hasExtScale = typeof currentExt.scaleMinExp === 'number' && typeof currentExt.scaleMaxExp === 'number';
const extScaleText = hasExtScale
  ? scaleRangeText(currentExt.scaleMinExp as number, currentExt.scaleMaxExp as number) : '';
const extEvidence = classificationEvidence(
  currentExt.researchClassification, currentExt.scaleMinExp, currentExt.scaleMaxExp,
);
const selectedSkillCats = new Set(currentExt.skillCategories);
const SKILL_CATEGORY_OPTIONS = [
  'PHYSICS', 'MATHEMATICS', 'CHEMISTRY', 'BIOLOGY', 'MATERIALS', 'NANOENGINEERING', 'QUANTUM',
  'SEMICONDUCTORS', 'ELECTRONICS', 'COMPUTER_SCIENCE', 'ARTIFICIAL_INTELLIGENCE',
  'SCIENTIFIC_COMPUTING', 'MECHANICAL_ENGINEERING', 'CIVIL_ENGINEERING', 'AEROSPACE',
  'ENERGY', 'ENVIRONMENT', 'ASTROPHYSICS', 'COSMOLOGY',
];
const extPreferredText = currentExt.preferredSkills.join('\n');
const extToolsText = currentExt.tools.join('\n');
const extDeliverablesText = currentExt.deliverables.join('\n');
const extEvaluationText = currentExt.evaluationCriteria.join('\n');
const extCollaboratorsText = currentExt.collaboratesWith.join('\n');
const extValidThrough = currentExt.validThrough ? currentExt.validThrough.slice(0, 10) : '';
const hasDivisionOptions = divisionOptions.length > 0;

const respText = (current.responsibilities || []).join('\n');
const skillsText = (current.skills || []).join('\n');
const eligText = (current.eligibility || []).join('\n');
---
<AdminLayout title={'Edit · ' + current.title} activeNav="roles">
  <div class="admin-page" style="max-width:880px;">
    <div class="admin-page-header">
      <div class="admin-page-title-block">
        <div class="admin-page-eyebrow"><a href="/admin/roles" style="color:#8a8a94;text-decoration:none;">← Roles</a></div>
        <h1 class="admin-page-title">{current.title}</h1>
        <p class="admin-page-sub" style="font-family:'Geist Mono',monospace;">{current.slug}</p>
      </div>
      {canEdit && (
        <a class="admin-btn" href={'/admin/applications/invitations?role=' + current.slug}
           style="color:#FF7040;border-color:#3a2419;text-decoration:none;">Invite someone to apply</a>
      )}
      {!canEdit && (
        <span class="admin-btn" style="color:#8a8a94;">Read-only access</span>
      )}
    </div>

    {errorMsg && (
      <div style="background:rgba(220,38,38,0.08);border:1px solid rgba(220,38,38,0.25);color:#fca5a5;font-size:12.5px;padding:11px 14px;border-radius:7px;margin-bottom:18px;line-height:1.7;">
        {errorMsg}
      </div>
    )}

    {okMsg && (
      <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);color:#6ee7b7;font-size:12.5px;padding:11px 14px;border-radius:7px;margin-bottom:18px;">
        {okMsg}
      </div>
    )}

    <!-- ================= PUBLICATION STATUS =================
         A SEPARATE FORM, deliberately. Publishing and closing a posting are not the same act as
         editing its wording, and one Save button that does both is how somebody closes a role while
         fixing a typo. Only the transitions permitted from the current status are offered, and the
         handler re-checks them server-side — the list here is a convenience, not the gate. -->
    <div class="admin-card" style="margin-bottom:18px;">
      <div class="admin-card-title">Publication status</div>
      <p style="font-size:12.5px;color:#8a8a94;line-height:1.7;margin:8px 0 12px;">
        Declared status: <strong style="color:#fff;font-family:'Geist Mono',monospace;">{declaredStatus}</strong>.
        Effective status: <strong style="color:#fff;font-family:'Geist Mono',monospace;">{effective.key}</strong>.
        {effective.acceptsApplications ? ' This posting is accepting applications.' : ' This posting is NOT accepting applications, and the submission path refuses it server-side — not by hiding the button.'}
      </p>
      {deadlineOverrides && (
        <p style="font-size:12.5px;color:#fbbf24;line-height:1.7;margin:0 0 12px;">
          The deadline has passed, so the effective status differs from the declared one. The site already
          treats this posting as closed; the column simply disagrees with the behaviour. Setting it to CLOSED
          here removes that disagreement.
        </p>
      )}
      {canEdit && (
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          {nextStatuses.map((st) => (
            <form method="POST">
              <input type="hidden" name="job_status" value={st} />
              <button type="submit" name="_intent" value="set_status" class="admin-btn" style="padding:6px 13px;font-size:11.5px;">
                {st === 'PUBLISHED' ? 'Publish' : 'Set ' + st}
              </button>
            </form>
          ))}
        </div>
      )}
      {!canEdit && <p style="font-size:12px;color:#8a8a94;margin:0;">You hold read access only.</p>}
    </div>

    <form method="POST" class="admin-card" style="display:flex;flex-direction:column;gap:18px;">

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
        <div>
          <label class="rolefield-label">Title *</label>
          <input name="title" required value={current.title} class="rolefield-input" disabled={!canEdit} />
        </div>
        <div>
          <label class="rolefield-label">Slug *</label>
          <input name="slug" required value={current.slug} class="rolefield-input" pattern="[a-z0-9-]+" disabled={!canEdit} />
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
        <div>
          <label class="rolefield-label">Department *</label>
          <select name="departmentId" required class="rolefield-input" disabled={!canEdit}>
            {allDepts.map((d) => {
              const sel = current.departmentId === d.id;
              return <option value={d.id} selected={sel}>{d.name}</option>;
            })}
          </select>
        </div>
        <div>
          <label class="rolefield-label">Level *</label>
          <select name="level" required class="rolefield-input" disabled={!canEdit}>
            {LEVELS.map((lv) => {
              const sel = current.level === lv;
              return <option value={lv} selected={sel}>{lv}</option>;
            })}
          </select>
        </div>
        <div>
          <label class="rolefield-label">Engagement *</label>
          <select name="engagementType" required class="rolefield-input" disabled={!canEdit}>
            {ENGAGEMENTS.map((e) => {
              const sel = current.engagementType === e;
              return <option value={e} selected={sel}>{e}</option>;
            })}
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start;">
        <div>
          <label class="rolefield-label">Product / venture pages</label>
          <select name="products" multiple size="4" class="rolefield-input" style="height:auto;min-height:108px;" disabled={!canEdit}>
            {productOptions.map((p) => {
              const sel = currentProducts.includes(p.slug);
              return <option value={p.slug} selected={sel}>{p.name}</option>;
            })}
          </select>
          <p style="font-size:0.75rem;color:#8a8a93;margin-top:4px;">Select one or more products — this role shows under "Work on this" on each one's ecosystem page (Ctrl/Cmd-click for multiple). None = general role, /careers only.</p>
        </div>
        <div>
          <label class="rolefield-label">Openings (optional)</label>
          <input type="number" name="openings" min="1" step="1" value={currentOpenings || ''} placeholder="e.g. 3" class="rolefield-input" disabled={!canEdit} />
          <p style="font-size:0.75rem;color:#8a8a93;margin-top:4px;">Number of seats. Leave blank if single / unspecified.</p>
        </div>
      </div>

      <div>
        <label class="rolefield-label">Function *</label>
        <input name="function" required value={current.function} class="rolefield-input" disabled={!canEdit} />
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
        <div>
          <label class="rolefield-label">Location *</label>
          <input name="location" required value={current.location} class="rolefield-input" disabled={!canEdit} />
          <p class="text-[0.68rem] text-white/40 mt-1">On site for permanent roles. Hybrid only for internships and apprenticeships. Never remote.</p>
        </div>
        <div>
          <label class="rolefield-label">Duration *</label>
          <input name="duration" required value={current.duration} class="rolefield-input" disabled={!canEdit} />
        </div>
        <div>
          <label class="rolefield-label">Salary / Comp *</label>
          <input name="salary" required value={current.salary} class="rolefield-input" disabled={!canEdit} />
        </div>
      </div>

      <div>
        <label class="rolefield-label">About *</label>
        <textarea name="about" required rows="4" class="rolefield-input" disabled={!canEdit}>{current.about}</textarea>
      </div>

      <div>
        <label class="rolefield-label">Responsibilities (one per line)</label>
        <textarea name="responsibilities" rows="6" class="rolefield-input" disabled={!canEdit}>{respText}</textarea>
      </div>

      <div>
        <label class="rolefield-label">Skills (one per line)</label>
        <textarea name="skills" rows="5" class="rolefield-input" disabled={!canEdit}>{skillsText}</textarea>
      </div>

      <div>
        <label class="rolefield-label">Eligibility (one per line)</label>
        <textarea name="eligibility" rows="4" class="rolefield-input" disabled={!canEdit}>{eligText}</textarea>
      </div>

      <div style="border-top:1px solid #15151a;padding-top:18px;margin-top:4px;">
        <p style="font-size:11px;font-weight:700;color:#FF7040;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 4px;">AICTE Internship Portal Fields</p>
        <p style="font-size:11.5px;color:#8a8a94;margin:0 0 14px;">Optional — fill these in for roles listed on AICTE or similar structured internship portals.</p>
      </div>

      <div>
        <label class="rolefield-label">Learning Outcomes (one per line)</label>
        <textarea name="learningOutcomes" rows="5" class="rolefield-input" disabled={!canEdit}>{currentAicte.learningOutcomes.join('\n')}</textarea>
      </div>

      <div style="display:grid;grid-template-columns:1fr 2fr;gap:16px;">
        <div>
          <label class="rolefield-label">Qualification Type</label>
          <input name="qualificationType" value={currentAicte.qualificationType || 'UG / PG'} class="rolefield-input" disabled={!canEdit} />
        </div>
        <div>
          <label class="rolefield-label">Qualification (one per line)</label>
          <textarea name="qualifications" rows="2" class="rolefield-input" disabled={!canEdit}>{currentAicte.qualifications.join('\n')}</textarea>
        </div>
      </div>

      <div>
        <label class="rolefield-label">Select Specialisation (one per line)</label>
        <textarea name="specialisations" rows="4" class="rolefield-input" disabled={!canEdit}>{currentAicte.specialisations.join('\n')}</textarea>
      </div>

      <div>
        <label class="rolefield-label">Keywords (one per line)</label>
        <textarea name="keywords" rows="3" class="rolefield-input" disabled={!canEdit}>{currentAicte.keywords.join('\n')}</textarea>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
          <label class="rolefield-label">No. of Interns Required</label>
          <input type="number" name="noOfInterns" min="1" step="1" value={currentAicte.noOfInterns ?? ''} placeholder="e.g. 35" class="rolefield-input" disabled={!canEdit} />
        </div>
        <div>
          <label class="rolefield-label">Internship Type</label>
          <select name="internshipMode" class="rolefield-input" disabled={!canEdit}>
            <option value="Full-Time" selected={(currentAicte.internshipMode || 'Full-Time') === 'Full-Time'}>Full-Time</option>
            <option value="Part-Time" selected={currentAicte.internshipMode === 'Part-Time'}>Part-Time</option>
          </select>
        </div>
      </div>

      <div>
        <label class="rolefield-label">Perks (one per line)</label>
        <textarea name="perks" rows="4" class="rolefield-input" disabled={!canEdit}>{currentAicte.perks.join('\n')}</textarea>
      </div>

      <div>
        <p style="font-size:10.5px;font-weight:600;color:#8a8a94;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:6px;">Terms of Engagement</p>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;">
          <div>
            <label class="rolefield-label">Days / Week</label>
            <input type="number" name="workingDaysPerWeek" min="1" max="7" value={currentAicte.workingDaysPerWeek ?? 6} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Hours / Week</label>
            <input type="number" step="0.5" name="hoursPerWeek" value={currentAicte.hoursPerWeek ?? 40} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Project Hrs/Day</label>
            <input type="number" step="0.1" name="projectHoursPerDay" value={currentAicte.projectHoursPerDay ?? 5} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Well-being Hrs/Day</label>
            <input type="number" step="0.1" name="wellbeingHoursPerDay" value={currentAicte.wellbeingHoursPerDay ?? 1.67} class="rolefield-input" disabled={!canEdit} />
          </div>
        </div>
        <p style="font-size:0.72rem;color:#8a8a93;margin-top:6px;">Well-being: physical fitness, mindfulness, reading, reflective learning, leadership development, community engagement, and other approved personal-development activities.</p>
      </div>

      <div>
        <label class="rolefield-label">Terms of Engagement — notes (one per line)</label>
        <textarea name="engagementNotes" rows="4" class="rolefield-input" disabled={!canEdit}>{currentAicte.engagementNotes.join('\n')}</textarea>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;align-items:end;">
        <div>
          <label class="rolefield-label">Sort order</label>
          <input type="number" name="sortOrder" value={current.sortOrder} class="rolefield-input" disabled={!canEdit} />
        </div>
        <label style="display:flex;align-items:center;gap:8px;color:#d8d8de;font-size:12.5px;padding:8px 0;cursor:pointer;">
          <input type="checkbox" name="isOpen" checked={current.isOpen} disabled={!canEdit} style="accent-color:#FF4F00;width:14px;height:14px;" />
          <span>Open for applications</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;color:#d8d8de;font-size:12.5px;padding:8px 0;cursor:pointer;">
          <input type="checkbox" name="isFeatured" checked={current.isFeatured} disabled={!canEdit} style="accent-color:#FF4F00;width:14px;height:14px;" />
          <span>Featured</span>
        </label>
      </div>

      <!-- ================= RESEARCH CLASSIFICATION =================
           Optional on every posting. Leaving the classification and the scale range empty is what a
           non-research role looks like, and it is the correct state for the ~988 postings that are
           not research roles — nothing here is required and nothing is defaulted into place. -->
      <div style="border-top:1px solid #15151a;padding-top:18px;">
        <div class="admin-card-title" style="margin-bottom:4px;">Research classification</div>
        <p style="font-size:12px;color:#8a8a94;line-height:1.7;margin:0 0 14px;">
          Fill these in for a research posting. A scale range published WITHOUT a classification reads to a
          candidate as a claim about what we can build, so the public page shows the classification and the
          evidential standing beside the range, every time.
        </p>

        {hasExtScale && (
          <p style="font-size:12px;color:#cfd6da;margin:0 0 14px;font-family:'Geist Mono',monospace;">
            Current: {extScaleText}{extEvidence ? ' — ' + extEvidence.label : ''}
          </p>
        )}
        {extEvidence && (
          <p style="font-size:12px;color:#c0a35e;line-height:1.7;margin:-8px 0 14px;">{extEvidence.statement}</p>
        )}

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
          <div>
            <label class="rolefield-label">Division</label>
            <select name="divisionId" class="rolefield-input" disabled={!canEdit}>
              <option value="">Not in a division</option>
              {divisionOptions.map((d) => (
                <option value={d.id} selected={currentExt.divisionId === d.id}>{d.name}</option>
              ))}
            </select>
            {!hasDivisionOptions && (
              <p style="font-size:11px;color:#8a8a94;margin:6px 0 0;line-height:1.6;">
                No divisions in the register. Either none have been imported, or the migration has not been
                applied — <a href="/admin/roles/divisions" style="color:#9bd1ff;">Divisions</a> says which.
              </p>
            )}
          </div>
          <div>
            <label class="rolefield-label">Research classification</label>
            <select name="researchClassification" class="rolefield-input" disabled={!canEdit}>
              <option value="">Not classified</option>
              {RESEARCH_CLASSIFICATIONS.map((c) => (
                <option value={c.key} selected={currentExt.researchClassification === c.key}>{c.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;margin-bottom:16px;">
          <div>
            <label class="rolefield-label">Scale min (log10 m)</label>
            <input type="number" name="scaleMinExp" min="-100" max="100" step="1" value={currentExt.scaleMinExp ?? ''} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Scale max (log10 m)</label>
            <input type="number" name="scaleMaxExp" min="-100" max="100" step="1" value={currentExt.scaleMaxExp ?? ''} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Career rung (0-10)</label>
            <select name="careerLevel" class="rolefield-input" disabled={!canEdit}>
              <option value="">Not set</option>
              {CAREER_LADDER.map((r) => (
                <option value={String(r.level)} selected={currentExt.careerLevel === r.level}>L{r.level} · {r.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="rolefield-label">Valid through</label>
            <input type="date" name="validThrough" value={extValidThrough} class="rolefield-input" disabled={!canEdit} />
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label class="rolefield-label">Disciplines</label>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            {SKILL_CATEGORY_OPTIONS.map((k) => (
              <label style="display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#cfd6da;background:#08080a;border:1px solid #1f1f26;border-radius:6px;padding:5px 9px;cursor:pointer;">
                <input type="checkbox" name="skillCategories" value={k} checked={selectedSkillCats.has(k)} disabled={!canEdit} style="accent-color:#FF4F00;width:13px;height:13px;" />
                <span>{k}</span>
              </label>
            ))}
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
          <div>
            <label class="rolefield-label">Preferred skills (one per line)</label>
            <textarea name="preferredSkills" rows="4" class="rolefield-input" disabled={!canEdit}>{extPreferredText}</textarea>
          </div>
          <div>
            <label class="rolefield-label">Tools (one per line)</label>
            <textarea name="tools" rows="4" class="rolefield-input" disabled={!canEdit}>{extToolsText}</textarea>
          </div>
          <div>
            <label class="rolefield-label">Deliverables (one per line)</label>
            <textarea name="deliverables" rows="4" class="rolefield-input" disabled={!canEdit}>{extDeliverablesText}</textarea>
          </div>
          <div>
            <label class="rolefield-label">Evaluation criteria (one per line)</label>
            <textarea name="evaluationCriteria" rows="4" class="rolefield-input" disabled={!canEdit}>{extEvaluationText}</textarea>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
          <div>
            <label class="rolefield-label">Reports to</label>
            <input type="text" name="reportingTo" value={currentExt.reportingTo || ''} class="rolefield-input" disabled={!canEdit} />
          </div>
          <div>
            <label class="rolefield-label">Collaborates with (one per line)</label>
            <textarea name="collaboratesWith" rows="2" class="rolefield-input" disabled={!canEdit}>{extCollaboratorsText}</textarea>
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label class="rolefield-label">Application instructions</label>
          <textarea name="applicationInstructions" rows="3" class="rolefield-input" disabled={!canEdit}>{currentExt.applicationInstructions || ''}</textarea>
        </div>

        <div>
          <label class="rolefield-label">Integrity note — what this work is, and what it is not</label>
          <textarea name="integrityNote" rows="4" class="rolefield-input" disabled={!canEdit}>{currentExt.integrityNote || ''}</textarea>
          <p style="font-size:11px;color:#8a8a94;margin:6px 0 0;line-height:1.6;">
            Shown on the public posting, above the apply button. This is where a speculative programme says so
            in the words a specialist would use. Do not leave it empty on a posting whose scale range sits where
            no experiment reaches.
          </p>
        </div>
      </div>

      {canEdit && (
        <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:16px;border-top:1px solid #15151a;">
          <a href="/admin/roles" class="admin-btn">Cancel</a>
          <button type="submit" name="_intent" value="save" class="admin-btn admin-btn-primary">Save changes</button>
        </div>
      )}
    </form>

    {canEdit && (
      <div class="admin-card" style="margin-top:24px;border-color:rgba(220,38,38,0.25);">
        <div class="admin-card-title" style="color:#fca5a5;">Danger Zone</div>
        <p style="font-size:12.5px;color:#8a8a94;line-height:1.7;margin:8px 0 12px;">
          Deleting this role removes it permanently. Public /careers will no longer show it. Existing applications referencing this role will be detached but kept.
        </p>
        <form method="POST" data-danger="Delete this role? This cannot be undone.">
          <button type="submit" name="_intent" value="delete" class="admin-btn" style="background:rgba(220,38,38,0.12);border-color:rgba(220,38,38,0.3);color:#fca5a5;">
            Delete this role
          </button>
        </form>
      </div>
    )}
  </div>

  <style>
    .rolefield-label {
      display: block;
      font-size: 10.5px;
      font-weight: 600;
      color: #8a8a94;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .rolefield-input {
      width: 100%;
      padding: 9px 12px;
      background: #08080a;
      border: 1px solid #1f1f26;
      border-radius: 6px;
      color: #fff;
      font-size: 13px;
      font-family: inherit;
      outline: none;
      line-height: 1.5;
    }
    .rolefield-input:focus { border-color: #FF4F00; }
    .rolefield-input:disabled { opacity: 0.6; cursor: not-allowed; }
    textarea.rolefield-input { resize: vertical; min-height: 80px; }
  </style>
<script src="/admin-danger.js" defer></script>
<script is:inline>
  /* FAIL CLOSED. If /admin-danger.js did not load — cached 404, blocked request, parse error —
     every data-danger control above would submit on the FIRST click with no confirmation at all.
     These are delete and revoke buttons, so the safe direction when the guard is missing is a
     dialog, not nothing. This runs only in that case and adds no behaviour when the guard is
     present. */
  window.addEventListener('load', function () {
    if (window.installDanger) return;
    console.warn('[admin-danger] guard script did not load; falling back to confirm()');
    Array.prototype.forEach.call(document.querySelectorAll('[data-danger]'), function (el) {
      var q = el.getAttribute('data-danger');
      var form = el.tagName === 'FORM' ? el : el.form;
      if (form) form.addEventListener('submit', function (e) { if (!confirm(q)) e.preventDefault(); });
      else el.addEventListener('click', function (e) { if (!confirm(q)) e.preventDefault(); });
    });
  });
</script>
</AdminLayout>
