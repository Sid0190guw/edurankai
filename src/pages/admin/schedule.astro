---
// /admin/schedule — faculty/registrar schedule management (Prompt 19, admin surface). Gated by
// can(write, schedule). Set deadlines that populate enrolled students' calendars; run reminders.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/rbac';
import { flashFailed } from '@/lib/flash-tone';
import { contentService } from '@/lib/kernel-content';
import { courseDeadlines, setDeadline, runDeadlineReminders } from '@/lib/calendar';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const gate = await can(user, 'write', { type: 'schedule' });
if (!gate.allow) return Astro.redirect('/admin');

// -------------------------------------------------------------------------------------------
// BOTH WRITES ON THIS PAGE POST NATIVELY NOW.
//
// "Add" and "Run reminders" were type="button" with an inline click handler calling fetch(). The
// four inputs beside them were not in a form at all, so pressing Enter in the Title field did
// nothing either. With scripting off, slow, or thrown — which is the ordinary condition on a
// mid-range phone in the first seconds after paint — both buttons were coloured rectangles that
// did nothing and said nothing, and the deadline the registrar believed they had set did not
// exist. A deadline that silently was not created does not appear on any student's calendar or
// ICS feed, and nobody finds out until the date passes.
//
// The fetch had no .catch() either, so a dropped connection produced no message at all.
//
// PAGE_PATH and KINDS are declared HERE, above the handler, because `const` is not hoisted and a
// const read from above its declaration throws on the handler's first line while the page carries
// on rendering as though the write had been considered.
//
// Same gate as /api/admin/schedule — can(write, schedule) — already resolved above, and the
// values are validated here rather than trusted from the form.
// -------------------------------------------------------------------------------------------
const PAGE_PATH = '/admin/schedule';
const KINDS = ['assessment', 'exam', 'lesson'];

if (Astro.request.method === 'POST') {
  let flash = '';
  let backTo = '';
  try {
    const fd = await Astro.request.formData();
    const action = String(fd.get('action') || '');
    if (action === 'set_deadline') {
      const courseObjId = String(fd.get('course_id') || '').trim();
      const title = String(fd.get('title') || '').trim();
      const kindRaw = String(fd.get('kind') || '');
      const kind = KINDS.includes(kindRaw) ? kindRaw : 'assessment';
      const dueAt = String(fd.get('due_at') || '').trim();
      const when = dueAt ? new Date(dueAt) : null;
      if (!courseObjId || !title || !when || isNaN(when.getTime())) {
        flash = 'Nothing was saved: a course, a title and a due date and time are all needed.';
      } else {
        await setDeadline(courseObjId, title, kind, when.toISOString(), user.id);
        backTo = courseObjId;
        flash = 'Deadline added. It is on the calendar and ICS feed of everybody enrolled on that course.';
      }
    } else if (action === 'run_reminders') {
      const n = await runDeadlineReminders(48);
      flash = n === 0
        ? 'No reminders were due. Nothing is falling inside the next 48 hours.'
        : 'Sent ' + n + ' reminder' + (n === 1 ? '' : 's') + ' for deadlines inside the next 48 hours.';
    } else {
      flash = 'That is not something this page does.';
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the failed SQL.
    console.error('[admin/schedule POST]', e?.cause?.message || e?.message, e?.stack);
    flash = 'Nothing was saved: ' + (e?.cause?.message || e?.message || 'the write could not be completed.');
  }
  return Astro.redirect(
    PAGE_PATH + '?msg=' + encodeURIComponent(flash) + (backTo ? '&c=' + encodeURIComponent(backTo) : ''),
  );
}

const courses = (await contentService().listCourses().catch(() => [])).map((c: any) => ({ id: c.id, title: (c.data as any).title }));
const sel = (Astro.url.searchParams.get('c') || '').trim();
const msg = (Astro.url.searchParams.get('msg') || '').trim();
const deadlines = sel ? await courseDeadlines(sel).catch(() => []) : [];
const CARD = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px 18px;margin-bottom:16px;';
const IN = 'background:#15151a;border:1px solid #26262c;color:#fff;padding:7px 9px;border-radius:6px;font-size:12px;';
const HD = "font-size:11px;color:#8a8a94;text-transform:uppercase;font-family:'Geist Mono',monospace;letter-spacing:0.1em;font-weight:700;margin:0 0 10px;";
function fmt(d: any) { try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch { return '-'; } }
---
<AdminLayout title="Schedule" activeNav="schedule">
  <div style="max-width:980px;margin:0 auto;padding:24px;">
    <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 4px;">Schedule &amp; deadlines</h1>
    <p style="font-size:12.5px;color:#8a8a94;margin:0 0 16px;">Deadlines populate enrolled students' calendars + ICS feeds. Reminders notify students 48h ahead.</p>
    {/* Rendered by the SERVER into the response that follows the write, so the result is on screen
        whether or not a script ran. flashFailed() reads the sentence: a failure gets role="alert"
        and the red treatment, everything else stays neutral. */}
    {msg && (
      <div role={flashFailed(msg) ? 'alert' : 'status'}
           style={'margin:0 0 12px;padding:9px 13px;border-radius:8px;font-size:13px;line-height:1.5;' + (flashFailed(msg)
             ? 'background:rgba(239,68,68,0.12);color:#fca5a5;'
             : 'background:rgba(16,185,129,0.12);color:#6ee7b7;')}>{msg}</div>
    )}

    <div style={CARD}>
      <p style={HD}>Set a deadline</p>
      {/* Every label was a bare <label> with no `for`, beside an input with an id nothing pointed
          at — four boxes announced with no names. They are joined now, and the controls clear 44px
          so they can be used with a thumb. `required` on the three that the handler refuses without
          means the browser says which field is empty instead of the page reloading with a sentence
          about it. */}
      <form method="POST" style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;">
        <input type="hidden" name="action" value="set_deadline" />
        <div><label for="dCourse" style="font-size:10px;color:#8a8a94;">Course</label><br/><select id="dCourse" name="course_id" required style={IN + 'min-height:44px;'}>{courses.map((c: any) => <option value={c.id} selected={c.id === sel}>{c.title}</option>)}</select></div>
        <div style="flex:1;min-width:180px;"><label for="dTitle" style="font-size:10px;color:#8a8a94;">Title</label><br/><input id="dTitle" name="title" required maxlength="200" style={IN + 'width:100%;box-sizing:border-box;min-height:44px;'} placeholder="For example, midterm assessment" /></div>
        <div><label for="dKind" style="font-size:10px;color:#8a8a94;">Kind</label><br/><select id="dKind" name="kind" style={IN + 'min-height:44px;'}><option value="assessment">assessment</option><option value="exam">exam</option><option value="lesson">lesson</option></select></div>
        <div><label for="dDue" style="font-size:10px;color:#8a8a94;">Due</label><br/><input id="dDue" name="due_at" type="datetime-local" required style={IN + 'min-height:44px;'} /></div>
        <button type="submit" style="min-height:44px;background:#FF4F00;border:none;color:#fff;font-size:11px;font-weight:700;padding:8px 18px;border-radius:6px;cursor:pointer;">Add</button>
      </form>
    </div>

    <div style={CARD}>
      <p style={HD}>Reminders</p>
      {/* Its own form, not a second button inside the deadline form. Sharing one form would have
          made "Run reminders" trip the `required` fields above it, so the control that sends mail
          to students would have been blocked by an empty Title box with no explanation. */}
      <form method="POST">
        <input type="hidden" name="action" value="run_reminders" />
        <button type="submit" style="min-height:44px;background:#15151a;border:1px solid #26262c;color:#cfd6da;font-size:11px;padding:8px 16px;border-radius:6px;cursor:pointer;">Run reminders</button>
      </form>
      <p style="font-size:11.5px;color:#8a8a94;margin:10px 0 0;line-height:1.55;">Notifies every enrolled student about a deadline falling inside the next 48 hours. Running it again does not re-send what has already gone.</p>
    </div>

    <div style={CARD}>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
        <p style={HD + 'margin:0;'}>Deadlines</p>
        {/* The onchange was the only way to apply this: no button, so with scripting off the picker
            was decorative and the panel below could never be filled. */}
        <form method="GET" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
          <label for="schedCourse" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">Course</label>
          <select id="schedCourse" name="c" onchange="this.form.submit()" style={IN + 'min-height:44px;'}><option value="">— pick a course —</option>{courses.map((c: any) => <option value={c.id} selected={c.id === sel}>{c.title}</option>)}</select>
          <button type="submit" style="background:#15151a;border:1px solid #2a2a33;color:#d8d8de;font-size:12px;font-weight:600;padding:0 14px;border-radius:6px;cursor:pointer;min-height:44px;">Show</button>
        </form>
      </div>
      {!sel ? <p style="font-size:12px;color:#8a8a94;margin:0;">Pick a course to see its deadlines.</p> :
        deadlines.length === 0 ? <p style="font-size:12px;color:#8a8a94;margin:0;">No deadlines for this course.</p> :
        deadlines.map((d: any) => <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #15151a;font-size:12.5px;color:#cfd6da;"><span>[{d.kind}] {d.title}</span><span style="color:#8a8a94;font-family:'Geist Mono',monospace;">{fmt(d.due_at)}</span></div>)}
    </div>
  </div>

  {/* THE INLINE SCRIPT IS GONE, NOT REPLACED. It was the only writer on this page and it was the
      defect; leaving a decorating copy behind would put two writers on one control, which is how
      the two drift. The page now ships no JavaScript of its own beyond the one-line onchange on the
      course picker, which is an enhancement over a Show button that works without it.
      /api/admin/schedule is untouched and still serves anything else that calls it. */}
</AdminLayout>
