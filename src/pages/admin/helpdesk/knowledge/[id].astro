---
// /admin/helpdesk/knowledge/<id> — ONE ARTICLE: read it, edit it, publish a version, see who has
// acknowledged it.
//
// THE GATE is the one on the index beside it — the 'helpdesk' section OR `knowledge.manage` — and it
// is repeated here because a deeper URL is typed, not clicked. Every WRITE below is re-checked inside
// src/lib/knowledge-base.ts against the posted id rather than the rendered one.
//
// AN ARTICLE THIS PERSON MAY NOT READ COMES BACK NULL, and this page says "not available" — the same
// sentence it would say for an id that does not exist. That is deliberate: a "you are not allowed to
// see this" tells you the article exists, which is half of what its audience was hiding. A knowledge
// manager who does not hold the capability an article names is in exactly that position, on purpose.
//
// WHAT THE ACKNOWLEDGEMENT PANEL SHOWS, AND WHAT IT WILL NOT. The people who HAVE acknowledged are
// named, because an acknowledgement is an act that person deliberately performed on a document and
// being able to show they did is the whole point of recording it. The people who have NOT are a
// COUNT — never a list. A screen that prints "these eleven have not read the code of conduct" is a
// shame list, and this product does not build one; the count is what tells the owner a reminder is
// due, which is the action the number is for.
//
// const BEFORE THE POST HANDLER. `const` is not hoisted.
// CLIENT JAVASCRIPT: NONE. MOBILE FIRST: 360px, 44px targets, one column.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { holdsCapability } from '@/lib/auth/capability';
import { resolvePermissions } from '@/lib/auth/registry';
import {
  makeViewer, getArticle, saveArticle, publishArticle, archiveArticle, articleVersions, ackLedger,
  renderArticleHtml, KB_CATEGORIES, KB_KINDS, kbCategoryLabel, kindLabel, statusLabel, audienceLabel,
} from '@/lib/knowledge-base';

const LIST = '/admin/helpdesk/knowledge';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const bySection = await canAccessSection(user as any, 'helpdesk', 'view');
const byCapability = holdsCapability(user as any, 'knowledge.manage');
if (!bySection && !byCapability) return Astro.redirect('/admin');

// ---------------------------------------------------------------------------------------------
// CONSTANTS FIRST.
// ---------------------------------------------------------------------------------------------

const articleId = String(Astro.params.id || '');
const PAGE = LIST + '/' + articleId;

const resolved = await resolvePermissions(String(user.id), { locals: Astro.locals });
const viewer = makeViewer(user as any, { permissions: resolved.permissions, hasWorkspace: true });

const fmt = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};
const fmtTime = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';
  let ok = true;

  if (action === 'save') {
    const r = await saveArticle(user as any, viewer, {
      id: articleId,
      kind: String(fd.get('kind') || 'article'),
      title: String(fd.get('title') || ''),
      summary: String(fd.get('summary') || ''),
      category: String(fd.get('category') || 'general'),
      tags: String(fd.get('tags') || ''),
      body: String(fd.get('body') || ''),
      audience: String(fd.get('audience') || 'workspace'),
      requiredCapability: String(fd.get('required_capability') || '') || null,
      ackRequired: String(fd.get('ack_required') || '') === 'on',
      effectiveFrom: String(fd.get('effective_from') || '') || null,
      changeNote: String(fd.get('change_note') || ''),
      authorName: String((user as any).name || ''),
    });
    ok = r.ok;
    flash = r.ok ? 'Saved. Publish it when it is ready to be read.' : (r.error || 'Could not save that.');
  } else if (action === 'publish') {
    const r = await publishArticle(user as any, viewer, articleId, String(fd.get('change_note') || ''));
    ok = r.ok;
    flash = r.ok
      ? 'Published. If the text changed since the last version, everybody is asked to acknowledge it again.'
      : (r.error || 'Could not publish that.');
  } else if (action === 'archive') {
    const r = await archiveArticle(user as any, viewer, articleId);
    ok = r.ok;
    flash = r.ok
      ? 'Archived. Nothing was deleted: the versions and every acknowledgement stay on the record.'
      : (r.error || 'Could not archive that.');
  } else {
    ok = false;
    flash = 'That is not something this page does.';
  }

  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash) + '&ok=' + (ok ? '1' : '0'));
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg') || '';
const msgOk = url.searchParams.get('ok') !== '0';

const article = await getArticle(viewer, articleId, { includeUnpublished: true });
const versions = article ? await articleVersions(viewer, article.id) : [];
const ledger = article ? await ackLedger(viewer, article) : null;
const bodyHtml = article ? renderArticleHtml(article.body) : '';
---

<AdminLayout title={article ? article.title : 'Article'} activeNav="helpdesk-knowledge">
  <div class="ka">
    <p class="ka__back"><a href={LIST}>Back to the knowledge base</a></p>

    {msg && <p class={msgOk ? 'ka__ok' : 'ka__warn'}>{msg}</p>}

    {!article && (
      <section class="ka__panel">
        <h1>Not available</h1>
        <p class="ka__blurb">
          There is no article here that you can open. It may not exist, or it may name a capability
          you do not hold — this page does not say which, because saying so would confirm the article
          exists to somebody it was kept from.
        </p>
      </section>
    )}

    {article && (
      <header class="ka__head">
        <h1>{article.title}</h1>
        <p class="ka__meta">
          {kindLabel(article.kind)} · {kbCategoryLabel(article.category)} · version {article.version} ·
          {' '}{statusLabel(article.status)} · {audienceLabel(article.audience, article.requiredCapability)}
          {article.effectiveFrom ? ' · in force from ' + fmt(article.effectiveFrom) : ''}
        </p>
        {article.summary && <p class="ka__summary">{article.summary}</p>}
        {article.tags.length > 0 && (
          <p class="ka__tags">{article.tags.map((t) => <span class="ka__tag">{t}</span>)}</p>
        )}
      </header>
    )}

    {article && (
      <section class="ka__panel">
        <h2>As people read it</h2>
        <div class="ka__body" set:html={bodyHtml} />
        <p class="ka__note">
          Rendered on the server from markdown. No renderer is sent to the browser and this page ships
          no JavaScript at all.
        </p>
      </section>
    )}

    {article && viewer.canManage && (
      <section class="ka__panel">
        <h2>Edit</h2>
        <form method="POST">
          <input type="hidden" name="action" value="save" />

          <label for="ka-kind">What it is</label>
          <select class="ka__field" id="ka-kind" name="kind">
            {KB_KINDS.map((k) => <option value={k} selected={article.kind === k}>{kindLabel(k)}</option>)}
          </select>

          <label for="ka-title">Title</label>
          <input class="ka__field" id="ka-title" name="title" required maxlength="200" value={article.title} />

          <label for="ka-summary">One-line summary</label>
          <input class="ka__field" id="ka-summary" name="summary" maxlength="400" value={article.summary} />

          <label for="ka-category">Desk</label>
          <select class="ka__field" id="ka-category" name="category">
            {KB_CATEGORIES.map((c) => (
              <option value={c} selected={article.category === c}>{kbCategoryLabel(c)}</option>
            ))}
          </select>

          <label for="ka-tags">Tags, comma separated</label>
          <input class="ka__field" id="ka-tags" name="tags" maxlength="300" value={article.tags.join(', ')} />

          <label for="ka-body">The article</label>
          <textarea class="ka__field ka__area" id="ka-body" name="body" required rows="14">{article.body}</textarea>

          <label for="ka-audience">Who may read it</label>
          <select class="ka__field" id="ka-audience" name="audience">
            <option value="workspace" selected={article.audience === 'workspace'}>Everyone with a workspace</option>
            <option value="restricted" selected={article.audience === 'restricted'}>Only the holders of a capability</option>
          </select>

          <label for="ka-cap">The capability, if restricted</label>
          <input class="ka__field" id="ka-cap" name="required_capability" maxlength="80"
            value={article.requiredCapability || ''} placeholder="payroll.manage" />

          <label for="ka-effective">In force from, for a policy</label>
          <input class="ka__field" id="ka-effective" name="effective_from" type="date"
            value={article.effectiveFrom || ''} />

          <label class="ka__check">
            <input type="checkbox" name="ack_required" checked={article.ackRequired} />
            <span>Ask everybody to acknowledge this policy</span>
          </label>

          <label for="ka-note">What changed, in one line</label>
          <input class="ka__field" id="ka-note" name="change_note" maxlength="500"
            placeholder="Kept with the version you are replacing" />

          <button class="ka__submit" type="submit">Save</button>
        </form>
      </section>
    )}

    {article && viewer.canManage && (
      <section class="ka__panel">
        <h2>Publish and withdraw</h2>
        <form method="POST" class="ka__inline">
          <input type="hidden" name="action" value="publish" />
          <input class="ka__field" name="change_note" maxlength="500" placeholder="What changed, for the version record" />
          <button class="ka__submit" type="submit">
            {article.status === 'published' ? 'Publish a new version' : 'Publish'}
          </button>
        </form>
        <p class="ka__note">
          Publishing a CHANGED policy starts a new version, and because acknowledgements are recorded
          against a version that asks everybody to read it again. Publishing an unchanged one does
          not: pressing this twice will not send four hundred people the same request.
        </p>
        <form method="POST" class="ka__inline">
          <input type="hidden" name="action" value="archive" />
          <button class="ka__submit ka__ghost" type="submit">Archive it</button>
        </form>
        <p class="ka__note">
          Archiving hides it from readers and deletes nothing. "Did we tell people about this, and
          when" is a question that gets asked about policies that are no longer in force.
        </p>
      </section>
    )}

    {article && ledger && ledger.available && (
      <section class="ka__panel">
        <h2>Acknowledgement</h2>
        <div class="ka__metrics">
          <div class="ka__metric"><b>{ledger.currentCount}</b><span>Acknowledged v{ledger.currentVersion}</span></div>
          <div class="ka__metric"><b>{ledger.outstandingCount}</b><span>Not yet</span></div>
          <div class="ka__metric"><b>{ledger.eligibleCount}</b><span>Active employees</span></div>
        </div>
        <p class="ka__note">
          Acknowledged counts people who confirmed THIS version. An older acknowledgement does not
          carry forward, because a policy rewritten after somebody read it has not been acknowledged
          by them. Not-yet is a COUNT and stays one — there is no list of names behind it and this
          screen will not grow one.
        </p>
        {ledger.entries.length > 0 && (
          <div class="ka__ledger">
            <h3>Who confirmed, and which version</h3>
            {ledger.entries.map((e) => (
              <div class="ka__ledgerrow">
                <span>{e.name}</span>
                <span class="ka__ledgermeta">
                  v{e.version}{e.stale ? ' (superseded)' : ''} · {fmtTime(e.acknowledgedAt)}
                </span>
              </div>
            ))}
          </div>
        )}
        {ledger.entries.length === 0 && (
          <p class="ka__note">Nobody has acknowledged this yet.</p>
        )}
      </section>
    )}

    {article && ledger && !ledger.available && ledger.note && (
      <p class="ka__note">{ledger.note}</p>
    )}

    {article && viewer.canManage && versions.length > 0 && (
      <section class="ka__panel">
        <h2>Version history</h2>
        {versions.map((v) => (
          <details class="ka__version">
            <summary>
              Version {v.version} · {fmt(v.createdAt)}{v.changeNote ? ' · ' + v.changeNote : ''}
            </summary>
            <p class="ka__vtitle">{v.title}</p>
            <pre class="ka__pre">{v.body}</pre>
          </details>
        ))}
        <p class="ka__note">
          Each row is what the article SAID at that version — stored when it was replaced, not
          reconstructed afterwards. That is what makes an acknowledgement against a version mean
          something later.
        </p>
      </section>
    )}
  </div>
</AdminLayout>

<style>
  .ka { max-width: 860px; margin: 0 auto; padding: 4px 0 32px; }
  .ka__back { margin: 0 0 10px; font-size: 0.8125rem; }
  .ka__back a { color: #564E43; }
  .ka__head h1 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  .ka__meta { margin: 6px 0 0; font-size: 0.75rem; color: #70685C; overflow-wrap: anywhere; }
  .ka__summary { margin: 8px 0 0; font-size: 0.875rem; line-height: 1.6; color: #564E43; }
  .ka__tags { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ka__tag { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px;
    border: 1px solid #DFDCD8; background: #F8F8F6; font-size: 0.6875rem; color: #564E43; }

  .ka__ok, .ka__warn { margin: 0 0 12px; padding: 10px 12px; border-radius: 10px;
    font-size: 0.8125rem; line-height: 1.55; }
  .ka__ok { border: 1px solid #BFE3D0; background: #F1FAF5; color: #065F46; }
  .ka__warn { border: 1px solid #EADECD; background: #FBF7F1; color: #6D470D; }

  .ka__panel { margin: 16px 0 0; padding: 14px; border: 1px solid #DFDCD8; border-radius: 12px;
    background: #FDFDFC; }
  .ka__panel h1, .ka__panel h2 { margin: 0 0 8px; font-size: 1rem; font-weight: 680; }
  .ka__blurb { margin: 4px 0 0; font-size: 0.8125rem; line-height: 1.6; color: #564E43; }

  .ka__body { font-size: 0.9375rem; line-height: 1.7; color: #1B1813; overflow-wrap: anywhere; }
  .ka__body h2, .ka__body h3, .ka__body h4 { margin: 18px 0 6px; font-size: 1rem; font-weight: 680; }
  .ka__body p { margin: 10px 0; }
  .ka__body ul, .ka__body ol { margin: 10px 0 10px 20px; }
  .ka__body li { margin: 4px 0; }
  .ka__body blockquote { margin: 12px 0; padding: 8px 12px; border-left: 3px solid #DFDCD8;
    background: #F8F8F6; color: #564E43; }
  .ka__body code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875em; background: #F1EFEA; padding: 1px 5px; border-radius: 4px; }
  .ka__body img { max-width: 100%; height: auto; }

  .ka__panel label { display: block; margin: 12px 0 4px; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #70685C; font-weight: 650; }
  .ka__field { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid #DFDCD8;
    border-radius: 8px; background: #FDFDFC; color: #1B1813; font: inherit; font-size: 0.875rem; }
  .ka__area { min-height: 280px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem; line-height: 1.6; }
  .ka__check { display: flex; align-items: center; gap: 8px; margin: 14px 0 0; min-height: 44px; }
  .ka__check input { width: 20px; height: 20px; }
  .ka__check span { font-size: 0.8125rem; color: #564E43; text-transform: none; letter-spacing: 0; }
  .ka__submit { width: 100%; margin-top: 12px; min-height: 44px; padding: 10px 16px;
    border: 1px solid #1B1813; border-radius: 8px; background: #1B1813; color: #FFFFFF;
    font: inherit; font-size: 0.875rem; font-weight: 650; cursor: pointer; }
  .ka__ghost { background: #FDFDFC; color: #1B1813; }
  .ka__inline { margin-top: 10px; }

  .ka__metrics { display: flex; flex-wrap: wrap; gap: 10px; }
  .ka__metric { flex: 1 1 130px; min-width: 0; padding: 11px 13px; border: 1px solid #DFDCD8;
    border-radius: 10px; background: #F8F8F6; }
  .ka__metric b { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.375rem; line-height: 1.15; }
  .ka__metric span { display: block; margin-top: 3px; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #70685C; }

  .ka__ledger { margin-top: 12px; }
  .ka__ledger h3 { margin: 0 0 6px; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #70685C; font-weight: 650; }
  .ka__ledgerrow { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 8px; padding: 8px 0; border-bottom: 1px solid #EFEDE9; font-size: 0.8125rem; }
  .ka__ledgerrow:last-child { border-bottom: none; }
  .ka__ledgermeta { font-size: 0.75rem; color: #70685C; }

  .ka__version { margin-bottom: 8px; }
  .ka__version summary { min-height: 44px; display: flex; align-items: center; font-size: 0.8125rem;
    cursor: pointer; color: #564E43; }
  .ka__vtitle { margin: 6px 0; font-size: 0.875rem; font-weight: 650; }
  .ka__pre { margin: 0; padding: 10px 12px; border: 1px solid #EFEDE9; border-radius: 8px;
    background: #F8F8F6; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }

  .ka__note { margin: 10px 0 0; font-size: 0.75rem; line-height: 1.6; color: #70685C; }
</style>
