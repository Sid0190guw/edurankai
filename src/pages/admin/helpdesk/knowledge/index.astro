---
// /admin/helpdesk/knowledge — THE STAFF HANDBOOK, from the desk's side. Articles and policies.
//
// WHY IT LIVES UNDER /admin/helpdesk. This is not a separate product: it is what the helpdesk hands
// somebody INSTEAD of a ticket. Sitting under that path means middleware's longest-prefix match
// already gates it on the 'helpdesk' section — the same door the queue is behind — so the sidebar
// entry, the door and the page ask one question rather than three that can drift apart.
//
// THE GATE. The section OR the `knowledge.manage` capability, either of which admits. The section is
// what a custom role is granted in /admin/team/roles; the capability is the named authority. Every
// WRITE is re-checked inside src/lib/knowledge-base.ts against the posted id, never against the
// rendered one — a page gate is a door, not a lock.
//
// READING IS NOT GATED ON `knowledge.manage`, HERE OR ANYWHERE. An article carries an audience, and
// a restricted article names the capability that unlocks it; that is applied IN THE WHERE CLAUSE of
// every read by visibilityClause(). So this page shows its opener exactly the articles they may read
// plus, when they hold knowledge.manage, the drafts they may work on. A knowledge manager who does
// not hold `payroll.manage` cannot open an article restricted to it, and that is deliberate.
//
// const BEFORE THE POST HANDLER. `const` is not hoisted; a const declared under the handler that
// reads it throws on that handler's first line — the failure that took down apply step 5 and the
// /admin/roles/diagnose Repair button on this project while both reported success.
//
// CLIENT JAVASCRIPT: NONE. The composer is a <details> element and a form.
// MOBILE FIRST: 360px, 44px targets, one column, nothing scrolls the page sideways.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { holdsCapability } from '@/lib/auth/capability';
import { resolvePermissions } from '@/lib/auth/registry';
import {
  makeViewer, listArticles, searchArticles, knowledgeCounts, saveArticle,
  KB_CATEGORIES, KB_KINDS, kbCategoryLabel, kindLabel, statusLabel, audienceLabel, excerpt,
  type KbArticle,
} from '@/lib/knowledge-base';

const PAGE = '/admin/helpdesk/knowledge';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const bySection = await canAccessSection(user as any, 'helpdesk', 'view');
const byCapability = holdsCapability(user as any, 'knowledge.manage');
if (!bySection && !byCapability) return Astro.redirect('/admin');

// ---------------------------------------------------------------------------------------------
// CONSTANTS FIRST.
// ---------------------------------------------------------------------------------------------

const resolved = await resolvePermissions(String(user.id), { locals: Astro.locals });
const viewer = makeViewer(user as any, { permissions: resolved.permissions, hasWorkspace: true });

const fmt = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

function statusColour(s: string): string {
  const k = String(s || '');
  if (k === 'published') return '#047857';
  if (k === 'archived') return '#6b7280';
  return '#b45309';
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';
  let ok = true;
  let newId = '';

  if (action === 'create') {
    const r = await saveArticle(user as any, viewer, {
      kind: String(fd.get('kind') || 'article'),
      title: String(fd.get('title') || ''),
      summary: String(fd.get('summary') || ''),
      category: String(fd.get('category') || 'general'),
      tags: String(fd.get('tags') || ''),
      body: String(fd.get('body') || ''),
      audience: String(fd.get('audience') || 'workspace'),
      requiredCapability: String(fd.get('required_capability') || '') || null,
      ackRequired: String(fd.get('ack_required') || '') === 'on',
      effectiveFrom: String(fd.get('effective_from') || '') || null,
      authorName: String((user as any).name || ''),
    });
    ok = r.ok;
    newId = r.ok && r.id ? String(r.id) : '';
    flash = r.ok
      ? 'Saved as a draft. Nobody can read it until you publish it.'
      : (r.error || 'Could not save that.');
  } else {
    ok = false;
    flash = 'That is not something this page does.';
  }

  const back = newId ? PAGE + '/' + newId : PAGE;
  return Astro.redirect(back + (back.indexOf('?') >= 0 ? '&' : '?') + 'msg=' + encodeURIComponent(flash) + '&ok=' + (ok ? '1' : '0'));
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg') || '';
const msgOk = url.searchParams.get('ok') !== '0';
const q = String(url.searchParams.get('q') || '').trim().slice(0, 120);
const categoryFilter = String(url.searchParams.get('category') || '');
const kindFilter = String(url.searchParams.get('kind') || '');

const counts = await knowledgeCounts();

// The list. Drafts are included ONLY for a knowledge manager — and listArticles() re-checks that
// against the viewer rather than trusting this flag.
const hits = q ? await searchArticles(viewer, q, 40) : [];
const articles: KbArticle[] = q
  ? hits.map((h) => h.article)
  : await listArticles(viewer, {
      category: categoryFilter || null,
      kind: kindFilter || null,
      includeUnpublished: true,
      limit: 150,
    });

const hrefFor = (params: { category?: string; kind?: string }) => {
  const sp = new URLSearchParams();
  const cat = params.category !== undefined ? params.category : categoryFilter;
  const kind = params.kind !== undefined ? params.kind : kindFilter;
  if (cat) sp.set('category', cat);
  if (kind) sp.set('kind', kind);
  const s = sp.toString();
  return s ? PAGE + '?' + s : PAGE;
};
---

<AdminLayout title="Knowledge base" activeNav="helpdesk-knowledge">
  <div class="kb">
    <header class="kb__head">
      <h1>Knowledge base</h1>
      <p>
        The answers this desk gives more than once. Everything published here is offered to somebody
        raising a ticket BEFORE they raise it, matched on the desk they picked and what they typed —
        deflection, never refusal: the ticket form still submits.
      </p>
    </header>

    {msg && <p class={msgOk ? 'kb__ok' : 'kb__warn'}>{msg}</p>}

    <div class="kb__metrics">
      <div class="kb__metric"><b>{counts.published}</b><span>Published</span></div>
      <div class="kb__metric"><b>{counts.drafts}</b><span>Drafts</span></div>
      <div class="kb__metric"><b>{counts.policies}</b><span>Live policies</span></div>
      <div class="kb__metric"><b>{counts.restricted}</b><span>Restricted</span></div>
    </div>

    <form class="kb__search" method="get" action={PAGE}>
      <label class="kb__srlabel" for="kb-q">Search</label>
      <input class="kb__field" id="kb-q" name="q" type="search" value={q}
        placeholder="Title, summary, tag or the text of an article" maxlength="120" />
      <button class="kb__go" type="submit">Search</button>
    </form>

    {!q && (
      <nav class="kb__tabs" aria-label="Filter">
        <a class="kb__tab" href={hrefFor({ category: '', kind: '' })}
          aria-current={!categoryFilter && !kindFilter ? 'page' : null}>Everything</a>
        <a class="kb__tab" href={hrefFor({ kind: 'policy', category: '' })}
          aria-current={kindFilter === 'policy' ? 'page' : null}>Policies</a>
        {KB_CATEGORIES.map((c) => (
          <a class="kb__tab" href={hrefFor({ category: c, kind: '' })}
            aria-current={categoryFilter === c ? 'page' : null}>{kbCategoryLabel(c)}</a>
        ))}
      </nav>
    )}

    {viewer.canManage && (
      <details class="kb__compose">
        <summary>Write something new</summary>
        <form method="POST">
          <input type="hidden" name="action" value="create" />

          <label for="kb-kind">What is it</label>
          <select class="kb__field" id="kb-kind" name="kind">
            {KB_KINDS.map((k) => <option value={k}>{kindLabel(k)}</option>)}
          </select>
          <p class="kb__hint">
            A policy can ask people to acknowledge it, and the acknowledgement is recorded against the
            VERSION they read. Publishing a rewritten policy re-opens that question for everybody.
          </p>

          <label for="kb-title">Title</label>
          <input class="kb__field" id="kb-title" name="title" required maxlength="200"
            placeholder="How to ask for a laptop" />

          <label for="kb-summary">One-line summary</label>
          <input class="kb__field" id="kb-summary" name="summary" maxlength="400"
            placeholder="What somebody gets if they open this" />

          <label for="kb-category">Desk</label>
          <select class="kb__field" id="kb-category" name="category">
            {KB_CATEGORIES.map((c) => <option value={c}>{kbCategoryLabel(c)}</option>)}
          </select>
          <p class="kb__hint">
            The desk is what deflection matches on: an article filed under IT is offered to somebody
            raising an IT ticket. These are the helpdesk's own categories, not a second list.
          </p>

          <label for="kb-tags">Tags, comma separated</label>
          <input class="kb__field" id="kb-tags" name="tags" maxlength="300" placeholder="laptop, hardware, joining" />

          <label for="kb-body">The article</label>
          <textarea class="kb__field kb__area" id="kb-body" name="body" required rows="10"
            placeholder="Markdown. Headings, lists, links and bold. It is rendered on the server; nothing is sent to the browser to draw it."></textarea>

          <label for="kb-audience">Who may read it</label>
          <select class="kb__field" id="kb-audience" name="audience">
            <option value="workspace">Everyone with a workspace</option>
            <option value="restricted">Only the holders of a capability</option>
          </select>

          <label for="kb-cap">The capability, if restricted</label>
          <input class="kb__field" id="kb-cap" name="required_capability" maxlength="80"
            placeholder="payroll.manage" />
          <p class="kb__hint">
            Checked against the permission registry when you save. An article restricted to a
            capability that does not exist would be readable by nobody, including you, so it is
            refused rather than saved.
          </p>

          <label for="kb-effective">In force from, for a policy</label>
          <input class="kb__field" id="kb-effective" name="effective_from" type="date" />

          <label class="kb__check">
            <input type="checkbox" name="ack_required" />
            <span>Ask everybody to acknowledge this policy</span>
          </label>

          <button class="kb__submit" type="submit">Save as a draft</button>
          <p class="kb__hint">
            Saving does not publish. A draft is somebody mid-sentence about a policy that has not been
            agreed, and no reader is shown one.
          </p>
        </form>
      </details>
    )}

    {!viewer.canManage && (
      <p class="kb__note">
        You can read this library but not write in it. Writing an article or publishing a policy needs
        the knowledge-manager capability, because publishing a changed policy asks the whole company to
        read it again.
      </p>
    )}

    <section class="kb__list">
      <h2>{q ? 'Results for "' + q + '"' : 'Everything you can read'}</h2>
      {articles.length === 0 && (
        <p class="kb__note">
          {q
            ? 'Nothing matches that. It may not be written yet — which is a reason to write it, not a fault of the search.'
            : 'Nothing is written yet. The first article to write is the one this desk answers most often.'}
        </p>
      )}
      {articles.map((a) => (
        <a class="kb__row" href={PAGE + '/' + a.id}>
          <div class="kb__rowtop">
            <strong>{a.title}</strong>
            <span class="kb__pill" style={'color:' + statusColour(a.status)}>{statusLabel(a.status)}</span>
          </div>
          <div class="kb__meta">
            {kindLabel(a.kind)} · {kbCategoryLabel(a.category)} · v{a.version} · {audienceLabel(a.audience, a.requiredCapability)}
            {a.updatedAt ? ' · updated ' + fmt(a.updatedAt) : ''}
          </div>
          {excerpt(a) && <p class="kb__excerpt">{excerpt(a)}</p>}
        </a>
      ))}
    </section>

    <p class="kb__foot">
      What you can see on this page is decided in the query, not in the markup: an article you may not
      read is never fetched, so there is no version of this screen with it hidden underneath. Reading
      needs no permission of its own — the article names its own audience.
    </p>
  </div>
</AdminLayout>

<style>
  .kb { max-width: 860px; margin: 0 auto; padding: 4px 0 32px; }
  .kb__head h1 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  .kb__head p { margin: 6px 0 0; font-size: 0.8125rem; line-height: 1.6; color: #564E43; }

  .kb__ok, .kb__warn { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px;
    font-size: 0.8125rem; line-height: 1.55; }
  .kb__ok { border: 1px solid #BFE3D0; background: #F1FAF5; color: #065F46; }
  .kb__warn { border: 1px solid #EADECD; background: #FBF7F1; color: #6D470D; }

  .kb__metrics { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 0; }
  .kb__metric { flex: 1 1 130px; min-width: 0; padding: 11px 13px; border: 1px solid #DFDCD8;
    border-radius: 10px; background: #F8F8F6; }
  .kb__metric b { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.375rem; line-height: 1.15; }
  .kb__metric span { display: block; margin-top: 3px; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #70685C; }

  .kb__search { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 14px 0 0; }
  .kb__srlabel { font-size: 0.75rem; font-weight: 650; color: #564E43; }
  .kb__field { flex: 1 1 200px; min-width: 0; min-height: 44px; padding: 10px 12px;
    border: 1px solid #DFDCD8; border-radius: 8px; background: #FDFDFC; color: #1B1813;
    font: inherit; font-size: 0.875rem; width: 100%; }
  .kb__area { min-height: 200px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem; line-height: 1.6; }
  .kb__go, .kb__submit { min-height: 44px; padding: 10px 16px; border: 1px solid #1B1813;
    border-radius: 8px; background: #1B1813; color: #FFFFFF; font: inherit; font-size: 0.875rem;
    font-weight: 650; cursor: pointer; }
  .kb__submit { width: 100%; margin-top: 14px; }
  .kb__go:focus-visible, .kb__submit:focus-visible { outline: 2px solid #6F52E5; outline-offset: 2px; }

  .kb__tabs { display: flex; gap: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch;
    padding: 12px 0 2px; margin: 0; scrollbar-width: thin; }
  .kb__tab { flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px;
    border: 1px solid #DFDCD8; border-radius: 999px; background: #FDFDFC; color: #564E43;
    font-size: 0.8125rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .kb__tab[aria-current="page"] { background: #1B1813; border-color: #1B1813; color: #FFFFFF; }

  .kb__compose { margin: 16px 0 0; padding: 14px; border: 1px solid #DFDCD8; border-radius: 12px;
    background: #FDFDFC; }
  .kb__compose summary { font-size: 0.875rem; font-weight: 650; cursor: pointer; min-height: 44px;
    display: flex; align-items: center; }
  .kb__compose label { display: block; margin: 12px 0 4px; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #70685C; font-weight: 650; }
  .kb__check { display: flex; align-items: center; gap: 8px; margin: 14px 0 0; min-height: 44px; }
  .kb__check input { width: 20px; height: 20px; }
  .kb__check span { font-size: 0.8125rem; color: #564E43; text-transform: none; letter-spacing: 0; }
  .kb__hint { margin: 6px 0 0; font-size: 0.75rem; line-height: 1.55; color: #70685C; }

  .kb__list { margin: 18px 0 0; }
  .kb__list h2 { margin: 0 0 8px; font-size: 1rem; font-weight: 680; }
  .kb__row { display: block; padding: 12px 0; border-bottom: 1px solid #EFEDE9; text-decoration: none;
    color: inherit; min-height: 44px; }
  .kb__row:last-child { border-bottom: none; }
  .kb__rowtop { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .kb__rowtop strong { font-size: 0.9375rem; overflow-wrap: anywhere; }
  .kb__pill { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    white-space: nowrap; }
  .kb__meta { margin-top: 3px; font-size: 0.75rem; color: #70685C; overflow-wrap: anywhere; }
  .kb__excerpt { margin: 6px 0 0; font-size: 0.8125rem; line-height: 1.55; color: #564E43; }
  .kb__note { margin: 12px 0 0; font-size: 0.8125rem; line-height: 1.6; color: #70685C; }
  .kb__foot { margin: 20px 0 0; padding: 14px 0 0; border-top: 1px solid #DFDCD8;
    font-size: 0.75rem; line-height: 1.7; color: #70685C; }
</style>
