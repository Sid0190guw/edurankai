---
// /admin/announcements/recognition — RECOGNITION, IN AGGREGATE.
//
// WHAT THIS PAGE IS, AND THE SHAPE IS THE POINT. Every figure is a count or a count of distinct
// people. There is no row per person, no ORDER BY that ranks anybody, and no drill-down to an
// individual — not because a filter hides one, but because src/lib/recognition.ts contains no query
// that would produce one. "Who got the fewest" is one ORDER BY away from being a public list of the
// people nobody thanked, so the function that would answer it does not exist.
//
// SUPPRESSION IS THE PLATFORM'S, NOT THIS PAGE'S. suppressBands() and MIN_GROUP come from
// src/lib/analytics-workforce.ts, which takes them from src/lib/wellness.ts where the minimum group
// size is defined once. A breakdown covering fewer than that is withheld, and its total is withheld
// with it — otherwise the missing number can be subtracted back out.
//
// THE MODERATION LIST IS COMPANY-WIDE RECOGNITIONS ONLY. A recognition sent to one team was sent by
// somebody who chose a narrower audience, and listing it here would quietly widen that choice after
// the fact. A moderator who can see a team-scoped one — because it is their team — takes it down
// from the feed, with the same capability and the same reason field.
//
// THE GATE. The `hr` section OR `announcements.publish` opens the page; the REMOVE button needs
// `recognition.moderate`, and that is re-checked inside src/lib/recognition.ts against the posted id.
//
// const BEFORE THE POST HANDLER. `const` is not hoisted.
// CLIENT JAVASCRIPT: NONE. MOBILE FIRST: 360px, 44px targets, wide content scrolls in its own box.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { holdsCapability } from '@/lib/auth/capability';
import { buildFeedViewer } from '@/lib/announcements';
import {
  recognitionOverview, listCompanyWideForModeration, removeRecognition,
  recognitionTagLabel, visibilityLabel,
  type Recognition, type RecognitionOverview,
} from '@/lib/recognition';

const PAGE = '/admin/announcements/recognition';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const byCapability = holdsCapability(user as any, 'announcements.publish');
const bySection = await canAccessSection(user as any, 'hr', 'view');
if (!byCapability && !bySection) return Astro.redirect('/admin');

// ---------------------------------------------------------------------------------------------
// CONSTANTS FIRST.
// ---------------------------------------------------------------------------------------------

const viewer = await buildFeedViewer(user as any);
const canModerate = viewer.canModerateRecognition;

const fmtTime = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';
  let ok = true;

  if (action === 'remove') {
    const r = await removeRecognition(user as any, viewer, String(fd.get('id') || ''), String(fd.get('reason') || ''));
    ok = r.ok;
    flash = r.ok
      ? 'Taken down. The row stays with your reason on it — nothing is deleted here.'
      : (r.error || 'Could not take that down.');
  } else {
    ok = false;
    flash = 'That is not something this page does.';
  }

  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash) + '&ok=' + (ok ? '1' : '0'));
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg') || '';
const msgOk = url.searchParams.get('ok') !== '0';

const overview: RecognitionOverview = await recognitionOverview();
const moderationList: Recognition[] = canModerate ? await listCompanyWideForModeration(viewer, 60) : [];

/** A band's number, or the platform's "too few" words. Never a zero standing in for a withheld one. */
const bandValue = (count: number | null, suppressed: boolean): string =>
  suppressed || count === null ? overview.tooFewLabel : String(count);

const participation = overview.headcount > 0
  ? Math.round((overview.distinctSenders / overview.headcount) * 100)
  : 0;
---

<AdminLayout title="Recognition" activeNav="announcements">
  <div class="rc">
    <header class="rc__head">
      <h1>Recognition</h1>
      <p>
        One person thanking another for something specific. Anybody with an employee record may send
        one, in any direction — there is no capability behind it and no check that the sender is
        senior to the person they are thanking. Recognition that only flows downward is not
        recognition.
      </p>
    </header>

    {msg && <p class={msgOk ? 'rc__ok' : 'rc__warn'}>{msg}</p>}

    <p class="rc__note">{overview.note}</p>

    <div class="rc__metrics">
      <div class="rc__metric"><b>{overview.total}</b><span>Sent, all time</span></div>
      <div class="rc__metric"><b>{overview.last30}</b><span>Last 30 days</span></div>
      <div class="rc__metric"><b>{overview.distinctSenders}</b><span>People who sent one ({overview.windowDays}d)</span></div>
      <div class="rc__metric"><b>{overview.distinctReceivers}</b><span>People who received one ({overview.windowDays}d)</span></div>
      <div class="rc__metric"><b>{participation}%</b><span>Of {overview.headcount} on record sent one</span></div>
    </div>

    <section class="rc__panel">
      <h2>How people choose to share them</h2>
      <p class="rc__body-note">
        {overview.companyWide} company-wide · {overview.teamScoped} to their teams only.
      </p>
      <p class="rc__hint">
        The sender picks. A team-scoped one is not readable on this page and is not counted anywhere
        that would name the people in it — the choice means what it says.
      </p>
      {(overview.withdrawn > 0 || overview.removed > 0) && (
        <p class="rc__body-note">
          {overview.withdrawn} withdrawn by whoever sent them · {overview.removed} taken down by a
          moderator. Shown rather than hidden, because a count that quietly excludes them would not
          add up.
        </p>
      )}
    </section>

    <section class="rc__panel">
      <h2>What people are being thanked for</h2>
      {overview.tagBands.length === 0 && <p class="rc__body-note">Nothing to break down yet.</p>}
      {overview.tagBands.length > 0 && (
        <ul class="rc__bands">
          {overview.tagBands.map((b) => (
            <li><span>{b.label}</span><b>{bandValue(b.count, b.suppressed)}</b></li>
          ))}
        </ul>
      )}
      {overview.tagSuppressed > 0 && (
        <p class="rc__hint">
          {overview.tagSuppressed} {overview.tagSuppressed === 1 ? 'band covers' : 'bands cover'} fewer
          than {overview.minGroup} and {overview.tagSuppressed === 1 ? 'is' : 'are'} withheld, and the
          total is withheld with them so the missing number cannot be subtracted back out.
        </p>
      )}
      <p class="rc__hint">
        The tag is optional and the sentence is the part that matters, so "no tag" being the largest
        band is a normal result rather than a problem to fix.
      </p>
    </section>

    <section class="rc__panel">
      <h2>Which departments are receiving them</h2>
      {overview.departmentBands.length === 0 && <p class="rc__body-note">Nothing to break down yet.</p>}
      {overview.departmentBands.length > 0 && (
        <ul class="rc__bands">
          {overview.departmentBands.map((b) => (
            <li><span>{b.label}</span><b>{bandValue(b.count, b.suppressed)}</b></li>
          ))}
        </ul>
      )}
      {overview.departmentSuppressed > 0 && (
        <p class="rc__hint">
          {overview.departmentSuppressed} withheld for covering fewer than {overview.minGroup} people.
          In a small department a count of two is a description of two named people, not a statistic.
        </p>
      )}
      <p class="rc__hint">
        This is a reading of where the programme has reached, not a scoreboard. A department with a
        low number needs a conversation, not a chart on a wall.
      </p>
    </section>

    {canModerate && (
      <section class="rc__panel">
        <h2>Company-wide recognitions</h2>
        <p class="rc__hint">
          Only the ones the sender chose to make company-wide. A team-scoped one is not listed here on
          purpose — the sender picked a narrower audience and this desk is not in it. If one needs
          taking down, whoever can see it can take it down from the feed with this same capability.
        </p>
        {moderationList.length === 0 && <p class="rc__body-note">None yet.</p>}
        {moderationList.map((r) => (
          <div class="rc__item">
            <div class="rc__itemtop">
              <strong>{r.fromName} thanked {r.toName}</strong>
              <span>{fmtTime(r.createdAt)}</span>
            </div>
            <p class="rc__msg">{r.message}</p>
            <p class="rc__meta">{recognitionTagLabel(r.tag)} · {visibilityLabel(r.visibility)}</p>
            <form method="POST" class="rc__remove">
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="id" value={r.id} />
              <label class="rc__srlabel" for={'why-' + r.id}>Reason for taking it down</label>
              <input class="rc__field" id={'why-' + r.id} name="reason" maxlength="300" required
                placeholder="Why this is coming down" />
              <button class="rc__btn" type="submit">Take it down</button>
            </form>
          </div>
        ))}
      </section>
    )}

    {!canModerate && (
      <p class="rc__note">
        You can read these figures but not take anything down. Removing somebody else's recognition
        needs the recognition-moderation capability.
      </p>
    )}

    <p class="rc__foot">
      There is no leaderboard on this page and there is no query behind it that could build one.
      Ranking people by how often they were thanked turns gratitude into a target, and the bottom of
      such a list is a thing done to somebody rather than a fact about them.
    </p>
  </div>
</AdminLayout>

<style>
  .rc { max-width: 820px; margin: 0 auto; padding: 4px 0 32px; }
  .rc__head h1 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  .rc__head p { margin: 6px 0 0; font-size: 0.8125rem; line-height: 1.6; color: #564E43; }

  .rc__ok, .rc__warn, .rc__note { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px;
    font-size: 0.8125rem; line-height: 1.55; }
  .rc__ok { border: 1px solid #BFE3D0; background: #F1FAF5; color: #065F46; }
  .rc__warn { border: 1px solid #EADECD; background: #FBF7F1; color: #6D470D; }
  .rc__note { border: 1px solid #DFDCD8; background: #F8F8F6; color: #564E43; }

  .rc__metrics { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 0; }
  .rc__metric { flex: 1 1 140px; min-width: 0; padding: 11px 13px; border: 1px solid #DFDCD8;
    border-radius: 10px; background: #F8F8F6; }
  .rc__metric b { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.375rem; line-height: 1.15; }
  .rc__metric span { display: block; margin-top: 3px; font-size: 0.6875rem; letter-spacing: 0.05em;
    text-transform: uppercase; color: #70685C; }

  .rc__panel { margin: 22px 0 0; padding: 14px; border: 1px solid #DFDCD8; border-radius: 12px;
    background: #FDFDFC; }
  .rc__panel h2 { margin: 0 0 8px; font-size: 0.9375rem; font-weight: 700; }
  .rc__body-note { margin: 0 0 6px; font-size: 0.8125rem; line-height: 1.6; color: #564E43; }
  .rc__hint { margin: 6px 0 0; font-size: 0.75rem; line-height: 1.55; color: #70685C; }

  .rc__bands { list-style: none; margin: 8px 0 0; padding: 0; }
  .rc__bands li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid #EFEDE9; font-size: 0.8125rem; }
  .rc__bands li:last-child { border-bottom: none; }
  .rc__bands b { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem; }

  .rc__item { padding: 12px 0; border-bottom: 1px solid #EFEDE9; }
  .rc__item:last-child { border-bottom: none; }
  .rc__itemtop { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline;
    justify-content: space-between; }
  .rc__itemtop strong { font-size: 0.875rem; overflow-wrap: anywhere; }
  .rc__itemtop span { font-size: 0.75rem; color: #70685C; }
  .rc__msg { margin: 6px 0 0; font-size: 0.875rem; line-height: 1.65; color: #1B1813;
    overflow-wrap: anywhere; }
  .rc__meta { margin: 4px 0 0; font-size: 0.75rem; color: #70685C; }

  .rc__remove { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .rc__srlabel { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .rc__field { flex: 1 1 200px; min-width: 0; min-height: 44px; padding: 10px 12px;
    border: 1px solid #DFDCD8; border-radius: 8px; background: #FDFDFC; color: #1B1813; font: inherit;
    font-size: 0.875rem; }
  .rc__btn { flex: none; min-height: 44px; padding: 10px 16px; border: 1px solid #C08A3E;
    border-radius: 8px; background: #FDFDFC; color: #6D470D; font: inherit; font-size: 0.875rem;
    font-weight: 600; cursor: pointer; }
  .rc__btn:focus-visible { outline: 2px solid #6F52E5; outline-offset: 2px; }

  .rc__foot { margin: 24px 0 0; font-size: 0.75rem; line-height: 1.6; color: #70685C; }
</style>
