---
// Offboarding report and completion letter for one employee.
//
// Everything here is computed from recorded attendance, approved leave and logged reviews — nobody
// types a credit figure. The letter is something people show to universities and employers, so a
// hand-entered number would be a claim we could not stand behind.
//
// The page is deliberately honest about gaps: if terms were never set, or the requirement is unmet,
// it says so rather than rendering a confident-looking letter over missing data.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can, canAccessSection } from '@/lib/auth/permissions';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ledgerFor, reviewsForDetailed, termsFor, setTermsFor } from '@/lib/credit-ledger';
import { completionFigures, remainingWeeks, weeklyHoursFor } from '@/lib/credit-hours';
// THE CREDIT UNIT THE FOUNDER CORRECTED. One credit is one COMPLETED WEEK, not an hour, and it is
// earned only when the hours were actually measured and the week's reports and tasks were done. The
// letter below used to print a single credit-hours figure with nothing behind it - a figure that
// included eight hours for every day somebody merely ticked in an attendance grid. It now prints
// credits EARNED with what each one rests on, and states the PENDING ones separately, because a
// completion letter that overstates credits to an accredited partner is the worst possible place
// for this to be wrong.
import {
  reconcileCreditWeeks,
  syncCreditDecisions,
  type ReconcileResult,
} from '@/lib/credit-week-ledger';
import { positionFrom, weekLabel } from '@/lib/credit-week';
import {
  creditsLabel, hoursLabel as creditHoursLabel,
  CREDIT_UNIT_SENTENCE, INTERN_WEEK_SENTENCE, CREDIT_SCOPE_SENTENCE,
} from '@/lib/credit-week-copy';
// The date this engagement ENDED is a claim printed on a certificate, not a formatting choice, and
// this process runs in UTC — five and a half hours behind the people whose record it is. Between
// 00:00 and 05:29 IST `new Date().toISOString().slice(0,10)` named YESTERDAY as the last day of
// somebody's engagement, on the document they hand to a university.
import { civilToday } from '@/lib/page-safety';

const user = Astro.locals.user!;
// This gate used to read `can(user, 'hr.edit') && can(user, 'employees.edit')`. Neither name exists
// in the Permission union in src/lib/auth/permissions.ts, so can() returned false for EVERY role
// including super_admin and this screen redirected all of them to /admin — the same defect that
// made /admin/offer-verifications unreachable while firms were being charged for the requests it
// was supposed to answer. It matters here because engagement terms and the credit-hour requirement
// are set on this page and nowhere else, so with the gate broken no intern's requirement could ever
// be recorded, and their completion letter had nothing to be measured against.
//
// 'admin.access' is a permission that actually exists. It is not sufficient on its own (editor and
// marketing both carry it), so the HR desk is narrowed by role, with the custom-role 'hr' section
// grant as the configurable path.
//
// CONVERTED FROM A ROLE-NAME TEST, with /admin/hr:54, which must keep asking the same question as
// this page: `roleName === 'hr' || roleName === 'super_admin'` is now can(user, 'employee.manage'),
// granted in PERMS_BY_ROLE to exactly those two roles. permissions.ts lists
// "/admin/hr/completion/[id] isHrDesk" among the checks the key was derived from. The custom-role
// arm below is untouched — can() cannot see custom roles, and the registry resolves an `hr` section
// row as hr.edit and NEVER as employee.manage, so dropping that arm would silently close this screen
// to every custom role that holds it today.
const isHrDesk = can(user, 'employee.manage');
const mayEditHr = can(user, 'admin.access')
  && (isHrDesk || await canAccessSection(user as any, 'hr', 'edit').catch(() => false));
if (!mayEditHr) return Astro.redirect('/admin');

const id = Astro.params.id!;
const rows = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

let msg = '';
let msgOk = true;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'terms') {
    const kind = String(fd.get('kind') || 'full-time') === 'part-time' ? 'part-time' : 'full-time';
    const wh = parseFloat(String(fd.get('weeklyHours') || '')) || null;
    // "Engagement terms saved." used to be printed on the line after the call with nothing between
    // them. setTermsFor() runs four ALTERs and an UPDATE and reports nothing back, so a rejected
    // write took the whole page down with a stack trace — and the terms it names are what the
    // credit requirement is measured against.
    try {
      await setTermsFor(id, {
        kind,
        weeklyHours: wh ?? (kind === 'full-time' ? 40 : undefined),
        workingDaysPerWeek: parseInt(String(fd.get('daysPerWeek') || '5')) || 5,
        requiredCreditHours: parseInt(String(fd.get('required') || '')) || undefined,
      });
      msg = 'Engagement terms saved.';
    } catch (e: any) {
      console.error('[admin/hr/completion] terms', e?.cause?.message || e?.message);
      msg = 'The engagement terms were NOT saved: ' + (e?.cause?.message || e?.message || 'unknown error');
      msgOk = false;
    }
  } else if (fd.get('_action') === 'review') {
    const note = String(fd.get('note') || '').trim();
    if (!note) { msg = 'A review needs a note. Nothing was saved.'; msgOk = false; }
    else {
      // This INSERT used to end in .catch(() => {}) with "Review added." printed unconditionally
      // underneath it. A review that failed to save is not a cosmetic loss: reviews rated 4 or
      // above become the achievements printed on the completion certificate below, so the
      // certificate would quietly go out without it.
      try {
        await db.execute(sql`
          INSERT INTO hr_reviews (employee_id, reviewer_name, reviewer_id, rating, note, period)
          VALUES (${id}, ${user.name || user.email}, ${user.id},
                  ${parseInt(String(fd.get('rating') || '')) || null}, ${note},
                  ${String(fd.get('period') || '') || null})`);
        msg = 'Review added.';
      } catch (e: any) {
        msg = 'The review was NOT saved: ' + (e?.cause?.message || e?.message || 'unknown error');
        msgOk = false;
      }
    }
  }
}

const emp = rows(await db.execute(sql`
  SELECT id, full_name, email, designation, joining_date, employment_status, employment_type
  FROM hr_employees WHERE id = ${id} LIMIT 1`))[0];
if (!emp) return Astro.redirect('/admin/hr/employees');

const terms = await termsFor(id);
// `ok` is the whole point of reading these two through the detailed readers. Both used to answer an
// empty result on a failed read that looked EXACTLY like a genuinely empty one — no attendance, no
// reviews — and this page then rendered a signed-looking certificate over it: nought credit-hours,
// nought per cent attendance, and no achievements. A certificate stating figures nobody measured is
// worse than no certificate, so when either read failed the letter is not rendered at all.
const ledger = await ledgerFor(id, terms);
const { summary, days } = ledger;
const reviewRead = await reviewsForDetailed(id);
const reviews = reviewRead.reviews;
const achievements = reviews.filter((r) => (r.rating || 0) >= 4).map((r) => r.note).slice(0, 6);

/** True only when every figure on the letter came from a read that actually happened. */
const figuresTrustworthy = ledger.ok && reviewRead.ok;
const readProblem = [ledger.error, reviewRead.error].filter(Boolean).join(' ');

// The last day of the engagement, cut in the zone the company works in. See the import note.
const letterEndDate = civilToday();

const figures = completionFigures({
  name: emp.full_name, role: emp.designation || '',
  startDate: String(emp.joining_date || '').slice(0, 10),
  endDate: letterEndDate,
  terms, summary, reviews, achievements,
});
const weeksLeft = remainingWeeks(summary, terms);
const contractedWeekly = weeklyHoursFor(terms);
const termsMissing = terms.kind === 'part-time' && contractedWeekly === 0;

// THE WEEKLY CREDIT REGISTER. Reading it is also what grants the weeks that earned themselves -
// idempotently, and only when every read behind them succeeded. A week a person already decided is
// never re-measured, so the evidence printed here is the evidence the approver saw.
await syncCreditDecisions(id);
const credit: ReconcileResult = await reconcileCreditWeeks(id, { maxWeeks: 104 });
const creditPosition = positionFrom(credit.weeks);
const creditsTotal = creditPosition.credits;
const creditedWeeks = credit.weeks.filter((w) => w.state === 'earned-automatically' || w.state === 'approved');
const pendingWeeks = credit.weeks.filter((w) => w.state === 'pending');
const unmeasurableWeeks = credit.weeks.filter(
  (w) => !!w.evidence && Array.isArray(w.evidence.incompleteDates) && w.evidence.incompleteDates.length > 0,
);
// The letter states credits only when the register could actually be read AND this engagement is on
// the credit model at all. A salaried engagement is not measured by an intern's week, and printing
// "0 credits" for one would be a claim about somebody rather than an absence of a measurement.
const creditsPrintable = credit.ok && credit.applicable;

const card = 'border:1px solid #2a2a30;border-radius:12px;background:#0f0f14;padding:14px;';
const stat = (label: string, value: string, tone = '#e8e8ee') =>
  `<div style="${card}"><p style="font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin:0 0 4px;">${label}</p><p style="font-size:20px;font-weight:700;color:${tone};margin:0;font-family:'Geist Mono',monospace;">${value}</p></div>`;
---
<AdminLayout title={'Completion — ' + emp.full_name}>
  <div style="max-width:900px;">
    <h1 style="font-family:'Fraunces',serif;font-size:24px;margin:0 0 2px;">{emp.full_name}</h1>
    <p style="font-size:13px;color:#8a8a94;margin:0 0 16px;">{emp.designation} · joined {String(emp.joining_date || '').slice(0, 10) || 'unknown'}</p>

    {msg && <div style={'padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px;border:1px solid ' + (msgOk ? '#14532d;background:rgba(20,83,45,0.2);' : 'rgba(239,68,68,0.35);background:rgba(239,68,68,0.12);color:#fca5a5;')}>{msg}</div>}

    {!figuresTrustworthy && (
      <div style="padding:12px 14px;border-radius:8px;margin-bottom:14px;border:1px solid rgba(239,68,68,0.35);background:rgba(239,68,68,0.12);color:#fca5a5;font-size:13px;line-height:1.55;">
        <strong>The figures below could not be read, so this is not a measurement.</strong>
        Every number on this page defaults to zero when the read fails, which looks identical to an
        intern who attended nothing and was never reviewed. The completion letter is withheld for
        that reason rather than printed over guesses.
        {readProblem && <span style="display:block;margin-top:6px;color:#f5b1b1;font-family:'Geist Mono',monospace;font-size:11px;">{readProblem}</span>}
      </div>
    )}

    {termsMissing && (
      <div style="padding:12px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #b45309;background:rgba(180,83,9,0.14);font-size:13px;line-height:1.55;">
        <strong>Part-time hours have not been set.</strong> Credit cannot be calculated until the
        agreed weekly hours are recorded, so the figures below read as zero. This is deliberate —
        guessing a contract would misstate what this person agreed to.
      </div>
    )}

    {/* THREE DIFFERENT FACTS, NEVER ONE NUMBER. Credits earned, credits waiting on a person, and
        weeks that could not be measured at all. They used to render as a single credit-hours
        figure that quietly included eight hours for every ticked day. */}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:10px;">
      <Fragment set:html={stat('Credits earned', creditsPrintable ? String(creditsTotal) : 'not measured', creditsPrintable ? '#6ee7b7' : '#b4b4be')} />
      <Fragment set:html={stat('Granted automatically', creditsPrintable ? String(creditPosition.earnedAutomatically) : '—')} />
      <Fragment set:html={stat('Credits waiting', creditsPrintable ? String(creditPosition.pending) : '—', creditPosition.pending ? '#fbbf24' : '#e8e8ee')} />
      <Fragment set:html={stat('Weeks not measurable', creditsPrintable ? String(unmeasurableWeeks.length) : '—', unmeasurableWeeks.length ? '#f87171' : '#e8e8ee')} />
    </div>

    <p style="font-size:12px;color:#8a8a94;margin:0 0 16px;line-height:1.6;">
      {CREDIT_UNIT_SENTENCE} {INTERN_WEEK_SENTENCE}
      {' '}<a href={'/admin/hr/credits/' + id} style="color:#e8e8ee;">Open the week-by-week record</a>.
    </p>

    {!credit.ok && (
      <div style="padding:12px 14px;border-radius:8px;margin-bottom:14px;border:1px solid rgba(239,68,68,0.35);background:rgba(239,68,68,0.12);color:#fca5a5;font-size:13px;line-height:1.55;">
        <strong>The weekly credit record could not be read, so no credit figure is stated.</strong>
        <span> {credit.error} A zero here would look exactly like somebody who earned nothing, and the
        letter will not print a credit count it could not measure.</span>
      </div>
    )}

    {credit.ok && !credit.applicable && (
      <div style="padding:12px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #2a2a30;background:#0f0f14;font-size:13px;line-height:1.55;color:#8a8a94;">
        <strong>This engagement is not on the weekly credit model.</strong>
        <span> {credit.notApplicableReason} The letter states hours and attendance for it, and no credit count.</span>
      </div>
    )}

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:18px;">
      <Fragment set:html={stat('Credit-hours recorded', String(summary.creditHours))} />
      <Fragment set:html={stat('Attendance', summary.attendancePct + '%', summary.attendancePct >= 85 ? '#4ade80' : summary.attendancePct >= 70 ? '#fbbf24' : '#f87171')} />
      <Fragment set:html={stat('Required', summary.requiredCreditHours ? String(summary.requiredCreditHours) : 'not set')} />
      <Fragment set:html={stat('Weeks remaining', weeksLeft == null ? '—' : String(weeksLeft))} />
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:18px;">
      <Fragment set:html={stat('Days present', String(summary.daysPresent))} />
      <Fragment set:html={stat('Authorised leave', String(summary.authorisedLeaveDays))} />
      <Fragment set:html={stat('Unauthorised', String(summary.unauthorisedLeaveDays), summary.unauthorisedLeaveDays ? '#f87171' : '#e8e8ee')} />
      <Fragment set:html={stat('Notice breaches', String(summary.noticeBreaches), summary.noticeBreaches ? '#fbbf24' : '#e8e8ee')} />
    </div>

    {summary.unmeasuredDays > 0 && (
      <div style="padding:12px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #b45309;background:rgba(180,83,9,0.14);font-size:13px;line-height:1.55;">
        <strong>{summary.unmeasuredDays} day(s) were marked present with no hours recorded against them.</strong>
        <span> They credit NOTHING. Until recently each of them was credited the expected daily
        figure - eight hours for a full-time engagement - so ticking a box in the attendance grid
        produced credit-hours on this letter that nobody had worked. The dates are
        {' ' + summary.unmeasuredDates.slice(0, 12).join(', ')}
        {summary.unmeasuredDates.length > 12 ? ' and ' + (summary.unmeasuredDates.length - 12) + ' more' : ''}.</span>
      </div>
    )}

    {/* WHAT THE CREDITS REST ON. Printed, not summarised: a number with no evidence behind it is
        exactly what this page used to hand somebody to show a university. */}
    {creditsPrintable && (
      <details style={card + 'margin-bottom:16px;'} open={pendingWeeks.length > 0}>
        <summary style="cursor:pointer;font-size:13px;font-weight:600;">
          Weekly credits: {creditsTotal} earned, {creditPosition.pending} waiting, {unmeasurableWeeks.length} not measurable
        </summary>

        {creditedWeeks.length === 0 && (
          <p style="font-size:12.5px;color:#8a8a94;margin:10px 0 0;line-height:1.6;">No week has been
          credited yet. That is a statement about the register, not about the person.</p>
        )}

        {creditedWeeks.map((w) => (
          <div style="border-top:1px solid #1a1a22;padding:9px 0;">
            <p style="font-size:12.5px;color:#e8e8ee;margin:0;font-weight:650;">
              {w.label || weekLabel(w.weekStart)} · {w.state === 'earned-automatically' ? 'granted automatically' : 'credited by decision'}
            </p>
            <p style="font-size:12px;color:#8a8a94;margin:3px 0 0;line-height:1.6;">
              {creditHoursLabel(w.hoursMeasured)} measured of {creditHoursLabel(w.hoursRequired)} required
              {' · reports ' + w.reportsFiled + '/' + w.reportsExpected}
              {' · tasks ' + w.tasksCompleted + '/' + w.tasksAssigned}
              {w.decidedByName ? ' · decided by ' + w.decidedByName : ''}
            </p>
            {w.decisionReason && w.state === 'approved' && (
              <p style="font-size:12px;color:#c8c8d0;margin:3px 0 0;line-height:1.6;">Reason: {w.decisionReason}</p>
            )}
          </div>
        ))}

        {pendingWeeks.length > 0 && (
          <>
            <p style="font-size:12.5px;font-weight:650;margin:14px 0 0;color:#fbbf24;">Waiting on a decision, and NOT counted above</p>
            {pendingWeeks.map((w) => (
              <div style="border-top:1px solid #1a1a22;padding:9px 0;">
                <p style="font-size:12.5px;color:#e8e8ee;margin:0;">{w.label || weekLabel(w.weekStart)}</p>
                <p style="font-size:12px;color:#8a8a94;margin:3px 0 0;line-height:1.55;">
                  {creditHoursLabel(w.hoursMeasured)} measured of {creditHoursLabel(w.hoursRequired)} required
                  {' · reports ' + w.reportsFiled + '/' + w.reportsExpected}
                  {' · tasks ' + w.tasksCompleted + '/' + w.tasksAssigned}
                </p>
                {w.haltReason && (
                  <p style="font-size:12px;color:#fca5a5;margin:3px 0 0;line-height:1.55;">{w.haltReason}</p>
                )}
              </div>
            ))}
          </>
        )}

        {unmeasurableWeeks.length > 0 && (
          <p style="font-size:12px;color:#f87171;margin:12px 0 0;line-height:1.6;">
            {unmeasurableWeeks.length} week(s) contain a day that was checked in and never checked out.
            Those hours are unknown, not zero, which is why those weeks are neither credited nor refused.
          </p>
        )}
      </details>
    )}

    {/* Terms */}
    <details style={card + 'margin-bottom:16px;'}>
      <summary style="cursor:pointer;font-size:13px;font-weight:600;">Engagement terms</summary>
      <form method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;align-items:end;margin-top:12px;">
        <input type="hidden" name="_action" value="terms" />
        <label style="font-size:11px;color:#8a8a94;">Kind
          <select name="kind" style="width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:7px;border-radius:6px;font-size:12.5px;">
            <option value="full-time" selected={terms.kind === 'full-time'}>Full-time</option>
            <option value="part-time" selected={terms.kind === 'part-time'}>Part-time</option>
          </select>
        </label>
        <label style="font-size:11px;color:#8a8a94;">Hours / week
          <input name="weeklyHours" type="number" step="0.5" value={terms.weeklyHours ?? ''} style="width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:7px;border-radius:6px;font-size:12.5px;" />
        </label>
        <label style="font-size:11px;color:#8a8a94;">Days / week
          <input name="daysPerWeek" type="number" value={terms.workingDaysPerWeek ?? 5} style="width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:7px;border-radius:6px;font-size:12.5px;" />
        </label>
        <label style="font-size:11px;color:#8a8a94;">Required credit-hours
          <input name="required" type="number" value={terms.requiredCreditHours ?? ''} style="width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:7px;border-radius:6px;font-size:12.5px;" />
        </label>
        <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:12.5px;padding:8px 14px;border-radius:6px;cursor:pointer;">Save</button>
      </form>
      <p style="font-size:11px;color:#8a8a94;margin:10px 0 0;line-height:1.5;">
        Part-time is pro-rata against a 40-hour week and must reach the SAME required credit-hours,
        so a half load simply runs twice as long.
      </p>
    </details>

    {/* Reviews */}
    <div style={card + 'margin-bottom:16px;'}>
      <p style="font-size:13px;font-weight:600;margin:0 0 10px;">Reviews {reviewRead.ok ? '(' + reviews.length + ')' : '(could not be read)'}</p>
      {!reviewRead.ok && (
        <p style="font-size:12px;color:#fca5a5;margin:0 0 10px;line-height:1.5;">
          The recorded reviews could not be read, so this list is empty for a reason that has nothing
          to do with whether anybody has reviewed this person. Nothing has been lost — do not re-enter them.
        </p>
      )}
      {reviewRead.ok && reviews.length === 0 && <p style="font-size:12px;color:#8a8a94;margin:0 0 10px;">No reviews recorded yet.</p>}
      {reviews.map((r) => (
        <div style="border-top:1px solid #1a1a22;padding:8px 0;">
          <p style="font-size:12px;color:#e8e8ee;margin:0;">{r.note}</p>
          <p style="font-size:10.5px;color:#8a8a94;margin:3px 0 0;">{r.reviewer} · {r.date}{r.rating ? ' · ' + r.rating + '/5' : ''}</p>
        </div>
      ))}
      <form method="POST" style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
        <input type="hidden" name="_action" value="review" />
        <input name="note" placeholder="Add a review note" required style="flex:1;min-width:200px;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:8px;border-radius:6px;font-size:12.5px;" />
        <input name="rating" type="number" min="1" max="5" placeholder="1-5" style="width:70px;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:8px;border-radius:6px;font-size:12.5px;" />
        <button type="submit" style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;font-size:12.5px;padding:8px 14px;border-radius:6px;cursor:pointer;">Add</button>
      </form>
    </div>

    {/* The letter. Withheld entirely when the figures on it were not measured — see the banner
        above. A certificate is a claim, and printing one over a failed read is making a claim we
        cannot stand behind, which the header of this file says is the one thing it must not do. */}
    {!figuresTrustworthy ? (
      <div style={card}>
        <p style="font-size:13px;font-weight:600;margin:0 0 6px;">The completion letter is not shown.</p>
        <p style="font-size:12.5px;color:#8a8a94;margin:0;line-height:1.6;">
          It states credit-hours, attendance and achievements, and none of those could be read on this
          request. Reload the page; if it keeps failing, the reason is in the banner above and in the
          server log, and the letter will render the moment the figures can be measured again.
        </p>
      </div>
    ) : (
    <div style="border:1px solid #2a2a30;border-radius:12px;background:#fff;color:#111;padding:26px;" id="letter">
      <p style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:#a33;margin:0 0 14px;">Certificate of completion</p>
      <p style="font-size:15px;line-height:1.75;margin:0 0 12px;">
        This is to certify that <strong>{emp.full_name}</strong> served as
        <strong> {emp.designation}</strong> at EduRankAI from
        <strong> {String(emp.joining_date || '').slice(0, 10) || '—'}</strong> to
        <strong> {letterEndDate}</strong>.
      </p>
      <p style="font-size:15px;line-height:1.75;margin:0 0 12px;">
        Over this engagement they recorded <strong>{figures.creditHours} credit-hours</strong> of
        measured work at an attendance of <strong>{figures.attendancePct}%</strong>
        {terms.kind === 'part-time' ? ' on an agreed part-time load of ' + contractedWeekly + ' hours per week' : ''}.
        {figures.reviewCount > 0 && figures.averageRating != null
          ? ` Across ${figures.reviewCount} recorded reviews their average rating was ${figures.averageRating} out of 5.`
          : ''}
      </p>

      {/* CREDITS, WITH THEIR PROVENANCE, AND THE PENDING ONES STATED SEPARATELY. Never one number.
          A completion letter that overstates credits to an accredited partner is the worst possible
          place for this to be wrong, so a week nobody has decided is named as undecided rather than
          rolled into the total or quietly dropped. */}
      {creditsPrintable ? (
        <p style="font-size:15px;line-height:1.75;margin:0 0 12px;">
          They completed <strong>{creditsLabel(creditsTotal)}</strong>, where one credit is one
          completed week: the hours that week required, measured from recorded check-in and check-out
          net of breaks, with the daily reports filed and the work due that week done. Approved leave
          and holidays reduced the hours required for the weeks they fell in.
          {creditPosition.approvedByPerson > 0
            ? ' ' + creditPosition.approvedByPerson + ' of those weeks were credited by a named person with a written reason, recorded against the week.'
            : ''}
          {creditPosition.pending > 0
            ? ' A further ' + creditPosition.pending + ' week(s) are waiting on a decision and are NOT included in that figure.'
            : ''}
          {unmeasurableWeeks.length > 0
            ? ' ' + unmeasurableWeeks.length + ' week(s) contain a day that was clocked in and never clocked out, so those hours are unknown rather than zero.'
            : ''}
        </p>
      ) : (
        <p style="font-size:15px;line-height:1.75;margin:0 0 12px;">
          {credit.applicable
            ? 'No weekly credit figure is stated: the weekly credit record could not be read for this engagement, and a count that was not measured will not be printed.'
            : 'No weekly credit figure is stated. ' + (credit.notApplicableReason || '')}
        </p>
      )}
      {figures.achievements.length > 0 && (
        <>
          <p style="font-size:13px;font-weight:700;margin:16px 0 6px;">Key achievements</p>
          <ul style="margin:0 0 12px;padding-left:18px;">
            {figures.achievements.map((a) => <li style="font-size:14px;line-height:1.6;">{a}</li>)}
          </ul>
        </>
      )}
      <p style="font-size:12.5px;color:#555;line-height:1.6;margin:16px 0 0;border-top:1px solid #eee;padding-top:12px;">
        {figures.reason} Figures are computed from recorded attendance, approved leave and logged
        reviews. A day marked present with no hours recorded against it contributes nothing, because
        an attendance mark is not a measurement of time worked. One credit is one completed week.
        {' ' + CREDIT_SCOPE_SENTENCE}
      </p>
    </div>
    )}

    {figuresTrustworthy && (
      <div style="display:flex;gap:8px;margin-top:12px;">
        <button type="button" onclick="window.print()" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:13px;padding:10px 18px;border-radius:8px;cursor:pointer;">Print / save as PDF</button>
        <span style={`font-size:12px;padding:10px 0;color:${figures.eligible ? '#4ade80' : '#fbbf24'};`}>
          {figures.eligible ? 'Requirement met.' : 'Requirement not yet met — issuing is your call.'}
        </span>
      </div>
    )}
    <p style="font-size:11.5px;color:#8a8a94;margin:10px 0 0;">
      {figuresTrustworthy
        ? days.length + ' attendance day(s) counted. Nothing on the letter is typed by hand.'
        : 'No attendance day was counted, because the attendance ledger could not be read.'}
    </p>
  </div>
</AdminLayout>
