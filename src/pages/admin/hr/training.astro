---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ensureAquintutorAuthoringSchema } from '@/lib/aquintutor-authoring';
// OPENING THE CATALOGUE AND REWRITING IT ARE NOT THE SAME POWER. See the gate below.
import { canAccessSection } from '@/lib/auth/permissions';
// A PASTED LINK IS NOT A URL WE MAY RENDER UNTIL ONE PLACE SAYS SO. src/lib/video-embed.ts parses
// it, requires https, matches it against an allowlist of known shapes and BUILDS the player address
// itself; src/lib/lesson-video.ts stores both the pasted form and the derived one. Refusal happens
// here, at the point of entry, with a sentence - never silently, to fail later in front of a learner.
import { resolveVideoLink, describeVideoLink } from '@/lib/video-embed';
import { persistLessonVideo } from '@/lib/lesson-video';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// This page INSERTs training_modules.sort_order and ORDERs BY it, and nothing in the repository
// created that column — src/lib/aquintutor-authoring.ts creates the table with order_in_course
// instead. Both spellings are now added and kept in step there, but only for a process that has
// called the bootstrap, and this page never did. One call, and the module list works.
await ensureAquintutorAuthoringSchema();

// =================================================================================================
// THE WRITE GATE
// =================================================================================================
//
// Every handler below — create a course, publish it, DELETE it and all its content, add modules and
// lessons — was fronted by `user.role === 'applicant'` and nothing else. That is the exact test
// canAccessSection()'s docblock warns against: every internal role passes it. src/middleware.ts:67
// maps this path to the `training` section and getViewableSectionKeys() enforces VIEW there and only
// VIEW, so any account that could READ the training catalogue could publish a course to every
// employee or delete one outright. The same repair has already been made on /admin/hr/classification,
// /admin/hr/employees and /admin/hr/requisitions.
//
// NOBODY WHO WRITES TODAY LOSES ANYTHING: canAccessSection() grants every action but 'delete' when a
// user holds the section, so the accounts that administer training keep it. READING IS UNCHANGED —
// a viewer still opens the screen and still sees every course, module and enrolment, and is told in
// place why the controls are not theirs rather than being bounced.
//
// Declared ABOVE the POST handler that reads it; `const` is not hoisted.
const mayWrite = await canAccessSection(user, 'training', 'edit');

let okMsg = '', errorMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  try {
    if (!mayWrite) {
      errorMsg = 'You can read the training catalogue, but creating, publishing, deleting or adding '
        + 'to a course needs the training section with edit rights. Nothing was changed. Ask '
        + 'whoever administers roles for it.';
    } else
    if (action === 'create_course') {
      const title = (fd.get('title') as string || '').trim();
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '-' + Date.now();
      const desc = (fd.get('description') as string || '').trim();
      const shortDesc = (fd.get('short_desc') as string || '').trim();
      const category = fd.get('category') as string || 'general';
      const level = fd.get('level') as string || 'beginner';
      const hours = parseFloat(fd.get('duration_hours') as string || '0') || 0;
      const instructor = (fd.get('instructor_name') as string || '').trim() || null;
      const instructorTitle = (fd.get('instructor_title') as string || '').trim() || null;
      const accessType = fd.get('access_type') as string || 'employees';
      const isFree = fd.get('is_free') !== 'false';
      if (!title) { errorMsg = 'Title required.'; }
      else {
        await db.execute(sql`
          INSERT INTO training_courses (title, slug, description, short_desc, category, level, duration_hours, instructor_name, instructor_title, access_type, is_free, created_by)
          VALUES (${title}, ${slug}, ${desc||null}, ${shortDesc||null}, ${category}, ${level}, ${hours}, ${instructor}, ${instructorTitle}, ${accessType}, ${isFree}, ${user.id})
        `);
        okMsg = 'Course created. Add modules and lessons to it.';
      }
    } else if (action === 'toggle_publish') {
      // ONE STATEMENT, AND THE ANSWER COMES BACK FROM THE ROW THAT WAS WRITTEN.
      // This was SELECT is_published, then UPDATE ... = ${!pub}. Two faults in five lines:
      //   1. Read-modify-write with nothing guarding it. Two people (or one double-click) both read
      //      the same value and both wrote its negation, so the second click undid the first and the
      //      course ended up in whichever state neither of them chose.
      //   2. When the id matched NOTHING, `pub` was undefined, `!pub` was true, and the page said
      //      "Course published." A deleted or mistyped course reported a publish that never happened.
      // NOT is computed inside the UPDATE against the row's own current value, and RETURNING says
      // what the row is now — so the message is read off the write instead of guessed before it.
      const id = fd.get('id') as string;
      const upd = await db.execute(sql`
        UPDATE training_courses
           SET is_published = NOT COALESCE(is_published, false), updated_at = NOW()
         WHERE id = ${id}
        RETURNING is_published
      `);
      const updRows = Array.isArray(upd) ? upd : (upd?.rows || []);
      if (!updRows.length) errorMsg = 'That course is no longer on the register — nothing was changed.';
      else okMsg = (updRows[0] as any)?.is_published ? 'Course published.' : 'Course unpublished.';
    } else if (action === 'delete_course') {
      // RETURNING, so "Course deleted." is a report of a row that went, not of a statement that ran.
      const del = await db.execute(sql`DELETE FROM training_courses WHERE id = ${fd.get('id') as string} RETURNING id`);
      const delRows = Array.isArray(del) ? del : (del?.rows || []);
      okMsg = delRows.length ? 'Course deleted.' : '';
      if (!delRows.length) errorMsg = 'That course is no longer on the register — nothing was deleted.';
    } else if (action === 'add_module') {
      // THE NEXT POSITION IS COMPUTED INSIDE THE INSERT, AND FROM MAX, NOT COUNT.
      // It was SELECT COUNT(*) in one round trip and INSERT in the next. COUNT is not the next
      // position: delete the second of three modules and the count is 2, which is the sort_order the
      // third already holds — so the new module landed on top of an existing one and the list ordered
      // arbitrarily between them. Under two people adding at once the same collision happened without
      // any delete at all. MAX(sort_order)+1 in the INSERT itself is one statement and one read of
      // the table, so nothing can move between the two.
      const courseId = fd.get('course_id') as string;
      const title = (fd.get('title') as string || '').trim();
      if (!title) { errorMsg = 'A module needs a title.'; }
      else {
        await db.execute(sql`
          INSERT INTO training_modules (course_id, title, sort_order)
          SELECT ${courseId}, ${title}, COALESCE(MAX(sort_order), -1) + 1
            FROM training_modules WHERE course_id = ${courseId}
        `);
        okMsg = 'Module added.';
      }
    } else if (action === 'add_lesson') {
      const courseId = fd.get('course_id') as string;
      const moduleId = fd.get('module_id') as string || null;
      const title = (fd.get('title') as string || '').trim();
      const type = fd.get('type') as string || 'video';
      const content = (fd.get('content') as string || '').trim() || null;
      const rawVideo = (fd.get('video_url') as string || '').trim();
      // The author ticked "this one opens elsewhere". That does not relax the checks - https, a real
      // public host and no embedded credentials are still required - it only means we will not frame it.
      const opensElsewhere = fd.get('video_opens_elsewhere') === 'on';
      const durationMins = parseInt(fd.get('duration_mins') as string || '0') || 0;
      const isPreview = fd.get('is_preview') === 'on';

      // RESOLVED BEFORE ANYTHING IS WRITTEN. A link we cannot play is refused here with the reason,
      // rather than stored to render as an empty black rectangle - or worse, as an arbitrary origin
      // in an iframe - on a page every enrolled learner opens.
      const link = rawVideo ? resolveVideoLink(rawVideo, { allowLinkOut: opensElsewhere }) : null;

      if (!title) { errorMsg = 'A lesson needs a title.'; }
      else if (link && !link.ok) {
        errorMsg = 'That video link was not saved. ' + link.reason
          + (link.canLinkOut ? ' If it is meant to open in a new tab rather than play here, tick "opens elsewhere" and save again.' : '');
      }
      else {
        // Same COUNT-is-not-the-next-position fault as add_module above, and the same fix: MAX+1
        // computed inside the INSERT.
        const ins = await db.execute(sql`
          INSERT INTO training_lessons (course_id, module_id, title, type, content, video_url, duration_mins, is_preview, sort_order)
          SELECT ${courseId}, ${moduleId}, ${title}, ${type}, ${content}, ${link ? link.originalUrl : null}, ${durationMins}, ${isPreview},
                 COALESCE(MAX(sort_order), -1) + 1
            FROM training_lessons WHERE course_id = ${courseId}
          RETURNING id
        `);
        const insertedId = (Array.isArray(ins) ? ins : ((ins as any)?.rows || []))[0]?.id;
        // The stored lesson count is recomputed from the lessons themselves rather than incremented,
        // so a missed run corrects itself on the next add instead of drifting forever.
        await db.execute(sql`UPDATE training_courses SET total_lessons = (SELECT COUNT(*) FROM training_lessons WHERE course_id = ${courseId}) WHERE id = ${courseId}`);

        // Both forms are stored: the address as pasted, and the player address we derived from it.
        // If the derived half cannot be written the lesson still exists and the author is told so -
        // a half-written row is never reported as a whole one.
        let note = '';
        if (insertedId && link && link.ok) {
          const p = await persistLessonVideo(String(insertedId), link);
          note = p.note;
        }
        okMsg = 'Lesson added.'
          + (link && link.ok ? ' ' + describeVideoLink(link) : '')
          + (note ? ' ' + note : '');
      }
    }
  // e.message on a Postgres error is only the statement that failed; the reason is on e.cause. An
  // author who saw the SQL echoed back could not tell a duplicate slug from a missing column.
  } catch(e: any) {
    console.error('[admin/hr/training] POST', e?.cause?.message || e?.message);
    errorMsg = String(e?.cause?.message || e?.message || 'The change could not be saved.').slice(0, 300);
  }
}

const url = new URL(Astro.request.url);
const selectedId = url.searchParams.get('course') || '';

// AN EMPTY CATALOGUE AND A CATALOGUE THAT COULD NOT BE READ LOOK IDENTICAL, AND THEY ARE NOT.
// Both of these were `catch(e) {}`. On a database missing training_courses — or during any transient
// pooler failure — this page rendered "No courses yet. Create your first course." An author would
// then have created a duplicate of a course that already existed, believing the catalogue was bare.
// The reason is captured and shown; nothing is guessed.
let courses: any[] = [];
let coursesReadError = '';
try {
  const r = await db.execute(sql`
    SELECT c.*,
      (SELECT COUNT(*)::int FROM training_enrollments WHERE course_id = c.id) as enrollments
    FROM training_courses c ORDER BY c.created_at DESC
  `);
  courses = Array.isArray(r) ? r : (r?.rows || []);
} catch(e: any) {
  coursesReadError = String(e?.cause?.message || e?.message || 'unknown error').slice(0, 200);
  console.error('[admin/hr/training] courses read', coursesReadError);
}

const selectedCourse = courses.find((c: any) => c.id === selectedId);

let modules: any[] = [];
let lessons: any[] = [];
let structureReadError = '';
if (selectedId) {
  try {
    const r = await db.execute(sql`SELECT * FROM training_modules WHERE course_id = ${selectedId} ORDER BY sort_order`);
    modules = Array.isArray(r) ? r : (r?.rows || []);
    const r2 = await db.execute(sql`SELECT * FROM training_lessons WHERE course_id = ${selectedId} ORDER BY sort_order`);
    lessons = Array.isArray(r2) ? r2 : (r2?.rows || []);
  } catch(e: any) {
    structureReadError = String(e?.cause?.message || e?.message || 'unknown error').slice(0, 200);
    console.error('[admin/hr/training] structure read', structureReadError);
  }
}

// =================================================================================================
// THE ENROLMENTS TAB WAS A TAB, A PANEL, AND A SENTENCE THAT DESCRIBED SOMETHING THAT DID NOT EXIST
// =================================================================================================
//
// The panel read: "Enrollment data loads here. N enrolled." Nothing loaded it. There was no query,
// no fetch, and no script — the tab could only ever print that sentence, and the count beside it
// came from a subquery on the course card, so the number was real and everything the tab promised
// to show about it was not. An author looking for who is on a course found a control that answered
// nothing and had no way to tell it apart from one that was merely slow.
//
// Read here, with the rest of the page's reads, rather than fetched: the tab is server-rendered and
// hidden with CSS, so there is no request to make and no state to lose.
//
// LEFT JOIN on users, because training_enrollments.user_id points at users and a learner whose
// account was removed must still be COUNTED — an INNER JOIN would silently shorten the list and
// disagree with the enrolment figure on the card above it.
let enrolments: any[] = [];
let enrolmentsReadError = '';
if (selectedId) {
  try {
    const r = await db.execute(sql`
      SELECT e.id, e.created_at, e.progress_pct, e.completed_at,
             u.name AS user_name, u.email AS user_email
        FROM training_enrollments e
        LEFT JOIN users u ON u.id = e.user_id
       WHERE e.course_id = ${selectedId}
       ORDER BY e.created_at DESC
       LIMIT 200`);
    enrolments = Array.isArray(r) ? r : (r?.rows || []);
  } catch(e: any) {
    enrolmentsReadError = String(e?.cause?.message || e?.message || 'unknown error').slice(0, 200);
    console.error('[admin/hr/training] enrolments read', enrolmentsReadError);
  }
}

/** Dates on this page are read by people in IST; the server is UTC. */
const fmtWhen = (v: any) => {
  if (!v) return '';
  const d = new Date(v);
  return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' });
};

const CATEGORY_COLORS: Record<string,string> = {
  technology:'#60a5fa', business:'#fbbf24', design:'#a78bfa',
  leadership:'#f97316', communication:'#34d399', compliance:'#ef4444',
  hr:'#10b981', general:'#6e6e78'
};
const LEVEL_COLOR: Record<string,string> = { beginner:'#10b981', intermediate:'#fbbf24', advanced:'#ef4444' };
---
<AdminLayout title="Training & Certifications" activeNav="hr">
<style>
  .course-card { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 14px; overflow: hidden; transition: border-color 0.15s; }
  .course-card:hover { border-color: #2a2a2f; }
  .lesson-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid #0a0a0c; }
  .lesson-type-icon { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .tab-btn { font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 6px; border: none; cursor: pointer; }
  .tab-btn.active { background: #FF4F00; color: #fff; }
  .tab-btn:not(.active) { background: #15151a; color: #8a8a94; }
</style>
<div style="padding-bottom:100px;">

  <!-- Header -->
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HR Management</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Training & Certifications</h1>
      </div>
      <div style="display:flex;gap:6px;">
        <a href="/admin/hr" style="background:#15151a;border:1px solid #1a1a1f;color:#8a8a94;text-decoration:none;font-size:11px;padding:6px 10px;border-radius:6px;">HR Home</a>
        {mayWrite && <button onclick="document.getElementById('newCourseModal').style.display='flex'" style="background:#FF4F00;border:none;color:#fff;font-size:11px;font-weight:600;padding:6px 12px;border-radius:6px;cursor:pointer;">+ New Course</button>}
      </div>
    </div>
    <p style="font-size:11px;color:#8a8a94;margin:0;">{courses.length} courses - {courses.filter((c:any)=>c.is_published).length} published</p>
  </div>

  {errorMsg && <div style="margin:10px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {okMsg && <div style="margin:10px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}

  {!mayWrite && (
    <div style="margin:10px 16px;background:#0f0f14;border:1px solid #2a2a2f;color:#8a8a94;border-radius:8px;padding:10px 14px;font-size:12.5px;line-height:1.6;">
      You are reading the training catalogue. Creating a course, publishing or deleting one, and
      adding modules or lessons need edit access to the training section — those controls are hidden
      rather than shown and then refused.
    </div>
  )}

  {!selectedId && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:10px;">
      {courses.length === 0 && (
        <div style="text-align:center;padding:56px 24px;background:#0f0f14;border:1px dashed #1a1a1f;border-radius:14px;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6e6e78" stroke-width="1.5" style="margin-bottom:14px;"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <p style="font-size:15px;font-weight:700;color:#fff;margin-bottom:6px;">No courses yet</p>
          <p style="font-size:12px;color:#8a8a94;margin-bottom:20px;">Build your training library. Employees and applicants can enroll and earn certificates.</p>
          {mayWrite && <button onclick="document.getElementById('newCourseModal').style.display='flex'" style="background:#FF4F00;border:none;color:#fff;font-size:13px;font-weight:600;padding:10px 20px;border-radius:8px;cursor:pointer;">Create First Course</button>}
        </div>
      )}
      {courses.map((c: any) => {
        const catColor = (CATEGORY_COLORS as any)[c.category] || '#6e6e78';
        const lvlColor = LEVEL_COLOR[c.level] || '#6e6e78';
        return (
          <div class="course-card">
            <!-- Course header with visual -->
            <div style={`background:linear-gradient(135deg,${catColor}15 0%,transparent 100%);border-bottom:1px solid #1a1a1f;padding:16px;display:flex;gap:14px;`}>
              <div style={`width:56px;height:56px;border-radius:12px;background:${catColor}22;border:1px solid ${catColor}33;display:flex;align-items:center;justify-content:center;flex-shrink:0;`}>
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={catColor} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              </div>
              <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px;">
                  <p style="font-size:14px;font-weight:700;color:#fff;margin:0;line-height:1.3;">{c.title}</p>
                  <span style={`font-size:9px;font-weight:700;padding:2px 8px;border-radius:100px;flex-shrink:0;${c.is_published?'background:rgba(16,185,129,0.15);color:#6ee7b7;':'background:#15151a;color:#8a8a94;'}`}>{c.is_published?'Published':'Draft'}</span>
                </div>
                {c.short_desc && <p style="font-size:11px;color:#8a8a94;margin:0 0 6px;line-height:1.4;">{c.short_desc}</p>}
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                  <span style={`font-size:9px;font-weight:600;padding:2px 7px;border-radius:100px;background:${catColor}22;color:${catColor};text-transform:capitalize;`}>{c.category}</span>
                  <span style={`font-size:9px;font-weight:600;padding:2px 7px;border-radius:100px;background:${lvlColor}22;color:${lvlColor};text-transform:capitalize;`}>{c.level}</span>
                  <span style="font-size:9px;color:#8a8a94;">{c.duration_hours}h</span>
                  <span style="font-size:9px;color:#8a8a94;">{c.total_lessons} lessons</span>
                  <span style="font-size:9px;color:#8a8a94;">{c.enrollments} enrolled</span>
                </div>
              </div>
            </div>
            <!-- Access & stats -->
            <div style="padding:10px 16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
              <div style="display:flex;align-items:center;gap:6px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6e6e78" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span style="font-size:10px;color:#8a8a94;text-transform:capitalize;">{c.access_type === 'both' ? 'Employees + Applicants' : c.access_type}</span>
              </div>
              <div style="display:flex;gap:5px;">
                <a href={`?course=${c.id}`} style="background:#15151a;border:1px solid #1a1a1f;color:#FF7040;text-decoration:none;font-size:11px;font-weight:600;padding:5px 10px;border-radius:6px;">Manage</a>
                {mayWrite && (
                <form method="POST" style="display:contents;">
                  <input type="hidden" name="action" value="toggle_publish" /><input type="hidden" name="id" value={c.id} />
                  <button type="submit" style={`font-size:11px;padding:5px 10px;border-radius:6px;border:none;cursor:pointer;${c.is_published?'background:rgba(251,191,36,0.1);color:#fbbf24;':'background:rgba(16,185,129,0.1);color:#6ee7b7;'}`}>{c.is_published?'Unpublish':'Publish'}</button>
                </form>
                )}
                {mayWrite && (
                <form method="POST" style="display:contents;" data-danger="Delete this course and all its content?">
                  <input type="hidden" name="action" value="delete_course" /><input type="hidden" name="id" value={c.id} />
                  <button type="submit" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#fca5a5;font-size:11px;padding:5px 8px;border-radius:6px;cursor:pointer;">Del</button>
                </form>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- Course detail / content management -->
  {selectedId && selectedCourse && (
    <div style="padding:12px 16px;">
      <a href="/admin/hr/training" style="font-size:11px;color:#8a8a94;text-decoration:none;display:flex;align-items:center;gap:4px;margin-bottom:12px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        All courses
      </a>

      <!-- Course info banner -->
      <div style="background:linear-gradient(135deg,rgba(255,79,0,0.1) 0%,transparent 100%);border:1px solid rgba(255,79,0,0.2);border-radius:12px;padding:14px;margin-bottom:14px;">
        <p style="font-size:15px;font-weight:700;color:#fff;margin:0 0 4px;">{selectedCourse.title}</p>
        <p style="font-size:11px;color:#8a8a94;margin:0 0 8px;">{selectedCourse.description}</p>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <span style="font-size:10px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:4px;">{selectedCourse.level}</span>
          <span style="font-size:10px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:4px;">{selectedCourse.duration_hours}h</span>
          <span style="font-size:10px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:4px;">{selectedCourse.total_lessons} lessons</span>
          <span style="font-size:10px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:4px;text-transform:capitalize;">{selectedCourse.access_type}</span>
          {/*
            "Preview" pointed at /courses/{slug}. There is no /courses/* route anywhere in
            src/pages — the learner-facing course page is /portal/courses/[slug] — so this link
            404'd on every course. It also only means anything once the course is published: the
            learner page selects `WHERE slug = ... AND is_published = true` and redirects away
            otherwise, which would have looked like a second broken link.
          */}
          {selectedCourse.is_published ? (
            <a href={`/portal/courses/${selectedCourse.slug}`} target="_blank" style="font-size:10px;background:rgba(96,165,250,0.15);color:#60a5fa;padding:2px 8px;border-radius:4px;text-decoration:none;">Preview</a>
          ) : (
            <span title="A draft course has no learner-facing page. Publish it to preview." style="font-size:10px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:4px;">Preview after publishing</span>
          )}
        </div>
      </div>

      <!-- Tabs -->
      <div style="display:flex;gap:6px;margin-bottom:14px;">
        <button class="tab-btn active" onclick="showTab('modules', this)">Modules & Lessons</button>
        {mayWrite && <button class="tab-btn" onclick="showTab('add-lesson', this)">Add Lesson</button>}
        <button class="tab-btn" onclick="showTab('enrollments', this)">Enrollments</button>
      </div>

      <!-- Modules tab -->
      <div id="tab-modules">
        <!-- Add module form -->
        {mayWrite && (
        <form method="POST" style="display:flex;gap:8px;margin-bottom:12px;">
          <input type="hidden" name="action" value="add_module" />
          <input type="hidden" name="course_id" value={selectedId} />
          <input name="title" placeholder="New module title..." required style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:9px 12px;color:#fff;font-size:13px;outline:none;" />
          <button type="submit" style="background:#FF4F00;border:none;color:#fff;font-size:12px;font-weight:600;padding:9px 14px;border-radius:8px;cursor:pointer;">+ Module</button>
        </form>
        )}

        {modules.length === 0 && lessons.length === 0 && (
          <div style="text-align:center;padding:32px;color:#8a8a94;background:#0f0f14;border:1px dashed #1a1a1f;border-radius:10px;">
            <p style="font-size:13px;">No modules or lessons yet. Add a module first, then add lessons to it.</p>
          </div>
        )}

        {modules.map((m: any) => {
          const moduleLessons = lessons.filter((l: any) => l.module_id === m.id);
          return (
            <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;overflow:hidden;margin-bottom:8px;">
              <div style="padding:10px 12px;background:#15151a;border-bottom:1px solid #1a1a1f;display:flex;align-items:center;gap:8px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF7040" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <p style="font-size:13px;font-weight:600;color:#fff;margin:0;flex:1;">{m.title}</p>
                <span style="font-size:10px;color:#8a8a94;">{moduleLessons.length} lessons</span>
              </div>
              {moduleLessons.map((l: any) => {
                const typeColors = { video:'#ef4444', text:'#60a5fa', quiz:'#a78bfa', pdf:'#f97316', link:'#10b981' };
                const tc = (typeColors as any)[l.type] || '#6e6e78';
                return (
                  <div class="lesson-row">
                    <div class="lesson-type-icon" style={`background:${tc}22;border:1px solid ${tc}33;`}>
                      {l.type === 'video' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={tc} stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>}
                      {l.type === 'text' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={tc} stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
                      {l.type === 'quiz' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={tc} stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>}
                      {(l.type === 'pdf' || l.type === 'link') && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={tc} stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>}
                    </div>
                    <div style="flex:1;min-width:0;">
                      <p style="font-size:12px;font-weight:500;color:#d8d8de;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{l.title}</p>
                      <p style="font-size:10px;color:#8a8a94;margin:1px 0 0;">{l.duration_mins}m {l.is_preview && '- Free preview'}</p>
                    </div>
                    <span style={`font-size:9px;font-weight:600;padding:1px 6px;border-radius:4px;background:${tc}22;color:${tc};text-transform:uppercase;`}>{l.type}</span>
                  </div>
                );
              })}
              {moduleLessons.length === 0 && <div style="padding:10px 12px;"><p style="font-size:11px;color:#8a8a94;margin:0;">No lessons yet in this module.</p></div>}
            </div>
          );
        })}

        <!-- Unmodules lessons -->
        {lessons.filter((l: any) => !l.module_id).length > 0 && (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;overflow:hidden;">
            <div style="padding:8px 12px;border-bottom:1px solid #1a1a1f;"><p style="font-size:11px;color:#8a8a94;margin:0;">Unassigned lessons</p></div>
            {lessons.filter((l: any) => !l.module_id).map((l: any) => (
              <div class="lesson-row">
                <p style="font-size:12px;color:#d8d8de;margin:0;">{l.title}</p>
                <span style="font-size:9px;color:#8a8a94;margin-left:auto;">{l.type}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {mayWrite && (
      <!-- Add lesson tab -->
      <div id="tab-add-lesson" style="display:none;">
        <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
          <input type="hidden" name="action" value="add_lesson" />
          <input type="hidden" name="course_id" value={selectedId} />
          <div>
            <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Lesson Title *</label>
            <input name="title" required placeholder="Introduction to the topic..." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div>
              <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Type</label>
              <select name="type" id="lessonType" onchange="toggleLessonFields()" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
                <option value="video">Video</option><option value="text">Text / Article</option>
                <option value="quiz">Quiz</option><option value="pdf">PDF</option><option value="link">External Link</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Module</label>
              <select name="module_id" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
                <option value="">No module</option>
                {modules.map((m: any) => <option value={m.id}>{m.title}</option>)}
              </select>
            </div>
          </div>
          <div id="videoField">
            <label for="lessonVideoUrl" style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Video link</label>
            <input id="lessonVideoUrl" name="video_url" type="url" inputmode="url" autocomplete="off" placeholder="Paste the address shown when the video is open" style="width:100%;min-height:44px;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
            <p style="font-size:11px;color:#8a8a94;margin:6px 0 0;line-height:1.5;">Nothing is uploaded. Paste the link and the lesson plays it from where it already lives.</p>
            <!-- The live check. It calls the same resolver the save handler uses, so what it says
                 here is what will happen on save. It never renders the pasted string - only the
                 sentence the server returned. -->
            <p id="lessonVideoCheck" role="status" aria-live="polite" style="display:none;font-size:12px;line-height:1.5;margin:8px 0 0;padding:8px 10px;border-radius:8px;"></p>
            <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;margin-top:8px;min-height:44px;">
              <input type="checkbox" name="video_opens_elsewhere" id="lessonVideoLinkOut" style="accent-color:#FF4F00;width:18px;height:18px;margin-top:12px;flex-shrink:0;" />
              <span style="font-size:12px;color:#d8d8de;line-height:1.5;padding-top:10px;">This one opens elsewhere &ndash; give learners a button to a new tab instead of playing it in the lesson.</span>
            </label>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Content / Description</label>
            <textarea name="content" rows="4" placeholder="Lesson content, transcript, notes, or link..." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;resize:vertical;"></textarea>
          </div>
          <div style="display:flex;gap:10px;align-items:center;">
            <div style="flex:1;">
              <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Duration (mins)</label>
              <input name="duration_mins" type="number" placeholder="15" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
            </div>
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin-top:16px;">
              <input type="checkbox" name="is_preview" style="accent-color:#FF4F00;width:16px;height:16px;" />
              <span style="font-size:12px;color:#d8d8de;">Free preview</span>
            </label>
          </div>
          <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;">Add Lesson</button>
        </form>
      </div>
      )}

      <!-- Enrollments tab. Server-rendered from the read above; see the comment on `enrolments`. -->
      <div id="tab-enrollments" style="display:none;">
        {enrolmentsReadError && (
          <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:12.5px;line-height:1.55;margin-bottom:10px;">
            <strong>The enrolments could not be read.</strong> Nobody is listed below for that reason,
            not because nobody is enrolled — the count on the course card comes from a different query
            and is still accurate.
            <span style="display:block;margin-top:5px;font-family:'Geist Mono',monospace;font-size:11px;color:#f5b1b1;">{enrolmentsReadError}</span>
          </div>
        )}
        {!enrolmentsReadError && enrolments.length === 0 && (
          <p style="font-size:12.5px;color:#8a8a94;text-align:center;padding:24px;line-height:1.6;">
            Nobody has enrolled on this course yet. Learners enrol themselves by opening it; there is
            no way to enrol somebody from here, and assigning required learning is a separate record
            kept on <a href="/admin/hr/performance/learning" style="color:#FF7040;">Assigned learning</a>.
          </p>
        )}
        {enrolments.length > 0 && (
          <div style="display:flex;flex-direction:column;gap:6px;">
            <p style="font-size:10px;color:#8a8a94;margin:0 0 4px;font-family:'Geist Mono',monospace;">
              {enrolments.length} shown{enrolments.length >= 200 ? ' (most recent 200)' : ''} of {selectedCourse.enrollments || 0} enrolled
            </p>
            {enrolments.map((en: any) => {
              // progress_pct arrives as a plain number or as a numeric string depending on the
              // column type; coerced once here rather than compared loosely in three places.
              const pct = Math.max(0, Math.min(100, Math.round(Number(en.progress_pct) || 0)));
              const done = !!en.completed_at;
              return (
                <div style="background:#15151a;border:1px solid #1a1a1f;border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                  <div style="flex:1;min-width:160px;">
                    <p style="font-size:12.5px;font-weight:600;color:#fff;margin:0;">{en.user_name || 'Account removed'}</p>
                    <p style="font-size:10.5px;color:#8a8a94;margin:2px 0 0;">{en.user_email || 'no address on file'}{en.created_at ? ' · enrolled ' + fmtWhen(en.created_at) : ''}</p>
                  </div>
                  <div style="width:120px;">
                    <div style="background:#0f0f14;border-radius:100px;height:4px;">
                      <div style={`background:${done ? '#10b981' : '#FF4F00'};height:100%;width:${pct}%;border-radius:100px;`}></div>
                    </div>
                    <p style="font-size:9.5px;color:#8a8a94;margin:3px 0 0;font-family:'Geist Mono',monospace;">{done ? 'Completed ' + fmtWhen(en.completed_at) : pct + '% complete'}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  )}

</div>

{mayWrite && (
<div>
<!-- New Course Modal -->
<div id="newCourseModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:200;align-items:flex-end;justify-content:center;overflow-y:auto;padding:16px;">
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px;width:100%;max-width:600px;margin:auto;padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <h2 style="font-size:15px;font-weight:700;color:#fff;margin:0;">New Course</h2>
      <button onclick="document.getElementById('newCourseModal').style.display='none'" style="background:#1a1a1f;border:none;color:#8a8a94;width:30px;height:30px;border-radius:6px;font-size:18px;cursor:pointer;">&times;</button>
    </div>
    <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="hidden" name="action" value="create_course" />
      <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Course Title *</label>
        <input name="title" required placeholder="Introduction to Data Science, Leadership Essentials..." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
      </div>
      <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Short Description</label>
        <input name="short_desc" placeholder="One-line summary shown in catalog..." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
      </div>
      <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Full Description</label>
        <textarea name="description" rows="3" placeholder="What students will learn and why it matters..." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;resize:vertical;"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Category</label>
          <select name="category" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:12px;outline:none;">
            <option value="technology">Technology</option><option value="business">Business</option>
            <option value="design">Design</option><option value="leadership">Leadership</option>
            <option value="communication">Communication</option><option value="compliance">Compliance</option>
            <option value="hr">HR</option><option value="general">General</option>
          </select>
        </div>
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Level</label>
          <select name="level" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:12px;outline:none;">
            <option value="beginner">Beginner</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option>
          </select>
        </div>
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Duration (hours)</label>
          <input name="duration_hours" type="number" step="0.5" placeholder="2.5" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Access</label>
          <select name="access_type" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:12px;outline:none;">
            <option value="employees">Employees only</option><option value="applicants">Applicants only</option>
            <option value="both">Employees + Applicants</option><option value="public">Public</option>
          </select>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Instructor Name</label>
          <input name="instructor_name" placeholder="Dr. Priya Sharma" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div><label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Instructor Title</label>
          <input name="instructor_title" placeholder="Senior Data Scientist" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
      </div>
      <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;">Create Course</button>
    </form>
  </div>
</div>
</div>
)}

<script is:inline>
function showTab(tab, btn) {
  ['modules','add-lesson','enrollments'].forEach(function(t) {
    var el = document.getElementById('tab-' + t);
    if (el) el.style.display = t === tab ? 'block' : 'none';
  });
  document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
}
function toggleLessonFields() {
  var type = document.getElementById('lessonType')?.value;
  var vf = document.getElementById('videoField');
  // A 'link' lesson carries an address too - hiding the field for it is why some link lessons were
  // saved with nothing to open.
  if (vf) vf.style.display = (type === 'video' || type === 'link') ? 'block' : 'none';
}

// LIVE CHECK ON THE VIDEO FIELD.
// Asks the server the same question the save handler will ask, and prints the server's sentence.
// It is advisory in the sense that it cannot let anything through - the save handler resolves the
// link again for itself and refuses independently - but it means an author learns the link is wrong
// while they are looking at it, not after a learner opens the lesson.
(function () {
  var input = document.getElementById('lessonVideoUrl');
  var out = document.getElementById('lessonVideoCheck');
  var linkOut = document.getElementById('lessonVideoLinkOut');
  if (!input || !out) return;
  var timer = null;
  var seq = 0;

  function paint(text, tone) {
    out.textContent = text;
    out.style.display = text ? 'block' : 'none';
    if (tone === 'ok') { out.style.background = 'rgba(16,185,129,0.12)'; out.style.border = '1px solid rgba(16,185,129,0.35)'; out.style.color = '#6ee7b7'; }
    else if (tone === 'bad') { out.style.background = 'rgba(239,68,68,0.10)'; out.style.border = '1px solid rgba(239,68,68,0.32)'; out.style.color = '#fca5a5'; }
    else { out.style.background = 'rgba(255,255,255,0.04)'; out.style.border = '1px solid #1a1a1f'; out.style.color = '#9a9aa4'; }
  }

  function check() {
    var value = (input.value || '').trim();
    if (!value) { paint('', ''); return; }
    var mine = ++seq;
    paint('Checking that link...', '');
    fetch('/api/admin/video-link/check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: value, allowLinkOut: !!(linkOut && linkOut.checked) })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (mine !== seq) return;
      if (!d || d.ok !== true) { paint('We could not check that link just now. You can still save - the link is checked again on the server before anything is stored.', ''); return; }
      // Same reasoning as the course form: a sharing precondition we cannot check is printed here,
      // where it can still be acted on, rather than discovered by the first person who cannot play it.
      var extra = '';
      if (d.recognised && d.warning) extra = ' — ' + d.warning;
      else if (d.recognised && d.mediaKind === 'audio') extra = ' — this is sound only; learners get an audio player, not a picture.';
      paint(d.message + extra, d.recognised ? 'ok' : 'bad');
    }).catch(function () {
      if (mine !== seq) return;
      // Honest about what a failed CHECK means: it is not a verdict on the link.
      paint('We could not check that link just now (no answer from the server). The link is checked again before it is stored.', '');
    });
  }

  input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(check, 450); });
  input.addEventListener('blur', function () { clearTimeout(timer); check(); });
  if (linkOut) linkOut.addEventListener('change', check);
})();
</script>
<script src="/admin-danger.js" defer></script>
<script is:inline>
  /* FAIL CLOSED. If /admin-danger.js did not load — cached 404, blocked request, parse error —
     every data-danger control above would submit on the FIRST click with no confirmation at all.
     These are delete and revoke buttons, so the safe direction when the guard is missing is a
     dialog, not nothing. This runs only in that case and adds no behaviour when the guard is
     present. */
  window.addEventListener('load', function () {
    if (window.installDanger) return;
    console.warn('[admin-danger] guard script did not load; falling back to confirm()');
    Array.prototype.forEach.call(document.querySelectorAll('[data-danger]'), function (el) {
      var q = el.getAttribute('data-danger');
      var form = el.tagName === 'FORM' ? el : el.form;
      if (form) form.addEventListener('submit', function (e) { if (!confirm(q)) e.preventDefault(); });
      else el.addEventListener('click', function (e) { if (!confirm(q)) e.preventDefault(); });
    });
  });
</script>
</AdminLayout>
