---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql as sqlExpr } from 'drizzle-orm';
import { ensureOnce } from '@/lib/ensure-once';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/hr/employees');

// Self-bootstrap offboarding columns (idempotent). Runs each load; UPDATE noop
// after the first time. Lets the Exit tab work without a manual migration.
try {
  await db.execute(sqlExpr`ALTER TABLE hr_employees
    ADD COLUMN IF NOT EXISTS exit_type VARCHAR(40),
    ADD COLUMN IF NOT EXISTS last_working_day DATE,
    ADD COLUMN IF NOT EXISTS notice_period_days INTEGER,
    ADD COLUMN IF NOT EXISTS notice_served_at TIMESTAMPTZ,
    ADD COLUMN IF NOT EXISTS offboarding_state JSONB DEFAULT '{}'::jsonb,
    ADD COLUMN IF NOT EXISTS relieving_letter_url TEXT`);
} catch (_) {}

// The reporting line. Its own statement, not another clause on the block above: if any one clause
// of a multi-clause ALTER fails the whole statement is rolled back, and this is the column the
// approval chain depends on. UUID, holding a USERS id (see the select below).
try {
  await db.execute(sqlExpr`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS reporting_manager_id UUID`);
} catch (_) {}

// The org column, and the other half of the same dependency: reporting_manager_id says who approves,
// department_id says which lists a person appears in at all.
//
// Its own statement, for the reason given above. VARCHAR(50) because departments.id is a varchar(50)
// SLUG (src/lib/db/schema.ts:80) — db/hr-schema.sql:54 declares this column
// `UUID REFERENCES departments(id)`, which describes a departments table that does not exist in that
// form (docs/KNOWN_GAPS.md). Compared and written as TEXT everywhere; never cast ::uuid.
// ADD COLUMN IF NOT EXISTS is a no-op wherever the column is already there, so the live type wins.
//
// Behind ensureOnce (src/lib/ensure-once.ts) because nothing on this request depends on it having
// just run: one DDL round-trip per server process instead of one per page load.
await ensureOnce('hr_employees_department_id_v1', async () => {
  await db.execute(sqlExpr`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS department_id VARCHAR(50)`);
});

// THE RECORD BEING EDITED, read BEFORE the POST handler because the handler validates against it:
// its own user id (the self-report and cycle tests below) and its stored values (the re-post
// exception). `const` is not hoisted — declared under the handler, the first line of that handler
// would throw on every submit.
//
// A failed read is kept apart from "no such row". Both render nothing, but only one of them means
// the validation below cannot be trusted, and that one has to refuse rather than guess.
let subject: any = null;
let subjectReadFailed = false;
try {
  const subjRes = await db.execute(sqlExpr`
    SELECT id, full_name, user_id, reporting_manager_id, department_id
      FROM hr_employees WHERE id = ${id} LIMIT 1`);
  const subjRows = (Array.isArray(subjRes) ? subjRes : ((subjRes as any)?.rows || [])) as any[];
  subject = subjRows[0] || null;
} catch (e: any) {
  subjectReadFailed = true;
  console.error('[hr-employee] subject read:', e?.cause?.message || e?.message);
}
const subjectUserId = subject?.user_id ? String(subject.user_id) : '';
const subjectName = subject?.full_name ? String(subject.full_name) : 'This employee';
const storedManagerId = subject?.reporting_manager_id ? String(subject.reporting_manager_id) : '';
const storedDepartmentId = (subject?.department_id === null || subject?.department_id === undefined)
  ? '' : String(subject.department_id).trim();

// The department register. Read before the POST handler for the same reason: the handler refuses a
// department that is not on it. `id::text` so the comparison is text on both sides — casting a slug
// like 'engineering' to ::uuid throws "invalid input syntax for type uuid".
//
// The fallback query exists because sort_order / is_visible belong to the schema.ts shape of this
// table; an environment carrying the other declared shape has neither, and a department picker that
// vanishes because of an ORDER BY is a worse outcome than an unsorted one.
let departmentOptions: any[] = [];
try {
  const deptRes = await db.execute(sqlExpr`
    SELECT id::text AS id, name, is_visible FROM departments ORDER BY sort_order ASC, name ASC LIMIT 300`);
  departmentOptions = (Array.isArray(deptRes) ? deptRes : ((deptRes as any)?.rows || [])) as any[];
} catch (e: any) {
  console.error('[hr-employee] department list:', e?.cause?.message || e?.message);
  try {
    const deptAlt = await db.execute(sqlExpr`SELECT id::text AS id, name FROM departments ORDER BY name ASC LIMIT 300`);
    departmentOptions = (Array.isArray(deptAlt) ? deptAlt : ((deptAlt as any)?.rows || [])) as any[];
  } catch (e2: any) {
    console.error('[hr-employee] department list fallback:', e2?.cause?.message || e2?.message);
    departmentOptions = [];
  }
}
const departmentIds = new Set(departmentOptions.map((d: any) => String(d.id)));
const departmentNames = new Map<string, string>(
  departmentOptions.map((d: any) => [String(d.id), String(d.name || d.id)] as [string, string])
);

// How far up a reporting line is worth walking. Twelve is far beyond any real chain here and still
// cheap: the walk only runs when a manager is actually being set, and stops the moment it reaches
// someone with no manager of their own.
const MANAGER_CHAIN_MAX_DEPTH = 12;

// Walk a reporting line UPWARDS from a users id.
//
// Each hop reads the employee row that OWNS that login — reporting_manager_id stores a USERS id, not
// an hr_employees id — and then follows that row's own manager. Bounded twice, and both bounds are
// load-bearing: the visited set means a loop already sitting in the data cannot spin this walk
// forever, and the depth cap means an unexpectedly long chain still terminates.
//
// `failed` is separate from an empty chain on purpose. A chain that ends because nobody is above
// that person is a proven answer; a chain that ends because the query threw is not, and the caller
// refuses on the second rather than treating a database hiccup as proof of no cycle.
async function walkManagerChain(startUserId: string) {
  const chain: Array<{ userId: string; name: string }> = [];
  const seen = new Set<string>();
  let cursor = String(startUserId || '');
  for (let depth = 0; depth < MANAGER_CHAIN_MAX_DEPTH; depth++) {
    if (!cursor) return { chain, looped: false, truncated: false, failed: false };
    if (seen.has(cursor)) return { chain, looped: true, truncated: false, failed: false };
    seen.add(cursor);
    let row: any = null;
    try {
      const r = await db.execute(sqlExpr`
        SELECT full_name, reporting_manager_id FROM hr_employees
         WHERE user_id = ${cursor}
         ORDER BY is_active DESC, created_at DESC
         LIMIT 1`);
      const rr = (Array.isArray(r) ? r : ((r as any)?.rows || [])) as any[];
      row = rr[0] || null;
    } catch (e: any) {
      console.error('[hr-employee] manager chain:', e?.cause?.message || e?.message);
      return { chain, looped: false, truncated: false, failed: true };
    }
    // That login has no employee row at all, so the line stops here — it cannot reach anyone else.
    if (!row) return { chain, looped: false, truncated: false, failed: false };
    chain.push({ userId: cursor, name: String(row.full_name || 'an unnamed record') });
    cursor = row.reporting_manager_id ? String(row.reporting_manager_id) : '';
  }
  // Out of depth. `truncated` only when there was still someone left to look at.
  return { chain, looped: false, truncated: !!cursor, failed: false };
}

// Who may be recorded as a reporting manager.
//
// reporting_manager_id holds a USERS id, NOT an hr_employees id — approverRole() in
// src/lib/hr-wallet.ts compares it to the signed-in user's id, so anything else stored here can
// never match and the manager silently cannot approve. Hence the filter on user_id IS NOT NULL:
// an employee with no login is structurally unable to approve anything, and offering them would
// record an approval chain that only looks connected.
//
// Declared BEFORE the POST handler because the handler validates the submitted value against it.
// `const` is not hoisted here.
//
// Excluded by USER id, not only by employee row id. `e.id <> id` alone is not enough: one person
// can hold more than one hr_employees row (a closed internship and a current contract — admin-
// access.ts reads up to five per person for exactly that reason), so their own login would still be
// offered through the second row. Set that and approverRole() in src/lib/hr-wallet.ts returns
// 'reporting_manager' for them on their own record — they approve their own leave and their own
// wallet withdrawals. Nobody is their own approver.
let managerOptions: any[] = [];
try {
  const mgrRes = await db.execute(sqlExpr`
    SELECT e.user_id, e.full_name, e.designation, e.employee_code,
           (e.user_id IS NULL) AS no_login
      FROM hr_employees e
     WHERE e.is_active = true
       AND e.id <> ${id}
       AND (e.user_id IS NULL OR e.user_id IS DISTINCT FROM (SELECT t.user_id FROM hr_employees t WHERE t.id = ${id}))
     ORDER BY e.full_name ASC
     LIMIT 500`);
  const mgrRows = (Array.isArray(mgrRes) ? mgrRes : ((mgrRes as any)?.rows || [])) as any[];
  // One option per LOGIN, not per employee row, for the same reason: the same name twice in a
  // select is a choice nobody can make correctly, and both entries write the same value anyway.
  const seenManagerUser = new Set<string>();
  managerOptions = mgrRows.filter((m: any) => {
    const uid = String(m.user_id || '');
    if (!uid || seenManagerUser.has(uid)) return false;
    seenManagerUser.add(uid);
    return true;
  });
} catch (_) { managerOptions = []; }
const managerUserIds = new Set(managerOptions.map((m: any) => String(m.user_id)));

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (action === 'update_personal') {
      const fullName = (fd.get('fullName') as string || '').trim();
      const phone = (fd.get('phone') as string || '').trim();
      const personalEmail = (fd.get('personalEmail') as string || '').trim();
      const dob = (fd.get('dob') as string || '').trim();
      const gender = (fd.get('gender') as string || '').trim();
      const nationality = (fd.get('nationality') as string || '').trim();
      const bloodGroup = (fd.get('bloodGroup') as string || '').trim();
      const emergencyName = (fd.get('emergencyName') as string || '').trim();
      const emergencyPhone = (fd.get('emergencyPhone') as string || '').trim();
      const emergencyRelation = (fd.get('emergencyRelation') as string || '').trim();
      const city = (fd.get('city') as string || '').trim();
      const state = (fd.get('state') as string || '').trim();
      const country = (fd.get('country') as string || '').trim();

      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          full_name = ${fullName}, phone = ${phone || null},
          personal_email = ${personalEmail || null},
          date_of_birth = ${dob || null}, gender = ${gender || null},
          nationality = ${nationality || null}, blood_group = ${bloodGroup || null},
          emergency_contact_name = ${emergencyName || null},
          emergency_contact_phone = ${emergencyPhone || null},
          emergency_contact_relation = ${emergencyRelation || null},
          city = ${city || null}, state = ${state || null}, country = ${country || null},
          updated_at = NOW()
        WHERE id = ${id}
      `);
      successMsg = 'Personal details updated.';
    } else if (action === 'update_employment') {
      const designation = (fd.get('designation') as string || '').trim();
      const employmentType = (fd.get('employmentType') as string || '').trim();
      const workMode = (fd.get('workMode') as string || '').trim();
      const joiningDate = (fd.get('joiningDate') as string || '').trim();
      const confirmationDate = (fd.get('confirmationDate') as string || '').trim();
      const probationEndDate = (fd.get('probationEndDate') as string || '').trim();
      const baseSalary = (fd.get('baseSalary') as string || '').trim();
      const currency = (fd.get('currency') as string || 'INR').trim();
      const panNumber = (fd.get('panNumber') as string || '').trim();
      const aadhaarNumber = (fd.get('aadhaarNumber') as string || '').trim();
      const reportingManagerId = (fd.get('reportingManagerId') as string || '').trim();
      const departmentIdInput = (fd.get('departmentId') as string || '').trim();

      // ---------------------------------------------------------------------------------------
      // ORG ASSIGNMENT, VALIDATED SERVER-SIDE.
      //
      // Every refusal below names the specific thing that was wrong. This one form also saves
      // designation, salary, PAN and four dates; "Could not save" would leave HR guessing which of
      // eleven fields it objected to, and the usual next move is to try the same thing again.
      //
      // Nothing is written unless every check passes — a partial save here would record an approval
      // authority while reporting a failure.
      // ---------------------------------------------------------------------------------------
      let refusal = '';

      // The record itself could not be read, so none of the tests below mean anything. Refusing is
      // the safe direction: writing approval authority that could not be checked is the outcome
      // that cannot be withdrawn afterwards.
      if (!refusal && subjectReadFailed) {
        refusal = 'This record could not be read just now, so the reporting line could not be checked. Nothing was saved. Reload the page and try again.';
      }

      // NOBODY IS THEIR OWN APPROVER. The select already excludes this person by USER id, so this
      // can only arrive by a posted value — which is exactly why it is tested here as well.
      if (!refusal && reportingManagerId && subjectUserId && reportingManagerId === subjectUserId) {
        refusal = subjectName + ' cannot be their own reporting manager. Approval is checked against the signed-in account, so this would let them approve their own leave and their own wallet withdrawals. Pick someone else, or choose "No reporting manager set".';
      }

      // Approval authority is being written here, so an id that did not come from the offered list
      // is refused outright rather than quietly dropped: a posted value could otherwise point at
      // any user in the system and hand them approval rights over this employee. The list is built
      // from ACTIVE employees with a linked user_id, which is the "must be an active employee with
      // a login" rule — an employee with no sign-in can never match the signed-in account and so
      // could never approve anything.
      //
      // With ONE exception, and it matters. The select deliberately still offers the manager already
      // on file when that person has since left or been deactivated — labelled, so the record never
      // reads as "nobody is set" — and that option is PRE-SELECTED. Refusing it would block every
      // other employment edit on this page (designation, salary, PAN, joining date) behind an error
      // about a manager the person editing never touched, and the only way out would be to change
      // the reporting line to make an unrelated correction. Re-posting the value already stored
      // grants nothing that is not already granted, so it is accepted; anything else is not.
      if (!refusal && reportingManagerId
          && !managerUserIds.has(reportingManagerId)
          && reportingManagerId !== storedManagerId) {
        refusal = 'That reporting manager is not an active employee with a linked sign-in. Nothing was saved — pick someone from the list.';
      }

      // NO CYCLES. A loop makes every approval chain infinite: a request escalating past this person
      // arrives back at them, and the "who approves this" question has no answer at any depth.
      // Skipped when this employee has no linked login, because reporting_manager_id stores a USERS
      // id — with none, no chain can pass through them and there is nothing to loop back to.
      if (!refusal && reportingManagerId && subjectUserId) {
        const walk = await walkManagerChain(reportingManagerId);
        const hitSelf = walk.chain.findIndex((s) => s.userId === subjectUserId);
        if (walk.failed) {
          refusal = 'The reporting line above that person could not be read, so this could not be checked for a loop. Nothing was saved — try again in a moment.';
        } else if (hitSelf >= 0) {
          const path = walk.chain.slice(0, hitSelf + 1).map((s) => s.name).join(' reports to ');
          refusal = 'That would make the reporting line circular: ' + path + '. ' + subjectName + ' would end up approving their own requests through the chain, and an approval that loops never reaches anybody. Pick a manager from outside ' + subjectName + "'s own reporting line.";
        } else if (walk.looped) {
          const path = walk.chain.map((s) => s.name).join(' reports to ');
          refusal = 'That person is already inside a reporting loop (' + path + '), so nothing above them can approve anything either. Nothing was saved — break that loop first, then set this.';
        } else if (walk.truncated) {
          refusal = 'The reporting line above that person runs more than ' + MANAGER_CHAIN_MAX_DEPTH + ' levels deep, so it could not be checked for a loop. Nothing was saved — shorten that chain first.';
        }
      }

      // DEPARTMENT. Deliberately optional (see the note beside the field), but a value that is not
      // on the register is refused rather than stored: a department id that matches nothing places
      // this person in no list at all while the record reads as assigned. Same re-post exception as
      // the manager above, so a record carrying a department that has since been removed does not
      // block every other edit on the page.
      if (!refusal && departmentIdInput
          && !departmentIds.has(departmentIdInput)
          && departmentIdInput !== storedDepartmentId) {
        refusal = 'That department is not on the department register. Nothing was saved — pick one from the list, or leave it unset.';
      }

      if (refusal) {
        errorMsg = refusal;
      } else {
        await db.execute(sqlExpr`
          UPDATE hr_employees SET
            designation = ${designation || null},
            department_id = ${departmentIdInput || null},
            employment_type = ${employmentType || null},
            work_mode = ${workMode || null},
            joining_date = ${joiningDate || null},
            confirmation_date = ${confirmationDate || null},
            probation_end_date = ${probationEndDate || null},
            base_salary = ${baseSalary ? parseFloat(baseSalary) : null},
            currency = ${currency},
            pan_number = ${panNumber || null},
            aadhaar_number = ${aadhaarNumber || null},
            reporting_manager_id = ${reportingManagerId || null},
            updated_at = NOW()
          WHERE id = ${id}
        `);
        // Say what is still missing rather than only what was saved. The two org fields are what
        // every department list and every approval chain is built from, and a plain "updated" on a
        // record that still has neither reads as finished.
        const gaps: string[] = [];
        if (!departmentIdInput) gaps.push('no department');
        if (!reportingManagerId) gaps.push('no reporting manager');
        successMsg = 'Employment details updated.'
          + (gaps.length ? ' Still ' + gaps.join(' and ') + ' on this record.' : '');
      }
    } else if (action === 'update_bank') {
      const bankAccountNumber = (fd.get('bankAccountNumber') as string || '').trim();
      const bankName = (fd.get('bankName') as string || '').trim();
      const bankIfsc = (fd.get('bankIfsc') as string || '').trim();
      const bankBranch = (fd.get('bankBranch') as string || '').trim();
      const uanNumber = (fd.get('uanNumber') as string || '').trim();
      const pfNumber = (fd.get('pfNumber') as string || '').trim();
      const esicNumber = (fd.get('esicNumber') as string || '').trim();

      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          bank_account_number = ${bankAccountNumber || null},
          bank_name = ${bankName || null},
          bank_ifsc = ${bankIfsc || null},
          bank_branch = ${bankBranch || null},
          uan_number = ${uanNumber || null},
          pf_number = ${pfNumber || null},
          esic_number = ${esicNumber || null},
          updated_at = NOW()
        WHERE id = ${id}
      `);
      successMsg = 'Banking & compliance details updated.';
    } else if (action === 'add_note') {
      const notes = (fd.get('notes') as string || '').trim();
      await db.execute(sqlExpr`UPDATE hr_employees SET notes = ${notes}, updated_at = NOW() WHERE id = ${id}`);
      successMsg = 'Notes saved.';
    } else if (action === 'initiate_exit') {
      const exitType = (fd.get('exitType') as string || 'resignation').trim();
      const noticeDays = parseInt((fd.get('noticePeriodDays') as string) || '0', 10) || 0;
      const lastWorkingDay = (fd.get('lastWorkingDay') as string || '').trim() || null;
      const exitReason = (fd.get('exitReason') as string || '').trim() || null;
      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          exit_type = ${exitType},
          notice_period_days = ${noticeDays || null},
          last_working_day = ${lastWorkingDay},
          exit_reason = ${exitReason},
          notice_served_at = COALESCE(notice_served_at, NOW()),
          employment_status = 'notice_period',
          offboarding_state = COALESCE(offboarding_state, '{}'::jsonb),
          updated_at = NOW()
        WHERE id = ${id}
      `);
      successMsg = 'Offboarding initiated. The employee is now on notice period.';
    } else if (action === 'update_exit_checklist') {
      const state = {
        exit_interview: fd.get('exit_interview') === 'on',
        dues_cleared: fd.get('dues_cleared') === 'on',
        assets_returned: fd.get('assets_returned') === 'on',
        access_revoked: fd.get('access_revoked') === 'on',
        relieving_letter_issued: fd.get('relieving_letter_issued') === 'on',
        knowledge_handover: fd.get('knowledge_handover') === 'on',
        final_payroll: fd.get('final_payroll') === 'on',
      };
      const relievingUrl = (fd.get('relievingLetterUrl') as string || '').trim() || null;
      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          offboarding_state = ${JSON.stringify(state)}::jsonb,
          relieving_letter_url = ${relievingUrl},
          updated_at = NOW()
        WHERE id = ${id}
      `);
      successMsg = 'Offboarding checklist updated.';
    } else if (action === 'mark_relieved') {
      // Final step: deactivate employee record + linked user account.
      const exitDate = (fd.get('exitDate') as string || '').trim() || null;
      const exitReason = (fd.get('exitReason') as string || '').trim() || null;
      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          is_active = false,
          employment_status = 'exited',
          exit_date = ${exitDate || sqlExpr`COALESCE(last_working_day, CURRENT_DATE)`},
          exit_reason = COALESCE(${exitReason}, exit_reason),
          updated_at = NOW()
        WHERE id = ${id}
      `);
      // If linked to a user account, deactivate the login + clear face enrol
      // so a future rehire forces re-enrolment.
      await db.execute(sqlExpr`
        UPDATE users SET is_active = false, updated_at = NOW()
        WHERE id = (SELECT user_id FROM hr_employees WHERE id = ${id})
      `);
      await db.execute(sqlExpr`
        UPDATE user_face_enrollments SET is_active = false
        WHERE user_id = (SELECT user_id FROM hr_employees WHERE id = ${id})
      `).catch(() => {});
      successMsg = 'Employee relieved. Login deactivated and access revoked.';
    } else if (action === 'cancel_exit') {
      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          employment_status = 'active',
          exit_type = NULL, notice_period_days = NULL, last_working_day = NULL,
          notice_served_at = NULL, exit_date = NULL, exit_reason = NULL,
          offboarding_state = '{}'::jsonb, relieving_letter_url = NULL,
          updated_at = NOW()
        WHERE id = ${id}
      `);
      successMsg = 'Exit cancelled - employee back to active status.';
    } else if (action === 'open_probation') {
      const { openProbation } = await import('@/lib/hr-lifecycle');
      const startDate = (fd.get('start_date') as string || '').trim();
      const durationMonths = parseInt((fd.get('duration_months') as string || '6'), 10);
      const noticeDays = parseInt((fd.get('notice_days') as string || '30'), 10);
      if (!startDate) { errorMsg = 'Start date is required.'; }
      else {
        const r = await openProbation({ employeeId: id, startDate, durationMonths, noticeDaysDuringProbation: noticeDays });
        successMsg = 'Probation opened. Auto-scheduled 30/60/90-day reviews. End: ' + r.scheduledEnd;
      }
    } else if (action === 'record_review') {
      const { recordReview } = await import('@/lib/hr-lifecycle');
      await recordReview({
        reviewId: fd.get('review_id') as string,
        rating: fd.get('rating') as any,
        summary: (fd.get('summary') as string || '').trim().slice(0, 4000),
        managerUserId: user.id,
      });
      successMsg = 'Review recorded.';
    } else if (action === 'confirm_employee') {
      const { confirmEmployee } = await import('@/lib/hr-lifecycle');
      await confirmEmployee({ probationId: fd.get('probation_id') as string, confirmedByUserId: user.id, letterUrl: (fd.get('letter_url') as string || '').trim() || undefined });
      successMsg = 'Employee confirmed. Written confirmation recorded.';
    } else if (action === 'extend_probation') {
      const { extendProbation } = await import('@/lib/hr-lifecycle');
      const r = await extendProbation({ probationId: fd.get('probation_id') as string, months: parseInt(fd.get('months') as string || '3', 10), reason: (fd.get('reason') as string || '').trim() });
      if (r.ok) successMsg = 'Probation extended to ' + r.newEnd;
      else errorMsg = r.error || 'Failed to extend.';
    } else if (action === 'set_goal') {
      const { setGoal } = await import('@/lib/hr-lifecycle');
      await setGoal({
        employeeId: id, kind: fd.get('kind') as any, title: (fd.get('title') as string || '').trim().slice(0, 300),
        description: (fd.get('description') as string || '').trim().slice(0, 4000),
        successMetric: (fd.get('success_metric') as string || '').trim().slice(0, 2000),
        targetDate: (fd.get('target_date') as string || '').trim() || undefined,
        weightPct: parseInt((fd.get('weight_pct') as string || '0'), 10) || undefined,
        setByUserId: user.id,
      });
      successMsg = 'Goal recorded and visible to employee.';
    } else if (action === 'close_goal') {
      const { closeGoal } = await import('@/lib/hr-lifecycle');
      await closeGoal(fd.get('goal_id') as string, fd.get('status') as any, (fd.get('notes') as string || '').trim().slice(0, 2000));
      successMsg = 'Goal closed.';
    } else if (action === 'open_pip') {
      const { openPip } = await import('@/lib/hr-lifecycle');
      const r = await openPip({
        employeeId: id, openedByUserId: user.id,
        managerUserId: (fd.get('manager_user_id') as string || '').trim() || undefined,
        durationWeeks: parseInt((fd.get('duration_weeks') as string || '2'), 10),
        reason: (fd.get('reason') as string || '').trim().slice(0, 4000),
        expectations: (fd.get('expectations') as string || '').trim().slice(0, 4000),
        consequences: (fd.get('consequences') as string || '').trim().slice(0, 2000) || undefined,
      });
      successMsg = 'PIP opened. Scheduled end: ' + r.scheduledEnd;
    } else if (action === 'log_pip_checkin') {
      const { logPipCheckin } = await import('@/lib/hr-lifecycle');
      await logPipCheckin({
        pipId: fd.get('pip_id') as string,
        weekNumber: parseInt(fd.get('week_number') as string, 10),
        progressSummary: (fd.get('progress_summary') as string || '').trim().slice(0, 4000),
        progressRating: fd.get('progress_rating') as any,
        managerUserId: user.id,
      });
      successMsg = 'Weekly check-in recorded.';
    } else if (action === 'close_pip') {
      const { closePip } = await import('@/lib/hr-lifecycle');
      await closePip({ pipId: fd.get('pip_id') as string, outcome: fd.get('outcome') as any, outcomeNotes: (fd.get('outcome_notes') as string || '').trim().slice(0, 4000) });
      successMsg = 'PIP closed.';
    } else if (action === 'raise_flag') {
      const { raiseFlag, BREACH_TYPES } = await import('@/lib/hr-flags');
      const breachType = (fd.get('breach_type') as string || '').trim() as keyof typeof BREACH_TYPES;
      const description = (fd.get('flag_description') as string || '').trim().slice(0, 4000);
      const actionTaken = (fd.get('flag_action_taken') as string || '').trim().slice(0, 2000) || undefined;
      if (!breachType || !BREACH_TYPES[breachType]) {
        errorMsg = 'Select a breach type from the list.';
      } else if (!description) {
        errorMsg = 'Description is required.';
      } else {
        const r = await raiseFlag({
          employeeId: id,
          breachType,
          description,
          actionTaken,
          flaggedByUserId: user.id,
          flaggedByName: user.name || user.email,
        });
        if (r.ok) {
          successMsg = 'Flag recorded.' + (r.autoEscalated ? ' Auto-escalated to Level 2 review (three-strike rule).' : '');
        } else {
          errorMsg = r.error || 'Could not raise flag.';
        }
      }
    } else if (action === 'reactivate') {
      await db.execute(sqlExpr`
        UPDATE hr_employees SET
          is_active = true, employment_status = 'active',
          exit_type = NULL, notice_period_days = NULL, last_working_day = NULL,
          notice_served_at = NULL, exit_date = NULL, exit_reason = NULL,
          offboarding_state = '{}'::jsonb, relieving_letter_url = NULL,
          updated_at = NOW()
        WHERE id = ${id}
      `);
      await db.execute(sqlExpr`
        UPDATE users SET is_active = true, updated_at = NOW()
        WHERE id = (SELECT user_id FROM hr_employees WHERE id = ${id})
      `);
      successMsg = 'Employee reactivated. Login restored.';
    }
  } catch (err: any) {
    // The real Postgres reason is on e.cause; err.message alone is just the failed SQL, which is
    // what made this page report an unreadable wall of statement text and nothing about the cause.
    const reason = err?.cause?.message || err?.message || 'Unknown';
    console.error('[hr-employee] ' + String(action || 'unknown action') + ':', reason);
    errorMsg = 'Error: ' + reason;
  }
}

const result = await db.execute(sqlExpr`SELECT * FROM hr_employees WHERE id = ${id} LIMIT 1`);
const _empRows = Array.isArray(result) ? result : (result?.rows || []);
if (_empRows.length === 0) return Astro.redirect('/admin/hr/employees');
const emp = _empRows[0] as any;

// The manager on file may since have left or been deactivated, in which case they are not in the
// options list above. Show them anyway, labelled — an empty select would read as "nobody is set"
// and HR would never know an approval chain had gone dead.
const currentManagerId = emp.reporting_manager_id ? String(emp.reporting_manager_id) : '';
let staleManagerLabel = '';
if (currentManagerId && !managerUserIds.has(currentManagerId)) {
  staleManagerLabel = 'Recorded manager is no longer an active employee';
  try {
    const smRes = await db.execute(sqlExpr`SELECT full_name, designation FROM hr_employees WHERE user_id = ${currentManagerId} LIMIT 1`);
    const smRows = (Array.isArray(smRes) ? smRes : ((smRes as any)?.rows || [])) as any[];
    const sm = smRows[0];
    if (sm?.full_name) {
      staleManagerLabel = sm.full_name + (sm.designation ? ' (' + sm.designation + ')' : '') + ' — no longer active';
    }
  } catch (_) {}
}

// Same treatment for the department on file: a stored id that is not on the register is shown as
// itself rather than silently falling back to "No department set", because those are different facts
// and only one of them is a data problem to chase.
const currentDepartmentId = (emp.department_id === null || emp.department_id === undefined)
  ? '' : String(emp.department_id).trim();
const currentDepartmentName = departmentNames.get(currentDepartmentId) || '';

// "Not on the register" and "the register could not be read" are kept apart, and the difference is
// not cosmetic. This form is a full-record save: whatever the select posts becomes the stored value,
// so a stored department with no matching <option> would be posted as empty and CLEARED — losing an
// assignment because a lookup query failed. The option below therefore always carries the current
// value, whatever the reason it is unrecognised; only the accusation that it is gone is withheld.
const departmentRegisterRead = departmentOptions.length > 0;
const currentDepartmentUnrecognised = !!currentDepartmentId && !departmentIds.has(currentDepartmentId);
const currentDepartmentOptionLabel = !currentDepartmentUnrecognised ? ''
  : departmentRegisterRead
    ? 'Recorded department "' + currentDepartmentId + '" is not on the register'
    : 'Recorded department "' + currentDepartmentId + '" — register unavailable, keeping it';
const staleDepartmentLabel = (currentDepartmentUnrecognised && departmentRegisterRead)
  ? 'Recorded department "' + currentDepartmentId + '" is not on the department register'
  : '';

// Leave balances, read from the table the leave workflow actually writes.
//
// Two leave schemas existed side by side: hr_leave_request (singular), which /admin/hr/leave and
// the employee portal read and write through src/lib/hr-leave.ts, and hr_leave_types /
// hr_leave_balances / hr_leave_requests (plural), which only ever had readers. This tab queried
// the plural set, so an employee's Leave tab was empty no matter how much leave they had taken.
const { getBalances, LEAVE_TYPES } = await import('@/lib/hr-leave');
const _balances = await getBalances(id).catch(() => [] as any[]);
const leaveBalanceRows = _balances.map((b: any) => ({
  name: b.name, code: b.id, is_paid: b.id !== 'unpaid',
  allocated: b.allowance, used: b.used, pending: b.pending, carried_forward: 0,
  unlimited: !(b.allowance > 0),
})) as any[];
const LEAVE_NAME: Record<string, string> = Object.fromEntries(LEAVE_TYPES.map((t: any) => [t.id, t.name]));

// Load conduct flags per Recruitment & Work Policy v2.0
const { listFlags, BREACH_TYPES } = await import('@/lib/hr-flags');
const flags = await listFlags(id);

// Load HR lifecycle state — probation, KRAs, PIPs (per HR Lifecycle Manual v1.0)
const { getActiveProbation, listProbationReviews, listGoals, listPips, listPipCheckins } = await import('@/lib/hr-lifecycle');
const activeProbation: any = await getActiveProbation(id);
const probationReviews = activeProbation ? await listProbationReviews(activeProbation.id) : [];
const goals = await listGoals(id);
const pips = await listPips(id);
const activePip = pips.find((p: any) => !p.closed_at);
const activePipCheckins = activePip ? await listPipCheckins(activePip.id) : [];
const l1count = flags.filter((f: any) => f.level === 1 && !f.is_escalation).length;
const l2count = flags.filter((f: any) => f.level === 2).length;
const l3count = flags.filter((f: any) => f.level === 3).length;
const BREACH_KEYS = Object.keys(BREACH_TYPES) as Array<keyof typeof BREACH_TYPES>;

// Fetch recent attendance
const attendance = await db.execute(sqlExpr`
  SELECT * FROM hr_attendance WHERE employee_id = ${id}
  ORDER BY date DESC LIMIT 10
`);
// `: attendanceRows` here referenced the variable inside its own initialiser — on any driver
// result that is not a plain array that throws a ReferenceError and takes the whole page down.
const attendanceRows = (Array.isArray(attendance) ? attendance : ((attendance as any)?.rows || [])) as any[];

// Recent leave requests — same singular table the leave workflow writes (see note above).
let leaveRequestRows: any[] = [];
try {
  const leaveRequests = await db.execute(sqlExpr`
    SELECT * FROM hr_leave_request WHERE employee_id = ${id}
    ORDER BY start_date DESC LIMIT 5
  `);
  leaveRequestRows = ((Array.isArray(leaveRequests) ? leaveRequests : (leaveRequests as any)?.rows || []) as any[])
    .map((lr: any) => ({ ...lr, leave_name: LEAVE_NAME[lr.leave_type] || lr.leave_type, code: lr.leave_type }));
} catch (e) { leaveRequestRows = []; }

// Fetch recent daily work reports
let dailyReportRows: any[] = [];
try {
  const dr = await db.execute(sqlExpr`SELECT * FROM hr_daily_reports WHERE employee_id = ${id} ORDER BY report_date DESC LIMIT 30`);
  dailyReportRows = (Array.isArray(dr) ? dr : (dr?.rows || [])) as any[];
} catch (e) {}

function formatDate(d: any) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' });
}

const tabs = ['Personal', 'Employment', 'Banking', 'Leave', 'Attendance', 'Notes', 'Reports', 'Exit'];

const offboardState = (emp.offboarding_state && typeof emp.offboarding_state === 'object') ? emp.offboarding_state as any : {};
const onNotice = emp.employment_status === 'notice_period';
const hasExited = !emp.is_active || emp.employment_status === 'exited';
