---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql as sqlExpr, eq, ilike, or, desc } from 'drizzle-orm';
import { pgTable, uuid, varchar, boolean, date, text, decimal, timestamp } from 'drizzle-orm/pg-core';
import { ensureOnce } from '@/lib/ensure-once';
// employee_code is TEXT NOT NULL UNIQUE. This page used to mint it from COUNT(*) + 1 — as did the
// auto-hire path — which reissues a number the moment any row is deleted and hands the same number
// to two people adding at once. One shared minter, deriving from MAX and retrying the INSERT on a
// unique violation, so the two paths cannot disagree about what the next code is.
import { withEmployeeCode } from '@/lib/hr/employee-code';
// "No employees found" and "the employee register could not be read" used to render as the same
// sentence over the same illustration — on the screen whose only other control ADDS a person.
// safeRows carries both facts; pageParam stops `?page=abc` and `?page=0` reaching OFFSET; clip and
// firstWord stop a null or 4,000-character name breaking a card; confirmAttr keeps the apostrophe.
import { safeRows, clip, firstWord, confirmAttr, pageParam } from '@/lib/page-safety';
// OPENING THE REGISTER AND REWRITING IT ARE NOT THE SAME POWER. See the gate below.
import { canAccessSection } from '@/lib/auth/permissions';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// =================================================================================================
// THE WRITE GATE. `role !== 'applicant'` IS NOT A GATE
// =================================================================================================
//
// This page ADDS a person to the register and ENDS an employee's every access, and the only test in
// front of both was that the caller is not an applicant. middleware.ts maps /admin/hr/employees to
// the `employees` section and enforces VIEW on it alone (getViewableSectionKeys), so a custom role
// granted read access to the register could add employees and deactivate any of them — the same
// fault already fixed on /admin/hr/performance.astro, on the screen that holds the people records.
//
// NOTHING IS TAKEN FROM ANYBODY WHO HAS IT TODAY. canAccessSection() returns true for every action
// but 'delete' when a BUILT-IN role holds the section (permissions.ts:1202-1205), so every hr and
// super_admin account writes exactly as before. Only a custom role deliberately configured as
// view-only is refused, which is the direction that configuration was chosen for.
//
// READING IS UNCHANGED, and the refusal is in place with a sentence rather than a redirect. The
// controls are hidden for a reader too, so nothing on screen offers a power the POST will refuse.
//
// `const` is not hoisted — declared above the POST handler that reads it.
const mayWrite = await canAccessSection(user, 'employees', 'edit');

// Runtime table definition (not in schema.ts yet)
const hrEmployees = pgTable('hr_employees', {
  id: uuid('id').primaryKey().defaultRandom(),
  employeeCode: varchar('employee_code', { length: 30 }),
  fullName: varchar('full_name', { length: 200 }).notNull(),
  email: varchar('email', { length: 200 }).notNull(),
  phone: varchar('phone', { length: 30 }),
  designation: varchar('designation', { length: 150 }),
  departmentId: text('department_id'),
  employmentType: varchar('employment_type', { length: 50 }),
  workMode: varchar('work_mode', { length: 30 }),
  employmentStatus: varchar('employment_status', { length: 30 }),
  joiningDate: date('joining_date'),
  baseSalary: decimal('base_salary', { precision: 12, scale: 2 }),
  currency: varchar('currency', { length: 10 }),
  isActive: boolean('is_active').default(true),
  createdAt: timestamp('created_at', { withTimezone: true }).defaultNow(),
  updatedAt: timestamp('updated_at', { withTimezone: true }).defaultNow(),
});

// Self-bootstrap the reporting line (idempotent). Repeated from the employee detail page because
// this list reads the column and has no other ensure step of its own — without it, a database
// predating the column would 500 the whole list instead of showing a blank manager.
// The catch was bare. A failed ALTER left the "Reports To" tile below reading "Not set. Nobody can
// approve their leave or withdrawals." for EVERY person on the register — a claim about real people,
// made because a column could not be added — with nothing in the log to say why. It still must not
// take the page down, so it is caught; it is no longer silent.
let reportingColumnOk = true;
try {
  await db.execute(sqlExpr`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS reporting_manager_id UUID`);
} catch (e: any) {
  reportingColumnOk = false;
  console.error('[hr-employees] reporting_manager_id ALTER -', e?.cause?.message || e?.message);
}

// Same for the department column, which the add form below now writes and the cards below now read.
// The ensureOnce key is shared with src/pages/admin/hr/employees/[id].astro on purpose: the DDL is
// identical and idempotent, so whichever page is opened first pays for it once per server process.
// VARCHAR(50) matches departments.id in src/lib/db/schema.ts:80, which is a SLUG — never ::uuid.
await ensureOnce('hr_employees_department_id_v1', async () => {
  await db.execute(sqlExpr`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS department_id VARCHAR(50)`);
});

// The department register, read BEFORE the POST handler because the handler validates the submitted
// department against it. `const` is not hoisted — below the handler, its first line would throw.
// `id::text` keeps the comparison text-on-text; the ids are slugs like 'engineering'.
//
// AND THE HANDLER MUST KNOW WHETHER THE REGISTER WAS READ. Both reads failing left
// departmentOptions empty, and the validation below then REFUSED every department as "not on the
// register" — a page that cannot read the register telling the operator their department does not
// exist. `departmentsOk` keeps "there are no departments" apart from "we could not ask".
let departmentOptions: any[] = [];
let departmentsOk = true;
let departmentsError: string | null = null;
{
  const primary = await safeRows('[hr-employees] department list', () => db.execute(sqlExpr`
    SELECT id::text AS id, name, is_visible FROM departments ORDER BY sort_order ASC, name ASC LIMIT 300`));
  if (primary.ok) {
    departmentOptions = primary.rows;
  } else {
    // is_visible / sort_order may not exist on an older departments table; the names still can.
    const fallback = await safeRows('[hr-employees] department list fallback', () => db.execute(
      sqlExpr`SELECT id::text AS id, name FROM departments ORDER BY name ASC LIMIT 300`));
    departmentOptions = fallback.rows;
    departmentsOk = fallback.ok;
    departmentsError = fallback.ok ? null : (fallback.error || primary.error);
  }
}
const departmentIds = new Set(departmentOptions.map((d: any) => String(d.id)));

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (!mayWrite) {
      errorMsg = 'You can read the employee register, but adding a person or changing whether they '
        + 'are active needs the employee-records section with edit rights. Nothing was changed. '
        + 'Ask whoever administers roles for it.';
    } else if (action === 'add') {
      const fullName = (fd.get('fullName') as string || '').trim();
      const email = (fd.get('email') as string || '').trim().toLowerCase();
      const phone = (fd.get('phone') as string || '').trim();
      const designation = (fd.get('designation') as string || '').trim();
      const employmentType = (fd.get('employmentType') as string || 'Full-Time').trim();
      const workMode = (fd.get('workMode') as string || 'Remote').trim();
      const joiningDate = (fd.get('joiningDate') as string || '').trim();
      const baseSalary = (fd.get('baseSalary') as string || '').trim();
      const currency = (fd.get('currency') as string || 'INR').trim();
      // Captured here so a hand-added record is not born contextless. Until this field existed,
      // department_id was written by exactly one code path — src/lib/hr/sync.ts, when an application
      // turns 'hired' — so everyone added by hand had it NULL permanently and could not appear in
      // any department-scoped list, with nothing on those lists to say they were missing.
      const departmentId = (fd.get('departmentId') as string || '').trim();

      if (!fullName || !email) {
        errorMsg = 'Full name and email are required.';
      } else if (departmentId && !departmentsOk) {
        // Refusing on the strength of a list that could not be read would be a claim this page is
        // not entitled to make. Say which it is, and do not write a department nobody verified.
        errorMsg = 'The department register could not be read, so the department you picked could not be checked and nothing was added. Try again in a moment, or add the person with no department and set it on their record.';
      } else if (departmentId && !departmentIds.has(departmentId)) {
        // Not merely dropped: a department id matching nothing puts the person in no list while the
        // record reads as assigned, which is harder to notice than an unassigned one.
        errorMsg = 'That department is not on the department register. Nothing was added — pick one from the list, or leave it unset.';
      } else {
        // The code is minted from the highest already issued, and the INSERT is retried if another
        // writer took that number between the read and the write.
        const code = await withEmployeeCode(async (candidate) => {
          await db.execute(sqlExpr`
            INSERT INTO hr_employees (employee_code, full_name, email, phone, designation, department_id, employment_type, work_mode, joining_date, base_salary, currency, employment_status)
            VALUES (${candidate}, ${fullName}, ${email}, ${phone || null}, ${designation || null}, ${departmentId || null}, ${employmentType}, ${workMode}, ${joiningDate || null}, ${baseSalary ? parseFloat(baseSalary) : null}, ${currency}, 'active')
          `);
          return candidate;
        });
        // The reporting manager is deliberately not on this form: it is a longer decision than an
        // add dialog should carry (the target must be an active employee with a sign-in, and the
        // chain has to be checked for loops), so it is set on the record itself. Say so, rather
        // than let a new record sit with no approver and no mention of it.
        successMsg = `Employee ${fullName} added. Code: ${code}.`
          + (departmentId ? '' : ' No department set, so they appear in no department list yet.')
          + ' Open the record to set a reporting manager — until one is set, nobody can approve their leave or withdrawals.';
      }
    } else if (action === 'deactivate') {
      // RETURNING, so "matched nothing" and "done" are different outcomes. Without it a stale id
      // from an open tab reported "Employee deactivated" while the person kept every access that
      // record grants — the reassuring blank this codebase has been bitten by before.
      const id = fd.get('id') as string;
      const r = await db.execute(sqlExpr`UPDATE hr_employees SET employment_status = 'inactive', is_active = false, updated_at = NOW() WHERE id = ${id} RETURNING employee_code`);
      const hit = (Array.isArray(r) ? r : ((r as any)?.rows || []))[0] as any;
      if (hit) successMsg = 'Employee deactivated (' + (hit.employee_code || id) + ').';
      else errorMsg = 'No employee matched that record, so nothing was changed. Reload the list and try again.';
    } else if (action === 'activate') {
      const id = fd.get('id') as string;
      const r = await db.execute(sqlExpr`UPDATE hr_employees SET employment_status = 'active', is_active = true, updated_at = NOW() WHERE id = ${id} RETURNING employee_code`);
      const hit = (Array.isArray(r) ? r : ((r as any)?.rows || []))[0] as any;
      if (hit) successMsg = 'Employee activated (' + (hit.employee_code || id) + ').';
      else errorMsg = 'No employee matched that record, so nothing was changed. Reload the list and try again.';
    }
  } catch (err: any) {
    // e.cause carries the real Postgres reason; err.message is only the failed SQL.
    const reason = err?.cause?.message || err?.message || 'Unknown';
    console.error('[hr-employees] ' + String(action || 'unknown action') + ':', reason);
    errorMsg = 'Error: ' + reason;
  }
}

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') || '';
const statusFilter = url.searchParams.get('status') || 'active';
const perPage = 20;

// THE PAGE NUMBER IS NOT WHATEVER THE URL SAYS.
//
// This was `parseInt(url.searchParams.get('page') || '1')` bound straight into OFFSET. `?page=abc`
// gives NaN and `?page=0` gives OFFSET -20; Postgres refuses both, so the whole employee register
// answered with a bare 500 on a URL anybody can type or a stale bookmark can hold. pageParam()
// always returns a positive integer, and clamps to the last real page once the count is known.
const countRes = await safeRows('[hr-employees] register count', () => db.execute(sqlExpr`
  SELECT COUNT(*) as n FROM hr_employees
  WHERE (${statusFilter === 'all'} OR employment_status = ${statusFilter})
  AND (${!q} OR full_name ILIKE ${'%' + q + '%'} OR email ILIKE ${'%' + q + '%'} OR employee_code ILIKE ${'%' + q + '%'} OR designation ILIKE ${'%' + q + '%'})
`));
const totalCount = countRes.ok ? parseInt(String((countRes.rows[0] as any)?.n ?? '0')) || 0 : 0;
// Math.ceil(0/20) is 0, and the pager rendered that as "1 / 0" on an empty database. A page count is
// never below one — there is always the page you are looking at, even when it holds nothing.
const totalPages = Math.max(1, Math.ceil(totalCount / perPage));
const page = pageParam(url.searchParams.get('page'), countRes.ok ? totalPages : undefined);
const offset = (page - 1) * perPage;
/** Kept so links preserve the search without corrupting it — a name with & or # broke every pager link. */
const pagerQs = (n: number) => '?q=' + encodeURIComponent(q) + '&status=' + encodeURIComponent(statusFilter) + '&page=' + n;

// The reporting manager comes back as a correlated scalar subquery, not a join: reporting_manager_id
// holds a USERS id, and a join on m.user_id would duplicate an employee card if two employee rows
// ever shared one login. A missing manager renders as "Not set" — which is the point of showing it.
//
// The department name is fetched the same way, and compared `::text` on BOTH sides. departments.id
// is a varchar(50) slug in src/lib/db/schema.ts:80 while db/hr-schema.sql:54 declares a UUID column
// against a UUID departments table that does not exist in that form; casting either side ::uuid
// throws "invalid input syntax for type uuid" on a value like 'engineering' and takes the whole
// list down. Text on both sides is correct under either shape.
const employeesRes = await safeRows('[hr-employees] register page', () => db.execute(sqlExpr`
  SELECT e.id, e.employee_code, e.full_name, e.email, e.phone, e.designation, e.employment_type, e.work_mode, e.employment_status, e.joining_date, e.base_salary, e.currency, e.is_active,
    e.reporting_manager_id,
    e.department_id,
    (SELECT d.name FROM departments d WHERE d.id::text = e.department_id::text LIMIT 1) AS department_name,
    (SELECT m.full_name FROM hr_employees m WHERE m.user_id = e.reporting_manager_id ORDER BY m.is_active DESC LIMIT 1) AS manager_name
  FROM hr_employees e
  WHERE (${statusFilter === 'all'} OR e.employment_status = ${statusFilter})
  AND (${!q} OR e.full_name ILIKE ${'%' + q + '%'} OR e.email ILIKE ${'%' + q + '%'} OR e.employee_code ILIKE ${'%' + q + '%'} OR e.designation ILIKE ${'%' + q + '%'})
  ORDER BY e.created_at DESC
  LIMIT ${perPage} OFFSET ${offset}
`));
const employeeRows = employeesRes.rows;

const statsRes = await safeRows('[hr-employees] header counts', () => db.execute(sqlExpr`
  SELECT
    COUNT(*) FILTER (WHERE employment_status = 'active') as active,
    COUNT(*) FILTER (WHERE employment_status = 'inactive') as inactive,
    COUNT(*) FILTER (WHERE joining_date >= NOW() - INTERVAL '30 days') as new_this_month,
    COUNT(*) as total
  FROM hr_employees
`));
const s = (statsRes.rows[0] || {}) as any;
/** A count that was not read is not a zero. The tiles print a dash rather than inventing one. */
const statValue = (v: any) => (statsRes.ok && v != null ? String(v) : '—');

// One banner naming every read that did not answer, so nothing blank below is mistaken for empty.
const readFailures: string[] = [];
if (!employeesRes.ok) readFailures.push('the employee register');
if (!countRes.ok) readFailures.push('how many employees match this filter');
if (!statsRes.ok) readFailures.push('the counts in the header');
if (!departmentsOk) readFailures.push('the department register');
const firstReadError = employeesRes.error || countRes.error || statsRes.error || departmentsError;
---
<AdminLayout title="Employees — HRMS" activeNav="hr">
<div class="admin-page" style="padding: 0 0 80px;">

  <!-- Mobile-first Header -->
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;line-height:1.2;">Employees</h1>
  <div style="margin-top:8px;display:flex;gap:6px;"><a href="/api/export/employees" class="era-btn era-btn-secondary era-btn-sm" download style="display:inline-flex;align-items:center;gap:5px;text-decoration:none;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Export CSV</a></div>

      </div>
      {mayWrite && (
      <button onclick="document.getElementById('addModal').style.display='flex'" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:13px;padding:8px 16px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:6px;flex-shrink:0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add
      </button>
      )}
    </div>

    <!-- Stats row -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px;">
      {[
        { label: 'Total', value: s.total, color: '#fff' },
        { label: 'Active', value: s.active, color: '#10b981' },
        { label: 'Inactive', value: s.inactive, color: '#ef4444' },
        { label: 'New (30d)', value: s.new_this_month, color: '#FF7040' },
      ].map(stat => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:8px;padding:8px;text-align:center;">
          <p style={`font-size:18px;font-weight:700;color:${stat.color};margin:0;line-height:1;`}>{statValue(stat.value)}</p>
          <p style="font-size:9px;color:#8a8a94;margin:2px 0 0;text-transform:uppercase;letter-spacing:0.08em;">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Search + Filter -->
    <form method="GET" style="display:flex;gap:8px;">
      <input type="text" name="q" value={q} placeholder="Search name, email, code..." style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 12px;color:#fff;font-size:13px;outline:none;min-width:0;" />
      <select name="status" onchange="this.form.submit()" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 10px;color:#fff;font-size:12px;outline:none;cursor:pointer;">
        <option value="active" selected={statusFilter === 'active'}>Active</option>
        <option value="inactive" selected={statusFilter === 'inactive'}>Inactive</option>
        <option value="all" selected={statusFilter === 'all'}>All</option>
      </select>
      <button type="submit" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 12px;color:#fff;font-size:13px;cursor:pointer;">Go</button>
    </form>
  </div>

  <!-- Messages -->
  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {successMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{successMsg}</div>}

  {/* WHAT COULD NOT BE READ, SAID BEFORE ANYTHING BLANK IS SHOWN. Every read on this page used to be
      a bare top-level await: on a database where hr_employees or departments has not been created —
      the state of every fresh deployment, and the state this page is most likely to be opened in
      first — the whole register answered with an unexplained 500. Failing soft alone would be worse:
      an empty list under "Add your first employee" invites a duplicate of somebody who is already
      on the register. */}
  {readFailures.length > 0 && (
    <div style="margin:12px 16px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:12.5px;line-height:1.6;">
      <strong style="color:#fecaca;">Part of this page could not be read, so what is blank below is unknown rather than empty.</strong>
      Not read: {readFailures.join('; ')}. Do not add somebody on the strength of an empty list here —
      they may already be on the register.
      {firstReadError && <span style="display:block;margin-top:6px;color:#f87171;font-family:'Geist Mono',monospace;font-size:11px;overflow-wrap:anywhere;">{clip(firstReadError, 300)}</span>}
    </div>
  )}

  <!-- Employee Cards (mobile-first) -->
  <div style="padding:12px 16px;display:flex;flex-direction:column;gap:8px;">
    {!employeesRes.ok && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:16px;color:#fca5a5;font-size:13px;line-height:1.65;">
        The employee register could not be read, so nobody is listed. This page is NOT saying the
        register is empty. Reload before adding anyone.
      </div>
    )}
    {employeesRes.ok && employeeRows.length === 0 && (
      <div style="text-align:center;padding:48px 16px;color:#8a8a94;">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;opacity:0.7;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p style="font-size:14px;font-weight:500;color:#a0a0ab;">{q || statusFilter !== 'all' ? 'No employee matches this search and filter' : 'No employees on the register'}</p>
        <p style="font-size:12px;margin-top:4px;">This list was read successfully and is genuinely empty.</p>
        {!q && <p style="font-size:12px;margin-top:4px;">Add your first employee to get started</p>}
      </div>
    )}
    {employeeRows.map((emp: any) => (
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
        <!-- Card header -->
        <div style="padding:12px 14px;display:flex;align-items:flex-start;gap:12px;">
          <div style={`width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,${emp.employment_status === 'active' ? '#FF4F00,#FF7040' : '#2a2a32,#1a1a1f'});display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;color:#fff;flex-shrink:0;`}>
            {/* `emp.full_name.substring(0,1)` throws on a NULL name and takes the whole register
                down with it — full_name is NOT NULL in db/hr-schema.sql but this page also renders
                rows written by importers and by hand. firstWord() answers for a null, a mononym and
                a script that does not space its words alike. */}
            {firstWord(emp.full_name, '?').substring(0, 1).toUpperCase()}
          </div>
          <div style="flex:1;min-width:0;">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
              {/* Clipped for the card, complete in the title attribute — a display cap, never a data
                  cap. A pasted 4,000-character "name" used to push the status chip off the card. */}
              <p style="font-size:14px;font-weight:600;color:#fff;margin:0;overflow-wrap:anywhere;" title={String(emp.full_name || '')}>{clip(emp.full_name || 'Unnamed employee', 70)}</p>
              <span style={`font-size:9px;font-weight:700;padding:2px 7px;border-radius:100px;text-transform:uppercase;letter-spacing:0.06em;${emp.employment_status === 'active' ? 'background:rgba(16,185,129,0.15);color:#6ee7b7;' : 'background:rgba(239,68,68,0.15);color:#fca5a5;'}`}>
                {emp.employment_status || 'status not recorded'}
              </span>
            </div>
            <p style="font-size:11px;color:#8a8a94;margin:2px 0 0;">{emp.designation || 'No designation'} · {emp.employment_type || 'Full-Time'}</p>
            <p style="font-size:11px;color:#8a8a94;margin:1px 0 0;font-family:'Geist Mono',monospace;">{emp.employee_code || 'no employee code'}</p>
          </div>
          <a href={`/admin/hr/employees/${emp.id}`} style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#1a1a1f;color:#8a8a94;text-decoration:none;flex-shrink:0;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <!-- Card details -->
        <div style="padding:0 14px 12px;display:grid;grid-template-columns:1fr 1fr;gap:6px;">
          <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Email</p>
            <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title={String(emp.email || '')}>{emp.email || 'no email on file'}</p>
          </div>
          <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Work Mode</p>
            <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;">{emp.work_mode || 'Remote'}</p>
          </div>
          <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Joining Date</p>
            <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;">{emp.joining_date ? new Date(emp.joining_date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata',day:'2-digit',month:'short',year:'numeric'}) : '—'}</p>
          </div>
          <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Salary</p>
            <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;">{emp.base_salary ? `${emp.currency || 'INR'} ${parseFloat(emp.base_salary).toLocaleString('en-IN')}` : 'Unpaid'}</p>
          </div>
          {/* Department, shown with the same weight as the reporting line because the two together
              are what every workspace and every team list is built from. Unset is called out rather
              than left blank: departmentFilter() in src/lib/auth/workspace-access.ts matches on this
              column, so a record without one is missing from every department-scoped screen and none
              of them says so. */}
          <div style={`border-radius:6px;padding:6px 8px;grid-column:1/-1;${emp.department_name ? 'background:#15151a;' : 'background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.22);'}`}>
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Department</p>
            {emp.department_name
              ? <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title={String(emp.department_name)}>{clip(emp.department_name, 60)}</p>
              : emp.department_id
                ? <p style="font-size:11px;color:#fbbf24;margin:2px 0 0;overflow-wrap:anywhere;">{departmentsOk ? 'Set to "' + clip(emp.department_id, 60) + '", which is not on the register' : 'Set to "' + clip(emp.department_id, 60) + '". The department register could not be read, so whether that is on it is unknown.'}</p>
                : <p style="font-size:11px;color:#fbbf24;margin:2px 0 0;">Not set. They appear in no department list.</p>}
          </div>
          {/* A missing reporting manager is not a cosmetic gap: approverRole() in src/lib/hr-wallet.ts
              lets the reporting manager approve this person's leave and wallet withdrawals, so an
              unset one means every request escalates to HR or an admin. Visible on the card so it
              cannot stay unnoticed. */}
          <div style={`border-radius:6px;padding:6px 8px;grid-column:1/-1;${emp.manager_name ? 'background:#15151a;' : 'background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.22);'}`}>
            <p style="font-size:9px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.08em;margin:0;">Reports To</p>
            {emp.manager_name
              ? <p style="font-size:11px;color:#d8d8de;margin:2px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title={String(emp.manager_name)}>{clip(emp.manager_name, 60)}</p>
              : emp.reporting_manager_id
                ? <p style="font-size:11px;color:#fbbf24;margin:2px 0 0;">Set, but that login is not on the employee register</p>
                : reportingColumnOk
                  ? <p style="font-size:11px;color:#fbbf24;margin:2px 0 0;">Not set. Nobody can approve their leave or withdrawals.</p>
                  : <p style="font-size:11px;color:#fca5a5;margin:2px 0 0;">Unknown — the reporting line column could not be provisioned, so this page cannot say whether one is set.</p>}
          </div>
        </div>
        <!-- Actions -->
        <div style="border-top:1px solid #1a1a1f;padding:8px 14px;display:flex;gap:8px;">
          <a href={`/admin/hr/employees/${emp.id}`} style="flex:1;text-align:center;background:#1a1a1f;color:#d8d8de;text-decoration:none;font-size:12px;font-weight:500;padding:7px;border-radius:6px;border:1px solid #2a2a32;">
            View Profile
          </a>
          {/* The completion letter is the only surface built on the credit-hours engine, and
              nothing anywhere linked to it -- so the credits an intern is measured on could be
              computed but never issued. Reachable from the person it concerns. */}
          <a href={`/admin/hr/completion/${emp.id}`} style="flex:1;text-align:center;background:#1a1a1f;color:#d8d8de;text-decoration:none;font-size:12px;font-weight:500;padding:7px;border-radius:6px;border:1px solid #2a2a32;">
            Completion
          </a>
          {/* DEACTIVATE HAD NO CONFIRMATION AT ALL, and it sits a thumb's width from "View Profile"
              on a phone. It ends every access the employee record grants, so the prompt names the
              person and the code — with the apostrophe INTACT: escaping it, not deleting it, is what
              lets somebody check they are ending the right person's access. */}
          {mayWrite && (
          <form method="POST" style="flex:1;" onsubmit={emp.employment_status === 'active' ? confirmAttr(
              'Deactivate ' + (emp.full_name || 'this employee') + ' (' + (emp.employee_code || 'no code') + ')? '
              + 'They stop counting as an active employee: no payroll run includes them, and nothing they have raised can be approved through their record.')
            : confirmAttr(
              'Reactivate ' + (emp.full_name || 'this employee') + ' (' + (emp.employee_code || 'no code') + ')? '
              + 'They count as active again and the next payroll run will include them.')}>
            <input type="hidden" name="action" value={emp.employment_status === 'active' ? 'deactivate' : 'activate'} />
            <input type="hidden" name="id" value={emp.id} />
            <button type="submit" style={`width:100%;font-size:12px;font-weight:500;padding:7px;border-radius:6px;border:none;cursor:pointer;${emp.employment_status === 'active' ? 'background:rgba(239,68,68,0.15);color:#fca5a5;' : 'background:rgba(16,185,129,0.15);color:#6ee7b7;'}`}>
              {emp.employment_status === 'active' ? 'Deactivate' : 'Activate'}
            </button>
          </form>
          )}
        </div>
      </div>
    ))}
  </div>

  {/* PAGINATION. The search term is encoded into the link: a name carrying & or # used to truncate
      the query and silently page through a DIFFERENT search than the one on screen. The count is
      only quoted when it was actually read — "1 / 0" on an empty database, and a confident total
      over a failed count, are the same lie in two shapes. Targets are 44px so a thumb lands on the
      link rather than between the two. */}
  {countRes.ok && totalPages > 1 && (
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;padding:16px;flex-wrap:wrap;">
      {page > 1 && <a href={pagerQs(page - 1)} style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;padding:0 16px;border-radius:8px;font-size:12px;min-height:44px;display:inline-flex;align-items:center;">Previous</a>}
      <span style="font-size:12px;color:#8a8a94;">Page {page} of {totalPages} · {totalCount} employee{totalCount === 1 ? '' : 's'} match</span>
      {page < totalPages && <a href={pagerQs(page + 1)} style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;padding:0 16px;border-radius:8px;font-size:12px;min-height:44px;display:inline-flex;align-items:center;">Next</a>}
    </div>
  )}
  {!countRes.ok && employeesRes.ok && employeeRows.length > 0 && (
    <p style="text-align:center;font-size:12px;color:#fbbf24;padding:12px 16px;line-height:1.6;">
      How many employees match could not be counted, so there is no page count and no Next link.
      What is listed above is page {page}; there may be more.
    </p>
  )}
</div>

<!-- Add Employee Modal. Rendered only for an account that may actually add somebody: a modal whose
     submit the handler above refuses is a control that lies about what it does. -->
{mayWrite && (
<div id="addModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:flex-end;justify-content:center;">
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px 16px 0 0;width:100%;max-width:600px;max-height:90vh;overflow-y:auto;padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <h2 style="font-size:16px;font-weight:700;color:#fff;margin:0;">Add Employee</h2>
      <button onclick="document.getElementById('addModal').style.display='none'" style="background:#1a1a1f;border:none;color:#8a8a94;width:30px;height:30px;border-radius:6px;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;">&times;</button>
    </div>
    <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="hidden" name="action" value="add" />
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div style="grid-column:1/-1;">
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Full Name *</label>
          <input type="text" name="fullName" required placeholder="Ravi Kumar" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div style="grid-column:1/-1;">
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Email *</label>
          <input type="email" name="email" required placeholder="ravi@edurankai.in" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Phone</label>
          <input type="tel" name="phone" placeholder="+91 98765 43210" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Designation</label>
          <input type="text" name="designation" placeholder="Software Engineer" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div style="grid-column:1/-1;">
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Department</label>
          <select name="departmentId" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
            <option value="" selected>No department set</option>
            {departmentOptions.map((d: any) => (
              <option value={String(d.id)}>{clip(d.name || d.id, 70)}{d.is_visible === false ? ' (not listed publicly)' : ''}</option>
            ))}
          </select>
          <p style="font-size:10.5px;color:#8a8a94;margin:5px 0 0;line-height:1.5;">
            Sets which team and department lists this person appears in. Optional for now, so existing records can still be added and corrected — but a record added without one is in no list until it is set on the record itself.
          </p>
          {/* "No departments could be read" was printed for BOTH an empty register and a failed
              read, and the two want opposite actions: create one, or wait and reload. */}
          {departmentOptions.length === 0 && departmentsOk && (
            <p style="font-size:10.5px;color:#fbbf24;margin:4px 0 0;line-height:1.5;">
              There are no departments on the register yet, so there is nothing to choose.
              {/* THE DESTINATION WAS NAMED IN PROSE AND NOT LINKED, on the single most-used day-one
                  form — and the screen it named rendered a blank table with no message of its own.
                  Both ends of that dead end are now closed. */}
              {' '}<a href="/admin/departments" style="color:#fbbf24;font-weight:700;text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;min-height:44px;">Create the first department</a>,
              then come back — everything in the organization attaches to one.
            </p>
          )}
          {!departmentsOk && (
            <p style="font-size:10.5px;color:#fca5a5;margin:4px 0 0;line-height:1.5;">
              The department register could not be read, so this list is not empty — it is unknown. Adding
              somebody with a department will be refused until it loads; adding them without one still works.
            </p>
          )}
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Employment Type</label>
          <select name="employmentType" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
            <option value="Full-Time">Full-Time</option>
            <option value="Part-Time">Part-Time</option>
            <option value="Contract">Contract</option>
            <option value="Internship">Internship</option>
            <option value="Freelance">Freelance</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Work Mode</label>
          <select name="workMode" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
            <option value="Remote">Remote</option>
            <option value="Hybrid">Hybrid</option>
            <option value="On-Site">On-Site</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Joining Date</label>
          <input type="date" name="joiningDate" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8a8a94;margin-bottom:5px;">Base Salary</label>
          <div style="display:flex;gap:6px;">
            <select name="currency" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 8px;color:#fff;font-size:12px;outline:none;width:80px;">
              <option value="INR">INR</option>
              <option value="USD">USD</option>
              <option value="GBP">GBP</option>
              <option value="EUR">EUR</option>
            </select>
            <input type="number" name="baseSalary" placeholder="0 = Unpaid" style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
          </div>
        </div>
      </div>
      <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;margin-top:4px;">
        Add Employee
      </button>
    </form>
  </div>
</div>
)}

</AdminLayout>
