---
// /admin/hr/classification — THE WORKER CLASSIFICATION REGISTER.
//
// =================================================================================================
// THE GATE. VIEWING THE REGISTER AND REWRITING IT ARE NOT THE SAME POWER
// =================================================================================================
//
// This page tested `user.role === 'applicant'` and nothing else, and then wrote hr_employees. That
// is not a gate: middleware.ts maps /admin/hr to the `hr` section and enforces VIEW on it only
// (getViewableSectionKeys), so every account that could READ this register could also rewrite the
// classification of any person on it — the exact fault already fixed on /admin/hr/performance.astro,
// on a page whose own lede calls misclassification "the single biggest compliance risk".
//
// Writes now ask `canAccessSection(user, 'hr', 'edit')`, which is the question /admin/hr/transfers
// already asks before it moves anybody. Nobody who administers HR loses anything: the same accounts
// that hold the section for editing today hold it here. READING IS UNCHANGED — a viewer still opens
// the screen and still sees every person, every classification and every review date. They are told
// in place why the controls are not theirs rather than being redirected, because a silent bounce is
// how somebody concludes the product is broken and asks for a wider role than they need.
//
// =================================================================================================
// WHAT IS WRITTEN IS WHAT THIS PAGE OFFERS, AND A NO-OP IS NOT A SUCCESS
// =================================================================================================
//
// The three posted values went into the UPDATE unchecked, so a hand-made POST could store any string
// at all as somebody's classification — and every count, every risk colour and the intern-signals
// vocabulary in src/lib/auth/intern-signals.ts read that column back. They are now matched against
// the same three lists the selects are built from, and an unrecognised one is refused by name.
//
// The UPDATE carried no RETURNING and the page printed "Classification updated." whatever happened,
// so a stale tab naming a person who has since been deactivated or removed reported a compliance
// review that was never recorded. It now says which of the two happened.
//
// `const` is not hoisted — every value the POST handler reads is declared above it.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { canAccessSection } from '@/lib/auth/permissions';
import { ensureClassificationSchema, CLASSIFICATIONS, ENGAGEMENT_VIAS, COUNTRY_CODES } from '@/lib/hr-classification';
// The joining pack that FOLLOWS from the classification recorded on this page. Pure data, no
// query: the panel at the foot of this page is read-only and exists so the exclusions can be
// read by the person most likely to undo one.
import { ENGAGEMENT_PACKS, engagementKeys, engagementLabelFor, engagementRiskFor, stepsForEngagement, documentsForEngagement, allPackProblems } from '@/lib/onboarding-packs';
import { ownerViaLabel } from '@/lib/onboarding-journey';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

await ensureClassificationSchema();
function rowsOf(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const mayWrite = await canAccessSection(user, 'hr', 'edit');
const CLASSIFICATION_KEYS = new Set(Object.keys(CLASSIFICATIONS));
const VIA_KEYS = new Set(Object.keys(ENGAGEMENT_VIAS));
const COUNTRY_KEYS = new Set(COUNTRY_CODES.map((c) => c.code));

let okMsg = '', errMsg = '';
if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    const id = String(fd.get('id') || '').trim();
    const classification = String(fd.get('classification') || '').trim();
    const country = String(fd.get('country') || '').trim();
    const via = String(fd.get('engaged_via') || '').trim();

    if (!mayWrite) {
      errMsg = 'You can read the classification register, but recording a review needs the HR '
        + 'section with edit rights. Nothing was changed. Ask whoever administers roles for it.';
    } else if (!id) {
      errMsg = 'No person was named, so nothing was changed.';
    } else if (!CLASSIFICATION_KEYS.has(classification)) {
      errMsg = 'That is not a classification this register recognises, so nothing was changed.';
    } else if (!COUNTRY_KEYS.has(country)) {
      errMsg = 'That is not a country on the list, so nothing was changed.';
    } else if (via && !VIA_KEYS.has(via)) {
      errMsg = 'That is not an engagement route this register recognises, so nothing was changed.';
    } else {
      const wrote = rowsOf(await db.execute(sql`
        UPDATE hr_employees
           SET classification = ${classification}, country_of_work = ${country},
               engaged_via = ${via || null}, classification_reviewed_at = NOW(),
               classification_reviewed_by = ${user.id}, updated_at = NOW()
         WHERE id = ${id}
        RETURNING id`));
      if (wrote.length) okMsg = 'Classification updated.';
      else errMsg = 'That person is no longer on the register, so nothing was changed. Reload the list.';
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the statement that failed, which
    // told the reviewer nothing about why their compliance review did not save.
    console.error('[admin/hr/classification] POST', e?.cause?.message || e?.message);
    errMsg = String(e?.cause?.message || e?.message || 'Nothing was changed.').slice(0, 240);
  }
}

const employees = rowsOf(await db.execute(sql`
  SELECT id, full_name, email, classification, country_of_work, engaged_via, classification_reviewed_at, is_active
  FROM hr_employees WHERE is_active = true ORDER BY full_name LIMIT 300
`));

// Counts per classification + per country
const byClass: Record<string, number> = {};
const byCountry: Record<string, number> = {};
employees.forEach((e: any) => {
  byClass[e.classification || 'permanent'] = (byClass[e.classification || 'permanent'] || 0) + 1;
  byCountry[e.country_of_work || 'IN'] = (byCountry[e.country_of_work || 'IN'] || 0) + 1;
});

// Declared before the markup that reads it. Flattened here rather than in JSX because a typed map
// inside JSX is one of this project's known .astro parsing traps.
const packRows = engagementKeys().map((k) => {
  const pack = ENGAGEMENT_PACKS[k];
  return {
    key: String(k),
    label: engagementLabelFor(k),
    risk: engagementRiskFor(k),
    summary: pack.summary,
    steps: stepsForEngagement(k).map((st) => ({ title: st.title, dueDay: st.dueDay, owner: ownerViaLabel(st.ownerVia) })),
    excludes: pack.excludes.map((x) => ({ label: x.label, why: x.why })),
    documents: documentsForEngagement(k).map((d) => ({ label: d.label, why: d.why, required: d.required === true })),
    stepCount: stepsForEngagement(k).length,
    excludeCount: pack.excludes.length,
    docCount: documentsForEngagement(k).length,
  };
});
// A pack that contradicts itself is shown rather than swallowed.
const packIssues = allPackProblems();

function fmt(d: any) { try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'short', year:'numeric' }); } catch { return ''; } }
---
<AdminLayout title="Worker Classification Register" activeNav="">
<div style="padding:14px 16px 80px;max-width:1280px;margin:0 auto;">
  <p style="font-size:10.5px;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;font-family:'Geist Mono',monospace;font-weight:700;">HR · Compliance · §2.1</p>
  <h1 style="font-size:24px;color:#fff;margin:6px 0 4px;font-weight:700;">Worker Classification Register</h1>
  <p style="font-size:13px;color:#9aa6b6;margin:0 0 18px;">Every person engaged must be classified correctly. Misclassification (e.g. calling an employee a contractor) is the single biggest compliance risk. Review at least once a year.</p>

  {okMsg && <div style="background:rgba(74,222,128,0.10);border:1px solid rgba(74,222,128,0.32);color:#86efac;border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:13px;">{okMsg}</div>}
  {errMsg && <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:13px;">{errMsg}</div>}
  {!mayWrite && <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.30);color:#fbbf24;border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:13px;">You are reading this register. Recording a classification review needs the HR section with edit rights, so the controls are not shown &mdash; every person, classification and review date below is still the live record.</div>}

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;">
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;">
      <p style="font-size:10.5px;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 10px;font-family:'Geist Mono',monospace;font-weight:700;">By classification</p>
      {Object.entries(byClass).map(([k, n]) => {
        const meta = (CLASSIFICATIONS as any)[k] || { label: k, risk: 'low' };
        const riskCol = meta.risk === 'high' ? '#fca5a5' : meta.risk === 'medium' ? '#fbbf24' : '#86efac';
        return (
          <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a1f;">
            <span style="font-size:12.5px;color:#fff;font-weight:600;">{meta.label} <span style={`color:${riskCol};font-size:9.5px;font-family:'Geist Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;`}>· {meta.risk} risk</span></span>
            <span style="font-size:14px;color:#FF7040;font-weight:700;font-family:'Geist Mono',monospace;">{n}</span>
          </div>
        );
      })}
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;">
      <p style="font-size:10.5px;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 10px;font-family:'Geist Mono',monospace;font-weight:700;">By country</p>
      {Object.entries(byCountry).map(([k, n]) => {
        const c = COUNTRY_CODES.find(x => x.code === k);
        return (
          <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a1f;">
            <span style="font-size:12.5px;color:#fff;font-weight:600;">{c ? c.name : k}</span>
            <span style="font-size:14px;color:#67e8f9;font-weight:700;font-family:'Geist Mono',monospace;">{n}</span>
          </div>
        );
      })}
    </div>
  </div>

  {/* The register is a six-column grid with two fixed px tracks, which cannot fit a 360px phone.
      Rather than reflow the columns (which would misalign the header from its rows), the table
      scrolls inside its own container at a min-width that keeps the columns readable. The PAGE
      never scrolls sideways, which is the part that makes a screen feel broken on a phone. */}
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;overflow:hidden;">
   <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
    <div style="min-width:760px;">
    <div style="background:#15151a;border-bottom:1px solid #1a1a1f;padding:10px 14px;display:grid;grid-template-columns:1.4fr 1.2fr 1.1fr 1fr 110px 80px;gap:10px;font-size:10px;color:#8a8a94;text-transform:uppercase;font-family:'Geist Mono',monospace;letter-spacing:0.08em;font-weight:700;">
      <div>Person</div><div>Classification</div><div>Country</div><div>Engaged via</div><div>Last review</div><div></div>
    </div>
    {employees.map((e: any) => {
      const meta = (CLASSIFICATIONS as any)[e.classification || 'permanent'] || CLASSIFICATIONS.permanent;
      const riskCol = meta.risk === 'high' ? '#fca5a5' : meta.risk === 'medium' ? '#fbbf24' : '#86efac';
      // A STORED VALUE THIS PAGE DOES NOT RECOGNISE MUST STILL BE AN OPTION, and the reason is not
      // cosmetic. Every row here is a FULL-RECORD save: whatever the three selects post becomes the
      // stored value. With no matching <option> the browser selects the FIRST one, so pressing Save
      // on a person whose country_of_work holds a legacy code silently rewrote them to India, and a
      // classification written before a key was renamed silently became "Permanent employee" — a
      // compliance record changed by opening a page and clicking Save on the row next to it.
      const clsKnown = CLASSIFICATION_KEYS.has(String(e.classification || ''));
      const ctryKnown = COUNTRY_KEYS.has(String(e.country_of_work || ''));
      const viaKnown = !e.engaged_via || VIA_KEYS.has(String(e.engaged_via));
      const cells = (
        <>
          <div><p style="font-size:12.5px;color:#fff;font-weight:600;margin:0;">{e.full_name}</p><p style="font-size:10px;color:#8a8a94;margin:1px 0 0;font-family:'Geist Mono',monospace;">{e.email}</p></div>
          {mayWrite ? (
            <select name="classification" style="background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:6px 8px;border-radius:5px;font-size:11.5px;">
              {!clsKnown && e.classification && <option value={e.classification} selected>{String(e.classification)} (not on the list)</option>}
              {Object.entries(CLASSIFICATIONS).map(([k, v]) => <option value={k} selected={k === e.classification || (!clsKnown && !e.classification && k === 'permanent')}>{v.label}</option>)}
            </select>
          ) : (
            <span style={`font-size:11.5px;color:${riskCol};font-weight:600;`}>{clsKnown ? meta.label : String(e.classification || 'Not recorded')}</span>
          )}
          {mayWrite ? (
            <select name="country" style="background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:6px 8px;border-radius:5px;font-size:11.5px;">
              {!ctryKnown && e.country_of_work && <option value={e.country_of_work} selected>{String(e.country_of_work)} (not on the list)</option>}
              {COUNTRY_CODES.map((c) => <option value={c.code} selected={c.code === e.country_of_work || (!ctryKnown && !e.country_of_work && c.code === 'IN')}>{c.name}</option>)}
            </select>
          ) : (
            <span style="font-size:11.5px;color:#cfd6da;">{(COUNTRY_CODES.find((c) => c.code === e.country_of_work) || { name: String(e.country_of_work || 'Not recorded') }).name}</span>
          )}
          {mayWrite ? (
            <select name="engaged_via" style="background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:6px 8px;border-radius:5px;font-size:11.5px;">
              <option value="" selected={!e.engaged_via}>&mdash;</option>
              {!viaKnown && <option value={e.engaged_via} selected>{String(e.engaged_via)} (not on the list)</option>}
              {Object.entries(ENGAGEMENT_VIAS).map(([k, v]) => <option value={k} selected={k === e.engaged_via}>{v.label}</option>)}
            </select>
          ) : (
            <span style="font-size:11.5px;color:#cfd6da;">{((ENGAGEMENT_VIAS as any)[e.engaged_via] || { label: String(e.engaged_via || '—') }).label}</span>
          )}
          <span style="font-size:10.5px;color:#9aa6b6;font-family:'Geist Mono',monospace;">{e.classification_reviewed_at ? fmt(e.classification_reviewed_at) : 'never'}</span>
        </>
      );
      return mayWrite ? (
        <form method="POST" style="display:grid;grid-template-columns:1.4fr 1.2fr 1.1fr 1fr 110px 80px;gap:10px;padding:9px 14px;border-bottom:1px solid #15151a;align-items:center;">
          <input type="hidden" name="id" value={e.id} />
          {cells}
          <button type="submit" style="background:#1045BB;color:#fff;border:none;padding:6px 10px;border-radius:5px;font-size:10.5px;font-weight:700;cursor:pointer;font-family:'Geist Mono',monospace;">Save</button>
        </form>
      ) : (
        <div style="display:grid;grid-template-columns:1.4fr 1.2fr 1.1fr 1fr 110px 80px;gap:10px;padding:9px 14px;border-bottom:1px solid #15151a;align-items:center;">
          {cells}
          <span></span>
        </div>
      );
    })}
    </div>
   </div>
  </div>

  {/* ---------------------------------------------------------------------------------------------
      THE JOINING PACK PER ENGAGEMENT, INCLUDING WHAT IS DELIBERATELY LEFT OUT.
      Read-only. It posts nothing and changes nothing; it exists because the exclusions in
      src/lib/onboarding-packs.ts are only useful if the person who might undo one can read why it
      is there. Rendered here rather than on the journey template screen because this is the page
      where somebody decides what a person IS, which is the decision the pack follows from.
      --------------------------------------------------------------------------------------------- */}
  <div style="margin-top:22px;">
    <p style="font-size:10.5px;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;font-family:'Geist Mono',monospace;font-weight:700;">Joining pack per engagement</p>
    <p style="font-size:12.5px;color:#9aa6b6;margin:0 0 12px;max-width:78ch;">An onboarding checklist is evidence of the relationship. Issuing company equipment to an independent contractor, enrolling them on payroll or recording their acknowledgement of the employee policies produces a written record of the control that makes somebody an employee in fact. Each pack below therefore states what is left out, and why, before anybody adds it back.</p>

    {packRows.map((p) => (
      <details style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:0;margin-bottom:8px;">
        <summary style="padding:12px 14px;cursor:pointer;list-style:none;display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;min-height:44px;">
          <span style="font-size:13px;color:#fff;font-weight:700;">{p.label}</span>
          <span style={`font-size:9.5px;font-family:'Geist Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;color:${p.risk === 'high' ? '#fca5a5' : p.risk === 'medium' ? '#fbbf24' : '#86efac'};`}>{p.risk} risk</span>
          <span style="font-size:10.5px;color:#8a8a94;font-family:'Geist Mono',monospace;">{p.stepCount} steps · {p.excludeCount} left out · {p.docCount} documents</span>
        </summary>
        <div style="padding:0 14px 14px;">
          <p style="font-size:12.5px;color:#cfd6da;margin:0 0 12px;max-width:78ch;">{p.summary}</p>

          <p style="font-size:10px;color:#8a8a94;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 6px;font-family:'Geist Mono',monospace;font-weight:700;">What this joiner is asked to do</p>
          {p.steps.map((s) => (
            <div style="padding:6px 0;border-bottom:1px solid #15151a;">
              <p style="font-size:12.5px;color:#fff;font-weight:600;margin:0;">{s.title}</p>
              <p style="font-size:11px;color:#8a8a94;margin:2px 0 0;font-family:'Geist Mono',monospace;">Day {s.dueDay} · {s.owner}</p>
            </div>
          ))}

          {p.excludes.length > 0 && (
            <div style="margin-top:14px;background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.26);border-radius:10px;padding:12px;">
              <p style="font-size:10px;color:#fca5a5;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 8px;font-family:'Geist Mono',monospace;font-weight:700;">Deliberately not on this checklist</p>
              {p.excludes.map((x) => (
                <div style="padding:6px 0;border-bottom:1px solid rgba(239,68,68,0.14);">
                  <p style="font-size:12.5px;color:#fca5a5;font-weight:600;margin:0;">{x.label}</p>
                  <p style="font-size:11.5px;color:#cfd6da;margin:3px 0 0;max-width:78ch;">{x.why}</p>
                </div>
              ))}
            </div>
          )}

          <p style="font-size:10px;color:#8a8a94;letter-spacing:0.08em;text-transform:uppercase;margin:14px 0 6px;font-family:'Geist Mono',monospace;font-weight:700;">Joining documents (Google Drive links; nothing is uploaded)</p>
          {p.documents.map((d) => (
            <div style="padding:6px 0;border-bottom:1px solid #15151a;">
              <p style="font-size:12.5px;color:#fff;font-weight:600;margin:0;">{d.label} <span style={`font-size:9.5px;font-family:'Geist Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;color:${d.required ? '#86efac' : '#8a8a94'};`}>{d.required ? 'required' : 'if it applies'}</span></p>
              <p style="font-size:11.5px;color:#8a8a94;margin:2px 0 0;max-width:78ch;">{d.why}</p>
            </div>
          ))}
        </div>
      </details>
    ))}

    {packIssues.length > 0 && (
      <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.30);color:#fbbf24;border-radius:10px;padding:10px 14px;margin-top:10px;font-size:12.5px;">
        <p style="margin:0 0 4px;font-weight:700;">These packs contradict themselves and need fixing in src/lib/onboarding-packs.ts:</p>
        {packIssues.map((m) => <p style="margin:2px 0;">{m}</p>)}
      </div>
    )}
  </div>

</div>
</AdminLayout>
