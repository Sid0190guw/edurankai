---
// /admin/hr/promotions — DESIGNATION AND GRADE, changed with an approval behind it.
//
// A PROMOTION IS NOT A TRANSFER, and this page deliberately cannot do one. Changing what somebody is
// called and changing who they report to are approved by different people and mean different things;
// folding them together would let a title change quietly rewrite a reporting line. A move that does
// both is raised as two requests, on this page and on /admin/hr/transfers.
//
// THE PREVIOUS DESIGNATION AND GRADE ARE KEPT ON THE REQUEST ROW, snapshotted when it was raised, so
// applying the change does not destroy what the person was before it. The employee record carries
// the current value; this register carries the history of how it got there.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { canAccessSection, can } from '@/lib/auth/permissions';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { isInitialized } from '@/lib/org-graph';
import { decideInstance, getInstance, resumeWorkflow, VIA_LABELS } from '@/lib/workflow';
import {
  ensureMoveSchema,
  requestPromotion,
  cancelMove,
  syncMoves,
  listPromotions,
  designationChangeLabel,
  DESIGNATION_CHANGE_KINDS,
} from '@/lib/hr-lifecycle';
// CONFIRMATION PROMPTS ARE ESCAPED, NOT STRIPPED. These were built with `.replace(/'/g, '')`,
// which DELETES the apostrophe — the admin was asked to confirm an action against "OBrien", a person
// who does not exist, which is the one thing a confirmation exists to let them check. A value
// carrying a newline ended the JS string literal outright, the handler became a syntax error,
// confirm() never fired, and the destructive form submitted with no confirmation at all.
import { confirmAttr, clip } from '@/lib/page-safety';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!(await canAccessSection(user, 'hr', 'edit'))) return Astro.redirect('/admin');

// CONSTANTS FIRST. `const` is not hoisted.
const PAGE = '/admin/hr/promotions';
const mayWrite = can(user as any, 'employee.manage');

function rowsOf(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const fmtDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

function stateLabel(s: string): string {
  const k = String(s || '');
  if (k === 'pending') return 'Waiting for approval';
  if (k === 'approved') return 'Approved';
  if (k === 'applied') return 'Applied';
  if (k === 'rejected') return 'Rejected';
  if (k === 'cancelled') return 'Withdrawn';
  if (k === 'halted') return 'Halted';
  return k;
}

function stateTone(s: string): string {
  const k = String(s || '');
  if (k === 'applied') return '#86efac';
  if (k === 'approved') return '#6ee7b7';
  if (k === 'rejected') return '#fca5a5';
  if (k === 'halted') return '#fbbf24';
  if (k === 'cancelled') return '#9aa6b6';
  return '#67e8f9';
}

function viaLabel(v: string): string {
  const k = String(v || '');
  if (k === 'reporting_manager') return VIA_LABELS.reporting_manager;
  if (k === 'department_head') return VIA_LABELS.department_head;
  if (k === 'approval_owner') return VIA_LABELS.approval_owner;
  if (k === 'executive_sponsor') return VIA_LABELS.executive_sponsor;
  return 'Approver';
}

await ensureMoveSchema();

if (Astro.request.method === 'POST') {
  let flash = '';
  try {
    const fd = await Astro.request.formData();
    const action = String(fd.get('action') || '');

    if (action === 'decide') {
      const r = await decideInstance(
        String(fd.get('instance_id') || ''),
        user as any,
        String(fd.get('decision') || '') === 'approved' ? 'approved' : 'rejected',
        String(fd.get('note') || ''),
      );
      flash = r.ok ? 'Decision recorded.' : (r.error || 'The decision was not recorded.');
      if (r.ok) {
        const sync = await syncMoves(user.id);
        if (sync.applied) flash += ' ' + sync.applied + ' approved change applied.';
        if (sync.errors.length) flash += ' ' + sync.errors[0];
      }
    } else if (action === 'resume' && mayWrite) {
      // THE `&& mayWrite` IS LOAD-BEARING. This branch sits ABOVE the chain's `!mayWrite` arm because
      // it has to sit beside 'decide' — but 'decide' is safe there only because decideInstance()
      // re-checks the actor itself, and resumeWorkflow() explicitly does NOT. Without this test a
      // read-only account could re-route somebody else's approval. Falling through leaves the
      // refusal sentence the chain already has.
      //
      // A HALTED REQUEST USED TO BE A DEAD END. The banner said "resume it from the approvals
      // workflow" — the only resume console is /admin/hr/leave/workflow and it is hard-scoped to the
      // `leave` domain, so this designation change never appeared on it and no surface could move it again.
      // resumeWorkflow() carries no entitlement check of its own; the gate is the test on this line. It cannot decide anything — it re-routes to whoever the graph names, and
      // leaves the instance halted with the current reason when the graph still names nobody.
      const r = await resumeWorkflow(String(fd.get('instance_id') || ''), user as any);
      if (!r.ok) {
        flash = r.error || 'The designation change was not resumed.';
      } else if (r.state === 'halted') {
        flash = 'Still halted: ' + (r.haltReason || 'the graph still names nobody for a required rung.')
          + ' Nothing on the employee record has changed.';
      } else {
        flash = 'Resumed. It carries on from the rung it stopped at; nothing earlier was re-decided.';
      }
      if (r.ok) {
        const sync = await syncMoves(user.id);
        if (sync.errors.length) flash += ' ' + sync.errors[0];
      }
    } else if (!mayWrite) {
      flash = 'You can read this register, but raising a designation change needs the employee-records permission.';
    } else if (action === 'request') {
      const r = await requestPromotion({
        employeeId: String(fd.get('employee_id') || ''),
        kind: String(fd.get('kind') || 'promotion'),
        toDesignation: String(fd.get('to_designation') || ''),
        toGrade: String(fd.get('to_grade') || '') || null,
        effectiveDate: String(fd.get('effective_date') || ''),
        reason: String(fd.get('reason') || ''),
        requestedByUserId: user.id,
      });
      if (r.ok && r.haltReason) flash = 'Recorded, but it is halted: ' + r.haltReason;
      else if (r.ok) flash = 'Sent for approval. Nothing on the record has changed yet.';
      else flash = r.error || 'The request was not saved.';
    } else if (action === 'cancel') {
      // 'promotion' here is the TABLE the request lives in, not the kind of change it records — a
      // demotion and a re-designation are rows in hr_promotions too. See DESIGNATION_CHANGE_KINDS.
      const r = await cancelMove('promotion', String(fd.get('promotion_id') || ''), user.id);
      flash = r.ok ? 'Request withdrawn.' : (r.error || 'The request was not withdrawn.');
    } else {
      flash = 'That is not something this page does.';
    }
  } catch (e: any) {
    console.error('[admin/hr/promotions] POST', e?.cause?.message || e?.message);
    flash = 'Nothing was saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
  }
  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash.slice(0, 300)));
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const synced = await syncMoves(user.id);
const graphReady = await isInitialized();
const promotions = await listPromotions({ limit: 150 });

let employees: any[] = [];
try {
  employees = rowsOf(await db.execute(sql`
    SELECT id, full_name, designation, grade FROM hr_employees
     WHERE is_active = true ORDER BY full_name ASC LIMIT 400`));
} catch (e: any) {
  console.error('[admin/hr/promotions] employees', e?.cause?.message || e?.message);
}

const open = promotions.filter((p) => p.state === 'pending' || p.state === 'halted').slice(0, 12);
const detail: any[] = [];
for (const p of open) {
  let instance: any = null;
  try {
    if (p.workflowInstanceId) instance = await getInstance(p.workflowInstanceId);
  } catch (e: any) {
    console.error('[admin/hr/promotions] instance', e?.cause?.message || e?.message);
  }
  // The steps already NAME who each rung is waiting on, frozen from the graph when the instance was
  // created. Re-resolving it live per row would be several graph queries each for the same answer.
  const waiting = instance
    ? (instance.steps || []).filter((s: any) => s.stepNo === instance.currentStep && s.decision === 'pending')
    : [];
  detail.push({ p, instance, waiting });
}

const settled = promotions.filter((p) => p.state !== 'pending' && p.state !== 'halted');
const appliedCount = promotions.filter((p) => p.state === 'applied').length;
const haltedCount = promotions.filter((p) => p.state === 'halted').length;
const today = new Date().toISOString().slice(0, 10);
---
<AdminLayout title="Promotions" activeNav="hr">
<div class="wrap">
  <p class="eyebrow">HR · Lifecycle · Designation changes</p>
  <h1>Promotions, demotions and re-designations</h1>
  <p class="lede">
    A change of designation or grade — up, down, or sideways — with the date it takes effect and the
    reason on the record. All three are the same mechanical act and are approved by the same chain:
    the reporting manager, then the department head, before anything on the employee record moves.
    The word is still recorded, because "promotion" on an audit trail where a demotion happened is a
    lie the record tells about somebody for the rest of their career. This page does not change who
    anybody reports to — that is a transfer, and it is approved separately.
  </p>

  {msg && <div class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</div>}
  {synced.errors.length > 0 && <div class="flash warn">{synced.errors[0]}</div>}
  {!mayWrite && (
    <div class="flash warn">You can read this register. Raising a designation change needs the employee-records permission.</div>
  )}
  {!graphReady && (
    <div class="flash warn">
      The Organization Graph is not yet initialized, so no approver can be resolved for anybody. A promotion
      raised now is recorded and halted with that reason rather than approved. Run the graph backfill first.
    </div>
  )}

  <div class="tiles">
    <div class="tile"><span class="tv">{open.length}</span><span class="tl">In progress</span></div>
    <div class="tile"><span class="tv">{appliedCount}</span><span class="tl">Applied</span></div>
    <div class="tile"><span class="tv">{haltedCount}</span><span class="tl">Halted</span></div>
  </div>

  {mayWrite && (
    <details class="panel">
      <summary>Raise a designation change</summary>
      <form method="POST" class="form">
        <input type="hidden" name="action" value="request" />
        <label>What kind of change
          <select name="kind" required>
            {DESIGNATION_CHANGE_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
          </select>
          <span class="hint">{DESIGNATION_CHANGE_KINDS.map((k) => k.label + ': ' + k.note).join(' ')}</span>
        </label>
        <label>Who this is for
          <select name="employee_id" required>
            <option value="">Choose a person</option>
            {employees.map((e: any) => (
              <option value={e.id}>
                {e.full_name}{e.designation ? ' — ' + e.designation : ''}{e.grade ? ' (' + e.grade + ')' : ''}
              </option>
            ))}
          </select>
        </label>
        <label>New designation<input type="text" name="to_designation" required maxlength="200" /></label>
        <label>New grade
          <input type="text" name="to_grade" maxlength="40" />
          <span class="hint">Leave blank to keep the grade they already hold.</span>
        </label>
        <label>Effective date<input type="date" name="effective_date" required value={today} /></label>
        <label>Reason
          <textarea name="reason" rows="3" required placeholder="An approver reads this before deciding."></textarea>
          <span class="hint">
            A demotion needs it written out in full — it is the only account the record will carry of
            why somebody was moved down.
          </span>
        </label>
        <button type="submit" class="btn">Send for approval</button>
      </form>
    </details>
  )}

  <h2>In progress</h2>
  {detail.length === 0 ? (
    <div class="empty">No designation change is waiting on anybody.</div>
  ) : (
    <div class="stack">
      {detail.map((d: any) => (
        <div class="card">
          <div class="cardhead">
            <div>
              <p class="name">{d.p.employeeName || 'Employee'}</p>
              <p class="sub">
                {designationChangeLabel(d.p.kind)} · effective {fmtDate(d.p.effectiveDate)} · raised {fmtDate(d.p.createdAt)}
              </p>
            </div>
            <span class="chip" style={'color:' + stateTone(d.p.state) + ';border-color:' + stateTone(d.p.state) + '55;'}>
              {stateLabel(d.p.state)}
            </span>
          </div>

          <dl class="terms">
            <div><dt>Designation</dt><dd>{d.p.fromDesignation || 'Not recorded'} to {d.p.toDesignation}</dd></div>
            {d.p.toGrade && <div><dt>Grade</dt><dd>{d.p.fromGrade || 'Not recorded'} to {d.p.toGrade}</dd></div>}
          </dl>

          <p class="reason">{d.p.reason}</p>

          {d.p.state === 'halted' && (
            <div class="halt">
              <strong>Halted.</strong> {d.p.haltReason || (graphReady
                ? 'No approver could be resolved.'
                : 'The Organization Graph has not been initialized, so no approver could be resolved for anybody yet.')}
              <span class="hint">
                {graphReady
                  ? 'Nothing on the employee record has changed. Record the missing relationship in the Organization Graph, then press Resume below — the approval carries on from the rung it stopped at.'
                  : 'Nothing on the employee record has changed. This is NOT a claim that this person has no manager: the Organization Graph has not been initialized at all, so nothing can be routed yet. Initialize it, then press Resume below.'}
              </span>
              {mayWrite && d.instance && (
                <form method="POST" class="inline">
                  <input type="hidden" name="action" value="resume" />
                  <input type="hidden" name="instance_id" value={d.instance.id} />
                  <button type="submit" class="btn ghost">Resume this approval</button>
                </form>
              )}
              {mayWrite && !d.instance && (
                <span class="hint">There is no approval instance on this request to resume — withdraw it and raise it again once the graph names an approver.</span>
              )}
            </div>
          )}

          {d.instance && d.instance.state === 'pending' && d.waiting.length > 0 && (
            <div class="waiting">
              <p class="wl">Waiting on</p>
              {d.waiting.map((s: any) => (
                <p class="wn">{viaLabel(s.via)} — {s.approverName || 'a person with no employee record'}</p>
              ))}
            </div>
          )}

          {d.instance && d.instance.state === 'pending' && (
            <form method="POST" class="decide">
              <input type="hidden" name="action" value="decide" />
              <input type="hidden" name="instance_id" value={d.instance.id} />
              <input type="text" name="note" placeholder="Note for the record (optional)" />
              <div class="btnrow">
                <button type="submit" name="decision" value="approved" class="btn ok">Approve</button>
                <button type="submit" name="decision" value="rejected" class="btn no">Reject</button>
              </div>
              <p class="hint">Only the person this was routed to, or somebody standing in for them, can decide it.</p>
            </form>
          )}

          {/* Withdrawing ends an approval somebody may already have acted on, and the button carried
            no prompt at all. It names the person and what stops. */}
          {mayWrite && (d.p.state === 'pending' || d.p.state === 'halted') && (
            <form method="POST" class="inline" onsubmit={confirmAttr('Withdraw the designation change for ' + clip(d.p.employeeName || 'this employee', 80) + '? The approval in progress ends, nothing changes on their record, and raising it again starts a new approval from the beginning.')}>
              <input type="hidden" name="action" value="cancel" />
              <input type="hidden" name="promotion_id" value={d.p.id} />
              <button type="submit" class="btn ghost">Withdraw this request</button>
            </form>
          )}
        </div>
      ))}
    </div>
  )}

  <h2>Settled</h2>
  {settled.length === 0 ? (
    <div class="empty">Nothing has been settled yet.</div>
  ) : (
    <div class="stack">
      {settled.map((p) => (
        <div class="card">
          <div class="cardhead">
            <div>
              <p class="name">{p.employeeName || 'Employee'}</p>
              <p class="sub">
                {designationChangeLabel(p.kind) + ' · '}
                {(p.fromDesignation || 'Not recorded') + ' to ' + p.toDesignation}
                {p.toGrade ? ', grade ' + (p.fromGrade || 'not recorded') + ' to ' + p.toGrade : ''}
                {' · effective ' + fmtDate(p.effectiveDate)}
              </p>
            </div>
            <span class="chip" style={'color:' + stateTone(p.state) + ';border-color:' + stateTone(p.state) + '55;'}>
              {stateLabel(p.state)}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .wrap { padding: 14px 16px 90px; max-width: 1100px; margin: 0 auto; }
  .eyebrow { font-size: 10.5px; color: #FF7040; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; font-weight: 700; }
  h1 { font-size: 23px; color: #fff; margin: 6px 0 4px; font-weight: 700; }
  h2 { font-size: 14px; color: #fff; margin: 26px 0 10px; font-weight: 700; }
  .lede { font-size: 13px; color: #9aa6b6; margin: 0 0 16px; line-height: 1.6; max-width: 70ch; }
  .flash { background: rgba(103,232,249,0.08); border: 1px solid rgba(103,232,249,0.3); color: #a5f3fc; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 13px; line-height: 1.5; }
  .flash.warn { background: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.32); color: #fde68a; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; margin-bottom: 18px; }
  .tile { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
  .tv { font-size: 22px; color: #fff; font-weight: 700; }
  .tl { font-size: 11px; color: #9aa6b6; }
  .panel { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 14px; margin-bottom: 16px; }
  .panel > summary { cursor: pointer; padding: 14px 18px; font-size: 12.5px; color: #FF7040; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; list-style: none; min-height: 44px; display: flex; align-items: center; }
  .form { padding: 0 16px 16px; display: grid; gap: 12px; }
  .form label { font-size: 11px; color: #9aa6b6; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; display: grid; gap: 5px; }
  input, select, textarea { width: 100%; background: #08080a; border: 1px solid #2a2a2f; color: #fff; padding: 11px 12px; border-radius: 8px; font-size: 14px; font-family: inherit; min-height: 44px; text-transform: none; letter-spacing: normal; }
  textarea { min-height: 60px; resize: vertical; }
  .hint { font-size: 11px; color: #6e6e78; text-transform: none; letter-spacing: normal; font-weight: 400; line-height: 1.5; display: block; }
  .btn { background: #FF4F00; color: #fff; border: none; padding: 12px 20px; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; min-height: 44px; justify-self: start; }
  .btn.ok { background: #15803d; }
  .btn.no { background: #b91c1c; }
  .btn.ghost { background: transparent; border: 1px solid #2a2a2f; color: #9aa6b6; }
  .btnrow { display: flex; gap: 8px; flex-wrap: wrap; }
  .stack { display: flex; flex-direction: column; gap: 10px; }
  .card { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 12px; padding: 14px 16px; }
  .cardhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; flex-wrap: wrap; }
  .name { font-size: 14px; color: #fff; font-weight: 700; margin: 0; }
  .sub { font-size: 11.5px; color: #9aa6b6; margin: 3px 0 0; line-height: 1.5; }
  .chip { font-size: 10px; font-weight: 700; padding: 4px 9px; border-radius: 100px; border: 1px solid #2a2a2f; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .reason { font-size: 13px; color: #d8d8de; margin: 10px 0 0; line-height: 1.6; white-space: pre-wrap; }
  .terms { display: grid; gap: 6px; margin: 12px 0 0; }
  .terms div { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; border-bottom: 1px dashed #1a1a1f; padding-bottom: 5px; }
  .terms dt { color: #9aa6b6; margin: 0; }
  .terms dd { color: #e8e8ee; margin: 0; text-align: right; }
  .halt { margin: 12px 0 0; padding: 10px 12px; background: rgba(251,191,36,0.07); border-left: 3px solid #fbbf24; border-radius: 0 8px 8px 0; font-size: 12.5px; color: #fde68a; line-height: 1.55; }
  .waiting { margin: 12px 0 0; padding: 10px 12px; background: rgba(103,232,249,0.06); border-left: 3px solid #67e8f9; border-radius: 0 8px 8px 0; }
  .wl { font-size: 10px; color: #67e8f9; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin: 0 0 4px; }
  .wn { font-size: 12.5px; color: #e8e8ee; margin: 0; }
  .decide { display: grid; gap: 8px; margin-top: 12px; }
  .inline { margin-top: 10px; }
  .empty { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 12px; padding: 30px 18px; text-align: center; color: #6e6e78; font-size: 13px; }
</style>
</AdminLayout>
