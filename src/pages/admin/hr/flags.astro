---
// /admin/hr/flags — the disciplinary register, and the desk where an appeal is actually decided.
//
// WHY THIS PAGE EXISTS. src/lib/hr-flags.ts exported setAppealStatus() — the only writer of an
// appeal outcome anywhere — and recentFlags(), and NOTHING called either one. The module's single
// consumer, /admin/hr/employees/[id].astro, imports raiseFlag and listFlags only. So a Level 3
// breach flag whose recorded action is "immediate termination, no certificate, legal action
// possible" could be raised against a named employee, and no screen in the product could ever
// decide the appeal against it. appeal_status and appeal_notes held NULL for every row ever written.
//
// There was also no organisation-wide view of flags at all: they were visible one employee at a
// time, on a page you can only reach if you already know whose record to open.
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { recentFlags, setAppealStatus, APPEAL_STATUSES, APPEAL_LABELS } from '@/lib/hr-flags';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
// Authorization from the capability matrix. A disciplinary register naming employees and describing
// harassment and misconduct allegations is not a `role !== 'applicant'` surface.
if (!can(user as any, 'admin.access')) return Astro.redirect('/portal');
const mayDecide = can(user as any, 'employee.manage');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  if (!mayDecide) {
    errMsg = 'Deciding an appeal needs the employee.manage capability. Your account can read this register but not change it.';
  } else {
    const fd = await Astro.request.formData();
    const status = String(fd.get('appeal_status') || '') as any;
    const res = await setAppealStatus(String(fd.get('flag_id') || ''), status, String(fd.get('appeal_notes') || ''));
    if (res.ok) okMsg = 'Appeal decision recorded: ' + (APPEAL_LABELS[status as keyof typeof APPEAL_LABELS] || status) + '.';
    else errMsg = res.error;
  }
}

const res = await recentFlags(200);
const flags = res.ok ? res.rows : [];
const readFailed = !res.ok;

const url = new URL(Astro.request.url);
const filter = url.searchParams.get('filter') || '';
const shown = filter === 'appeals'
  ? flags.filter((f) => f.appealStatus === 'pending')
  : filter === 'undecided'
    ? flags.filter((f) => f.appealStatus === null)
    : flags;

const pendingAppeals = flags.filter((f) => f.appealStatus === 'pending').length;

function fmt(d: string): string {
  try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' }); }
  catch { return d; }
}
const LEVEL_TONE: Record<number, string> = { 1: '#b7791f', 2: '#c05621', 3: '#c53030' };
---
<AdminLayout title="Flags and appeals" activeNav="hr">
  <div style="max-width:1080px;margin:0 auto;padding:26px 20px 80px;">
    <p style="font-family:ui-monospace,monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 6px;">HR · Conduct</p>
    <h1 style="font-size:28px;font-weight:700;margin:0 0 6px;">Flags and appeals</h1>
    <p style="font-size:14px;color:#6b6455;margin:0 0 20px;max-width:74ch;line-height:1.6;">
      Every conduct flag raised across the organisation, and the only place an appeal against one can be
      decided. A decision requires a written reason and is recorded against the flag, so the person it
      concerns can be told what was decided and why.
    </p>

    {okMsg && <div style="background:#EBF5EF;border:1px solid #1A6B35;border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">{okMsg}</div>}
    {errMsg && <div style="background:#FFF3EE;border:1px solid #FF4F00;border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">{errMsg}</div>}
    {!mayDecide && <div style="background:#F3EFE8;border:1px solid rgba(14,11,8,0.12);border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">Read-only: deciding an appeal needs the employee.manage capability.</div>}

    {readFailed ? (
      <div style="background:#fff;border:1px solid #FF4F00;border-radius:14px;padding:24px;">
        <p style="font-size:16px;font-weight:700;margin:0 0 8px;">The conduct register could not be read.</p>
        <p style="font-size:14px;color:#2E2520;line-height:1.65;margin:0;max-width:70ch;">
          This page is <strong>not</strong> telling you that no flags exist or that no appeal is waiting.
          It could not look. Somebody may have an undecided appeal against a termination-level flag right
          now and this screen cannot see it, so do not treat a quiet page as a clear one.
        </p>
        <p style="font-family:ui-monospace,monospace;font-size:12px;color:#7A6F68;margin:12px 0 0;">Reason recorded: {res.ok ? '' : res.reason}</p>
      </div>
    ) : (
      <div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
          <a href="/admin/hr/flags" style={'font-size:12px;padding:6px 14px;border-radius:100px;text-decoration:none;border:1px solid rgba(14,11,8,0.15);' + (!filter ? 'background:#0E0B08;color:#fff;' : 'color:#2E2520;')}>All ({flags.length})</a>
          <a href="/admin/hr/flags?filter=appeals" style={'font-size:12px;padding:6px 14px;border-radius:100px;text-decoration:none;border:1px solid rgba(14,11,8,0.15);' + (filter === 'appeals' ? 'background:#0E0B08;color:#fff;' : 'color:#2E2520;')}>Appeals awaiting a decision ({pendingAppeals})</a>
          <a href="/admin/hr/flags?filter=undecided" style={'font-size:12px;padding:6px 14px;border-radius:100px;text-decoration:none;border:1px solid rgba(14,11,8,0.15);' + (filter === 'undecided' ? 'background:#0E0B08;color:#fff;' : 'color:#2E2520;')}>No appeal lodged</a>
        </div>

        {shown.length === 0 ? (
          <div style="background:#fff;border:1px solid rgba(14,11,8,0.10);border-radius:14px;padding:28px;">
            <p style="font-size:15px;margin:0;color:#7A6F68;">
              {flags.length === 0
                ? 'No conduct flag has ever been raised. The register is genuinely empty, not unreadable.'
                : 'No flag matches this filter.'}
            </p>
          </div>
        ) : (
          <div style="display:flex;flex-direction:column;gap:12px;">
            {shown.map((f) => (
              <div style="background:#fff;border:1px solid rgba(14,11,8,0.10);border-radius:12px;padding:16px;">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                  <div style="min-width:220px;flex:1;">
                    <p style="font-size:15px;font-weight:600;margin:0;">
                      <a href={'/admin/hr/employees/' + f.employeeId} style="color:inherit;">{f.employeeName || 'Employee record ' + f.employeeId.slice(0, 8)}</a>
                    </p>
                    <p style="font-size:12.5px;color:#7A6F68;margin:2px 0 0;">
                      {f.breachLabel} · raised {fmt(f.createdAt)}{f.flaggedByName ? ' by ' + f.flaggedByName : ''}
                    </p>
                  </div>
                  <span style={'font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 10px;border-radius:100px;align-self:flex-start;font-weight:700;color:#fff;background:' + (LEVEL_TONE[f.level] || '#6b6455')}>Level {f.level}{f.isEscalation ? ' · auto' : ''}</span>
                </div>

                <p style="font-size:13.5px;color:#2E2520;line-height:1.65;margin:10px 0 0;">{f.description}</p>
                {f.actionTaken && <p style="font-size:12.5px;color:#7A6F68;margin:6px 0 0;">Action on record: {f.actionTaken}</p>}

                <div style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(14,11,8,0.08);">
                  {f.appealStatus === null ? (
                    <p style="font-size:12.5px;color:#7A6F68;margin:0 0 8px;">No appeal has been lodged against this flag.</p>
                  ) : (
                    <p style="font-size:13px;margin:0 0 8px;">
                      <strong>{APPEAL_LABELS[f.appealStatus]}</strong>
                      {f.appealNotes && <span style="display:block;color:#2E2520;margin-top:4px;line-height:1.6;">{f.appealNotes}</span>}
                    </p>
                  )}

                  {mayDecide && (
                    <form method="POST" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                      <input type="hidden" name="flag_id" value={f.id} />
                      <select name="appeal_status" required style="border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 10px;font-size:13px;">
                        {APPEAL_STATUSES.map((s) => <option value={s} selected={f.appealStatus === s}>{APPEAL_LABELS[s]}</option>)}
                      </select>
                      <input type="text" name="appeal_notes" placeholder="Reason for this decision (min 15 characters)" value={f.appealNotes || ''}
                        style="flex:1;min-width:240px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 10px;font-size:13px;" />
                      <button type="submit" style="background:#0E0B08;color:#fff;border:none;border-radius:8px;padding:7px 16px;font-size:13px;font-weight:600;cursor:pointer;">Record decision</button>
                    </form>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</AdminLayout>
