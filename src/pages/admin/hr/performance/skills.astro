---
// /admin/hr/performance/skills — THE SKILL CATALOGUE AND THE DEPARTMENT MATRIX.
//
// THE GATE: `skills.manage`, asked with can() — PERMS_BY_ROLE only, never the registry, because
// page_key is free text and a hand-typed custom-role row could otherwise spell the same string.
// Granted to super_admin + hr, which is exactly who reaches /admin/hr today.
//
// THE MATRIX IS A COUNT OF PEOPLE, NOT A LIST OF THEM. A department view exists to answer "where are
// we thin", and turning it into a per-person ranking is a different screen with different
// consequences for the people on it. Individual levels belong on the person's own surface.
//
// AND IT IS HONEST ABOUT WHAT IT MEASURES: it counts what people have RECORDED. An unrecorded skill
// looks exactly like an absent one, and the copy says so rather than presenting this as a
// measurement of the organization.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { can } from '@/lib/auth/permissions';
import { resolvePerfViewer, departmentOptions, SKILLS_MANAGE } from '@/lib/performance-scope';
import {
  listSkills,
  createSkill,
  retireSkill,
  departmentMatrix,
  skillGaps,
  SKILL_LEVELS,
  type Skill,
  type DepartmentSkillCell,
} from '@/lib/skills';

const PATH = '/admin/hr/performance/skills';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));

const hasConsole = can(user as any, 'admin.access');
if (!hasConsole) return Astro.redirect('/admin');
const allowed = can(user as any, SKILLS_MANAGE);

// Declared above the POST handler — `const` is not hoisted.
const back = (msg: string, dept: string) =>
  Astro.redirect(PATH + '?dept=' + encodeURIComponent(dept) + '&msg=' + encodeURIComponent(msg.slice(0, 300)));

if (Astro.request.method === 'POST') {
  if (!allowed) return Astro.redirect(PATH);
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  const dept = String(fd.get('dept') || '');

  if (action === 'create_skill') {
    const r = await createSkill({
      name: String(fd.get('name') || ''),
      category: String(fd.get('category') || ''),
      description: String(fd.get('description') || ''),
      actorUserId: String(user.id),
    });
    return back(r.ok ? 'Skill added to the catalogue.' : (r.error || 'Could not add that skill.'), dept);
  }

  if (action === 'retire_skill') {
    const r = await retireSkill(String(fd.get('skill_id') || ''), String(user.id));
    return back(
      r.ok
        ? 'Skill retired. The levels people recorded against it are kept — retiring is not deleting.'
        : (r.error || 'Could not retire that skill.'),
      dept,
    );
  }

  return back('That action is not one this page performs.', dept);
}

const params = Astro.url.searchParams;
const msg = String(params.get('msg') || '').slice(0, 300);
const deptParam = String(params.get('dept') || '');

let catalogue: Skill[] = [];
let matrix: DepartmentSkillCell[] = [];
let gaps: { skillId: string; skillName: string; category: string; capable: number }[] = [];
let departments: { id: string; name: string }[] = [];
let viewer: any = null;

if (allowed) {
  viewer = await resolvePerfViewer(String(user.id), (k: string) => can(user as any, k as any));
  departments = await departmentOptions();
  catalogue = await listSkills({ includeRetired: true });
  const dept = departments.some((d) => d.id === deptParam) ? deptParam : '';
  matrix = await departmentMatrix({ departmentId: dept || null });
  gaps = await skillGaps(0);
}

const dept = departments.some((d) => d.id === deptParam) ? deptParam : '';
const active = catalogue.filter((s) => s.isActive);
const retired = catalogue.filter((s) => !s.isActive);

// Group the matrix by department so each one gets its own table rather than one long list.
const byDepartment: { name: string; cells: DepartmentSkillCell[] }[] = [];
for (const cell of matrix) {
  const found = byDepartment.find((g) => g.name === cell.departmentName);
  if (found) found.cells.push(cell);
  else byDepartment.push({ name: cell.departmentName, cells: [cell] });
}
---

<AdminLayout title="Skills" activeNav="hr">
  <style>
    .sk{max-width:1080px}
    .sk h1{font-size:22px;font-weight:700;letter-spacing:-.01em;margin:0 0 4px}
    .sk .lede{font-size:13.5px;line-height:1.6;color:#6b6255;margin:0 0 18px;max-width:70ch}
    .sk .flash{background:rgba(5,150,105,.09);border:1px solid rgba(5,150,105,.3);color:#065f46;
      border-radius:10px;padding:11px 13px;font-size:13px;line-height:1.5;margin-bottom:16px;
      overflow-wrap:anywhere}
    .sk .flash.warn{background:rgba(220,38,38,.07);border-color:rgba(220,38,38,.34);color:#8a1c1c}
    .sk .deny{background:#fbf7f1;border:1px solid #eadecd;color:#6d470d;border-radius:12px;
      padding:16px;font-size:13.5px;line-height:1.6;max-width:70ch}
    .sk .card{background:#fff;border:1px solid #ece4d6;border-radius:14px;padding:16px;
      margin-bottom:14px}
    .sk .card h2{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;
      letter-spacing:.13em;text-transform:uppercase;color:#9a8f7d;font-weight:700;margin:0 0 12px}
    .sk .muted{font-size:12.5px;line-height:1.55;color:#6b6255;overflow-wrap:anywhere}
    .sk label{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9.5px;
      letter-spacing:.1em;text-transform:uppercase;color:#9a8f7d;font-weight:700;display:block;
      margin:10px 0 4px}
    .sk input,.sk select,.sk textarea{width:100%;background:#faf7f1;border:1px solid #e6ddcd;
      border-radius:9px;padding:10px 12px;font-size:14px;font-family:inherit;color:#1a1510;
      outline:none;min-height:44px}
    .sk textarea{min-height:70px;resize:vertical}
    .sk input:focus,.sk select:focus,.sk textarea:focus{border-color:#c2410c}
    .sk .row2{display:grid;grid-template-columns:1fr;gap:9px}
    .sk .btn{background:#c2410c;color:#fff;border:none;border-radius:10px;padding:11px 18px;
      font-size:14px;font-weight:650;cursor:pointer;font-family:inherit;min-height:44px;margin-top:12px}
    .sk .btn.ghost{background:#fff;color:#6b6255;border:1px solid #e6ddcd}
    .sk .btn.slim{padding:9px 14px;font-size:13px;margin-top:0}
    .sk .tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:10px}
    .sk table{border-collapse:collapse;width:100%;min-width:560px;font-size:13.5px}
    .sk th{text-align:left;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9.5px;
      letter-spacing:.1em;text-transform:uppercase;color:#9a8f7d;font-weight:700;padding:8px 10px;
      border-bottom:1px solid #ece4d6;white-space:nowrap}
    .sk td{padding:10px;border-bottom:1px solid #f4efe6;vertical-align:top}
    .sk .meter{display:block;height:7px;border-radius:99px;background:#f0e9db;overflow:hidden;
      min-width:70px}
    .sk .meter i{display:block;height:100%;background:#c2410c;border-radius:99px}
    .sk .kv{display:flex;justify-content:space-between;gap:10px;padding:8px 0;
      border-bottom:1px solid #f4efe6;font-size:13.5px}
    .sk .kv:last-child{border-bottom:none}
    .sk .kv span{color:#6b6255;flex:none}
    @media (min-width:760px){ .sk .row2{grid-template-columns:1fr 1fr} }
  </style>

  <div class="sk">
    <h1>Skills</h1>
    <p class="lede">
      The catalogue everybody records against, and what the organization has recorded so far. This
      counts entries people have made about themselves and assessments their managers have made — it
      is a prompt for a conversation, not a measurement of the company.
    </p>

    {!allowed && (
      <div class="deny">
        <p><b>This is the skills desk.</b> You hold the admin console but not
          <code> skills.manage</code>, which is what maintains the catalogue and reads the department
          matrix.</p>
        <p style="margin-top:9px">It is held by super admins and by HR. Your own skills, and your
          team's, are on your workspace at
          <a href="/portal/employee/learning?view=skills">/portal/employee/learning</a>.</p>
      </div>
    )}

    {allowed && (
      <>
        {msg && <p class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</p>}

        <div class="card">
          <h2>Add a skill</h2>
          <form method="post">
            <input type="hidden" name="action" value="create_skill" />
            <input type="hidden" name="dept" value={dept} />
            <div class="row2">
              <div>
                <label for="s-name">Name</label>
                <input id="s-name" name="name" maxlength="120" required />
              </div>
              <div>
                <label for="s-cat">Category</label>
                <input id="s-cat" name="category" maxlength="60" placeholder="general" />
              </div>
            </div>
            <label for="s-desc">What it means here</label>
            <textarea id="s-desc" name="description" maxlength="1000"
              placeholder="Optional. So two people record the same thing the same way"></textarea>
            <button class="btn" type="submit">Add skill</button>
          </form>
        </div>

        <div class="card">
          <h2>What the levels mean</h2>
          {SKILL_LEVELS.map((l) => (
            <div class="kv">
              <span>{l.level} · {l.label}</span>
              <b style="font-weight:400;text-align:right">{l.hint}</b>
            </div>
          ))}
        </div>

        <div class="card">
          <h2>Catalogue</h2>
          {active.length === 0
            ? <p class="muted">Nothing in the catalogue yet. Nobody can record a level until there is
                something to record it against.</p>
            : (
              <div class="tablewrap">
                <table>
                  <thead><tr><th>Skill</th><th>Category</th><th>People</th><th></th></tr></thead>
                  <tbody>
                    {active.map((s) => (
                      <tr>
                        <td>{s.name}{s.description ? <><br /><span class="muted">{s.description}</span></> : null}</td>
                        <td>{s.category}</td>
                        <td>{s.holders}</td>
                        <td>
                          <form method="post">
                            <input type="hidden" name="action" value="retire_skill" />
                            <input type="hidden" name="dept" value={dept} />
                            <input type="hidden" name="skill_id" value={s.id} />
                            <button class="btn ghost slim" type="submit">Retire</button>
                          </form>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          {retired.length > 0 && (
            <p class="muted" style="margin-top:12px">
              {retired.length} retired skill{retired.length === 1 ? '' : 's'}:
              {' ' + retired.map((s) => s.name).join(', ')}. Retiring drops a skill out of the pickers
              and keeps every level recorded against it.
            </p>
          )}
        </div>

        <div class="card">
          <h2>Department matrix</h2>
          <form method="get" style="display:flex;flex-wrap:wrap;gap:9px;align-items:flex-end">
            <div style="flex:1 1 220px;min-width:0">
              <label for="d">Department</label>
              <select id="d" name="dept">
                <option value="">Every department</option>
                {departments.map((d) => <option value={d.id} selected={d.id === dept}>{d.name}</option>)}
              </select>
            </div>
            <button class="btn slim" type="submit" style="margin-top:0">Filter</button>
          </form>

          {byDepartment.length === 0 && (
            <p class="muted" style="margin-top:12px">Nobody has recorded a skill yet, so there is
              nothing to aggregate. This will stay empty rather than showing zeroes that look like
              measurements.</p>
          )}

          {byDepartment.map((g) => (
            <div style="margin-top:16px">
              <p style="font-size:14px;font-weight:650;margin-bottom:4px">{g.name}</p>
              <div class="tablewrap">
                <table>
                  <thead><tr><th>Skill</th><th>People</th><th>Average level</th><th>Could teach it</th></tr></thead>
                  <tbody>
                    {g.cells.map((c) => (
                      <tr>
                        <td>{c.skillName}<br /><span class="muted">{c.category}</span></td>
                        <td>{c.people}</td>
                        <td>
                          {c.averageLevel}
                          <i class="meter" style="margin-top:5px"><i style={'width:' + Math.round((c.averageLevel / 5) * 100) + '%'}></i></i>
                        </td>
                        <td>{c.strong}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>

        {gaps.length > 0 && (
          <div class="card">
            <h2>Nobody has recorded level 3 or above</h2>
            <p class="muted">Read this as a list of conversations to have, not as a verdict. A skill
              nobody has recorded looks identical to one nobody has.</p>
            {gaps.map((g) => (
              <div class="kv"><span>{g.category}</span><b>{g.skillName}</b></div>
            ))}
          </div>
        )}

        <p class="muted" style="max-width:70ch">
          Individual levels are not listed on this screen. A department view answers "where are we
          thin"; a per-person ranking is a different screen with different consequences for the people
          on it. One person's skills are on their own record.
        </p>
      </>
    )}
  </div>
</AdminLayout>
