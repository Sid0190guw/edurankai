---
// /admin/hr/role-compare — PATCH 16. One person, up to four roles, side by side, in no order.
//
// THE GATE: `match.run`, asked with can() — PERMS_BY_ROLE only, never the registry, because
// page_key is free text and a hand-typed custom-role row could otherwise spell the same string.
// Held by super_admin and hr, which is exactly who reaches the rest of /admin/hr today.
//
// NO NEW PERMISSION KEY WAS INVENTED FOR THIS SCREEN, and that is deliberate rather than lazy. A key
// that is not in PERMS_BY_ROLE and BUILTIN_PERMISSIONS answers false for EVERY role including
// super_admin, so the page would refuse everybody while looking like policy. src/lib/auth/permissions.ts
// records that exact failure happening to offer verifications. Reading a person against a job's
// recorded requirements is what match.run already means; four jobs is still that.
//
// WHAT THIS SCREEN REFUSES TO DO, stated here because a rendering layer is where these get lost:
//   - it never ranks the columns, never sorts them by fit, and prints the refusal to do so;
//   - it never shows a coverage figure without the completeness figure that qualifies it;
//   - it prints "growth headroom" and "leadership requirement coverage" together with the sentence
//     saying which refused subject each one replaces and why;
//   - it renders a withheld aspect as unknown, never as a gap.
//
// IT IS A GET. Nothing on this page writes anything about anybody: no evaluation row, no profile
// update, no assignment. The comparison is recomputed on each load, which is also why the URL is
// shareable between two people looking at the same question.
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { resolvePerfViewer } from '@/lib/performance-scope';
import { employeeOptions } from '@/lib/projects';
import {
  compareRoles,
  comparableRoles,
  ROLE_SLOTS,
  SLOT_LABELS,
  SLOT_INTROS,
  ROLE_COMPARE_READ,
  type ComparableRole,
  type RoleComparison,
  type RoleSlotInput,
  type RoleSlot,
} from '@/lib/horizon/role-compare';

const PATH = '/admin/hr/role-compare';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/portal');

const mayRun = can(user as any, ROLE_COMPARE_READ as any);

const url = new URL(Astro.request.url);
const employeeId = String(url.searchParams.get('employee') || '').trim();
const picked: Record<string, string> = {
  current: String(url.searchParams.get('current') || '').trim(),
  alternative_a: String(url.searchParams.get('alternative_a') || '').trim(),
  alternative_b: String(url.searchParams.get('alternative_b') || '').trim(),
  future_leadership: String(url.searchParams.get('future_leadership') || '').trim(),
};

let employees: { employeeId: string; fullName: string; designation: string | null }[] = [];
let roles: ComparableRole[] = [];
let comparison: RoleComparison | null = null;
let readFailed = '';

if (mayRun) {
  try {
    const [emps, rs] = await Promise.all([employeeOptions(500), comparableRoles(300)]);
    employees = emps;
    roles = rs;
  } catch (e: any) {
    // The real Postgres reason lives on e.cause; e.message is just the failed SQL.
    readFailed = e?.cause?.message || e?.message || 'unknown';
  }
}

const chosen: RoleSlotInput[] = [];
for (const slot of ROLE_SLOTS) {
  const id = picked[slot];
  if (id) chosen.push({ slot: slot as RoleSlot, jobKind: 'role', jobId: id, chosenBecause: null });
}

if (mayRun && employeeId && chosen.length) {
  try {
    const viewer = await resolvePerfViewer(String(user.id), (k: string) => can(user as any, k as any));
    comparison = await compareRoles({
      person: { employeeId },
      roles: chosen,
      viewer,
      holds: (k: string) => can(user as any, k as any),
      mayRun: true,
    });
  } catch (e: any) {
    readFailed = e?.cause?.message || e?.message || 'unknown';
  }
}

const selectedEmployee = employees.find((e) => e.employeeId === employeeId) || null;
const rolesWithRequirements = roles.filter((r) => r.comparable).length;
const readings = comparison ? comparison.readings : [];

// Comparisons hoisted out of the template — `<` and `<=` inside a JSX expression break .astro parsing.
const noRolesMapped = rolesWithRequirements === 0;
const hasRoles = roles.length > 0;
const hasReadings = readings.length > 0;
const notReadRows = comparison ? comparison.notRead : [];
const hasNotRead = notReadRows.length > 0;
---

<AdminLayout title="Role comparison" activeNav="hr">
  <div class="rc">
    <header class="rc-head">
      <h1>Role comparison</h1>
      <p class="rc-lede">
        One person's recorded evidence, read against what several roles have written down as their
        requirements. Every column is produced the same way and none of them is ranked against another.
      </p>
    </header>

    {!mayRun && (
      <p class="rc-refuse">
        This screen needs the <code>{ROLE_COMPARE_READ}</code> capability. Your account can reach the HR
        console but not read a person against a job's requirements, so nothing was loaded.
      </p>
    )}

    {mayRun && readFailed && (
      <p class="rc-refuse">
        Something could not be read just now: {readFailed}. That is a failure to read, and nothing on this
        page should be taken as a finding about anybody.
      </p>
    )}

    {mayRun && (
      <form method="get" action={PATH} class="rc-form">
        <div class="rc-field">
          <label for="employee">Person</label>
          <select id="employee" name="employee">
            <option value="">Choose a person</option>
            {employees.map((e) => (
              <option value={e.employeeId} selected={e.employeeId === employeeId}>
                {e.fullName}{e.designation ? ' — ' + e.designation : ''}
              </option>
            ))}
          </select>
        </div>

        {ROLE_SLOTS.map((slot) => (
          <div class="rc-field">
            <label for={slot}>{SLOT_LABELS[slot]}</label>
            <select id={slot} name={slot}>
              <option value="">Not in this comparison</option>
              {roles.map((r) => (
                <option value={r.jobId} selected={r.jobId === picked[slot]}>
                  {r.title}{r.comparable ? '' : ' (no requirements recorded)'}
                </option>
              ))}
            </select>
          </div>
        ))}

        <button type="submit">Read the comparison</button>
      </form>
    )}

    {mayRun && hasRoles && noRolesMapped && (
      <p class="rc-note">
        No role in the catalogue has any requirement mapped onto the skill catalogue yet, so every column
        this page could draw would say that nothing was compared. Requirements are authored per role
        before a comparison can say anything at all. Until then this screen is honest and empty, which is
        the correct output rather than a missing one.
      </p>
    )}

    {comparison && (
      <section class="rc-frame">
        <p class="rc-refuses">{comparison.refusesRanking}</p>

        <dl class="rc-meta">
          <dt>Person</dt>
          <dd>{selectedEmployee ? selectedEmployee.fullName : (comparison.subject.displayName || 'This person')}</dd>
          <dt>What this account may see of them</dt>
          <dd>{comparison.subject.accessSentence || 'Not stated.'}</dd>
          <dt>Composed by</dt>
          <dd>{comparison.fusion.sentence}</dd>
          <dt>Weighting</dt>
          <dd>{comparison.weightProfile.label}. {comparison.weightProfile.sentence}</dd>
          <dt>Run</dt>
          <dd>
            {comparison.engine.id} v{comparison.engine.version} ({comparison.engine.engineClass},
            {' '}{comparison.engine.decisionUse}), computation {comparison.computationId}, at {comparison.computedAt}.
          </dd>
        </dl>

        <div class="rc-refused">
          <h2>Two things this comparison was asked for and does not produce</h2>
          {comparison.refused.map((r) => (
            <p><strong>{r.subject}:</strong> {r.why}</p>
          ))}
          <p class="rc-instead">
            What is shown instead is the distance between this role's recorded requirements and what is on
            file today, and which of this role's own requirements name a leadership capability. Both are
            statements about the role and the gap. Neither is a rating of the person.
          </p>
        </div>

        {hasNotRead && (
          <div class="rc-note">
            <h2>Roles that could not be read</h2>
            {notReadRows.map((n) => (
              <p><strong>{SLOT_LABELS[n.slot]}:</strong> {n.because}</p>
            ))}
          </div>
        )}

        {hasReadings && (
          <div class="rc-cols">
            {readings.map((r) => (
              <article class="rc-col">
                <h2>{r.slotLabel}</h2>
                <p class="rc-title">{r.title || 'Untitled role'}</p>
                <p class="rc-intro">{SLOT_INTROS[r.slot]}</p>

                <h3>Evidence-based fit</h3>
                <p class="rc-band">{r.evidenceBasedFit.band}</p>
                <p>
                  {r.evidenceBasedFit.coveragePct === null
                    ? 'No coverage figure, because nothing could be assessed.'
                    : r.evidenceBasedFit.coveragePct + '% of the assessed weighting is covered, and '
                      + r.evidenceBasedFit.completenessPct + '% of this role could be assessed at all.'}
                </p>
                <p class="rc-caveat">{r.evidenceBasedFit.mustAccompany}</p>

                <h3>Current capability</h3>
                <p>{r.currentCapability.sentence}</p>
                <ul>
                  {r.currentCapability.evidenced.map((q) => (
                    <li>{q.skillName} — asked at {q.minLevelLabel}. {q.why}</li>
                  ))}
                </ul>

                <h3>Development gap</h3>
                <p>{r.developmentGap.sentence}</p>
                {r.developmentGap.blockers.map((b) => (
                  <p class="rc-blocker">{b}</p>
                ))}
                <ul>
                  {r.developmentGap.lines.map((l) => (
                    <li>
                      <strong>{l.skillName}</strong> ({l.necessity}, asked at {l.minLevelLabel}) —
                      {' '}{l.kindLabel}. {l.why}
                      {l.isLeadership && <span class="rc-lead-note"> {l.leadershipNote}</span>}
                    </li>
                  ))}
                </ul>

                <h3>Growth headroom</h3>
                <p>{r.growthHeadroom.sentence}</p>
                <p class="rc-caveat">
                  This replaces "{r.growthHeadroom.refusedInstead.subject}", which this system refuses:
                  {' '}{r.growthHeadroom.refusedInstead.why}
                </p>

                <h3>Leadership requirement coverage</h3>
                <p>{r.leadership.sentence}</p>
                <p class="rc-caveat">
                  This replaces "{r.leadership.refusedInstead.subject}", which this system refuses:
                  {' '}{r.leadership.refusedInstead.why}
                </p>

                <h3>Long-term sustainability of this reading</h3>
                <p>{r.sustainability.sentence}</p>
                <p class="rc-caveat">{r.sustainability.isNotAForecast}</p>

                <h3>Training to consider</h3>
                <p>{r.requiredTraining.sentence}</p>
                <ul>
                  {r.requiredTraining.suggestions.map((t) => (
                    <li>
                      <a href={r.requiredTraining.assignRoute}>{t.title}</a>
                      {t.durationHours === null ? '' : ' — ' + t.durationHours + ' hours'}
                      {t.isPaid ? ' (paid course)' : ''}
                      <span class="rc-caveat"> {t.basis}</span>
                    </li>
                  ))}
                </ul>

                <h3>Person evidence, role requirements, time and development</h3>
                <p>{r.threeFactor.personEvidence.sentence}</p>
                <p>{r.threeFactor.roleRequirements.sentence}</p>
                <p>{r.threeFactor.timeContext.sentence}</p>

                <details class="rc-chain">
                  <summary>How this was arrived at</summary>
                  <p><strong>Concluded:</strong> {r.chain.concluded}</p>
                  <p><strong>Why:</strong> {r.chain.why}</p>
                  <p><strong>How this is known:</strong> {r.chain.assertion}</p>
                  <h4>On what evidence</h4>
                  <ul>
                    {r.chain.evidence.map((c) => (
                      <li>
                        {c.kind}: {c.label}{c.at ? ' (' + c.at.slice(0, 10) + ')' : ''} — {c.assertion}
                        {c.url && <a href={c.url}> see the record</a>}
                      </li>
                    ))}
                  </ul>
                  <h4>Assumptions</h4>
                  <ul>{r.chain.assumptions.map((a) => (<li>{a}</li>))}</ul>
                  <h4>What is uncertain</h4>
                  <ul>{r.chain.uncertain.map((u) => (<li>{u}</li>))}</ul>
                  <h4>What was read</h4>
                  <ul>{r.chain.dataRead.map((d) => (<li>{d}</li>))}</ul>
                  <h4>Can a human override this</h4>
                  <p>{r.chain.overridable.how}</p>
                </details>

                {!r.resultValidation.ok && (
                  <p class="rc-note">
                    This column could not be published as a shareable record:
                    {' '}{r.resultValidation.errors.join(' ')}
                  </p>
                )}
              </article>
            ))}
          </div>
        )}

        <footer class="rc-authority">
          <h2>What happens with this</h2>
          <p>{comparison.humanAuthority.decidesNothing}</p>
          <ul>{comparison.humanAuthority.routes.map((x) => (<li>{x}</li>))}</ul>
        </footer>
      </section>
    )}
  </div>
</AdminLayout>

<style>
  .rc { max-width: 1400px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
  .rc-head h1 { margin: 0 0 .35rem; font-size: 1.5rem; }
  .rc-lede { margin: 0 0 1.25rem; max-width: 70ch; color: #444; }
  .rc-refuse { padding: .85rem 1rem; border: 1px solid #b45309; background: #fffbeb; border-radius: 8px; }
  .rc-note { padding: .85rem 1rem; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 8px; margin: 1rem 0; }
  .rc-note h2 { margin: 0 0 .4rem; font-size: 1rem; }

  .rc-form { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; margin: 0 0 1.5rem; }
  .rc-field { display: flex; flex-direction: column; gap: .25rem; }
  .rc-field label { font-size: .8rem; font-weight: 600; color: #334155; }
  .rc-field select { min-width: 210px; padding: .45rem .5rem; border: 1px solid #cbd5e1; border-radius: 6px; }
  .rc-form button { padding: .5rem 1rem; border: 0; border-radius: 6px; background: #0f172a; color: #fff; cursor: pointer; }

  .rc-refuses { padding: .85rem 1rem; border-left: 3px solid #0f172a; background: #f1f5f9; margin: 0 0 1.25rem; max-width: 90ch; }
  .rc-meta { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: .35rem 1rem; margin: 0 0 1.25rem; font-size: .9rem; }
  .rc-meta dt { font-weight: 600; color: #334155; }
  .rc-meta dd { margin: 0; color: #475569; }

  .rc-refused { border: 1px solid #cbd5e1; border-radius: 8px; padding: 1rem; margin: 0 0 1.5rem; background: #fff; }
  .rc-refused h2 { margin: 0 0 .5rem; font-size: 1rem; }
  .rc-refused p { margin: 0 0 .5rem; max-width: 90ch; font-size: .9rem; }
  .rc-instead { color: #334155; font-weight: 500; }

  .rc-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; align-items: start; }
  .rc-col { border: 1px solid #cbd5e1; border-radius: 8px; padding: 1rem; background: #fff; }
  .rc-col h2 { margin: 0 0 .15rem; font-size: 1.05rem; }
  .rc-col h3 { margin: 1.1rem 0 .3rem; font-size: .85rem; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .rc-col h4 { margin: .8rem 0 .25rem; font-size: .8rem; color: #475569; }
  .rc-col p { margin: 0 0 .5rem; font-size: .88rem; line-height: 1.5; }
  .rc-col ul { margin: 0 0 .5rem; padding-left: 1.1rem; font-size: .85rem; line-height: 1.5; }
  .rc-title { font-weight: 600; font-size: 1rem; }
  .rc-intro { color: #64748b; font-size: .82rem; }
  .rc-band { font-weight: 600; text-transform: capitalize; }
  .rc-caveat { color: #64748b; font-size: .8rem; }
  .rc-lead-note { color: #64748b; font-size: .8rem; }
  .rc-blocker { border-left: 3px solid #b91c1c; padding-left: .6rem; color: #7f1d1d; }
  .rc-chain { margin-top: 1rem; border-top: 1px solid #e2e8f0; padding-top: .6rem; }
  .rc-chain summary { cursor: pointer; font-size: .85rem; font-weight: 600; color: #334155; }
  .rc-authority { margin-top: 1.5rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; }
  .rc-authority h2 { font-size: 1rem; margin: 0 0 .4rem; }
  .rc-authority ul { font-size: .85rem; line-height: 1.6; }
</style>
