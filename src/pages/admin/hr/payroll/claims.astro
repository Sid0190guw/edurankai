---
// /admin/hr/payroll/claims — the finance view of every expense, travel and advance claim.
//
// THIS CONSOLE DECIDES NOTHING, AND IT HAS NO APPROVE BUTTON. That is not an omission.
//
// A claim is decided by the person the Organization Graph ROUTES it to — usually the claimant's own
// reporting manager, who is an ordinary employee with no admin capability at all. The `expenses` and
// `travel` workflow domains deliberately declare `capability: null`, so there is no standing
// authority that lets a finance or HR account approve any claim it likes; only the routed approver or
// their in-force delegate may act, and they do it at /portal/employee/expenses where their queue is.
//
// Drawing an Approve button here would therefore be a broken promise for almost everyone who opened
// the page, and for the few it worked for it would be an approval reached from the wrong screen. What
// this console is FOR is the finance question — what has been claimed, what is stuck, and why.
//
// THE GATE. `expenses.review` through can() (PERMS_BY_ROLE only, never canAccessSection), granted to
// super_admin and hr. It is SENSITIVE in the registry: a claim queue records what colleagues buy,
// where they travel and, on a medical reimbursement, a health-related spend against a named person.
//
// THE HALTED LIST IS THE POINT OF THIS SCREEN TODAY. Until the founder runs
// db/org-graph-backfill.sql the Organization Graph is empty, so EVERY claim halts with "organization
// graph not yet initialized". That is correct behaviour — nothing is auto-approved and no role name is
// used as a fallback — and this screen is where it is visible rather than silent.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql as sqlExpr } from 'drizzle-orm';
// safeRows keeps "no claim is waiting" apart from "we could not read the claims" — on this console
// those two sentences differ by somebody not being reimbursed.
import { safeRows } from '@/lib/page-safety';
import { can } from '@/lib/auth/permissions';
import {
  allClaims, claimCounts, routeWithdrawals, claimApprovalTrail,
  CLAIM_STATES, CLAIM_STATE_LABELS, CLAIM_KINDS, CLAIM_KIND_LABELS,
  type Claim,
} from '@/lib/expenses';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'expenses.review')) return Astro.redirect('/admin?denied=expenses');

const url = new URL(Astro.request.url);
const statusFilter = String(url.searchParams.get('status') || '');
const kindFilter = String(url.searchParams.get('kind') || '');

const claims: Claim[] = await allClaims({ status: statusFilter, kind: kindFilter, limit: 200 });
const counts = await claimCounts();
const withdrawals = await routeWithdrawals(null);

// =================================================================================================
// "NOBODY HAS RAISED A CLAIM YET" IS A CLAIM ABOUT MONEY PEOPLE ARE WAITING FOR
// =================================================================================================
//
// allClaims() and claimCounts() both log their failure and return [] / {} (src/lib/expenses.ts), and
// safeEnsure() returns them the same way when the schema cannot be provisioned. So an unreachable
// pooler, a permission error or a failed CREATE all rendered as a calm empty queue with six zeroes
// above it — on the finance console whose entire purpose is to show what is stuck. A reviewer reading
// "nobody has raised a claim" closes the tab, and the people waiting to be reimbursed keep waiting.
//
// An independent probe tells the two apart: an empty list under a successful probe is genuinely
// empty; an empty list under a failed probe is UNKNOWN, and the page says so instead of reassuring
// anybody. Declared above the markup that reads it — `const` is not hoisted.
let claimsReadOk = true;
let claimsReadError: string | null = null;
if (claims.length === 0) {
  const probe = await safeRows('[hr/payroll/claims] claim probe', () =>
    db.execute(sqlExpr`SELECT 1 FROM expense_claims LIMIT 1`));
  if (!probe.ok) {
    claimsReadOk = false;
    claimsReadError = probe.error;
  }
}

// The approval trail for the claims that are still live, so this screen can say WHO each one is
// waiting on rather than only that it is waiting.
const trails = new Map<string, Awaited<ReturnType<typeof claimApprovalTrail>>>();
for (const c of claims) {
  if (c.status === 'submitted') trails.set(c.id, await claimApprovalTrail(c));
}

// DECLARED ABOVE THE FIRST THING THAT READS IT. `const` is not hoisted; this used to sit below the
// open-value arithmetic that now calls it, which throws on the first line of the page.
const money = (n: any, cur: string) =>
  (cur || 'INR') + ' ' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const halted = claims.filter((c) => c.status === 'halted');
const totalOpen = (counts.submitted || 0) + (counts.halted || 0);

// =================================================================================================
// NO SINGLE NUMBER ADDS TWO CURRENCIES TOGETHER
// =================================================================================================
//
// "Open value" was `claims.filter(open).reduce((t, c) => t + c.amount, 0)`, printed with
// `claims[0].currency` in front of it. Claim.amount is the amount in that claim's OWN currency and
// this product records one per claim (a travel claim raised abroad is the ordinary case), so a
// queue holding USD 400 and INR 30,000 reported "INR 30,400" — a figure that is not true in any
// currency, on the finance screen, labelled with whichever currency the first row happened to
// carry. There is no exchange rate anywhere in this codebase and this page does not invent one.
//
// Each currency held is now totalled and shown separately, the same discipline getBalance() in
// src/lib/hr-wallet.ts already applies to a wallet.
//
// AND THE FIGURE SAYS WHICH CLAIMS IT COVERS. `counts` is the whole ledger while `claims` is at most
// 200 rows AFTER the status and kind filters, so the count and the value beside it were answering
// two different questions and neither said so.
const openClaims = claims.filter((c) => c.status === 'submitted' || c.status === 'halted');
const openByCurrency = new Map<string, number>();
for (const c of openClaims) {
  const cur = String(c.currency || 'INR').toUpperCase();
  openByCurrency.set(cur, (openByCurrency.get(cur) || 0) + Number(c.amount || 0));
}
const openValueLines = [...openByCurrency.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([cur, total]) => money(total, cur));
const openValueIsPartial = openClaims.length < totalOpen;

const stateColour = {
  draft: '#94a3b8',
  submitted: '#fbbf24',
  halted: '#fb923c',
  approved: '#a5b4fc',
  reimbursed: '#6ee7b7',
  rejected: '#fca5a5',
  cancelled: '#94a3b8',
};

// `const currency = claims[0]?.currency` used to stand here: the first row's currency, used as the
// label on a total summed across every currency in the queue. Nothing reads a page-wide currency
// now, because there is no such thing.
---
<AdminLayout title="Claims — Payroll" activeNav="hr">
<div style="padding-bottom:80px;">

  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS &middot; Payroll</p>
    <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0 0 12px;">Expense and travel claims</h1>
    <div style="display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;">
      <a href="/admin/hr/payroll" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;">Payroll runs</a>
      <a href="/admin/hr/payroll/components" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;">Components</a>
      <a href="/admin/hr/payroll/claims" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#FF4F00;color:#fff;">Claims</a>
    </div>
  </div>

  <div style="padding:12px 16px;">

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin-bottom:14px;">
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:11px 12px;">
        <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;letter-spacing:0.08em;">Open</p>
        <p style="font-size:17px;font-weight:700;color:#fff;margin:3px 0 0;">{totalOpen}</p>
      </div>
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:11px 12px;">
        <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;letter-spacing:0.08em;">Open value{openValueIsPartial ? ' (this view)' : ''}</p>
        {openValueLines.length === 0
          ? <p style="font-size:14px;font-weight:700;color:#fff;margin:3px 0 0;">&mdash;</p>
          : openValueLines.map((line) => (
              <p style="font-size:14px;font-weight:700;color:#fff;margin:3px 0 0;overflow-wrap:anywhere;">{line}</p>
            ))}
        {openValueIsPartial && (
          <p style="font-size:9px;color:#6e6e78;margin:4px 0 0;line-height:1.5;">Covers the {openClaims.length} shown, not all {totalOpen} open.</p>
        )}
      </div>
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:11px 12px;">
        <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;letter-spacing:0.08em;">Cannot be routed</p>
        <p style="font-size:17px;font-weight:700;color:#fb923c;margin:3px 0 0;">{counts.halted || 0}</p>
      </div>
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:11px 12px;">
        <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;letter-spacing:0.08em;">Paid out</p>
        <p style="font-size:17px;font-weight:700;color:#6ee7b7;margin:3px 0 0;">{counts.reimbursed || 0}</p>
      </div>
    </div>

    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:13px 15px;margin-bottom:14px;">
      <p style="font-size:12.5px;color:#8a8a94;margin:0;line-height:1.65;">
        This screen does not approve anything, on purpose. Every claim is decided by the approver the
        Organization Graph routes it to — usually the claimant's own reporting manager, who acts on it
        from their own workspace. Holding the permission that opens this page confers no authority over
        any claim on it.
      </p>
    </div>

    {halted.length > 0 && (
      <div style="background:rgba(251,146,60,0.08);border:1px solid rgba(251,146,60,0.3);border-radius:10px;padding:13px 15px;margin-bottom:14px;">
        <p style="font-size:13px;font-weight:700;color:#fdba74;margin:0;">{halted.length} claim{halted.length === 1 ? '' : 's'} could not be sent to anybody</p>
        <p style="font-size:12.5px;color:#fdba74;margin:7px 0 0;line-height:1.65;">
          Nothing was approved and nothing was lost. Each one names the relationship that is missing —
          record it, and the claim carries on from where it stopped. The most common cause is that the
          Organization Graph has not been populated yet.
        </p>
      </div>
    )}

    {/* Filters. The strip scrolls inside its own container rather than widening the page. */}
    <div style="display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;margin-bottom:12px;padding-bottom:2px;">
      <a href="/admin/hr/payroll/claims" style={`flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:99px;min-height:44px;display:inline-flex;align-items:center;${!statusFilter && !kindFilter ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>All</a>
      {CLAIM_STATES.map((s) => (
        <a href={`/admin/hr/payroll/claims?status=${s}`} style={`flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:99px;min-height:44px;display:inline-flex;align-items:center;${statusFilter === s ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>{CLAIM_STATE_LABELS[s]}</a>
      ))}
      {CLAIM_KINDS.map((k) => (
        <a href={`/admin/hr/payroll/claims?kind=${k}`} style={`flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:99px;min-height:44px;display:inline-flex;align-items:center;${kindFilter === k ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>{CLAIM_KIND_LABELS[k]}</a>
      ))}
    </div>

    {claims.length === 0 && !claimsReadOk && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.35);border-radius:11px;padding:14px 16px;color:#fca5a5;font-size:13px;line-height:1.7;">
        <p style="margin:0;font-weight:700;">The claim queue could not be read, so this page cannot say whether anything is waiting.</p>
        <p style="margin:6px 0 0;">The counts above and the empty list below are not evidence that nobody has claimed. Reload in a moment; if it stays this way the reason is in the server log{claimsReadError ? ' (' + claimsReadError + ')' : ''}.</p>
      </div>
    )}

    {claims.length === 0 && claimsReadOk && (
      <div style="text-align:center;padding:44px 16px;color:#6e6e78;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.7;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/></svg>
        <p style="font-size:13.5px;margin-top:10px;">{statusFilter || kindFilter ? 'No claim matches that filter.' : 'Nobody has raised a claim yet.'}</p>
        <p style="font-size:12.5px;margin-top:6px;line-height:1.6;">Employees raise expense, travel and advance claims from their own workspace at /portal/employee/expenses.</p>
      </div>
    )}

    <div style="display:flex;flex-direction:column;gap:8px;">
      {claims.map((c) => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:11px;padding:13px 14px;">
          <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
            <div style="min-width:0;">
              <p style="font-size:14px;font-weight:600;color:#fff;margin:0;overflow-wrap:anywhere;">{c.title}</p>
              <p style="font-size:11px;color:#6e6e78;margin:3px 0 0;overflow-wrap:anywhere;">
                {c.employeeName || 'Unknown employee'}{c.employeeCode ? ' · ' + c.employeeCode : ''} &middot; {c.kindLabel} &middot; {c.categoryLabel}
              </p>
            </div>
            <div style="text-align:right;flex:0 0 auto;">
              <p style="font-size:14px;font-weight:700;color:#fff;margin:0;font-family:'Geist Mono',monospace;white-space:nowrap;">{money(c.amount, c.currency)}</p>
              <span style={`display:inline-block;margin-top:5px;font-size:9px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;color:${stateColour[c.status]};background:${stateColour[c.status]}22;`}>{c.statusLabel}</span>
            </div>
          </div>

          {c.status === 'halted' && (
            <p style="font-size:12px;color:#fdba74;margin:9px 0 0;line-height:1.6;">{c.haltReason || 'No approver could be resolved.'}</p>
          )}

          {c.status === 'submitted' && trails.get(c.id) && trails.get(c.id)!.steps.length > 0 && (
            <div style="margin-top:9px;border-top:1px dashed #1a1a1f;padding-top:8px;">
              {trails.get(c.id)!.steps.map((s) => (
                <p style="font-size:11.5px;color:#8a8a94;margin:0 0 3px;line-height:1.6;">
                  Step {s.stepNo}: {s.approverName || 'an approver'} &middot; {s.decision}{s.note ? ' — ' + s.note : ''}
                </p>
              ))}
            </div>
          )}

          {c.description && <p style="font-size:12px;color:#8a8a94;margin:9px 0 0;line-height:1.6;overflow-wrap:anywhere;">{c.description}</p>}

          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:9px;font-size:11.5px;">
            {c.incurredOn && <span style="color:#6e6e78;">Spent {c.incurredOn}</span>}
            {c.neededBy && <span style="color:#6e6e78;">Needed by {c.neededBy}</span>}
            {c.travelFrom && <span style="color:#6e6e78;">{c.travelFrom} to {c.travelTo}</span>}
            {c.receiptUrl
              ? <a href={c.receiptUrl} target="_blank" rel="noopener noreferrer" style="color:#FF7040;">Receipt link</a>
              : <span style="color:#6e6e78;">No receipt (advance request)</span>}
          </div>
        </div>
      ))}
    </div>

    <!-- WALLET WITHDRAWALS, routed through the same engine -->
    <div style="margin-top:22px;">
      <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#6e6e78;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 4px;">Wallet withdrawals</p>
      <p style="font-size:12px;color:#6e6e78;margin:0 0 10px;line-height:1.65;">
        Requests to move an employee's wallet balance to their bank, given an approval chain by the same
        engine. Releasing an approved payout is a separate authority and still happens on
        <a href="/admin/hr/wallet" style="color:#FF7040;"> Payouts</a>.
      </p>

      {withdrawals.length === 0 && (
        <p style="font-size:12.5px;color:#6e6e78;padding:20px 0;text-align:center;">No withdrawal requests.</p>
      )}

      <div style="display:flex;flex-direction:column;gap:8px;">
        {withdrawals.map((w) => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:11px;padding:12px 14px;">
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
              <div style="min-width:0;">
                <p style="font-size:13.5px;font-weight:600;color:#fff;margin:0;">{w.employeeName || 'Unknown employee'}</p>
                <p style="font-size:11px;color:#6e6e78;margin:3px 0 0;">
                  {w.requestedAt ? new Date(w.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}{w.note ? ' — ' + w.note : ''}
                </p>
              </div>
              <div style="text-align:right;flex:0 0 auto;">
                <p style="font-size:13.5px;font-weight:700;color:#fff;margin:0;font-family:'Geist Mono',monospace;white-space:nowrap;">{money(w.amount, w.currency)}</p>
                <span style="display:inline-block;margin-top:5px;font-size:9px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;background:rgba(148,163,184,0.15);color:#94a3b8;">{w.status}</span>
              </div>
            </div>
            {w.workflowState === 'halted' && w.haltReason && (
              <p style="font-size:11.5px;color:#fdba74;margin:8px 0 0;line-height:1.6;">Not sent to anybody yet: {w.haltReason}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
</AdminLayout>
