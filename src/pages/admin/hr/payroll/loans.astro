---
// /admin/hr/payroll/loans — EMPLOYEE LOANS AND SALARY ADVANCES.
//
// WHAT THIS SCREEN IS FOR. Somebody needs money now and will pay it back out of later pay runs. The
// register records the agreement, routes it for approval, records that the money actually went out,
// and then shows the balance coming down one payroll run at a time until it clears by itself.
//
// THREE THINGS IT DELIBERATELY CANNOT DO:
//   1. It cannot approve anything. Every request is routed by src/lib/workflow.ts from the
//      Organization Graph, and the Approve button below acts on the WORKFLOW INSTANCE — only the
//      person that engine routed to, or somebody standing in for them, can press it and have it
//      count. Holding this page confers no authority to decide.
//   2. It cannot pay anybody. "Record disbursement" writes down that the money went out through
//      whatever this organisation actually uses, with a reference. Nothing here moves money.
//   3. It cannot deduct anything by itself. The per-run recovery happens inside the payroll run,
//      capped at what that month's pay can carry, and it stops the moment the balance reaches zero.
//
// THE GATE. `payroll.manage` through can(), exactly as /admin/hr/payroll and its components screen
// do — PERMS_BY_ROLE only, so a custom role holding the `payroll` SECTION checkbox (which passes
// middleware) is still refused here. This register carries what people owe the company.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { can } from '@/lib/auth/permissions';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { isInitialized } from '@/lib/org-graph';
import { decideInstance, getInstance, resumeWorkflow, VIA_LABELS } from '@/lib/workflow';
import {
  ensureLoanSchema, listLoans, requestLoan, cancelLoan, recordDisbursement,
  syncLoanApprovals, loanLedger, loanKindLabel, loanStateLabel, LOAN_KINDS,
  type LoanRow,
} from '@/lib/loans';
// CONFIRMATION PROMPTS ARE ESCAPED, NOT STRIPPED. These were built with `.replace(/'/g, '')`,
// which DELETES the apostrophe — the admin was asked to confirm an action against "OBrien", a person
// who does not exist, which is the one thing a confirmation exists to let them check. A value
// carrying a newline ended the JS string literal outright, the handler became a syntax error,
// confirm() never fired, and the destructive form submitted with no confirmation at all.
import { confirmAttr, clip, civilToday } from '@/lib/page-safety';
// sumMoney adds integer paise, so a summary tile equals the rows printed beneath it.
import { sumMoney } from '@/lib/money';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'payroll.manage')) return Astro.redirect('/admin?denied=payroll');

// EVERY const BEFORE the POST handler that reads it. `const` is not hoisted, and a declaration below
// its first use throws on the handler's first line while the page still reports success.
const PAGE = '/admin/hr/payroll/loans';
const DETAIL_LIMIT = 12;

function rowsOf(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

const money = (n: any, cur: string) =>
  (cur || 'INR') + ' ' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const fmtDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

function stateTone(s: string): string {
  const k = String(s || '');
  if (k === 'closed') return '#86efac';
  if (k === 'active') return '#6ee7b7';
  if (k === 'rejected') return '#fca5a5';
  if (k === 'halted') return '#fbbf24';
  if (k === 'cancelled') return '#9aa6b6';
  return '#67e8f9';
}

function viaLabel(v: string): string {
  const k = String(v || '');
  if (k === 'reporting_manager') return VIA_LABELS.reporting_manager;
  if (k === 'department_head') return VIA_LABELS.department_head;
  if (k === 'approval_owner') return VIA_LABELS.approval_owner;
  if (k === 'executive_sponsor') return VIA_LABELS.executive_sponsor;
  return 'Approver';
}

const MONTH_OPTIONS = [
  { v: 1, l: 'January' }, { v: 2, l: 'February' }, { v: 3, l: 'March' }, { v: 4, l: 'April' },
  { v: 5, l: 'May' }, { v: 6, l: 'June' }, { v: 7, l: 'July' }, { v: 8, l: 'August' },
  { v: 9, l: 'September' }, { v: 10, l: 'October' }, { v: 11, l: 'November' }, { v: 12, l: 'December' },
];

// ensureLoanSchema() logs the Postgres cause and re-throws on purpose. Swallowing it made "the loan
// tables are not there" render identically to "nobody has a loan", which is the difference that
// matters most on a page about money owed. The reason is kept and shown.
let schemaError = '';
try { await ensureLoanSchema(); }
catch (e: any) { schemaError = e?.cause?.message || e?.message || 'unknown error'; }

if (Astro.request.method === 'POST') {
  let flash = '';
  try {
    const fd = await Astro.request.formData();
    const action = String(fd.get('action') || '');

    if (action === 'decide') {
      // THE WORKFLOW INSTANCE, not the loan row. decideInstance() re-checks that this account is the
      // routed approver or an in-force delegate; reaching this page proves nothing about that.
      const r = await decideInstance(
        String(fd.get('instance_id') || ''),
        user as any,
        String(fd.get('decision') || '') === 'approved' ? 'approved' : 'rejected',
        String(fd.get('note') || ''),
      );
      flash = r.ok ? 'Decision recorded.' : (r.error || 'The decision was not recorded.');
      if (r.ok) {
        const sync = await syncLoanApprovals(user.id);
        if (sync.errors.length) flash += ' ' + sync.errors[0];
      }
    } else if (action === 'request') {
      const r = await requestLoan({
        employeeId: String(fd.get('employee_id') || ''),
        kind: String(fd.get('kind') || ''),
        purpose: String(fd.get('purpose') || ''),
        principal: Number(fd.get('principal')),
        instalments: Number(fd.get('instalments')),
        interestRatePct: Number(fd.get('interest_rate') || 0),
        startMonth: Number(fd.get('start_month')),
        startYear: Number(fd.get('start_year')),
        requestedByUserId: user.id,
      });
      if (r.ok && r.haltReason) flash = 'Recorded, but it is halted: ' + r.haltReason;
      else if (r.ok) flash = 'Sent for approval. No money has moved and nothing is being deducted.';
      else flash = r.error || 'The request was not saved.';
    } else if (action === 'cancel') {
      const r = await cancelLoan(String(fd.get('loan_id') || ''), user.id);
      flash = r.ok ? 'Request withdrawn.' : (r.error || 'The request was not withdrawn.');
    } else if (action === 'disburse') {
      const r = await recordDisbursement({
        loanId: String(fd.get('loan_id') || ''),
        reference: String(fd.get('reference') || ''),
        actorUserId: user.id,
      });
      flash = r.ok
        ? 'Disbursement recorded. Recovery starts with the next payroll run at or after the start month.'
        : (r.error || 'The disbursement was not recorded.');
    } else if (action === 'resume') {
      // THE HALT WAS A DEAD END ON THIS PAGE.
      //
      // The banner told the operator to "record the missing relationship in the Organization Graph,
      // then resume it from the approvals workflow" — and the only console that resumes anything is
      // /admin/hr/leave/workflow, which is hard-scoped to the `leave` domain. A loan halted for a
      // missing manager could therefore never be moved again from any surface in the product: the
      // request sat halted forever with a sentence pointing at a screen that cannot list it.
      //
      // resumeWorkflow() carries NO entitlement check of its own and says so in its own doc comment
      // — the caller must bring the gate. This page's gate is `payroll.manage`, tested at the top,
      // and it is the same key that raises a loan here. Resuming cannot decide anything: it re-routes
      // to whoever the graph names, and if the graph still names nobody the instance STAYS halted
      // with the current reason. It is never nudged towards approved.
      const r = await resumeWorkflow(String(fd.get('instance_id') || ''), user as any);
      if (!r.ok) {
        flash = r.error || 'The request was not resumed.';
      } else if (r.state === 'halted') {
        flash = 'Still halted: ' + (r.haltReason || 'the graph still names nobody for a required rung.')
          + ' Nothing was approved and no money has moved.';
      } else {
        flash = 'Resumed. It carries on from the rung it stopped at; nothing earlier was re-decided.';
      }
      if (r.ok) {
        const sync = await syncLoanApprovals(user.id);
        if (sync.errors.length) flash += ' ' + sync.errors[0];
      }
    } else {
      flash = 'That is not something this page does.';
    }
  } catch (e: any) {
    // NEVER SWALLOWED. The real Postgres reason is on e.cause; e.message is only the failed SQL.
    console.error('[admin/hr/payroll/loans] POST', e?.cause?.message || e?.message);
    flash = 'Nothing was saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
  }
  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash.slice(0, 300)));
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const synced = await syncLoanApprovals(user.id);
const graphReady = await isInitialized();
const loans = await listLoans({ limit: 250 });

let employees: any[] = [];
try {
  employees = rowsOf(await db.execute(sql`
    SELECT id, full_name, employee_code FROM hr_employees
     WHERE is_active = true ORDER BY full_name ASC LIMIT 400`));
} catch (e: any) {
  console.error('[admin/hr/payroll/loans] employees', e?.cause?.message || e?.message);
}

const open = loans.filter((l) => l.state === 'pending' || l.state === 'halted').slice(0, DETAIL_LIMIT);
const detail: any[] = [];
for (const l of open) {
  let instance: any = null;
  try {
    if (l.workflowInstanceId) instance = await getInstance(l.workflowInstanceId);
  } catch (e: any) {
    console.error('[admin/hr/payroll/loans] instance', e?.cause?.message || e?.message);
  }
  const waiting = instance
    ? (instance.steps || []).filter((s: any) => s.stepNo === instance.currentStep && s.decision === 'pending')
    : [];
  detail.push({ l, instance, waiting });
}

const active = loans.filter((l) => l.state === 'active');
const settled = loans.filter((l) => ['closed', 'rejected', 'cancelled'].indexOf(l.state) >= 0);
const awaitingDisbursement = active.filter((l) => !l.disbursedAt);
// ===================================================================================================
// A TOTAL OVER TWO CURRENCIES IS NOT A NUMBER, AND THE FIRST ROW'S SYMBOL IS NOT A LABEL FOR IT
// ===================================================================================================
//
// This was `active.reduce((s, l) => s + l.outstanding, 0)` printed with `loans[0]?.currency`. Two
// faults compounded on one tile:
//
//   * Every other figure on this page is rendered with its OWN loan's currency (`money(l.principal,
//     l.currency)`), because hr_salary_loans carries one and src/lib/loans.ts reads it. This tile
//     added them all together regardless and labelled the sum with whichever loan the ORDER BY
//     happened to return first. A register holding a USD 4,000 advance and a rupee loan of 60,000
//     reported "INR 64,000.00" — a figure that is not true in any currency, on the screen somebody
//     uses to say what the company is owed. src/lib/payroll.ts and src/lib/settlement.ts both REFUSE
//     to mix currencies at exactly this boundary; this page quietly did it anyway.
//   * The addition was a left-to-right double sum. sumMoney() adds integer paise, so the total
//     equals the balances printed beneath it to the paisa.
//
// One entry per currency held. Nothing is converted — there is no exchange rate in this codebase and
// a summary tile is not the place to invent one.
const outstandingBuckets = new Map<string, number[]>();
for (const l of active) {
  const cur = String(l.currency || 'INR').toUpperCase();
  const bucket = outstandingBuckets.get(cur) || [];
  bucket.push(l.outstanding);
  outstandingBuckets.set(cur, bucket);
}
const outstandingByCurrency: Array<{ currency: string; total: number }> = [];
outstandingBuckets.forEach((amounts, cur) => {
  outstandingByCurrency.push({ currency: cur, total: sumMoney(amounts) });
});
outstandingByCurrency.sort((a, b) => a.currency.localeCompare(b.currency));
const outstandingLabel = outstandingByCurrency.length === 0
  ? money(0, 'INR')
  : outstandingByCurrency.map((o) => money(o.total, o.currency)).join('  +  ');

// The ledger for the live agreements only. Each is one query, and a long history must not turn one
// page load on a phone into hundreds of round trips.
const ledgers: Record<string, any[]> = {};
for (const l of active.slice(0, DETAIL_LIMIT)) {
  ledgers[l.id] = await loanLedger(l.id);
}

// THE MONTH THIS FORM DEFAULTS TO, IN THE ZONE THE COMPANY WORKS IN.
//
// `new Date().getMonth()` reads the PROCESS clock, which is UTC on this deployment. Between 00:00 and
// 05:29 IST on the 1st of a month it is still the previous month there, so the "recovery starts from"
// selector defaulted to a month that has already been paid — and src/lib/loans.ts plannedRecoveries()
// skips a loan whose start period is not yet reached, so the opposite error simply delays recovery by
// a run. Neither is visible on the form: it shows a plausible month either way.
const civilNow = civilToday();
const thisMonth = Number(civilNow.slice(5, 7)) || 1;
const thisYear = Number(civilNow.slice(0, 4)) || new Date().getUTCFullYear();
const yearOptions = [thisYear, thisYear + 1];
---
<AdminLayout title="Loans and salary advances" activeNav="hr">
<div class="wrap">
  <p class="eyebrow">HR · Payroll · Loans and advances</p>
  <h1>Loans and salary advances</h1>
  <p class="lede">
    Money lent to somebody and recovered from their later pay. A loan and a salary advance are the
    same act with different words, so they are recorded here together and recovered the same way. The
    deduction appears on the payslip, it is capped at what that month's pay can carry, and it stops
    on its own the moment the balance reaches zero.
  </p>

  {msg && <div class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</div>}
  {schemaError && <div class="flash warn">The loan tables could not be prepared, so any list below is incomplete and nothing here can be saved. Postgres said: {schemaError}</div>}
  {synced.errors.length > 0 && <div class="flash warn">{synced.errors[0]}</div>}
  {!graphReady && (
    <div class="flash warn">
      The Organization Graph is not yet initialized, so no approver can be resolved for anybody. A
      request raised now is recorded and halted with that reason rather than approved. Run the graph
      backfill first.
    </div>
  )}

  <div class="tiles">
    <div class="tile"><span class="tv">{detail.length}</span><span class="tl">Waiting on a decision</span></div>
    <div class="tile"><span class="tv">{active.length}</span><span class="tl">Live agreements</span></div>
    <div class="tile"><span class="tv">{awaitingDisbursement.length}</span><span class="tl">Approved, not paid out</span></div>
    <div class="tile"><span class="tv">{outstandingLabel}</span><span class="tl">{outstandingByCurrency.length > 1 ? 'Outstanding, per currency (not added together)' : 'Outstanding in total'}</span></div>
  </div>

  <details class="panel">
    <summary>Raise a loan or salary advance</summary>
    <form method="POST" class="form">
      <input type="hidden" name="action" value="request" />
      <label>Who is this for
        <select name="employee_id" required>
          <option value="">Choose a person</option>
          {employees.map((e: any) => (
            <option value={e.id}>{e.full_name}{e.employee_code ? ' — ' + e.employee_code : ''}</option>
          ))}
        </select>
      </label>
      <label>What kind
        <select name="kind" required>
          <option value="">Choose</option>
          {LOAN_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
        </select>
        <span class="hint">
          {LOAN_KINDS.map((k) => k.label + ': ' + k.note).join(' ')}
        </span>
      </label>
      <label>What it is for
        <textarea name="purpose" rows="2" required placeholder="An approver reads this before deciding."></textarea>
      </label>
      <label>Amount
        <input type="number" name="principal" step="0.01" min="0.01" required />
      </label>
      <label>Recovered over how many pay runs
        <input type="number" name="instalments" step="1" min="1" max="120" required value="1" />
      </label>
      <label>Flat annual interest rate
        <input type="number" name="interest_rate" step="0.001" min="0" max="100" value="0" />
        <span class="hint">
          Enter 0 for an interest-free advance. Where a rate is entered the total interest is the
          amount multiplied by the rate, multiplied by the number of runs divided by twelve. It is
          flat and uncompounded, and this product makes no claim that it matches any lending rule.
        </span>
      </label>
      <div class="pair">
        <label>Recovery starts in
          <select name="start_month" required>
            {MONTH_OPTIONS.map((m) => (
              <option value={m.v} selected={m.v === thisMonth}>{m.l}</option>
            ))}
          </select>
        </label>
        <label>Year
          <select name="start_year" required>
            {yearOptions.map((y) => <option value={y} selected={y === thisYear}>{y}</option>)}
          </select>
        </label>
      </div>
      <button type="submit" class="btn">Send for approval</button>
      <p class="hint">
        Nothing is lent and nothing is deducted by pressing this. It records the agreement and asks
        the people the Organization Graph names to approve it.
      </p>
    </form>
  </details>

  <h2>Waiting on a decision</h2>
  {detail.length === 0 ? (
    <div class="empty">Nothing is waiting on anybody.</div>
  ) : (
    <div class="stack">
      {detail.map((d: any) => (
        <div class="card">
          <div class="cardhead">
            <div>
              <p class="name">{d.l.employeeName || 'Employee'}</p>
              <p class="sub">
                {loanKindLabel(d.l.kind)} · {money(d.l.principal, d.l.currency)} over {d.l.instalments} run{d.l.instalments === 1 ? '' : 's'} · raised {fmtDate(d.l.createdAt)}
              </p>
            </div>
            <span class="chip" style={'color:' + stateTone(d.l.state) + ';border-color:' + stateTone(d.l.state) + '55;'}>
              {loanStateLabel(d.l.state)}
            </span>
          </div>

          <dl class="terms">
            <div><dt>Amount</dt><dd>{money(d.l.principal, d.l.currency)}</dd></div>
            <div><dt>Interest</dt><dd>{d.l.interestRatePct > 0 ? d.l.interestRatePct + '% flat, ' + money(d.l.interestTotal, d.l.currency) + ' in total' : 'None'}</dd></div>
            <div><dt>Total repayable</dt><dd>{money(d.l.totalPayable, d.l.currency)}</dd></div>
            <div><dt>Each run</dt><dd>{money(d.l.instalmentAmount, d.l.currency)}</dd></div>
          </dl>

          <p class="reason">{d.l.purpose}</p>

          {d.l.state === 'halted' && (
            <div class="halt">
              <strong>Halted.</strong> {d.l.haltReason || (graphReady
                ? 'No approver could be resolved.'
                : 'The Organization Graph has not been initialized, so no approver could be resolved for anybody yet.')}
              {/* THE INSTRUCTION USED TO POINT AT A SCREEN THAT CANNOT HELP. It read "resume it from
                  the approvals workflow" — the only resume console is /admin/hr/leave/workflow and
                  it is hard-scoped to the leave domain, so a halted LOAN never appears on it. The
                  button is here now, on the request it concerns. */}
              <span class="hint">
                {graphReady
                  ? 'Nothing has been lent and nothing is being deducted. Record the missing relationship in the Organization Graph, then press Resume below — the approval carries on from the rung it stopped at.'
                  : 'Nothing has been lent and nothing is being deducted. This is NOT a claim that this person has no manager: the Organization Graph has not been initialized at all, so nothing can be routed yet. Initialize it, then press Resume below.'}
              </span>
              {/* No extra gate: the whole page is already refused to anybody without
                  `payroll.manage`, which is the same key that raises a loan here. */}
              {d.instance && (
                <form method="POST" class="inline">
                  <input type="hidden" name="action" value="resume" />
                  <input type="hidden" name="instance_id" value={d.instance.id} />
                  <button type="submit" class="btn ghost">Resume this approval</button>
                </form>
              )}
              {!d.instance && (
                <span class="hint">There is no approval instance on this request to resume — withdraw it and raise it again once the graph names an approver.</span>
              )}
            </div>
          )}

          {d.instance && d.instance.state === 'pending' && d.waiting.length > 0 && (
            <div class="waiting">
              <p class="wl">Waiting on</p>
              {d.waiting.map((s: any) => (
                <p class="wn">{viaLabel(s.via)} — {s.approverName || 'a person with no employee record'}</p>
              ))}
            </div>
          )}

          {d.instance && d.instance.state === 'pending' && (
            <form method="POST" class="decide">
              <input type="hidden" name="action" value="decide" />
              <input type="hidden" name="instance_id" value={d.instance.id} />
              <input type="text" name="note" placeholder="Note for the record (optional)" />
              <div class="btnrow">
                <button type="submit" name="decision" value="approved" class="btn ok">Approve</button>
                <button type="submit" name="decision" value="rejected" class="btn no">Reject</button>
              </div>
              <p class="hint">Only the person this was routed to, or somebody standing in for them, can decide it.</p>
            </form>
          )}

          {/* Withdrawing ends an approval somebody may already have acted on. It named nothing. */}
          <form method="POST" class="inline" onsubmit={confirmAttr('Withdraw the ' + money(d.l.principal, d.l.currency) + ' ' + loanKindLabel(d.l.kind).toLowerCase() + ' for ' + clip(d.l.employeeName || 'this employee', 80) + '? The approval in progress ends, no money is lent, and raising it again starts a new approval from the beginning.')}>
            <input type="hidden" name="action" value="cancel" />
            <input type="hidden" name="loan_id" value={d.l.id} />
            <button type="submit" class="btn ghost">Withdraw this request</button>
          </form>
        </div>
      ))}
    </div>
  )}

  <h2>Live agreements</h2>
  {active.length === 0 ? (
    <div class="empty">Nobody has a loan or advance running.</div>
  ) : (
    <div class="stack">
      {active.map((l: LoanRow) => (
        <div class="card">
          <div class="cardhead">
            <div>
              <p class="name">{l.employeeName || 'Employee'}</p>
              <p class="sub">
                {loanKindLabel(l.kind)} · {money(l.principal, l.currency)}
                {l.interestRatePct > 0 ? ' at ' + l.interestRatePct + '% flat' : ' interest-free'}
              </p>
            </div>
            <span class="chip" style={'color:' + stateTone(l.state) + ';border-color:' + stateTone(l.state) + '55;'}>
              {l.disbursedAt ? 'Recovering' : 'Not paid out yet'}
            </span>
          </div>

          <dl class="terms">
            <div><dt>Total repayable</dt><dd>{money(l.totalPayable, l.currency)}</dd></div>
            <div><dt>Recovered so far</dt><dd>{money(l.recovered, l.currency)} over {l.instalmentsPaid} run{l.instalmentsPaid === 1 ? '' : 's'}</dd></div>
            <div><dt>Still outstanding</dt><dd>{money(l.outstanding, l.currency)}</dd></div>
            <div><dt>Each run</dt><dd>{money(l.instalmentAmount, l.currency)}, from {MONTH_OPTIONS[l.startMonth - 1]?.l} {l.startYear}</dd></div>
          </dl>

          <div class="bar" aria-hidden="true">
            <span style={'width:' + Math.max(0, Math.min(100, l.totalPayable > 0 ? Math.round((l.recovered / l.totalPayable) * 100) : 0)) + '%;'}></span>
          </div>

          {!l.disbursedAt && (
            <div class="halt">
              <strong>Approved, but the money has not gone out.</strong>
              <span class="hint">
                Nothing is being deducted until a disbursement is recorded — a repayment for money
                that never arrived is not something this product will do. Pay it out through whatever
                this organisation uses, then record the reference here.
              </span>
              <form method="POST" class="decide" style="margin-top:10px;">
                <input type="hidden" name="action" value="disburse" />
                <input type="hidden" name="loan_id" value={l.id} />
                <input type="text" name="reference" required maxlength="300" placeholder="Where it was paid out — a reference somebody can follow" />
                <button type="submit" class="btn">Record disbursement</button>
              </form>
            </div>
          )}

          {l.disbursedAt && (
            <p class="sub" style="margin-top:10px;">
              Paid out {fmtDate(l.disbursedAt)}{l.disbursedReference ? ' — ' + l.disbursedReference : ''}
            </p>
          )}

          {(ledgers[l.id] || []).length > 0 && (
            <details class="ledger">
              <summary>Every repayment taken ({(ledgers[l.id] || []).length})</summary>
              <div class="scroller">
                <table>
                  <thead><tr><th>Period</th><th>Amount</th><th>Of which interest</th></tr></thead>
                  <tbody>
                    {(ledgers[l.id] || []).map((i: any) => (
                      <tr>
                        <td>{MONTH_OPTIONS[i.month - 1]?.l} {i.year}</td>
                        <td>{money(i.amount, l.currency)}</td>
                        <td>{money(i.interestPart, l.currency)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  )}

  <h2>Settled</h2>
  {settled.length === 0 ? (
    <div class="empty">Nothing has been settled yet.</div>
  ) : (
    <div class="stack">
      {settled.map((l: LoanRow) => (
        <div class="card">
          <div class="cardhead">
            <div>
              <p class="name">{l.employeeName || 'Employee'}</p>
              <p class="sub">
                {loanKindLabel(l.kind)} · {money(l.principal, l.currency)} · raised {fmtDate(l.createdAt)}
                {l.closedAt ? ' · cleared ' + fmtDate(l.closedAt) : ''}
              </p>
            </div>
            <span class="chip" style={'color:' + stateTone(l.state) + ';border-color:' + stateTone(l.state) + '55;'}>
              {loanStateLabel(l.state)}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
