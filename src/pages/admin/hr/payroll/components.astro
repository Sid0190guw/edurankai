---
// /admin/hr/payroll/components — THE SALARY COMPONENT CATALOGUE.
//
// This screen exists because the payroll run used to carry four statutory rates as constants:
//
//     const pfEmployee = Math.min(basic * 0.12, 1800);
//     const esicEmployee = gross < 21000 ? gross * 0.0075 : 0;
//     if (gross > 15000) professionalTax = 200;                 // "(Karnataka/Maharashtra standard)"
//
// and then printed them on employees' payslips under labels that stated the percentage. Provident
// fund, state insurance, professional tax and withholding are JURISDICTION-SPECIFIC. They change,
// they differ by state and by wage band, and this platform serves people in more than one country. A
// rate frozen in a source file is not the law; it is a guess wearing the law's clothes.
//
// So every component is configured here, by a person, with the rate THEY enter. The catalogue starts
// EMPTY and stays empty until somebody fills it in. There is deliberately no "add the usual Indian
// components" button — that would be the same hardcoding with one extra click.
//
// NOTHING ON THIS PAGE CLAIMS COMPLIANCE, and nothing may be added that does. Marking a component
// "statutory" groups it on the payslip and says nothing about whether it is correct.
//
// THE GATE. `payroll.manage` through can(), exactly as /admin/hr/payroll does — PERMS_BY_ROLE only,
// so a custom role holding the `payroll` SECTION checkbox (which passes middleware) is still refused
// here. This screen sets the numbers every salary is computed from.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  readComponents, saveComponent, setComponentActive,
  COMPONENT_KINDS, COMPONENT_BASES, KIND_LABELS, BASIS_LABELS,
  type PayrollComponent,
} from '@/lib/payroll';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'payroll.manage')) return Astro.redirect('/admin?denied=payroll');

// EVERY const BEFORE the POST handler that reads it. `const` is not hoisted, and a declaration below
// its first use throws on the first line of the handler while the page still reports success — the
// exact failure that took down apply step 5 and the /admin/roles/diagnose Repair button here.
let errorMsg = '';
let successMsg = '';

const num = (fd: FormData, key: string): number => {
  const n = Number(fd.get(key));
  return Number.isFinite(n) ? n : 0;
};
const optNum = (fd: FormData, key: string): number | null => {
  const raw = String(fd.get(key) || '').trim();
  if (!raw) return null;
  const n = Number(raw);
  return Number.isFinite(n) ? n : null;
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');

  if (action === 'save_component') {
    const res = await saveComponent({
      id: String(fd.get('id') || '') || null,
      code: String(fd.get('code') || ''),
      label: String(fd.get('label') || ''),
      kind: String(fd.get('kind') || 'earning'),
      basis: String(fd.get('basis') || 'fixed'),
      employeeValue: num(fd, 'employee_value'),
      employerValue: num(fd, 'employer_value'),
      capAmount: optNum(fd, 'cap_amount'),
      employerCapAmount: optNum(fd, 'employer_cap_amount'),
      minGross: optNum(fd, 'min_gross'),
      maxGross: optNum(fd, 'max_gross'),
      statutory: String(fd.get('statutory') || '') === 'on',
      jurisdictionNote: String(fd.get('jurisdiction_note') || ''),
      sortOrder: num(fd, 'sort_order') || 100,
      isActive: String(fd.get('is_active') || '') !== 'off',
    }, String(user.id));
    // NOT SWALLOWED: saveComponent logs the Postgres cause itself and hands back a sentence, which is
    // shown. A payroll write that fails quietly is a month of wrong pay.
    if (res.ok) successMsg = 'Component saved. It applies to every payroll run generated from now on.';
    else errorMsg = res.error || 'That component could not be saved.';
  } else if (action === 'toggle_component') {
    const res = await setComponentActive(
      String(fd.get('id') || ''),
      String(fd.get('active') || '') === '1',
      String(user.id),
    );
    if (res.ok) successMsg = 'Component updated. Payslips already issued are unchanged.';
    else errorMsg = res.error || 'That component could not be updated.';
  }
}

// readComponents(), NOT listComponents(). listComponents() logs a failed read and hands back an
// empty array, and every sentence this page prints over an empty array is a claim about the
// company's payroll: "No component is configured yet", "No statutory component is configured", and
// "a payroll run deducts no provident fund, no state insurance, no professional tax and no
// withholding". A pooler timeout said all three, word for word, over a catalogue that was there —
// and the reasonable act on reading them is to type the rates in again, which is how a component
// ends up recorded twice.
const catalogueRead = await readComponents({ includeInactive: true });
const components = catalogueRead.components;
const earnings = components.filter((c) => c.kind === 'earning');
const deductions = components.filter((c) => c.kind === 'deduction');
const activeStatutory = components.filter((c) => c.statutory && c.isActive);

const editId = new URL(Astro.request.url).searchParams.get('edit') || '';
const editing = components.find((c) => c.id === editId) || null;

// TYPED, not `any`. An `any` here loses the union on `basis` and BASIS_LABELS[c.basis] stops
// type-checking — which is exactly how a label lookup ends up silently rendering `undefined` for a
// basis somebody adds later.
const groups: { heading: string; list: PayrollComponent[] }[] = [
  { heading: 'Earnings', list: earnings },
  { heading: 'Deductions', list: deductions },
];
---
<AdminLayout title="Salary components — Payroll" activeNav="hr">
<div style="padding-bottom:80px;">

  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS &middot; Payroll</p>
    <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0 0 12px;">Salary components</h1>
    <div style="display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;">
      <a href="/admin/hr/payroll" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;">Payroll runs</a>
      <a href="/admin/hr/payroll/components" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#FF4F00;color:#fff;">Components</a>
      <a href="/admin/hr/payroll/claims" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;">Claims</a>
    </div>
  </div>

  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:11px 14px;font-size:13px;line-height:1.6;">{errorMsg}</div>}
  {successMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:11px 14px;font-size:13px;line-height:1.6;">{successMsg}</div>}

  <div style="padding:12px 16px;">

    <div style="background:rgba(255,159,0,0.07);border:1px solid rgba(255,159,0,0.22);border-radius:10px;padding:13px 15px;margin-bottom:14px;">
      <p style="font-size:12.5px;color:#fbbf24;margin:0;line-height:1.65;">
        <strong>These rates are yours, not ours.</strong> Provident fund, state insurance, professional
        tax and withholding differ by country, by state and by wage band, and they change. This product
        computes each of them from the rate you enter below and makes no claim that any of it is correct
        for your jurisdiction. Nothing here, and nothing on a payslip, is advice. Check the figures with
        whoever advises you before running a month.
      </p>
    </div>

    {!catalogueRead.ok && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:16px;margin-bottom:14px;">
        <p style="font-size:14px;font-weight:700;color:#fca5a5;margin:0;">The component catalogue could not be read</p>
        <p style="font-size:12.5px;color:#fca5a5;margin:8px 0 0;line-height:1.65;">
          This is not the same as an empty catalogue, and nothing below should be read as one. Whatever
          components exist are unchanged and still apply to a payroll run; this screen simply cannot see
          them right now, so do not re-enter a rate from here until the list loads. The database's own
          reason is in the server log.
        </p>
      </div>
    )}

    {catalogueRead.ok && activeStatutory.length === 0 && (
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;margin-bottom:14px;">
        <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">No statutory component is configured</p>
        <p style="font-size:12.5px;color:#8a8a94;margin:8px 0 0;line-height:1.65;">
          Until you add them, a payroll run deducts no provident fund, no state insurance, no
          professional tax and no withholding — the run does not assume any of them. Add one component
          per deduction your jurisdiction requires, with the rate it requires, and mark it statutory so
          it groups correctly on the payslip.
        </p>
        <p style="font-size:12.5px;color:#8a8a94;margin:8px 0 0;line-height:1.65;">
          Payslips generated before this screen existed were computed from rates written into the code
          and are unchanged; they are a record of what was paid.
        </p>
      </div>
    )}

    <!-- ADD / EDIT -->
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;margin-bottom:16px;">
      <p style="font-size:14px;font-weight:700;color:#fff;margin:0 0 4px;">{editing ? 'Edit component' : 'Add a component'}</p>
      <p style="font-size:11.5px;color:#8a8a94;margin:0 0 14px;line-height:1.6;">
        The label is printed on the payslip exactly as you write it. The code identifies the component
        for the rest of the system and cannot be changed casually once payslips reference it.
      </p>

      <form method="POST" style="display:flex;flex-direction:column;gap:10px;">
        <input type="hidden" name="action" value="save_component"/>
        {editing && <input type="hidden" name="id" value={editing.id}/>}

        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
          <div>
            <label for="f-code" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Code</label>
            <input id="f-code" name="code" required value={editing?.code || ''} placeholder="provident_fund" pattern="[a-z][a-z0-9_]{1,38}" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-sort" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Order on payslip</label>
            <input id="f-sort" name="sort_order" type="number" min="0" max="9999" value={editing?.sortOrder ?? 100} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
        </div>

        <div>
          <label for="f-label" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Label shown on the payslip</label>
          <input id="f-label" name="label" required maxlength="120" value={editing?.label || ''} placeholder="Provident fund (employee share)" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
        </div>

        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
          <div>
            <label for="f-kind" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Kind</label>
            <select id="f-kind" name="kind" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;">
              {COMPONENT_KINDS.map((k) => (<option value={k} selected={editing?.kind === k}>{KIND_LABELS[k]}</option>))}
            </select>
          </div>
          <div>
            <label for="f-basis" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Calculated as</label>
            <select id="f-basis" name="basis" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;">
              {COMPONENT_BASES.map((b) => (<option value={b} selected={editing?.basis === b}>{BASIS_LABELS[b]}</option>))}
            </select>
          </div>
        </div>
        <p style="font-size:11px;color:#8a8a94;margin:0;line-height:1.6;">
          An earning cannot be a percentage of gross, because it would be a percentage of a total it is
          itself part of. Use a percentage of basic, or a fixed amount.
        </p>

        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
          <div>
            <label for="f-ev" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Employee rate or amount</label>
            <input id="f-ev" name="employee_value" type="number" step="0.0001" min="0" value={editing?.employeeValue ?? 0} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-erv" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Employer share (0 for none)</label>
            <input id="f-erv" name="employer_value" type="number" step="0.0001" min="0" value={editing?.employerValue ?? 0} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-cap" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Employee cap (blank for none)</label>
            <input id="f-cap" name="cap_amount" type="number" step="0.01" min="0" value={editing?.capAmount ?? ''} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-ecap" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Employer cap (blank for none)</label>
            <input id="f-ecap" name="employer_cap_amount" type="number" step="0.01" min="0" value={editing?.employerCapAmount ?? ''} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-min" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Applies from gross</label>
            <input id="f-min" name="min_gross" type="number" step="0.01" min="0" value={editing?.minGross ?? ''} placeholder="blank = no lower limit" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
          <div>
            <label for="f-max" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Applies up to gross</label>
            <input id="f-max" name="max_gross" type="number" step="0.01" min="0" value={editing?.maxGross ?? ''} placeholder="blank = no upper limit" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
          </div>
        </div>

        <div>
          <label for="f-note" style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#8a8a94;margin-bottom:4px;">Your note on where this rate comes from</label>
          <input id="f-note" name="jurisdiction_note" maxlength="500" value={editing?.jurisdictionNote || ''} placeholder="Recorded for your own reference. Not checked or interpreted." style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;"/>
        </div>

        <label style="display:flex;align-items:center;gap:9px;color:#d8d8de;font-size:13px;min-height:44px;cursor:pointer;">
          <input type="checkbox" name="statutory" checked={editing?.statutory === true} style="width:18px;height:18px;"/>
          Group this with statutory deductions on the payslip
        </label>
        <label style="display:flex;align-items:center;gap:9px;color:#d8d8de;font-size:13px;min-height:44px;cursor:pointer;">
          <input type="checkbox" name="is_active" checked={editing ? editing.isActive : true} style="width:18px;height:18px;"/>
          Use this component in new payroll runs
        </label>

        <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:13px;border-radius:10px;cursor:pointer;min-height:44px;">{editing ? 'Save changes' : 'Add component'}</button>
        {editing && <a href="/admin/hr/payroll/components" style="text-align:center;color:#8a8a94;font-size:12.5px;text-decoration:none;min-height:44px;display:flex;align-items:center;justify-content:center;">Cancel and add a new one instead</a>}
      </form>
    </div>

    <!-- THE CATALOGUE -->
    {catalogueRead.ok && components.length === 0 && (
      <div style="text-align:center;padding:40px 16px;color:#8a8a94;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.7;"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M9 10v10"/></svg>
        <p style="font-size:13.5px;margin-top:10px;line-height:1.6;">No component is configured yet.</p>
        <p style="font-size:12.5px;margin-top:6px;line-height:1.6;">Until one is, a payroll run pays basic
        salary plus whatever fixed allowances are already on each salary structure, and deducts only
        loss of pay and any amount typed in by hand.</p>
      </div>
    )}

    {groups.map((g) => (
      g.list.length > 0 && (
        <div style="margin-bottom:16px;">
          <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#8a8a94;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 8px;">{g.heading}</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {g.list.map((c) => (
              <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:13px 14px;">
                <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
                  <div style="min-width:0;">
                    <p style="font-size:14px;font-weight:600;color:#fff;margin:0;overflow-wrap:anywhere;">{c.label}</p>
                    <p style="font-size:10.5px;color:#8a8a94;margin:3px 0 0;font-family:'Geist Mono',monospace;overflow-wrap:anywhere;">{c.code}</p>
                  </div>
                  <div style="display:flex;gap:6px;flex:0 0 auto;flex-wrap:wrap;justify-content:flex-end;">
                    {c.statutory && <span style="font-size:9px;font-weight:700;padding:3px 8px;border-radius:99px;background:rgba(99,102,241,0.15);color:#a5b4fc;text-transform:uppercase;">Statutory</span>}
                    <span style={`font-size:9px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;${c.isActive ? 'background:rgba(16,185,129,0.15);color:#6ee7b7;' : 'background:rgba(148,163,184,0.15);color:#94a3b8;'}`}>{c.isActive ? 'In use' : 'Retired'}</span>
                  </div>
                </div>
                <p style="font-size:12px;color:#8a8a94;margin:9px 0 0;line-height:1.6;">
                  {BASIS_LABELS[c.basis]} &middot; employee {c.employeeValue}{c.basis === 'fixed' ? '' : '%'}
                  {c.employerValue > 0 ? ' · employer ' + c.employerValue + (c.basis === 'fixed' ? '' : '%') : ''}
                  {c.capAmount !== null ? ' · capped at ' + c.capAmount : ''}
                  {c.minGross !== null ? ' · from gross ' + c.minGross : ''}
                  {c.maxGross !== null ? ' · up to gross ' + c.maxGross : ''}
                </p>
                {c.jurisdictionNote && <p style="font-size:11.5px;color:#8a8a94;margin:6px 0 0;line-height:1.6;">{c.jurisdictionNote}</p>}
                <div style="display:flex;gap:8px;margin-top:11px;flex-wrap:wrap;">
                  <a href={`/admin/hr/payroll/components?edit=${c.id}`} style="flex:1;min-width:110px;text-align:center;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;font-size:12.5px;font-weight:500;padding:11px;border-radius:8px;min-height:44px;display:flex;align-items:center;justify-content:center;">Edit</a>
                  <form method="POST" style="flex:1;min-width:110px;">
                    <input type="hidden" name="action" value="toggle_component"/>
                    <input type="hidden" name="id" value={c.id}/>
                    <input type="hidden" name="active" value={c.isActive ? '0' : '1'}/>
                    <button type="submit" style="width:100%;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;font-size:12.5px;font-weight:500;padding:11px;border-radius:8px;cursor:pointer;min-height:44px;">{c.isActive ? 'Retire' : 'Put back in use'}</button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    ))}
  </div>
</div>
</AdminLayout>
