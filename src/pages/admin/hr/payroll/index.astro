---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { db } from '@/lib/db';
import { sql as sqlExpr } from 'drizzle-orm';
// THE STATUTORY RATES ARE NO LONGER IN THIS FILE.
//
// This page used to compute every payslip from four constants — `basic * 0.12` capped at 1800 for
// provident fund, `gross * 0.0075` below a gross of 21000 for state insurance, and a professional tax
// of 200 or 150 by band, commented "(Karnataka/Maharashtra standard)". Those are jurisdiction-specific
// rules that change, that differ by state and by wage band, and that were being printed on employees'
// payslips with the percentage next to them as though this product could stand behind them.
//
// generateRun() in src/lib/payroll.ts now builds each payslip from components an administrator
// configures at /admin/hr/payroll/components, with the rates THEY entered. The catalogue starts empty
// and there is no button that offers to fill in a country's rates.
//
// THE CONSEQUENCE IS REAL AND IS STATED ON SCREEN BELOW: until statutory components are configured, a
// new run deducts none of them, so net pay is higher than a run generated before this change. That is
// visible on this page, not silent.
import { generateRun, computePay, listComponents, MONTH_NAMES as PAYROLL_MONTHS } from '@/lib/payroll';
// safeRows keeps "there are no payroll runs" apart from "we could not read the payroll runs" —
// on this screen the second one, rendered as the first, invites somebody to generate a duplicate
// month. clip/confirmAttr keep a long or apostrophe-bearing name from breaking a card or a prompt.
import { safeRows, clip, confirmAttr, dbReason, pageParam } from '@/lib/page-safety';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
// THE GATE — payroll.manage, granted in PERMS_BY_ROLE to exactly super_admin and hr, which is the
// literal list `['super_admin','hr']` this line used to spell out. Same two accounts, named by what
// they may do.
//
// DELIBERATELY NOT canAccessSection(user, 'payroll', 'edit'), the pattern /admin/finance uses. A
// custom role granted the `payroll` section passes the middleware section gate (middleware.ts:59)
// and is then refused HERE, so it has no access today; canAccessSection() would ADMIT it, and this
// screen reads and writes base_salary. can() reads PERMS_BY_ROLE only and cannot be widened by a
// section checkbox.
//
// The `role === 'applicant'` line that used to sit above went with the conversion: middleware.ts:311
// redirects every applicant off every /admin path before this frontmatter runs, and can() answers
// false for `applicant` anyway (its permission list is empty), so the guard was dead twice over.
if (!can(user as any, 'payroll.manage')) return Astro.redirect('/admin?denied=payroll');

let errorMsg = '';
let successMsg = '';

// Payroll decisions and salary changes are money decisions: they must leave a trail. Nothing
// under /admin/hr wrote to audit_log, so a salary could be changed and there was no record of
// who changed it, when, or from what.
async function audit(userId: string, action: string, entityId: string, diff: Record<string, unknown>) {
  try {
    const { logAudit } = await import('@/lib/audit');
    await logAudit({ userId, action, entity: 'hr_payroll', entityId, diff });
  } catch (_) {}
}

const currentMonth = new Date().getMonth() + 1;
const currentYear = new Date().getFullYear();

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (action === 'create_run') {
      const month = parseInt(fd.get('month') as string);
      const year = parseInt(fd.get('year') as string);
      const notes = (fd.get('notes') as string || '').trim();

      // Loss-of-pay columns. Additive and idempotent, matching how the rest of the HR schema
      // provisions itself; see db/hr-schema.sql for the full canonical definition.
      await db.execute(sqlExpr`ALTER TABLE hr_payslips ADD COLUMN IF NOT EXISTS lop_days NUMERIC(6,2) NOT NULL DEFAULT 0`).catch(() => {});
      await db.execute(sqlExpr`ALTER TABLE hr_payslips ADD COLUMN IF NOT EXISTS lop_deduction NUMERIC(14,2) NOT NULL DEFAULT 0`).catch(() => {});

      // ONE CALL, and every rate in it came from the component catalogue rather than from this file.
      // generateRun() is idempotent on (month, year), refuses a second run for a period that already
      // has one, and reports per-employee failures by name instead of aborting the whole month or
      // hiding them.
      const run = await generateRun(month, year, String(user.id), notes);
      if (!run.ok) {
        errorMsg = run.error || 'That payroll run could not be created.';
      } else {
        const parts = [
          `Payroll run created for ${PAYROLL_MONTHS[month - 1]} ${year} with ${run.employees} employee${run.employees === 1 ? '' : 's'}.`,
          `Total net ₹${Math.round(run.totalNet).toLocaleString('en-IN')}.`,
        ];
        if (run.failed.length) {
          parts.push(`${run.failed.length} employee${run.failed.length === 1 ? ' was' : 's were'} left out because their payslip could not be written: ${run.failed.join(', ')}. Nobody was paid a wrong amount — they simply have no payslip in this run.`);
        }
        if (run.noStatutoryComponents) {
          parts.push('No statutory component is configured, so this run deducted no provident fund, state insurance, professional tax or withholding. Configure them under Components if your jurisdiction requires them, then regenerate.');
        }
        // THE LEDGER WARNINGS ARE NOT OPTIONAL READING, so they go in the ERROR slot rather than
        // being folded into the success sentence. A payslip that deducted a loan repayment or paid a
        // bonus which never reached its ledger is the one class of failure in this run somebody has
        // to repair by hand: the loan balance stays high and the person is charged again next month,
        // or a one-off bonus pays a second time.
        if (run.ledgerWarnings.length) {
          errorMsg = run.ledgerWarnings.length + ' thing'
            + (run.ledgerWarnings.length === 1 ? '' : 's')
            + ' on this run need checking by hand. ' + run.ledgerWarnings.join(' ');
        }
        successMsg = parts.join(' ');
      }
    } else if (action === 'approve_run') {
      const runId = fd.get('runId') as string;
      // THE WRITE RE-STATES THE PRECONDITION THE BUTTON WAS DRAWN UNDER.
      //
      // This was `WHERE id = ${runId}` with nothing else, and its result was never looked at. Two
      // consequences, both reachable with one finger:
      //   * This page renders its flash on the POST RESPONSE — there is no redirect — so a browser
      //     refresh re-submits. Re-posting Approve against a run already marked PAID walked it
      //     backwards to 'approved' and every payslip from 'paid' to 'approved', while paid_at
      //     stayed set: a console showing money as not yet paid that had already left the account.
      //   * It printed "Payroll run approved." whether or not any row matched, so a runId for a run
      //     that had been deleted, or that somebody else had just approved, read as success.
      //
      // `AND status = 'draft'` makes the second press match nothing, and RETURNING makes that
      // visible instead of silent.
      const appRows = await db.execute(sqlExpr`
        UPDATE hr_payroll_runs SET status = 'approved', approved_by = ${user.id}, approved_at = NOW()
        WHERE id = ${runId} AND status = 'draft'
        RETURNING id, month, year
      `);
      const approved = (Array.isArray(appRows) ? appRows : ((appRows as any)?.rows || [])) as any[];
      if (!approved.length) {
        // Say WHICH of the two it is. "Nothing happened" is not a message somebody can act on.
        const cur = await db.execute(sqlExpr`SELECT status FROM hr_payroll_runs WHERE id = ${runId}`);
        const curRow = ((Array.isArray(cur) ? cur : ((cur as any)?.rows || [])) as any[])[0];
        errorMsg = curRow
          ? 'Nothing was approved: that run is already ' + String(curRow.status || 'in an unknown state')
            + ', and only a draft can be approved. If you meant to pay it, use Mark Paid.'
          : 'Nothing was approved: there is no payroll run with that id any more. Reload the page.';
      } else {
        // Payslips follow the run, and only the ones still in the state the run just left.
        await db.execute(sqlExpr`UPDATE hr_payslips SET status = 'approved' WHERE payroll_run_id = ${runId} AND status = 'draft'`);
        await audit(user.id, 'hr.payroll.approved', runId, {});
        successMsg = 'Payroll run approved for ' + (PAYROLL_MONTHS[(approved[0].month || 1) - 1] || '?') + ' ' + approved[0].year + '.';
      }
    } else if (action === 'mark_paid') {
      const runId = fd.get('runId') as string;
      // SAME GUARD, AND IT MATTERS MORE HERE. Re-posting this (a refresh of the POST response)
      // rewrote paid_at = NOW() on the run AND on every payslip, destroying the date the money
      // actually moved — the one field a payroll question three months later turns on. With
      // `AND status = 'approved'` the second press matches nothing and the original date stands.
      const runPaidRes = await db.execute(sqlExpr`
        UPDATE hr_payroll_runs SET status = 'paid', paid_at = NOW()
        WHERE id = ${runId} AND status = 'approved'
        RETURNING id
      `);
      const paidNow = (Array.isArray(runPaidRes) ? runPaidRes : ((runPaidRes as any)?.rows || [])) as any[];
      if (!paidNow.length) {
        const cur = await db.execute(sqlExpr`SELECT status, paid_at FROM hr_payroll_runs WHERE id = ${runId}`);
        const curRow = ((Array.isArray(cur) ? cur : ((cur as any)?.rows || [])) as any[])[0];
        errorMsg = curRow
          ? (String(curRow.status) === 'paid'
              ? 'That run was already marked paid' + (curRow.paid_at ? ' on ' + new Date(curRow.paid_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '')
                + '. Nothing was changed and that date has not been overwritten. If a wallet is still empty, credit it from Payouts.'
              : 'Nothing was marked paid: that run is ' + String(curRow.status || 'in an unknown state')
                + ', and only an approved run can be paid.')
          : 'Nothing was marked paid: there is no payroll run with that id any more. Reload the page.';
      } else {
      await db.execute(sqlExpr`UPDATE hr_payslips SET status = 'paid', paid_at = NOW() WHERE payroll_run_id = ${runId} AND status <> 'paid'`);

      // Money must actually land somewhere. Marking a run paid used to change two status columns
      // and stop, so wallet balances stayed at zero no matter how many months had been paid and
      // employees had nothing to withdraw. Credit the ledger here; the call is idempotent by
      // payslip ref, so re-clicking Mark Paid cannot pay anyone twice.
      let payoutMsg = '';
      // Which employees' money is actually in the ledger. Only these people may be told their
      // salary was credited; everybody else is told the truth instead (see the notify block below).
      let walletOk = new Set<string>();
      let walletCreditFailed = false;
      try {
        const { creditPayrollRun } = await import('@/lib/hr-wallet');
        const res = await creditPayrollRun(runId, user.id);
        walletOk = new Set(res.walletOk.map(String));
        // "NOTHING TO DO" AND "NOTHING WORKED" MUST NOT READ THE SAME.
        // This used to be `credited > 0 ? "...credited" : "Wallets were already credited for this
        // run."` — so a total failure of the credit step (which returned credited:0 with its error
        // swallowed) printed as reassurance while every employee was pushed "credited to your wallet".
        const bits: string[] = [];
        if (res.credited > 0) bits.push(`${res.credited} wallet${res.credited === 1 ? '' : 's'} credited (₹${Math.round(res.total).toLocaleString('en-IN')})`);
        if (res.alreadyCredited > 0) bits.push(`${res.alreadyCredited} ${res.alreadyCredited === 1 ? 'was' : 'were'} already credited by an earlier run of this step`);
        if (res.credited === 0 && res.alreadyCredited === 0) bits.push('no wallet was credited');
        payoutMsg = ' ' + bits.join('; ') + '.';
        if (res.failures.length) {
          walletCreditFailed = true;
          errorMsg = res.failures.length + ' salary payment' + (res.failures.length === 1 ? '' : 's')
            + ' did NOT reach a wallet, so ' + (res.failures.length === 1 ? 'that person has' : 'those people have')
            + ' nothing to withdraw even though the run is marked paid. Credit them by hand from Payouts. '
            + res.failures.join(' ');
        }
        await audit(user.id, 'hr.payroll.paid', runId, { credited: res.credited, alreadyCredited: res.alreadyCredited, total: res.total, failed: res.failures.length });
      } catch (e: any) {
        // The real Postgres reason is on `.cause`; `.message` is only the failed SQL.
        console.error('[payroll] creditPayrollRun failed for run', runId, '-', e?.cause?.message || e?.message);
        walletCreditFailed = true;
        payoutMsg = '';
        errorMsg = 'The run is marked paid but NO wallet was credited, so nobody can withdraw anything: '
          + (e?.cause?.message || e?.message || 'unknown database error')
          + ' Credit the wallets from Payouts before telling anyone they have been paid.';
      }
      successMsg = 'Payroll marked as paid.' + payoutMsg;

      // The entire HR module sent no notifications of any kind, so being paid was silent: money
      // landed in the wallet and nobody was told. Notify each paid employee who has a linked
      // portal account, plus the other admins. All guarded — the enclosing catch would otherwise
      // report a failure for a run that has already been marked paid and credited.
      try {
        const { sendPushToUser, sendPushToAdmins } = await import('@/lib/push');
        // `p.net_pay` — the column this used to select DOES NOT EXIST. hr_payslips carries
        // `net_salary` (db/hr-schema.sql:262); there has never been a net_pay. So this statement threw
        // `column p.net_pay does not exist` on every run, the bare `catch (_) {}` around the block
        // swallowed it, and NOBODY was ever notified that they had been paid — while the page reported
        // success. The column name is fixed and the value is aliased so the reader below is unchanged.
        const paidRows = await db.execute(sqlExpr`
          SELECT e.id AS employee_id, e.user_id, p.net_salary AS net_pay
          FROM hr_payslips p
          JOIN hr_employees e ON e.id = p.employee_id
          WHERE p.payroll_run_id = ${runId} AND e.user_id IS NOT NULL`);
        const paid = (Array.isArray(paidRows) ? paidRows : ((paidRows as any)?.rows || [])) as any[];
        let notified = 0;
        const notifyFailed: string[] = [];
        for (const row of paid) {
          // NEVER TELL SOMEBODY THEIR MONEY ARRIVED WHEN IT DID NOT. Every employee on the run used
          // to be pushed "has been credited to your wallet" regardless of what the wallet step
          // actually did — the single most misleading message this module can send.
          const inWallet = walletOk.has(String(row.employee_id));
          const amount = row.net_pay != null ? 'Rs ' + Math.round(Number(row.net_pay)).toLocaleString('en-IN') : null;
          try {
            await sendPushToUser(row.user_id, {
              type: 'payroll_run',
              title: inWallet ? 'Salary credited' : 'Payslip ready',
              body: inWallet
                ? (amount
                    ? 'Your payslip is ready and ' + amount + ' has been credited to your wallet.'
                    : 'Your payslip is ready and your salary has been credited to your wallet.')
                : (amount
                    ? 'Your payslip for this run is ready (' + amount + '). The wallet credit has not gone through yet — HR is completing it.'
                    : 'Your payslip for this run is ready. The wallet credit has not gone through yet — HR is completing it.'),
              url: '/portal/employee',
              tag: 'payroll-' + runId,
            });
            notified++;
          } catch (e: any) {
            // Non-fatal — the run IS paid and must not roll back — but never silent.
            console.error('[payroll] could not notify user', row.user_id, '-', e?.cause?.message || e?.message);
            notifyFailed.push(String(row.user_id));
          }
        }
        if (notifyFailed.length) {
          errorMsg = (errorMsg ? errorMsg + ' ' : '')
            + notifyFailed.length + ' employee' + (notifyFailed.length === 1 ? '' : 's')
            + ' could not be notified that payroll was run. Tell them another way.';
        }
        await sendPushToAdmins({
          type: 'payroll_run',
          title: 'Payroll marked paid',
          body: notified + ' of ' + paid.length + ' employee' + (paid.length === 1 ? '' : 's') + ' notified.'
            + (walletCreditFailed ? ' WALLET CREDIT INCOMPLETE — check Payouts.' : payoutMsg.trim()),
          url: '/admin/hr/payroll',
          tag: 'payroll-admin-' + runId,
        }, user.id);
      } catch (e: any) {
        // WAS `catch (_) {}`. The run is already paid and credited, so this cannot abort — but an
        // admin who is not told that nobody was notified will assume everyone knows.
        console.error('[payroll] notification step failed for run', runId, '-', e?.cause?.message || e?.message);
        errorMsg = (errorMsg ? errorMsg + ' ' : '')
          + 'Payroll is marked paid, but the notifications could not be sent, so no employee has been told. ('
          + (e?.cause?.message || e?.message || 'unknown error') + ')';
      }
      } // end of the "this press actually moved the run from approved to paid" branch
    } else if (action === 'update_salary') {
      const empId = fd.get('empId') as string;
      const basic = parseFloat(fd.get('basic') as string || '0');
      const hra = parseFloat(fd.get('hra') as string || '0');
      const da = parseFloat(fd.get('da') as string || '0');
      const specialAllowance = parseFloat(fd.get('specialAllowance') as string || '0');
      const transportAllowance = parseFloat(fd.get('transportAllowance') as string || '0');
      const medicalAllowance = parseFloat(fd.get('medicalAllowance') as string || '0');
      const otherAllowances = parseFloat(fd.get('otherAllowances') as string || '0');
      const tds = parseFloat(fd.get('tds') as string || '0');
      const currency = (fd.get('currency') as string || 'INR').trim();

      const gross = basic + hra + da + specialAllowance + transportAllowance + medicalAllowance + otherAllowances;

      // THE THREE HARDCODED STATUTORY FORMULAS THAT USED TO SIT HERE ARE GONE. They were
      // `Math.min(basic * 0.12, 1800)`, `gross < 21000 ? gross * 0.0075 : 0` and a professional tax
      // of 200/150 by band — jurisdiction-specific rules, written into a page, stamped onto a salary
      // record. Those three columns are now written as ZERO on the structure, because this form does
      // not know them: statutory deductions are components, they are configured at
      // /admin/hr/payroll/components, and they are applied when a run is generated.
      //
      // `tds` and `other_deductions` stay on the structure, because a human types those in here.
      const pfEmployee = 0;
      const esicEmployee = 0;
      const professionalTax = 0;
      const totalDed = tds;
      const net = gross - totalDed;

      // Capture what the salary WAS, so the audit entry records the change and not just the result.
      let prev: any = null;
      try {
        const p = await db.execute(sqlExpr`SELECT gross_salary, net_salary, currency FROM hr_salary_structures
          WHERE employee_id = ${empId} AND effective_to IS NULL ORDER BY effective_from DESC LIMIT 1`);
        prev = (Array.isArray(p) ? p : (p as any)?.rows || [])[0] || null;
      } catch (_) {}

      // Close existing structure
      await db.execute(sqlExpr`
        UPDATE hr_salary_structures SET effective_to = CURRENT_DATE - INTERVAL '1 day'
        WHERE employee_id = ${empId} AND effective_to IS NULL
      `);

      // Insert new structure
      await db.execute(sqlExpr`
        INSERT INTO hr_salary_structures (
          employee_id, effective_from, currency,
          basic, hra, da, special_allowance, transport_allowance, medical_allowance,
          other_allowances, gross_salary, pf_employee, esic_employee,
          professional_tax, tds, total_deductions, net_salary, created_by
        ) VALUES (
          ${empId}, CURRENT_DATE, ${currency},
          ${basic}, ${hra}, ${da}, ${specialAllowance}, ${transportAllowance}, ${medicalAllowance},
          ${otherAllowances}, ${gross}, ${pfEmployee}, ${esicEmployee},
          ${professionalTax}, ${tds}, ${totalDed}, ${net}, ${user.id}
        )
      `);

      // Update base salary on employee
      await db.execute(sqlExpr`UPDATE hr_employees SET base_salary = ${gross}, currency = ${currency} WHERE id = ${empId}`);
      await audit(user.id, 'hr.salary.updated', empId, {
        from: prev ? { gross: Number(prev.gross_salary || 0), net: Number(prev.net_salary || 0), currency: prev.currency } : null,
        to: { gross, net, currency },
      });
      // The honest net, computed the way a real run will compute it — through the component engine
      // against the structure that has just been written — rather than by repeating a formula here.
      // Reporting a net that a run would not reproduce is how a salary conversation goes wrong.
      const preview = await computePay(empId, { month: currentMonth, year: currentYear });
      successMsg = `Salary structure updated. Gross ${currency} ${gross.toLocaleString('en-IN')}; `
        + `net ${preview.currency} ${preview.net.toLocaleString('en-IN')} after the components configured today`
        + (preview.noStatutoryComponents ? ' (no statutory component is configured, so none was deducted).' : '.');
    }
  } catch (err: any) {
    // `.message` on a drizzle/postgres-js error is only the failed SQL text; the reason is on `.cause`.
    // Printing the SQL to an admin and dropping the reason on the floor is how these faults survive.
    const real = err?.cause?.message || err?.message;
    console.error('[payroll] action failed -', real, err?.message);
    errorMsg = 'Error: ' + (real || 'Unknown');
  }
}

const url = new URL(Astro.request.url);
const tab = url.searchParams.get('tab') || 'runs';
const selectedRunId = url.searchParams.get('run') || '';

// THE CREATE-RUN SHEET IS OPENED BY A URL, NOT BY JAVASCRIPT.
//
// "+ Run Payroll" used to be a <button onclick="...style.display='flex'">. On a mid-range phone on a
// weak connection — which is most of the people who open this — the page paints long before that
// inline handler is live, and until it is, the only control that starts a payroll run does nothing
// when tapped. No error, no spinner: a dead button. The same failure that hid clock-in.
//
// It is now a link to ?new=1 and the sheet is rendered open by the server. It works with no
// JavaScript at all, it survives a back button, and it can be linked to.
const showRunModal = url.searchParams.get('new') === '1';
/** Where the sheet's Cancel/close returns to — the tab you were on, without ?new. */
const runModalBack = '?tab=' + encodeURIComponent(tab) + (selectedRunId ? '&run=' + encodeURIComponent(selectedRunId) : '');

// EVERY READ BELOW WAS A BARE TOP-LEVEL AWAIT. On a database where hr_payroll_runs or
// hr_salary_structures has not been created — which is the state of every fresh deployment, and the
// state this page is most likely to be opened in first — the whole console answered with an
// unexplained 500 rather than with the sentence that would have told somebody what to do.
//
// Failing SOFT is only half the fix. A `catch (_) { [] }` here would render "No payroll runs yet"
// over a read that failed, and the button under that message creates a run. Both facts are carried.

// Payroll runs
const runsRes = await safeRows('[payroll] run list', () =>
  db.execute(sqlExpr`SELECT * FROM hr_payroll_runs ORDER BY year DESC, month DESC LIMIT 24`));
const runRows = runsRes.rows;

// Payslips for selected run. PAGED: a run for a few thousand employees rendered every payslip card
// into one column, and this is the tab HR opens on a phone the morning after a run.
const PAYSLIP_PER_PAGE = 50;
const payslipCountRes = selectedRunId
  ? await safeRows('[payroll] payslip count', () => db.execute(
      sqlExpr`SELECT COUNT(*)::int AS n FROM hr_payslips WHERE payroll_run_id = ${selectedRunId}`))
  : null;
const payslipTotal = payslipCountRes && payslipCountRes.ok ? Number(payslipCountRes.rows[0]?.n ?? 0) : 0;
const payslipPages = Math.max(1, Math.ceil(payslipTotal / PAYSLIP_PER_PAGE));
const payslipPage = pageParam(url.searchParams.get('p'), payslipPages);
const payslipsRes = selectedRunId ? await safeRows('[payroll] payslips for run', () => db.execute(sqlExpr`
  SELECT ps.*, e.full_name, e.employee_code, e.designation
  FROM hr_payslips ps
  JOIN hr_employees e ON ps.employee_id = e.id
  WHERE ps.payroll_run_id = ${selectedRunId}
  ORDER BY e.full_name
  LIMIT ${PAYSLIP_PER_PAGE} OFFSET ${(payslipPage - 1) * PAYSLIP_PER_PAGE}
`)) : null;
const payslipRows = payslipsRes ? payslipsRes.rows : null;

const selectedRun = selectedRunId ? runRows.find((r: any) => String(r.id) === selectedRunId) : null;
/** A run id in the URL that is not in the (latest 24) list. Not the same as "no run selected". */
const selectedRunMissing = !!selectedRunId && !selectedRun && runsRes.ok;

// Employees for salary setup
const EMPLOYEE_LIMIT = 100;
const employeesRes = await safeRows('[payroll] salary setup list', () => db.execute(sqlExpr`
  SELECT e.id, e.full_name, e.employee_code, e.base_salary, e.currency,
    ss.basic, ss.hra, ss.da, ss.special_allowance, ss.transport_allowance,
    ss.medical_allowance, ss.other_allowances, ss.gross_salary, ss.net_salary, ss.tds
  FROM hr_employees e
  LEFT JOIN hr_salary_structures ss ON ss.employee_id = e.id
    AND ss.effective_from <= NOW() AND (ss.effective_to IS NULL OR ss.effective_to >= NOW())
  WHERE e.is_active = true
  ORDER BY e.full_name
  LIMIT ${EMPLOYEE_LIMIT}
`));
const employeeRows = employeesRes.rows;

// What a run will actually apply. Read AFTER the POST handler so a component saved elsewhere in this
// request is reflected, and used only to state a fact on screen — it decides nothing.
//
// listComponents() swallows its own failure and returns [] (src/lib/payroll.ts safeEnsure), so a
// zero here means EITHER nothing is configured OR the catalogue could not be read. The banner below
// says "no statutory component is configured" in both cases, which is a claim this page cannot
// actually make. componentsReadOk records which it was.
let componentsReadOk = true;
let activeComponents: Awaited<ReturnType<typeof listComponents>> = [];
try {
  activeComponents = await listComponents();
} catch (e: any) {
  componentsReadOk = false;
  console.error('[payroll] component catalogue could not be read -', dbReason(e));
}
const statutoryConfigured = activeComponents.filter((c) => c.statutory).length;

// One banner naming every read that did not answer.
const readFailures: string[] = [];
if (!runsRes.ok) readFailures.push('the list of payroll runs');
if (payslipsRes && !payslipsRes.ok) readFailures.push('the payslips on the selected run');
if (payslipCountRes && !payslipCountRes.ok) readFailures.push('how many payslips that run carries');
if (!employeesRes.ok) readFailures.push('the employees on Salary Setup');
if (!componentsReadOk) readFailures.push('the salary component catalogue');
const firstReadError = runsRes.error || (payslipsRes && payslipsRes.error) || employeesRes.error || null;

const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function fmt(n: any) {
  if (!n || n == 0) return '0';
  return parseFloat(n).toLocaleString('en-IN');
}
---
<AdminLayout title="Payroll — HRMS" activeNav="hr">
<div style="padding-bottom:80px;">

  <!-- Header -->
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS · Payroll</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Payroll</h1>
      </div>
      <a href="?tab=runs&new=1" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:12px;padding:0 14px;border-radius:8px;cursor:pointer;text-decoration:none;min-height:44px;display:inline-flex;align-items:center;white-space:nowrap;">+ Run Payroll</a>
    </div>

    {/* Tabs. Three labels at their natural width are wider than a 320px phone, and this strip sits
        in the sticky header, so the overflow used to widen the whole PAGE. The strip now scrolls
        inside its own container and the labels keep their full width instead of squashing. */}
    <div style="display:flex;gap:4px;overflow-x:auto;-webkit-overflow-scrolling:touch;">
      {[['runs','Payroll Runs'],['payslips','Payslips'],['salary','Salary Setup']].map(([t, label]) => (
        <a href={`?tab=${t}`} style={`flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;min-height:44px;display:inline-flex;align-items:center;${tab === t ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>{label}</a>
      ))}
      {/* THE TWO SURFACES THIS PHASE ADDED. Both gated at their own door — Components on
          payroll.manage (the same key as this page), Claims on expenses.review — so a link here is
          never wider than what the destination admits. */}
      <a href="/admin/hr/payroll/components" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;min-height:44px;display:inline-flex;align-items:center;">Components</a>
      <a href="/admin/hr/payroll/claims" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;min-height:44px;display:inline-flex;align-items:center;">Claims</a>
    </div>
  </div>

  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {successMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{successMsg}</div>}

  {/* WHAT COULD NOT BE READ, ON THE SCREEN THAT CREATES PAYROLL RUNS. Without this, a failed read
      of hr_payroll_runs renders as "No payroll runs yet" directly above a button that creates one —
      and generateRun() refuses a second run for a period that already has one, so the person is
      told the month exists after being told it does not. */}
  {readFailures.length > 0 && (
    <div style="margin:12px 16px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:12.5px;line-height:1.6;">
      <strong style="color:#fecaca;">Part of this page could not be read, so what is blank below is unknown rather than empty.</strong>
      Not read: {readFailures.join('; ')}. Do not generate a run on the strength of an empty list here —
      check the month first.
      {firstReadError && <span style="display:block;margin-top:6px;color:#f87171;font-family:'Geist Mono',monospace;font-size:11px;overflow-wrap:anywhere;">{clip(firstReadError, 300)}</span>}
    </div>
  )}

  <!-- PAYROLL RUNS TAB -->
  {tab === 'runs' && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:8px;">
      {/* WHAT THIS RUN WILL AND WILL NOT DEDUCT, said before anybody presses the button. The rates
          that used to live in this file are gone; a run now applies exactly the components that have
          been configured, and none is assumed. */}
      {/* THREE STATES, NOT TWO. "No statutory component is configured" is a claim about the
          catalogue; listComponents() returns [] both when the catalogue is empty AND when the read
          of it failed, and this banner used to assert the first for both. */}
      <div style={`border-radius:10px;padding:12px 14px;margin-bottom:4px;${!componentsReadOk ? 'background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.3);' : statutoryConfigured === 0 ? 'background:rgba(255,159,0,0.07);border:1px solid rgba(255,159,0,0.22);' : 'background:#0f0f14;border:1px solid #1a1a1f;'}`}>
        <p style={`font-size:12.5px;margin:0;line-height:1.65;${!componentsReadOk ? 'color:#fca5a5;' : statutoryConfigured === 0 ? 'color:#fbbf24;' : 'color:#8a8a94;'}`}>
          {!componentsReadOk
            ? 'The salary component catalogue could not be read, so this page cannot say what a run would deduct. It is NOT saying that nothing is configured. Do not generate a run until this loads.'
            : statutoryConfigured === 0
            ? 'No statutory component is configured, so a run generated now deducts no provident fund, state insurance, professional tax or withholding — the run assumes none of them. Those rates are jurisdiction-specific and this product makes no claim about what yours requires.'
            : statutoryConfigured + ' statutory component' + (statutoryConfigured === 1 ? '' : 's') + ' configured, plus ' + (activeComponents.length - statutoryConfigured) + ' other component' + ((activeComponents.length - statutoryConfigured) === 1 ? '' : 's') + '. Every rate is the one you entered; nothing here is advice on what your jurisdiction requires.'}
          <a href="/admin/hr/payroll/components" style="color:#FF7040;"> Open components</a>.
        </p>
      </div>
      {/* "No payroll runs yet" over a FAILED read is the worst sentence this page can print: the
          only button next to it creates a run, and a duplicate run recovers loan instalments and
          pays bonuses a second time. */}
      {!runsRes.ok && (
        <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:16px;color:#fca5a5;font-size:13px;line-height:1.65;">
          The payroll runs could not be read, so none is listed. There may be a run for this month
          already — this page does not know. Do not press "+ Run Payroll" until this list loads.
        </div>
      )}
      {runsRes.ok && runRows.length === 0 && (
        <div style="text-align:center;padding:48px;color:#6e6e78;">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;opacity:0.7;"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
          <p style="font-size:13px;">No payroll runs yet</p>
          <p style="font-size:12px;margin-top:4px;">This list was read successfully and is genuinely empty.</p>
          <p style="font-size:12px;margin-top:4px;">Click "+ Run Payroll" to create your first payroll run</p>
        </div>
      )}
      {runRows.map(run => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
          <div style="padding:12px 14px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
              <div>
                <p style="font-size:15px;font-weight:700;color:#fff;margin:0;">{MONTH_NAMES[(run.month || 1) - 1]} {run.year}</p>
                <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;">{run.total_employees} employees</p>
              </div>
              <span style={`font-size:10px;font-weight:700;padding:3px 8px;border-radius:100px;text-transform:uppercase;${run.status === 'paid' ? 'background:rgba(16,185,129,0.15);color:#6ee7b7;' : run.status === 'approved' ? 'background:rgba(99,102,241,0.15);color:#a5b4fc;' : 'background:rgba(251,191,36,0.15);color:#fbbf24;'}`}>
                {run.status}
              </span>
            </div>
            {/* Company-wide totals, so these are the largest numbers on the page: a crore-scale
                gross is "₹12,50,00,000" and has no space to break at. Three fixed tracks on a 360px
                phone left each tile ~96px wide, so the figure spilled over its neighbour and was
                then cut off by the card's overflow:hidden. These three tiles are independent of one
                another, so they can REFLOW rather than scroll: auto-fit keeps three across on a
                normal phone and wider, and drops to two on a narrow one instead of clipping.
                overflow-wrap is the last resort for a figure too long for even a reflowed tile. */}
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:6px;margin-bottom:10px;">
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Gross</p>
                <p style="font-size:12px;font-weight:600;color:#fff;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_gross)}</p>
              </div>
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Deductions</p>
                <p style="font-size:12px;font-weight:600;color:#fca5a5;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_deductions)}</p>
              </div>
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Net Pay</p>
                <p style="font-size:12px;font-weight:600;color:#6ee7b7;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_net)}</p>
              </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <a href={`?tab=payslips&run=${run.id}`} style="flex:1;text-align:center;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;font-size:12px;font-weight:500;padding:7px;border-radius:6px;min-width:80px;">
                View Payslips
              </a>
              {/* BOTH CONSEQUENTIAL BUTTONS NOW NAME WHAT THEY ARE ABOUT TO DO. Approve had no
                  confirmation at all, and Mark Paid asked "Mark this payroll as paid?" without saying
                  WHICH payroll, for how many people, or how much — a prompt with nothing in it to
                  check is a prompt that gets dismissed. On a phone these two sit side by side and are
                  seven pixels apart. */}
              {run.status === 'draft' && (
                <form method="POST" style="flex:1;min-width:120px;" onsubmit={confirmAttr(
                  'Approve the ' + (MONTH_NAMES[(run.month || 1) - 1] || 'unknown month') + ' ' + run.year
                  + ' payroll run? This fixes ' + (run.total_employees ?? 0) + ' payslip'
                  + (Number(run.total_employees) === 1 ? '' : 's') + ' totalling ' + fmt(run.total_net)
                  + ' net and is what Mark Paid then pays out.')}>
                  <input type="hidden" name="action" value="approve_run" />
                  <input type="hidden" name="runId" value={run.id} />
                  <button type="submit" style="width:100%;background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.4);color:#c7d2fe;font-size:12px;font-weight:600;padding:7px;border-radius:6px;cursor:pointer;min-height:44px;">
                    Approve
                  </button>
                </form>
              )}
              {run.status === 'approved' && (
                <form method="POST" style="flex:1;min-width:120px;" onsubmit={confirmAttr(
                  'Mark the ' + (MONTH_NAMES[(run.month || 1) - 1] || 'unknown month') + ' ' + run.year
                  + ' payroll as paid? ' + (run.total_employees ?? 0) + ' employee'
                  + (Number(run.total_employees) === 1 ? '' : 's') + ' will be credited ' + fmt(run.total_net)
                  + ' net in their wallets and told they have been paid. There is no undo.')}>
                  <input type="hidden" name="action" value="mark_paid" />
                  <input type="hidden" name="runId" value={run.id} />
                  <button type="submit" style="width:100%;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);color:#a7f3d0;font-size:12px;font-weight:600;padding:7px;border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;min-height:44px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Mark Paid
                  </button>
                </form>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- PAYSLIPS TAB -->
  {tab === 'payslips' && (
    <div style="padding:12px 16px;">
      {/* Run selector. The onchange auto-submit is kept as a convenience, but it was the ONLY way to
          apply the choice: with scripting off, or before the handler is live on a slow phone, picking
          a month did nothing and there was no button to press. There is one now. */}
      <form method="GET" style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="hidden" name="tab" value="payslips" />
        <label for="runSelect" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">Payroll run</label>
        <select id="runSelect" name="run" onchange="this.form.submit()" style="flex:1 1 180px;min-width:0;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
          <option value="">Select Payroll Run</option>
          {runRows.map(r => (
            <option value={r.id} selected={selectedRunId === String(r.id)}>{MONTH_NAMES[(r.month||1)-1]} {r.year} · {r.status || 'no status'}</option>
          ))}
        </select>
        <button type="submit" style="flex:0 0 auto;background:#15151a;border:1px solid #26262e;color:#d8d8de;font-size:12.5px;font-weight:600;padding:0 16px;border-radius:8px;cursor:pointer;min-height:44px;">Show</button>
      </form>
      {!runsRes.ok && (
        <p style="font-size:12px;color:#fca5a5;margin:-4px 0 12px;line-height:1.6;">The run list could not be read, so this picker is empty. There may be runs; we could not fetch them.</p>
      )}

      {selectedRun && (
        <div style="background:#0f0f14;border:1px solid #FF4F00;border-radius:10px;padding:10px 14px;margin-bottom:12px;">
          <p style="font-size:12px;color:#FF7040;margin:0;font-weight:600;">{MONTH_NAMES[(selectedRun.month||1)-1]} {selectedRun.year} — {selectedRun.status ? String(selectedRun.status).toUpperCase() : 'NO STATUS'}</p>
          <p style="font-size:11px;color:#6e6e78;margin:4px 0 0;">{selectedRun.total_employees ?? 0} employees · Net: ₹{fmt(selectedRun.total_net)}</p>
        </div>
      )}
      {/* A RUN ID THAT IS NOT IN THE LIST. The list is the latest 24 runs, so this is reachable
          without anything being wrong — and it used to render as though no run were selected while
          the payslips below were still those of the run that IS being read. */}
      {selectedRunMissing && (
        <div style="background:rgba(251,191,36,0.07);border:1px solid rgba(251,191,36,0.3);border-radius:10px;padding:12px 14px;margin-bottom:12px;color:#fde68a;font-size:12.5px;line-height:1.6;">
          That run is not among the 24 most recent, so its month, status and totals are not shown here.
          Any payslips listed below do belong to it.
        </div>
      )}

      <div style="display:flex;flex-direction:column;gap:6px;">
        {!selectedRunId && <div style="text-align:center;padding:32px;color:#8a8a94;"><p style="font-size:13px;">Select a payroll run to view payslips</p></div>}
        {/* A RUN WITH NO PAYSLIPS USED TO RENDER NOTHING AT ALL — the same blank space as "you have
            not picked a run yet", which is the exact ambiguity that let four months of failed
            messages go unnoticed on this project. Now it says which of the two it is.
            AND a THIRD state that was folded into the second: the payslip read failing. "This run
            carries no payslip — regenerate it before approving" is advice to re-run a month, which
            recovers every loan instalment on it a second time. It must never be printed on a guess. */}
        {selectedRunId && payslipsRes && !payslipsRes.ok && (
          <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:14px;color:#fca5a5;font-size:13px;line-height:1.6;">
            The payslips on this run could not be read, so none is listed. This does NOT mean the run
            is empty, and it is not a reason to regenerate the month — a second run for a period
            recovers loan instalments and pays bonuses again.
          </div>
        )}
        {selectedRunId && payslipsRes && payslipsRes.ok && payslipTotal === 0 && (
          <div style="background:rgba(251,191,36,0.07);border:1px solid rgba(251,191,36,0.3);border-radius:10px;padding:14px;color:#fde68a;font-size:13px;line-height:1.6;">
            This run exists but carries no payslip. Either every employee was skipped when it was
            generated, or the payslips were removed afterwards. Nobody on this run has anything to be
            paid — regenerate it before approving.
          </div>
        )}
        {selectedRunId && payslipsRes && payslipsRes.ok && payslipTotal > 0 && payslipRows && payslipRows.length === 0 && (
          <div style="background:rgba(251,191,36,0.07);border:1px solid rgba(251,191,36,0.3);border-radius:10px;padding:14px;color:#fde68a;font-size:13px;line-height:1.6;">
            This run carries {payslipTotal} payslips, but none on this page.
            <a href={`?tab=payslips&run=${encodeURIComponent(selectedRunId)}&p=1`} style="color:#FF7040;"> Go to the first page</a>.
          </div>
        )}
        {payslipRows && payslipRows.map(ps => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;overflow:hidden;">
            <div style="padding:12px 14px;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                <div>
                  <p style="font-size:13px;font-weight:600;color:#fff;margin:0;overflow-wrap:anywhere;" title={String(ps.full_name || '')}>{clip(ps.full_name || 'Unnamed employee', 60)}</p>
                  {/* `{ps.days_worked}d worked` printed "nulld worked" for a payslip whose column
                      was never written. A number that was not recorded is not a zero. */}
                  <p style="font-size:10px;color:#6e6e78;margin:2px 0 0;font-family:'Geist Mono',monospace;">{ps.employee_code || 'no code'} · {ps.days_worked != null ? ps.days_worked + 'd worked' : 'days worked not recorded'}</p>
                </div>
                <div style="text-align:right;">
                  <p style="font-size:15px;font-weight:700;color:#6ee7b7;margin:0;">{ps.currency} {fmt(ps.net_salary)}</p>
                  <p style="font-size:10px;color:#6e6e78;margin:0;">net pay</p>
                  {/* THE DOCUMENT ITSELF, WHICH NOTHING OPENED. /admin/hr/payslip/[id] renders the
                      full payslip through src/lib/hr-payslip.ts and has existed all along with NO
                      link anywhere in src/ — every other mention of that path is a comment in a
                      different file. So this list showed HR four summary tiles and gave them no way
                      to reach the document a person is about to ring up about. The route answers to
                      super_admin and hr and nobody else ([id].ts:10), which is NARROWER than this
                      console's own `payroll` section, so nobody offered this link is refused by it.
                      44px tall on its own line, because it sits at the right-hand edge of a card at
                      360px and a 20px target there is the one nobody's thumb lands on. */}
                  <a href={'/admin/hr/payslip/' + ps.id} target="_blank" rel="noopener noreferrer"
                     style="display:inline-flex;align-items:center;justify-content:flex-end;min-height:44px;color:#67e8f9;text-decoration:none;font-size:11px;font-family:'Geist Mono',monospace;letter-spacing:0.05em;">Open payslip</a>
                </div>
              </div>
              {/* Earnings/Deductions breakdown. Bounded tracks so a long "INR 12,50,000" cannot
                  stretch the two tiles past the card on a phone. */}
              <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;">
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Basic</p>
                  <p style="font-size:11px;font-weight:500;color:#d8d8de;margin:2px 0 0;">{ps.currency} {fmt(ps.basic)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Gross</p>
                  <p style="font-size:11px;font-weight:500;color:#d8d8de;margin:2px 0 0;">{ps.currency} {fmt(ps.gross_salary)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">PF</p>
                  <p style="font-size:11px;font-weight:500;color:#fca5a5;margin:2px 0 0;">- {ps.currency} {fmt(ps.pf_employee)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">TDS</p>
                  <p style="font-size:11px;font-weight:500;color:#fca5a5;margin:2px 0 0;">- {ps.currency} {fmt(ps.tds)}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* THE PAYSLIP PAGER. This list had no LIMIT: a run for a large organisation rendered every
          payslip card into one column on a phone. The count is the run's real total. */}
      {selectedRunId && payslipsRes && payslipsRes.ok && payslipPages > 1 && (
        <div style="display:flex;align-items:center;justify-content:center;gap:8px;padding:16px 0 0;flex-wrap:wrap;">
          {payslipPage > 1 && (
            <a href={`?tab=payslips&run=${encodeURIComponent(selectedRunId)}&p=${payslipPage - 1}`} style="background:#15151a;border:1px solid #26262e;color:#d8d8de;text-decoration:none;padding:0 14px;border-radius:8px;font-size:12px;min-height:44px;display:inline-flex;align-items:center;">Previous</a>
          )}
          <span style="font-size:12px;color:#6e6e78;">Page {payslipPage} of {payslipPages} · {payslipTotal} payslips on this run</span>
          {payslipPage < payslipPages && (
            <a href={`?tab=payslips&run=${encodeURIComponent(selectedRunId)}&p=${payslipPage + 1}`} style="background:#15151a;border:1px solid #26262e;color:#d8d8de;text-decoration:none;padding:0 14px;border-radius:8px;font-size:12px;min-height:44px;display:inline-flex;align-items:center;">Next</a>
          )}
        </div>
      )}
    </div>
  )}

  <!-- SALARY SETUP TAB -->
  {tab === 'salary' && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:8px;">
      <p style="font-size:12px;color:#6e6e78;margin:0 0 8px;">Set salary structure for each employee. Changes take effect from current date.</p>
      {/* WAS a <button> whose only effect was an addEventListener at the bottom of the page. With
          scripting off, or before the handler attached on a slow phone, tapping a person did
          nothing and there was NO OTHER WAY to reach the salary form — the whole tab was dead.
          <details> is the same interaction, done by the browser, with no script involved.

          THE COMMENT SITS OUTSIDE THE .map() CALLBACK DELIBERATELY. A concise arrow body `emp => (`
          may hold exactly one expression, so a JSX comment placed before the details element made it
          two and broke parsing for everything from this line to the end of the file — astro check
          reported it as an unclosed div element 200 lines further down.

          Note also that no brace character appears in this prose: the .astro parser matches braces
          inside a JSX comment, so one written here would close the expression early. */}
      {employeeRows.map(emp => (
        <details style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
          <summary class="salary-summary" style="padding:12px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;cursor:pointer;text-align:left;min-height:44px;">
            <div style="min-width:0;">
              <p style="font-size:13px;font-weight:600;color:#fff;margin:0;overflow-wrap:anywhere;">{emp.full_name}</p>
              <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;font-family:'Geist Mono',monospace;">{emp.employee_code}</p>
            </div>
            {/* The colour used to be written as color:{...} inside a QUOTED style attribute, which
                Astro does not interpolate — the browser received the literal text, dropped the
                declaration, and "Not set" was rendered in the same colour as a real salary. */}
            <div style="text-align:right;flex:0 0 auto;">
              <p style={`font-size:13px;font-weight:600;margin:0;color:${emp.gross_salary ? '#fff' : '#8a8a94'};`}>
                {emp.gross_salary ? `${emp.currency || 'INR'} ${fmt(emp.gross_salary)}/mo` : 'Not set'}
              </p>
              <p style="font-size:10px;color:#FF7040;margin:0;">Tap to edit</p>
            </div>
          </summary>
          <div style="border-top:1px solid #1a1a1f;padding:14px;">
            <form method="POST" style="display:flex;flex-direction:column;gap:10px;">
              <input type="hidden" name="action" value="update_salary" />
              <input type="hidden" name="empId" value={emp.id} />
              {/* The salary fields are the worst offender on a phone: a bare 1fr track takes its
                  automatic minimum from the number input's intrinsic size (~150px each), so the two
                  columns needed ~320px before padding and the right-hand fields were cut off by the
                  card. minmax(0,1fr) pins each track to half the card and the width:100% inputs
                  shrink with it. Column count is unchanged, so the desktop form looks identical. */}
              <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
                <label style="grid-column:1/-1;display:flex;gap:8px;align-items:center;">
                  <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;white-space:nowrap;">Currency</span>
                  <select name="currency" style="flex:1;min-width:0;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 8px;color:#fff;font-size:13px;outline:none;min-height:44px;">
                    {['INR','USD','GBP','EUR','SGD','AED'].map(c => (
                      <option value={c} selected={emp.currency === c}>{c}</option>
                    ))}
                  </select>
                </label>
                {[
                  ['basic','Basic Salary', emp.basic || emp.base_salary],
                  ['hra','HRA', emp.hra],
                  ['da','DA', emp.da],
                  ['specialAllowance','Special Allowance', emp.special_allowance],
                  ['transportAllowance','Transport Allowance', emp.transport_allowance || 1600],
                  ['medicalAllowance','Medical Allowance', emp.medical_allowance || 1250],
                  ['otherAllowances','Other Allowances', emp.other_allowances],
                  ['tds','TDS (monthly)', emp.tds],
                ].map(([name, label, val]: any) => (
                  /* The label was a loose <label> with no `for` and no input inside it, so it named
                     nothing: a screen reader read eight unlabelled number fields, and tapping the
                     word did not focus the box. Wrapping associates them with no id bookkeeping.
                     9px at #6e6e78 on this card is about 3.7:1 — under the 4.5:1 floor for text
                     this size — so the label is 10px at a colour that clears it. */
                  <label style="display:block;">
                    <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#9a9aa4;margin-bottom:4px;">{label}</span>
                    <input type="number" name={name} value={val || 0} step="0.01" min="0" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:6px;padding:10px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
                  </label>
                ))}
              </div>
              <div style="background:#15151a;border-radius:8px;padding:8px 10px;font-size:11px;color:#6e6e78;">
                This form sets the fixed part of the salary. Provident fund, state insurance, professional
                tax and any other statutory deduction are <a href="/admin/hr/payroll/components" style="color:#FF7040;">configured components</a>
                with rates you set, applied when a run is generated. Nothing is assumed here.
              </div>
              <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:13px;padding:10px;border-radius:8px;cursor:pointer;min-height:44px;">Save Salary Structure</button>
            </form>
          </div>
        </details>
      ))}
      {/* THE LIST IS CAPPED AT 100 AND SAID SO NOWHERE. An organisation with 140 people had 40 of
          them simply absent from Salary Setup with no hint that anything had been left out — the
          page looked complete. Until this screen paginates, it at least says what it is showing. */}
      {employeeRows.length >= EMPLOYEE_LIMIT && (
        <p style="font-size:12px;color:#fbbf24;margin:8px 0 0;line-height:1.6;">
          Showing the first {EMPLOYEE_LIMIT} active employees by name. There are more, and they are not on
          this list. Open a person from <a href="/admin/hr/employees" style="color:#FF7040;">the employee
          register</a> to set their salary until this screen pages.
        </p>
      )}
      {employeeRows.length === 0 && (
        <p style="font-size:13px;color:#8a8a94;margin:8px 0 0;">
          No active employee is on record, so there is nobody to give a salary structure to.
        </p>
      )}
    </div>
  )}
</div>

<!-- Create Payroll Run sheet. Rendered by the server when ?new=1 — no JavaScript opens or closes it. -->
{showRunModal && (
<div id="runModal" role="dialog" aria-modal="true" aria-labelledby="runModalTitle" style="display:flex;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:flex-end;justify-content:center;overflow-y:auto;">
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px 16px 0 0;width:100%;max-width:600px;padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:10px;">
      <h2 id="runModalTitle" style="font-size:15px;font-weight:700;color:#fff;margin:0;">Create Payroll Run</h2>
      {/* A LINK, not a button with an onclick. It closes the sheet with no script running, and the
          44px box is a target a thumb can actually hit — the 30px square it replaced was not. */}
      <a href={runModalBack} aria-label="Close without creating a payroll run" style="background:#1a1a1f;border:none;color:#d8d8de;min-width:44px;min-height:44px;border-radius:8px;font-size:20px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;">&times;</a>
    </div>
    <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="hidden" name="action" value="create_run" />
      {/* Same bounded tracks for the month/year pair. This modal is position:fixed, so its overflow
          escapes to the viewport and would scroll the page sideways while the sheet is open. */}
      {/* Each label WRAPS its control. They were loose <label> elements with no `for`, so none of the
          three named anything: a screen reader announced three unlabelled fields on the screen that
          starts a payroll run, and tapping the word did not focus the box. */}
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Month</span>
          <select name="month" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
            {MONTH_NAMES.map((m, i) => (
              <option value={i+1} selected={i+1 === currentMonth}>{m}</option>
            ))}
          </select>
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Year</span>
          <input type="number" name="year" value={currentYear} min="2024" max="2030" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
        </label>
      </div>
      <label style="display:block;">
        <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Notes (optional)</span>
        <input type="text" name="notes" placeholder="e.g. May 2026 payroll" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
      </label>
      <div style="background:rgba(255,159,0,0.08);border:1px solid rgba(255,159,0,0.2);border-radius:8px;padding:10px 12px;">
        <p style="font-size:11px;color:#fbbf24;margin:0;">This will auto-calculate salary for all active employees based on their salary structures and attendance data for the selected month.</p>
      </div>
      <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;min-height:44px;">Generate Payroll</button>
      <a href={runModalBack} style="text-align:center;color:#8a8a94;font-size:12.5px;text-decoration:underline;min-height:44px;display:flex;align-items:center;justify-content:center;">Cancel</a>
    </form>
  </div>
</div>
)}

{/* PROGRESSIVE ENHANCEMENT ONLY. Everything above already works with scripting switched off; this
    moves focus into the sheet and closes it on Escape when scripting is on. If it never runs, the
    sheet is still open, still fillable and still closable by the link.

    NOT wrapped in the showRunModal conditional: a script element inside a JSX conditional breaks
    .astro parsing. It guards itself on the element instead, which is the same outcome and parses.

    No brace character appears in this prose either. The .astro parser matches braces inside a JSX
    comment, so the conditional written out literally here closed the expression early and every
    element after it was reported as unbalanced. */}
<script is:inline>
(function () {
  var sheet = document.getElementById('runModal');
  if (!sheet) return;
  var back = sheet.querySelector('a[aria-label]');
  var first = sheet.querySelector('select, input, button');
  if (first && first.focus) { try { first.focus(); } catch (e) {} }
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && back) { window.location.href = back.getAttribute('href'); }
  });
})();
</script>

<style>
  /* The default disclosure triangle is not part of this visual language, and the summary already
     says "Tap to edit". Hiding the marker is the only styling here; the behaviour is the
     browser's. */
  summary.salary-summary { list-style: none; }
  summary.salary-summary::-webkit-details-marker { display: none; }
  summary.salary-summary::marker { content: ''; }
</style>
</AdminLayout>
