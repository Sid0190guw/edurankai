---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { db } from '@/lib/db';
import { sql as sqlExpr } from 'drizzle-orm';
// THE STATUTORY RATES ARE NO LONGER IN THIS FILE.
//
// This page used to compute every payslip from four constants — `basic * 0.12` capped at 1800 for
// provident fund, `gross * 0.0075` below a gross of 21000 for state insurance, and a professional tax
// of 200 or 150 by band, commented "(Karnataka/Maharashtra standard)". Those are jurisdiction-specific
// rules that change, that differ by state and by wage band, and that were being printed on employees'
// payslips with the percentage next to them as though this product could stand behind them.
//
// generateRun() in src/lib/payroll.ts now builds each payslip from components an administrator
// configures at /admin/hr/payroll/components, with the rates THEY entered. The catalogue starts empty
// and there is no button that offers to fill in a country's rates.
//
// THE CONSEQUENCE IS REAL AND IS STATED ON SCREEN BELOW: until statutory components are configured, a
// new run deducts none of them, so net pay is higher than a run generated before this change. That is
// visible on this page, not silent.
import { generateRun, computePay, listComponents, MONTH_NAMES as PAYROLL_MONTHS } from '@/lib/payroll';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
// THE GATE — payroll.manage, granted in PERMS_BY_ROLE to exactly super_admin and hr, which is the
// literal list `['super_admin','hr']` this line used to spell out. Same two accounts, named by what
// they may do.
//
// DELIBERATELY NOT canAccessSection(user, 'payroll', 'edit'), the pattern /admin/finance uses. A
// custom role granted the `payroll` section passes the middleware section gate (middleware.ts:59)
// and is then refused HERE, so it has no access today; canAccessSection() would ADMIT it, and this
// screen reads and writes base_salary. can() reads PERMS_BY_ROLE only and cannot be widened by a
// section checkbox.
//
// The `role === 'applicant'` line that used to sit above went with the conversion: middleware.ts:311
// redirects every applicant off every /admin path before this frontmatter runs, and can() answers
// false for `applicant` anyway (its permission list is empty), so the guard was dead twice over.
if (!can(user as any, 'payroll.manage')) return Astro.redirect('/admin?denied=payroll');

let errorMsg = '';
let successMsg = '';

// Payroll decisions and salary changes are money decisions: they must leave a trail. Nothing
// under /admin/hr wrote to audit_log, so a salary could be changed and there was no record of
// who changed it, when, or from what.
async function audit(userId: string, action: string, entityId: string, diff: Record<string, unknown>) {
  try {
    const { logAudit } = await import('@/lib/audit');
    await logAudit({ userId, action, entity: 'hr_payroll', entityId, diff });
  } catch (_) {}
}

const currentMonth = new Date().getMonth() + 1;
const currentYear = new Date().getFullYear();

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (action === 'create_run') {
      const month = parseInt(fd.get('month') as string);
      const year = parseInt(fd.get('year') as string);
      const notes = (fd.get('notes') as string || '').trim();

      // Loss-of-pay columns. Additive and idempotent, matching how the rest of the HR schema
      // provisions itself; see db/hr-schema.sql for the full canonical definition.
      await db.execute(sqlExpr`ALTER TABLE hr_payslips ADD COLUMN IF NOT EXISTS lop_days NUMERIC(6,2) NOT NULL DEFAULT 0`).catch(() => {});
      await db.execute(sqlExpr`ALTER TABLE hr_payslips ADD COLUMN IF NOT EXISTS lop_deduction NUMERIC(14,2) NOT NULL DEFAULT 0`).catch(() => {});

      // ONE CALL, and every rate in it came from the component catalogue rather than from this file.
      // generateRun() is idempotent on (month, year), refuses a second run for a period that already
      // has one, and reports per-employee failures by name instead of aborting the whole month or
      // hiding them.
      const run = await generateRun(month, year, String(user.id), notes);
      if (!run.ok) {
        errorMsg = run.error || 'That payroll run could not be created.';
      } else {
        const parts = [
          `Payroll run created for ${PAYROLL_MONTHS[month - 1]} ${year} with ${run.employees} employee${run.employees === 1 ? '' : 's'}.`,
          `Total net ₹${Math.round(run.totalNet).toLocaleString('en-IN')}.`,
        ];
        if (run.failed.length) {
          parts.push(`${run.failed.length} employee${run.failed.length === 1 ? ' was' : 's were'} left out because their payslip could not be written: ${run.failed.join(', ')}. Nobody was paid a wrong amount — they simply have no payslip in this run.`);
        }
        if (run.noStatutoryComponents) {
          parts.push('No statutory component is configured, so this run deducted no provident fund, state insurance, professional tax or withholding. Configure them under Components if your jurisdiction requires them, then regenerate.');
        }
        successMsg = parts.join(' ');
      }
    } else if (action === 'approve_run') {
      const runId = fd.get('runId') as string;
      await db.execute(sqlExpr`
        UPDATE hr_payroll_runs SET status = 'approved', approved_by = ${user.id}, approved_at = NOW()
        WHERE id = ${runId}
      `);
      await db.execute(sqlExpr`UPDATE hr_payslips SET status = 'approved' WHERE payroll_run_id = ${runId}`);
      await audit(user.id, 'hr.payroll.approved', runId, {});
      successMsg = 'Payroll run approved.';
    } else if (action === 'mark_paid') {
      const runId = fd.get('runId') as string;
      await db.execute(sqlExpr`
        UPDATE hr_payroll_runs SET status = 'paid', paid_at = NOW() WHERE id = ${runId}
      `);
      await db.execute(sqlExpr`UPDATE hr_payslips SET status = 'paid', paid_at = NOW() WHERE payroll_run_id = ${runId}`);

      // Money must actually land somewhere. Marking a run paid used to change two status columns
      // and stop, so wallet balances stayed at zero no matter how many months had been paid and
      // employees had nothing to withdraw. Credit the ledger here; the call is idempotent by
      // payslip ref, so re-clicking Mark Paid cannot pay anyone twice.
      let payoutMsg = '';
      try {
        const { creditPayrollRun } = await import('@/lib/hr-wallet');
        const res = await creditPayrollRun(runId, user.id);
        payoutMsg = res.credited > 0
          ? ` ${res.credited} wallet${res.credited === 1 ? '' : 's'} credited (₹${Math.round(res.total).toLocaleString('en-IN')}).`
          : ' Wallets were already credited for this run.';
        await audit(user.id, 'hr.payroll.paid', runId, { credited: res.credited, total: res.total });
      } catch (e: any) {
        payoutMsg = ' Wallet credit could not be completed — open Payouts and check before telling anyone they have been paid.';
      }
      successMsg = 'Payroll marked as paid.' + payoutMsg;

      // The entire HR module sent no notifications of any kind, so being paid was silent: money
      // landed in the wallet and nobody was told. Notify each paid employee who has a linked
      // portal account, plus the other admins. All guarded — the enclosing catch would otherwise
      // report a failure for a run that has already been marked paid and credited.
      try {
        const { sendPushToUser, sendPushToAdmins } = await import('@/lib/push');
        // `p.net_pay` — the column this used to select DOES NOT EXIST. hr_payslips carries
        // `net_salary` (db/hr-schema.sql:262); there has never been a net_pay. So this statement threw
        // `column p.net_pay does not exist` on every run, the bare `catch (_) {}` around the block
        // swallowed it, and NOBODY was ever notified that they had been paid — while the page reported
        // success. The column name is fixed and the value is aliased so the reader below is unchanged.
        const paidRows = await db.execute(sqlExpr`
          SELECT e.user_id, p.net_salary AS net_pay
          FROM hr_payslips p
          JOIN hr_employees e ON e.id = p.employee_id
          WHERE p.payroll_run_id = ${runId} AND e.user_id IS NOT NULL`);
        const paid = (Array.isArray(paidRows) ? paidRows : ((paidRows as any)?.rows || [])) as any[];
        for (const row of paid) {
          try {
            await sendPushToUser(row.user_id, {
              type: 'payroll_run',
              title: 'Salary credited',
              body: row.net_pay != null
                ? 'Your payslip is ready and Rs ' + Math.round(Number(row.net_pay)).toLocaleString('en-IN') + ' has been credited to your wallet.'
                : 'Your payslip is ready and your salary has been credited to your wallet.',
              url: '/portal/employee',
              tag: 'payroll-' + runId,
            });
          } catch (_) {}
        }
        await sendPushToAdmins({
          type: 'payroll_run',
          title: 'Payroll marked paid',
          body: paid.length + ' employee' + (paid.length === 1 ? '' : 's') + ' notified.' + payoutMsg.trim(),
          url: '/admin/hr/payroll',
          tag: 'payroll-admin-' + runId,
        }, user.id);
      } catch (_) {}
    } else if (action === 'update_salary') {
      const empId = fd.get('empId') as string;
      const basic = parseFloat(fd.get('basic') as string || '0');
      const hra = parseFloat(fd.get('hra') as string || '0');
      const da = parseFloat(fd.get('da') as string || '0');
      const specialAllowance = parseFloat(fd.get('specialAllowance') as string || '0');
      const transportAllowance = parseFloat(fd.get('transportAllowance') as string || '0');
      const medicalAllowance = parseFloat(fd.get('medicalAllowance') as string || '0');
      const otherAllowances = parseFloat(fd.get('otherAllowances') as string || '0');
      const tds = parseFloat(fd.get('tds') as string || '0');
      const currency = (fd.get('currency') as string || 'INR').trim();

      const gross = basic + hra + da + specialAllowance + transportAllowance + medicalAllowance + otherAllowances;

      // THE THREE HARDCODED STATUTORY FORMULAS THAT USED TO SIT HERE ARE GONE. They were
      // `Math.min(basic * 0.12, 1800)`, `gross < 21000 ? gross * 0.0075 : 0` and a professional tax
      // of 200/150 by band — jurisdiction-specific rules, written into a page, stamped onto a salary
      // record. Those three columns are now written as ZERO on the structure, because this form does
      // not know them: statutory deductions are components, they are configured at
      // /admin/hr/payroll/components, and they are applied when a run is generated.
      //
      // `tds` and `other_deductions` stay on the structure, because a human types those in here.
      const pfEmployee = 0;
      const esicEmployee = 0;
      const professionalTax = 0;
      const totalDed = tds;
      const net = gross - totalDed;

      // Capture what the salary WAS, so the audit entry records the change and not just the result.
      let prev: any = null;
      try {
        const p = await db.execute(sqlExpr`SELECT gross_salary, net_salary, currency FROM hr_salary_structures
          WHERE employee_id = ${empId} AND effective_to IS NULL ORDER BY effective_from DESC LIMIT 1`);
        prev = (Array.isArray(p) ? p : (p as any)?.rows || [])[0] || null;
      } catch (_) {}

      // Close existing structure
      await db.execute(sqlExpr`
        UPDATE hr_salary_structures SET effective_to = CURRENT_DATE - INTERVAL '1 day'
        WHERE employee_id = ${empId} AND effective_to IS NULL
      `);

      // Insert new structure
      await db.execute(sqlExpr`
        INSERT INTO hr_salary_structures (
          employee_id, effective_from, currency,
          basic, hra, da, special_allowance, transport_allowance, medical_allowance,
          other_allowances, gross_salary, pf_employee, esic_employee,
          professional_tax, tds, total_deductions, net_salary, created_by
        ) VALUES (
          ${empId}, CURRENT_DATE, ${currency},
          ${basic}, ${hra}, ${da}, ${specialAllowance}, ${transportAllowance}, ${medicalAllowance},
          ${otherAllowances}, ${gross}, ${pfEmployee}, ${esicEmployee},
          ${professionalTax}, ${tds}, ${totalDed}, ${net}, ${user.id}
        )
      `);

      // Update base salary on employee
      await db.execute(sqlExpr`UPDATE hr_employees SET base_salary = ${gross}, currency = ${currency} WHERE id = ${empId}`);
      await audit(user.id, 'hr.salary.updated', empId, {
        from: prev ? { gross: Number(prev.gross_salary || 0), net: Number(prev.net_salary || 0), currency: prev.currency } : null,
        to: { gross, net, currency },
      });
      // The honest net, computed the way a real run will compute it — through the component engine
      // against the structure that has just been written — rather than by repeating a formula here.
      // Reporting a net that a run would not reproduce is how a salary conversation goes wrong.
      const preview = await computePay(empId, { month: currentMonth, year: currentYear });
      successMsg = `Salary structure updated. Gross ${currency} ${gross.toLocaleString('en-IN')}; `
        + `net ${preview.currency} ${preview.net.toLocaleString('en-IN')} after the components configured today`
        + (preview.noStatutoryComponents ? ' (no statutory component is configured, so none was deducted).' : '.');
    }
  } catch (err: any) {
    errorMsg = 'Error: ' + (err.message || 'Unknown');
  }
}

const url = new URL(Astro.request.url);
const tab = url.searchParams.get('tab') || 'runs';
const selectedRunId = url.searchParams.get('run') || '';

// Payroll runs
const runs = await db.execute(sqlExpr`SELECT * FROM hr_payroll_runs ORDER BY year DESC, month DESC LIMIT 24`);

// Payslips for selected run
const payslips = selectedRunId ? await db.execute(sqlExpr`
  SELECT ps.*, e.full_name, e.employee_code, e.designation
  FROM hr_payslips ps
  JOIN hr_employees e ON ps.employee_id = e.id
  WHERE ps.payroll_run_id = ${selectedRunId}
  ORDER BY e.full_name
`) : null;

const selectedRun = selectedRunId ? ((Array.isArray(runs) ? runs : (runs?.rows || [])) as any[]).find(r => r.id === selectedRunId) : null;

// Employees for salary setup
const employees = await db.execute(sqlExpr`
  SELECT e.id, e.full_name, e.employee_code, e.base_salary, e.currency,
    ss.basic, ss.hra, ss.da, ss.special_allowance, ss.transport_allowance,
    ss.medical_allowance, ss.gross_salary, ss.net_salary, ss.tds
  FROM hr_employees e
  LEFT JOIN hr_salary_structures ss ON ss.employee_id = e.id
    AND ss.effective_from <= NOW() AND (ss.effective_to IS NULL OR ss.effective_to >= NOW())
  WHERE e.is_active = true
  ORDER BY e.full_name
  LIMIT 100
`);

// What a run will actually apply. Read AFTER the POST handler so a component saved elsewhere in this
// request is reflected, and used only to state a fact on screen — it decides nothing.
const activeComponents = await listComponents();
const statutoryConfigured = activeComponents.filter((c) => c.statutory).length;

const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function fmt(n: any) {
  if (!n || n == 0) return '0';
  return parseFloat(n).toLocaleString('en-IN');
}
---
<AdminLayout title="Payroll — HRMS" activeNav="hr">
<div style="padding-bottom:80px;">

  <!-- Header -->
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS · Payroll</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Payroll</h1>
      </div>
      <button onclick="document.getElementById('runModal').style.display='flex'" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:12px;padding:8px 14px;border-radius:8px;cursor:pointer;">+ Run Payroll</button>
    </div>

    {/* Tabs. Three labels at their natural width are wider than a 320px phone, and this strip sits
        in the sticky header, so the overflow used to widen the whole PAGE. The strip now scrolls
        inside its own container and the labels keep their full width instead of squashing. */}
    <div style="display:flex;gap:4px;overflow-x:auto;-webkit-overflow-scrolling:touch;">
      {[['runs','Payroll Runs'],['payslips','Payslips'],['salary','Salary Setup']].map(([t, label]) => (
        <a href={`?tab=${t}`} style={`flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;min-height:44px;display:inline-flex;align-items:center;${tab === t ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>{label}</a>
      ))}
      {/* THE TWO SURFACES THIS PHASE ADDED. Both gated at their own door — Components on
          payroll.manage (the same key as this page), Claims on expenses.review — so a link here is
          never wider than what the destination admits. */}
      <a href="/admin/hr/payroll/components" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;min-height:44px;display:inline-flex;align-items:center;">Components</a>
      <a href="/admin/hr/payroll/claims" style="flex:0 0 auto;white-space:nowrap;text-decoration:none;font-size:12px;font-weight:600;padding:9px 12px;border-radius:6px;background:#15151a;color:#8a8a94;min-height:44px;display:inline-flex;align-items:center;">Claims</a>
    </div>
  </div>

  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {successMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{successMsg}</div>}

  <!-- PAYROLL RUNS TAB -->
  {tab === 'runs' && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:8px;">
      {/* WHAT THIS RUN WILL AND WILL NOT DEDUCT, said before anybody presses the button. The rates
          that used to live in this file are gone; a run now applies exactly the components that have
          been configured, and none is assumed. */}
      <div style={`border-radius:10px;padding:12px 14px;margin-bottom:4px;${statutoryConfigured === 0 ? 'background:rgba(255,159,0,0.07);border:1px solid rgba(255,159,0,0.22);' : 'background:#0f0f14;border:1px solid #1a1a1f;'}`}>
        <p style={`font-size:12.5px;margin:0;line-height:1.65;${statutoryConfigured === 0 ? 'color:#fbbf24;' : 'color:#8a8a94;'}`}>
          {statutoryConfigured === 0
            ? 'No statutory component is configured, so a run generated now deducts no provident fund, state insurance, professional tax or withholding — the run assumes none of them. Those rates are jurisdiction-specific and this product makes no claim about what yours requires.'
            : statutoryConfigured + ' statutory component' + (statutoryConfigured === 1 ? '' : 's') + ' configured, plus ' + (activeComponents.length - statutoryConfigured) + ' other component' + ((activeComponents.length - statutoryConfigured) === 1 ? '' : 's') + '. Every rate is the one you entered; nothing here is advice on what your jurisdiction requires.'}
          <a href="/admin/hr/payroll/components" style="color:#FF7040;"> Open components</a>.
        </p>
      </div>
      {((Array.isArray(runs) ? runs : (runs?.rows || [])) as any[]).length === 0 && (
        <div style="text-align:center;padding:48px;color:#6e6e78;">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;opacity:0.7;"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
          <p style="font-size:13px;">No payroll runs yet</p>
          <p style="font-size:12px;margin-top:4px;">Click "+ Run Payroll" to create your first payroll run</p>
        </div>
      )}
      {((Array.isArray(runs) ? runs : (runs?.rows || [])) as any[]).map(run => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
          <div style="padding:12px 14px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
              <div>
                <p style="font-size:15px;font-weight:700;color:#fff;margin:0;">{MONTH_NAMES[(run.month || 1) - 1]} {run.year}</p>
                <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;">{run.total_employees} employees</p>
              </div>
              <span style={`font-size:10px;font-weight:700;padding:3px 8px;border-radius:100px;text-transform:uppercase;${run.status === 'paid' ? 'background:rgba(16,185,129,0.15);color:#6ee7b7;' : run.status === 'approved' ? 'background:rgba(99,102,241,0.15);color:#a5b4fc;' : 'background:rgba(251,191,36,0.15);color:#fbbf24;'}`}>
                {run.status}
              </span>
            </div>
            {/* Company-wide totals, so these are the largest numbers on the page: a crore-scale
                gross is "₹12,50,00,000" and has no space to break at. Three fixed tracks on a 360px
                phone left each tile ~96px wide, so the figure spilled over its neighbour and was
                then cut off by the card's overflow:hidden. These three tiles are independent of one
                another, so they can REFLOW rather than scroll: auto-fit keeps three across on a
                normal phone and wider, and drops to two on a narrow one instead of clipping.
                overflow-wrap is the last resort for a figure too long for even a reflowed tile. */}
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:6px;margin-bottom:10px;">
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Gross</p>
                <p style="font-size:12px;font-weight:600;color:#fff;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_gross)}</p>
              </div>
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Deductions</p>
                <p style="font-size:12px;font-weight:600;color:#fca5a5;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_deductions)}</p>
              </div>
              <div style="background:#15151a;border-radius:6px;padding:6px 8px;text-align:center;">
                <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Net Pay</p>
                <p style="font-size:12px;font-weight:600;color:#6ee7b7;margin:2px 0 0;overflow-wrap:anywhere;">₹{fmt(run.total_net)}</p>
              </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <a href={`?tab=payslips&run=${run.id}`} style="flex:1;text-align:center;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;font-size:12px;font-weight:500;padding:7px;border-radius:6px;min-width:80px;">
                View Payslips
              </a>
              {run.status === 'draft' && (
                <form method="POST" style="flex:1;">
                  <input type="hidden" name="action" value="approve_run" />
                  <input type="hidden" name="runId" value={run.id} />
                  <button type="submit" style="width:100%;background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;font-size:12px;font-weight:500;padding:7px;border-radius:6px;cursor:pointer;">
                    Approve
                  </button>
                </form>
              )}
              {run.status === 'approved' && (
                <form method="POST" style="flex:1;" onsubmit="return confirm('Mark this payroll as paid? This cannot be undone.')">
                  <input type="hidden" name="action" value="mark_paid" />
                  <input type="hidden" name="runId" value={run.id} />
                  <button type="submit" style="width:100%;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;font-size:12px;font-weight:500;padding:7px;border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Mark Paid
                  </button>
                </form>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- PAYSLIPS TAB -->
  {tab === 'payslips' && (
    <div style="padding:12px 16px;">
      <!-- Run selector -->
      <form method="GET" style="display:flex;gap:8px;margin-bottom:12px;">
        <input type="hidden" name="tab" value="payslips" />
        <select name="run" onchange="this.form.submit()" style="flex:1;min-width:0;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 12px;color:#fff;font-size:13px;outline:none;">
          <option value="">Select Payroll Run</option>
          {((Array.isArray(runs) ? runs : (runs?.rows || [])) as any[]).map(r => (
            <option value={r.id} selected={selectedRunId === r.id}>{MONTH_NAMES[(r.month||1)-1]} {r.year} · {r.status}</option>
          ))}
        </select>
      </form>

      {selectedRun && (
        <div style="background:#0f0f14;border:1px solid #FF4F00;border-radius:10px;padding:10px 14px;margin-bottom:12px;">
          <p style="font-size:12px;color:#FF7040;margin:0;font-weight:600;">{MONTH_NAMES[(selectedRun.month||1)-1]} {selectedRun.year} — {selectedRun.status?.toUpperCase()}</p>
          <p style="font-size:11px;color:#6e6e78;margin:4px 0 0;">{selectedRun.total_employees} employees · Net: ₹{fmt(selectedRun.total_net)}</p>
        </div>
      )}

      <div style="display:flex;flex-direction:column;gap:6px;">
        {!selectedRunId && <div style="text-align:center;padding:32px;color:#6e6e78;"><p style="font-size:13px;">Select a payroll run to view payslips</p></div>}
        {payslips && ((Array.isArray(payslips) ? payslips : (payslips?.rows || [])) as any[]).map(ps => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;overflow:hidden;">
            <div style="padding:12px 14px;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                <div>
                  <p style="font-size:13px;font-weight:600;color:#fff;margin:0;">{ps.full_name}</p>
                  <p style="font-size:10px;color:#6e6e78;margin:2px 0 0;font-family:'Geist Mono',monospace;">{ps.employee_code} · {ps.days_worked}d worked</p>
                </div>
                <div style="text-align:right;">
                  <p style="font-size:15px;font-weight:700;color:#6ee7b7;margin:0;">{ps.currency} {fmt(ps.net_salary)}</p>
                  <p style="font-size:10px;color:#6e6e78;margin:0;">net pay</p>
                </div>
              </div>
              {/* Earnings/Deductions breakdown. Bounded tracks so a long "INR 12,50,000" cannot
                  stretch the two tiles past the card on a phone. */}
              <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;">
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Basic</p>
                  <p style="font-size:11px;font-weight:500;color:#d8d8de;margin:2px 0 0;">{ps.currency} {fmt(ps.basic)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">Gross</p>
                  <p style="font-size:11px;font-weight:500;color:#d8d8de;margin:2px 0 0;">{ps.currency} {fmt(ps.gross_salary)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">PF</p>
                  <p style="font-size:11px;font-weight:500;color:#fca5a5;margin:2px 0 0;">- {ps.currency} {fmt(ps.pf_employee)}</p>
                </div>
                <div style="background:#15151a;border-radius:6px;padding:6px 8px;">
                  <p style="font-size:9px;color:#6e6e78;margin:0;text-transform:uppercase;">TDS</p>
                  <p style="font-size:11px;font-weight:500;color:#fca5a5;margin:2px 0 0;">- {ps.currency} {fmt(ps.tds)}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- SALARY SETUP TAB -->
  {tab === 'salary' && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:8px;">
      <p style="font-size:12px;color:#6e6e78;margin:0 0 8px;">Set salary structure for each employee. Changes take effect from current date.</p>
      {((Array.isArray(employees) ? employees : (employees?.rows || [])) as any[]).map(emp => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
          <button type="button" data-salary-emp={emp.id} class="salary-toggle" style="width:100%;background:none;border:none;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;text-align:left;">
            <div>
              <p style="font-size:13px;font-weight:600;color:#fff;margin:0;">{emp.full_name}</p>
              <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;font-family:'Geist Mono',monospace;">{emp.employee_code}</p>
            </div>
            <div style="text-align:right;">
              <p style="font-size:13px;font-weight:600;color:{emp.gross_salary ? '#fff' : '#6e6e78'};margin:0;">
                {emp.gross_salary ? `${emp.currency || 'INR'} ${fmt(emp.gross_salary)}/mo` : 'Not set'}
              </p>
              <p style="font-size:10px;color:#FF7040;margin:0;">Tap to edit ›</p>
            </div>
          </button>
          <div id={`salary-${emp.id}`} style="display:none;border-top:1px solid #1a1a1f;padding:14px;">
            <form method="POST" style="display:flex;flex-direction:column;gap:10px;">
              <input type="hidden" name="action" value="update_salary" />
              <input type="hidden" name="empId" value={emp.id} />
              {/* The salary fields are the worst offender on a phone: a bare 1fr track takes its
                  automatic minimum from the number input's intrinsic size (~150px each), so the two
                  columns needed ~320px before padding and the right-hand fields were cut off by the
                  card. minmax(0,1fr) pins each track to half the card and the width:100% inputs
                  shrink with it. Column count is unchanged, so the desktop form looks identical. */}
              <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
                <div style="grid-column:1/-1;display:flex;gap:8px;align-items:center;">
                  <label style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6e6e78;white-space:nowrap;">Currency</label>
                  <select name="currency" style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px;color:#fff;font-size:12px;outline:none;">
                    {['INR','USD','GBP','EUR','SGD','AED'].map(c => (
                      <option value={c} selected={emp.currency === c}>{c}</option>
                    ))}
                  </select>
                </div>
                {[
                  ['basic','Basic Salary', emp.basic || emp.base_salary],
                  ['hra','HRA', emp.hra],
                  ['da','DA', emp.da],
                  ['specialAllowance','Special Allowance', emp.special_allowance],
                  ['transportAllowance','Transport Allowance', emp.transport_allowance || 1600],
                  ['medicalAllowance','Medical Allowance', emp.medical_allowance || 1250],
                  ['otherAllowances','Other Allowances', emp.other_allowances],
                  ['tds','TDS (monthly)', emp.tds],
                ].map(([name, label, val]: any) => (
                  <div>
                    <label style="display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#6e6e78;margin-bottom:4px;">{label}</label>
                    <input type="number" name={name} value={val || 0} step="0.01" min="0" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12px;outline:none;" />
                  </div>
                ))}
              </div>
              <div style="background:#15151a;border-radius:8px;padding:8px 10px;font-size:11px;color:#6e6e78;">
                This form sets the fixed part of the salary. Provident fund, state insurance, professional
                tax and any other statutory deduction are <a href="/admin/hr/payroll/components" style="color:#FF7040;">configured components</a>
                with rates you set, applied when a run is generated. Nothing is assumed here.
              </div>
              <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:13px;padding:10px;border-radius:8px;cursor:pointer;">Save Salary Structure</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<!-- Create Payroll Run Modal -->
<div id="runModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:flex-end;justify-content:center;">
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px 16px 0 0;width:100%;max-width:600px;padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <h2 style="font-size:15px;font-weight:700;color:#fff;margin:0;">Create Payroll Run</h2>
      <button onclick="document.getElementById('runModal').style.display='none'" style="background:#1a1a1f;border:none;color:#8a8a94;width:30px;height:30px;border-radius:6px;font-size:18px;cursor:pointer;">&times;</button>
    </div>
    <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="hidden" name="action" value="create_run" />
      {/* Same bounded tracks for the month/year pair. This modal is position:fixed, so its overflow
          escapes to the viewport and would scroll the page sideways while the sheet is open. */}
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6e6e78;margin-bottom:5px;">Month</label>
          <select name="month" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;">
            {MONTH_NAMES.map((m, i) => (
              <option value={i+1} selected={i+1 === currentMonth}>{m}</option>
            ))}
          </select>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6e6e78;margin-bottom:5px;">Year</label>
          <input type="number" name="year" value={currentYear} min="2024" max="2030" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
      </div>
      <div>
        <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6e6e78;margin-bottom:5px;">Notes (optional)</label>
        <input type="text" name="notes" placeholder="e.g. May 2026 payroll" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
      </div>
      <div style="background:rgba(255,159,0,0.08);border:1px solid rgba(255,159,0,0.2);border-radius:8px;padding:10px 12px;">
        <p style="font-size:11px;color:#fbbf24;margin:0;">This will auto-calculate salary for all active employees based on their salary structures and attendance data for the selected month.</p>
      </div>
      <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;">Generate Payroll</button>
    </form>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.salary-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var empId = btn.getAttribute('data-salary-emp');
      var panel = document.getElementById('salary-' + empId);
      if (panel) panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    });
  });
});
</script>
</AdminLayout>
