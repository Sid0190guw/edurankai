---
import AdminLayout from '@/layouts/AdminLayout.astro';
// readLeave(), NOT listLeave(). listLeave() goes through an internal safe() helper that catches,
// logs and returns [] — so a total read failure rendered "No leave requests waiting." on the screen
// where being wrong means somebody's time off is never actioned. Day one and an outage were the same
// sentence. readLeave() carries the outcome; the page says which of the three it is looking at.
import { readLeave, decideLeave, describeUnits, leaveTypeName } from '@/lib/hr-leave';
import { canAccessSection } from '@/lib/auth/permissions';
import DayOne from '@/components/admin/DayOne.astro';
// Whether there is anybody to have leave, and whether the holiday calendar exists. Both change what
// an empty queue MEANS on this page, and neither was ever stated on it.
import { readSetupStatus, PREREQUISITE } from '@/lib/day-one';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
// Same substring defect as /admin/hr/wallet, on the page that approves leave:
// `role.indexOf('hr') >= 0` gave approval authority to any role whose name contains those letters,
// and the 'admin' arm was dead (no such value in userRoleEnum). `leave` is the section key
// middleware.ts:57 already maps this path to, so the page and the middleware now ask one question
// instead of two that can drift apart. hr holds it; the gate fails closed on an unknown role.
//
// DELIBERATELY NOT `can(user, 'leave.approve')`, for the reason written out in full at the top of
// /admin/hr/wallet: a custom role holding the `leave` section resolves as `leave.edit` and never as
// `leave.approve`, so a bare swap removes access from every custom role that has it, and accepting
// either widens it for an `hr` account whose custom role omits the section. Both are policy changes.
// The decision itself is capability-checked where it binds — decideLeave() calls
// approverRole(user, id, 'leave.approve') on every posted decision.
if (!(await canAccessSection(user, 'leave', 'edit'))) return Astro.redirect('/admin');

let flash = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('action') === 'decide') {
    const r = await decideLeave(fd.get('id') as string, user, (fd.get('decision') as string) === 'approved' ? 'approved' : 'rejected', (fd.get('note') as string) || '');
    // THE WARNING IS APPENDED, NOT DROPPED. decideLeave() returns one when the decision COMMITTED but
    // something that should have accompanied it did not — the audit row that is the only record of who
    // approved this, or the attendance days payroll reads. Its docblock says callers must append it,
    // and this line printed a flat "Decision recorded." straight over the top of it.
    flash = r.ok
      ? ('Decision recorded.' + (r.warning ? ' ' + r.warning : ''))
      : 'Error: ' + r.error;
  }
  return Astro.redirect('/admin/hr/leave?msg=' + encodeURIComponent(flash));
}

const leaveRead = await readLeave({});
const all = leaveRead.rows;
const pending = all.filter((l: any) => l.status === 'pending');
const recent = all.filter((l: any) => l.status !== 'pending').slice(0, 25);

// WHAT AN EMPTY QUEUE MEANS HERE DEPENDS ON TWO THINGS OUTSIDE THIS TABLE.
//
//   * With no employee records, nobody can have requested leave. The queue is empty because the
//     platform is not set up, not because everybody is at their desk.
//   * With no holiday calendar, approvals still work — and charge every day in a request as an
//     ordinary day, so a public holiday inside somebody's week off costs them a day of their
//     allowance. That happens from the FIRST approval, silently, and this page never said so.
//
// Both are counted behind safeRows and neither can take this page down.
let employeesConfigured: boolean | null = null;
let holidaysConfigured: boolean | null = null;
try {
  const setup = await readSetupStatus();
  const emp = setup.find((s) => s.step.id === 'employees');
  const hol = setup.find((s) => s.step.id === 'holidays');
  employeesConfigured = emp && emp.state !== 'unknown' ? emp.state === 'done' : null;
  holidaysConfigured = hol && hol.state !== 'unknown' ? hol.state === 'done' : null;
} catch (e: any) {
  // Never silently: an absent prerequisite notice would read as "everything is configured".
  console.error('[admin/hr/leave] setup status could not be read -', e?.cause?.message || e?.message);
}
const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const fmt = (d: any) => new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const statusColor: Record<string, string> = { approved: '#86efac', rejected: '#fca5a5', cancelled: '#8a8a94' };

// WHAT THE REQUEST ACTUALLY COSTS, not the calendar span it occupies. A half day and an hour both
// occupy one day, and showing "1d" for either would have an approver reading a two-hour request as a
// whole day off. day_units is the true cost; rows written before part-days existed have none and
// fall back to days, which is exactly what they always meant.
const unitWords = (l: any) => describeUnits(
  String(l?.unit || 'full'),
  Number(l?.day_units ?? l?.days) || 0,
  l?.hours === null || l?.hours === undefined ? null : Number(l.hours),
);
const dayPartWords = (l: any) =>
  l?.day_part === 'first_half' ? ' · first half' : (l?.day_part === 'second_half' ? ' · second half' : '');
---
<AdminLayout title="Leave approvals" activeNav="">
  <div class="admin-page" style="max-width:1000px;">
    <div class="admin-page-header"><div class="admin-page-title-block">
      <div class="admin-page-eyebrow">HR Management · Time off</div>
      <h1 class="admin-page-title">Leave approvals</h1>
      <p class="admin-page-sub">Approve or reject leave requests. Reporting managers, HR heads, admins and super-admins can decide.</p>
    </div></div>
    {msg && <div style="margin:0 0 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{msg}</div>}

    {/* The multi-step engine, made reachable from the page people already open. NOTHING ELSE ON
        THIS PAGE CHANGES: decideLeave() -> approverRole() still decides every request below, and a
        reporting manager can still approve their own report's leave here without holding any
        capability. That arm is a per-row relationship and is already correct. The workflow view is
        the other route - sequential and parallel rungs resolved from the Organization Graph, with
        delegation and escalation - and it is a LINK rather than a redirect precisely so neither
        path is taken away from anybody who relies on it. */}
    <p class="wflink">
      Multi-step routing, delegation and escalation live on the
      <a href="/admin/hr/leave/workflow">approval workflow view</a>.
      Approving here still works exactly as it always has.
      Days off are named on the <a href="/admin/hr/holidays">holiday calendar</a>, and a holiday
      inside a request is never charged against anybody's allowance.
    </p>

    {/* THE HOLIDAY CALENDAR, NAMED ON THE SCREEN WHERE ITS ABSENCE COSTS SOMETHING.
        Approvals here start working immediately. With no calendar every day inside a request is
        charged, and the only route to the calendar in the whole console was a sentence at the bottom
        of this page — on a screen the sidebar does not carry. */}
    {holidaysConfigured === false && (
      <div style="margin:0 0 16px;">
        <DayOne
          state="unconfigured"
          thing="The holiday calendar"
          unconfiguredBody="Approving leave below works, and it is charging every day in each request as an ordinary working day. No holiday has been recorded for this year, so a public holiday falling inside somebody's time off costs them a day of their allowance — from the first approval, with nothing on screen to say it happened."
          prereqs={[PREREQUISITE.holidays]}
          compact={true}
        />
      </div>
    )}

    <h2 style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#c2410c;font-weight:700;margin:0 0 10px;">Pending · {leaveRead.ok ? pending.length : 'unknown'}</h2>
    {/* THREE STATES ON A DECISION SCREEN. "No leave requests waiting." used to be printed over a
        failed read, over a platform with no employees in it, and over a genuinely clear queue. */}
    {pending.length === 0 && (
      <div style="margin-bottom:20px;">
        <DayOne
          state={!leaveRead.ok ? 'unreadable' : (employeesConfigured === false ? 'unconfigured' : 'empty')}
          thing="The leave queue"
          error={leaveRead.error}
          unconfiguredBody="No employee record exists yet, so nobody can have requested leave. This queue is empty because the platform has not been set up, not because everybody is at their desk."
          emptyBody="No leave request is waiting on a decision. Nothing is stuck; this is the state you want it in."
          prereqs={employeesConfigured === false ? [PREREQUISITE.employees] : []}
          compact={true}
        />
      </div>
    )}
    {pending.map((l: any) => (
      <div class="lrow">
        <div class="lmeta">
          <div style="color:#fff;font-weight:700;">{l.full_name || 'Employee'} · {leaveTypeName(l.leave_type)} · {unitWords(l)}</div>
          <div style="color:#8a8a94;font-size:12px;">{l.employee_code} · {fmt(l.start_date)} – {fmt(l.end_date)}{dayPartWords(l)}{l.reason ? ' · ' + l.reason : ''}</div>
        </div>
        <form method="POST" class="lform">
          <input type="hidden" name="action" value="decide"/><input type="hidden" name="id" value={l.id}/>
          <input name="note" class="lfi" placeholder="note (optional)"/>
          <button name="decision" value="approved" class="lbtn" style="background:#22c07e;">Approve</button>
          <button name="decision" value="rejected" class="lbtn" style="background:transparent;border:1px solid #444;color:#fca5a5;">Reject</button>
        </form>
      </div>
    ))}

    {recent.length > 0 && (<div>
      <h2 style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#8a8a94;font-weight:700;margin:24px 0 10px;">Recent</h2>
      {recent.map((l: any) => (
        <div class="lrow" style="opacity:.75;">
          <div class="lmeta"><div style="color:#cfd6da;">{l.full_name} · {leaveTypeName(l.leave_type)} · {unitWords(l)}</div><div style="color:#8a8a94;font-size:12px;">{fmt(l.start_date)} – {fmt(l.end_date)}{l.decided_by_role ? ' · by ' + l.decided_by_role : ''}</div></div>
          <span class="lstat" style={`color:${statusColor[l.status]||'#8a8a94'};`}>{l.status}</span>
        </div>
      ))}
    </div>)}
  </div>
  <style>
    /* overflow-wrap so the sentence cannot push the page sideways on a 360px phone. */
    .wflink{ font-size:13px;color:#8a8a94;margin:0 0 18px;line-height:1.55;overflow-wrap:anywhere; }
    .wflink a{ color:#f97316; }
    .lfi{ background:#08080b;border:1px solid #262630;border-radius:7px;padding:8px 10px;color:#fff;font-size:13px;outline:none;font-family:inherit;width:150px;flex:1 1 150px;min-width:0; }
    .lbtn{ border:none;border-radius:7px;padding:8px 14px;color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:'Geist Mono',monospace;white-space:nowrap; }
    .lrow{ display:flex;align-items:center;gap:12px;background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:12px 14px;margin-bottom:8px;flex-wrap:wrap; }
    /* A flex item defaults to min-width:auto, so a long unbroken word (an email, an employee
       code, a pasted reason) makes this cell wider than the phone and the PAGE scrolls sideways.
       min-width:0 + overflow-wrap lets the text wrap inside the card instead. */
    .lmeta{ flex:1 1 220px;min-width:0;overflow-wrap:anywhere; }
    /* The decide form used to be a non-wrapping flex line: a 150px note field plus two nowrap
       buttons is ~313px of unshrinkable content, wider than the ~302px a 360px phone leaves
       inside this card. These are independent controls, not table columns, so they reflow. */
    .lform{ display:flex;gap:6px;align-items:center;flex-wrap:wrap;flex:1 1 260px;min-width:0; }
    .lstat{ font-family:'Geist Mono',monospace;font-size:10px;font-weight:700;text-transform:uppercase;flex:0 0 auto; }
    @media (max-width:520px){
      .lform{ flex:1 1 100%; }
      .lfi{ flex:1 1 100%; }
      .lbtn{ flex:1 1 auto; }
    }
  </style>
</AdminLayout>
