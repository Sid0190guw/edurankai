---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql as sqlExpr } from 'drizzle-orm';
import { can, canAccessSection } from '@/lib/auth/permissions';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// CONVERTED FROM A ROLE-NAME TEST. This page's only gate used to be
// `user.role === 'applicant'` -- the exact test canAccessSection()'s docblock warns against, and the
// one its own siblings (./reports.astro:47, ../holidays/index.astro:50) already stopped using. It
// matters more here than on a read-only screen: the POST handler below MARKS ATTENDANCE, and a day
// marked 'absent' is counted by computePay() in src/lib/payroll.ts as a loss-of-pay day and priced
// against the month's gross. A gate that admits everyone who is merely not an applicant is a gate on
// somebody else's salary.
//
// TWO HOLES IT CLOSED, both invisible to a built-in HR account and neither hypothetical:
//   1. VIEW-ONLY CUSTOM ROLES GOT THE WRITE SURFACE. The middleware section gate
//      (src/middleware.ts:409) admits anyone whose custom role grants VIEW on the `attendance` page
//      key, and this page then asked nothing further -- so a role deliberately configured to look and
//      not touch could mark any employee absent. Asking for 'edit', as the two sibling pages do, is
//      what makes the view/edit distinction mean anything on this screen.
//   2. AN UNKNOWN ROLE WAS UNRESTRICTED. defaultSectionKeysForRole() returns null -- "do not
//      restrict" -- for any role absent from ROLE_SECTIONS, so the middleware gate stood down
//      entirely for such an account and the role-name test was the only thing left.
//
// MECHANISM, NOT POLICY: the population is unchanged. 'attendance.roster.manage' is granted in
// PERMS_BY_ROLE to exactly super_admin and hr, and `hr` is the only built-in role carrying the
// `attendance` section in ROLE_SECTIONS -- which is to say, precisely the accounts the middleware
// already let through this door. The canAccessSection arm is kept for the reason /admin/hr/leave
// states: can() cannot see custom roles, and the registry resolves an `attendance` section row as
// attendance.edit and NEVER as attendance.roster.manage, so dropping it would silently close this
// screen to every custom role that legitimately holds it today.
const attendanceDesk = await canAccessSection(user, 'attendance', 'edit');
const mayManage = can(user as any, 'attendance.roster.manage') || attendanceDesk;
if (!mayManage) return Astro.redirect('/admin');

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (action === 'mark') {
      const employeeId = fd.get('employeeId') as string;
      const date = fd.get('date') as string;
      const status = fd.get('status') as string;
      const clockIn = fd.get('clockIn') as string;
      const clockOut = fd.get('clockOut') as string;
      const workMode = fd.get('workMode') as string || 'remote';
      const notes = (fd.get('notes') as string || '').trim();

      // Calculate work hours. If clock_out is earlier than clock_in (overnight
      // shift), assume it's the NEXT day - that's the bug behind "-7.50h".
      let workHours: number | null = null;
      let clockInTs: string | null = clockIn ? `${date}T${clockIn}:00` : null;
      let clockOutTs: string | null = clockOut ? `${date}T${clockOut}:00` : null;
      if (clockIn && clockOut) {
        const inTime = new Date(`${date}T${clockIn}`);
        let outTime = new Date(`${date}T${clockOut}`);
        if (outTime.getTime() <= inTime.getTime()) {
          outTime = new Date(outTime.getTime() + 24 * 3600 * 1000);
          const y = outTime.getFullYear();
          const m = String(outTime.getMonth() + 1).padStart(2, '0');
          const d = String(outTime.getDate()).padStart(2, '0');
          clockOutTs = `${y}-${m}-${d}T${clockOut}:00`;
        }
        workHours = Math.round(((outTime.getTime() - inTime.getTime()) / 3600000) * 100) / 100;
      }

      await db.execute(sqlExpr`
        INSERT INTO hr_attendance (employee_id, date, clock_in, clock_out, work_hours, status, work_mode, notes, ip_address)
        VALUES (
          ${employeeId}, ${date},
          ${clockInTs},
          ${clockOutTs},
          ${workHours}, ${status}, ${workMode}, ${notes || null},
          ${Astro.clientAddress || null}
        )
        ON CONFLICT (employee_id, date)
        DO UPDATE SET
          clock_in = EXCLUDED.clock_in,
          clock_out = EXCLUDED.clock_out,
          work_hours = EXCLUDED.work_hours,
          status = EXCLUDED.status,
          work_mode = EXCLUDED.work_mode,
          notes = EXCLUDED.notes
      `);
      successMsg = 'Attendance saved.';
    } else if (action === 'delete') {
      const employeeId = fd.get('employeeId') as string;
      const date = fd.get('date') as string;
      await db.execute(sqlExpr`DELETE FROM hr_attendance WHERE employee_id = ${employeeId} AND date = ${date}`);
      successMsg = 'Attendance entry deleted.';
    } else if (action === 'bulk_mark') {
      const date = fd.get('date') as string;
      const status = fd.get('status') as string;
      const workMode = fd.get('workMode') as string || 'remote';

      const emps = await db.execute(sqlExpr`SELECT id FROM hr_employees WHERE is_active = true`);
      const _empRows = (Array.isArray(emps) ? emps : (emps?.rows || [])) as any[];
      let count = 0;
      for (const emp of _empRows) {
        await db.execute(sqlExpr`
          INSERT INTO hr_attendance (employee_id, date, status, work_mode)
          VALUES (${emp.id}, ${date}, ${status}, ${workMode})
          ON CONFLICT (employee_id, date) DO NOTHING
        `);
        count++;
      }
      successMsg = `Marked ${count} employees as ${status} for ${date}.`;
    }
  } catch (err: any) {
    // The real Postgres reason is on `.cause`; `.message` is only the failed SQL text, which is
    // what an administrator was being shown instead of what actually went wrong.
    console.error('[attendance] action failed -', err?.cause?.message || err?.message);
    errorMsg = 'That did not save: ' + (err?.cause?.message || err?.message || 'unknown database error');
  }
}

const url = new URL(Astro.request.url);
const tab = url.searchParams.get('tab') || 'today';
const dateFilter = url.searchParams.get('date') || new Date().toISOString().split('T')[0];
const empFilter = url.searchParams.get('emp') || '';

// One-shot heal: fix rows where clock_out got stored on the same calendar day
// as clock_in but is earlier (overnight shifts). Shift clock_out to next day
// and recompute work_hours. Idempotent - matches zero rows once corrected.
try {
  await db.execute(sqlExpr`
    UPDATE hr_attendance
    SET clock_out = clock_out + INTERVAL '1 day',
        work_hours = ROUND((EXTRACT(EPOCH FROM ((clock_out + INTERVAL '1 day') - clock_in)) / 3600.0)::numeric, 2)
    WHERE clock_in IS NOT NULL AND clock_out IS NOT NULL AND clock_out < clock_in
  `);
} catch (_) {}

// Today's attendance (with the employee's daily diary/progress report for the day)
const todayAttendance = await db.execute(sqlExpr`
  SELECT a.*, e.full_name, e.employee_code, e.designation,
    dr.work_done AS report_work, dr.progress AS report_progress, dr.blockers AS report_blockers,
    (SELECT COALESCE(SUM(hours),0) FROM hr_time_logs tl WHERE tl.employee_id = a.employee_id AND tl.log_date = a.date) AS logged_hours,
    (SELECT COUNT(*)::int FROM hr_time_logs tl WHERE tl.employee_id = a.employee_id AND tl.log_date = a.date) AS log_count
  FROM hr_attendance a
  JOIN hr_employees e ON a.employee_id = e.id
  LEFT JOIN hr_daily_reports dr ON dr.employee_id = a.employee_id AND dr.report_date = a.date
  WHERE a.date = ${dateFilter}
  ORDER BY e.full_name
`);

// Time-period logs for the day (per employee) to show under attendance.
const dayTimeLogs = await db.execute(sqlExpr`SELECT employee_id, start_time, end_time, hours, task FROM hr_time_logs WHERE log_date = ${dateFilter} ORDER BY start_time ASC`);
const _dtl = (Array.isArray(dayTimeLogs) ? dayTimeLogs : (dayTimeLogs?.rows || [])) as any[];
const timeLogsByEmp: Record<string, any[]> = {};
for (const t of _dtl) (timeLogsByEmp[t.employee_id] = timeLogsByEmp[t.employee_id] || []).push(t);

// Face check-ins for the selected day (advisory attendance proof — a human
// verifies these; they never auto-penalise). Guarded because face_photo
// self-bootstraps on first clock event and may not exist on older DBs.
let faceCheckins: any[] = [];
try {
  const fr = await db.execute(sqlExpr`
    SELECT ce.id, ce.event_type, ce.event_time, ce.face_photo, ce.location_name,
           e.full_name, e.employee_code
    FROM hr_clock_events ce
    JOIN hr_employees e ON ce.employee_id = e.id
    WHERE DATE(ce.event_time) = ${dateFilter} AND ce.face_photo IS NOT NULL
    ORDER BY ce.event_time DESC
    LIMIT 60
  `);
  faceCheckins = (Array.isArray(fr) ? fr : (fr?.rows || [])) as any[];
} catch (_) {}

// Employees not marked today
const unmarkedToday = await db.execute(sqlExpr`
  SELECT e.id, e.full_name, e.employee_code, e.designation
  FROM hr_employees e
  WHERE e.is_active = true
  AND e.id NOT IN (SELECT employee_id FROM hr_attendance WHERE date = ${dateFilter})
  ORDER BY e.full_name
`);

// Monthly summary for an employee
const monthlySummary = empFilter ? await db.execute(sqlExpr`
  SELECT 
    COUNT(*) FILTER (WHERE status = 'present') as present_days,
    COUNT(*) FILTER (WHERE status = 'absent') as absent_days,
    COUNT(*) FILTER (WHERE status = 'half_day') as half_days,
    COUNT(*) FILTER (WHERE status = 'wfh') as wfh_days,
    COUNT(*) FILTER (WHERE status = 'on_leave') as leave_days,
    ROUND(AVG(work_hours)::numeric, 1) as avg_hours,
    SUM(overtime_hours) as total_overtime
  FROM hr_attendance a
  WHERE a.employee_id = ${empFilter}
  AND DATE_TRUNC('month', a.date) = DATE_TRUNC('month', NOW())
`) : null;

// Stats for today
const todayStats = await db.execute(sqlExpr`
  SELECT 
    COUNT(*) FILTER (WHERE status = 'present') as present,
    COUNT(*) FILTER (WHERE status = 'absent') as absent,
    COUNT(*) FILTER (WHERE status = 'wfh') as wfh,
    COUNT(*) FILTER (WHERE status = 'half_day') as half,
    COUNT(*) FILTER (WHERE status = 'on_leave') as on_leave,
    COUNT(*) as total
  FROM hr_attendance WHERE date = ${dateFilter}
`);
const _todayStatsRows = Array.isArray(todayStats) ? todayStats : (todayStats?.rows || []);
const ts = (_todayStatsRows[0] || {}) as any;
const _monthlyRows = monthlySummary ? (Array.isArray(monthlySummary) ? monthlySummary : (monthlySummary?.rows || [])) : [];
const ms = (_monthlyRows[0] || {}) as any;

const EMPLOYEE_PICKER_LIMIT = 200;
const allEmployees = await db.execute(sqlExpr`SELECT id, full_name, employee_code FROM hr_employees WHERE is_active = true ORDER BY full_name LIMIT ${EMPLOYEE_PICKER_LIMIT}`);
const employeeOptions = (Array.isArray(allEmployees) ? allEmployees : ((allEmployees as any)?.rows || [])) as any[];
const attendanceRows = (Array.isArray(todayAttendance) ? todayAttendance : ((todayAttendance as any)?.rows || [])) as any[];

// THE MARK / EDIT SHEET IS OPENED BY A URL, NOT BY JAVASCRIPT.
//
// "+ Mark" was a <button onclick="...style.display='flex'"> and every row's Edit called
// editAttendance(this) from an inline script at the foot of the page. Until that script had parsed —
// which on a mid-range phone on a weak connection is well after the page is readable — both controls
// were dead on tap, with no error and nothing to retry. Marking somebody absent prices a
// loss-of-pay day against their salary, so this is not a cosmetic surface.
//
// The sheet is now rendered by the server from ?sheet=new or ?sheet=edit&sheetEmp=<id>. It needs no
// script at all, it survives the back button, and an Edit link can be reopened or shared.
const sheetMode = url.searchParams.get('sheet') || '';
const sheetEmpId = url.searchParams.get('sheetEmp') || '';
const sheetRow = sheetMode === 'edit'
  ? (attendanceRows.find((a: any) => String(a.employee_id) === sheetEmpId) || null)
  : null;
const sheetOpen = sheetMode === 'new' || sheetMode === 'edit';
/** An edit whose row is no longer on this date falls back to a blank entry rather than lying. */
const isEditSheet = sheetMode === 'edit' && sheetRow !== null;
const sheetBack = '?tab=' + encodeURIComponent(tab) + '&date=' + encodeURIComponent(dateFilter)
  + (empFilter ? '&emp=' + encodeURIComponent(empFilter) : '');
const sheetNewHref = sheetBack + '&sheet=new';

const STATUS_COLORS: Record<string, string> = {
  present: 'rgba(16,185,129,0.15)',
  absent: 'rgba(239,68,68,0.15)',
  half_day: 'rgba(251,191,36,0.15)',
  wfh: 'rgba(99,102,241,0.15)',
  on_leave: 'rgba(168,85,247,0.15)',
  holiday: 'rgba(107,114,128,0.15)',
};
const STATUS_TEXT: Record<string, string> = {
  present: '#6ee7b7',
  absent: '#fca5a5',
  half_day: '#fbbf24',
  wfh: '#a5b4fc',
  on_leave: '#d8b4fe',
  holiday: '#9ca3af',
};

function formatTime(ts: any) {
  if (!ts) return '—';
  return new Date(ts).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
}
function timeInputValue(ts: any) {
  if (!ts) return '';
  const d = new Date(ts);
  return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
}
function dateValue(d: any) {
  if (!d) return '';
  return String(d).slice(0, 10);
}
function crossesMidnight(a: any) {
  if (!a.clock_in || !a.clock_out) return false;
  return new Date(a.clock_in).toDateString() !== new Date(a.clock_out).toDateString();
}
// SVG status glyph (no emoji — house rule). stroke:currentColor inherits the badge colour.
function statusIcon(status: string) {
  const p: Record<string, string> = {
    present: '<polyline points="20 6 9 17 4 12"/>',
    absent: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
    wfh: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    half_day: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"/>',
    on_leave: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
    holiday: '<circle cx="12" cy="12" r="9"/>',
  };
  const inner = p[status] || '<line x1="5" y1="12" x2="19" y2="12"/>';
  return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">' + inner + '</svg>';
}
const ICON_ALERT = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
---
<AdminLayout title="Attendance — HRMS" activeNav="hr">
<div style="padding-bottom:80px;">

  <!-- Header -->
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">HRMS · Attendance</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Attendance</h1>
        <p style="font-size:12px;color:#8a8a94;margin:6px 0 0;line-height:1.55;overflow-wrap:anywhere;">
          <a href="/admin/hr/attendance/reports" style="color:#f97316;">Reports over a period</a> ·
          <a href="/admin/hr/holidays" style="color:#f97316;">Holiday calendar</a> ·
          <a href="/admin/hr/leave" style="color:#f97316;">Leave approvals</a>
        </p>
      </div>
      <a href={sheetNewHref} style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:12px;padding:0 14px;border-radius:8px;cursor:pointer;text-decoration:none;min-height:44px;display:inline-flex;align-items:center;white-space:nowrap;flex:0 0 auto;">+ Mark</a>
    </div>

    <!-- Date picker -->
    <form method="GET" style="display:flex;gap:8px;margin-bottom:12px;">
      <input type="hidden" name="tab" value={tab} />
      <input type="date" name="date" value={dateFilter} style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 12px;color:#fff;font-size:13px;outline:none;" onchange="this.form.submit()" />
      <button type="submit" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 14px;color:#fff;font-size:12px;cursor:pointer;">Go</button>
    </form>

    <!-- Stats for selected date. Five independent tiles, so they REFLOW rather than
         scroll: nothing here has to stay aligned with a row below it. auto-fit keeps
         them five-up wherever five still fit (360px and wider) and drops to four on a
         320px phone instead of squeezing the labels. On desktop auto-fit collapses the
         empty tracks, so the tiles still stretch across exactly as before. -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(58px,1fr));gap:6px;margin-bottom:12px;">
      {[
        { label: 'Present', value: ts.present, color: '#6ee7b7' },
        { label: 'Absent', value: ts.absent, color: '#fca5a5' },
        { label: 'WFH', value: ts.wfh, color: '#a5b4fc' },
        { label: 'Half', value: ts.half, color: '#fbbf24' },
        { label: 'Leave', value: ts.on_leave, color: '#d8b4fe' },
      ].map(stat => (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:8px;padding:6px;text-align:center;">
          <p style={`font-size:16px;font-weight:700;color:${stat.color};margin:0;line-height:1;`}>{stat.value || 0}</p>
          <p style="font-size:8px;color:#6e6e78;margin:2px 0 0;text-transform:uppercase;">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Tabs -->
    <div style="display:flex;gap:4px;">
      {[['today','Daily'],['monthly','Monthly'],['bulk','Bulk Mark']].map(([t, label]) => (
        <a href={`?tab=${t}&date=${dateFilter}`} style={`text-decoration:none;font-size:12px;font-weight:600;padding:6px 12px;border-radius:6px;${tab === t ? 'background:#FF4F00;color:#fff;' : 'background:#15151a;color:#8a8a94;'}`}>{label}</a>
      ))}
    </div>
  </div>

  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {successMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{successMsg}</div>}

  <!-- DAILY TAB -->
  {tab === 'today' && (
    <div style="padding:12px 16px;">
      {faceCheckins.length > 0 && (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:12px 14px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:7px;margin-bottom:10px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <p style="font-size:12px;font-weight:700;color:#fff;margin:0;">Face check-ins</p>
            <span style="font-size:10px;color:#6e6e78;">{faceCheckins.length} · advisory — verify visually</span>
          </div>
          <div style="display:flex;gap:10px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px;">
            {(faceCheckins as any[]).map((f: any) => (
              <div style="flex-shrink:0;width:76px;text-align:center;">
                <div style="position:relative;width:76px;height:76px;border-radius:10px;overflow:hidden;border:1px solid #1a1a1f;background:#000;">
                  <img src={f.face_photo} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1);" />
                  <span style={`position:absolute;left:4px;bottom:4px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:1px 5px;border-radius:99px;color:#fff;background:${f.event_type==='clock_in'?'rgba(16,185,129,.9)':f.event_type==='clock_out'?'rgba(239,68,68,.9)':'rgba(251,191,36,.9)'};`}>{f.event_type==='clock_in'?'IN':f.event_type==='clock_out'?'OUT':f.event_type==='break_start'?'BRK':'RES'}</span>
                </div>
                <p style="font-size:10px;color:#d8d8de;margin:4px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{f.full_name?.split(' ')[0]}</p>
                <p style="font-size:9px;color:#6e6e78;margin:0;font-family:'Geist Mono',monospace;">{formatTime(f.event_time)}</p>
              </div>
            ))}
          </div>
        </div>
      )}
      {(Array.isArray(unmarkedToday) ? unmarkedToday : (unmarkedToday?.rows || [])).length > 0 && (
        <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.2);border-radius:10px;padding:10px 14px;margin-bottom:12px;">
          <p style="font-size:12px;color:#fbbf24;font-weight:600;margin:0 0 4px;"><span set:html={ICON_ALERT}></span>{(Array.isArray(unmarkedToday) ? unmarkedToday : (unmarkedToday?.rows || [])).length} employees not yet marked for {dateFilter}</p>
          <div style="display:flex;flex-wrap:wrap;gap:4px;">
            {((Array.isArray(unmarkedToday) ? unmarkedToday : (unmarkedToday?.rows || [])) as any[]).slice(0, 8).map((e: any) => (
              <span style="font-size:10px;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;padding:2px 8px;border-radius:100px;">{e.full_name.split(' ')[0]}</span>
            ))}
            {(Array.isArray(unmarkedToday) ? unmarkedToday : (unmarkedToday?.rows || [])).length > 8 && <span style="font-size:10px;color:#6e6e78;">+{(Array.isArray(unmarkedToday) ? unmarkedToday : (unmarkedToday?.rows || [])).length - 8} more</span>}
          </div>
        </div>
      )}

      <div style="display:flex;flex-direction:column;gap:6px;">
        {(Array.isArray(todayAttendance) ? todayAttendance : (todayAttendance?.rows || [])).length === 0 && (
          <div style="text-align:center;padding:48px;color:#6e6e78;">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;opacity:0.7;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <p style="font-size:13px;">No attendance marked for {dateFilter}</p>
          </div>
        )}
        {((Array.isArray(todayAttendance) ? todayAttendance : (todayAttendance?.rows || [])) as any[]).map(a => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:12px 14px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style={`width:36px;height:36px;border-radius:8px;background:${STATUS_COLORS[a.status] || 'rgba(107,114,128,0.15)'};display:flex;align-items:center;justify-content:center;flex-shrink:0;`}>
                <span style={`color:${STATUS_TEXT[a.status] || '#9ca3af'};display:flex;`} set:html={statusIcon(a.status)}></span>
              </div>
              <div style="flex:1;min-width:0;">
                <p style="font-size:13px;font-weight:600;color:#fff;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{a.full_name}</p>
                <p style="font-size:10px;color:#6e6e78;margin:2px 0 0;">
                  {formatTime(a.clock_in)} {crossesMidnight(a) ? '(prev) ' : ''}to {formatTime(a.clock_out)} {crossesMidnight(a) ? '(next day) ' : ''}
                  {a.work_hours != null ? ` · ${a.work_hours}h clocked` : ''}
                  {Number(a.logged_hours) > 0 ? ` · ${a.logged_hours}h logged (${a.log_count})` : ''}
                  {a.work_mode ? ` · ${a.work_mode}` : ''}
                </p>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;">
                <span style={`font-size:9px;font-weight:700;padding:2px 8px;border-radius:100px;text-transform:uppercase;background:${STATUS_COLORS[a.status] || 'rgba(107,114,128,0.15)'};color:${STATUS_TEXT[a.status] || '#9ca3af'};`}>
                  {a.status.replace('_', ' ')}
                </span>
                {/* Edit is a LINK to the server-rendered sheet — it needs no script, and it was
                    10.5px inside a 20px-tall box, well under the 44px a thumb can reliably hit next
                    to a Delete that removes a pay-affecting record. Both are 44px now. */}
                <div style="display:flex;gap:8px;">
                  <a href={sheetBack + '&sheet=edit&sheetEmp=' + a.employee_id}
                    aria-label={'Edit attendance for ' + a.full_name}
                    style="background:#15151a;border:1px solid #26262e;color:#FF7040;font-size:12px;font-weight:600;padding:0 14px;border-radius:6px;cursor:pointer;text-decoration:none;min-height:44px;display:inline-flex;align-items:center;">Edit</a>
                  {/* "Delete this attendance entry?" named nothing. The same prompt appeared on every
                      row, so on a phone — where the rows are 8px apart — there was no way to tell
                      from the dialog whether you had hit the right person's. It says so now. */}
                  <form method="POST" style="margin:0;display:inline;" onsubmit={`return confirm('Delete the attendance entry for ${String(a.full_name || 'this employee').replace(/'/g, '')} on ${dateValue(a.date)}? It is currently ${String(a.status || '').replace('_', ' ')}${a.work_hours != null ? ' with ' + a.work_hours + ' hours clocked' : ''}. Deleting it leaves the day unmarked, which counts as neither present nor absent until somebody marks it again.')`}>
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="employeeId" value={a.employee_id} />
                    <input type="hidden" name="date" value={dateValue(a.date)} />
                    <button type="submit" aria-label={'Delete attendance for ' + a.full_name} style="background:#15151a;border:1px solid rgba(239,68,68,0.4);color:#fca5a5;font-size:12px;font-weight:600;padding:0 14px;border-radius:6px;cursor:pointer;min-height:44px;">Delete</button>
                  </form>
                </div>
              </div>
            </div>
            {(timeLogsByEmp[a.employee_id] && timeLogsByEmp[a.employee_id].length > 0) && (
              <div style="margin-top:10px;padding-top:10px;border-top:1px solid #1a1a1f;">
                <p style="font-size:10px;color:#6e6e78;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 5px;">Hourly time log</p>
                <div style="display:flex;flex-direction:column;gap:4px;">
                  {timeLogsByEmp[a.employee_id].map((t: any) => (
                    <div style="display:flex;gap:8px;font-size:11.5px;">
                      <span style="color:#FF7040;font-family:monospace;white-space:nowrap;">{t.start_time}-{t.end_time}</span>
                      <span style="color:#d8d8de;flex:1;min-width:0;overflow-wrap:anywhere;">{t.task}</span>
                      <span style="color:#6e6e78;white-space:nowrap;">{t.hours}h</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {a.report_work ? (
              <div style="margin-top:10px;padding-top:10px;border-top:1px solid #1a1a1f;">
                <p style="font-size:10px;color:#6e6e78;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 4px;">Daily diary / progress</p>
                <p style="font-size:12px;color:#d8d8de;margin:0;white-space:pre-wrap;overflow-wrap:anywhere;">{a.report_work}</p>
                {a.report_progress && <p style="font-size:11.5px;color:#a0a0ab;margin:5px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;"><span style="color:#6e6e78;">Progress:</span> {a.report_progress}</p>}
                {a.report_blockers && <p style="font-size:11.5px;color:#fca5a5;margin:5px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;"><span style="color:#6e6e78;">Blockers:</span> {a.report_blockers}</p>}
              </div>
            ) : (
              <p style="font-size:10.5px;color:#fbbf24;margin:8px 0 0;">No daily report submitted for this day.</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- MONTHLY TAB -->
  {tab === 'monthly' && (
    <div style="padding:12px 16px;">
      {/* The onchange auto-submit was the ONLY way to apply this choice: no button, so with
          scripting off — or before the handler is live on a slow phone — picking a person did
          nothing at all and the tab could not be used. The convenience stays, the button is the
          thing that makes it work. */}
      <form method="GET" style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="hidden" name="tab" value="monthly" />
        <input type="hidden" name="date" value={dateFilter} />
        <label for="monthlyEmp" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">Employee</label>
        <select id="monthlyEmp" name="emp" onchange="this.form.submit()" style="flex:1 1 180px;min-width:0;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
          <option value="">Select Employee</option>
          {employeeOptions.map(e => (
            <option value={e.id} selected={empFilter === e.id}>{e.full_name} ({e.employee_code})</option>
          ))}
        </select>
        <button type="submit" style="flex:0 0 auto;background:#15151a;border:1px solid #26262e;color:#d8d8de;font-size:12.5px;font-weight:600;padding:0 16px;border-radius:8px;cursor:pointer;min-height:44px;">Show</button>
      </form>

      {monthlySummary && _monthlyRows.length > 0 && (
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;">
            {[
              { label: 'Present Days', value: ms.present_days, color: '#6ee7b7' },
              { label: 'Absent Days', value: ms.absent_days, color: '#fca5a5' },
              { label: 'WFH Days', value: ms.wfh_days, color: '#a5b4fc' },
              { label: 'Half Days', value: ms.half_days, color: '#fbbf24' },
              { label: 'Leave Days', value: ms.leave_days, color: '#d8b4fe' },
              { label: 'Avg Hours/Day', value: ms.avg_hours || '-', color: '#fff' },
            ].map(stat => (
              <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:12px;display:flex;align-items:center;gap:12px;">
                <p style={`font-size:22px;font-weight:700;color:${stat.color};margin:0;`}>{stat.value || 0}</p>
                <p style="font-size:11px;color:#6e6e78;margin:0;">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      )}
      {!empFilter && (
        <div style="text-align:center;padding:48px;color:#6e6e78;">
          <p style="font-size:13px;">Select an employee to view monthly summary</p>
        </div>
      )}
    </div>
  )}

  <!-- BULK MARK TAB -->
  {tab === 'bulk' && (
    <div style="padding:12px 16px;">
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;">
        <p style="font-size:14px;font-weight:600;color:#fff;margin:0 0 4px;">Bulk Mark Attendance</p>
        <p style="font-size:12.5px;color:#8a8a94;margin:0 0 16px;line-height:1.6;">
          Writes one attendance row for every active employee on the chosen date. It will not overwrite
          a day somebody already has a record for. Marking the company absent prices a loss-of-pay day
          against each of their salaries in that month's payroll run.
        </p>
        {/* THE WIDEST WRITE ON THIS SCREEN AND IT HAD NO CONFIRMATION AT ALL — one tap wrote a row
            for every active employee, and "absent" sits directly under "present" in the same list.
            The prompt reads back the status and date actually chosen rather than asking whether you
            are sure about something it will not name. */}
        <form method="POST" style="display:flex;flex-direction:column;gap:12px;"
          onsubmit="return confirm('Mark EVERY active employee as ' + this.status.value.replace('_', ' ') + ' on ' + this.date.value + '? Anyone who already has a record for that day keeps it. A day recorded as absent is priced as a loss-of-pay day against that person’s salary in the payroll run for that month.')">
          <input type="hidden" name="action" value="bulk_mark" />
          <label style="display:block;">
            <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Date</span>
            <input type="date" name="date" value={dateFilter} required style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
          </label>
          <label style="display:block;">
            <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Status</span>
            <select name="status" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
              <option value="present">Present</option>
              <option value="absent">Absent</option>
              <option value="wfh">Work From Home</option>
              <option value="holiday">Holiday</option>
              <option value="on_leave">On Leave</option>
            </select>
          </label>
          <label style="display:block;">
            <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Work Mode</span>
            <select name="workMode" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
              <option value="remote">Remote</option>
              <option value="office">Office</option>
              <option value="hybrid">Hybrid</option>
            </select>
          </label>
          <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;min-height:44px;">Mark All Active Employees</button>
        </form>
      </div>
    </div>
  )}
</div>

{/* MARK / EDIT SHEET — rendered by the server when ?sheet= is set. The inline editAttendance()
    script and the "+ Mark" click listener that used to live here are gone: they were the only way
    to open this form, and until they parsed the two controls that reach it were dead. */}
{sheetOpen && (
<div id="markModal" role="dialog" aria-modal="true" aria-labelledby="markModalTitle" style="display:flex;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:100;align-items:flex-end;justify-content:center;">
  <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px 16px 0 0;width:100%;max-width:600px;max-height:90vh;overflow-y:auto;padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:10px;">
      <h2 id="markModalTitle" style="font-size:15px;font-weight:700;color:#fff;margin:0;">
        {isEditSheet ? 'Edit attendance for ' + sheetRow.full_name : 'Mark Attendance'}
      </h2>
      <a href={sheetBack} aria-label="Close without saving" style="background:#1a1a1f;border:none;color:#d8d8de;min-width:44px;min-height:44px;border-radius:8px;font-size:20px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;">&times;</a>
    </div>
    {sheetMode === 'edit' && !isEditSheet && (
      <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.3);border-radius:8px;padding:10px 12px;margin-bottom:12px;">
        <p style="font-size:12px;color:#fde68a;margin:0;line-height:1.55;">
          That entry is no longer on {dateFilter} — somebody may have deleted it since this page was
          drawn. The form below is blank rather than showing you stale values.
        </p>
      </div>
    )}
    <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="hidden" name="action" value="mark" />
      {/* Every label WRAPS its control. They were loose <label> elements with no `for`, so a screen
          reader announced seven unlabelled fields and tapping a word focused nothing. */}
      <label style="display:block;">
        <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Employee</span>
        <select name="employeeId" required style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
          {employeeOptions.map(e => (
            <option value={e.id} selected={isEditSheet && String(e.id) === String(sheetRow.employee_id)}>{e.full_name} ({e.employee_code})</option>
          ))}
        </select>
      </label>
      {employeeOptions.length >= EMPLOYEE_PICKER_LIMIT && (
        <p style="font-size:11.5px;color:#fbbf24;margin:-4px 0 0;line-height:1.5;">
          This picker lists the first {EMPLOYEE_PICKER_LIMIT} active employees by name. If somebody is
          missing they are past that cut, not inactive.
        </p>
      )}
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
        <label style="grid-column:1/-1;display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Date</span>
          <input type="date" name="date" value={isEditSheet ? dateValue(sheetRow.date) : dateFilter} required style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Status</span>
          <select name="status" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
            {[['present','Present'],['absent','Absent'],['wfh','WFH'],['half_day','Half Day'],['on_leave','On Leave'],['holiday','Holiday']].map(([v, label]) => (
              <option value={v} selected={isEditSheet && sheetRow.status === v}>{label}</option>
            ))}
          </select>
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Work Mode</span>
          <select name="workMode" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;">
            {[['remote','Remote'],['office','Office'],['hybrid','Hybrid']].map(([v, label]) => (
              <option value={v} selected={isEditSheet && (sheetRow.work_mode || 'remote') === v}>{label}</option>
            ))}
          </select>
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Clock In</span>
          <input type="time" name="clockIn" value={isEditSheet ? timeInputValue(sheetRow.clock_in) : ''} style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Clock Out</span>
          <input type="time" name="clockOut" value={isEditSheet ? timeInputValue(sheetRow.clock_out) : ''} style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
        </label>
        <label style="grid-column:1/-1;display:block;">
          <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9a9aa4;margin-bottom:5px;">Notes</span>
          <input type="text" name="notes" value={isEditSheet ? (sheetRow.notes || '') : ''} placeholder="Optional note" style="width:100%;background:#15151a;border:1px solid #26262e;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;min-height:44px;" />
        </label>
      </div>
      <p style="font-size:11.5px;color:#8a8a94;margin:0;line-height:1.55;">
        A day saved as absent is counted by the payroll run as a loss-of-pay day and priced against
        that month's gross.
      </p>
      <button type="submit" style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;min-height:44px;">Save Attendance</button>
      <a href={sheetBack} style="text-align:center;color:#8a8a94;font-size:12.5px;text-decoration:underline;min-height:44px;display:flex;align-items:center;justify-content:center;">Cancel</a>
    </form>
  </div>
</div>
)}

{/* PROGRESSIVE ENHANCEMENT ONLY — focus and Escape. Deliberately NOT inside a JSX conditional: a
    <script> in one breaks .astro parsing. It guards on the element instead. */}
<script is:inline>
(function () {
  var sheet = document.getElementById('markModal');
  if (!sheet) return;
  var back = sheet.querySelector('a[aria-label]');
  var first = sheet.querySelector('select, input');
  if (first && first.focus) { try { first.focus(); } catch (e) {} }
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && back) { window.location.href = back.getAttribute('href'); }
  });
})();
</script>

</AdminLayout>
