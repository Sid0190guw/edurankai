---
// /admin/hr/reconciliation — WHO IS LOST BETWEEN TWO SCREENS.
//
// WHY THIS PAGE EXISTS. A person signed their offer and was not an employee for eleven days. Nothing
// looked broken: offer_letters said 'signed', applications said 'hired', and both were correct. The
// third table simply had no row, and no screen in the product joined the three — every screen showed
// its own table and every one of them looked right. The only trace was one line in the last-50 error
// tail on /admin/hardening, which any busy day scrolls off.
//
// This screen asks the joins. Ten of them, each a state a real person can sit in while every
// individual surface reports success — and each one carries the action that ends it, on this page,
// rather than sending somebody to find the right console.
//
// A CHECK THAT COULD NOT RUN SAYS SO. "None" because nobody is lost and "None" because a table does
// not exist are opposite facts. src/lib/hire-reconcile.ts returns { rows, error } for every check and
// this page prints the error under the heading rather than rendering a reassuring empty state.
//
// EVERY ACTION IS IDEMPOTENT. "Finish this hire" re-runs the whole handoff: the employee lookup finds
// the existing row, the enrichment only fills blanks, and startJourney() tops a checklist up without
// resetting anything anybody has completed. Pressing it twice is safe, which is the point — an
// operator must never have to reason about whether a repair has already run.
//
// THE GATE. `employee.manage` through can() — the people-desk capability, the same one that gates
// /admin/hr/onboarding/journey. Authorization comes only from src/lib/auth/permissions.ts; nothing
// here reads users.role.
//
// NO CLIENT JAVASCRIPT. Every action is a plain form POST.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { reconciliationReport, closeLeaverEdge } from '@/lib/hire-reconcile';
import {
  retryHire, setOnboardingStatus, expireOffer, ONBOARDING_STATUSES, onboardingStatusLabel,
} from '@/lib/hire-completion';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'employee.manage')) return Astro.redirect('/admin?denied=reconciliation');

// EVERY const BEFORE the POST handler that reads it. `const` is not hoisted, and a declaration below
// the handler throws on its first line while the page reports success.
const PAGE = '/admin/hr/reconciliation';

const fmtDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? String(d) : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

const ageWords = (days: number | null) => {
  if (days === null || days === undefined) return '';
  if (days <= 0) return 'today';
  if (days === 1) return '1 day';
  return days + ' days';
};

if (Astro.request.method === 'POST') {
  let flash = '';
  try {
    const fd = await Astro.request.formData();
    const action = String(fd.get('action') || '');

    if (action === 'retry_hire') {
      const r = await retryHire(String(fd.get('offer_id') || ''), user.id);
      if (!r.ok) {
        flash = 'STILL NO EMPLOYEE RECORD: ' + (r.error || 'unknown reason')
          + ' — the reason is recorded against this hire and it stays on this list.';
      } else {
        const unresolved = r.steps.filter((s) => !s.ok && !s.skipped);
        flash = unresolved.length === 0
          ? 'Hire completed' + (r.employeeCode ? ' as ' + r.employeeCode : '') + '.'
            + (r.gaps.length ? ' Still missing: ' + r.gaps.length + ' thing(s) only a human can fill in.' : '')
          : 'Employee record is in place' + (r.employeeCode ? ' (' + r.employeeCode + ')' : '')
            + ', but ' + unresolved.length + ' step(s) did not complete: '
            + unresolved.map((s) => s.label).join('; ') + '.';
      }
    } else if (action === 'start_journey') {
      const { startJourney } = await import('@/lib/onboarding-journey');
      const r = await startJourney(String(fd.get('employee_id') || ''), user.id);
      if (!r.ok) flash = r.error || 'The checklist was not started.';
      else if (r.unowned && r.unowned > 0) {
        flash = 'Checklist started. ' + r.unowned + ' step(s) cannot resolve an owner yet and each says why.';
      } else flash = 'Checklist started, and every step has an owner.';
    } else if (action === 'set_onboarding') {
      const r = await setOnboardingStatus(
        String(fd.get('employee_id') || ''), String(fd.get('status') || ''), user.id,
      );
      flash = r.ok
        ? 'Onboarding is now ' + onboardingStatusLabel(String(fd.get('status') || '')).toLowerCase()
          + '. They have been told if it is complete.'
        : (r.error || 'The status was not changed.');
    } else if (action === 'expire_offer') {
      const r = await expireOffer(String(fd.get('offer_id') || ''), user.id);
      flash = r.ok
        ? 'That offer now reads expired instead of awaiting a signature.'
        : (r.error || 'The offer was not changed.');
    } else if (action === 'close_edge') {
      const r = await closeLeaverEdge(String(fd.get('relationship_id') || ''), user.id);
      flash = r.ok
        ? 'The relationship is closed as of their last working day. Nothing was deleted, so their past approvals still read correctly.'
        : (r.error || 'The relationship was not closed.');
    } else {
      flash = 'That is not something this page does.';
    }
  } catch (e: any) {
    // NEVER SWALLOWED. The real Postgres reason is on e.cause; e.message is only the failed SQL.
    console.error('[admin/hr/reconciliation] POST', e?.cause?.message || e?.message);
    flash = 'Nothing was saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
  }
  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash.slice(0, 400)));
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const report = await reconciliationReport();
---
<AdminLayout title="Joining and leaving: reconciliation" activeNav="hr">
<div class="wrap">
  <p class="eyebrow">HR &middot; Joining and leaving</p>
  <h1>Reconciliation</h1>
  <p class="lede">
    The people who are lost between two screens. Every check here is a join across tables that each
    look correct on their own &mdash; a signed offer with no employee record, somebody on the register
    who cannot sign in, a leaver whose access never closed. Each list carries the action that ends it,
    and every action is safe to press twice.
  </p>

  {msg && <div class="flash">{msg}</div>}

  {report.failedChecks > 0 && (
    <div class="flash bad">
      {report.failedChecks} of the checks below could not be answered. Each says so under its own
      heading. An empty list from a check that did not run is not the same as nobody being lost, and
      this page will not show you one as the other.
    </div>
  )}

  <div class="tiles">
    <div class="tile"><span class="tv">{report.signedNoEmployee.rows.length}</span><span class="tl">Signed, no employee record</span></div>
    <div class="tile"><span class="tv">{report.incompleteHandoffs.rows.length}</span><span class="tl">Handoffs unfinished</span></div>
    <div class="tile"><span class="tv">{report.noAccount.rows.length}</span><span class="tl">Cannot sign in</span></div>
    <div class="tile"><span class="tv">{report.openLeavers.rows.length + report.openEdges.rows.length}</span><span class="tl">Left, still open</span></div>
  </div>

  {report.urgentCount === 0 && report.failedChecks === 0 && (
    <div class="flash ok">
      Nothing is stuck on any of the ten checks. That is a real answer, not an empty screen: every
      check ran and every one came back empty.
    </div>
  )}

  <!-- ------------------------------------------------------------------ 1 -->
  <h2>Signed offers with no employee record</h2>
  <p class="note">
    The check that would have found the eleven-day hire on its first day. A person appears here only
    when no employee record can be found by their application, their account, their personal email or
    their work email. &ldquo;Finish this hire&rdquo; runs the whole handoff again.
  </p>
  {report.signedNoEmployee.error
    ? <div class="flash bad">{report.signedNoEmployee.error}</div>
    : report.signedNoEmployee.rows.length === 0
      ? <div class="empty">Every signed offer has an employee record behind it.</div>
      : (
        <div class="stack">
          {report.signedNoEmployee.rows.map((r) => (
            <div class="card bad">
              <div class="cardhead">
                <div class="grow">
                  <p class="name">{r.candidateName || r.candidateEmail || 'Unnamed candidate'}</p>
                  <p class="sub">
                    {r.roleTitle || 'role not recorded'}
                    {r.signedAt ? ' · signed ' + fmtDate(r.signedAt) : ''}
                    {r.daysSince !== null ? ' · ' + ageWords(r.daysSince) + ' ago' : ''}
                  </p>
                </div>
                <span class="chip warn">No HR record</span>
              </div>
              {r.lastError && <p class="why">Last attempt failed with: {r.lastError}</p>}
              {!r.lastError && (
                <p class="why note">
                  No handoff was ever recorded for this offer, which means it was signed before the
                  handoff was tracked, or the signing request ended before it could be written.
                </p>
              )}
              <div class="btnrow">
                <form method="POST">
                  <input type="hidden" name="action" value="retry_hire" />
                  <input type="hidden" name="offer_id" value={r.offerId} />
                  <button type="submit" class="btn small">Finish this hire</button>
                </form>
                {r.applicationId && (
                  <a class="btn ghost small" href={'/admin/applications/' + r.applicationId}>Open the application</a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

  <!-- ------------------------------------------------------------------ 2 -->
  <h2>Hires whose handoff did not complete</h2>
  <p class="note">
    The employee record may exist while a later step did not run: the checklist was never started, the
    tracker never moved, or the person was never told. Each step is named with the reason it gives.
  </p>
  {report.incompleteHandoffs.error
    ? <div class="flash bad">{report.incompleteHandoffs.error}</div>
    : report.incompleteHandoffs.rows.length === 0
      ? <div class="empty">Every recorded handoff finished every step it had to.</div>
      : (
        <div class="stack">
          {report.incompleteHandoffs.rows.map((h) => (
            <div class="card">
              <div class="cardhead">
                <div class="grow">
                  <p class="name">{h.candidateName || 'Unnamed hire'}</p>
                  <p class="sub">
                    {h.roleTitle || 'role not recorded'}
                    {h.updatedAt ? ' · last tried ' + fmtDate(h.updatedAt) : ''}
                    {h.attempts ? ' · ' + h.attempts + ' attempt' + (h.attempts === 1 ? '' : 's') : ''}
                  </p>
                </div>
                {h.employeeId
                  ? <span class="chip">On the register</span>
                  : <span class="chip warn">No HR record</span>}
              </div>
              <ul class="steps">
                {h.steps.map((s) => (
                  <li class={s.ok ? (s.skipped ? 'skip' : 'ok') : 'fail'}>
                    <span class="sname">{s.label}</span>
                    <span class="sdetail">{s.detail}</span>
                  </li>
                ))}
              </ul>
              {h.gaps.length > 0 && (
                <ul class="gaps">
                  {h.gaps.map((g) => <li>{g}</li>)}
                </ul>
              )}
              <div class="btnrow">
                {h.offerId && (
                  <form method="POST">
                    <input type="hidden" name="action" value="retry_hire" />
                    <input type="hidden" name="offer_id" value={h.offerId} />
                    <button type="submit" class="btn small">Try the rest again</button>
                  </form>
                )}
                {h.employeeId && (
                  <form method="POST">
                    <input type="hidden" name="action" value="start_journey" />
                    <input type="hidden" name="employee_id" value={h.employeeId} />
                    <button type="submit" class="btn ghost small">Start their checklist</button>
                  </form>
                )}
                {h.employeeId && (
                  <a class="btn ghost small" href={'/admin/hr/employees/' + h.employeeId}>Open their record</a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

  <!-- ------------------------------------------------------------------ 3 -->
  <h2>On the register, and cannot sign in</h2>
  <p class="note">
    An employee record with no account behind it. They exist in HR, in payroll and on the org chart,
    and there is nothing they can log into.
  </p>
  {report.noAccount.error
    ? <div class="flash bad">{report.noAccount.error}</div>
    : report.noAccount.rows.length === 0
      ? <div class="empty">Every active employee has an account.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Person</th><th>Code</th><th>Email</th><th>Why</th><th></th></tr></thead>
            <tbody>
              {report.noAccount.rows.map((e) => (
                <tr>
                  <td class="wrapcell">{e.fullName}</td>
                  <td>{e.employeeCode || ''}</td>
                  <td class="wrapcell">{e.email || ''}</td>
                  <td class="wrapcell">{e.reason}</td>
                  <td><a class="link" href={'/admin/hr/employees/' + e.employeeId}>Open</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 4 -->
  <h2>No department, no manager, or no pay recorded</h2>
  <p class="note">
    Not a tidiness problem. With no department and no reporting manager, nobody in the company can
    give this person their first task and no relationship-owned onboarding step can find an owner.
    With no base salary, a payroll run computes their pay as zero and balances perfectly.
  </p>
  {report.placementGaps.error
    ? <div class="flash bad">{report.placementGaps.error}</div>
    : report.placementGaps.rows.length === 0
      ? <div class="empty">Every active employee has a department, a manager and a recorded salary.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Person</th><th>Joined</th><th>Missing</th><th>Onboarding</th><th></th></tr></thead>
            <tbody>
              {report.placementGaps.rows.map((e) => (
                <tr>
                  <td class="wrapcell">{e.fullName}<span class="why note">{e.designation || ''}</span></td>
                  <td>{fmtDate(e.joiningDate)}</td>
                  <td class="wrapcell"><span class="why">{e.missing.join(', ')}</span></td>
                  <td>{onboardingStatusLabel(e.onboardingStatus)}</td>
                  <td><a class="link" href={'/admin/hr/employees/' + e.employeeId}>Fix</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 5 -->
  <h2>Onboarding started and never finished</h2>
  <p class="note">
    Onboarding had no end. The portal wrote &ldquo;submitted&rdquo; and nothing in the product ever
    wrote anything after it, so every person the company has ever hired counted as still onboarding,
    forever, in two analytics surfaces. The control below is that missing exit.
  </p>
  {report.onboardingOpen.error
    ? <div class="flash bad">{report.onboardingOpen.error}</div>
    : report.onboardingOpen.rows.length === 0
      ? <div class="empty">Nobody is mid-onboarding.</div>
      : (
        <div class="stack">
          {report.onboardingOpen.rows.map((e) => (
            <div class="card">
              <div class="cardhead">
                <div class="grow">
                  <p class="name">{e.fullName}{e.employeeCode ? ' · ' + e.employeeCode : ''}</p>
                  <p class="sub">
                    {e.joiningDate ? 'joined ' + fmtDate(e.joiningDate) : 'no joining date'}
                    {e.daysSinceJoining !== null ? ' · ' + ageWords(e.daysSinceJoining) + ' ago' : ''}
                    {' · '}{onboardingStatusLabel(e.onboardingStatus)}
                  </p>
                </div>
                {!e.journeyId && <span class="chip warn">No checklist</span>}
                {e.overdueItems > 0 && <span class="chip warn">{e.overdueItems} overdue</span>}
                {e.unownedItems > 0 && <span class="chip warn">{e.unownedItems} unowned</span>}
              </div>
              {e.journeyId && (
                <p class="why note">
                  {e.pendingItems} step{e.pendingItems === 1 ? '' : 's'} still open on their checklist.
                </p>
              )}
              {!e.journeyId && (
                <p class="why">
                  No onboarding checklist exists for them, so nobody owns their equipment, their
                  accounts, their introductions or their policy acknowledgement.
                </p>
              )}
              <div class="btnrow">
                {!e.journeyId && (
                  <form method="POST">
                    <input type="hidden" name="action" value="start_journey" />
                    <input type="hidden" name="employee_id" value={e.employeeId} />
                    <button type="submit" class="btn small">Start their checklist</button>
                  </form>
                )}
                <form method="POST" class="inline">
                  <input type="hidden" name="action" value="set_onboarding" />
                  <input type="hidden" name="employee_id" value={e.employeeId} />
                  <select name="status" aria-label={'Onboarding state for ' + e.fullName}>
                    {ONBOARDING_STATUSES.map((s) => (
                      <option value={s.key} selected={s.key === e.onboardingStatus}>{s.label}</option>
                    ))}
                  </select>
                  <button type="submit" class="btn ghost small">Set</button>
                </form>
                <a class="btn ghost small" href="/admin/hr/onboarding/journey">Checklists</a>
              </div>
            </div>
          ))}
        </div>
      )}

  <!-- ------------------------------------------------------------------ 6 -->
  <h2>Joining documents rejected and waiting</h2>
  <p class="note">
    A rejected credential holds the whole document step open, and the hire's own progress reads
    complete only when every document is verified. Reviews now notify the person; these are the ones
    decided before that, still waiting on somebody who may never have been told.
  </p>
  {report.rejectedDocs.error
    ? <div class="flash bad">{report.rejectedDocs.error}</div>
    : report.rejectedDocs.rows.length === 0
      ? <div class="empty">No joining document is sitting rejected.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Person</th><th>Document</th><th>Note left</th><th>Reviewed</th><th></th></tr></thead>
            <tbody>
              {report.rejectedDocs.rows.map((d) => (
                <tr>
                  <td class="wrapcell">{d.personName}</td>
                  <td class="wrapcell">{d.title || d.docType}</td>
                  <td class="wrapcell">{d.reviewNote || 'no reason was recorded'}</td>
                  <td>{fmtDate(d.reviewedAt)}</td>
                  <td><a class="link" href="/admin/hr/onboarding">Review</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 7 -->
  <h2>Offers that lapsed and still read &ldquo;awaiting signature&rdquo;</h2>
  <p class="note">
    Expiry was worked out fresh on every page load and never written down, so a lapsed offer stayed
    indistinguishable from a live one in every count and every export. Marking one expired refuses
    unless it really has lapsed &mdash; a live offer cannot be closed by pressing this.
  </p>
  {report.lapsed.error
    ? <div class="flash bad">{report.lapsed.error}</div>
    : report.lapsed.rows.length === 0
      ? <div class="empty">No lapsed offer is still counted as awaiting a signature.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Candidate</th><th>Role</th><th>Expired</th><th>Overdue</th><th></th></tr></thead>
            <tbody>
              {report.lapsed.rows.map((o) => (
                <tr>
                  <td class="wrapcell">{o.candidateName}</td>
                  <td class="wrapcell">{o.roleTitle}</td>
                  <td>{fmtDate(o.expiryDate)}</td>
                  <td>{ageWords(o.daysOverdue)}</td>
                  <td>
                    <form method="POST">
                      <input type="hidden" name="action" value="expire_offer" />
                      <input type="hidden" name="offer_id" value={o.offerId} />
                      <button type="submit" class="btn ghost small">Mark expired</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 8 -->
  <h2>Left, and the record is still active</h2>
  <p class="note">
    Their last working day has passed and their employee record is still open. That is an access fact,
    not a bookkeeping one: an active record is what the workspace, the task board and the approval
    queues read. Closing an exit properly is done on the separation console, which checks the
    clearances, the exit interview and the settlement first.
  </p>
  {report.openLeavers.error
    ? <div class="flash bad">{report.openLeavers.error}</div>
    : report.openLeavers.rows.length === 0
      ? <div class="empty">Nobody whose last day has passed still has an open record.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Person</th><th>Last day</th><th>Open for</th><th>Separation</th><th></th></tr></thead>
            <tbody>
              {report.openLeavers.rows.map((l) => (
                <tr>
                  <td class="wrapcell">{l.fullName}{l.employeeCode ? ' · ' + l.employeeCode : ''}</td>
                  <td>{fmtDate(l.lastWorkingDay)}</td>
                  <td><span class="why">{ageWords(l.daysSince)}</span></td>
                  <td>{l.separationId ? (l.separationStatus || 'open') : 'none recorded'}</td>
                  <td><a class="link" href="/admin/hr/separation">Close the exit</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 9 -->
  <h2>Left, and still on the organization graph</h2>
  <p class="note">
    An open edge belonging to somebody whose record is closed. The graph keeps answering &ldquo;who
    manages this team&rdquo; with a name that has gone, so their reports&rsquo; leave routes to
    nobody. Closing an edge is not deleting it: it takes an end date, and every past approval they
    made still reads correctly.
  </p>
  {report.openEdges.error
    ? <div class="flash bad">{report.openEdges.error}</div>
    : report.openEdges.rows.length === 0
      ? <div class="empty">No open relationship belongs to somebody who has left.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Relationship</th><th>Between</th><th>Who has left</th><th>Open since</th><th></th></tr></thead>
            <tbody>
              {report.openEdges.rows.map((e) => (
                <tr>
                  <td>{e.type.replace(/_/g, ' ')}</td>
                  <td class="wrapcell">{(e.subjectName || 'unknown') + ' / ' + (e.objectName || 'unknown')}</td>
                  <td class="wrapcell">{e.leaverSide === 'both' ? 'both of them' : (e.leaverName || 'unknown')}</td>
                  <td>{fmtDate(e.effectiveFrom)}</td>
                  <td>
                    <form method="POST">
                      <input type="hidden" name="action" value="close_edge" />
                      <input type="hidden" name="relationship_id" value={e.relationshipId} />
                      <button type="submit" class="btn ghost small">Close it</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

  <!-- ------------------------------------------------------------------ 10 -->
  <h2>Exits with reports still attached</h2>
  <p class="note">
    People still report to somebody who is leaving. The separation console refuses to close in this
    state and offers the leaver's own manager as the default place those reports land &mdash; but only
    once somebody opens it. This is the list that says somebody should.
  </p>
  {report.exitsWithReports.error
    ? <div class="flash bad">{report.exitsWithReports.error}</div>
    : report.exitsWithReports.rows.length === 0
      ? <div class="empty">No open exit has people still reporting to the person leaving.</div>
      : (
        <div class="scroller">
          <table>
            <thead><tr><th>Leaver</th><th>Last day</th><th>Reports</th><th>Exit state</th><th></th></tr></thead>
            <tbody>
              {report.exitsWithReports.rows.map((x) => (
                <tr>
                  <td class="wrapcell">{x.fullName}</td>
                  <td>{fmtDate(x.lastWorkingDay)}</td>
                  <td><span class="why">{x.reportCount}</span></td>
                  <td>{x.separationStatus}</td>
                  <td><a class="link" href="/admin/hr/separation">Reassign and close</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
</div>

<style>
  .wrap { padding: 14px 16px 90px; max-width: 1100px; margin: 0 auto; }
  .eyebrow { font-size: 10.5px; color: #FF7040; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; font-weight: 700; }
  h1 { font-size: 23px; color: #fff; margin: 6px 0 4px; font-weight: 700; }
  h2 { font-size: 14px; color: #fff; margin: 30px 0 6px; font-weight: 700; }
  .lede { font-size: 13px; color: #9aa6b6; margin: 0 0 16px; line-height: 1.6; max-width: 70ch; }
