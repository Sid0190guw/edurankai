---
// /admin/hr/intelligence — THE PEOPLE LIST, AND THE PLACE A REASON IS TYPED.
//
// WHY THIS FILE EXISTS. It did not, and the sidebar linked here anyway: "HR intelligence" in the
// admin navigation resolved to a 404 on the live site, because the only page under this directory
// was [employeeId].astro. Two other paths landed on the same missing page — the detail page's own
// "Back to the people list" link, and its POST refusal, which redirects here with ?notice=. And its
// no-purpose refusal says, in those words, "go back to the people list and say why you are opening
// it", naming a screen that had never been built.
//
// WHAT IT DOES. Two things, and deliberately not a third.
//
//   1. It collects the REASON, before the list is any use. The record page refuses to open without
//      one, so an Open link that carries no purpose is a link to a refusal. Until a purpose is
//      typed, this page says so on every row rather than letting the operator find out one click
//      later.
//   2. It lists the people the viewer may open, so somebody can be chosen by name.
//
// WHAT IT IS NOT. There is no reading, no score, no ranking and no sort by any computed figure —
// the same refusal the fusion desk makes next door, for the same reason: a column of numbers beside
// a column of names is a ranking of humans however the column is labelled. Every figure in this
// system lives on the individual's own page, beside the sentence that explains it.
//
// THE DOOR IS A CAPABILITY, NOT A RELATIONSHIP. resolveHrIntelAccess() opens this record for
// `employee.manage` or `people.view_360` and for nothing else — not for a reporting line, and not
// for the subject themselves. So the population a holder may open is EVERY active employee, and the
// list is not scoped by the organisation graph. Scoping it that way would show a team lead their
// reports and send every click into a refusal. Somebody who holds neither key may open nobody, and
// this page says that in place instead of listing names they cannot use.
//
// CLIENT JAVASCRIPT: NONE. The purpose form is a GET form; it comes back in the query string, and
// the server builds each row's link from it.
//
// Every `const` is declared above anything that reads it. `const` is not hoisted, and this project
// has shipped a page that threw on its handler's first line while reporting success.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { can } from '@/lib/auth/permissions';
import { hasPermission } from '@/lib/auth/registry';
import { HR_DESK, PERSON_360, FOUNDATIONAL } from '@/lib/hr-intelligence/access';

const PATH = '/admin/hr/intelligence';
const LIST_LIMIT = 200;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

const params = Astro.url.searchParams;
const q = String(params.get('q') || '').trim().slice(0, 80);
const purpose = String(params.get('purpose') || '').trim().slice(0, 300);
const notice = String(params.get('notice') || '').slice(0, 400);
const wantsDeep = params.get('depth') === 'foundational';

// THE SAME TWO KEYS resolveHrIntelAccess() ASKS FOR, asked here so the page can refuse in place
// rather than list people every one of whom would refuse on arrival. The registry is consulted for
// the foundational key only, exactly as the record page does it: that tier is granted to no built-in
// role, so it has nowhere else to come from.
const hrDesk = can(user as any, HR_DESK as any);
const person360 = can(user as any, PERSON_360 as any);
const mayOpenSomebody = hrDesk || person360;
const holdsDeep = await hasPermission(String(user.id), FOUNDATIONAL, { locals: Astro.locals });

// -------------------------------------------------------------------------------------------------
// THE READ
//
// Only when the viewer may open somebody. A name list is the smallest thing this page can be and it
// is still a list of employees; there is no reason to assemble one for an account that cannot use a
// single row of it.
// -------------------------------------------------------------------------------------------------
let people: { id: string; fullName: string; designation: string | null }[] = [];
let peopleUnreadable: string | null = null;

if (mayOpenSomebody) {
  try {
    // ILIKE on full_name only. The parameter carries the wildcards, so the pattern is bound and
    // never concatenated, and the column is not cast — a cast on the column is what defeats an
    // index on it.
    const search = q ? sql`AND e.full_name ILIKE ${'%' + q + '%'}` : sql``;
    const rows = await db.execute(sql`
      SELECT e.id, e.full_name, e.designation
        FROM hr_employees e
       WHERE e.is_active = TRUE ${search}
       ORDER BY e.full_name ASC
       LIMIT ${LIST_LIMIT}`);
    // postgres-js hands back a plain array. Never rows.rows[0].
    const list = Array.isArray(rows) ? rows : ((rows as any)?.rows || []);
    people = list.map((r: any) => ({
      id: String(r.id),
      fullName: r.full_name ? String(r.full_name) : 'Unnamed record',
      designation: r.designation ? String(r.designation) : null,
    }));
  } catch (e: any) {
    // NAMED, NEVER RENDERED AS AN EMPTY LIST. The real Postgres reason is on e.cause; e.message is
    // only the failed SQL. An empty list and a failed query look identical otherwise, and an empty
    // state here would read as "this organisation employs nobody".
    peopleUnreadable = e?.cause?.message || e?.message || 'no reason was given';
  }
}

// -------------------------------------------------------------------------------------------------
// Hoisted out of the template. `<` and `<=` inside a JSX expression is a known parse hazard in
// .astro, and a template should not be doing arithmetic or building URLs.
// -------------------------------------------------------------------------------------------------
const hasPurpose = purpose.length > 0;
const listed = people.length;
const listCapped = listed >= LIST_LIMIT;
const searching = q.length > 0;
const showList = mayOpenSomebody && !peopleUnreadable;
const hasRows = showList && listed !== 0;
const emptyForSearch = showList && listed === 0 && searching;
const emptyOutright = showList && listed === 0 && !searching;
const deepOffered = holdsDeep && mayOpenSomebody;

const openHref = (id: string): string => {
  let href = PATH + '/' + id + '?purpose=' + encodeURIComponent(purpose);
  if (wantsDeep && holdsDeep) href = href + '&depth=foundational';
  return href;
};

const capabilitySentence = hrDesk && person360
  ? 'You hold ' + HR_DESK + ' and ' + PERSON_360 + '.'
  : hrDesk
    ? 'You hold ' + HR_DESK + '.'
    : 'You hold ' + PERSON_360 + '.';
---

<AdminLayout title="HR intelligence" activeNav="hr">
  <div class="hri-wrap">
    <header class="hri-head">
      <p class="hri-eyebrow">People desk</p>
      <h1>HR intelligence</h1>
      <p class="hri-lede">
        One person's development record, read across appraisals, skills, assigned learning, feedback
        and the employment record, with every figure carrying where it came from and how sure it is.
        Nothing here decides anything. Choose somebody below, and say first why you are opening it.
      </p>
    </header>

    {notice ? <p class="hri-error" role="alert">{notice}</p> : null}

    {!mayOpenSomebody ? (
      <section class="hri-card hri-refusal">
        <h2>There is nobody here for you to open</h2>
        <p class="hri-muted">
          Opening one person's HR intelligence record needs <code>{HR_DESK}</code> or
          <code>{PERSON_360}</code>. You hold neither, so no list of people is shown: every row of it
          would refuse on arrival.
        </p>
        <p class="hri-muted">
          Two things this is not. A reporting line does not open this record — a manager reading
          their own team's delivery is a different document, on their workspace at
          <a href="/portal/manager"> /portal/manager</a>. And your own development record is not here
          either: yours is written for you, on your portal at
          <a href="/portal/employee/intelligence"> /portal/employee/intelligence</a>. Both of those
          are deliberate, and neither is a gap in what you were granted.
        </p>
      </section>
    ) : (
      <>
        <section class="hri-card">
          <h2>Why are you opening a record</h2>
          <p class="hri-muted hri-tight">
            The reason is written into the access row beside the read, before anything about the
            person is assembled, and the person whose record it is can be shown who opened it and
            what they said they were doing. That is why the record page refuses without one, and why
            the rows below stay closed until this is filled in.
          </p>

          <form method="get" class="hri-form">
            <label for="purpose">The reason for this read</label>
            <input
              id="purpose"
              name="purpose"
              maxlength="300"
              value={purpose}
              placeholder="For example: preparing this quarter's development conversation"
            />

            <label for="q">Narrow the list by name (optional)</label>
            <input id="q" name="q" maxlength="80" value={q} placeholder="Name" />

            {deepOffered ? (
              <p class="hri-check">
                <label>
                  <input type="checkbox" name="depth" value="foundational" checked={wantsDeep} />
                  Include foundational computation detail
                </label>
                <span class="hri-muted">
                  You hold <code>{FOUNDATIONAL}</code>. The deeper tier is a separate decision from
                  opening the record, it is recorded as one, and it needs the reason above — a read
                  at this depth with no stated purpose is refused rather than downgraded.
                </span>
              </p>
            ) : null}

            <button class="hri-btn" type="submit">Set the reason</button>
          </form>

          {hasPurpose ? (
            <p class="hri-set">
              Opening for: <b>{purpose}</b>{wantsDeep && holdsDeep ? ', with foundational detail' : ''}.
              This is carried onto whichever record you open and written down there.
            </p>
          ) : (
            <p class="hri-warnline">
              No reason is set, so nothing can be opened yet.
            </p>
          )}
        </section>

        <section class="hri-card">
          <h2>Who you can open</h2>
          <p class="hri-muted hri-tight">
            {capabilitySentence} That capability reads across the whole organisation, so this lists
            every active employee rather than a team. It is alphabetical and carries no reading:
            there is deliberately no way to sort people by a computed figure here.
          </p>

          {peopleUnreadable ? (
            <p class="hri-warnline" role="alert">
              The people list could not be read just now: {peopleUnreadable}. That is a failed query,
              not an organisation with nobody in it.
            </p>
          ) : null}

          {emptyOutright ? (
            <p class="hri-muted">
              No active employee is on record. The query succeeded and returned nothing.
            </p>
          ) : null}

          {emptyForSearch ? (
            <p class="hri-muted">
              No active employee's name matches "{q}". The query succeeded and returned nothing.
            </p>
          ) : null}

          {hasRows ? (
            <>
              <div class="hri-tablewrap">
                <table class="hri-table">
                  <thead>
                    <tr><th>Person</th><th>Role</th><th></th></tr>
                  </thead>
                  <tbody>
                    {people.map((p) => (
                      <tr>
                        <td><b>{p.fullName}</b></td>
                        <td class="hri-muted">{p.designation || 'No designation recorded'}</td>
                        <td class="hri-actioncell">
                          {hasPurpose
                            ? <a class="hri-btn hri-slim" href={openHref(p.id)}>Open</a>
                            : <span class="hri-muted">Set a reason above first</span>}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <p class="hri-muted">
                {listCapped
                  ? 'Showing the first ' + LIST_LIMIT + ' names alphabetically. There may be more; narrow the list by name to reach them.'
                  : listed + ' ' + (listed === 1 ? 'person' : 'people') + ' listed.'}
              </p>
            </>
          ) : null}
        </section>
      </>
    )}
  </div>
</AdminLayout>

<style>
  .hri-wrap { max-width: 980px; margin: 0 auto; padding: 24px 20px 100px; }
  .hri-head { margin-bottom: 22px; }
  .hri-eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 11px;
    color: var(--muted, #6b7280); margin: 0 0 6px;
  }
  .hri-head h1 { font-size: 28px; margin: 0 0 8px; line-height: 1.15; }
  .hri-lede { max-width: 64ch; color: var(--muted, #4b5563); margin: 0; line-height: 1.6; font-size: 14px; }

  .hri-card {
    border: 1px solid var(--border, #e5e7eb); border-radius: 12px;
    padding: 20px; margin-bottom: 16px; background: var(--surface, #fff);
  }
  .hri-card h2 { font-size: 16px; margin: 0 0 8px; }
  .hri-muted { color: var(--muted, #6b7280); font-size: 13px; line-height: 1.6; }
  .hri-tight { margin-top: 0; }
  .hri-refusal { border-style: dashed; }
  .hri-warnline { color: #b45309; font-size: 13px; margin: 10px 0 0; }
  .hri-set { font-size: 13px; color: var(--muted, #4b5563); margin: 12px 0 0; line-height: 1.6; }
  .hri-error {
    border: 1px solid #ef4444; background: rgba(239, 68, 68, 0.07);
    padding: 12px 14px; border-radius: 10px; margin-bottom: 16px; font-size: 14px;
  }

  .hri-form { margin-top: 14px; }
  .hri-form label {
    display: block; font-size: 12px; font-weight: 600;
    color: var(--muted, #4b5563); margin: 12px 0 4px;
  }
  .hri-form input[type="text"], .hri-form input:not([type]) {
    width: 100%; max-width: 46ch; padding: 9px 12px; font: inherit; font-size: 14px;
    border: 1px solid var(--border, #d1d5db); border-radius: 8px;
    background: var(--surface, #fff); color: inherit;
  }
  .hri-check { margin: 14px 0 0; }
  .hri-check label {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; margin: 0 0 4px;
  }
  .hri-check input { width: auto; }

  .hri-btn {
    display: inline-block; margin-top: 14px; padding: 9px 16px;
    border: 1px solid var(--border, #d1d5db); border-radius: 8px;
    background: var(--surface-2, #fafafa); color: inherit;
    font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none;
  }
  .hri-btn:hover { border-color: #9ca3af; }
  .hri-slim { margin-top: 0; padding: 5px 12px; font-weight: 500; }

  .hri-tablewrap { overflow-x: auto; margin-top: 14px; }
  .hri-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .hri-table th {
    text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted, #6b7280); font-weight: 600;
    padding: 0 12px 8px 0; border-bottom: 1px solid var(--border, #e5e7eb);
  }
  .hri-table td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--border, #f0f0f0); }
  .hri-actioncell { text-align: right; white-space: nowrap; }
</style>
