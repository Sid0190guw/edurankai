---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { departments, roles } from '@/lib/db/schema';
import { can } from '@/lib/auth/permissions';
import { departmentSchema } from '@/lib/validators';
import { logAudit } from '@/lib/audit';
import { eq, sql } from 'drizzle-orm';
// A FAILED READ IS NOT A MISSING DEPARTMENT. Both reads here were bare top-level awaits: an
// unreadable `departments` table took the page down with an unexplained 500, and a catch that
// returned nothing would have bounced to the list as though the department did not exist. The second
// is the worse of the two — it invites somebody to create a duplicate of a record that is still
// there.
import { safeRows } from '@/lib/page-safety';
import DayOne from '@/components/admin/DayOne.astro';
// WHO HEADS THIS DEPARTMENT — a per-ROW fact about the department, which is why it belongs on the
// department's own record rather than on a person's.
//
// THERE IS NO COLUMN FOR IT ANYWHERE. `departments` has no head field in either schema file and
// hr_employees has no is_head flag, so the graph edge IS the record — nothing to mirror and nothing
// that can drift. The only other signal in the product is the pair users.role = 'department_head' +
// users.assigned_department_id, and the leadership half of that is a ROLE NAME: read as a
// relationship it would make every head a head of everything, which is the regression Phase 1
// removed. Nothing on this page reads users.role.
import { getDepartmentHead } from '@/lib/org-graph';
import { setDepartmentHead } from '@/lib/org-assignment';

const user = Astro.locals.user!;
const canEdit = can(user, 'roles.edit');
// A DIFFERENT POWER, SO A DIFFERENT KEY. Renaming a department is editorial; naming its head is an
// authority change that decides who approves work across it. `employee.manage` is the people-desk
// capability already gating /admin/hr/reconciliation and the org-writing screens, and it already
// exists in the union in src/lib/auth/permissions.ts — a key outside that union is a permanent 403,
// so no new one is invented here.
const canSetHead = can(user, 'employee.manage');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/departments');

const existingRes = await safeRows<any>('[departments] one department', () =>
  db.select().from(departments).where(eq(departments.id, id)).limit(1));
// Redirect ONLY on a read that worked and found nothing. On a failed read the page renders and says
// what failed, because "this department does not exist" is a claim it cannot make.
if (existingRes.ok && existingRes.rows.length === 0) return Astro.redirect('/admin/departments');
let current: any = existingRes.rows[0] || null;

let errorMsg = '';
let okMsg = '';

// NO WRITE ON A RECORD WE DID NOT READ. Without `current` the update below would build its payload
// from `current.id` and throw, and the delete would audit a name it does not have.
if (Astro.request.method === 'POST' && current) {
  const fd = await Astro.request.formData();
  const intent = fd.get('_intent');

  if (intent === 'set_department_head') {
    // SUPERSEDES, NEVER OVERWRITES. setDepartmentHead() closes the incumbent's edge with an
    // effective_to at the same instant the new one opens, so a decision taken under the previous
    // head stays explicable afterwards. It refuses — with a sentence — rather than guessing: a head
    // who has left, or who has an employee record but no linked sign-in, would read as headed on
    // this screen while every permission check answered no.
    if (!canSetHead) {
      errorMsg = 'You can read this department, but naming its head decides who approves work across '
        + 'it, and that needs the people-desk capability. Nothing was changed.';
    } else {
      const headEmployeeId = (fd.get('headEmployeeId') as string || '').trim();
      const res = await setDepartmentHead({
        departmentId: String(current.id),
        headEmployeeId: headEmployeeId || null,
        actorUserId: user.id,
        note: 'Set on /admin/departments/' + current.id,
      });
      if (!res.ok) {
        errorMsg = res.error || 'The department head was not changed.';
      } else if (!headEmployeeId) {
        okMsg = 'This department now has no recorded head. Anything that routes to a department head '
          + 'will resolve to nobody until one is named. The edge held by the previous head was closed, not '
          + 'deleted, so past approvals still read correctly.';
      } else {
        okMsg = res.edgeWritten
          ? res.headName + ' is now recorded as the head of ' + current.name + ' in the Organization '
            + 'Graph. Any edge held by a previous head was closed at the same instant, not deleted.'
          : res.headName + ' was already the recorded head of ' + current.name + '. Nothing needed to change.';
      }
    }
  } else if (!canEdit) {
    // Previously a POST from somebody without `roles.edit` fell through and did nothing at all,
    // which reads on screen as a save that worked. Saying so grants nobody anything new.
    errorMsg = 'You can read this department, but changing it needs edit rights on roles and '
      + 'departments. Nothing was changed.';
  } else if (intent === 'delete') {
    // THE GUARD REFUSES WHEN IT CANNOT ANSWER. This was `inUse[0].count`, which throws on a read
    // that failed and on a driver that returned no row — an unexplained 500 in a DESTRUCTIVE path.
    // The failure is not swallowed: it is reported to the person pressing the button and logged with
    // the real Postgres reason, and the delete does not happen.
    const inUse = await safeRows<any>('[departments] roles still in this department', () =>
      db.select({ count: sql<number>`count(*)::int` }).from(roles).where(eq(roles.departmentId, id)));
    const inUseCount = inUse.ok ? Number(inUse.rows[0]?.count ?? 0) : null;
    if (inUseCount === null) {
      errorMsg = 'Nothing was deleted. This page could not check whether any role is still in this '
        + 'department, so it will not remove it on an assumption: ' + (inUse.error || 'unknown database error');
    } else if (inUseCount > 0) {
      errorMsg = 'Cannot delete: ' + inUseCount + ' role(s) still in this department. Move or delete those roles first.';
    } else {
      await db.delete(departments).where(eq(departments.id, id));
      await logAudit({
        userId: user.id,
        action: 'department.delete',
        entity: 'department',
        entityId: id,
        diff: { deleted: { name: current.name } },
        ipAddress: Astro.clientAddress
      });
      return Astro.redirect('/admin/departments');
    }
  } else {
    const candidate = {
      id: current.id,
      name: (fd.get('name') as string || '').trim(),
      icon: (fd.get('icon') as string || '').trim(),
      description: (fd.get('description') as string || '').trim(),
      isFlagship: fd.get('isFlagship') === 'on',
      sortOrder: parseInt((fd.get('sortOrder') as string) || '0', 10),
      isVisible: fd.get('isVisible') === 'on'
    };

    const parsed = departmentSchema.safeParse(candidate);
    if (!parsed.success) {
      errorMsg = parsed.error.errors.map((e) => e.path.join('.') + ': ' + e.message).join(' · ');
    } else {
      await db.update(departments)
        .set({ ...parsed.data, updatedAt: new Date() })
        .where(eq(departments.id, id));
      await logAudit({
        userId: user.id,
        action: 'department.update',
        entity: 'department',
        entityId: id,
        diff: { updated: parsed.data },
        ipAddress: Astro.clientAddress
      });
      okMsg = 'Saved.';
      // The re-read can fail on its own. Keep the record we already have rather than replacing it
      // with undefined, which crashed the whole page on the line after a SUCCESSFUL save.
      const refreshed = await safeRows<any>('[departments] re-read after save', () =>
        db.select().from(departments).where(eq(departments.id, id)).limit(1));
      if (refreshed.ok && refreshed.rows[0]) current = refreshed.rows[0];
    }
  }
}

const roleCountRes = await safeRows<any>('[departments] role count for one department', () =>
  db.select({ count: sql<number>`count(*)::int` }).from(roles).where(eq(roles.departmentId, id)));
// Null, not 0. "0 role(s)" over a failed count is what makes somebody delete a department that is
// still in use — and the delete guard below reads the same table, so it would refuse anyway. Saying
// "unknown" keeps the screen and the guard telling the same story.
const roleCount: number | null = roleCountRes.ok ? Number(roleCountRes.rows[0]?.count ?? 0) : null;
const roleCountWords = roleCount === null ? 'role count unknown' : roleCount + ' role(s)';

// =================================================================================================
// THE DEPARTMENT HEAD. Read AFTER the POST handler, so what is shown is what was just written.
// =================================================================================================
//
// getDepartmentHead() asks the graph for the in-force `department_head` edge scoped to this
// department. It returns null both when there is no head and when the read failed, which is why the
// list below is read separately and its own failure is reported: an empty picker over an unread
// employee register would read as "nobody here can be a head".
const currentHead = current ? await getDepartmentHead(String(current.id)) : null;

// WHO CAN BE A HEAD: an ACTIVE employee with a linked sign-in.
//
// Both halves are load-bearing. The graph is keyed on hr_employees.id, so somebody with no employee
// record cannot be an edge at all; and userIsDepartmentHead() resolves a session user id to an
// employee id before asking the graph, so a head with no linked login can never be matched to a
// signed-in session — the department would read as headed while every permission check answered no.
// setDepartmentHead() refuses both cases as well, so a posted id cannot get round this list.
const headCandidatesRes = current && canSetHead
  ? await safeRows<any>('[departments] employees who could head a department', () => db.execute(sql`
      SELECT id, full_name, designation, employee_code
        FROM hr_employees
       WHERE is_active = true AND user_id IS NOT NULL
       ORDER BY full_name ASC
       LIMIT 500`))
  : { ok: true, rows: [] as any[], error: null };
const headCandidates = headCandidatesRes.rows;
const currentHeadEmployeeId = currentHead?.employeeId ? String(currentHead.employeeId) : '';
// The head already on file might not be on the list above — they may have been deactivated since.
// Offering them, labelled, keeps the record from reading as "nobody is set"; setDepartmentHead()
// still refuses to re-record a departed head, which is the correct refusal to make out loud.
const headOnFileMissing = !!currentHeadEmployeeId
  && !headCandidates.some((e: any) => String(e.id) === currentHeadEmployeeId);
---
<AdminLayout title={current ? 'Edit · ' + current.name : 'Department could not be read'} activeNav="departments">
  <div class="admin-page" style="max-width:680px;">
    <div class="admin-page-header">
      <div class="admin-page-title-block">
        <div class="admin-page-eyebrow"><a href="/admin/departments" style="color:#6e6e78;text-decoration:none;">Departments</a></div>
        <h1 class="admin-page-title">{current ? current.name : 'This department could not be read'}</h1>
        <p class="admin-page-sub" style="font-family:'Geist Mono',monospace;">{current ? current.id + ' · ' + roleCountWords : 'read failed'}</p>
      </div>
    </div>

    {!current && (
      <DayOne
        state="unreadable"
        thing="This department"
        error={existingRes.error}
      />
    )}

    {errorMsg && (
      <div style="background:rgba(220,38,38,0.08);border:1px solid rgba(220,38,38,0.25);color:#fca5a5;font-size:12.5px;padding:11px 14px;border-radius:7px;margin-bottom:18px;">
        {errorMsg}
      </div>
    )}
    {okMsg && (
      <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);color:#6ee7b7;font-size:12.5px;padding:11px 14px;border-radius:7px;margin-bottom:18px;">
        {okMsg}
      </div>
    )}

    {current && (
    <form method="POST" class="admin-card" style="display:flex;flex-direction:column;gap:16px;">
      <div>
        <label class="rolefield-label">Name *</label>
        <input name="name" required value={current.name} class="rolefield-input" disabled={!canEdit} />
      </div>
      <div>
        <label class="rolefield-label">Icon *</label>
        <input name="icon" required value={current.icon} class="rolefield-input" disabled={!canEdit} />
      </div>
      <div>
        <label class="rolefield-label">Description *</label>
        <textarea name="description" required rows="3" class="rolefield-input" disabled={!canEdit}>{current.description}</textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
        <div>
          <label class="rolefield-label">Sort order</label>
          <input type="number" name="sortOrder" value={current.sortOrder} class="rolefield-input" disabled={!canEdit} />
        </div>
        <label style="display:flex;align-items:center;gap:8px;color:#d8d8de;font-size:12.5px;padding-top:22px;cursor:pointer;">
          <input type="checkbox" name="isFlagship" checked={current.isFlagship} disabled={!canEdit} style="accent-color:#FF4F00;" />
          <span>Flagship</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;color:#d8d8de;font-size:12.5px;padding-top:22px;cursor:pointer;">
          <input type="checkbox" name="isVisible" checked={current.isVisible} disabled={!canEdit} style="accent-color:#FF4F00;" />
          <span>Visible publicly</span>
        </label>
      </div>
      {canEdit && (
        <div style="display:flex;gap:10px;justify-content:flex-end;padding-top:14px;border-top:1px solid #15151a;">
          <a href="/admin/departments" class="admin-btn">Cancel</a>
          <button type="submit" name="_intent" value="save" class="admin-btn admin-btn-primary">Save changes</button>
        </div>
      )}
    </form>
    )}

    {current && (
    <div class="admin-card" style="margin-top:24px;">
      <div class="admin-card-title">Department head</div>
      <p style="font-size:12.5px;color:#8a8a94;line-height:1.7;margin:8px 0 14px;">
        The head is recorded as a relationship in the Organization Graph, scoped to this department.
        It is what resolves the approver for anything routed to a department rather than to a named
        person. Changing it supersedes: the previous head is closed off with an effective date rather
        than overwritten, so a decision taken under them still reads correctly.
      </p>

      <p style="font-size:12.5px;color:#d8d8de;line-height:1.7;margin:0 0 14px;">
        {currentHead && currentHead.fullName
          ? 'Currently ' + currentHead.fullName + (currentHead.designation ? ' (' + currentHead.designation + ')' : '') + '.'
          : 'No head is recorded for this department, so anything that routes to a department head resolves to nobody.'}
      </p>

      {canSetHead && !headCandidatesRes.ok && (
        <p style="font-size:12.5px;color:#fca5a5;line-height:1.7;margin:0 0 14px;">
          The employee register could not be read, so this page cannot offer anybody to name:
          {' ' + (headCandidatesRes.error || 'unknown database error')}. Nothing here has changed.
        </p>
      )}

      {canSetHead && headCandidatesRes.ok && (
        <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
          <input type="hidden" name="_intent" value="set_department_head" />
          <div>
            <label class="rolefield-label" for="headEmployeeId">Head of this department</label>
            <select id="headEmployeeId" name="headEmployeeId" class="rolefield-input" style="min-height:44px;">
              <option value="" selected={!currentHeadEmployeeId}>No recorded head</option>
              {headOnFileMissing && (
                <option value={currentHeadEmployeeId} selected>
                  {(currentHead && currentHead.fullName ? currentHead.fullName : 'The head on file') + ' (no longer an active employee)'}
                </option>
              )}
              {headCandidates.map((e: any) => (
                <option value={String(e.id)} selected={String(e.id) === currentHeadEmployeeId}>
                  {String(e.full_name || 'Unnamed record')
                    + (e.designation ? ' — ' + String(e.designation) : '')
                    + (e.employee_code ? ' · ' + String(e.employee_code) : '')}
                </option>
              ))}
            </select>
          </div>
          <p style="font-size:11.5px;color:#6e6e78;line-height:1.6;margin:0;">
            Only active employees with a linked sign-in are listed. Somebody with no employee record
            cannot hold a relationship at all, and somebody with no sign-in could never be matched to
            a session, so the department would read as headed while every check answered no.
          </p>
          <div style="display:flex;justify-content:flex-end;">
            <button type="submit" class="admin-btn admin-btn-primary" style="min-height:44px;">Save department head</button>
          </div>
        </form>
      )}

      {!canSetHead && (
        <p style="font-size:11.5px;color:#6e6e78;line-height:1.6;margin:0;">
          Naming a head decides who approves work across this department, so it needs the people-desk
          capability. Ask whoever administers roles for it.
        </p>
      )}
    </div>
    )}

    {current && canEdit && (
      <div class="admin-card" style="margin-top:24px;border-color:rgba(220,38,38,0.25);">
        <div class="admin-card-title" style="color:#fca5a5;">Danger Zone</div>
        <p style="font-size:12.5px;color:#8a8a94;line-height:1.7;margin:8px 0 12px;">
          Departments can only be deleted when they contain zero roles.
          {roleCount === null
            ? ' The role count could not be read, so this page cannot tell whether this department is in use. Delete is off until it can.'
            : ' Currently this department has ' + roleCount + ' role(s).'}
        </p>
        {/* THE BUTTON IS OFF WHEN THE COUNT IS UNKNOWN, NOT ONLY WHEN IT IS NON-ZERO. `roleCount > 0`
            on a null read is false, which used to leave Delete ENABLED on exactly the page load
            where nothing was known about what the department still holds. */}
        <form method="POST" data-danger="Delete this department?">
          <button type="submit" name="_intent" value="delete" class="admin-btn"
            style={roleCount === null || roleCount > 0
              ? 'background:rgba(120,120,128,0.1);border-color:rgba(120,120,128,0.2);color:#6e6e78;cursor:not-allowed;'
              : 'background:rgba(220,38,38,0.12);border-color:rgba(220,38,38,0.3);color:#fca5a5;'}
            disabled={roleCount === null || roleCount > 0}>
            Delete this department
          </button>
        </form>
      </div>
    )}
  </div>

  <style>
    .rolefield-label {
      display:block;font-size:10.5px;font-weight:600;color:#8a8a94;
      letter-spacing:0.1em;text-transform:uppercase;margin-bottom:6px;
    }
    .rolefield-input {
      width:100%;padding:9px 12px;background:#08080a;border:1px solid #1f1f26;
      border-radius:6px;color:#fff;font-size:13px;font-family:inherit;outline:none;line-height:1.5;
    }
    .rolefield-input:focus { border-color:#FF4F00; }
    .rolefield-input:disabled { opacity:0.6;cursor:not-allowed; }
    textarea.rolefield-input { resize:vertical;min-height:80px; }
  </style>

  <script src="/admin-danger.js" defer></script>
<script is:inline>
  /* FAIL CLOSED. If /admin-danger.js did not load — cached 404, blocked request, parse error —
     every data-danger control above would submit on the FIRST click with no confirmation at all.
     These are delete and revoke buttons, so the safe direction when the guard is missing is a
     dialog, not nothing. This runs only in that case and adds no behaviour when the guard is
     present. */
  window.addEventListener('load', function () {
    if (window.installDanger) return;
    console.warn('[admin-danger] guard script did not load; falling back to confirm()');
    Array.prototype.forEach.call(document.querySelectorAll('[data-danger]'), function (el) {
      var q = el.getAttribute('data-danger');
      var form = el.tagName === 'FORM' ? el : el.form;
      if (form) form.addEventListener('submit', function (e) { if (!confirm(q)) e.preventDefault(); });
      else el.addEventListener('click', function (e) { if (!confirm(q)) e.preventDefault(); });
    });
  });
</script>
</AdminLayout>
