---
// /admin/submissions/[id] — one submission, and every review ever left on it.
//
// WHY THIS ROUTE HAD TO EXIST. src/lib/submissions.ts exported getSubmission(id) and
// listSubmissionReviews(submissionId) and NOTHING called either. /admin/submissions/index.astro
// imports listSubmissions and reviewSubmission only, and there was no /admin/submissions/[id] route
// at all. So reviewSubmission() wrote a row into portal_submission_reviews on every review — a full
// history, with each reviewer's verdict, score and notes — and no surface anywhere in the product
// could read one back. The list screen shows only the LATEST review_notes copied onto the submission
// itself, so a second reviewer's disagreement with the first was invisible the moment it was saved.
//
// This is the same shape as the reviewer surface that did not exist while a notification pushed
// people at its 404, so this page is created BEFORE anything links people to a submission.
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { getSubmission, listSubmissionReviews, reviewSubmission, SUBMISSION_KIND_LABELS } from '@/lib/submissions';

const { id } = Astro.params as { id: string };
const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'admin.access')) return Astro.redirect('/portal');
const mayReview = can(user as any, 'applications.score');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  if (!mayReview) {
    errMsg = 'Recording a review needs the applications.score capability.';
  } else {
    const fd = await Astro.request.formData();
    const notes = String(fd.get('notes') || '').trim();
    const verdict = String(fd.get('verdict') || 'comment') as any;
    const scoreRaw = parseFloat(String(fd.get('score_pct') || ''));
    const scorePct = Number.isFinite(scoreRaw) && scoreRaw >= 0 && scoreRaw <= 100 ? scoreRaw : undefined;
    if (!notes) {
      errMsg = 'Write the review. A verdict with no reasoning cannot be explained to the person who submitted the work.';
    } else {
      // Never swallowed: a review that silently failed to save would leave the reviewer believing
      // they had answered somebody.
      try {
        await reviewSubmission({
          submissionId: id,
          reviewerUserId: user.id,
          reviewerName: user.name || user.email || 'Reviewer',
          verdict, notes, scorePct,
        });
        okMsg = 'Review recorded and added to the history below.';
      } catch (e: any) {
        errMsg = 'The review was NOT saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
      }
    }
  }
}

// Both reads are wrapped so that a failure is named rather than rendered as "no submission" or
// "no reviews yet" — the second of which would be a lie about a person's work.
let sub: any = null;
let subError = '';
try { sub = await getSubmission(id); }
catch (e: any) { subError = String(e?.cause?.message || e?.message || 'unknown error'); }

let reviews: any[] = [];
let reviewsError = '';
try { reviews = await listSubmissionReviews(id); }
catch (e: any) { reviewsError = String(e?.cause?.message || e?.message || 'unknown error'); }

const kindMeta = sub ? (SUBMISSION_KIND_LABELS[sub.kind] || SUBMISSION_KIND_LABELS.other) : null;

function fmt(d: any): string {
  if (!d) return '—';
  try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
  catch { return String(d); }
}
const VERDICT_LABELS: Record<string, string> = {
  approve: 'Approved',
  request_revisions: 'Revisions requested',
  reject: 'Not selected',
  comment: 'Comment only',
};
---
<AdminLayout title="Submission" activeNav="">
<div style="padding:14px 16px 80px;max-width:920px;margin:0 auto;">
  <a href="/admin/submissions" style="font-size:11px;color:#8a8a94;text-decoration:none;font-family:'Geist Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;">Back to the inbox</a>

  {okMsg && <div style="background:rgba(74,222,128,0.10);border:1px solid rgba(74,222,128,0.32);color:#86efac;border-radius:10px;padding:10px 14px;margin:14px 0;font-size:13px;">{okMsg}</div>}
  {errMsg && <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:10px;padding:10px 14px;margin:14px 0;font-size:13px;">{errMsg}</div>}

  {subError ? (
    <div style="background:#0f0f14;border:1px solid rgba(239,68,68,0.32);border-radius:14px;padding:28px;margin-top:16px;">
      <h1 style="font-size:20px;color:#fff;margin:0 0 8px;font-weight:700;">This submission could not be read.</h1>
      <p style="font-size:13.5px;color:#d8d8de;line-height:1.65;margin:0;">
        That is different from it not existing. Do not record a decision about work you cannot see.
      </p>
      <p style="font-family:'Geist Mono',monospace;font-size:11.5px;color:#8a8a94;margin:12px 0 0;">Reason recorded: {subError}</p>
    </div>
  ) : !sub ? (
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:28px;margin-top:16px;">
      <h1 style="font-size:20px;color:#fff;margin:0 0 8px;font-weight:700;">No submission at this address.</h1>
      <p style="font-size:13.5px;color:#9aa6b6;margin:0;">It may have been withdrawn. The inbox lists everything currently on record.</p>
    </div>
  ) : (
    <div>
      <div style="display:flex;gap:8px;align-items:center;margin:16px 0 6px;flex-wrap:wrap;">
        <span style={`background:${kindMeta!.accent}22;color:${kindMeta!.accent};font-size:10px;font-weight:700;padding:3px 9px;border-radius:100px;font-family:'Geist Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;`}>{kindMeta!.label}</span>
        <span style="background:rgba(255,255,255,0.06);color:#9aa6b6;font-size:10px;font-weight:700;padding:3px 9px;border-radius:100px;font-family:'Geist Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;">{String(sub.submitter_role || '').replace(/_/g, ' ')}</span>
        <span style="font-size:10.5px;color:#FF7040;font-weight:700;font-family:'Geist Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;">{String(sub.status || '').replace(/_/g, ' ')}</span>
      </div>

      <h1 style="font-size:24px;color:#fff;margin:0 0 6px;font-weight:700;line-height:1.25;">{sub.title}</h1>
      <p style="font-size:12px;color:#9aa6b6;margin:0 0 18px;font-family:'Geist Mono',monospace;">
        {sub.submitter_name} · {sub.submitter_email || 'no email on record'} · submitted {fmt(sub.submitted_at)}
      </p>

      {sub.description && (
        <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;margin-bottom:12px;">
          <p style="font-size:13.5px;color:#d8d8de;line-height:1.7;margin:0;white-space:pre-wrap;">{sub.description}</p>
        </div>
      )}

      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;">
        {sub.drive_url && <a href={sub.drive_url} target="_blank" rel="noopener" style="background:#15151a;border:1px solid #2a2a2f;color:#FF7040;padding:9px 16px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none;">Open the shared document</a>}
        {sub.external_url && <a href={sub.external_url} target="_blank" rel="noopener" style="background:#15151a;border:1px solid #2a2a2f;color:#FF7040;padding:9px 16px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none;">Open the external link</a>}
        {!sub.drive_url && !sub.external_url && <p style="font-size:12.5px;color:#8a8a94;margin:0;">No link was provided with this submission.</p>}
      </div>

      {/* THE REVIEW HISTORY — the thing that was written and never readable. */}
      <h2 style="font-size:16px;color:#fff;margin:0 0 10px;font-weight:700;">Review history</h2>

      {reviewsError ? (
        <div style="background:#0f0f14;border:1px solid rgba(239,68,68,0.32);border-radius:12px;padding:16px;margin-bottom:14px;">
          <p style="font-size:13px;color:#fca5a5;line-height:1.6;margin:0;">
            The review history could not be read. This is <strong>not</strong> a submission with no reviews —
            an earlier reviewer may already have decided this, and you cannot see it.
          </p>
          <p style="font-family:'Geist Mono',monospace;font-size:11.5px;color:#8a8a94;margin:8px 0 0;">Reason recorded: {reviewsError}</p>
        </div>
      ) : reviews.length === 0 ? (
        <p style="font-size:13px;color:#8a8a94;margin:0 0 14px;">Nobody has reviewed this yet.</p>
      ) : (
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
          {reviews.map((r: any) => (
            <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px;">
              <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;">
                <p style="font-size:13px;color:#fff;font-weight:700;margin:0;">{VERDICT_LABELS[r.verdict] || r.verdict}</p>
                {r.score_pct != null && <p style="font-size:13px;color:#FF7040;font-weight:800;margin:0;font-family:'Geist Mono',monospace;">{Number(r.score_pct).toFixed(1)}%</p>}
              </div>
              <p style="font-size:11.5px;color:#8a8a94;margin:3px 0 0;font-family:'Geist Mono',monospace;">{r.reviewer_name || 'Reviewer'} · {fmt(r.created_at)}</p>
              <p style="font-size:13.5px;color:#d8d8de;line-height:1.7;margin:8px 0 0;white-space:pre-wrap;">{r.notes}</p>
            </div>
          ))}
        </div>
      )}

      {mayReview && (
        <form method="POST" style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:10px;">
          <h3 style="font-size:14px;color:#fff;margin:0;font-weight:700;">Add a review</h3>
          <textarea name="notes" rows="4" required placeholder="What you decided, and why."
            style="background:#15151a;border:1px solid #2a2a2f;color:#fff;padding:10px 12px;border-radius:6px;font-size:13px;line-height:1.6;font-family:inherit;"></textarea>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <select name="verdict" style="background:#15151a;border:1px solid #2a2a2f;color:#fff;padding:9px 10px;border-radius:6px;font-size:12.5px;">
              <option value="comment">Comment only</option>
              <option value="approve">Approve</option>
              <option value="request_revisions">Request revisions</option>
              <option value="reject">Not selected</option>
            </select>
            <input type="number" name="score_pct" min="0" max="100" step="0.1" placeholder="Score %"
              style="width:110px;background:#15151a;border:1px solid #2a2a2f;color:#fff;padding:9px 10px;border-radius:6px;font-size:12.5px;" />
            <button type="submit" style="background:#FF4F00;border:none;color:#fff;padding:9px 18px;border-radius:6px;font-size:12.5px;font-weight:700;cursor:pointer;">Record review</button>
          </div>
        </form>
      )}
    </div>
  )}
</div>
</AdminLayout>
