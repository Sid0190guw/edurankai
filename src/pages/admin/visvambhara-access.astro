---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ensureVisvambharaAccessSchema } from '@/lib/visvambhara-access';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

await ensureVisvambharaAccessSchema();

let okMsg = '', errMsg = '';
// Declared before the handler that fills it. Each entry names one thing the applicant was supposed
// to receive and did not. See the note on postDecisionToThread below.
const missedEffects: string[] = [];

function rowsLocal(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// WAS `catch (_) {}`, UNDER THREE MESSAGES THAT SAID "Decision posted into thread, applicant
// notified." That claim was printed whether or not the post happened. This thread is the ONLY place
// the applicant reads why they were approved, refused or revoked — /products/visvambhara/access
// shows them the status and nothing else — so a swallowed failure here means a researcher whose
// access was pulled is never told, and the reviewer closes the case believing they were.
async function postDecisionToThread(requestId: string, applicantUid: string | null, body: string): Promise<boolean> {
  try {
    const { postMessage } = await import('@/lib/request-threads');
    const posted = await postMessage({
      requestType: 'visvambhara_access',
      requestId,
      applicantUserId: applicantUid,
      senderRole: 'admin',
      senderUserId: user.id,
      senderName: user.name || 'Research team',
      body,
    });
    if (!posted.ok) {
      console.error('[admin/visvambhara-access] thread post refused for', requestId, '-', posted.error);
      missedEffects.push('the decision was NOT posted into the applicant’s thread (' + (posted.error || 'unknown reason') + ')');
      return false;
    }
    if (posted.warning) missedEffects.push('the decision is in the thread but no unread badge was raised for the applicant');
    return true;
  } catch (e: any) {
    console.error('[admin/visvambhara-access] thread post failed for', requestId, '-', e?.cause?.message || e?.message);
    missedEffects.push('the decision was NOT posted into the applicant’s thread');
    return false;
  }
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = (fd.get('_action') as string || '').trim();
  const id = (fd.get('id') as string || '').trim();
  const reason = (fd.get('reason') as string || '').trim() || null;
  try {
    // Look up the applicant once so every action below can post a decision
    // message into the thread (and so the push notification routes correctly).
    const reqRow = id ? (rowsLocal(await db.execute(sql`SELECT user_id FROM visvambhara_access_requests WHERE id = ${id} LIMIT 1`))[0] as any) : null;
    const applicantUid: string | null = reqRow?.user_id || null;

    // RETURNING ON EVERY DECISION. All three writes used to be fire-and-forget UPDATEs followed by
    // an unconditional "Approved." — so an id that matched no row, or a request another reviewer had
    // already decided, produced the green box over a statement that changed nothing.
    if (action === 'approve' && id) {
      const done = rowsLocal(await db.execute(sql`UPDATE visvambhara_access_requests SET status = 'approved', reviewed_by_user_id = ${user.id}, reviewed_at = NOW(), reject_reason = NULL WHERE id = ${id} RETURNING id`));
      if (!done.length) {
        errMsg = 'Nothing was approved: that request no longer exists. Reload the queue.';
      } else {
        await postDecisionToThread(id, applicantUid, 'Your restricted research access request has been approved.\n\nOne approval covers the whole restricted line: you can now open the Viśvambhara deep modules at /products/visvambhara and the Akasha-Q briefing at /products/akasha-q. Replies to this thread reach the research team directly.');
        okMsg = 'Approved.';
      }
    } else if (action === 'reject' && id) {
      const done = rowsLocal(await db.execute(sql`UPDATE visvambhara_access_requests SET status = 'rejected', reviewed_by_user_id = ${user.id}, reviewed_at = NOW(), reject_reason = ${reason} WHERE id = ${id} RETURNING id`));
      if (!done.length) {
        errMsg = 'Nothing was rejected: that request no longer exists. Reload the queue.';
      } else {
        const body = 'Your restricted research access request was not granted at this time.'
          + (reason ? '\n\nReason from the reviewer:\n' + reason : '')
          + '\n\nYou are welcome to update your engagement note and re-submit, or reply on this thread with additional context.';
        await postDecisionToThread(id, applicantUid, body);
        okMsg = 'Marked as rejected.';
      }
    } else if (action === 'revoke' && id) {
      const finalReason = reason || 'Access revoked';
      const done = rowsLocal(await db.execute(sql`UPDATE visvambhara_access_requests SET status = 'rejected', reviewed_by_user_id = ${user.id}, reviewed_at = NOW(), reject_reason = COALESCE(${reason}, 'Access revoked') WHERE id = ${id} RETURNING id`));
      if (!done.length) {
        errMsg = 'Nothing was revoked: that request no longer exists. Reload the queue.';
      } else {
        await postDecisionToThread(id, applicantUid, 'Your restricted research access has been revoked — this covers both the Viśvambhara modules and the Akasha-Q briefing.\n\nReason: ' + finalReason + '\n\nReplies to this thread reach the research team directly.');
        okMsg = 'Access revoked.';
      }
    }
    if (okMsg) {
      if (!applicantUid) missedEffects.push('this request has no portal account attached, so nobody could be told');
      if (missedEffects.length) {
        errMsg = 'The decision is recorded, but ' + missedEffects.join('; ') + '. The applicant has not been told — contact them directly.';
      } else {
        okMsg += ' Decision posted into the applicant’s thread.';
      }
    }
  } catch (e: any) {
    // e.message on a drizzle error is only the failed SQL, and it was being handed to the operator
    // with nothing written to any log.
    const real = e?.cause?.message || e?.message || 'unknown reason';
    console.error('[admin/visvambhara-access]', action, 'failed for', id, '-', real);
    okMsg = '';
    errMsg = 'Nothing was changed. Reason: ' + real;
  }
}

function rows(r: any) { return Array.isArray(r) ? r : (r?.rows || []); }
const filter = new URL(Astro.request.url).searchParams.get('status') || 'pending';
// THE ONLY SCREEN WHERE THE GRANT DECISION IS MADE, and both reads were bare top-level awaits: an
// unreachable pooler took the whole reviewer desk to a 500. It degrades to an explicit banner now,
// because an empty queue means "nobody is waiting" and a reviewer must not read an outage as that.
let requests: any[] = [];
let queueReadable = true;
try {
  requests = rows(await db.execute(sql`
    SELECT r.id, r.note, r.cv_url, r.status, r.reject_reason, r.created_at, r.reviewed_at,
           u.email AS user_email, u.name AS user_name
    FROM visvambhara_access_requests r
    JOIN users u ON u.id = r.user_id
    ${filter === 'all' ? sql`` : sql`WHERE r.status = ${filter}`}
    ORDER BY r.created_at DESC
    LIMIT 200
  `));
} catch (e: any) {
  queueReadable = false;
  console.error('[admin/visvambhara-access] queue read failed:', e?.cause?.message || e?.message);
}

const countMap: Record<string, number> = {};
let countsReadable = true;
try {
  const counts = rows(await db.execute(sql`SELECT status, COUNT(*)::int AS n FROM visvambhara_access_requests GROUP BY status`));
  for (const c of counts) countMap[c.status] = c.n;
} catch (e: any) {
  countsReadable = false;
  console.error('[admin/visvambhara-access] counts read failed:', e?.cause?.message || e?.message);
}

function fmt(d: any) { return d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—'; }
---
<AdminLayout title="Restricted Research Access Requests" activeNav="">
<div style="padding-bottom:80px;">
  {(!queueReadable || !countsReadable) && (
    <div style="background:rgba(251,191,36,0.10);border-bottom:1px solid rgba(251,191,36,0.35);padding:12px 16px;color:#fbbf24;font-size:12.5px;line-height:1.6;">
      <b>{queueReadable ? 'Counts unavailable.' : 'Queue unavailable.'}</b> {queueReadable ? 'The totals below may be wrong.' : 'This list could not be loaded — it does NOT mean nobody is waiting for a decision. Try again shortly.'}
    </div>
  )}
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">Restricted research · Viśvambhara + Akasha-Q</p>
    <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0 0 4px;">Access Requests</h1>
    <p style="font-size:11.5px;color:#8a8a99;margin:0 0 10px;line-height:1.5;">One approval opens both programmes: the Viśvambhara deep modules and the Akasha-Q restricted briefing.</p>
    <div style="display:flex;gap:4px;flex-wrap:wrap;">
      {[
        { k: 'pending',  l: 'Pending',  c: countMap.pending  || 0, color: '#fbbf24' },
        { k: 'approved', l: 'Approved', c: countMap.approved || 0, color: '#34d399' },
        { k: 'rejected', l: 'Rejected', c: countMap.rejected || 0, color: '#f87171' },
        { k: 'all',      l: 'All',      c: Object.values(countMap).reduce((a:any,b:any)=>a+b,0) as number, color: '#9aa6b6' },
      ].map((t: any) => (
        <a href={`?status=${t.k}`} style={`text-decoration:none;font-size:12px;font-weight:600;padding:6px 12px;border-radius:6px;${filter === t.k ? 'background:'+t.color+';color:#0a0a0c;' : 'background:#15151a;color:#8a8a94;'}`}>{t.l} ({t.c})</a>
      ))}
    </div>
  </div>

  {okMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.10);border:1px solid rgba(16,185,129,0.30);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}
  {errMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.30);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errMsg}</div>}

  <div style="padding:14px 16px;display:flex;flex-direction:column;gap:10px;">
    {requests.length === 0 && (
      <p style="color:#8a8a94;font-size:13px;text-align:center;padding:40px;">No {filter !== 'all' ? filter : ''} requests.</p>
    )}
    {requests.map((r: any) => (
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px 16px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px;">
          <div>
            <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">{r.user_name || r.user_email}</p>
            <p style="font-size:11px;color:#8a8a94;margin:2px 0 0;font-family:'Geist Mono',monospace;">{r.user_email}</p>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
            <span style={`font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px;text-transform:uppercase;background:${r.status === 'approved' ? 'rgba(16,185,129,0.15)' : r.status === 'rejected' ? 'rgba(239,68,68,0.15)' : 'rgba(251,191,36,0.15)'};color:${r.status === 'approved' ? '#6ee7b7' : r.status === 'rejected' ? '#fca5a5' : '#fbbf24'};`}>{r.status}</span>
            <span style="font-size:10.5px;color:#8a8a94;">{fmt(r.created_at)}</span>
          </div>
        </div>
        <p style="font-size:13px;color:#d8d8de;margin:8px 0;white-space:pre-wrap;line-height:1.7;background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;">{r.note}</p>
        <p style="font-size:11.5px;color:#8a8a94;margin:6px 0;">CV: <a href={r.cv_url} target="_blank" rel="noopener" style="color:#60a5fa;text-decoration:none;font-family:'Geist Mono',monospace;word-break:break-all;">{r.cv_url}</a></p>
        {r.status === 'rejected' && r.reject_reason && (
          <p style="font-size:11px;color:#fca5a5;margin:4px 0 0;">Reason: {r.reject_reason}</p>
        )}
        <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
          {r.status !== 'approved' && (
            <form method="POST" style="margin:0;">
              <input type="hidden" name="_action" value="approve" />
              <input type="hidden" name="id" value={r.id} />
              <button type="submit" style="background:#10b981;border:none;color:#fff;font-size:11.5px;font-weight:700;padding:6px 14px;border-radius:6px;cursor:pointer;">Approve</button>
            </form>
          )}
          {r.status !== 'rejected' && (
            <form method="POST" onsubmit="this.querySelector('input[name=reason]').value = prompt('Reason for rejection (shown to applicant):') || ''; if (!this.querySelector('input[name=reason]').value) return false;" style="margin:0;">
              <input type="hidden" name="_action" value={r.status === 'approved' ? 'revoke' : 'reject'} />
              <input type="hidden" name="id" value={r.id} />
              <input type="hidden" name="reason" value="" />
              <button type="submit" style="background:#15151a;border:1px solid rgba(239,68,68,0.4);color:#fca5a5;font-size:11.5px;font-weight:700;padding:6px 14px;border-radius:6px;cursor:pointer;">{r.status === 'approved' ? 'Revoke' : 'Reject'}</button>
            </form>
          )}
          <button type="button" class="toggle-thread" data-req={r.id} style="background:#15151a;border:1px solid #1a1a1f;color:#9aa6b6;font-size:11.5px;font-weight:700;padding:6px 14px;border-radius:6px;cursor:pointer;">Open thread</button>
        </div>

        <div class="thread-panel" id={'thread-' + r.id} data-req={r.id} style="display:none;margin-top:12px;padding-top:12px;border-top:1px solid #1a1a1f;">
          <div class="thread-list" style="display:flex;flex-direction:column;gap:8px;max-height:380px;overflow-y:auto;margin-bottom:10px;">
            <p style="color:#8a8a94;font-size:11.5px;text-align:center;padding:12px;">Loading…</p>
          </div>
          <textarea class="thread-input" rows="3" placeholder="Reply to the applicant — they will see this inside their portal thread" maxlength="5000" style="width:100%;background:#08080a;border:1px solid #1a1a1f;color:#fff;border-radius:8px;padding:9px 12px;font-size:13px;font-family:inherit;outline:none;resize:vertical;line-height:1.55;"></textarea>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px;">
            <span class="thread-status" style="font-size:11px;color:#8a8a94;line-height:1.5;"></span>
            <button type="button" class="thread-send" data-req={r.id} style="background:#FF4F00;border:none;color:#fff;font-size:11.5px;font-weight:700;padding:7px 16px;border-radius:6px;cursor:pointer;flex-shrink:0;">Send reply</button>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    function fmt(d) { try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (_) { return ''; } }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    function renderThread(panel, msgs) {
      var list = panel.querySelector('.thread-list');
      if (!msgs || !msgs.length) {
        list.innerHTML = '<p style="color:#8a8a94;font-size:11.5px;text-align:center;padding:12px;">No replies yet. Be the first to respond — your message lands in the applicant\'s portal thread.</p>';
        return;
      }
      list.innerHTML = msgs.map(function (m) {
        var bg = m.sender_role === 'admin' ? 'rgba(255,79,0,0.08)' : '#15151a';
        var border = m.sender_role === 'admin' ? 'rgba(255,79,0,0.30)' : '#1a1a1f';
        var label = m.sender_role === 'admin' ? 'Research team · ' + esc(m.sender_name || 'You') : esc(m.sender_name || 'Applicant');
        var labelColor = m.sender_role === 'admin' ? '#FF7040' : '#9aa6b6';
        return '<div style="background:' + bg + ';border:1px solid ' + border + ';border-radius:8px;padding:9px 12px;">'
          + '<div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:4px;">'
          + '<p style="font-size:10px;color:' + labelColor + ';font-weight:700;letter-spacing:0.08em;text-transform:uppercase;font-family:Geist Mono,monospace;margin:0;">' + label + '</p>'
          + '<p style="font-size:10px;color:#8a8a94;font-family:Geist Mono,monospace;margin:0;">' + fmt(m.created_at) + '</p>'
          + '</div>'
          + '<p style="font-size:13px;color:#d8d8de;line-height:1.6;white-space:pre-wrap;margin:0;">' + esc(m.body) + '</p>'
          + '</div>';
      }).join('');
      list.scrollTop = list.scrollHeight;
    }
    // A REFUSED OR FAILED READ USED TO LEAVE 'Loading…' ON SCREEN FOR EVER. There was no .catch and
    // no else: a 403 from the endpoint, a 500, an HTML error page or a dropped connection all ended
    // the chain silently, and the reviewer sat looking at a spinner that was never going to resolve.
    function note(panel, text, color) {
      var list = panel.querySelector('.thread-list');
      if (list) list.innerHTML = '<p style="color:' + color + ';font-size:11.5px;text-align:center;padding:12px;line-height:1.6;">' + esc(text) + '</p>';
    }
    function load(panel) {
      var req = panel.getAttribute('data-req');
      fetch('/api/admin/visvambhara-access/thread?id=' + encodeURIComponent(req), { credentials: 'same-origin' })
        .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'the server answered ' + r.status + ' with something that is not JSON' }; }); })
        .then(function (d) {
          if (d && d.ok) renderThread(panel, d.messages);
          else note(panel, 'This thread could not be loaded, so it is not empty — it is unknown. ' + ((d && d.error) || ''), '#e8c46a');
        })
        .catch(function () { note(panel, 'This thread could not be loaded: the request never reached the server. Nothing here has been checked.', '#e8c46a'); });
    }
    document.querySelectorAll('.toggle-thread').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var panel = document.getElementById('thread-' + btn.getAttribute('data-req'));
        if (!panel) return;
        var open = panel.style.display !== 'none';
        if (open) { panel.style.display = 'none'; btn.textContent = 'Open thread'; }
        else { panel.style.display = 'block'; btn.textContent = 'Close thread'; load(panel); }
      });
    });
    document.querySelectorAll('.thread-send').forEach(function (b) {
      b.addEventListener('click', function () {
        var req = b.getAttribute('data-req');
        var panel = document.getElementById('thread-' + req);
        var ta = panel.querySelector('.thread-input');
        var body = (ta.value || '').trim();
        if (!body) return;
        b.disabled = true; b.textContent = 'Sending…';
        // The reply either went to the applicant or it did not, and the reviewer has to be told
        // which. This used to re-enable the button and stop: a refused reply looked identical to a
        // sent one except that the text stayed in the box, which reads as a mis-click.
        var st = panel.querySelector('.thread-status');
        function say(text, color) { if (st) { st.textContent = text; st.style.color = color; } }
        say('', '#6e6e78');
        fetch('/api/admin/visvambhara-access/reply', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ requestId: req, body: body })})
          .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'the server answered ' + r.status + ' with something that is not JSON' }; }); })
          .then(function (d) {
            b.disabled = false; b.textContent = 'Send reply';
            if (d && d.ok) { ta.value = ''; say('Sent. The applicant sees it in their portal thread.', '#6ee7b7'); load(panel); }
            else say('NOT sent — the applicant has not received this. ' + ((d && d.error) || ''), '#fca5a5');
          })
          .catch(function () {
            b.disabled = false; b.textContent = 'Send reply';
            say('NOT sent — the request never reached the server. Your text is still in the box.', '#fca5a5');
          });
      });
    });
  })();
</script>
</AdminLayout>
