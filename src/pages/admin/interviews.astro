---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { canAccessSection } from '@/lib/auth/permissions';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

// EVERY WRITE ON THIS PAGE WAS FRONTED BY user.role === 'applicant' AND NOTHING ELSE.
//
// src/middleware.ts maps this path to the interviews section and getViewableSectionKeys() enforces
// VIEW there and only VIEW, so any account that could OPEN this console could also change what it
// holds. src/lib/auth/permissions.ts says in as many words never to use role !== 'applicant' as an
// authorisation test; the identical repair was already made on /admin/ai-interview-templates and
// /admin/hr/training.
//
// GATED ON 'edit', NOT 'delete', DELIBERATELY: canAccessSection() gives a built-in role holding a
// section view/edit/export and reserves delete for super_admin, so asking for 'delete' here would
// take an action away from a role that holds this section today. Narrowing it further is a policy
// decision for a human; refusing a custom VIEW-ONLY role is the mechanism fix, and that is this.
const canWrite = await canAccessSection(user as any, 'interviews', 'edit');

let okMsg = '', errorMsg = '';

// =================================================================================================
// MOVING SOMEBODY'S INTERVIEW WITHOUT TELLING THEM IS NOT MOVING IT
// =================================================================================================
//
// All four actions here were a bare UPDATE whose result was never read, followed by an unconditional
// success sentence. Two separate silences came out of that:
//
//   1. THE CANDIDATE WAS NEVER TOLD. Rescheduling put a new time in the database and cancelling put
//      a reason in a column, and the person whose diary it is learned neither. They turn up for an
//      interview that was cancelled last Tuesday, or miss one that was moved — the two outcomes this
//      screen exists to prevent. Every other decision on an application goes to the candidate through
//      notifyUser(); this screen was the one that did not.
//   2. THE ADMIN WAS TOLD IT WORKED REGARDLESS. `WHERE id=${id}` matching no row — a stale list, a
//      second click, an interview somebody else just cancelled — printed "Interview rescheduled."
//      just the same.
//
// RETURNING fixes the second. The helper below fixes the first, and it is DECLARED ABOVE THE HANDLER
// that calls it: `const` is not hoisted and a helper sitting under its first caller has taken pages
// down on this project.
//
// The notification is best-effort BY DESIGN and never swallowed: the status is already committed, so
// a push failure must not report the reschedule as having failed — but "the candidate was NOT told"
// is exactly the fact this whole screen is about, so it is returned and shown, not logged and lost.
function rowsOf(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

async function tellCandidate(
  applicationId: string | null | undefined,
  title: string,
  body: string,
): Promise<string> {
  if (!applicationId) return 'this interview is not linked to an application, so the candidate could not be told';
  try {
    const who = rowsOf(await db.execute(
      sql`SELECT applicant_user_id FROM applications WHERE id = ${applicationId} LIMIT 1`));
    const uid = who[0]?.applicant_user_id;
    if (!uid) return 'the candidate has no portal account, so they could not be told';
    const { notifyUser } = await import('@/lib/notify');
    await notifyUser(String(uid), {
      title, body,
      type: 'application',
      // An EXISTING route. Their application tracker is where an interview is listed; a push to a
      // page that does not exist is worse than no push at all.
      actionUrl: '/portal/applications/' + applicationId,
      entityType: 'application',
      entityId: String(applicationId),
    });
    return '';
  } catch (e: any) {
    console.error('[interviews] the candidate was NOT told -', e?.cause?.message || e?.message);
    return 'the candidate was NOT notified (' + (e?.cause?.message || e?.message || 'unknown reason') + ')';
  }
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  if (!canWrite) {
    errorMsg = 'Your role can open the interview board but cannot change it. Nothing was saved.';
  } else
  try {
    if (action === 'reschedule') {
      const id = fd.get('id') as string;
      const newTime = fd.get('scheduled_at') as string;
      const changed = rowsOf(await db.execute(sql`
        UPDATE interview_rounds SET scheduled_at=${newTime}, status='rescheduled', updated_at=NOW()
         WHERE id=${id}
        RETURNING id, application_id, scheduled_at`));
      if (!changed.length) {
        errorMsg = 'Nothing was changed — that interview is no longer on this list. Reload the page.';
      } else {
        const when = changed[0].scheduled_at
          ? new Date(changed[0].scheduled_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
          : 'a new time';
        const missed = await tellCandidate(
          changed[0].application_id,
          'Your interview has been moved',
          'It is now on ' + when + ' (IST). Nothing else about your application has changed.',
        );
        okMsg = 'Interview rescheduled.' + (missed ? '' : ' The candidate has been told the new time.');
        if (missed) errorMsg = 'The new time is saved, but ' + missed + '. Contact them directly.';
      }
    } else if (action === 'cancel') {
      const id = fd.get('id') as string;
      const reason = fd.get('reason') as string;
      const changed = rowsOf(await db.execute(sql`
        UPDATE interview_rounds SET status='cancelled', cancellation_reason=${reason}, updated_at=NOW()
         WHERE id=${id}
        RETURNING id, application_id`));
      if (!changed.length) {
        errorMsg = 'Nothing was changed — that interview is no longer on this list. Reload the page.';
      } else {
        const why = String(reason || '').trim();
        const missed = await tellCandidate(
          changed[0].application_id,
          'Your interview has been cancelled',
          'This round will not go ahead' + (why ? ': ' + why : '.')
            + ' Your application itself has not been closed by this.',
        );
        okMsg = 'Interview cancelled.' + (missed ? '' : ' The candidate has been told.');
        if (missed) errorMsg = 'The cancellation is recorded, but ' + missed + '. They may still turn up — contact them directly.';
      }
    } else if (action === 'mark_no_show') {
      const id = fd.get('id') as string;
      // NOT NOTIFIED, DELIBERATELY. "You did not attend" is an accusation, and this screen has no
      // field for the panel's side of it and no route for the candidate to answer back. It is an
      // internal record for the recruiter; the consequence reaches the candidate through the
      // application stage, which advanceStage() already announces.
      const changed = rowsOf(await db.execute(sql`
        UPDATE interview_rounds SET status='no_show', updated_at=NOW() WHERE id=${id} RETURNING id`));
      okMsg = changed.length ? 'Marked as no-show.' : '';
      if (!changed.length) errorMsg = 'Nothing was changed — that interview is no longer on this list. Reload the page.';
    } else if (action === 'mark_completed') {
      const id = fd.get('id') as string;
      const changed = rowsOf(await db.execute(sql`
        UPDATE interview_rounds SET status='completed', updated_at=NOW() WHERE id=${id} RETURNING id`));
      okMsg = changed.length ? 'Marked as completed. Please submit scorecard.' : '';
      if (!changed.length) errorMsg = 'Nothing was changed — that interview is no longer on this list. Reload the page.';
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the failed SQL.
    console.error('[interviews]', action, 'failed -', e?.cause?.message || e?.message);
    errorMsg = 'That did not go through: ' + (e?.cause?.message || e?.message || 'unknown error');
  }
}

const urlP = new URL(Astro.request.url);
const filter = urlP.searchParams.get('filter') || 'upcoming';

// A scorecard that could not be loaded sends the reason here rather than bouncing the interviewer
// back with no explanation. Kept apart from errorMsg so a POST on this page still owns that slot.
const arrivedWithError = (urlP.searchParams.get('err') || '').slice(0, 400);
if (arrivedWithError && !errorMsg) errorMsg = arrivedWithError;
if (urlP.searchParams.get('saved') === '1' && !okMsg) okMsg = 'Scorecard saved.';

// =================================================================================================
// "TODAY" IS THE COMPANY'S DAY, NOT THE SERVER'S
// =================================================================================================
//
// This read `DATE(ir.scheduled_at) = CURRENT_DATE`. Both halves are cut in the DATABASE SESSION's
// zone, and nothing in this codebase sets it — db/index.ts opens the pooled connection with no
// SET TIME ZONE, so it resolves to UTC while every interviewer and every candidate is in IST.
// Between 00:00 and 05:29 IST the Today tab therefore listed YESTERDAY's interviews and the Today
// tile counted them, on the screen a recruiter opens first thing in the morning. An 08:00 IST
// interview also falls on the previous UTC calendar day, so it went missing from Today entirely.
//
// Both sides are now converted to Asia/Kolkata before the date is taken.
const IST_TODAY = sql`(NOW() AT TIME ZONE 'Asia/Kolkata')::date`;

// A READ THAT COULD NOT RUN IS NOT AN EMPTY DIARY. Both queries below ended in `catch(e) {}`, so a
// pooler timeout or a renamed column drew "No upcoming interviews" and four confident zeros — the
// calmest state this page can be in and the most alarming one were the same screen. The failure is
// now logged with the Postgres cause (e.message is only the failed SQL) and said on the page.
let interviewsFailed = '';
let statsFailed = '';

let interviews: any[] = [];
try {
  let whereClause = sql`WHERE 1=1`;
  if (filter === 'upcoming') {
    whereClause = sql`WHERE ir.scheduled_at >= NOW() AND ir.status IN ('scheduled','rescheduled')`;
  } else if (filter === 'today') {
    whereClause = sql`WHERE (ir.scheduled_at AT TIME ZONE 'Asia/Kolkata')::date = ${IST_TODAY} AND ir.status IN ('scheduled','rescheduled')`;
  } else if (filter === 'completed') {
    whereClause = sql`WHERE ir.status = 'completed'`;
  } else if (filter === 'pending_feedback') {
    whereClause = sql`WHERE ir.status = 'pending_feedback'`;
  } else if (filter === 'cancelled') {
    whereClause = sql`WHERE ir.status IN ('cancelled','no_show')`;
  }

  const r = await db.execute(sql`
    SELECT ir.*,
      a.first_name, a.last_name, a.email as candidate_email, a.application_number, a.status as app_status,
      a.role_title_snapshot,
      (SELECT COUNT(*)::int FROM interview_scorecards WHERE interview_id = ir.id) as scorecard_count
    FROM interview_rounds ir
    LEFT JOIN applications a ON ir.application_id = a.id
    ${whereClause}
    ORDER BY ir.scheduled_at ASC NULLS LAST
    LIMIT 100
  `);
  interviews = Array.isArray(r) ? r : (r?.rows || []);
} catch (e: any) {
  console.error('[interviews] list', filter, e?.cause?.message || e?.message);
  interviewsFailed = 'The interview list could not be read, so nothing below is a statement about what is scheduled.';
}

let stats = { today: 0, upcoming: 0, pending: 0, completed: 0 };
try {
  const r = await db.execute(sql`
    SELECT
      (SELECT COUNT(*)::int FROM interview_rounds WHERE (scheduled_at AT TIME ZONE 'Asia/Kolkata')::date = ${IST_TODAY} AND status IN ('scheduled','rescheduled')) as today_count,
      (SELECT COUNT(*)::int FROM interview_rounds WHERE scheduled_at >= NOW() AND status IN ('scheduled','rescheduled')) as upcoming_count,
      (SELECT COUNT(*)::int FROM interview_rounds WHERE status='pending_feedback') as pending_count,
      (SELECT COUNT(*)::int FROM interview_rounds WHERE status='completed') as completed_count
  `);
  const rows = Array.isArray(r) ? r : (r?.rows || []);
  if (rows[0]) {
    stats.today = (rows[0] as any).today_count || 0;
    stats.upcoming = (rows[0] as any).upcoming_count || 0;
    stats.pending = (rows[0] as any).pending_count || 0;
    stats.completed = (rows[0] as any).completed_count || 0;
  }
} catch (e: any) {
  console.error('[interviews] counts', e?.cause?.message || e?.message);
  statsFailed = 'The counts on the tabs could not be read.';
}

const TYPE_COLORS: Record<string,string> = {
  screening:'#60a5fa', technical:'#a78bfa', culture_fit:'#10b981',
  case_study:'#fbbf24', final:'#FF4F00', reference_check:'#8b5cf6', custom:'#6b7280'
};
---
<AdminLayout title="Interviews" activeNav="hr">
<div style="padding-bottom:80px;">
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">Recruitment</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Interviews</h1>
      </div>
    </div>
    <div style="display:flex;gap:5px;overflow-x:auto;">
      {[['upcoming','Upcoming',stats.upcoming],['today','Today',stats.today],['pending_feedback','Pending Feedback',stats.pending],['completed','Completed',stats.completed],['cancelled','Cancelled',0]].map(([f,l,n]) => (
        <a href={`?filter=${f}`} style={`text-decoration:none;font-size:11px;font-weight:600;padding:6px 12px;border-radius:6px;white-space:nowrap;${filter===f?'background:#FF4F00;color:#fff;':'background:#15151a;color:#8a8a94;'}`}>{l}{(n as number)>0?` (${n})`:''}</a>
      ))}
    </div>
  </div>

  {errorMsg && <div style="margin:10px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {okMsg && <div style="margin:10px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}

  {(interviewsFailed || statsFailed) && (
    <div style="margin:10px 16px;background:rgba(251,146,60,0.10);border:1px solid rgba(251,146,60,0.32);color:#fdba74;border-radius:8px;padding:10px 14px;font-size:13px;line-height:1.6;">
      {interviewsFailed}{interviewsFailed && statsFailed ? ' ' : ''}{statsFailed} Nothing has been cancelled or moved &mdash; this is a read that did not answer. Reload, and if it persists check the server log.
    </div>
  )}

  <div style="padding:12px 16px;">
    {interviews.length === 0 && !interviewsFailed && (
      <div style="text-align:center;padding:40px;background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;color:#6e6e78;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6e6e78" stroke-width="1.5" style="margin-bottom:12px;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <p style="font-size:14px;font-weight:600;color:#fff;margin-bottom:4px;">No {filter} interviews</p>
        <p style="font-size:12px;">Schedule from any application page.</p>
      </div>
    )}

    <div style="display:flex;flex-direction:column;gap:8px;">
      {interviews.map((i: any) => {
        const tc = (TYPE_COLORS as any)[i.round_type] || '#6b7280';
        const scheduledLocal = i.scheduled_at ? new Date(i.scheduled_at).toISOString() : '';
        return (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
            <div style="padding:12px 14px;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
                <div style="flex:1;min-width:200px;">
                  <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap;">
                    <span style={`font-size:9px;font-weight:700;padding:2px 8px;border-radius:100px;background:${tc}22;color:${tc};text-transform:uppercase;`}>Round {i.round_number} - {i.round_type?.replace('_',' ')}</span>
                    <span style="font-size:9px;background:#15151a;color:#8a8a94;padding:2px 8px;border-radius:100px;">{i.status?.replace('_',' ')}</span>
                    {i.scorecard_count > 0 && <span style="font-size:9px;background:rgba(16,185,129,0.15);color:#6ee7b7;padding:2px 8px;border-radius:100px;">{i.scorecard_count} scorecard</span>}
                  </div>
                  <p style="font-size:14px;font-weight:700;color:#fff;margin:0 0 2px;">{i.first_name} {i.last_name}</p>
                  <p style="font-size:11px;color:#8a8a94;margin:0;">{i.application_number} - {i.role_title_snapshot}</p>
                  <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;">{i.candidate_email}</p>
                </div>
                <div style="text-align:right;flex-shrink:0;">
                  <p style="font-size:13px;font-weight:600;color:#fff;margin:0;" data-ts={scheduledLocal}>{i.scheduled_at || 'TBD'}</p>
                  <p style="font-size:10px;color:#6e6e78;margin:2px 0 0;">{i.duration_mins}min</p>
                </div>
              </div>
              <p style="font-size:13px;color:#d8d8de;margin:0 0 8px;">{i.title}</p>
              {i.notes && <p style="font-size:11px;color:#6e6e78;margin:0 0 8px;font-style:italic;">"{i.notes}"</p>}
              <div style="display:flex;gap:5px;flex-wrap:wrap;">
                {i.meeting_url && (i.status === 'scheduled' || i.status === 'rescheduled') && (
                  <a href={i.meeting_url} target="_blank" style="background:#10b981;border:none;color:#fff;font-size:11px;font-weight:600;padding:7px 12px;border-radius:6px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                    Join Room
                  </a>
                )}
                <a href={`/admin/applications/${i.application_id}`} style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;font-size:11px;padding:7px 12px;border-radius:6px;text-decoration:none;">View Application</a>
                {/* Patch 09. The interviewer's brief, capture and completion console. Additive: it
                    reads the same round this row already names and writes only its own tables. */}
                <a href={`/admin/interviews/${i.id}/intelligence`} style="background:#15151a;border:1px solid #1a1a1f;color:#FF7040;font-size:11px;padding:7px 12px;border-radius:6px;text-decoration:none;">Interview Intelligence</a>
                {(i.status === 'scheduled' || i.status === 'rescheduled') && (
                  <>
                    <form method="POST" style="display:inline;">
                      <input type="hidden" name="action" value="mark_completed"/>
                      <input type="hidden" name="id" value={i.id}/>
                      <button type="submit" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;font-size:11px;font-weight:600;padding:7px 12px;border-radius:6px;cursor:pointer;">Mark Completed</button>
                    </form>
                    <form method="POST" style="display:inline;" onsubmit="return confirm('Mark no-show?');">
                      <input type="hidden" name="action" value="mark_no_show"/>
                      <input type="hidden" name="id" value={i.id}/>
                      <button type="submit" style="background:#15151a;border:1px solid #1a1a1f;color:#fbbf24;font-size:11px;padding:7px 12px;border-radius:6px;cursor:pointer;">No-show</button>
                    </form>
                  </>
                )}
                {i.status === 'completed' && !i.scorecard_count && (
                  <a href={`/admin/interviews/${i.id}/scorecard`} style="background:#FF4F00;border:none;color:#fff;font-size:11px;font-weight:600;padding:7px 12px;border-radius:6px;text-decoration:none;">Submit Scorecard</a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
<script is:inline>
document.querySelectorAll('[data-ts]').forEach(function(el) {
  var ts = el.getAttribute('data-ts');
  if (!ts) return;
  var d = new Date(ts);
  el.textContent = d.toLocaleString(undefined, { weekday:'short', day:'numeric', month:'short', hour:'numeric', minute:'2-digit' });
});
</script>
</AdminLayout>
