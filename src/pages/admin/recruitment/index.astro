---
// /admin/recruitment — THE RECRUITMENT CONSOLE HUB.
//
// WHAT THIS IS AND IS NOT. It is not a second applicant tracking system. /admin/applications is the
// pipeline, /admin/roles is the catalogue, /admin/interviews is the schedule and /admin/offers is the
// paperwork; every one of them predates this page and none of them is duplicated here. This hub links
// the four things that were MISSING and now exist — the referral programme, the talent pool, the
// hiring-team feedback view, and the background-verification checklist — plus the surfaces they lead
// back into, so nobody has to know a URL to find them.
//
// THE GATE. `applications.view` opens the hub: it is the capability that already means "read the
// applicant pipeline", held by super_admin, hr, recruiter, reviewer and department_head. The referral
// card additionally asks `referrals.view`, so a role that holds one and not the other sees exactly
// what it may open. can() is used rather than hasPermission() because neither key may be spelled into
// existence by a hand-typed section row — see the note above the union in permissions.ts.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { referralCounts } from '@/lib/referrals';
import { poolCounts } from '@/lib/talent-pool';
import { listInterviewsForFeedback } from '@/lib/interview-feedback';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'applications.view')) return Astro.redirect('/admin?denied=applications');

const mayReferrals = can(user as any, 'applications.view') && can(user as any, 'referrals.view');

// Every const is declared before the template reads it. This page has no POST handler at all — it
// reads, and every action lives on the surface that owns it.
const referrals = mayReferrals ? await referralCounts(null) : null;
const pool = await poolCounts();
const feedback = await listInterviewsForFeedback('awaiting', 200);
const awaitingFeedback = feedback.interviews.length;
const interviewTablesMissing = feedback.tablesPresent === false;

const cardStyle = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px;display:block;text-decoration:none;';
---
<AdminLayout title="Recruitment" activeNav="applications">
<div style="padding:14px 16px 90px;max-width:1100px;margin:0 auto;">
  <p style="font-size:10.5px;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;font-family:'Geist Mono',monospace;font-weight:700;">Hiring</p>
  <h1 style="font-size:24px;color:#fff;margin:6px 0 4px;font-weight:700;">Recruitment</h1>
  <p style="font-size:13px;color:#9aa6b6;margin:0 0 20px;line-height:1.6;max-width:60ch;">
    The parts of hiring that sit around the pipeline: who your people recommend, who you said no to and
    should call back, what the interview panel actually thought, and what has been verified.
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;">

    {mayReferrals && (
      <a href="/admin/recruitment/referrals" style={cardStyle}>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF7040" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">Referral programme</p>
        </div>
        <p style="font-size:12px;color:#9aa6b6;margin:0 0 12px;line-height:1.55;">Referrals from employees, tracked against the application the candidate files. Rewards are recorded here and approved by the workflow engine, never paid from this screen.</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{referrals?.total ?? 0} total</span>
          <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{referrals?.linked ?? 0} applied</span>
          <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{referrals?.hired ?? 0} joined</span>
          {(referrals?.rewardsHalted ?? 0) > 0 && (
            <span style="font-size:11px;color:#fbbf24;font-family:'Geist Mono',monospace;">{referrals?.rewardsHalted} reward halted</span>
          )}
        </div>
      </a>
    )}

    <a href="/admin/recruitment/talent-pool" style={cardStyle}>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF7040" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">Talent pool</p>
      </div>
      <p style="font-size:12px;color:#9aa6b6;margin:0 0 12px;line-height:1.55;">Everyone you said no to, still searchable and still reopenable. A rejection is a decision about one moment, never a deletion.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{pool.total} in the pool</span>
        <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{pool.rejected} rejected</span>
        <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{pool.reopened} reopened</span>
      </div>
    </a>

    <a href="/admin/recruitment/feedback" style={cardStyle}>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF7040" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">Interview feedback</p>
      </div>
      <p style="font-size:12px;color:#9aa6b6;margin:0 0 12px;line-height:1.55;">Every interviewer's scorecard for a candidate, side by side, visible to the hiring team only. Panels are resolved from the Organization Graph, never from a job title.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        {interviewTablesMissing
          ? <span style="font-size:11px;color:#fbbf24;font-family:'Geist Mono',monospace;">Interview records unavailable</span>
          : <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">{awaitingFeedback} awaiting feedback</span>}
      </div>
    </a>

    <a href="/admin/hr/bgv" style={cardStyle}>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF7040" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <p style="font-size:14px;font-weight:700;color:#fff;margin:0;">Background verification</p>
      </div>
      <p style="font-size:12px;color:#9aa6b6;margin:0 0 12px;line-height:1.55;">Eight checks per candidate, each with a status and a link to the evidence behind it. Written consent is recorded before any check is run.</p>
      <span style="font-size:11px;color:#cfd6da;font-family:'Geist Mono',monospace;">Open the checklist</span>
    </a>
  </div>

  <h2 style="font-size:12px;color:#8a8a94;letter-spacing:0.1em;text-transform:uppercase;font-family:'Geist Mono',monospace;font-weight:700;margin:26px 0 10px;">The rest of hiring, where it already lives</h2>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/admin/applications" style="min-height:44px;display:inline-flex;align-items:center;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 16px;border-radius:8px;font-size:12.5px;text-decoration:none;">Applications</a>
    <a href="/admin/roles" style="min-height:44px;display:inline-flex;align-items:center;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 16px;border-radius:8px;font-size:12.5px;text-decoration:none;">Job roles</a>
    <a href="/admin/interviews" style="min-height:44px;display:inline-flex;align-items:center;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 16px;border-radius:8px;font-size:12.5px;text-decoration:none;">Interview schedule</a>
    <a href="/admin/offers" style="min-height:44px;display:inline-flex;align-items:center;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 16px;border-radius:8px;font-size:12.5px;text-decoration:none;">Offer letters</a>
    <a href="/admin/hr/requisitions" style="min-height:44px;display:inline-flex;align-items:center;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 16px;border-radius:8px;font-size:12.5px;text-decoration:none;">Requisitions</a>
  </div>

  <p style="font-size:11.5px;color:#8a8a94;margin:22px 0 0;line-height:1.6;max-width:70ch;">
    EduRankAI is the technology platform. Accredited partners award credentials; nothing on these screens
    confers a degree. Internships are unpaid unless a stipend is explicitly recorded on the role.
  </p>
</div>
</AdminLayout>
