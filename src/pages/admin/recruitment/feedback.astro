---
// /admin/recruitment/feedback — INTERVIEW FEEDBACK, FOR THE HIRING TEAM.
//
// THE GATE IS `applications.score`, which already means "record evaluations and scores against an
// application" and is held by super_admin, hr, recruiter, reviewer and department_head. That is the
// same population that reaches /admin/interviews today (middleware's `interviews` section plus the
// scorecard page's own gate), so this screen invents no capability and moves nobody in or out.
//
// A CANDIDATE NEVER REACHES IT. There is no applicant-facing route to anything on this page, and
// nothing here is echoed into the applicant portal, which shows a status and nothing else.
//
// WHAT IS NOT HERE: a second scorecard form. /admin/interviews/[id]/scorecard.astro already writes
// one card per interviewer, upserting on the unique index, and a second writer against one table is
// how two surfaces begin to disagree. This console links to it.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { listInterviewsForFeedback, recommendationLabel } from '@/lib/interview-feedback';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'applications.score')) return Astro.redirect('/admin?denied=interviews');

const params = Astro.url.searchParams;
const rawFilter = String(params.get('filter') || 'awaiting');
const filter: 'awaiting' | 'submitted' | 'all' =
  rawFilter === 'submitted' ? 'submitted' : rawFilter === 'all' ? 'all' : 'awaiting';

const result = await listInterviewsForFeedback(filter, 200);
const interviews = result.interviews;

const fmtWhen = (iso: string | null) =>
  iso ? new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not scheduled';

const TABS = [
  { key: 'awaiting', label: 'Awaiting feedback' },
  { key: 'submitted', label: 'Feedback in' },
  { key: 'all', label: 'All interviews' },
];
---
<AdminLayout title="Interview feedback" activeNav="applications">
<div style="padding:14px 16px 90px;max-width:1100px;margin:0 auto;">
  <a href="/admin/recruitment" style="font-size:11.5px;color:#6e6e78;text-decoration:none;display:inline-flex;align-items:center;gap:5px;min-height:44px;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    Recruitment
  </a>
  <h1 style="font-size:24px;color:#fff;margin:2px 0 4px;font-weight:700;">Interview feedback</h1>
  <p style="font-size:13px;color:#9aa6b6;margin:0 0 16px;line-height:1.6;max-width:66ch;">
    What each interviewer actually thought, in one place, for the hiring team only. A candidate never sees
    a scorecard, a reviewer comment or an internal note.
  </p>

  <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;">
    {TABS.map((t) => (
      <a href={'/admin/recruitment/feedback?filter=' + t.key}
         style={`min-height:44px;display:inline-flex;align-items:center;padding:0 16px;border-radius:100px;font-size:12.5px;text-decoration:none;border:1px solid ${filter === t.key ? '#FF4F00' : '#2a2a2f'};background:${filter === t.key ? 'rgba(255,79,0,0.14)' : '#15151a'};color:${filter === t.key ? '#FF7040' : '#cfd6da'};`}>
        {t.label}
      </a>
    ))}
  </div>

  {!result.tablesPresent ? (
    <div style="background:#0f0f14;border:1px solid rgba(251,191,36,0.32);border-radius:12px;padding:24px 20px;">
      <p style="font-size:14px;color:#fbbf24;margin:0 0 6px;font-weight:600;">Interview records are not available on this database</p>
      <p style="font-size:12.5px;color:#9aa6b6;margin:0;line-height:1.6;">
        The interview and scorecard tables were created by a hand-run migration that this repository does not
        carry, so they are not declared anywhere in the source and cannot be created from here without
        guessing their shape. Nothing has been assumed and no empty list is being passed off as "no interviews".
      </p>
      {result.error && <p style="font-size:11px;color:#6e6e78;margin:10px 0 0;font-family:'Geist Mono',monospace;overflow-wrap:anywhere;">{result.error}</p>}
    </div>
  ) : interviews.length === 0 ? (
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:40px 20px;text-align:center;">
      <p style="font-size:14px;color:#cfd6da;margin:0 0 6px;font-weight:600;">Nothing in this view</p>
      <p style="font-size:12.5px;color:#6e6e78;margin:0;line-height:1.6;">Interviews are scheduled from the application, and appear here the moment they exist.</p>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:8px;">
      {interviews.map((i) => (
        <a href={'/admin/recruitment/feedback/' + i.id}
           style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px 16px;text-decoration:none;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;min-height:44px;">
          <span style="flex:1 1 210px;min-width:0;">
            <span style="display:block;font-size:13.5px;color:#fff;font-weight:700;">{i.candidateName}</span>
            <span style="display:block;font-size:11px;color:#9aa6b6;">{i.roleTitle || 'No role recorded'} · Round {i.roundNumber}{i.roundType ? ' · ' + i.roundType.split('_').join(' ') : ''}</span>
          </span>
          <span style="flex:0 0 auto;font-size:11.5px;color:#cfd6da;font-family:'Geist Mono',monospace;">{fmtWhen(i.scheduledAt)}</span>
          <span style="flex:0 0 auto;display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
            <span style={`font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;background:${i.scorecardCount > 0 ? 'rgba(134,239,172,0.14)' : 'rgba(251,191,36,0.14)'};color:${i.scorecardCount > 0 ? '#86efac' : '#fbbf24'};`}>
              {i.scorecardCount} of {Math.max(i.panelCount, i.scorecardCount)} in
            </span>
            {i.finalRecommendation && (
              <span style="font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;background:rgba(207,214,218,0.12);color:#cfd6da;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;">{recommendationLabel(i.finalRecommendation)}</span>
            )}
          </span>
        </a>
      ))}
    </div>
  )}

  <p style="font-size:11.5px;color:#6e6e78;margin:22px 0 0;line-height:1.6;max-width:70ch;">
    Automated signals from proctoring and detection are advisory only. A human decides, and a scorecard is
    a person's judgement recorded in their own words.
  </p>
</div>
</AdminLayout>
