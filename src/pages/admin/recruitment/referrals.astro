---
// /admin/recruitment/referrals — THE REFERRAL PROGRAMME, FROM THE HIRING TEAM'S SIDE.
//
// TWO GATES, NOT ONE, BECAUSE THERE ARE TWO POWERS ON THIS PAGE.
//
//   referrals.view    opens it. Held by everyone who holds applications.view — the same five roles
//                     that already read a candidate's name, email and CV on /admin/applications.
//   referrals.reward  is required for BOTH write actions, and is re-checked inside the POST handler
//                     against the posted form rather than trusted from the render. A button hidden in
//                     the HTML is not an authorization check; the check below is.
//
// NOTHING ON THIS PAGE APPROVES OR PAYS A REWARD. "Send for approval" opens a workflow instance and
// stops. If the Organization Graph cannot name an approver the instance comes back HALTED with a
// sentence, and that sentence is printed on this screen exactly as the engine wrote it. There is no
// branch here that marks a reward approved, and no fallback that approves one when routing fails.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  listReferrals,
  referralCounts,
  linkReferralsToApplications,
  recordRewardEligibility,
  sendRewardForApproval,
  refreshRewardState,
  relationshipLabel,
  referralStateLabel,
  rewardStateLabel,
  REFERRAL_STATE_LABELS,
  REWARD_STATE_LABELS,
} from '@/lib/referrals';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'referrals.view')) return Astro.redirect('/admin?denied=referrals');

const mayReward = can(user as any, 'referrals.reward');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  const referralId = String(fd.get('referral_id') || '');

  if (!mayReward) {
    // Re-checked at the write, against the posted action, for every arm. Refused with a sentence.
    errMsg = 'You can see the referral programme but you may not price or submit a reward.';
  } else if (action === 'record_reward') {
    const result = await recordRewardEligibility({
      referralId,
      actorUserId: String(user.id),
      amount: Number(fd.get('amount') || 0),
      currency: String(fd.get('currency') || 'INR'),
      note: String(fd.get('reward_note') || ''),
    });
    if (result.ok) okMsg = result.message || 'Recorded.'; else errMsg = result.error;
  } else if (action === 'send_for_approval') {
    const result = await sendRewardForApproval(referralId, String(user.id));
    if (result.ok) okMsg = result.message || 'Sent for approval.'; else errMsg = result.error;
  } else if (action === 'refresh_reward') {
    const next = await refreshRewardState(referralId);
    okMsg = next ? 'Reward state re-read from the approval: ' + rewardStateLabel(next) + '.' : 'That reward could not be re-read.';
  } else {
    errMsg = 'That is not an action this page performs.';
  }
}

// ---- Reads. Every const declared before the template uses it. -------------------------------------
const params = Astro.url.searchParams;
const q = String(params.get('q') || '').trim().slice(0, 80);
const stateFilter = String(params.get('state') || '').trim();
const rewardFilter = String(params.get('reward') || '').trim();

// Attach referrals to the applications their candidates actually filed, before reading. Idempotent
// and forward-only; the count is reported rather than applied silently.
const linked = await linkReferralsToApplications();
const counts = await referralCounts(null);
const referrals = await listReferrals({ q: q || null, state: stateFilter || null, rewardState: rewardFilter || null });

const fmtDate = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
const money = (amount: number | null, currency: string | null) =>
  amount === null ? 'Not priced' : (currency || 'INR') + ' ' + amount.toLocaleString('en-IN');

function toneFor(rewardState: string): string {
  if (rewardState === 'approved') return '#86efac';
  if (rewardState === 'rejected') return '#fca5a5';
  if (rewardState === 'halted') return '#fbbf24';
  if (rewardState === 'in_approval') return '#67e8f9';
  if (rewardState === 'eligible') return '#cfd6da';
  return '#6e6e78';
}

const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:10px 12px;border-radius:8px;font-size:12.5px;min-height:44px;';
---
<AdminLayout title="Referral programme" activeNav="applications">
<div style="padding:14px 16px 90px;max-width:1100px;margin:0 auto;">
  <a href="/admin/recruitment" style="font-size:11.5px;color:#6e6e78;text-decoration:none;display:inline-flex;align-items:center;gap:5px;min-height:44px;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    Recruitment
  </a>
  <h1 style="font-size:24px;color:#fff;margin:2px 0 4px;font-weight:700;">Referral programme</h1>
  <p style="font-size:13px;color:#9aa6b6;margin:0 0 16px;line-height:1.6;max-width:66ch;">
    Referrals employees have made, tracked against the application the candidate actually filed. A reward
    recorded here is a note; the payment is decided by whoever the Organization Graph routes it to, and
    released in the payouts console by whoever holds that authority. Nothing is paid from this screen.
  </p>

  {okMsg && <div style="background:rgba(74,222,128,0.10);border:1px solid rgba(74,222,128,0.32);color:#86efac;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;line-height:1.55;">{okMsg}</div>}
  {errMsg && <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;line-height:1.55;">{errMsg}</div>}
  {linked > 0 && <div style="background:rgba(103,232,249,0.08);border:1px solid rgba(103,232,249,0.28);color:#67e8f9;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;">{linked} referral(s) matched to an application just now.</div>}

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:16px;">
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.total}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Referrals</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.waiting}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Not applied yet</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.hired}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Joined</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#67e8f9;margin:0;">{counts.rewardsWaiting}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Rewards in approval</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fbbf24;margin:0;">{counts.rewardsHalted}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Rewards halted</p>
    </div>
  </div>

  <form method="GET" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
    <input name="q" value={q} placeholder="Candidate or referrer" style={inputStyle + 'flex:1 1 200px;'} />
    <select name="state" style={inputStyle}>
      <option value="">Any referral state</option>
      {REFERRAL_STATE_LABELS.map((s) => <option value={s.key} selected={stateFilter === s.key}>{s.label}</option>)}
    </select>
    <select name="reward" style={inputStyle}>
      <option value="">Any reward state</option>
      {REWARD_STATE_LABELS.map((s) => <option value={s.key} selected={rewardFilter === s.key}>{s.label}</option>)}
    </select>
    <button type="submit" style="background:#FF4F00;color:#fff;border:none;padding:0 20px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Filter</button>
  </form>

  {referrals.length === 0 ? (
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:40px 20px;text-align:center;">
      <p style="font-size:14px;color:#cfd6da;margin:0 0 6px;font-weight:600;">No referrals yet</p>
      <p style="font-size:12.5px;color:#6e6e78;margin:0;line-height:1.6;">Employees submit referrals from their own workspace at /portal/employee/referrals. Nothing has been recorded here yet, and nothing has been assumed.</p>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:10px;">
      {referrals.map((r) => (
        <details style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;">
          <summary style="cursor:pointer;padding:14px 16px;list-style:none;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;min-height:44px;">
            <span style="flex:1 1 220px;min-width:0;">
              <span style="display:block;font-size:13.5px;color:#fff;font-weight:700;">{r.candidateName}</span>
              <span style="display:block;font-size:11px;color:#9aa6b6;font-family:'Geist Mono',monospace;overflow-wrap:anywhere;">{r.candidateEmail}</span>
            </span>
            <span style="flex:0 0 auto;font-size:11.5px;color:#cfd6da;">{r.roleTitle || 'No role named'}</span>
            <span style={`flex:0 0 auto;font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;font-family:'Geist Mono',monospace;letter-spacing:0.05em;text-transform:uppercase;background:${toneFor(r.rewardState)}22;color:${toneFor(r.rewardState)};`}>{rewardStateLabel(r.rewardState)}</span>
          </summary>

          <div style="border-top:1px solid #1a1a1f;padding:14px 16px;">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:14px;">
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Referred by</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;">{r.referrerName || 'An employee'}</p>
                <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">{relationshipLabel(r.relationship)}</p>
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Referral state</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;">{referralStateLabel(r.state)}</p>
                <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Recorded {fmtDate(r.createdAt)}</p>
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Application</p>
                {r.applicationId ? (
                  <a href={'/admin/applications/' + r.applicationId} style="font-size:12.5px;color:#FF7040;text-decoration:none;">{r.applicationNumber || 'Open the application'}</a>
                ) : (
                  <p style="font-size:12.5px;color:#9aa6b6;margin:0;">Not applied yet</p>
                )}
                {r.applicationStatus && <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;text-transform:capitalize;">{r.applicationStatus.split('_').join(' ')}</p>}
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">CV</p>
                {r.cvDriveUrl ? (
                  <a href={r.cvDriveUrl} target="_blank" rel="noopener noreferrer" style="font-size:12.5px;color:#FF7040;text-decoration:none;">Open the linked CV</a>
                ) : (
                  <p style="font-size:12.5px;color:#9aa6b6;margin:0;">No link given</p>
                )}
              </div>
            </div>

            {r.note && (
              <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:10px;padding:12px 14px;margin-bottom:14px;">
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 5px;">What the referrer said</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;line-height:1.6;white-space:pre-wrap;">{r.note}</p>
              </div>
            )}

            <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:10px;padding:14px;">
              <p style="font-size:11px;color:#fff;font-weight:700;margin:0 0 4px;">Reward</p>
              <p style="font-size:12px;color:#cfd6da;margin:0 0 4px;">{money(r.rewardAmount, r.rewardCurrency)} · {rewardStateLabel(r.rewardState)}</p>
              {r.rewardNote && <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 6px;line-height:1.55;">{r.rewardNote}</p>}
              {r.rewardHaltReason && (
                <p style="font-size:11.5px;color:#fbbf24;margin:0 0 8px;line-height:1.6;">Halted: {r.rewardHaltReason} Nothing has been approved.</p>
              )}

              {!mayReward ? (
                <p style="font-size:11.5px;color:#6e6e78;margin:8px 0 0;line-height:1.55;">You may read the programme. Pricing a reward and sending it for approval needs the referral reward permission.</p>
              ) : (
                <div style="display:flex;flex-direction:column;gap:10px;margin-top:10px;">
                  <form method="POST" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-start;">
                    <input type="hidden" name="action" value="record_reward" />
                    <input type="hidden" name="referral_id" value={r.id} />
                    <input name="amount" type="number" min="1" step="1" value={r.rewardAmount ?? ''} placeholder="Amount" required style={inputStyle + 'flex:0 1 130px;'} />
                    <input name="currency" value={r.rewardCurrency || 'INR'} maxlength="8" style={inputStyle + 'flex:0 1 90px;'} />
                    <input name="reward_note" value={r.rewardNote || ''} placeholder="Why this amount" style={inputStyle + 'flex:1 1 180px;'} />
                    <button type="submit" style="background:#15151a;border:1px solid #2a2a2f;color:#FF7040;padding:0 18px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Record as eligible</button>
                  </form>

                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <form method="POST">
                      <input type="hidden" name="action" value="send_for_approval" />
                      <input type="hidden" name="referral_id" value={r.id} />
                      <button type="submit" style="background:#FF4F00;color:#fff;border:none;padding:0 20px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Send for approval</button>
                    </form>
                    {r.workflowInstanceId && (
                      <form method="POST">
                        <input type="hidden" name="action" value="refresh_reward" />
                        <input type="hidden" name="referral_id" value={r.id} />
                        <button type="submit" style="background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;padding:0 18px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Re-read the approval</button>
                      </form>
                    )}
                    {r.workflowInstanceId && (
                      <a href="/admin/hr/leave/workflow" style="display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:8px;background:#15151a;border:1px solid #2a2a2f;color:#cfd6da;font-size:12.5px;text-decoration:none;">Open the approvals queue</a>
                    )}
                  </div>
                  <p style="font-size:11px;color:#6e6e78;margin:0;line-height:1.55;">Sending for approval routes the request to the people the Organization Graph names for this referrer. It does not approve it and it does not pay it.</p>
                </div>
              )}
            </div>
          </div>
        </details>
      ))}
    </div>
  )}
</div>
</AdminLayout>
