---
// /admin/recruitment/talent-pool — REJECTED IS NOT DELETED.
//
// THE GATES, AND WHY THEY ARE THE ONES THAT ALREADY EXIST:
//   applications.view  opens the screen. Reading a rejected candidate is reading an application, and
//                      that is exactly what this key means. No new capability was invented for it.
//   applications.edit  is required to CURATE (tag) and to REOPEN, because both write the application
//                      record. Re-checked inside the POST handler against the posted action rather
//                      than trusted from the render — a hidden button is not an authorization check.
//
// WHAT A REOPEN ACTUALLY DOES is in src/lib/talent-pool.ts and not repeated here: status back to
// under review, out of archive and out of trash, and the stage moved through the EXISTING funnel
// engine so the candidate's stage history stays continuous. They do not re-apply.
//
// THE CANDIDATE NEVER SEES THIS SCREEN. Pool tags, curator reasons and pool notes are internal. What
// an applicant sees remains their status and nothing else.
//
// NO NATIONALITY OR COUNTRY FILTER EXISTS HERE, and none may be added.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { searchPool, poolCounts, curateCandidate, reopenCandidate, POOL_FILTERS, POOL_TAGS, tagLabel } from '@/lib/talent-pool';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user as any, 'applications.view')) return Astro.redirect('/admin?denied=applications');

const mayEdit = can(user as any, 'applications.edit');
const actorName = String((user as any)?.name || 'Admin');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  const applicationId = String(fd.get('application_id') || '');

  if (!mayEdit) {
    errMsg = 'You can search the pool but you may not change or reopen a candidate.';
  } else if (action === 'curate') {
    const tags = fd.getAll('tags').map((t) => String(t));
    const result = await curateCandidate({
      applicationId,
      tags,
      reason: String(fd.get('reason') || ''),
      actorUserId: String(user.id),
      actorName,
    });
    if (result.ok) okMsg = result.message || 'Saved.'; else errMsg = result.error;
  } else if (action === 'reopen') {
    const result = await reopenCandidate({
      applicationId,
      actorUserId: String(user.id),
      actorName,
      note: String(fd.get('note') || ''),
    });
    if (result.ok) okMsg = result.message || 'Reopened.'; else errMsg = result.error;
  } else {
    errMsg = 'That is not an action this page performs.';
  }
}

// ---- Reads. Declared before the template. ----------------------------------------------------
const params = Astro.url.searchParams;
const q = String(params.get('q') || '').trim().slice(0, 80);
const active = params.getAll('f').map((f) => String(f));
const counts = await poolCounts();
const candidates = await searchPool({ q: q || null, filters: active });

const fmtDate = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');

// A filter chip's href: the current query with this filter toggled. Built as a function so the
// template does not construct URLs inline, and so there is one definition of "toggle".
function chipHref(key: string): string {
  const sp = new URLSearchParams();
  if (q) sp.set('q', q);
  const next = active.includes(key) ? active.filter((f) => f !== key) : active.concat([key]);
  for (const f of next) sp.append('f', f);
  const qs = sp.toString();
  return '/admin/recruitment/talent-pool' + (qs ? '?' + qs : '');
}

const inputStyle = 'background:#08080a;border:1px solid #2a2a2f;color:#fff;padding:10px 12px;border-radius:8px;font-size:12.5px;min-height:44px;';
---
<AdminLayout title="Talent pool" activeNav="applications">
<div style="padding:14px 16px 90px;max-width:1100px;margin:0 auto;">
  <a href="/admin/recruitment" style="font-size:11.5px;color:#6e6e78;text-decoration:none;display:inline-flex;align-items:center;gap:5px;min-height:44px;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    Recruitment
  </a>
  <h1 style="font-size:24px;color:#fff;margin:2px 0 4px;font-weight:700;">Talent pool</h1>
  <p style="font-size:13px;color:#9aa6b6;margin:0 0 16px;line-height:1.6;max-width:66ch;">
    Everyone who was rejected or archived stays here, searchable and reopenable. A rejection is a decision
    about one moment, not a deletion of a person, so nothing on this screen removes anybody.
  </p>

  {okMsg && <div style="background:rgba(74,222,128,0.10);border:1px solid rgba(74,222,128,0.32);color:#86efac;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;line-height:1.55;">{okMsg}</div>}
  {errMsg && <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.32);color:#fca5a5;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;line-height:1.55;">{errMsg}</div>}

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:16px;">
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.total}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">In the pool</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.rejected}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Rejected</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.archived}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Archived</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#86efac;margin:0;">{counts.reopened}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Reopened</p>
    </div>
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px 14px;">
      <p style="font-size:22px;font-weight:700;color:#fff;margin:0;">{counts.curated}</p>
      <p style="font-size:11px;color:#9aa6b6;margin:2px 0 0;">Tagged</p>
    </div>
  </div>

  <form method="GET" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
    <input name="q" value={q} placeholder="Name, email, application number or role" style={inputStyle + 'flex:1 1 220px;'} />
    {active.map((f) => <input type="hidden" name="f" value={f} />)}
    <button type="submit" style="background:#FF4F00;color:#fff;border:none;padding:0 20px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Search</button>
  </form>

  <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:6px;">
    {POOL_FILTERS.map((f) => (
      <a href={chipHref(f.key)}
         style={`min-height:44px;display:inline-flex;align-items:center;padding:0 14px;border-radius:100px;font-size:12px;text-decoration:none;border:1px solid ${active.includes(f.key) ? '#FF4F00' : '#2a2a2f'};background:${active.includes(f.key) ? 'rgba(255,79,0,0.14)' : '#15151a'};color:${active.includes(f.key) ? '#FF7040' : '#cfd6da'};`}>
        {f.label}
      </a>
    ))}
  </div>
  <p style="font-size:11px;color:#6e6e78;margin:0 0 18px;line-height:1.6;max-width:70ch;">
    The first four filters are read from the application itself. The last five are judgements somebody
    recorded. Selecting more than one narrows the list to candidates who satisfy all of them.
  </p>

  {candidates.length === 0 ? (
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:40px 20px;text-align:center;">
      <p style="font-size:14px;color:#cfd6da;margin:0 0 6px;font-weight:600;">Nobody matches</p>
      <p style="font-size:12.5px;color:#6e6e78;margin:0;line-height:1.6;">Candidates arrive in the pool when an application is rejected or archived, or when somebody tags them. Nothing has been hidden and nothing has been deleted.</p>
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:10px;">
      {candidates.map((c) => (
        <details style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;">
          <summary style="cursor:pointer;padding:14px 16px;list-style:none;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;min-height:44px;">
            <span style="flex:1 1 220px;min-width:0;">
              <span style="display:block;font-size:13.5px;color:#fff;font-weight:700;">{c.firstName} {c.lastName}</span>
              <span style="display:block;font-size:11px;color:#9aa6b6;font-family:'Geist Mono',monospace;overflow-wrap:anywhere;">{c.email}</span>
            </span>
            <span style="flex:0 0 auto;font-size:11.5px;color:#cfd6da;">{c.roleTitle || 'No role recorded'}</span>
            <span style="flex:0 0 auto;display:flex;gap:5px;flex-wrap:wrap;">
              {c.status === 'rejected' && <span style="font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;background:rgba(252,165,165,0.14);color:#fca5a5;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;">Rejected</span>}
              {c.isArchived && <span style="font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;background:rgba(154,166,182,0.14);color:#9aa6b6;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;">Archived</span>}
              {c.reopenedAt && <span style="font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;background:rgba(134,239,172,0.14);color:#86efac;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;">Reopened</span>}
              {c.applicationCount > 1 && <span style="font-size:10px;font-weight:700;padding:4px 9px;border-radius:100px;background:rgba(103,232,249,0.14);color:#67e8f9;font-family:'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.05em;">{c.applicationCount} applications</span>}
            </span>
          </summary>

          <div style="border-top:1px solid #1a1a1f;padding:14px 16px;">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-bottom:14px;">
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Application</p>
                <a href={'/admin/applications/' + c.applicationId} style="font-size:12.5px;color:#FF7040;text-decoration:none;">{c.applicationNumber || 'Open the application'}</a>
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Applied</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;">{fmtDate(c.createdAt)}</p>
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Department</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;">{c.department || 'Not recorded'}</p>
              </div>
              <div>
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 3px;">Tags</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;">{c.tags.length ? c.tags.map(tagLabel).join(', ') : 'None recorded'}</p>
              </div>
            </div>

            {c.reason && (
              <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:10px;padding:12px 14px;margin-bottom:14px;">
                <p style="font-size:10px;color:#6e6e78;letter-spacing:0.09em;text-transform:uppercase;font-family:'Geist Mono',monospace;margin:0 0 5px;">Why they are in the pool (internal)</p>
                <p style="font-size:12.5px;color:#cfd6da;margin:0;line-height:1.6;white-space:pre-wrap;">{c.reason}</p>
              </div>
            )}

            {!mayEdit ? (
              <p style="font-size:11.5px;color:#6e6e78;margin:0;line-height:1.55;">You may search the pool. Tagging a candidate and reopening one need the application edit permission.</p>
            ) : (
              <div style="display:flex;flex-direction:column;gap:14px;">
                <form method="POST" style="background:#08080a;border:1px solid #1a1a1f;border-radius:10px;padding:14px;">
                  <input type="hidden" name="action" value="curate" />
                  <input type="hidden" name="application_id" value={c.applicationId} />
                  <p style="font-size:11px;color:#fff;font-weight:700;margin:0 0 8px;">Tag this candidate</p>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;">
                    {POOL_TAGS.map((t) => (
                      <label style="display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:0 12px;border:1px solid #2a2a2f;border-radius:8px;font-size:12px;color:#cfd6da;cursor:pointer;">
                        <input type="checkbox" name="tags" value={t.key} checked={c.tags.includes(t.key)} style="accent-color:#FF4F00;width:16px;height:16px;" />
                        {t.label}
                      </label>
                    ))}
                  </div>
                  <input name="reason" value={c.reason || ''} placeholder="Why keep them (internal, never shown to the candidate)" style={inputStyle + 'width:100%;margin-bottom:10px;'} />
                  <button type="submit" style="background:#15151a;border:1px solid #2a2a2f;color:#FF7040;padding:0 18px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Save tags</button>
                </form>

                <form method="POST" style="background:#08080a;border:1px solid #1a1a1f;border-radius:10px;padding:14px;">
                  <input type="hidden" name="action" value="reopen" />
                  <input type="hidden" name="application_id" value={c.applicationId} />
                  <p style="font-size:11px;color:#fff;font-weight:700;margin:0 0 4px;">Reopen into the pipeline</p>
                  <p style="font-size:11.5px;color:#9aa6b6;margin:0 0 10px;line-height:1.6;">Puts them back under review at the review stage, out of archive, without asking them to apply again. They stay in the pool, marked reopened.</p>
                  <input name="note" placeholder="Why now (recorded on the stage history)" style={inputStyle + 'width:100%;margin-bottom:10px;'} />
                  <button type="submit" style="background:#FF4F00;color:#fff;border:none;padding:0 20px;min-height:44px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;">Reopen this candidate</button>
                </form>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  )}
</div>
</AdminLayout>
