---
// /admin/projects/roadmap — THE PORTFOLIO ON ONE TIME AXIS.
//
// WHAT IT ANSWERS that the list cannot: what overlaps what, what lands in the same fortnight, and
// what has no dates at all. A table of target dates makes you hold twenty rows in your head; a
// timeline puts them side by side.
//
// INLINE SVG, NO CHARTING LIBRARY, AND ONE RENDERING FOR EVERY WIDTH. Each bar sits UNDER its own
// label on a full-width track, so this is a Gantt on a laptop and a readable dated list on a 360px
// phone, from the same markup and the same numbers. There is no second mobile chart to fall out of
// step, and the page never scrolls sideways.
//
// UNDATED PROJECTS ARE DRAWN, NOT DROPPED. A project with no start and no target is shown in grey
// across the whole window, labelled as having no dates. Leaving it out would make the roadmap look
// complete while hiding exactly the work nobody has scheduled — which is what a roadmap is read to
// find.
//
// THE GATE AND THE SCOPE are the same as the portfolio list: the `projects` section or the
// `projects.view` capability to open it, and listProjects() decides in the WHERE clause which rows
// this account may see. Nothing is hidden with CSS.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { canAccessSection } from '@/lib/auth/permissions';
import { holdsCapability } from '@/lib/auth/capability';
import {
  listProjects,
  buildTimeline,
  departmentOptions,
  projectStatusLabel,
  PROJECT_STATUSES,
  GRAPH_NOT_READY,
  type Project,
} from '@/lib/projects';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const bySection = await canAccessSection(user as any, 'projects', 'view');
const byCapability = holdsCapability(user as any, 'projects.view');
if (!bySection && !byCapability) return Astro.redirect('/admin');

// CONSTANTS FIRST — `const` is not hoisted, and a const declared under the code that reads it throws
// on that code's first line while the page still reports success.
const fmt = (d: string | null) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

/** Plain words from a function — a typed map indexed inside JSX is a known .astro parse hazard. */
function barFill(p: Project | undefined, undated: boolean): string {
  if (undated || !p) return '#e0d6c4';
  if (p.isOverdue) return '#b91c1c';
  if (p.status === 'completed') return '#0f766e';
  if (p.status === 'on_hold') return '#a16207';
  if (p.status === 'cancelled' || p.status === 'archived') return '#9a8f7d';
  return '#c2410c';
}

const filterStatus = Astro.url.searchParams.get('status') || '';
const filterDept = Astro.url.searchParams.get('department') || '';
const from = Astro.url.searchParams.get('from') || '';
const to = Astro.url.searchParams.get('to') || '';

const view = await listProjects(user as any, {
  status: filterStatus,
  departmentId: filterDept,
  includeClosed: true,
  limit: 300,
});

const departments = await departmentOptions();

const timeline = buildTimeline(
  view.projects.map((p) => ({
    id: p.id,
    label: p.code + ' ' + p.name,
    sublabel: p.statusLabel,
    startOn: p.startOn,
    endOn: p.targetOn,
    status: p.status,
    overdue: p.isOverdue,
  })),
  { from: from || null, to: to || null },
);

const undatedCount = timeline.bars.filter((b) => b.undated).length;
---
<AdminLayout title="Project roadmap" activeNav="projects-roadmap">
  <div class="pwrap">
    {!view.ok && (
      <div class="bad">
        <strong>The roadmap could not be read just now.</strong>
        <p>Nothing is lost and nothing has changed. This is a failed read, not a statement that there
        is nothing scheduled.</p>
      </div>
    )}

    {view.ok && !view.graphReady && (
      <div class="warn">
        <strong>Organization Graph not yet initialized.</strong>
        <p>{GRAPH_NOT_READY}</p>
      </div>
    )}

    <div class="card">
      <form method="GET" class="filters">
        <div>
          <label for="f-status">Status</label>
          <select id="f-status" name="status">
            <option value="">Every status</option>
            {PROJECT_STATUSES.map((s) => (<option value={s} selected={s === filterStatus}>{projectStatusLabel(s)}</option>))}
          </select>
        </div>
        <div>
          <label for="f-dept">Department</label>
          <select id="f-dept" name="department">
            <option value="">Every department</option>
            {departments.map((d) => (<option value={d.id} selected={d.id === filterDept}>{d.name}</option>))}
          </select>
        </div>
        <div>
          <label for="f-from">Window from</label>
          <input id="f-from" type="date" name="from" value={from}/>
        </div>
        <div>
          <label for="f-to">Window to</label>
          <input id="f-to" type="date" name="to" value={to}/>
        </div>
        <button class="btn btn-thin" type="submit">Apply</button>
      </form>
      <p class="note">
        Leave the window empty and it is worked out from the projects themselves, first start to last
        target. A window narrower than the work does not hide anything: a bar that runs past either edge
        is clipped to it, and its real dates are printed under its name.
      </p>
    </div>

    <div class="card">
      <h3>Roadmap — {timeline.from} to {timeline.to}</h3>
      {view.ok && view.projects.length === 0 && (
        <p class="empty">No project matches that filter, so there is nothing to draw.</p>
      )}
      {view.projects.length > 0 && (
        <div class="tl">
          <div class="tl-axis">
            {timeline.ticks.map((t) => (<span style={'left:' + t.leftPct + '%;'}>{t.label}</span>))}
          </div>
          <div class="tl-body">
            {timeline.todayPct !== null && (<div class="tl-today" style={'left:' + timeline.todayPct + '%;'}></div>)}
            {timeline.bars.map((b) => {
              const project = view.projects.find((p) => p.id === b.id);
              return (
                <div class="tl-row">
                  <div class="tl-name">
                    <a href={'/admin/projects/' + b.id}>{b.label}</a>
                    {project && <span class="tl-status"> {projectStatusLabel(project.status)}</span>}
                  </div>
                  <div class="tl-dates">
                    {b.undated
                      ? 'No dates recorded'
                      : (fmt(b.startOn) || 'no start') + ' to ' + (fmt(b.endOn) || 'no target')}
                    {project && project.milestoneCount > 0
                      ? ' | ' + project.milestonesMet + ' of ' + project.milestoneCount + ' milestones met'
                      : ''}
                  </div>
                  <svg class="tl-track" width="100%" height="14" role="img"
                       aria-label={b.label + ': ' + (b.undated ? 'no dates recorded' : (b.startOn || 'no start') + ' to ' + (b.endOn || 'no target'))}>
                    <rect x={b.leftPct + '%'} y="2" width={b.widthPct + '%'} height="10" rx="5"
                          fill={barFill(project, b.undated)} opacity={b.undated ? '0.75' : '1'}></rect>
                  </svg>
                </div>
              );
            })}
          </div>
        </div>
      )}
      <p class="note">
        The vertical line is today. Red is past its target date, teal is finished, amber is on hold and
        grey has no dates recorded.
        {undatedCount > 0
          ? ' ' + undatedCount + ' project' + (undatedCount === 1 ? ' has' : 's have') +
            ' no dates at all and are drawn across the whole window rather than left off.'
          : ''}
      </p>
    </div>
  </div>

  <style>
    /* MOBILE FIRST. The label sits ABOVE its own full-width track, so this reads as a dated list at
       360px and as a Gantt on a laptop — one rendering, and no page-level horizontal scroll. */
    .pwrap{max-width:1100px;margin:0 auto;padding:4px 0 40px;}
    .card{background:#fff;border:1px solid #ece4d6;border-radius:14px;padding:16px;margin-bottom:14px;}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#9a8f7d;font-weight:700;margin:0 0 12px;}
    label{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:#9a8f7d;font-weight:700;display:block;margin:0 0 4px;}
    input,select{width:100%;background:#faf7f1;border:1px solid #e6ddcd;border-radius:9px;padding:11px 12px;font-size:15px;font-family:inherit;color:#1a1510;outline:none;min-height:44px;}
    .filters{display:grid;grid-template-columns:1fr;gap:10px;align-items:end;}
    .btn{background:#c2410c;color:#fff;border:none;border-radius:10px;padding:0 18px;min-height:44px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;width:100%;}
    .btn-thin{background:transparent;border:1px solid #e0d6c4;color:#6b6255;}
    .bad{background:rgba(220,38,38,.07);border:1px solid rgba(220,38,38,.3);color:#8a1c1c;border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:12px;line-height:1.55;overflow-wrap:anywhere;}
    .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.32);color:#7c4a03;border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:12px;line-height:1.55;overflow-wrap:anywhere;}
    .warn p,.bad p{margin-top:6px;}
    .tl{position:relative;}
    .tl-axis{position:relative;height:16px;margin-bottom:6px;}
    .tl-axis span{position:absolute;top:0;transform:translateX(-50%);font-family:'JetBrains Mono',monospace;font-size:9px;color:#b3a894;white-space:nowrap;}
    .tl-body{position:relative;}
    .tl-today{position:absolute;top:0;bottom:0;width:1px;background:rgba(194,65,12,.5);z-index:1;}
    .tl-row{position:relative;padding:8px 0;border-bottom:1px solid #f6f1e7;z-index:2;}
    .tl-row:last-child{border-bottom:none;}
    .tl-name{font-size:13.5px;font-weight:600;overflow-wrap:anywhere;line-height:1.4;}
    .tl-name a{color:#1a1510;text-decoration:none;}
    .tl-name a:hover{color:#c2410c;}
    .tl-status{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:#9a8f7d;text-transform:uppercase;letter-spacing:.08em;}
    .tl-dates{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:#9a8f7d;margin:2px 0 4px;overflow-wrap:anywhere;}
    .tl-track{display:block;width:100%;height:14px;background:#faf7f1;border-radius:7px;}
    .empty{font-size:13.5px;color:#6b6255;line-height:1.55;}
    .note{font-size:12px;color:#9a8f7d;line-height:1.55;margin-top:10px;overflow-wrap:anywhere;}
    @media (min-width:760px){
      .filters{grid-template-columns:1fr 1fr 1fr 1fr auto;}
      .btn{width:auto;}
    }
  </style>
</AdminLayout>
