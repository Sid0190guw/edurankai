---
import AdminLayout from '@/layouts/AdminLayout.astro';
import TwoFactorPanel from '@/components/security/TwoFactorPanel.astro';
import { isTotpEnabled, countUnusedBackupCodes } from '@/lib/auth/twofactor';
import { listPasskeys } from '@/lib/auth/webauthn';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

let enabled = false;
let backupRemaining = 0;
let passkeys: any[] = [];
// DID THE READ RUN? This was `catch (_) {}`, and the defaults above are the answer "you have no
// second factor and no passkeys". So a pooler timeout drew "Two-factor authentication: Off" with a
// "Set up authenticator" button and "Fingerprint & passkeys: None" for an ADMINISTRATOR who has both
// - the one wrong answer a security screen must not give, because it invites the reader either to
// conclude the console is unprotected or to re-enrol over a working factor. src/pages/portal/
// security.astro was repaired for exactly this and the admin half was left behind; the same flag,
// the same banner, and the panel is not drawn at all over a failed read.
let securityOk = true;
try {
  enabled = await isTotpEnabled(user.id);
  if (enabled) backupRemaining = await countUnusedBackupCodes(user.id);
  passkeys = await listPasskeys(user.id);
} catch (e: any) {
  securityOk = false;
  // The real Postgres reason is on e.cause; e.message is only the failed SQL.
  console.error('[admin/security]', e?.cause?.message || e?.message);
}
const accountLabel = user.email || (user as any).internalHandle || user.name || '';
---
<AdminLayout title="Security">
  <div style="max-width:640px;">
    <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#DC5000;margin:0 0 8px;">Account security</p>
    <h1 style="font-size:26px;font-weight:700;color:#111;margin:0 0 6px;">Two-factor authentication</h1>
    <p style="font-size:14px;color:#6b7280;margin:0 0 24px;line-height:1.6;">A second step at sign-in protects admin access even if a password leaks. This is in addition to any face-recognition step already on your account.</p>

    {!securityOk && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.28);border-radius:10px;padding:12px 14px;margin:0 0 18px;">
        <p style="font-size:13.5px;color:#991b1b;margin:0 0 4px;font-weight:600;">We could not read your security settings.</p>
        <p style="font-size:13px;color:#7f1d1d;margin:0;line-height:1.55;">Nothing about your account has changed, and what would have been shown below is NOT your current setup. Reload in a moment before turning anything on or off.</p>
      </div>
    )}

    {securityOk && (
      <TwoFactorPanel enabled={enabled} backupRemaining={backupRemaining} accountLabel={accountLabel} passkeys={passkeys} />
    )}
  </div>
</AdminLayout>
