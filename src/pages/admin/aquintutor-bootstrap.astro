---
// /admin/aquintutor-bootstrap — create the FIRST AquinTutor super admin, once, and never again.
//
// =================================================================================================
// WHY THIS IS A BOOTSTRAP AND NOT THE BRIDGE THE ARCHITECTURE FORBIDS
// =================================================================================================
//
// docs/aquintutor-independence.md says an EduRankAI account carries no authority on AquinTutor. This
// page appears to break that rule, so the distinction has to be exact:
//
//   A BRIDGE is standing. It says "whoever administers EduRankAI administers AquinTutor", and it
//   keeps saying it — so the two products can never be separated, because one is permanently
//   deriving its authority from the other.
//
//   A BOOTSTRAP is a single act that DISABLES ITSELF. It exists because a system whose only
//   role-granting authority is a super admin cannot create its first super admin, and something has
//   to break that circle. The moment one exists, this page grants nothing to anybody ever again —
//   including to the EduRankAI account that used it.
//
// After it has run, removing EduRankAI entirely would not affect who administers AquinTutor. That is
// the test of whether a dependency is real, and this one does not pass it in the wrong direction.
//
// The alternatives were considered and are worse: a secret in an environment variable (the founder
// cannot read Vercel runtime logs to retrieve one, which was established while diagnosing
// /admin/rbac), or seeding a known password in a migration (a credential in the repository).
//
// const BEFORE THE HANDLER — `const` is not hoisted, and that has taken pages down here.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { aquinStore } from '@/lib/aquin/store';
import { createAccount } from '@/lib/aquin/identity';
import { AQUIN_TABLES } from '@/lib/aquin/schema';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=/admin/aquintutor-bootstrap');
// Creating the founding administrator of another product is a platform-configuration act, and
// `settings.edit` is the key that governs those. A capability outside the union answers false for
// EVERY role including super_admin, so this is the checked one rather than an assumed one.
if (!can(user as any, 'settings.edit')) return Astro.redirect('/admin?denied=settings');

let errorMsg = '';
let successMsg = '';
let schemaError = '';
let missingTables: string[] = [];
let superAdmins = -1;      // -1 means "not known", which is different from 0
let createdEmail = '';

async function refresh(): Promise<void> {
  try {
    const store = await aquinStore();
    await store.ensureSchema();
    const present = await store.presentTables();
    // VERIFIED AGAINST THE DATABASE, not inferred from ensureSchema() returning. This project has
    // shipped a bootstrap reporting ran:8 failed:0 while ten tables were missing.
    missingTables = AQUIN_TABLES.filter((t) => !present.includes(t));
    superAdmins = missingTables.length ? -1 : await store.countRole('super_admin');
  } catch (e: any) {
    schemaError = e?.cause?.message || e?.message || 'unknown error';
    console.error('[aquintutor-bootstrap] schema check failed:', schemaError);
  }
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData().catch(() => null);
  const email = String(fd?.get('email') || '').trim();
  const name = String(fd?.get('name') || '').trim();
  const password = String(fd?.get('password') || '');
  const confirm = String(fd?.get('confirm') || '');

  await refresh();

  if (schemaError) {
    errorMsg = 'The AquinTutor tables could not be prepared, so nothing was created. The database said: ' + schemaError;
  } else if (missingTables.length) {
    errorMsg = 'These AquinTutor tables are still missing, so nothing was created: ' + missingTables.join(', ') + '.';
  } else if (superAdmins > 0) {
    // The self-disabling half. Checked again HERE rather than trusting the render above, because
    // between drawing the form and submitting it somebody else may have run this.
    errorMsg = 'An AquinTutor super admin already exists, so this page will not create another. Further administrators are granted from inside AquinTutor by an existing super admin.';
  } else if (password !== confirm) {
    errorMsg = 'The two passwords do not match. Nothing was created.';
  } else {
    try {
      const store = await aquinStore();
      const made = await createAccount(store, { email, name, password });
      if (!made.ok) {
        errorMsg = made.error || 'That account could not be created.';
      } else {
        // createAccount refuses every admin-surface role by design, so the founding grant is made
        // directly against the store. This is the one place in the product that may do that, and it
        // is why this page can only run once.
        await store.assignRole(made.userId!, 'super_admin', null);
        await store.audit({
          actorId: null,
          action: 'aquin.bootstrap',
          subject: made.userId!,
          detail: { email, byEduRankAiUser: String(user.id), byEduRankAiEmail: (user as any).email || '' },
          host: Astro.request.headers.get('host'),
          ip: Astro.clientAddress || null,
        });
        createdEmail = email;
        successMsg = 'Created. This page will not create another.';
      }
    } catch (e: any) {
      const why = e?.cause?.message || e?.message || 'unknown error';
      console.error('[aquintutor-bootstrap] creation failed:', why);
      errorMsg = 'That account could not be created. The database said: ' + why;
    }
  }
}

await refresh();
const done = superAdmins > 0;

const CARD = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:18px 20px;margin-bottom:16px;max-width:680px;';
const LBL = 'display:block;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:#8a8a94;margin-bottom:6px;';
const INP = 'width:100%;padding:9px 12px;background:#15151a;border:1px solid #26262c;border-radius:8px;color:#fff;font-size:14px;';
---

<AdminLayout title="AquinTutor bootstrap" activeNav="settings">
  <div style="max-width:720px;margin:0 auto;padding:24px;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">AquinTutor</p>
    <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 8px;">The first super admin</h1>
    <p style="font-size:13px;color:#8a8a94;line-height:1.6;margin:0 0 20px;">
      AquinTutor has its own accounts, separate from EduRankAI. Only a super admin can grant
      administrative roles there &mdash; which means the first one cannot be granted from inside.
      This page breaks that circle exactly once and then refuses forever, so nothing here becomes a
      standing route from EduRankAI authority into AquinTutor.
    </p>

    {successMsg !== '' && (
      <div style={CARD + 'border-color:rgba(0,150,70,0.45);'}>
        <p style="margin:0 0 6px;color:#7dd3a8;font-weight:700;font-size:14px;">{successMsg}</p>
        <p style="margin:0;color:#cfd6da;font-size:13px;line-height:1.6;">
          <strong>{createdEmail}</strong> is now the AquinTutor super admin. Sign in at
          <a href="/aquintutor/admin/login" style="color:#FF7040;"> /aquintutor/admin/login</a> &mdash;
          with that password, not your EduRankAI one. Every further administrator is granted from
          inside AquinTutor.
        </p>
      </div>
    )}

    {errorMsg !== '' && (
      <div style={CARD + 'border-color:rgba(248,113,113,0.45);'}>
        <p style="margin:0;color:#fca5a5;font-size:13.5px;line-height:1.6;">{errorMsg}</p>
      </div>
    )}

    {schemaError !== '' && successMsg === '' && (
      <div style={CARD + 'border-color:rgba(248,113,113,0.45);'}>
        <p style="margin:0 0 6px;color:#fca5a5;font-weight:700;font-size:13.5px;">The AquinTutor tables could not be prepared.</p>
        <p style="margin:0;color:#cfd6da;font-size:13px;line-height:1.6;">The database said: {schemaError}</p>
      </div>
    )}

    {missingTables.length > 0 && schemaError === '' && (
      <div style={CARD + 'border-color:rgba(230,120,0,0.45);'}>
        <p style="margin:0;color:#e8c46a;font-size:13px;line-height:1.6;">
          Still missing after the create ran: {missingTables.join(', ')}. Reload to try again.
        </p>
      </div>
    )}

    {done && successMsg === '' && (
      <div style={CARD}>
        <p style="margin:0 0 6px;color:#7dd3a8;font-weight:700;font-size:14px;">Already done.</p>
        <p style="margin:0;color:#cfd6da;font-size:13px;line-height:1.6;">
          AquinTutor has {superAdmins} super {superAdmins === 1 ? 'admin' : 'admins'}. This page
          grants nothing further to anybody, including to this EduRankAI account. Further
          administrators are appointed from inside AquinTutor by an existing super admin.
          <br /><br />
          <a href="/aquintutor/admin/login" style="color:#FF7040;">Sign in to AquinTutor &rarr;</a>
        </p>
      </div>
    )}

    {!done && schemaError === '' && missingTables.length === 0 && (
      <form method="POST" style={CARD}>
        <p style="font-size:11px;color:#8a8a94;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;margin:0 0 14px;">Create the founding administrator</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div><label style={LBL} for="bs-name">Full name</label><input id="bs-name" style={INP} type="text" name="name" required /></div>
          <div>
            <label style={LBL} for="bs-email">Email</label>
            <input id="bs-email" style={INP} type="email" name="email" required />
            <p style="margin:5px 0 0;font-size:11.5px;color:#8a8a94;line-height:1.5;">May be the same address as an EduRankAI account. It will be a different account with a different password, which is the point.</p>
          </div>
          <div><label style={LBL} for="bs-pw">Password</label><input id="bs-pw" style={INP} type="password" name="password" required minlength="10" autocomplete="new-password" /></div>
          <div><label style={LBL} for="bs-pw2">Repeat the password</label><input id="bs-pw2" style={INP} type="password" name="confirm" required minlength="10" autocomplete="new-password" /></div>
        </div>
        <button type="submit" style="margin-top:16px;min-height:44px;padding:0 20px;border:0;border-radius:9px;background:#FF4F00;color:#fff;font-weight:700;font-size:14px;cursor:pointer;">Create the AquinTutor super admin</button>
        <p style="margin:10px 0 0;font-size:11.5px;color:#8a8a94;line-height:1.5;">Recorded in the AquinTutor audit log with the EduRankAI account that did it.</p>
      </form>
    )}
  </div>
</AdminLayout>
