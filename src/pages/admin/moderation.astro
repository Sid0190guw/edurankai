---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

function mRows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

let okMsg = '', errorMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  try {
    // EVERY WRITE ON THIS PAGE NOW READS ITS OWN RESULT. They were all fire-and-forget UPDATEs and
    // DELETEs followed by an unconditional 'Flag resolved.' / 'Domain unblocked.' — so a flag another
    // moderator had already closed, or a row deleted in a second tab, produced the green box and a
    // list that still showed the item, with nothing on screen explaining the contradiction.
    if (action === 'resolve') {
      const id = fd.get('id') as string;
      const resolution = fd.get('resolution') as string;
      const done = mRows(await db.execute(sql`UPDATE content_flags SET status = 'resolved', resolution = ${resolution}, resolved_by = ${user.id}, resolved_at = NOW() WHERE id = ${id} AND status = 'pending' RETURNING id`));
      okMsg = done.length ? 'Flag resolved.' : '';
      if (!done.length) errorMsg = 'That flag was not resolved: it no longer exists, or somebody else already actioned it. Reload to see its current state.';
    } else if (action === 'dismiss') {
      const id = fd.get('id') as string;
      const done = mRows(await db.execute(sql`UPDATE content_flags SET status = 'dismissed', resolved_by = ${user.id}, resolved_at = NOW() WHERE id = ${id} AND status = 'pending' RETURNING id`));
      okMsg = done.length ? 'Flag dismissed.' : '';
      if (!done.length) errorMsg = 'That flag was not dismissed: it no longer exists, or somebody else already actioned it. Reload to see its current state.';
    } else if (action === 'warn_user') {
      const userId = fd.get('user_id') as string;
      const message = fd.get('message') as string;
      // THROUGH THE ONE NOTIFIER, NOT A HAND-WRITTEN INSERT. This used to be a raw
      // `INSERT INTO notifications (user_id, title, body, type)` straight from this page: it never
      // ran the schema ensure, wrote none of the columns src/lib/push.ts fills (category, priority),
      // and — because it is not the notifier — sent no push, so a warning about flagged content sat
      // silently in a bell the person may never open while this page said "Warning sent to user."
      const { sendPushToUser } = await import('@/lib/push');
      await sendPushToUser(userId, {
        type: 'content_warning',
        title: 'Content warning',
        body: message,
        url: '/portal',
        tag: 'content-warning',
      });
      okMsg = 'Warning sent to user.';
    } else if (action === 'add_domain') {
      const domain = (fd.get('domain') as string || '').trim().toLowerCase();
      const reason = (fd.get('reason') as string || '').trim();
      const category = fd.get('category') as string;
      if (!domain) {
        errorMsg = 'Type a domain to block. Nothing was changed.';
      } else {
        const added = mRows(await db.execute(sql`INSERT INTO content_blocked_domains (domain, reason, category, added_by) VALUES (${domain}, ${reason || null}, ${category || null}, ${user.id}) ON CONFLICT (domain) DO NOTHING RETURNING id`));
        // ON CONFLICT DO NOTHING is silent by design, and the page used to report it as a fresh
        // block. An operator who mistypes a domain that is already listed deserves to know which of
        // the two happened.
        okMsg = added.length ? 'Domain blocked.' : '';
        if (!added.length) errorMsg = 'That domain was already on the block list, so nothing was added. Its existing reason and category are unchanged.';
      }
    } else if (action === 'remove_domain') {
      const removed = mRows(await db.execute(sql`DELETE FROM content_blocked_domains WHERE id = ${fd.get('id') as string} RETURNING id`));
      okMsg = removed.length ? 'Domain unblocked.' : '';
      if (!removed.length) errorMsg = 'That domain was not unblocked: the entry no longer exists. Reload to see the current list.';
    }
  } catch (e: any) {
    // e.message on a drizzle error is only the failed SQL. The reason is on e.cause, and NOTHING
    // was being logged here at all — a moderation action that threw left no trace anywhere.
    const real = e?.cause?.message || e?.message || 'unknown reason';
    console.error('[admin/moderation]', action, 'failed -', real);
    okMsg = '';
    errorMsg = 'Nothing was changed. Reason: ' + real;
  }
}

const url = new URL(Astro.request.url);
const tab = url.searchParams.get('tab') || 'flags';
const filter = url.searchParams.get('filter') || 'pending';

let flags: any[] = [];
let blockedDomains: any[] = [];
let stats = { pending: 0, resolved: 0, dismissed: 0, total: 0 };
// A ZERO AND A FAILED READ ARE NOT THE SAME FACT, AND ON A SAFETY QUEUE THE DIFFERENCE IS THE WHOLE
// POINT. All three reads below used to end in `catch(e) {}`, so a database that refused the query
// rendered "0 pending", "No pending flags — Content is clean." and an empty block list. A moderator
// reading that closes the tab. Each read now records whether it answered.
let flagsError = '';
let statsError = '';
let domainsError = '';

try {
  const r = await db.execute(sql`
    SELECT f.*, u1.name as reporter_name, u2.name as target_name, u2.email as target_email
    FROM content_flags f
    LEFT JOIN users u1 ON f.reporter_user_id = u1.id
    LEFT JOIN users u2 ON f.target_user_id = u2.id
    WHERE f.status = ${filter}
    ORDER BY f.created_at DESC LIMIT 50
  `);
  flags = mRows(r);
} catch (e: any) {
  flagsError = e?.cause?.message || e?.message || 'the flag queue did not answer';
  console.error('[admin/moderation] flags read failed -', flagsError);
}

try {
  const r = await db.execute(sql`SELECT COUNT(*)::int as n, status FROM content_flags GROUP BY status`);
  for (const row of mRows(r) as any[]) {
    if (row.status === 'pending' || row.status === 'resolved' || row.status === 'dismissed') {
      stats[row.status as 'pending' | 'resolved' | 'dismissed'] = Number(row.n) || 0;
    }
    stats.total += Number(row.n) || 0;
  }
} catch (e: any) {
  statsError = e?.cause?.message || e?.message || 'the flag counts did not answer';
  console.error('[admin/moderation] stats read failed -', statsError);
}

try {
  const r = await db.execute(sql`SELECT * FROM content_blocked_domains ORDER BY created_at DESC`);
  blockedDomains = mRows(r);
} catch (e: any) {
  domainsError = e?.cause?.message || e?.message || 'the blocked-domain list did not answer';
  console.error('[admin/moderation] blocked domains read failed -', domainsError);
}

const FLAG_COLOR: Record<string,string> = {
  nudity:'#ef4444', explicit:'#f97316', propaganda:'#a78bfa',
  hate_speech:'#ef4444', misinformation:'#fbbf24', spam:'#6b7280',
  harassment:'#f97316', violence:'#ef4444', self_harm:'#a78bfa', other:'#6b7280'
};

function timeAgo(d: any) {
  if (!d) return '';
  const diff = Date.now() - new Date(d).getTime();
  const mins = Math.floor(diff/60000);
  if (mins < 60) return mins + 'm ago';
  return Math.floor(mins/60) + 'h ago';
}
---
<AdminLayout title="Content Moderation" activeNav="moderation">
<div style="padding-bottom:80px;">

  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;position:sticky;top:0;z-index:10;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">Safety</p>
        <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Content Moderation</h1>
      </div>
      {stats.pending > 0 && <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:100px;padding:4px 12px;"><span style="font-size:12px;font-weight:700;color:#ef4444;">{stats.pending} pending</span></div>}
    </div>
    <div style="display:flex;gap:5px;">
      {[['flags','Flags'],['domains','Blocked Domains'],['wellbeing','Wellbeing']].map(([t,l]) => (
        <a href={`?tab=${t}`} style={`text-decoration:none;font-size:12px;font-weight:600;padding:6px 12px;border-radius:6px;${tab===t?'background:#FF4F00;color:#fff;':'background:#15151a;color:#8a8a94;'}`}>{l}</a>
      ))}
    </div>
  </div>

  {errorMsg && <div style="margin:10px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {okMsg && <div style="margin:10px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}

  {tab === 'flags' && (
    <div style="padding:12px 16px;">
      <!-- Stats -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px;">
        {[
          { label:'Total', value: statsError ? 'unknown' : stats.total, color: statsError ? '#e8c46a' : '#fff' },
          { label:'Pending', value: statsError ? 'unknown' : stats.pending, color: statsError ? '#e8c46a' : '#ef4444' },
          { label:'Resolved', value: statsError ? 'unknown' : stats.resolved, color: statsError ? '#e8c46a' : '#10b981' },
          { label:'Dismissed', value: statsError ? 'unknown' : stats.dismissed, color: statsError ? '#e8c46a' : '#6b7280' },
        ].map(s => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:10px;text-align:center;">
            <p style={`font-size:20px;font-weight:800;color:${s.color};margin:0;font-family:'Geist Mono',monospace;`}>{s.value}</p>
            <p style="font-size:9px;color:#6e6e78;margin:3px 0 0;text-transform:uppercase;">{s.label}</p>
          </div>
        ))}
      </div>

      <!-- Filter -->
      <div style="display:flex;gap:5px;margin-bottom:12px;">
        {['pending','reviewing','resolved','dismissed'].map(f => (
          <a href={`?tab=flags&filter=${f}`} style={`text-decoration:none;font-size:11px;font-weight:600;padding:5px 10px;border-radius:100px;${filter===f?'background:#FF4F00;color:#fff;':'background:#15151a;border:1px solid #1a1a1f;color:#8a8a94;'}`}>{f.charAt(0).toUpperCase()+f.slice(1)}</a>
        ))}
      </div>

      {flagsError ? (
        <div style="padding:16px 18px;background:#0f0f14;border:1px solid rgba(232,196,106,0.3);border-radius:12px;color:#e8c46a;font-size:12.5px;line-height:1.6;">
          <p style="margin:0 0 4px;font-weight:700;">The flag queue could not be read.</p>
          <p style="margin:0;color:#8a8a94;">This is NOT "no flags" — it is unknown. Nothing below has been checked. Reason: {flagsError}</p>
        </div>
      ) : flags.length === 0 && (
        <div style="text-align:center;padding:40px;background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;color:#6e6e78;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6e6e78" stroke-width="1.5" style="margin-bottom:12px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p style="font-size:14px;font-weight:600;color:#fff;margin-bottom:4px;">No {filter} flags</p>
          <p style="font-size:12px;">Nothing is waiting in this state right now.</p>
        </div>
      )}

      <div style="display:flex;flex-direction:column;gap:8px;">
        {flags.map((f: any) => {
          const fc = (FLAG_COLOR as any)[f.flag_type] || '#6b7280';
          return (
            <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
              <div style="padding:12px 14px;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;">
                  <div>
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap;">
                      <span style={`font-size:9px;font-weight:700;padding:2px 8px;border-radius:100px;background:${fc}22;color:${fc};text-transform:uppercase;`}>{f.flag_type?.replace('_',' ')}</span>
                      <span style="font-size:9px;background:#15151a;color:#8a8a94;padding:2px 6px;border-radius:4px;">{f.flag_source}</span>
                      {f.confidence && <span style="font-size:9px;color:#6e6e78;">{Math.round(f.confidence*100)}% confidence</span>}
                    </div>
                    <p style="font-size:12px;color:#6e6e78;margin:0;font-family:'Geist Mono',monospace;">{f.entity_type} - {f.entity_id?.substring(0,12)}</p>
                  </div>
                  <span style="font-size:10px;color:#6e6e78;flex-shrink:0;">{timeAgo(f.created_at)}</span>
                </div>

                {f.content_snippet && (
                  <div style="background:#15151a;border-radius:6px;padding:8px 10px;margin-bottom:8px;border-left:3px solid #ef4444;">
                    <p style="font-size:11px;color:#8a8a94;margin:0;line-height:1.4;font-style:italic;">"{f.content_snippet.substring(0,200)}{f.content_snippet.length>200?'...':''}"</p>
                  </div>
                )}

                <div style="display:flex;align-items:center;gap:8px;font-size:11px;color:#6e6e78;flex-wrap:wrap;">
                  {f.reporter_name && <span>Reported by: <span style="color:#d8d8de;">{f.reporter_name}</span></span>}
                  {f.target_name && <span>Target: <span style="color:#fca5a5;">{f.target_name} ({f.target_email})</span></span>}
                </div>
              </div>

              {f.status === 'pending' && (
                <div style="border-top:1px solid #1a1a1f;padding:8px 14px;display:flex;gap:6px;flex-wrap:wrap;">
                  <form method="POST" style="display:flex;gap:4px;flex:1;">
                    <input type="hidden" name="action" value="resolve" />
                    <input type="hidden" name="id" value={f.id} />
                    <input name="resolution" placeholder="Resolution note..." required style="flex:1;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:6px 10px;color:#fff;font-size:11px;outline:none;" />
                    <button type="submit" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;font-size:11px;font-weight:600;padding:6px 10px;border-radius:6px;cursor:pointer;">Resolve</button>
                  </form>
                  <form method="POST" style="display:contents;">
                    <input type="hidden" name="action" value="dismiss" />
                    <input type="hidden" name="id" value={f.id} />
                    <button type="submit" style="background:#15151a;border:1px solid #1a1a1f;color:#6e6e78;font-size:11px;padding:6px 10px;border-radius:6px;cursor:pointer;">Dismiss</button>
                  </form>
                  {f.target_user_id && (
                    <form method="POST" style="display:contents;">
                      <input type="hidden" name="action" value="warn_user" />
                      <input type="hidden" name="user_id" value={f.target_user_id} />
                      <input type="hidden" name="message" value={`Your content was flagged for ${f.flag_type?.replace('_',' ')}. Please review our community guidelines.`} />
                      <button type="submit" style="background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.2);color:#fbbf24;font-size:11px;padding:6px 10px;border-radius:6px;cursor:pointer;">Warn User</button>
                    </form>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  {tab === 'domains' && (
    <div style="padding:12px 16px;">
      <!-- Add domain form -->
      <form method="POST" style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px;margin-bottom:12px;display:flex;flex-direction:column;gap:10px;">
        <input type="hidden" name="action" value="add_domain" />
        <p style="font-size:12px;font-weight:600;color:#fff;margin:0;">Block a Domain</p>
        <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;">
          <input name="domain" placeholder="example.com" required style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:9px 12px;color:#fff;font-size:13px;outline:none;" />
          <select name="category" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:9px 12px;color:#fff;font-size:12px;outline:none;">
            <option value="nudity">Nudity</option>
            <option value="hate_speech">Hate speech</option>
            <option value="propaganda">Propaganda</option>
            <option value="violence">Violence</option>
            <option value="spam">Spam</option>
            <option value="other">Other</option>
          </select>
          <button type="submit" style="background:#FF4F00;border:none;color:#fff;font-size:12px;font-weight:600;border-radius:8px;cursor:pointer;">Block</button>
        </div>
        <input name="reason" placeholder="Reason (optional)" style="background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:8px 12px;color:#fff;font-size:12px;outline:none;" />
      </form>

      {domainsError && (
        <div style="padding:14px 16px;margin-bottom:10px;background:#0f0f14;border:1px solid rgba(232,196,106,0.3);border-radius:12px;color:#e8c46a;font-size:12.5px;line-height:1.6;">
          <p style="margin:0 0 4px;font-weight:700;">The block list could not be read.</p>
          <p style="margin:0;color:#8a8a94;">The list below is empty because the query failed, not because nothing is blocked. Blocking is still enforced from the table by /api/safety/check-domain. Reason: {domainsError}</p>
        </div>
      )}
      {!domainsError && blockedDomains.length === 0 && (
        <p style="font-size:12.5px;color:#6e6e78;margin:0 0 10px;">No domain is blocked yet.</p>
      )}
      <div style="display:flex;flex-direction:column;gap:6px;">
        {blockedDomains.map((d: any) => (
          <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:10px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            <div style="flex:1;min-width:0;">
              <p style="font-size:13px;font-weight:600;color:#fff;margin:0;font-family:'Geist Mono',monospace;">{d.domain}</p>
              {d.reason && <p style="font-size:11px;color:#6e6e78;margin:2px 0 0;">{d.reason}</p>}
            </div>
            <span style="font-size:9px;background:rgba(239,68,68,0.1);color:#fca5a5;padding:2px 8px;border-radius:100px;flex-shrink:0;">{d.category}</span>
            <form method="POST" style="display:contents;">
              <input type="hidden" name="action" value="remove_domain" />
              <input type="hidden" name="id" value={d.id} />
              <button type="submit" style="background:none;border:none;color:#6e6e78;cursor:pointer;font-size:16px;padding:4px;">&times;</button>
            </form>
          </div>
        ))}
      </div>
    </div>
  )}

  {tab === 'wellbeing' && (
    <div style="padding:12px 16px;display:flex;flex-direction:column;gap:12px;">
      <!--
        THIS TAB CLAIMED A SAFETY CONTROL THAT DOES NOT EXIST.

        "NSFW Image Detection — ACTIVE", followed by a whole panel headed "How NSFW Detection Works"
        stating as fact that "the system runs them through a TensorFlow.js NSFW classification model
        before storage" with a five-row table of classes, thresholds and Allow/Block/Flag actions.
        There is no such model, no such dependency and no such call anywhere in this repository: not
        in package.json, not in any upload handler, not in src/lib. Every image a user uploads is
        stored unexamined.

        That is worse than a missing feature. This is the safety console — the screen somebody opens
        to decide whether uploads are being screened — and it was answering yes. The fabricated
        pipeline description is gone and the row now says what is true, so the gap is visible to the
        person who can act on it.

        THE OTHER ROWS WERE CHECKED, NOT ASSUMED. Link Safety Check and User Report System are real:
        public/safety.js is loaded by BaseLayout and calls /api/safety/check-domain and
        /api/safety/report, and the reports land in the queue on the Flags tab. The propaganda row is
        real but was overstated — the scan is a client-side keyword pass over page text in
        public/safety.js, which is not "detection in text submissions", so it is described as what it
        is and marked advisory. Automated signals on this platform are advisory: a human decides.
      -->
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:16px;">
        <p style="font-size:13px;font-weight:600;color:#fff;margin:0 0 4px;">Platform safety features</p>
        <p style="font-size:11px;color:#6e6e78;margin:0 0 12px;line-height:1.6;">What is actually running today, named against the file that runs it. A row marked NOT BUILT is not a plan and not a partial rollout — nothing on the platform does it.</p>
        {[
          { label: 'User reports', desc: 'Any visitor can flag content from the page (public/safety.js). Every report lands in the Flags tab on this screen.', status: 'live', color: '#10b981' },
          { label: 'Blocked-domain warning', desc: 'Outbound links are checked against the block list below before the visitor leaves (public/safety.js, /api/safety/check-domain).', status: 'live', color: '#10b981' },
          { label: 'Propaganda keyword scan', desc: 'A client-side keyword pass over page text that raises a report for a human to read. Advisory only — it blocks nothing and penalises nobody.', status: 'advisory', color: '#fbbf24' },
          { label: 'Uploaded-image screening', desc: 'Images uploaded to the platform are NOT examined by anything. There is no classifier, no threshold and no automatic rejection. Anything reported has to be found by a person.', status: 'not built', color: '#ef4444' },
          { label: 'Content warnings', desc: 'Warning overlays on sensitive topics before content is displayed.', status: 'not built', color: '#6b7280' },
          { label: 'Screen time limits', desc: 'Daily usage limits with reminders that a user sets for themselves.', status: 'not built', color: '#6b7280' },
          { label: 'AI chat safety', desc: 'Filtering of harmful prompts in AI-powered features.', status: 'not built', color: '#6b7280' },
        ].map(f => (
          <div style="display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid #1a1a1f;">
            <div style={`width:8px;height:8px;border-radius:50%;background:${f.color};flex-shrink:0;margin-top:5px;`}></div>
            <div style="flex:1;">
              <p style="font-size:13px;font-weight:600;color:#fff;margin:0 0 2px;">{f.label}</p>
              <p style="font-size:11px;color:#6e6e78;margin:0;line-height:1.5;">{f.desc}</p>
            </div>
            <span style={`font-size:9px;font-weight:700;padding:2px 8px;border-radius:100px;flex-shrink:0;background:${f.color}22;color:${f.color};text-transform:uppercase;`}>{f.status}</span>
          </div>
        ))}
      </div>

      <div style="background:#0f0f14;border:1px solid rgba(239,68,68,0.2);border-radius:12px;padding:16px;">
        <p style="font-size:13px;font-weight:600;color:#fca5a5;margin:0 0 8px;">Uploaded images are not screened</p>
        <p style="font-size:12px;color:#8a8a94;margin:0;line-height:1.6;">This panel used to describe an image classifier with per-class thresholds and an automatic block at 70% explicit. No such classifier exists in this codebase, so nothing was ever rejected by it and nothing was ever flagged by it. Until one is built and named here, the only thing standing between an explicit upload and the rest of the platform is a person reporting it into the Flags tab.</p>
      </div>
    </div>
  )}

</div>
</AdminLayout>
