---
// /admin/billing — payments & refunds console + revenue from REAL data (Prompt AP5b). Registrar-gated.
// Revenue counts only captured payments and separates live vs test/comp — never a fabricated number.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/rbac';
import { allPayments } from '@/lib/course-payments';
import { PLANS, revenuePaise, gatewayMode } from '@/lib/payment-gateway';
import { dbReason } from '@/lib/page-safety';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
const gate = await can(user, 'manage', { type: 'enrolment' });
if (!gate.allow) return Astro.redirect('/admin');
// A FAILED READ USED TO BE PRINTED AS "₹0 REVENUE".
//
// `allPayments(120).catch(() => [])` handed an empty array to revenuePaise(), and the three tiles
// below stated ₹0 live, ₹0 test and 0 payments as measured facts. On the one screen in the product
// that answers "how much money has come in", a pooler timeout and a month with no sales rendered
// identically — and this page is read by the person who decides whether the paid flow is working.
//
// The read now reports whether it answered. Where it did not, the tiles say "unknown" and the reason
// is printed. dbReason() unwraps the real Postgres message off e.cause; e.message on a drizzle error
// is only the SQL that failed. `const` before every use.
let payments: any[] = [];
let paymentsError = '';
try {
  payments = await allPayments(120);
} catch (e: any) {
  paymentsError = dbReason(e);
  console.error('[admin/billing] payments could not be read -', paymentsError);
}
const paymentsOk = !paymentsError;
const rev = revenuePaise(payments);
const mode = gatewayMode();
const CARD = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px 18px;margin-bottom:16px;';
const HD = "font-size:11px;color:#8a8a94;text-transform:uppercase;font-family:'Geist Mono',monospace;letter-spacing:0.1em;font-weight:700;margin:0 0 10px;";
function inr(paise: number) { return '₹' + (paise / 100).toLocaleString('en-IN'); }
---
<AdminLayout title="Billing" activeNav="billing">
  <div style="max-width:940px;margin:0 auto;padding:24px;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">Registrar</p>
    <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0;">Payments &amp; refunds</h1>
    <p style="font-size:12.5px;color:#8a8a94;margin:6px 0 0;">Gateway mode: <b style={mode === 'live' ? 'color:#6ee7b7;' : 'color:#c0a35e;'}>{mode}</b>. Plans: {PLANS.map((p) => p.label + ' (' + inr(p.priceInr * 100) + ')').join(' · ')}.</p>
    <div id="msg" style="display:none;margin:12px 0;padding:9px 13px;border-radius:8px;font-size:13px;"></div>

    {!paymentsOk && (
      <div style="border:1px solid #e8c46a33;background:#e8c46a0f;border-radius:12px;padding:12px 14px;margin:14px 0;font-size:12.5px;color:#e8c46a;line-height:1.6;">
        The payment record could not be read, so the figures below are <b>unknown</b>, not zero. No refund can be issued from this screen until it answers. Reason: {paymentsError}
      </div>
    )}

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:16px 0;">
      <div style={CARD + 'margin:0;'}><p style="font-size:11px;color:#8a8a94;margin:0;">Revenue (real / live)</p><p style={'font-size:26px;font-weight:800;margin:4px 0 0;color:' + (paymentsOk ? '#6ee7b7' : '#e8c46a')}>{paymentsOk ? inr(rev.live) : 'unknown'}</p></div>
      <div style={CARD + 'margin:0;'}><p style="font-size:11px;color:#8a8a94;margin:0;">Test / comp (not real)</p><p style="font-size:26px;font-weight:800;color:#c0a35e;margin:4px 0 0;">{paymentsOk ? inr(rev.sandbox) : 'unknown'}</p></div>
      <div style={CARD + 'margin:0;'}><p style="font-size:11px;color:#8a8a94;margin:0;">Payments</p><p style={'font-size:26px;font-weight:800;margin:4px 0 0;color:' + (paymentsOk ? '#fff' : '#e8c46a')}>{paymentsOk ? payments.length : 'unknown'}</p></div>
    </div>

    <div style={CARD}>
      <p style={HD}>Payments</p>
      <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
        <thead><tr style="text-align:left;color:#8a8a94;font-size:11px;text-transform:uppercase;"><th style="padding:6px 8px;">Plan</th><th style="padding:6px 8px;">Amount</th><th style="padding:6px 8px;">Status</th><th style="padding:6px 8px;">Mode</th><th style="padding:6px 8px;"></th></tr></thead>
        <tbody>
          {payments.map((p: any) => (
            <tr style="border-top:1px solid #1a1a1f;color:#d6d6de;">
              <td style="padding:7px 8px;">{p.plan}</td>
              <td style="padding:7px 8px;">{inr(p.amount_paise)}</td>
              <td style={'padding:7px 8px;color:' + (p.status === 'paid' ? '#6ee7b7' : p.status === 'refunded' ? '#c0a35e' : '#8a8a94')}>{p.status}</td>
              <td style="padding:7px 8px;font-family:'Geist Mono',monospace;font-size:11px;color:#8a8a94;">{p.mode}</td>
              <td style="padding:7px 8px;">{p.status === 'paid' && p.payment_id && p.payment_id !== 'comp' && p.payment_id !== 'free'
                ? <button class="refundBtn" data-pid={p.payment_id} style="background:#2a0f0f;color:#fca5a5;border:1px solid #3a1a1a;border-radius:7px;padding:5px 11px;font-size:12px;cursor:pointer;">Refund</button>
                : null}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {paymentsOk && payments.length === 0 && (
        <p style="font-size:12px;color:#6e6e78;margin:10px 0 0;">No payment has been recorded yet. This is a genuine empty list, not a failed read.</p>
      )}
    </div>
  </div>

  <script is:inline>
    // A REFUND IS REAL MONEY AND THIS BUTTON USED TO LOOK DEAD ON A TIMEOUT.
    //
    // The old chain was fetch, then r.json(), then a single success handler, with no .catch. When the gateway
    // call ran past the invocation ceiling the platform answered an HTML error body, r.json()
    // rejected, and NOTHING happened: #msg was never even switched to display:block, the row did
    // not change, the page did not reload, and the button stayed clickable. The obvious move for a
    // registrar is then to click Refund again — against a payment that may already be refunded,
    // with no way to tell from this screen which it is. So: report every outcome, and on any
    // outcome that is not a confirmed refund leave the button DISABLED, so a retry costs a
    // deliberate page reload where the row's real status is re-read from the payment record.
    document.querySelectorAll('.refundBtn').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Refund this payment and re-lock the course?')) return;
        var msg = document.getElementById('msg');
        function say(bg, fg, text) { msg.style.display = 'block'; msg.style.background = bg; msg.style.color = fg; msg.textContent = text; }
        b.disabled = true;
        b.textContent = 'Refunding...';
        fetch('/api/admin/billing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'refund', paymentId: b.getAttribute('data-pid') }) })
          .then(function (r) { return r.json().catch(function () { return null; }); })
          .then(function (j) {
            if (j && j.ok) { say('#0f2a1c', '#6ee7b7', 'Refunded. Reloading...'); setTimeout(function () { location.reload(); }, 800); return; }
            say('#2a0f0f', '#fca5a5', (j && j.error) || 'The server did not confirm the refund, so we cannot say whether it was issued. Reload this page and check the payment status before trying again.');
          })
          .catch(function () {
            say('#2a0f0f', '#fca5a5', 'The refund request timed out on our side. It may or may not have reached the gateway - reload this page and check the payment status before trying again.');
          });
      });
    });
  </script>
</AdminLayout>
