---
// /admin/horizon/interpretation — PATCH 03's read surface.
//
// It renders the twelve neutral professional dimensions and NOTHING about how they were arrived at,
// unless the account holds horizon.interpretation.trace — and in that case the detail arrives in the
// object, not through a template flag, because the projection happens in the library.
//
// It exists so the layer is reachable rather than a set of files nobody can open. It is deliberately
// thin: a richer profile view belongs to whichever patch owns employee profile surfaces, and this
// page hands it the same library call rather than becoming that surface itself.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  connectFoundationalEngine,
  latestInterpretation,
  interpretationHistory,
  foundationalProviderName,
  evidenceProviderName,
  languageGuardSelfCheck,
  engineSelfCheck,
  DIMENSION_LIST,
  UNIVERSAL_LIMITATIONS,
  INFERRED_CONFIDENCE_CEILING,
  isSubject,
  type HorizonSubject,
  type InterpretationResult,
  type DimensionMovement,
} from '@/lib/horizon/interpretation';

const user = Astro.locals.user!;
if (!can(user, 'horizon.interpretation.view')) return Astro.redirect('/admin');

// Idempotent, and it will not displace a provider something else registered first.
connectFoundationalEngine();

const caps = { view: true, trace: can(user, 'horizon.interpretation.trace') };
const mayCompute = can(user, 'horizon.interpretation.compute');

const url = new URL(Astro.request.url);
const kind = String(url.searchParams.get('kind') || '');
const subjectId = String(url.searchParams.get('id') || '').trim();
const purpose = String(url.searchParams.get('purpose') || '').trim();

const subject = { kind, id: subjectId } as HorizonSubject;
const haveSubject = isSubject(subject) && !!purpose;

let result: InterpretationResult | null = null;
let interpretationId = '';
let movements: DimensionMovement[] = [];
let notice = '';
let found = false;

if (haveSubject) {
  const r = await latestInterpretation(subject, { actorUserId: user.id, caps, purpose });
  if (!r.ok) {
    notice = r.error || 'The stored interpretations could not be read.';
  } else if (!r.found) {
    notice = 'Nothing has been interpreted for this person. There is no record to show.';
  } else {
    found = true;
    result = r.interpretation!.result;
    interpretationId = r.interpretation!.id;
    const h = await interpretationHistory(subject, { actorUserId: user.id, caps, purpose });
    if (h.ok) movements = h.movements;
  }
}

// The layer's own honesty checks, run on the page rather than only in CI: a guard regression must be
// visible where the output is read, not only where the tests are.
const guardProblems = languageGuardSelfCheck();
const enginePro = engineSelfCheck();
const selfCheckProblems = [...guardProblems, ...enginePro];
const upstream = foundationalProviderName();
const evidenceSource = evidenceProviderName();

// Hoisted out of JSX: this project's .astro parser does not tolerate comparison operators inside a
// JSX expression, and a value computed in the template is a value computed on every render.
const hasUpstream = upstream.length > 0;
const hasEvidence = evidenceSource.length > 0;
const selfCheckClean = selfCheckProblems.length === 0;
const hasMovements = movements.length > 0;
const dimensions = result ? result.dimensions : [];
const problemList = result ? result.problems : [];
const hasProblems = problemList.length > 0;
---

<AdminLayout title="Professional Interpretation" activeNav="">
  <div class="hz-wrap">
    <header class="hz-head">
      <h1>Professional interpretation</h1>
      <p class="hz-sub">
        Neutral professional dimensions produced from foundational input. These are indications, not
        measurements, and no employment decision may be made or supported on them.
      </p>
    </header>

    <section class="hz-card hz-status">
      <h2>Layer status</h2>
      <dl class="hz-status-grid">
        <div>
          <dt>Foundational input source</dt>
          <dd>{hasUpstream ? upstream : 'Not connected. Nothing can be interpreted until an input source is registered.'}</dd>
        </div>
        <div>
          <dt>Demonstrated-evidence source</dt>
          <dd>{hasEvidence ? evidenceSource : 'Not connected. Indications cannot be compared against work on record.'}</dd>
        </div>
        <div>
          <dt>Confidence ceiling</dt>
          <dd>{INFERRED_CONFIDENCE_CEILING} — no indication from this layer may ever exceed it.</dd>
        </div>
        <div>
          <dt>Self-check</dt>
          <dd>{selfCheckClean ? 'Passing.' : selfCheckProblems.join(' ')}</dd>
        </div>
      </dl>
    </section>

    <form class="hz-card hz-form" method="get">
      <h2>Open a record</h2>
      <div class="hz-row">
        <label>
          <span>Record type</span>
          <select name="kind">
            <option value="employee" selected={kind === 'employee'}>Employee</option>
            <option value="candidate" selected={kind === 'candidate'}>Candidate</option>
            <option value="learner" selected={kind === 'learner'}>Learner</option>
          </select>
        </label>
        <label>
          <span>Record id</span>
          <input type="text" name="id" value={subjectId} placeholder="record identifier" />
        </label>
      </div>
      <label class="hz-purpose">
        <span>Purpose for this access</span>
        <input type="text" name="purpose" value={purpose} placeholder="why this record is being opened" required />
      </label>
      <p class="hz-hint">
        The purpose is written to the audit log before anything is shown. An access that cannot be
        logged is refused rather than served.
      </p>
      <button type="submit" class="hz-btn">Open</button>
    </form>

    {notice && <div class="hz-card hz-notice">{notice}</div>}

    {mayCompute && haveSubject && (
      <div class="hz-card">
        <h2>Produce an interpretation</h2>
        <p class="hz-hint">
          Reads the current foundational input for this record and writes a new interpretation. If no
          consent reference is attached to that input, nothing is computed and the refusal is what is
          recorded.
        </p>
        <button type="button" class="hz-btn" id="hz-compute" data-kind={kind} data-id={subjectId}>Run now</button>
        <span id="hz-compute-msg" class="hz-hint"></span>
      </div>
    )}

    {found && result && (
      <section class="hz-card">
        <h2>Record</h2>
        <p class="hz-notice-inline">{result.notice}</p>
        <dl class="hz-status-grid">
          <div><dt>State</dt><dd>{result.state}</dd></div>
          <div><dt>Produced</dt><dd>{result.generatedAt}</dd></div>
          <div><dt>Input source</dt><dd>{result.inputSourceModule} {result.inputSourceVersion}</dd></div>
          <div><dt>Input fingerprint</dt><dd class="hz-mono">{result.inputDigest || 'none'}</dd></div>
          <div><dt>Inputs considered</dt><dd>{result.factorsConsidered}</dd></div>
          <div><dt>Inputs that reached no dimension</dt><dd>{result.unmappedFactorCount}</dd></div>
          <div><dt>Consent reference</dt><dd class="hz-mono">{result.consentRef || 'none recorded'}</dd></div>
          <div><dt>Withheld wordings</dt><dd>{result.redactionCount}</dd></div>
        </dl>
        {hasProblems && (
          <ul class="hz-problems">
            {problemList.map((p) => <li>{p}</li>)}
          </ul>
        )}
      </section>
    )}

    {hasMovements && (
      <section class="hz-card">
        <h2>What changed since the previous run</h2>
        <p class="hz-hint">
          A change is a reason to ask a question, not a trend. Nothing here projects forward.
        </p>
        <ul class="hz-moves">
          {movements.map((m) => (
            <li><strong>{m.label}</strong>: {m.from} to {m.to}</li>
          ))}
        </ul>
      </section>
    )}

    {dimensions.map((d) => (
      <article class="hz-card hz-dim">
        <header class="hz-dim-head">
          <h3>{d.label}</h3>
          <span class="hz-badge">{d.levelLabel}</span>
          <span class="hz-badge hz-badge-quiet">{d.confidenceLabel}</span>
          {d.supersededByEvidence && <span class="hz-badge hz-badge-warn">Superseded by work on record</span>}
        </header>
        <p class="hz-desc">{d.description}</p>
        <p class="hz-not">{d.notAbout}</p>
        <p class="hz-explain">{d.explanation}</p>
        <p class="hz-prec">{d.precedenceNote}</p>

        {d.implications.length ? (
          <div class="hz-block">
            <h4>Professional implications</h4>
            <ul>{d.implications.map((i) => <li>{i}</li>)}</ul>
          </div>
        ) : null}

        <div class="hz-block">
          <h4>Limitations</h4>
          <ul>{d.limitations.map((l) => <li>{l}</li>)}</ul>
        </div>

        {caps.trace && d.trace && (
          <details class="hz-block hz-trace">
            <summary>Trace and explainability</summary>
            <dl class="hz-status-grid">
              <div><dt>Inputs</dt><dd>{d.explainability.inputs}</dd></div>
              <div><dt>Processing</dt><dd>{d.explainability.processing}</dd></div>
              <div><dt>Output</dt><dd>{d.explainability.output}</dd></div>
              <div><dt>Evidence</dt><dd>{d.explainability.evidence}</dd></div>
              <div><dt>Confidence</dt><dd>{d.explainability.confidence}</dd></div>
              <div><dt>Timestamp</dt><dd>{d.explainability.timestamp}</dd></div>
            </dl>
            <table class="hz-table">
              <thead>
                <tr><th>Input</th><th>Share</th><th>Direction</th><th>Source confidence</th></tr>
              </thead>
              <tbody>
                {d.trace.map((t) => (
                  <tr>
                    <td class="hz-mono">{t.factorId}</td>
                    <td>{t.share}</td>
                    <td>{t.direction}</td>
                    <td>{t.confidence}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        )}
      </article>
    ))}

    {found && interpretationId && (
      <section class="hz-card">
        <h2>Record a disagreement</h2>
        <p class="hz-hint">
          An objection is appended beside this record and overwrites nothing in it. One person's view
          does not become the organisation's, and that applies to this system's view as much as to
          anybody else's.
        </p>
        <textarea id="hz-objection" rows="3" placeholder="what is wrong with this record"></textarea>
        <button type="button" class="hz-btn" id="hz-object" data-interp={interpretationId}>Record it</button>
        <span id="hz-object-msg" class="hz-hint"></span>
      </section>
    )}

    <section class="hz-card hz-catalogue">
      <h2>The twelve dimensions this layer can produce</h2>
      <p class="hz-hint">
        The list is closed. Nothing outside it can be emitted, whatever the input source sends.
      </p>
      <ul class="hz-cat">
        {DIMENSION_LIST.map((s) => <li><strong>{s.label}</strong> — {s.description}</li>)}
      </ul>
      <h3>Applies to every dimension</h3>
      <ul>{UNIVERSAL_LIMITATIONS.map((l) => <li>{l}</li>)}</ul>
    </section>
  </div>
</AdminLayout>

<script>
  const compute = document.getElementById('hz-compute');
  const computeMsg = document.getElementById('hz-compute-msg');
  if (compute && computeMsg) {
    compute.addEventListener('click', async () => {
      computeMsg.textContent = 'Working...';
      try {
        const res = await fetch('/api/admin/horizon/interpretation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'compute',
            kind: compute.getAttribute('data-kind'),
            id: compute.getAttribute('data-id'),
          }),
        });
        const data = await res.json();
        if (!data.ok) {
          computeMsg.textContent = data.error || 'It did not run.';
          return;
        }
        const state = data.interpretation && data.interpretation.state;
        const reason = (data.interpretation && data.interpretation.reason) || '';
        computeMsg.textContent = 'Recorded as "' + state + '". ' + reason;
        setTimeout(() => window.location.reload(), 1200);
      } catch {
        computeMsg.textContent = 'It did not run.';
      }
    });
  }

  const objectBtn = document.getElementById('hz-object');
  const objectMsg = document.getElementById('hz-object-msg');
  const objectText = document.getElementById('hz-objection') as HTMLTextAreaElement | null;
  if (objectBtn && objectMsg && objectText) {
    objectBtn.addEventListener('click', async () => {
      const statement = objectText.value.trim();
      if (!statement) {
        objectMsg.textContent = 'Write what is wrong with it first.';
        return;
      }
      objectMsg.textContent = 'Recording...';
      try {
        const res = await fetch('/api/admin/horizon/interpretation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'object',
            interpretationId: objectBtn.getAttribute('data-interp'),
            statement,
          }),
        });
        const data = await res.json();
        objectMsg.textContent = data.ok ? 'Recorded.' : (data.error || 'It was not recorded.');
        if (data.ok) objectText.value = '';
      } catch {
        objectMsg.textContent = 'It was not recorded.';
      }
    });
  }
</script>

<style>
  .hz-wrap { max-width: 68rem; margin: 0 auto; padding: 1rem; display: grid; gap: 1rem; }
  .hz-head h1 { margin: 0 0 .25rem; font-size: 1.5rem; }
  .hz-sub { margin: 0; color: var(--muted, #6b7280); max-width: 52rem; }
  .hz-card {
    background: var(--surface, #fff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: .6rem;
    padding: 1rem;
  }
  .hz-card h2 { margin: 0 0 .6rem; font-size: 1.05rem; }
  .hz-card h3 { margin: .8rem 0 .4rem; font-size: .95rem; }
  .hz-card h4 { margin: 0 0 .35rem; font-size: .85rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted, #6b7280); }
  .hz-status-grid { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 0; }
  .hz-status-grid dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted, #6b7280); }
  .hz-status-grid dd { margin: .15rem 0 0; font-size: .9rem; overflow-wrap: anywhere; }
  .hz-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; }
  .hz-form .hz-row { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .hz-form label { display: block; }
  .hz-form label span { display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted, #6b7280); margin-bottom: .2rem; }
  .hz-form input, .hz-form select, textarea {
    width: 100%; padding: .5rem .6rem; border: 1px solid var(--border, #e5e7eb);
    border-radius: .4rem; background: var(--bg, #fff); color: inherit; font: inherit;
  }
  .hz-purpose { margin-top: .6rem; display: block; }
  .hz-hint { color: var(--muted, #6b7280); font-size: .82rem; margin: .5rem 0; }
  .hz-btn {
    margin-top: .6rem; padding: .5rem .9rem; border-radius: .4rem; cursor: pointer;
    border: 1px solid var(--border, #e5e7eb); background: var(--accent, #111827); color: #fff; font: inherit;
  }
  .hz-notice { border-left: 3px solid var(--accent, #111827); }
  .hz-notice-inline { margin: 0 0 .8rem; font-size: .85rem; padding: .6rem; border-radius: .4rem; background: var(--muted-bg, #f3f4f6); }
  .hz-problems, .hz-moves, .hz-cat { margin: .6rem 0 0; padding-left: 1.1rem; font-size: .85rem; }
  .hz-problems li, .hz-moves li, .hz-cat li { margin-bottom: .3rem; }
  .hz-dim-head { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin-bottom: .5rem; }
  .hz-dim-head h3 { margin: 0; flex: 1 1 12rem; font-size: 1rem; }
  .hz-badge { font-size: .72rem; padding: .18rem .5rem; border-radius: 999px; border: 1px solid var(--border, #e5e7eb); }
  .hz-badge-quiet { color: var(--muted, #6b7280); }
  .hz-badge-warn { border-color: #b45309; color: #b45309; }
  .hz-desc { margin: 0 0 .4rem; font-size: .9rem; }
  .hz-not, .hz-prec { margin: 0 0 .4rem; font-size: .82rem; color: var(--muted, #6b7280); }
  .hz-explain { margin: 0 0 .6rem; font-size: .9rem; }
  .hz-block { margin-top: .8rem; }
  .hz-block ul { margin: 0; padding-left: 1.1rem; font-size: .85rem; }
  .hz-block li { margin-bottom: .25rem; }
  .hz-trace summary { cursor: pointer; font-size: .85rem; }
  .hz-table { width: 100%; border-collapse: collapse; margin-top: .6rem; font-size: .8rem; display: block; overflow-x: auto; }
  .hz-table th, .hz-table td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--border, #e5e7eb); white-space: nowrap; }
  @media (max-width: 40rem) {
    .hz-wrap { padding: .6rem; }
  }
</style>
