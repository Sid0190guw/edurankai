---
// /admin/horizon — WHOSE INTELLIGENCE RECORD DO YOU WANT TO OPEN.
//
// The picker for the Super Admin employee profile. It builds NO directory of its own: the scoped,
// searched, keyset-paged employee list already exists in src/lib/workforce/directory.ts and is
// owned there, so this page asks it a question and renders the answer. A second directory query
// would be a second scope rule, and two scope rules disagree eventually.
//
// It also states, before anybody clicks through, which of the twelve sections THIS viewer would be
// able to open — so the shape of what they are about to see is not a surprise, and the sections
// switched off for everybody are named as switched off rather than simply missing.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { directoryPage, type DirectoryPage } from '@/lib/workforce/directory';
import { HORIZON_SECTIONS, PEOPLE_VIEW_360, PROPOSED_CAPABILITY_MEANING } from '@/lib/horizon/sections';
import { resolveHorizonAccess } from '@/lib/horizon/access';

const PATH = '/admin/horizon';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

const holds = (k: string) => can(user as any, k as any);
const mayOpen = holds(PEOPLE_VIEW_360);

const url = new URL(Astro.request.url);
const q = String(url.searchParams.get('q') || '');
const cursor = url.searchParams.get('cursor');

// The grants are resolved against an EMPTY subject on purpose. This page is not showing anybody's
// record, so it must not resolve a person to work out what the viewer holds — the capability answer
// is the same for every subject, and asking it without a subject is the honest way to preview it.
const preview = resolveHorizonAccess(
  { userId: String(user.id), employeeId: null, role: String((user as any).role || ''), name: null },
  { personKey: '', userId: null, employeeId: null, applicationIds: [] },
  holds,
);

let page: DirectoryPage | null = null;
if (mayOpen) {
  page = await directoryPage({ userId: String(user.id), holds, q, cursor });
}

const people = page ? page.people : [];
const readOk = !!page && page.ok;
const tooShort = !!page && page.tooShort;
const indexed = !!page && page.indexed;
const nextCursor = page ? page.next : null;
const totalCount = page ? page.total.count : 0;
const totalIsFloor = !!page && page.total.atLeast;
const totalOk = !!page && page.total.ok;

const grantedSections = preview.grants.filter((g) => g.granted);
const withheldSections = preview.grants.filter((g) => g.outcome === 'withheld');
const awaitingSections = preview.grants.filter((g) => g.outcome === 'awaiting_ratification');
const sectionCount = HORIZON_SECTIONS.length;

const proposedMeaning = (k: string) => (PROPOSED_CAPABILITY_MEANING as any)[k] || '';
const nextHref = nextCursor
  ? PATH + '?q=' + encodeURIComponent(q) + '&cursor=' + encodeURIComponent(nextCursor)
  : null;

const MUTED = '#6e6e78';
const ACCENT = '#FF4F00';
---

<AdminLayout title="Employee intelligence records" activeNav="hr-employees">
  <div style="max-width:960px;">

    <div style={`font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>
      HORIZON
    </div>
    <h1 style="font-size:26px;font-weight:700;margin:6px 0 0;">Employee intelligence records</h1>
    <p style={`font-size:13px;color:${MUTED};line-height:1.75;margin:10px 0 0;max-width:76ch;`}>
      One person, twelve sections, and every panel says where it got what it shows. Nothing on these records
      decides anything: a hiring, promotion, pay, discipline or termination decision is made by a named human
      and recorded as theirs.
    </p>

    {!mayOpen && (
      <div style="border:1px solid #e4e4e8;border-left:3px solid #b3261e;padding:16px;border-radius:6px;margin-top:20px;">
        <div style="font-weight:700;font-size:14px;">You may not open an assembled person record.</div>
        <p style={`font-size:13px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>
          This needs {PEOPLE_VIEW_360}. No directory was read.
        </p>
      </div>
    )}

    {mayOpen && (
      <div>
        <!-- WHAT THIS VIEWER WOULD SEE -->
        <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px 16px;margin:20px 0;background:#fbfbfc;">
          <div style="font-size:13px;font-weight:700;">
            You would be able to open {grantedSections.length} of {sectionCount} sections.
          </div>
          <div style={`font-size:12px;color:${MUTED};line-height:1.8;margin-top:8px;`}>
            {grantedSections.map((g) => (<span>{g.section.replace(/_/g, ' ')} · </span>))}
          </div>
          {withheldSections.length > 0 && (
            <p style={`font-size:12px;color:${MUTED};line-height:1.7;margin:10px 0 0;`}>
              {withheldSections.length} section(s) are withheld from you and will not be read.
            </p>
          )}
          {awaitingSections.length > 0 && (
            <div style="margin-top:12px;border-top:1px solid #f0f0f2;padding-top:12px;">
              <div style="font-size:12px;font-weight:700;">
                {awaitingSections.length} interpretive section(s) are switched off for every role, super admin included.
              </div>
              {awaitingSections.map((g) => (
                <p style={`font-size:11.5px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>
                  <strong>{g.section.replace(/_/g, ' ')}</strong> needs {g.capability}, which is not in the permission
                  registry. Ratifying it would permit: {proposedMeaning(String(g.capability))}
                </p>
              ))}
            </div>
          )}
        </div>

        <!-- SEARCH -->
        <form method="get" action={PATH} style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search by name or employee code"
            style="flex:1;min-width:240px;padding:10px 12px;border:1px solid #e4e4e8;border-radius:6px;font-size:13px;"
          />
          <button type="submit" style={`padding:10px 18px;border:1px solid ${ACCENT};background:${ACCENT};color:#fff;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;`}>
            Search
          </button>
        </form>

        {!readOk && (
          <div style="border:1px solid #f0d9a0;background:#fffaf0;border-radius:6px;padding:12px 16px;margin-bottom:16px;">
            <p style="font-size:12.5px;line-height:1.7;margin:0;">
              The directory could not be read just now. This list is INCOMPLETE rather than empty, and nothing here
              says nobody matches.
            </p>
          </div>
        )}

        {tooShort && (
          <p style={`font-size:12.5px;color:${MUTED};line-height:1.7;`}>
            That search is too short to run, so everybody is not being listed instead. Type a little more.
          </p>
        )}

        {readOk && !tooShort && (
          <div>
            <p style={`font-size:12px;color:${MUTED};line-height:1.7;margin:0 0 10px;`}>
              {totalOk
                ? (totalIsFloor ? 'At least ' + totalCount + ' people in your scope.' : totalCount + ' people in your scope.')
                : 'The count could not be read, so no total is stated.'}
              {indexed ? '' : ' This search is reading the table because the name index is not present — it will be slow at headcount.'}
            </p>

            <div style="border:1px solid #e4e4e8;border-radius:6px;overflow:hidden;">
              {people.map((p) => (
                <a
                  href={'/admin/horizon/employee/' + p.id}
                  style="display:block;padding:14px 16px;border-bottom:1px solid #f0f0f2;text-decoration:none;color:inherit;"
                >
                  <div style="font-size:14px;font-weight:600;">
                    {p.name}
                    {p.isSelf && <span style={`font-weight:500;font-size:11px;color:${MUTED};`}> · this is you</span>}
                  </div>
                  <div style={`font-size:11.5px;color:${MUTED};line-height:1.6;`}>
                    {p.designation || 'No designation on the record'}
                    {p.departmentName ? ' · ' + p.departmentName : ' · no department set'}
                    {p.employeeCode ? ' · ' + p.employeeCode : ''}
                  </div>
                </a>
              ))}
            </div>

            {people.length === 0 && (
              <p style={`font-size:12.5px;color:${MUTED};line-height:1.7;margin-top:12px;`}>
                The directory was read and nobody in your scope matches.
              </p>
            )}

            {nextHref && (
              <a href={nextHref} style={`display:inline-block;margin-top:14px;font-size:12.5px;color:${ACCENT};font-weight:600;text-decoration:none;`}>
                Next page
              </a>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</AdminLayout>
