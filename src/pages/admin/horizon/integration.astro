---
// /admin/horizon/integration — IS THIS ONE SYSTEM YET, AND WHERE IS IT NOT.
//
// PATCH 20's surface. It renders no person, no score and no record about anybody: every value on
// this page is about CODE — which patches exist, which tables they declare, which concepts have two
// owners, and which of the brief's Definition of Done items are actually proven.
//
// It is deliberately the one HORIZON screen that contains no personal data at all, which is why its
// gate is `admin.access` and not a people capability. Nothing here needs consent, and nothing here
// is logged as a read of a person, because nothing here reads one.
//
// IT DOES NOT SIT AT /admin/horizon. That route belongs to Patch 11 (the Super Admin record picker)
// and overwriting it would be the collision the multi-agent rules exist to prevent.
//
// WHAT IT SHOWS IN A DEPLOYED FUNCTION. A serverless bundle does not ship src/ as readable files, so
// the assessment degrades to `unknown` with the reason printed, rather than reporting twenty-one
// patches as absent. That distinction is the whole discipline of this codebase and it is enforced in
// src/lib/horizon/integration/index.ts, not here.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { horizonIntegrationReport, VERDICT_LABELS, MODULE_STATE_LABELS } from '@/lib/horizon/integration';

const PATH = '/admin/horizon/integration';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

const report = await horizonIntegrationReport();
const c = report.counts;

// Every comparison is done HERE. `<` and `<=` inside a JSX expression break .astro parsing, and this
// project has lost a deploy to exactly that.
const readable = report.verdict !== 'unknown';
const defects = report.duplicates.filter((d) => d.severity === 'defect');
const byDesign = report.duplicates.filter((d) => d.severity === 'by_design');
const hasDefects = defects.length > 0;
const hasByDesign = byDesign.length > 0;
const hasUnclassified = report.unclassifiedTables.length > 0;
const hasParseFailures = report.parseFailures.length > 0;
const hasMigrations = report.migrationsOwed.length > 0;

const dodProven = report.dod.filter((d) => d.met === true).length;
const dodFailed = report.dod.filter((d) => d.met === false).length;
const dodUnknown = report.dod.filter((d) => d.met === null).length;

const verdictTone =
  report.verdict === 'ready' ? 'ok'
  : report.verdict === 'partially_integrated' ? 'warn'
  : report.verdict === 'unknown' ? 'muted'
  : 'bad';

function stateTone(state: string): string {
  if (state === 'reachable') return 'ok';
  if (state === 'implemented') return 'warn';
  if (state === 'absent') return 'bad';
  return 'muted';
}

function dodMark(met: boolean | null): string {
  if (met === true) return 'Proven';
  if (met === false) return 'Not met';
  return 'Needs a live run';
}

function dodTone(met: boolean | null): string {
  if (met === true) return 'ok';
  if (met === false) return 'bad';
  return 'muted';
}
---

<AdminLayout title="HORIZON integration" activeNav="horizon-integration">
  <div class="wrap">
    <header class="head">
      <h1>HORIZON integration</h1>
      <p class="sub">
        Twenty-one patches, assessed by reading the repository. No database is opened by this page and
        no record about any person is read.
      </p>
    </header>

    <section class={'verdict ' + verdictTone}>
      <div class="vlabel">{VERDICT_LABELS[report.verdict]}</div>
      <p class="vline">{report.headline}</p>
      <p class="vmeta">Assessed {report.collectedAt}</p>
    </section>

    {readable && (
      <section class="counts">
        <div class="count"><b>{c.reachable}</b><span>reachable</span></div>
        <div class="count"><b>{c.implemented}</b><span>built, unwired</span></div>
        <div class="count"><b>{c.contractOnly}</b><span>contract only</span></div>
        <div class="count"><b>{c.absent}</b><span>not started</span></div>
        <div class="count"><b>{c.tables}</b><span>tables declared</span></div>
        <div class={'count ' + (hasDefects ? 'bad' : 'ok')}><b>{c.duplicateDefects}</b><span>duplicate stores</span></div>
      </section>
    )}

    {hasParseFailures && (
      <section class="panel bad-panel">
        <h2>Files that do not parse</h2>
        <p class="note">
          A file that does not parse breaks the build for every patch that imports its contract, and
          the author cannot see it because they are working in their own subtree.
        </p>
        <ul class="plain">
          {report.parseFailures.map((p) => (
            <li><code>{p.file}:{p.line}</code> — {p.detail}</li>
          ))}
        </ul>
      </section>
    )}

    {hasDefects && (
      <section class="panel bad-panel">
        <h2>One concept, more than one owner</h2>
        <p class="note">
          Each row below is a second store of something that already has a canonical owner, with no
          stated reason to exist beside it. One of the two is not the truth and nothing in the code
          says which.
        </p>
        <table class="grid">
          <thead>
            <tr><th>Concept</th><th>Second store</th><th>Canonical</th><th>Declared by</th></tr>
          </thead>
          <tbody>
            {defects.map((d) => (
              <tr>
                <td>{d.conceptLabel}</td>
                <td><code>{d.duplicateTable}</code></td>
                <td><code>{d.canonicalTable}</code></td>
                <td class="dim">{d.duplicateModule}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {hasMigrations && (
          <p class="note">
            Patches owing a migration: {report.migrationsOwed.map((n) => 'P' + String(n).padStart(2, '0')).join(', ')}.
            The procedure is the brief's own: determine the canonical owner, migrate safely, preserve
            backward compatibility, update consumers, deprecate the duplicate, and never silently
            destroy history.
          </p>
        )}
      </section>
    )}

    {hasUnclassified && (
      <section class="panel">
        <h2>Tables nobody has classified</h2>
        <p class="note">
          These exist in the tree and no concept accounts for them. An unclassified table is a
          question nobody has answered yet, not a table that is fine.
        </p>
        <p class="tables">{report.unclassifiedTables.map((t) => <code>{t}</code>)}</p>
      </section>
    )}

    <section class="panel">
      <h2>Module status</h2>
      <ol class="modules">
        {report.modules.map((m) => (
          <li>
            <div class="mhead">
              <span class="pnum">P{String(m.entry.patch).padStart(2, '0')}</span>
              <span class="mtitle">{m.entry.title}</span>
              <span class={'pill ' + stateTone(m.state)}>{MODULE_STATE_LABELS[m.state]}</span>
            </div>
            <p class="msent">{m.sentence}</p>
            <p class="mmeta">
              <span>Owns {m.entry.owns.length ? m.entry.owns.join(', ') : 'nothing yet'}</span>
              {m.misplaced && <span class="warnflag">outside src/lib/horizon</span>}
              {m.hasTests && <span class="okflag">has tests</span>}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="panel">
      <h2>Definition of done</h2>
      <p class="note">
        {dodProven} proven by this run, {dodFailed} disproven, {dodUnknown} that reading source cannot
        settle either way. An item marked <em>needs a live run</em> is not a pass and is never counted
        as one.
      </p>
      <ul class="dod">
        {report.dod.map((d) => (
          <li>
            <span class={'pill ' + dodTone(d.met)}>{dodMark(d.met)}</span>
            <span class="dlabel">{d.label}</span>
            <span class="ddetail">{d.detail}</span>
          </li>
        ))}
      </ul>
    </section>

    {hasByDesign && (
      <section class="panel">
        <h2>Second stores that state their reason</h2>
        <p class="note">
          These are design decisions somebody made on purpose, recorded here so a later reviewer does
          not close them as defects or open them as new ones.
        </p>
        <ul class="plain">
          {byDesign.map((d) => (
            <li><code>{d.duplicateTable}</code> — {d.sentence}</li>
          ))}
        </ul>
      </section>
    )}

    <footer class="foot">
      <p>
        This page reads the repository, not the database. It establishes which tables this codebase
        intends to exist, not which ones a live environment has. For the same report in a terminal,
        with a non-zero exit on a blocking finding:
        <code>npx tsx scripts/horizon-check.mjs --strict</code>
      </p>
    </footer>
  </div>
</AdminLayout>

<style>
  .wrap { max-width: 1080px; margin: 0 auto; padding: 24px 20px 80px; }
  .head h1 { font-size: 26px; margin: 0 0 6px; letter-spacing: -0.01em; }
  .sub { margin: 0 0 22px; color: #6b6459; font-size: 14px; line-height: 1.55; max-width: 70ch; }

  .verdict { border: 1px solid #e2ddd3; border-left-width: 4px; border-radius: 6px; padding: 16px 18px; margin-bottom: 18px; background: #fdfcfa; }
  .verdict.ok { border-left-color: #2f7d4f; }
  .verdict.warn { border-left-color: #b3760f; }
  .verdict.bad { border-left-color: #9d2f2f; }
  .verdict.muted { border-left-color: #9a938a; }
  .vlabel { font-size: 12px; letter-spacing: 0.09em; text-transform: uppercase; color: #6b6459; margin-bottom: 6px; }
  .vline { margin: 0; font-size: 16px; line-height: 1.55; color: #241f1a; }
  .vmeta { margin: 8px 0 0; font-size: 12px; color: #8a8279; }

  .counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin-bottom: 22px; }
  .count { border: 1px solid #e2ddd3; border-radius: 6px; padding: 12px 14px; background: #fff; }
  .count b { display: block; font-size: 22px; font-weight: 600; color: #241f1a; }
  .count span { font-size: 12px; color: #6b6459; }
  .count.bad b { color: #9d2f2f; }
  .count.ok b { color: #2f7d4f; }

  .panel { border: 1px solid #e2ddd3; border-radius: 6px; padding: 18px; margin-bottom: 18px; background: #fff; }
  .panel.bad-panel { border-color: #e3c9c9; background: #fffafa; }
  .panel h2 { font-size: 15px; margin: 0 0 8px; letter-spacing: 0.01em; }
  .note { margin: 0 0 14px; font-size: 13px; line-height: 1.6; color: #6b6459; max-width: 78ch; }

  .grid { width: 100%; border-collapse: collapse; font-size: 13px; }
  .grid th { text-align: left; font-weight: 600; color: #6b6459; font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; padding: 6px 10px 6px 0; border-bottom: 1px solid #e2ddd3; }
  .grid td { padding: 8px 10px 8px 0; border-bottom: 1px solid #f0ece5; vertical-align: top; }
  .grid .dim { color: #8a8279; }

  .plain { margin: 0; padding-left: 18px; font-size: 13px; line-height: 1.65; color: #3d372f; }
  .plain li { margin-bottom: 6px; }

  .tables { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }

  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: #f5f2ec; padding: 1px 5px; border-radius: 3px; color: #3d372f; }

  .modules { list-style: none; margin: 0; padding: 0; }
  .modules li { padding: 12px 0; border-bottom: 1px solid #f0ece5; }
  .modules li:last-child { border-bottom: 0; }
  .mhead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pnum { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: #8a8279; }
  .mtitle { font-weight: 600; font-size: 14px; color: #241f1a; }
  .msent { margin: 5px 0 4px; font-size: 13px; line-height: 1.6; color: #3d372f; max-width: 80ch; }
  .mmeta { margin: 0; font-size: 11px; color: #8a8279; display: flex; gap: 12px; flex-wrap: wrap; }
  .warnflag { color: #b3760f; }
  .okflag { color: #2f7d4f; }

  .pill { font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid #e2ddd3; color: #6b6459; white-space: nowrap; }
  .pill.ok { border-color: #bcd9c6; background: #f2f9f4; color: #2f7d4f; }
  .pill.warn { border-color: #e6d3ab; background: #fdf8ee; color: #8a5c0b; }
  .pill.bad { border-color: #e3c9c9; background: #fdf4f4; color: #9d2f2f; }
  .pill.muted { border-color: #e2ddd3; background: #f7f5f1; color: #6b6459; }

  .dod { list-style: none; margin: 0; padding: 0; }
  .dod li { display: grid; grid-template-columns: 130px 1fr; gap: 6px 12px; padding: 9px 0; border-bottom: 1px solid #f0ece5; align-items: start; }
  .dod li:last-child { border-bottom: 0; }
  .dlabel { font-size: 13px; font-weight: 600; color: #241f1a; }
  .ddetail { grid-column: 2; font-size: 12px; line-height: 1.6; color: #6b6459; max-width: 80ch; }

  .foot { margin-top: 24px; font-size: 12px; color: #8a8279; line-height: 1.65; }

  @media (max-width: 640px) {
    .wrap { padding: 16px 14px 60px; }
    .dod li { grid-template-columns: 1fr; }
    .ddetail { grid-column: 1; }
  }
</style>
