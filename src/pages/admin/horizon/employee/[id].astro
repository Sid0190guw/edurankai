---
// /admin/horizon/employee/[id] — PATCH 11, THE SUPER ADMIN EMPLOYEE PROFILE.
//
// TWELVE TABS, ONE PERSON, AND EVERY PANEL SAYS WHERE IT GOT WHAT IT SHOWS.
//
// The navigation principle is SUMMARY -> SIGNAL -> PATTERN -> EVIDENCE -> ORIGINAL AUTHORISED
// RECORD, and it is rendered as a ladder rather than described in a heading: every section prints
// how far down a reader can actually walk from it, and a summary that stops at "summary" is marked
// as a statement nobody has backed yet instead of being drawn the same as one that reaches a row.
//
// THIS PAGE OWNS NO EMPLOYEE DATA. Everything comes through src/lib/horizon/profile.ts, which
// consumes the identity spine, the evidence graph and any provider a producing patch has registered.
// There is no query in this file.
//
// FOUR THINGS THE PAGE REFUSES TO DO
//   - It never renders a section it was not granted. Withheld means not read, not read-then-hidden.
//   - It never prints "no records" when it means "not wired up" or "the read failed". Five statuses,
//     five different sentences.
//   - It never shows a score. There is no total, no average and no composite anywhere on it.
//   - It decides nothing. Every intelligence panel is advisory and says so in its own words.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { buildSuperAdminProfile } from '@/lib/horizon/profile';
import { PEOPLE_VIEW_360, PROPOSED_CAPABILITIES, DRILL_RUNG_LABELS, DRILL_RUNGS } from '@/lib/horizon/sections';
import {
  DATA_CLASS_LABELS,
  SIGNAL_WEIGHT_LABELS,
  SIGNAL_WEIGHT_MEANING,
  SECTION_STATUS_MEANING,
  SUSTAINABILITY_REFUSALS,
  PERSONAL_SUMMARY_REFUSALS,
  screenTerminology,
} from '@/lib/horizon/contracts';

// Every const above the handler. `const` is not hoisted, and a const read before its declaration
// throws on the first line of its caller — that pattern has taken pages down on this project.
const id = String(Astro.params.id || '');
const PATH = '/admin/horizon/employee/' + id;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

const holds = (k: string) => can(user as any, k as any);

// The page itself needs the assembled-record capability. Without it there is no profile to open at
// all, and saying so here is cheaper and clearer than rendering twelve withheld panels.
const mayOpen = holds(PEOPLE_VIEW_360);

const ip = Astro.request.headers.get('x-forwarded-for') || null;

const profile = mayOpen
  ? await buildSuperAdminProfile({
    employeeId: id,
    viewer: {
      userId: String(user.id),
      employeeId: null,
      role: String((user as any).role || ''),
      name: String((user as any).name || ''),
    },
    holds,
    ipAddress: ip,
  })
  : null;

// ---- EVERYTHING THE MARKUP NEEDS, RESOLVED HERE ------------------------------------------------
// Astro's JSX cannot carry a `<` comparison or a typed string map, so every derived value is
// computed in the frontmatter and the markup only reads it.
const sections = profile ? profile.sections : [];
const refusal = profile ? profile.refusal : null;
const overview = sections.find((s) => s.key === 'overview');
const overviewData: any = overview && overview.payload.status === 'ok' ? overview.payload.data : null;
const displayName = overviewData && overviewData.displayName ? overviewData.displayName : 'This person';
const grantedCount = profile ? profile.access.granted.length : 0;
const awaitingCount = profile ? profile.access.awaitingRatification.length : 0;
const conflicts = profile ? profile.conflicts : [];
const openLogFailed = !!profile && !profile.openLogged;
const asOfLabel = profile ? new Date(profile.asOf).toLocaleString('en-IN') : '';
const proposedList = PROPOSED_CAPABILITIES.join(', ');

const accessSentence = profile ? profile.access.sentence : '';
const openLogNote = profile ? profile.openLogNote : null;
// The wiring facts, printed in the footer. "No patch contributed" beside a list of eight registered
// patches is a different problem from the same sentence beside an empty list.
const registeredPatches = profile ? profile.registeredPatches : [];
const recordRefusal = profile ? profile.recordRefusal : null;
const registeredList = registeredPatches.join(', ');

const ACCENT = '#FF4F00';
const MUTED = '#6e6e78';

// Lookup maps are read through functions rather than indexed inside the markup: a typed
// Record<string, string> subscripted in an .astro expression is one of the shapes that has broken
// parsing on this project, and a helper costs nothing.
const weightLabel = (k: string) => (SIGNAL_WEIGHT_LABELS as any)[k] || k;
const weightMeaning = (k: string) => (SIGNAL_WEIGHT_MEANING as any)[k] || '';
const dataClassLabel = (k: string) => (DATA_CLASS_LABELS as any)[k] || k;
const statusMeaning = (k: string) => (SECTION_STATUS_MEANING as any)[k] || '';
const rungLabel = (k: string) => (DRILL_RUNG_LABELS as any)[k] || k;

const statusColour = (s: string) => {
  if (s === 'ok') return '#1f7a3d';
  if (s === 'empty') return MUTED;
  if (s === 'unreadable') return '#b3261e';
  if (s === 'not_supplied') return '#8a6d00';
  return '#5b5b66';
};

const rungIndex = (r: string) => DRILL_RUNGS.indexOf(r as any);

// Rule 19, enforced at the boundary rather than trusted: every provider-supplied label that reaches
// the screen goes through the terminology screen first. A label that names a birth-based method is
// replaced with the neutral term, and the substitution is counted so an operator finds out.
let substitutions = 0;
const safeLabel = (s: string) => {
  const c = screenTerminology(s);
  if (!c.clean) substitutions += 1;
  return c.text;
};
for (const s of sections) {
  for (const sig of s.payload.signals || []) {
    sig.label = safeLabel(sig.label);
    sig.statement = safeLabel(sig.statement);
  }
  for (const pat of s.payload.patterns || []) {
    pat.label = safeLabel(pat.label);
    pat.statement = safeLabel(pat.statement);
  }
}
---

<AdminLayout title={'Employee intelligence record'} activeNav="hr-employees">
  <div style="max-width:1120px;">

    <!-- HEADER -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px;">
      <div>
        <div style={`font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>
          Employee intelligence record
        </div>
        <h1 style="font-size:26px;font-weight:700;margin:6px 0 0;">{displayName}</h1>
      </div>
      <div style={`font-size:11px;color:${MUTED};text-align:right;line-height:1.7;`}>
        <div>Read at {asOfLabel}</div>
        <div>Viewing as {String((user as any).role || '')}</div>
      </div>
    </div>

    {!mayOpen && (
      <div style="border:1px solid #e4e4e8;border-left:3px solid #b3261e;padding:16px;border-radius:6px;margin-top:18px;">
        <div style="font-weight:700;font-size:14px;">You may not open an assembled person record.</div>
        <p style={`font-size:13px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>
          This page needs {PEOPLE_VIEW_360}. Nothing was read. This is not a statement that the record is empty,
          and it is not a statement about the person.
        </p>
      </div>
    )}

    {mayOpen && refusal && (
      <div style="border:1px solid #e4e4e8;border-left:3px solid #b3261e;padding:16px;border-radius:6px;margin-top:18px;">
        <div style="font-weight:700;font-size:14px;">Nothing was opened.</div>
        <p style={`font-size:13px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>{refusal}</p>
      </div>
    )}

    {mayOpen && !refusal && (
      <div>

        <!-- WHAT YOU MAY SEE, SAID BEFORE ANYTHING IS SHOWN -->
        <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px 16px;margin:16px 0;background:#fbfbfc;">
          <p style="font-size:13px;line-height:1.75;margin:0;">{accessSentence}</p>
          {awaitingCount > 0 && (
            <p style={`font-size:12px;color:${MUTED};line-height:1.7;margin:10px 0 0;`}>
              {awaitingCount} interpretive section(s) are switched off for every role including super admin, because the
              capability behind each one has not been ratified: {proposedList}. The tab itself names what ratifying it
              would permit. Nothing was read for those tabs.
            </p>
          )}
        </div>

        {openLogFailed && (
          <div style="border:1px solid #f0d9a0;background:#fffaf0;border-radius:6px;padding:12px 16px;margin:0 0 16px;">
            <div style="font-size:12px;font-weight:700;">The record of you opening this page could not be written.</div>
            <p style={`font-size:12px;color:${MUTED};line-height:1.7;margin:6px 0 0;`}>{openLogNote}</p>
          </div>
        )}

        {conflicts.length > 0 && (
          <div style="border:1px solid #f0d9a0;background:#fffaf0;border-radius:6px;padding:12px 16px;margin:0 0 16px;">
            <div style="font-size:12px;font-weight:700;">Two patches claimed the same section.</div>
            <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:6px 0 0;padding-left:18px;`}>
              {conflicts.map((c) => (
                <li>{c.section}: held by {c.heldBy}, refused for {c.refused}</li>
              ))}
            </ul>
          </div>
        )}

        {substitutions > 0 && (
          <div style="border:1px solid #f0d9a0;background:#fffaf0;border-radius:6px;padding:12px 16px;margin:0 0 16px;">
            <div style="font-size:12px;font-weight:700;">{substitutions} label(s) were replaced before rendering.</div>
            <p style={`font-size:12px;color:${MUTED};line-height:1.7;margin:6px 0 0;`}>
              A producing patch returned copy naming a birth-based method. The neutral term was rendered instead. Fix the
              provider so the substitution is not needed.
            </p>
          </div>
        )}

        <!-- THE LADDER, DRAWN ONCE -->
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 18px;">
          {DRILL_RUNGS.map((r, i) => (
            <span style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:${i === 0 ? ACCENT : MUTED};`}>
              {rungLabel(r)}{i === 4 ? '' : '  ·'}
            </span>
          ))}
        </div>

        <!-- TABS -->
        <div style="border-bottom:1px solid #e4e4e8;overflow-x:auto;">
          <div style="display:flex;gap:0;min-width:max-content;" id="hzNav">
            {sections.map((s, i) => (
              <button
                data-tab={i}
                class="hz-tab"
                style={`background:none;border:none;border-bottom:2px solid ${i === 0 ? ACCENT : 'transparent'};color:${i === 0 ? '#FF7040' : MUTED};font-size:12px;font-weight:600;padding:12px 13px;cursor:pointer;white-space:nowrap;`}
              >
                {s.label}
                {!s.grant.granted && <span style="opacity:0.55;font-weight:500;"> · locked</span>}
              </button>
            ))}
          </div>
        </div>

        <!-- PANELS -->
        {sections.map((s, i) => (
          <div id={'hz-panel-' + i} class="hz-panel" style={i === 0 ? 'padding-top:20px;' : 'display:none;padding-top:20px;'}>

            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap;">
              <h2 style="font-size:18px;font-weight:700;margin:0;">{s.label}</h2>
              <span style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:${statusColour(s.payload.status)};`}>
                {s.payload.status.replace('_', ' ')}
              </span>
            </div>
            <p style={`font-size:12px;color:${MUTED};line-height:1.75;margin:8px 0 0;max-width:78ch;`}>{s.blurb}</p>

            <!-- WHY THIS PANEL LOOKS THE WAY IT DOES -->
            <div style="border:1px solid #e4e4e8;border-radius:6px;padding:12px 14px;margin:14px 0 0;background:#fbfbfc;">
              <p style="font-size:12.5px;line-height:1.75;margin:0;">{s.payload.sentence || s.grant.because}</p>
              <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>
                {statusMeaning(s.payload.status)} Owed by {s.payload.owedBy}.
                {s.grant.capability ? ' Opens on ' + s.grant.capability + '.' : ' Needs no capability of its own.'}
                {s.grant.sensitive ? ' Sensitive: opening it is written to the audit log before it renders.' : ''}
              </p>
              {s.grant.accessLogNote && (
                <p style="font-size:11px;color:#b3261e;line-height:1.7;margin:8px 0 0;">{s.grant.accessLogNote}</p>
              )}
            </div>

            <!-- THE REFUSALS THAT MUST APPEAR ABOVE THE CONTENT, WHATEVER THE CONTENT IS -->
            {s.key === 'work_sustainability' && (
              <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:14px 0 0;padding-left:18px;`}>
                {SUSTAINABILITY_REFUSALS.map((r) => (<li>{r}</li>))}
              </ul>
            )}
            {s.key === 'personal_intelligence_summary' && (
              <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:14px 0 0;padding-left:18px;`}>
                {PERSONAL_SUMMARY_REFUSALS.map((r) => (<li>{r}</li>))}
              </ul>
            )}

            <!-- OVERVIEW -->
            {s.key === 'overview' && s.payload.status === 'ok' && s.payload.data && (
              <div style="margin-top:18px;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;">
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                    <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Identity</div>
                    {(s.payload.data as any).identity.map((r: any) => (
                      <div style="margin-top:10px;">
                        <div style="font-size:13px;font-weight:600;">{r.label}: {r.value}</div>
                        <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{r.assertionLabel} · {r.basis}</div>
                      </div>
                    ))}
                  </div>
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                    <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Employment</div>
                    {(s.payload.data as any).employment.map((r: any) => (
                      <div style="margin-top:10px;">
                        <div style="font-size:13px;font-weight:600;">{r.label}: {r.value}</div>
                        <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{r.assertionLabel} · {r.basis}</div>
                      </div>
                    ))}
                  </div>
                </div>

                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-top:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>
                    How these records were linked
                  </div>
                  <p style="font-size:12.5px;line-height:1.75;margin:8px 0 0;">{(s.payload.data as any).linkageSentence}</p>
                  <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:8px 0 0;padding-left:18px;`}>
                    {(s.payload.data as any).edges.map((e: any) => (<li>{e.sentence}</li>))}
                  </ul>
                  {(s.payload.data as any).unconfirmed.map((u: any) => (
                    <p style="font-size:12px;color:#8a6d00;line-height:1.7;margin:8px 0 0;">{u.sentence}</p>
                  ))}
                </div>

                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-top:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>
                    What this record does not hold, for anybody
                  </div>
                  <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:8px 0 0;padding-left:18px;`}>
                    {(s.payload.data as any).neverComposed.map((n: any) => (<li>{n.what} — {n.because}</li>))}
                  </ul>
                </div>
              </div>
            )}

            <!-- PROFESSIONAL PROFILE -->
            {s.key === 'professional_profile' && s.payload.status === 'ok' && s.payload.data && (
              <div style="margin-top:18px;">
                {(s.payload.data as any).reportingLine && (
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-bottom:14px;">
                    <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Reporting line</div>
                    <p style="font-size:12.5px;line-height:1.75;margin:8px 0 0;">{(s.payload.data as any).reportingLine.sentence}</p>
                  </div>
                )}
                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Skills, with what backs each one</div>
                  {(s.payload.data as any).skills.map((k: any) => (
                    <div style="margin-top:10px;padding-top:10px;border-top:1px solid #f0f0f2;">
                      <div style="font-size:13px;font-weight:600;">{k.name} · {k.level}</div>
                      <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{k.assertion} · {k.basis}</div>
                    </div>
                  ))}
                  {(s.payload.data as any).claimed.map((c: any) => (
                    <div style="margin-top:10px;padding-top:10px;border-top:1px solid #f0f0f2;">
                      <div style="font-size:13px;font-weight:600;">{c.keyword}</div>
                      <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>
                        A word somebody typed, from {c.from}. {c.resolved ? 'It matches a catalogue name — a name match, not evidence.' : 'It matches nothing in the skill catalogue.'}
                      </div>
                    </div>
                  ))}
                </div>
                {(s.payload.data as any).notRead.length > 0 && (
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-top:14px;">
                    <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Not read</div>
                    <ul style={`font-size:12px;color:${MUTED};line-height:1.8;margin:8px 0 0;padding-left:18px;`}>
                      {(s.payload.data as any).notRead.map((n: any) => (<li>{n.aspect}: {n.because}</li>))}
                    </ul>
                  </div>
                )}
              </div>
            )}

            <!-- PERFORMANCE & WORK RECORDS -->
            {s.key === 'performance_work_records' && s.payload.status === 'ok' && s.payload.data && (
              <div style="margin-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;">
                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Review cycles</div>
                  {(s.payload.data as any).reviews.map((r: any) => (
                    <div style="margin-top:10px;">
                      <div style="font-size:13px;font-weight:600;">{r.cycle || 'Unnamed cycle'}{r.outcome ? ' · ' + r.outcome : ''}</div>
                      <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{r.basis}</div>
                    </div>
                  ))}
                </div>
                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Work submitted</div>
                  {(s.payload.data as any).projects.map((x: any) => (
                    <div style="margin-top:10px;">
                      <div style="font-size:13px;font-weight:600;">{x.title}</div>
                      <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{x.kind} · {x.status}</div>
                    </div>
                  ))}
                </div>
                <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                  <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>Goals</div>
                  {(s.payload.data as any).goals.map((g: any) => (
                    <div style="margin-top:10px;">
                      <div style="font-size:13px;font-weight:600;">{g.title}</div>
                      <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{g.kind} · {g.status} · {g.progressPct}%</div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- EVIDENCE & RECORDS -->
            {s.key === 'evidence_records' && s.payload.status === 'ok' && s.payload.data && (
              <div style="margin-top:18px;border:1px solid #e4e4e8;border-radius:6px;padding:14px;">
                {(s.payload.data as any).claims.map((c: any) => (
                  <div style="margin-top:10px;padding-top:10px;border-top:1px solid #f0f0f2;">
                    <div style="font-size:13px;font-weight:600;">{c.skill} · {c.levelLabel}</div>
                    <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>{c.levelMeaning}</div>
                    <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>
                      Recorded from {c.source}{c.sourceDetail ? ' (' + c.sourceDetail + ')' : ''}{c.linkedVia ? ' · reached via ' + c.linkedVia : ''}
                    </div>
                    <a href={c.href} style={`font-size:11px;color:${ACCENT};font-weight:600;text-decoration:none;`}>Open the original record</a>
                  </div>
                ))}
              </div>
            )}

            <!-- AUDIT TRAIL -->
            {s.key === 'audit_trail' && s.payload.status === 'ok' && s.payload.data && (
              <div style="margin-top:18px;">
                <div style="border:1px solid #e4e4e8;border-radius:6px;overflow-x:auto;">
                  <table style="width:100%;border-collapse:collapse;font-size:12px;min-width:600px;">
                    <thead>
                      <tr style="text-align:left;">
                        <th style={`padding:10px 12px;color:${MUTED};font-weight:700;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;`}>When</th>
                        <th style={`padding:10px 12px;color:${MUTED};font-weight:700;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;`}>Who</th>
                        <th style={`padding:10px 12px;color:${MUTED};font-weight:700;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;`}>Action</th>
                        <th style={`padding:10px 12px;color:${MUTED};font-weight:700;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;`}>Section</th>
                      </tr>
                    </thead>
                    <tbody>
                      {(s.payload.data as any).entries.map((e: any) => (
                        <tr style="border-top:1px solid #f0f0f2;">
                          <td style="padding:10px 12px;">{e.at ? new Date(e.at).toLocaleString('en-IN') : ''}</td>
                          <td style="padding:10px 12px;">{e.byName || e.byUserId || 'unattributed'}{e.byRole ? ' · ' + e.byRole : ''}</td>
                          <td style="padding:10px 12px;">{e.action}</td>
                          <td style="padding:10px 12px;">{e.section || ''}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <ul style={`font-size:11px;color:${MUTED};line-height:1.8;margin:10px 0 0;padding-left:18px;`}>
                  {(s.payload.data as any).caveats.map((c: string) => (<li>{c}</li>))}
                </ul>
              </div>
            )}

            <!-- WHAT THE MASTER RECORD CONTRIBUTED TO THIS TAB -->
            {s.payload.data && (s.payload.data as any).findings && (
              <div style="margin-top:18px;">
                {(s.payload.data as any).findings.map((f: any) => (
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-bottom:10px;">
                    <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline;">
                      <div style="font-size:13px;font-weight:600;">{f.dimensionLabel}</div>
                      <span style={`font-size:10px;letter-spacing:0.08em;text-transform:uppercase;font-weight:700;color:${MUTED};`}>
                        {f.familyLabel}
                      </span>
                    </div>
                    <p style="font-size:14px;font-weight:600;margin:8px 0 0;">{f.valueText}</p>
                    {f.summary && <p style="font-size:12.5px;line-height:1.75;margin:6px 0 0;">{f.summary}</p>}
                    {f.unreadable && (
                      <p style="font-size:12px;color:#b3261e;line-height:1.7;margin:6px 0 0;">{f.unreadable}</p>
                    )}
                    <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>
                      {dataClassLabel(f.dataClass)} · {f.decisionUse === 'may_decide' ? 'may support a decision' : 'advisory only, may not carry a decision'}
                      {' · method ' + f.scientificStatus}
                      {' · human review ' + f.humanReviewStatus}
                      {f.confidence.value === null ? ' · no confidence stated' : ' · confidence ' + f.confidence.band}
                      {' · ' + f.confidence.basis}
                    </p>
                    <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:4px 0 0;`}>
                      Produced by {f.patchId} using {f.engine}
                      {f.computedAt ? ', computed ' + new Date(f.computedAt).toLocaleString('en-IN') : ', with no computation time on the record'}.
                    </p>
                    {f.evidence.map((e: any) => (
                      <div style="border-top:1px solid #f0f0f2;margin-top:10px;padding-top:10px;">
                        <div style="font-size:12px;line-height:1.7;">{e.sentence}</div>
                        <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>
                          {e.ownerModule}{e.sourceTable ? ' · ' + e.sourceTable : ''}{e.sourceId ? ' · ' + e.sourceId : ''}
                          {e.occurredAt ? ' · ' + new Date(e.occurredAt).toLocaleDateString('en-IN') : ''}
                        </div>
                        {e.documentUrl && <a href={e.documentUrl} rel="noreferrer noopener" target="_blank" style={`font-size:11px;color:${ACCENT};font-weight:600;text-decoration:none;`}>Open the linked document</a>}
                      </div>
                    ))}
                  </div>
                ))}
                {(s.payload.data as any).degraded.length > 0 && (
                  <p style="font-size:12px;color:#b3261e;line-height:1.7;">
                    Could not be read: {(s.payload.data as any).degraded.join(', ')}. This tab is incomplete, not empty.
                  </p>
                )}
              </div>
            )}

            <!-- THE LADDER FOR THIS SECTION: SIGNAL -> PATTERN -> EVIDENCE -> RECORD -->
            {s.payload.patterns.length > 0 && (
              <div style="margin-top:18px;">
                <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;margin-bottom:8px;`}>Patterns</div>
                {s.payload.patterns.map((p) => (
                  <div style="border:1px solid #e4e4e8;border-radius:6px;padding:14px;margin-bottom:10px;">
                    <div style="font-size:13px;font-weight:600;">{p.label}</div>
                    <p style="font-size:12.5px;line-height:1.75;margin:6px 0 0;">{p.statement}</p>
                    <div style={`font-size:11px;color:${MUTED};line-height:1.7;margin-top:6px;`}>
                      {p.signalIds.length} signal(s){p.counterSignalIds.length > 0 ? ' · ' + p.counterSignalIds.length + ' pointing the other way' : ' · nothing on record points the other way'}
                      {p.confidence.value === null ? ' · no confidence stated' : ' · confidence ' + p.confidence.band}
                      {' · ' + p.confidence.basis}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {s.payload.signals.length > 0 && (
              <div style="margin-top:18px;">
                <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;margin-bottom:8px;`}>
                  Signals under this section
                </div>
                {s.payload.signals.map((sig) => (
                  <details style="border:1px solid #e4e4e8;border-radius:6px;padding:12px 14px;margin-bottom:8px;">
                    <summary style="cursor:pointer;font-size:13px;font-weight:600;list-style:none;">
                      {sig.label}
                      <span style={`font-weight:500;color:${MUTED};font-size:11px;`}> · {weightLabel(sig.weightClass)} · {dataClassLabel(sig.dataClass)}</span>
                      {sig.disputed && <span style="color:#b3261e;font-size:11px;font-weight:700;"> · disputed</span>}
                    </summary>
                    <p style="font-size:12.5px;line-height:1.75;margin:10px 0 0;">{sig.statement}</p>
                    <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>{weightMeaning(sig.weightClass)}</p>
                    <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:6px 0 0;`}>
                      {sig.confidence.value === null ? 'No confidence stated.' : 'Confidence ' + sig.confidence.band + '.'} {sig.confidence.basis}
                      {sig.observedAt ? ' Observed ' + new Date(sig.observedAt).toLocaleDateString('en-IN') + '.' : ' No observation date on the record.'}
                      {' Produced by ' + sig.producedBy + '.'}
                    </p>
                    {sig.evidence.map((e) => (
                      <div style="border-top:1px solid #f0f0f2;margin-top:10px;padding-top:10px;">
                        <div style="font-size:12px;line-height:1.7;">{e.sentence}</div>
                        <div style={`font-size:11px;color:${MUTED};line-height:1.6;`}>
                          {e.ownerModule}{e.sourceTable ? ' · ' + e.sourceTable : ''}{e.locator ? ' · ' + e.locator : ''}
                          {e.occurredAt ? ' · ' + new Date(e.occurredAt).toLocaleDateString('en-IN') : ''}
                        </div>
                        {e.href && <a href={e.href} style={`font-size:11px;color:${ACCENT};font-weight:600;text-decoration:none;`}>Open the original authorised record</a>}
                        {!e.href && e.documentUrl && <a href={e.documentUrl} rel="noreferrer noopener" target="_blank" style={`font-size:11px;color:${ACCENT};font-weight:600;text-decoration:none;`}>Open the linked document</a>}
                        {!e.href && !e.documentUrl && <div style={`font-size:11px;color:${MUTED};`}>No original record was linked to this, so the last step opens nothing.</div>}
                      </div>
                    ))}
                  </details>
                ))}
              </div>
            )}

            <!-- HOW FAR DOWN THIS SECTION CAN BE WALKED -->
            <div style="margin-top:16px;border-top:1px solid #f0f0f2;padding-top:12px;">
              <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                {DRILL_RUNGS.map((r, ri) => (
                  <span style={`font-size:10px;letter-spacing:0.08em;text-transform:uppercase;font-weight:700;color:${ri > rungIndex(s.depth) ? '#c9c9d0' : ACCENT};`}>
                    {rungLabel(r)}{ri === 4 ? '' : '  ·'}
                  </span>
                ))}
              </div>
              <p style={`font-size:11px;color:${MUTED};line-height:1.7;margin:8px 0 0;`}>{s.depthSentence}</p>
            </div>

          </div>
        ))}

        <!-- WHAT IS ACTUALLY WIRED UP -->
        <div style="margin-top:28px;border-top:1px solid #e4e4e8;padding-top:14px;">
          <div style={`font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${MUTED};font-weight:700;`}>
            Where this page gets its intelligence
          </div>
          <p style={`font-size:11.5px;color:${MUTED};line-height:1.75;margin:8px 0 0;max-width:80ch;`}>
            The interpretive tabs are composed from the Master Employee Intelligence Record, which holds no
            intelligence of its own: each producing patch registers a provider and the record is assembled at
            read time. {registeredPatches.length > 0
              ? 'Registered in this process: ' + registeredList + '.'
              : 'No provider is registered in this process, so every provider-backed tab reads as not supplied rather than as empty.'}
          </p>
          {recordRefusal && (
            <p style="font-size:11.5px;color:#b3261e;line-height:1.75;margin:8px 0 0;">{recordRefusal}</p>
          )}
        </div>

      </div>
    )}
  </div>
</AdminLayout>

<script>
  (function () {
    var tabs = document.querySelectorAll('.hz-tab');
    var panels = document.querySelectorAll('.hz-panel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var idx = tab.getAttribute('data-tab');
        panels.forEach(function (p) { p.style.display = 'none'; });
        tabs.forEach(function (t) {
          t.style.borderBottomColor = 'transparent';
          t.style.color = '#6e6e78';
        });
        var panel = document.getElementById('hz-panel-' + idx);
        if (panel) panel.style.display = 'block';
        tab.style.borderBottomColor = '#FF4F00';
        tab.style.color = '#FF7040';
      });
    });
  })();
</script>
