---
import AdminLayout from '@/layouts/AdminLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { applications, brandProfiles, offerLetters } from '@/lib/db/schema';
import { eq, asc } from 'drizzle-orm';
import { buildTemplateGrid, ROLE_LEVELS, type RoleLevel } from '@/lib/offer-templates';
import { ENGAGEMENT_POLICIES, shortCommitment, resolveEngagementPolicy } from '@/lib/engagement-policy';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// Token-aware access: if user is applicant, allow only when ?from=<their-own-app-id>
const urlForGate = new URL(Astro.request.url);
const fromAppId = urlForGate.searchParams.get('from');

if (user.role === 'applicant') {
  if (!fromAppId) return Astro.redirect('/portal');
  const ownCheck = await db.select({ uid: applications.applicantUserId }).from(applications)
    .where(eq(applications.id, fromAppId))
    .limit(1);
  if (ownCheck.length === 0 || ownCheck[0].uid !== user.id) return Astro.redirect('/portal');
}

// Pick layout based on role: applicants get BaseLayout (no admin chrome)
const Layout: any = user.role === 'applicant' ? BaseLayout : AdminLayout;
const isApplicant = user.role === 'applicant';

// Load brand profiles
let brands: any[] = [];
try {
  brands = await db.select().from(brandProfiles).where(eq(brandProfiles.isActive, true)).orderBy(asc(brandProfiles.sortOrder));
} catch (e) {
  // Table may not exist yet
  brands = [];
}

if (brands.length === 0) {
  brands = [
    { slug: 'edurankai', name: 'EduRankAI', tagline: 'BHARAT-BUILT FRONTIER AI LAB', primaryColor: '#FF4F00', domain: 'edurankai.in' },
    { slug: 'karate-support', name: 'Karate Support', tagline: 'POWERED BY EDURANKAI', primaryColor: '#FF4F00', domain: 'karate.support' },
    { slug: 'other', name: 'Other', tagline: 'POWERED BY EDURANKAI', primaryColor: '#FF4F00', domain: null }
  ];
}

// Pre-fill from applicationId
let prefill: any = null;
let savedOffer: any = null;
if (fromAppId) {
  const found = await db.select().from(applications).where(eq(applications.id, fromAppId)).limit(1);
  if (found.length > 0) prefill = found[0];
  // If a persisted offer letter exists for this application, reuse its real
  // verification token + ref number so the PDF's verify link resolves to the
  // same record the web verify page reads.
  const off = await db.select().from(offerLetters).where(eq(offerLetters.applicationId, fromAppId)).limit(1);
  if (off.length > 0) savedOffer = off[0];
}

const today = new Date().toISOString().split('T')[0];
const refNumber = (savedOffer && savedOffer.refNumber) ? savedOffer.refNumber : 'ERA-2026-' + Math.random().toString(36).substring(2, 8).toUpperCase();
// Real DB token for the verify link (empty when generating a brand-new/blank offer)
const realOfferToken = savedOffer && savedOffer.token ? savedOffer.token : '';

const defaults = {
  brandSlug: 'edurankai',
  candidateName: prefill ? ((prefill.firstName || '') + ' ' + (prefill.lastName || '')).trim() : '',
  candidateEmail: prefill ? prefill.email : '',
  candidatePhone: prefill && prefill.phone ? prefill.phone : '',
  candidateCity: prefill && prefill.city ? prefill.city : '',
  roleTitle: prefill && prefill.roleTitleSnapshot ? prefill.roleTitleSnapshot : '',
  department: prefill && prefill.departmentSnapshot ? prefill.departmentSnapshot : '',
  employmentType: 'Internship',
  workMode: 'Remote',
  duration: '3 Months',
  // From src/lib/engagement-policy.ts. The old default, "2.5 hrs/day, 5 days/week", appears
  // nowhere in the published internship policy — that is six days and about 40 hours of TOTAL
  // ENGAGEMENT, of which five hours a day is project work and 1 hour 40 minutes is well-being.
  // This form prefills the internship because the rest of its defaults do; the offer page resolves
  // the correct policy for the level regardless of what is typed here.
  hoursCommitment: shortCommitment(ENGAGEMENT_POLICIES['Intern']),
  compensation: 'Unpaid',
  reportingTo: '',
  offerDate: today,
  joiningDate: '',
  expiryDate: '',
  responseDeadline: '',
  signatoryName: user.name || 'Siddharth Prasad',
  signatoryTitle: 'Founder & CEO',
  customNote: '',
  refNumber
};

const brandsJson = JSON.stringify(brands);

// THE PREVIEW HAD ITS OWN COPY OF THE LETTER, and its own intern fallback:
// `bodyTemplates[empType] || bodyTemplates.Internship`, plus a hardcoded opening reading "we are
// pleased to extend this formal offer of an <employment type>". That is the same failure as the one
// on the candidate-facing letter, in a second place, drifting independently.
//
// The sentences now come from src/lib/offer-templates.ts. Selection cannot run in the browser on
// every keystroke, so the REAL selector runs here, on the server, once per employment type the form
// offers, crossed with "does the role title read as senior". The preview looks the answer up; it
// owns no rules and no copy. The fallback entry is the neutral template, never the intern one.
const EMPLOYMENT_TYPES = ['Internship', 'Apprenticeship', 'Full-Time', 'Contract', 'Part-Time'];
const templateGridJson = JSON.stringify(buildTemplateGrid(EMPLOYMENT_TYPES));

// THE HOURS BOX WAS A FIXED INTERN STRING AND NOTHING EVER CHANGED IT.
//
// `defaults.hoursCommitment` prefills the internship commitment because the rest of this form's
// defaults are an internship. Switching Employment Type to Full-Time did not touch it — so an
// admin writing a mid-level employment offer kept "6 days/week, ~40 h total engagement (5h project
// + 1h 40m well-being per day)" sitting in the box, and the professional template DOES print
// {hoursCommitment}. A salaried employee was being handed an intern's counted programme as their
// working time, from a value nobody had chosen and nobody had noticed.
//
// The same resolver the letter uses answers it here, once per employment type crossed with every
// level the title can read as — computed on the server so the browser holds no policy of its own.
// Keys match the template grid exactly, so the preview does one lookup for both.
const hoursByKey: Record<string, string> = {};
for (const et of EMPLOYMENT_TYPES) {
  for (const lvl of [...ROLE_LEVELS, null] as (RoleLevel | null)[]) {
    hoursByKey[et + '|' + (lvl || 'unknown')] = shortCommitment(
      resolveEngagementPolicy({ level: lvl, engagementType: et, roleTitle: '' }),
    );
  }
}
const hoursByKeyJson = JSON.stringify(hoursByKey);
---
<Layout title="Offer Letter Builder" description="Professional offer letter builder with brand switching.">
<style is:global>
  body.applicant-view-mode .ofl,
  body.applicant-view-mode .ofi,
  body.applicant-view-mode .form-section,
  body.applicant-view-mode #leftPanel,
  body.applicant-view-mode .left-form-column,
  body.applicant-view-mode .lg\:col-span-1 > .bg-white\/5,
  body.applicant-view-mode .lg\:col-span-2 > .bg-white\/5,
  body.applicant-view-mode .grid > div:has(.ofl),
  body.applicant-view-mode .grid > div:first-child {
    display: none !important;
  }
  body.applicant-view-mode .grid {
    display: block !important;
    grid-template-columns: none !important;
  }
  body.applicant-view-mode #downloadBtn,
  body.applicant-view-mode #printBtn {
    display: inline-block !important;
    position: fixed;
    bottom: 24px;
    z-index: 100;
  }
  body.applicant-view-mode #downloadBtn { left: 24px; }
  body.applicant-view-mode #printBtn { left: 200px; }
</style>
<script is:inline define:vars={{ isApp: isApplicant }}>
  if (isApp) document.body.classList.add('applicant-view-mode');
</script>

  <div class="mb-4">
    <a href="/admin/applications" class="text-[0.78rem] text-white/50 hover:text-white">&larr; Back to applications</a>
  </div>

  <div class="mb-5 pb-4 border-b border-white/8">
    <p class="font-mono text-[0.7rem] text-burn">OFFER BUILDER</p>
    <h1 class="font-display text-[1.6rem] font-semibold text-white">Create Offer Letter</h1>
    <p class="text-[0.85rem] text-white/60 mt-1">Live preview. Switch brand. Download as PDF or print.</p>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-5 gap-5">

    <!-- FORM (left, 2 of 5 cols) -->
    <div class="xl:col-span-2 flex flex-col gap-4">

      <div class="bg-white/5 border border-white/10 rounded-xl p-5">
