---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { users } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { sql } from 'drizzle-orm';
import { generateSessionToken, createSession } from '@/lib/auth/session';
import { setSessionCookie } from '@/lib/auth/cookie';
import { findUserByLoginIdentifier, verifyPasswordForLogin } from '@/lib/auth/handle';
import {
  isSecondStepRequired, availableSecondFactors, startPendingChallenge,
  resolvePendingChallenge, verifySecondFactor, dropPendingChallenge,
  pendingCookieName, verifyFaceSecondFactor, canCompleteSecondStep,
  passwordAttemptsBlocked, recordFailedPassword, clearPasswordAttempts,
  PASSWORD_THROTTLED_MESSAGE,
  PENDING_TTL_SECONDS, PENDING_COOKIE_SECURE,
  type SecondFactorMethod,
} from '@/lib/auth/two-factor';
// EVERY DATABASE WAIT ON THE SIGN-IN PATH IS BOUNDED FROM HERE DOWN.
//
// What an admin saw before: they typed their password, pressed Sign in, and the form posted into
// nothing — a spinning tab until the platform killed the invocation and served
// FUNCTION_INVOCATION_TIMEOUT. The catch at the bottom of the password branch has said
// "Sign-in is temporarily unavailable" since the day a bare catch here hid a total sign-in outage,
// but a catch cannot catch a wait, and on this deployment opening a connection is what fails
// (~810ms when it works, no answer at all in roughly a quarter of the attempts that have to open
// one). So the one console that could fix an outage was the one console nobody could get into.
//
// withDbRetry for the reads — a second ask usually reuses the connection the abandoned attempt left
// in the pool. withDbTimeout, never a retry, for anything that WRITES: a challenge, a session, a
// rate-limit counter. See src/lib/db-timeout.ts for the measurement behind both.
import { withDbRetry, withDbTimeout } from '@/lib/db-timeout';

// Every `const` this handler touches is declared BEFORE the handler — `const`
// is not hoisted, and that has taken pages down here before.
const SURFACE = 'admin' as const;
/** The source address, in the shape every limiter on this project keys on. */
const CLIENT_IP = (Astro.clientAddress || Astro.request.headers.get('x-forwarded-for') || 'unknown')
  .toString().split(',')[0].trim().slice(0, 64);
const PENDING_COOKIE = pendingCookieName(SURFACE);
const LEGACY_FACE_COOKIE = 'face_pending_user';
const LEGACY_TFA_COOKIE = 'admin_tfa_pending';

async function startSession(userId: string, req: Request, ip: string | undefined, cookies: any) {
  const token = generateSessionToken();
  // The bound goes around createSession and NOT around this whole function, so the cookie is still
  // written only after a session row we actually waited for. A timeout here throws to the caller's
  // catch, which says so; nobody walks away holding a cookie for a session we never confirmed.
  const session = await withDbTimeout(createSession(token, userId, {
    userAgent: req.headers.get('user-agent') || undefined,
    ipAddress: ip,
  }), 'adminLogin.createSession');
  setSessionCookie(cookies, token, session.expiresAt);
}

function setPendingCookie(cookies: any, token: string) {
  cookies.set(PENDING_COOKIE, token, {
    path: '/', httpOnly: true, sameSite: 'lax', secure: PENDING_COOKIE_SECURE, maxAge: PENDING_TTL_SECONDS,
  });
}
function clearPendingCookies(cookies: any) {
  cookies.delete(PENDING_COOKIE, { path: '/' });
  // Retire the old raw-user-id cookies if a browser still carries one.
  cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
  cookies.delete(LEGACY_TFA_COOKIE, { path: '/' });
}

// Already logged in?
if (Astro.locals.user) {
  return Astro.redirect('/admin');
}

let errorMsg = '';
let noticeMsg = '';
let requireSecondStep = false;
let pendingUserName = '';
let offerFace = false;
let offerCode = false;

// The half-finished sign-in is named by an opaque token we minted, never by a
// user id the client can type. Previously this cookie held a raw uuid, which
// meant setting it by hand skipped the password outright.
let pendingToken = Astro.cookies.get(PENDING_COOKIE)?.value || '';

async function loadPendingState(token: string) {
  // Three reads, and this runs on the GET that draws the challenge — so before it was bounded a
  // stall here hung the login page itself, not just a submission.
  const pending = await withDbRetry(() => resolvePendingChallenge(token, SURFACE), 'adminLogin.pending');
  if (!pending) return null;
  const u = await withDbRetry(
    () => db.select({ name: users.name }).from(users).where(eq(users.id, pending.userId)).limit(1),
    'adminLogin.pendingName');
  pendingUserName = u[0]?.name || '';
  const methods = await withDbRetry(() => availableSecondFactors(pending.userId), 'adminLogin.pendingFactors');
  offerFace = methods.indexOf('face') >= 0;
  offerCode = methods.indexOf('totp') >= 0;
  requireSecondStep = true;
  return pending;
}

if (Astro.request.method === 'POST') {
  const fd2 = await Astro.request.formData();
  const action = fd2.get('action') as string;

  if (action === 'password_login') {
    // Accept a personal email OR an internal handle. Trimmed and matched
    // case-insensitively; a handle is an identifier, not a mailbox.
    const identifier = (fd2.get('email') as string || '').trim();
    const password = (fd2.get('password') as string || '').trim();

    // THIS USED TO BE `} else if (await passwordAttemptsBlocked(...)) {` — an unbounded database
    // wait sitting in the if-chain, OUTSIDE the try below that would have reported it. It was the
    // first thing every sign-in touched and the one await on this page that had nowhere to fail to.
    // Hoisted here so the wait is bounded and a failure lands somewhere that can speak.
    //
    // It stays FALSE when the counter cannot be read, which is the posture the limiter itself
    // documents (two-factor.ts: "letting the password check decide"). This counter is depth, not the
    // lock — the password and scrypt are still required either way — and refusing here on an
    // unreadable database would be a total sign-in outage across all four surfaces, which is the
    // exact failure this codebase has already shipped twice.
    let pwBlocked = false;
    if (identifier && password) {
      try {
        pwBlocked = await withDbRetry(() => passwordAttemptsBlocked(identifier, CLIENT_IP), 'adminLogin.throttle');
      } catch (e: any) {
        console.error('[admin/login throttle] attempt counter unreadable; letting the password check decide:',
          e?.cause?.message || e?.message);
        pwBlocked = false;
      }
    }

    if (!identifier || !password) {
      errorMsg = 'Enter your email or internal handle, and your password.';
    } else if (pwBlocked) {
      // This console is the highest-value password on the platform and, until this line, the only
      // thing that cost an attacker anything per guess was one scrypt. Failures only are counted,
      // the count is cleared the moment the right password arrives, and nothing durable is written
      // to the account — so a person typing their own password never sees this.
      errorMsg = PASSWORD_THROTTLED_MESSAGE;
    } else {
      try {
        const u = await withDbRetry(() => findUserByLoginIdentifier(identifier), 'adminLogin.identifier');
        // Always pays for scrypt, present or absent, so timing does not say
        // which. One message covers unknown identifier AND wrong password.
        // Deliberately NOT bounded: this is scrypt over a row already in hand, not a database wait,
        // and a database bound around CPU work would mean nothing.
        const ok = await verifyPasswordForLogin(u, password);
        if (!ok || !u) {
          // THE LIMITER SWALLOWS ITS OWN TIMEOUT, AND THAT IS THE POINT OF THE `.catch` HERE.
          // recordFailedPassword already never throws — two-factor.ts says so, precisely so a
          // limiter that cannot count does not break the form. Letting the bound around it throw
          // into the catch below would turn a plain wrong password into "Sign-in is temporarily
          // unavailable", which is a worse lie than the outage it is describing. Short bound for the
          // same reason: a counter must not spend the form's whole budget.
          await withDbTimeout(recordFailedPassword(identifier, CLIENT_IP), 'adminLogin.recordFail', 2000).catch(() => {});
          errorMsg = 'Invalid email or password.';
        } else if (!u.isActive) {
          await withDbTimeout(recordFailedPassword(identifier, CLIENT_IP), 'adminLogin.recordFail', 2000).catch(() => {});
          errorMsg = 'Account is inactive. Contact admin.';
        } else {
          // Giving the allowance back is housekeeping on a sign-in that has already succeeded. If it
          // times out the count simply stands, which is the strict direction — never a reason to
          // refuse somebody who typed the right password.
          await withDbTimeout(clearPasswordAttempts(identifier, CLIENT_IP), 'adminLogin.clearThrottle', 2000).catch(() => {});
          const methods = await withDbRetry(() => availableSecondFactors(u.id), 'adminLogin.factors');
          const optedIn = await withDbRetry(() => isSecondStepRequired(u.id), 'adminLogin.policy');
          // Staff with a face on file kept their existing face challenge before
          // the opt-in existed; that posture is preserved, not relaxed.
          const legacyFaceRule = u.role !== 'applicant' && methods.indexOf('face') >= 0;
          // A recovery code counts as a completable second step, so an account
          // whose only enrolled factor was cleared is still challenged instead of
          // being waved through on the password alone. It returns false only when
          // there is nothing left at all, which is the one case where challenging
          // would mean a lockout rather than a check.
          // Left inline so it still SHORT CIRCUITS — an account with no second step must not pay a
          // round trip to be told so. A timeout on it throws to the catch below and nobody is signed
          // in, which is the fail-closed direction and must stay that way: an unreadable factor list
          // is not permission to skip the second step.
          if ((optedIn || legacyFaceRule) && await withDbRetry(() => canCompleteSecondStep(u.id), 'adminLogin.canComplete')) {
            const token = await withDbTimeout(startPendingChallenge(u.id, SURFACE, 'password'), 'adminLogin.challenge');
            setPendingCookie(Astro.cookies, token);
            return Astro.redirect('/admin/login');
          }
          // No second step on this account: one method signs you in, unchanged.
          await startSession(u.id, Astro.request, Astro.clientAddress, Astro.cookies);
          clearPendingCookies(Astro.cookies);
          return Astro.redirect('/admin');
        }
      } catch (e: any) {
        // Never swallow this. A bare catch here once hid a total sign-in outage.
        console.error('[admin/login password]', e?.cause?.message || e?.message, e?.stack);
        errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
      }
    }
  } else if (action === 'second_factor') {
    const method = ((fd2.get('method') as string) || 'totp') as SecondFactorMethod;
    const payload = method === 'face'
      ? ((fd2.get('live_descriptor') as string) || '')
      : ((fd2.get('code') as string) || '').trim();
    try {
      // Audit the face attempt with the distance the SERVER measured.
      if (method === 'face') {
        const peek = await withDbRetry(() => resolvePendingChallenge(pendingToken, SURFACE), 'adminLogin.2faPeek');
        if (peek) {
          const r = await withDbRetry(() => verifyFaceSecondFactor(peek.userId, payload), 'adminLogin.faceCompare');
          await withDbTimeout(db.execute(sql`
            INSERT INTO identity_verifications (user_id, email, claimed_name, method, face_match_distance, face_match_passed, verdict, ip_address, user_agent)
            VALUES (${peek.userId}, ${''}, ${pendingUserName || ''}, 'face_login', ${Number.isFinite(r.distance) ? r.distance : null}, ${r.matched}, ${r.matched ? 'verified' : 'rejected'}, ${(Astro.clientAddress || '').toString().slice(0, 64) || null}, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500)})
          `), 'adminLogin.faceAudit', 2000).catch(() => {});
        }
      }
      // NOT withDbRetry. This consumes the challenge and spends an attempt against it — running it
      // twice would burn two of somebody's tries for one code they typed once. A timeout throws to
      // the catch below and no session is created, which is the only safe direction here.
      const result = await withDbTimeout(verifySecondFactor(pendingToken, SURFACE, method, payload), 'adminLogin.verifySecond');
      if (!result.ok) {
        errorMsg = result.error;
        if (result.locked) { clearPendingCookies(Astro.cookies); pendingToken = ''; }
      } else {
        // Two bookkeeping stamps on a sign-in that has already been decided. Both were already
        // written to be lost without comment; all that is added is a short bound, so a stalled
        // connection cannot hold a successful sign-in open until the gateway gives up on it.
        if (method === 'face') {
          await withDbTimeout(db.execute(sql`UPDATE user_face_enrollments SET last_used_at = NOW() WHERE user_id = ${result.userId}`), 'adminLogin.faceUsed', 2000).catch(() => {});
        }
        await startSession(result.userId, Astro.request, Astro.clientAddress, Astro.cookies);
        await withDbTimeout(db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, result.userId)), 'adminLogin.lastLogin', 2000).catch(() => {});
        clearPendingCookies(Astro.cookies);
        return Astro.redirect('/admin');
      }
    } catch (e: any) {
      console.error('[admin/login second_factor]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Verification is temporarily unavailable. Please try again.';
    }
  } else if (action === 'cancel_second_step') {
    // Cancelling must never be the thing that hangs. The cookies are cleared on the next line
    // whatever the server managed to do, so the person is back at the password form either way.
    await withDbTimeout(dropPendingChallenge(pendingToken), 'adminLogin.dropChallenge', 2000).catch(() => {});
    clearPendingCookies(Astro.cookies);
    return Astro.redirect('/admin/login');
  }
}

// Render the challenge if one is still live (also after a failed attempt).
if (pendingToken) {
  try {
    const pending = await loadPendingState(pendingToken);
    if (!pending) {
      clearPendingCookies(Astro.cookies);
      pendingToken = '';
      requireSecondStep = false;
      if (!errorMsg) noticeMsg = 'That sign-in step expired. Please sign in again.';
    }
  } catch (e: any) {
    console.error('[admin/login pending]', e?.cause?.message || e?.message, e?.stack);
    clearPendingCookies(Astro.cookies);
    pendingToken = '';
    requireSecondStep = false;
    errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
  }
}
---
<!doctype html>
<html lang="en" style="background:#08080a;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login - EduRankAI</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #08080a; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: system-ui, sans-serif; padding: 16px; }
    .card { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 16px; width: 100%; max-width: 400px; padding: 32px 24px; }
    .logo { font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 24px; text-align: center; }
    .logo em { font-style: normal; color: #FF4F00; }
    .label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6e6e78; margin-bottom: 5px; }
    .input { width: 100%; background: #15151a; border: 1px solid #1a1a1f; border-radius: 8px; padding: 11px 14px; color: #fff; font-size: 14px; outline: none; transition: border-color 0.15s; }
    .input:focus { border-color: #FF4F00; }
    .btn { width: 100%; background: #FF4F00; border: none; color: #fff; font-weight: 700; font-size: 15px; padding: 13px; border-radius: 10px; cursor: pointer; transition: opacity 0.15s; }
    .btn:hover { opacity: 0.9; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
    .notice { background: rgba(255,79,0,0.08); border: 1px solid rgba(255,79,0,0.28); color: #ffb694; border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
    .field { margin-bottom: 14px; }
    .face-oval { width: 200px; height: 240px; border: 3px solid rgba(255,79,0,0.5); border-radius: 50%; margin: 0 auto 16px; position: relative; overflow: hidden; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">EduRank<em>AI</em></div>

    {errorMsg && <div class="error">{errorMsg}</div>}
    {noticeMsg && <div class="notice">{noticeMsg}</div>}

    {requireSecondStep ? (
      <!-- Second step. The first factor already passed, but no session exists
           yet and the pending token is not one. -->
      <div>
        <p style="text-align:center;font-size:13px;color:#8a8a94;margin-bottom:4px;">Welcome back,</p>
        <p style="text-align:center;font-size:16px;font-weight:600;color:#fff;margin-bottom:6px;">{pendingUserName}</p>
        <p style="text-align:center;font-size:12px;color:#6e6e78;margin-bottom:18px;">One more step to confirm it is you.</p>

        {offerFace && (
          <div style="margin-bottom:18px;">
            <div style="position:relative;background:#000;border-radius:16px;overflow:hidden;margin-bottom:12px;aspect-ratio:3/4;max-width:240px;margin-left:auto;margin-right:auto;">
              <video id="videoEl" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1);"></video>
              <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                <div style="width:140px;height:180px;border:2px solid rgba(255,79,0,0.7);border-radius:50%;"></div>
              </div>
              <div id="faceStatus" style="position:absolute;bottom:10px;left:0;right:0;text-align:center;">
                <span style="background:rgba(0,0,0,0.75);color:#fff;font-size:11px;padding:3px 10px;border-radius:100px;">Loading...</span>
              </div>
            </div>
            <button id="verifyBtn" disabled class="btn" style="opacity:0.5;">Preparing camera...</button>
            <form method="POST" style="display:none;" id="successForm">
              <input type="hidden" name="action" value="second_factor" />
              <input type="hidden" name="method" value="face" />
              <input type="hidden" name="live_descriptor" id="liveDescriptorField" value="" />
            </form>
          </div>
        )}

        {offerFace && offerCode && (
          <div style="display:flex;align-items:center;gap:10px;color:#4a4a52;font-size:11px;margin:14px 0;"><span style="flex:1;height:1px;background:#1a1a1f;"></span>OR<span style="flex:1;height:1px;background:#1a1a1f;"></span></div>
        )}

        <form method="POST">
          <input type="hidden" name="action" value="second_factor" />
          <input type="hidden" name="method" value="totp" />
          <div class="field">
            <label class="label">{offerCode ? 'Authenticator code, or a recovery code' : 'Recovery code'}</label>
            <input name="code" type="text" inputmode="text" autocomplete="one-time-code" maxlength="16" class="input" placeholder={offerCode ? '123456' : 'abcde-12345'} required style="text-align:center;letter-spacing:0.18em;font-size:18px;min-height:48px;" />
          </div>
          <button type="submit" class="btn" style="min-height:48px;">Verify</button>
        </form>
        <p style="text-align:center;margin-top:12px;font-size:12px;color:#6e6e78;line-height:1.5;">Lost your phone? Use one of the <strong style="color:#8a8a94;">recovery codes</strong> you saved when you turned this on. Each works once.</p>
        <form method="POST">
          <input type="hidden" name="action" value="cancel_second_step" />
          <button type="submit" style="width:100%;background:none;border:none;color:#6e6e78;font-size:12px;cursor:pointer;padding:12px;min-height:44px;">Use a different account</button>
        </form>
      </div>
    ) : (
      <!-- Password login -->
      <form method="POST">
        <input type="hidden" name="action" value="password_login" />
        <div class="field">
          <label class="label">Email or internal handle</label>
          <input name="email" type="text" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" class="input" placeholder="you@edurankai.in" required autofocus style="min-height:48px;" />
        </div>
        <div class="field">
          <label class="label">Password</label>
          <input name="password" type="password" class="input" placeholder="Password" required />
        </div>
        <button type="submit" class="btn">Sign In</button>
        <p style="text-align:center;margin-top:14px;font-size:12px;">
          <a href="/forgot-password" style="color:#FF7040;text-decoration:none;font-weight:600;">Forgot password?</a>
        </p>
        <p style="text-align:center;margin-top:8px;font-size:12px;color:#6e6e78;">
          Not an admin? <a href="/portal/login" style="color:#FF7040;text-decoration:none;">Applicant portal</a>
        </p>
      </form>
      <div style="margin-top:16px;">
        <div style="display:flex;align-items:center;gap:10px;color:#4a4a52;font-size:11px;margin-bottom:12px;"><span style="flex:1;height:1px;background:#1a1a1f;"></span>OR<span style="flex:1;height:1px;background:#1a1a1f;"></span></div>
        <button type="button" id="pkLoginBtn" style="width:100%;display:flex;align-items:center;justify-content:center;gap:8px;background:#15151a;border:1px solid #2a2a31;color:#fff;font-size:13px;font-weight:700;padding:11px;border-radius:8px;cursor:pointer;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 11c0-1.5-1-3-3-3M5 13a7 7 0 0 1 7-7 7 7 0 0 1 7 7M8 21c-1-2-1.5-4-1.5-6M12 13v3c0 2 .5 4 1.5 6M16 14c.3 2 .8 4 1.5 5"/></svg>
          Sign in with fingerprint / passkey
        </button>
        <p id="pkLoginErr" style="color:#ff6b6b;font-size:11px;text-align:center;margin:8px 0 0;min-height:1em;"></p>
        <div style="text-align:center;margin-top:6px;">
          <button type="button" id="totpToggle" style="background:transparent;border:none;color:#FF7040;font-size:12px;font-weight:600;cursor:pointer;text-decoration:underline;">Sign in with an authenticator code</button>
        </div>
        <div id="totpBox" style="display:none;margin-top:10px;">
          <input id="totpEmail" type="text" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="Email or internal handle" class="input" style="margin-bottom:8px;" />
          <input id="totpCode" inputmode="numeric" maxlength="12" placeholder="6-digit code" class="input" style="margin-bottom:8px;text-align:center;letter-spacing:0.15em;" />
          <button type="button" id="totpBtn" class="btn" style="font-size:13px;padding:10px;">Verify code</button>
          <p id="totpErr" style="color:#ff6b6b;font-size:11px;text-align:center;margin:8px 0 0;min-height:1em;"></p>
        </div>
      </div>
    )}
  </div>

  {requireSecondStep && offerFace && (
    <script is:inline src="/vendor/face-api/face-api.min.js"></script>
    <script is:inline>
    // The enrolled descriptor is NEVER sent to the browser. This script only
    // captures a live descriptor and posts it; the comparison, the threshold
    // and the verdict all happen on the server, which is the only place a
    // forged POST cannot reach.
    (function () {
      var video = document.getElementById('videoEl');
      var verifyBtn = document.getElementById('verifyBtn');
      var statusEl = document.getElementById('faceStatus');
      var successForm = document.getElementById('successForm');
      var field = document.getElementById('liveDescriptorField');
      if (!video || !verifyBtn || !successForm) return;
      var submitted = false;
      var stream = null;

      // THE CAMERA IS TURNED OFF EXPLICITLY, ON EVERY EXIT.
      //
      // Leaving it to the page navigation was not good enough: the light stays on
      // while the descriptor is posted and the next page renders, and it stays on
      // indefinitely whenever somebody abandons the face step and types a code
      // instead — the page is still open, so nothing ever tears the stream down.
      // A camera that keeps running after the moment it was granted for is a
      // trust failure even when, as here, no frame is ever stored or uploaded.
      function shutCamera() {
        try {
          if (stream) { stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); }
        } catch (_) {}
        stream = null;
        try { video.pause(); } catch (_) {}
        try { video.srcObject = null; } catch (_) {}
        try { video.removeAttribute('src'); } catch (_) {}
      }
      window.addEventListener('pagehide', shutCamera);

      function setStatus(msg, color) {
        if (!statusEl) return;
        statusEl.innerHTML = '<span style="background:rgba(0,0,0,0.75);color:' + (color || '#fff') + ';font-size:11px;padding:3px 10px;border-radius:100px;">' + msg + '</span>';
      }

      async function init() {
        setStatus('Loading face model...', '#fff');
        var MODEL_URL = '/vendor/face-api/models';
        await Promise.all([
          faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
          faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        video.srcObject = stream;
        verifyBtn.disabled = false;
        verifyBtn.style.opacity = '1';
        verifyBtn.textContent = 'Verify my face';
        verifyBtn.onclick = capture;
        setStatus('Position your face in the oval', '#10b981');
      }

      async function capture() {
        if (submitted) return;
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Checking...';
        setStatus('Scanning...', '#fbbf24');
        try {
          var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
            .withFaceLandmarks(true).withFaceDescriptor();
          if (!det) {
            setStatus('No face detected. Try again in better light.', '#ef4444');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Try again';
            return;
          }
          submitted = true;
          field.value = JSON.stringify(Array.prototype.slice.call(det.descriptor));
          // Camera off BEFORE the descriptor is posted. The frame it came from is
          // never drawn to a canvas, never uploaded and does not outlive this line.
          shutCamera();
          setStatus('Sending for verification...', '#10b981');
          successForm.submit();
        } catch (e) {
          // The camera is left running here on purpose: this is a detection
          // failure, "Try again" needs a live preview, and pagehide still stops
          // every track the moment this page is left by any route.
          setStatus('Camera error. Use a code instead.', '#ef4444');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Try again';
        }
      }

      init().catch(function () {
        setStatus('Camera unavailable. Use a code instead.', '#ef4444');
        verifyBtn.textContent = 'Camera unavailable';
      });
    })();
    </script>
  )}

  <script src="/webauthn-client.js" is:inline></script>
  <script is:inline>
    (function () {
      var pk = document.getElementById('pkLoginBtn'), pkErr = document.getElementById('pkLoginErr');
      if (pk) {
        if (!window.eraPasskeySupported) pk.style.display = 'none';
        pk.addEventListener('click', async function () {
          if (pkErr) pkErr.textContent = ''; pk.disabled = true; var t = pk.innerHTML; pk.textContent = 'Follow your device prompt…';
          try { var r = await window.eraPasskeyLogin(); location.href = r.redirect || '/admin'; }
          catch (e) { if (pkErr) pkErr.textContent = (e && e.message) || 'Could not sign in with passkey.'; pk.disabled = false; pk.innerHTML = t; }
        });
      }
      var tog = document.getElementById('totpToggle'), box = document.getElementById('totpBox');
      if (tog && box) tog.addEventListener('click', function () { box.style.display = (box.style.display === 'none' || !box.style.display) ? 'block' : 'none'; });
      var tb = document.getElementById('totpBtn'), te = document.getElementById('totpErr');
      if (tb) tb.addEventListener('click', async function () {
        if (te) te.textContent = '';
        var email = (document.getElementById('totpEmail').value || '').trim();
        var code = (document.getElementById('totpCode').value || '').trim();
        if (!email || !code) { if (te) te.textContent = 'Enter your email and code.'; return; }
        tb.disabled = true;
        // `surface` names the sign-in this code belongs to. Without it the route
        // defaults to the portal, so an admin whose account owes a second step is
        // handed a portal challenge cookie and redirected to /portal/login.
        //
        // NOT LEFT UNGUARDED IN A SIGN-IN PATH. Only rr.json() was wrapped; `fetch` itself REJECTS
        // on a dropped connection, DNS trouble or a blocked request, and that rejection propagated
        // out of this handler — so `tb.disabled = false` never ran and the error line stayed empty.
        // The result on the console's sign-in page was a dead "Sign in with code" button that says
        // nothing, which reads as "my code was wrong" and sends somebody down the recovery flow for
        // a network blip. /portal/login was repaired for exactly this and the admin copy was left
        // behind.
        var d = {};
        try {
          var rr = await fetch('/api/auth/totp-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ email: email, code: code, surface: 'admin' }) });
          try { d = await rr.json(); } catch (_) { d = {}; }
          if (!d.ok && !d.error && !rr.ok) d = { error: 'Sign-in is temporarily unavailable. Please try again.' };
        } catch (_) {
          d = { error: 'We could not reach the server. Check your connection and try again.' };
        }
        tb.disabled = false;
        if (d.ok) location.href = d.redirect || '/admin'; else if (te) te.textContent = d.error || 'Invalid email or code.';
      });
    })();
  </script>
</body>
