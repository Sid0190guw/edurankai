---
// /admin/deployment-check — open this first on a new hosting account.
//
// A hosting move is not a code change, which is exactly why it fails quietly: the build succeeds,
// the home page loads, and three days later nobody has had an email since Tuesday. This page names
// every variable this deployment needs, whether it is set HERE, and what stops working without it.
//
// It reads the running process, so it answers for the deployment you are looking at rather than for
// the one somebody meant to configure.
//
// const BEFORE THE HANDLER — `const` is not hoisted, and that has taken pages down here.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { deploymentReadiness } from '@/lib/deployment-readiness';
import { CONFIGURED_CRONS } from '@/lib/observability-health';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=/admin/deployment-check');
// Which secrets are set is platform configuration, and `settings.edit` is the key that governs it.
if (!can(user as any, 'settings.edit')) return Astro.redirect('/admin?denied=settings');

const r = deploymentReadiness();

const CARD = 'background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:18px 20px;margin-bottom:16px;';
const HD = "font-size:10.5px;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;color:#8a8a94;margin:0 0 12px;";

const tone = (s: string) => s === 'blocking' ? '#fca5a5' : s === 'degraded' ? '#e8c46a' : '#8a8a94';
---

<AdminLayout title="Deployment check" activeNav="settings">
  <div style="max-width:900px;margin:0 auto;padding:24px;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 6px;">Hosting</p>
    <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 8px;">Deployment check</h1>
    <p style="font-size:13px;color:#8a8a94;line-height:1.65;margin:0 0 20px;max-width:74ch;">
      What this deployment is missing, and what stops working without it. Read from the running
      process, so it answers for the deployment you are looking at. No value is ever shown &mdash;
      only whether it is set.
    </p>

    <div style={CARD + (r.ok ? 'border-color:rgba(0,150,70,0.45);' : 'border-color:rgba(230,120,0,0.5);')}>
      <p style="margin:0;font-size:15px;font-weight:700;color:{r.ok ? '#7dd3a8' : '#e8c46a'};">
        {r.ok
          ? 'Nothing blocking or degrading is missing.'
          : r.blockingMissing.length + ' blocking and ' + r.degradedMissing.length + ' feature-breaking variables are not set here.'}
      </p>
      {!r.ok && (
        <p style="margin:8px 0 0;font-size:13px;color:#cfd6da;line-height:1.65;">
          Blocking means the site is not usable. Feature-breaking means it loads and something is
          silently dead &mdash; which is the kind nobody reports for a fortnight.
        </p>
      )}
    </div>

    {r.warnings.length > 0 && (
      <div style={CARD + 'border-color:rgba(248,113,113,0.5);'}>
        <p style={HD + 'color:#fca5a5;'}>Set, but the value looks wrong</p>
        {r.warnings.map((w) => (
          <p style="margin:0 0 8px;font-size:13px;color:#cfd6da;line-height:1.6;">
            <strong style="color:#fca5a5;font-family:'Geist Mono',monospace;">{w.name}</strong> &mdash; {w.warning}
          </p>
        ))}
      </div>
    )}

    <!-- THE TWO THAT A CHECKLIST WOULD MISS, because both look correctly configured. -->
    <div style={CARD}>
      <p style={HD}>Cannot simply be copied from the old account</p>
      {r.accountBound.map((s) => (
        <div style="margin-bottom:12px;">
          <p style="margin:0 0 3px;font-size:13px;font-family:'Geist Mono',monospace;color:{s.present ? '#7dd3a8' : '#fca5a5'};">
            {s.name} &mdash; {s.present ? 'set here' : 'not set here'}
          </p>
          <p style="margin:0;font-size:12.5px;color:#8a8a94;line-height:1.6;">{s.accountBound}</p>
        </div>
      ))}
    </div>

    <div style={CARD}>
      <p style={HD}>Must carry the SAME value as before</p>
      <p style="margin:0 0 12px;font-size:12.5px;color:#8a8a94;line-height:1.6;">
        These will show as configured on the new account and still be wrong, because a NEW value
        invalidates data already in the database. There is no error message for this anywhere.
      </p>
      {r.mustMatch.map((s) => (
        <div style="margin-bottom:12px;">
          <p style="margin:0 0 3px;font-size:13px;font-family:'Geist Mono',monospace;color:{s.present ? '#7dd3a8' : '#fca5a5'};">
            {s.name} &mdash; {s.present ? 'set here' : 'not set here'}
          </p>
          <p style="margin:0;font-size:12.5px;color:#8a8a94;line-height:1.6;">{s.mustMatchOld}</p>
        </div>
      ))}
    </div>

    <div style={CARD}>
      <p style={HD}>Everything this deployment reads</p>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px;min-width:560px;">
          <thead>
            <tr style="text-align:left;color:#6e6e78;font-size:10px;text-transform:uppercase;letter-spacing:0.08em;">
              <th style="padding:7px 8px 7px 0;">Variable</th>
              <th style="padding:7px 8px;">Here</th>
              <th style="padding:7px 8px;">Without it</th>
            </tr>
          </thead>
          <tbody>
            {r.statuses.map((s) => (
              <tr style="border-top:1px solid #1a1a1f;vertical-align:top;">
                <td style="padding:8px 8px 8px 0;font-family:'Geist Mono',monospace;color:#cfd6da;white-space:nowrap;">{s.name}</td>
                <td style="padding:8px;white-space:nowrap;">
                  <span style={'color:' + (s.present ? '#7dd3a8' : tone(s.severity)) + ';'}>
                    {s.present ? 'set' : (s.severity === 'optional' ? 'not set' : 'MISSING')}
                  </span>
                </td>
                <td style="padding:8px;color:#8a8a94;line-height:1.6;">{s.breaks}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div style={CARD}>
      <p style={HD}>Scheduled jobs this project expects</p>
      <p style="margin:0 0 10px;font-size:12.5px;color:#8a8a94;line-height:1.6;">
        {CONFIGURED_CRONS.length} jobs, declared in vercel.json and carried by the repository, so they
        arrive with the code. They still need CRON_SECRET set on the new project, or every one of
        them refuses itself. On the Hobby plan a job may run at most once a day.
      </p>
      <ul style="margin:0;padding-left:18px;font-size:12.5px;color:#cfd6da;line-height:1.8;font-family:'Geist Mono',monospace;">
        {CONFIGURED_CRONS.map((c) => <li>{c.schedule}  {c.path}</li>)}
      </ul>
    </div>

    <p style="font-size:12.5px;color:#6e6e78;line-height:1.65;margin:0;">
      Domains, DNS and the Node version are set in the Vercel dashboard, not here. This project
      builds on Node 22; a local Node 24 only produces a warning.
    </p>
  </div>
</AdminLayout>
