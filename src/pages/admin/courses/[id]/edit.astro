---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { canAccessSection } from '@/lib/auth/permissions';
import { sql } from 'drizzle-orm';
import { ensureAquintutorAuthoringSchema } from '@/lib/aquintutor-authoring';
import { textArray } from '@/lib/pg-array';
// ONE RESOLVER FOR A PASTED VIDEO LINK, shared with /admin/hr/training and both learner players.
// It requires https, matches an allowlist of known shapes and builds the player address itself, so
// no author-supplied string is ever interpolated into an iframe src. Refusal happens here, with a
// sentence, rather than being stored to break in front of a learner.
import { resolveVideoLink, describeVideoLink } from '@/lib/video-embed';
import { persistLessonVideo, lessonVideo } from '@/lib/lesson-video';

// WHAT CHANGED, AND WHY
//
// 1. "COURSE DETAILS SAVED." OVER AN UPDATE THAT COULD NEVER RUN. The statement ended
//    `learning_outcomes = ${learningOutcomes}, prerequisites = ${prerequisites}, tags = ${tags}` -
//    three JS ARRAYS interpolated into a drizzle sql template. That is the exact defect
//    src/lib/pg-array.ts was written about: postgres-js serialises a JS array as a RECORD literal
//    and Postgres refuses the whole statement. So NOTHING on the course-details form saved - not the
//    title, not the slug, not the credit hours - because one statement carried all of it, and the
//    only sign was a red box holding the failed SQL. Every other write on this page then reported
//    success without asking whether it had happened.
//
// 2. NONE OF THE THREE COLUMNS HAS A CREATE IN THIS REPOSITORY, so their live types cannot be read
//    from source: the only mention is ALTER TABLE ... ADD COLUMN IF NOT EXISTS in
//    src/lib/aquintutor-authoring.ts (learning_outcomes JSONB, prerequisites TEXT), which does
//    nothing at all if the column already exists with another type - and every reader in the product
//    (this page's own textareas, /aquintutor/courses/[slug]) treats all three as ARRAYS. Guessing
//    silently is what produced the situation above, so the shape is now READ from
//    information_schema and the value is written in whatever form that column actually takes. No
//    DDL, no type change, no guess.
//
// 3. The catch printed `e?.message` - on a drizzle error the failed SQL statement - and logged
//    nothing; add_module / add_lesson with an empty title answered with complete silence (no
//    success, no error, an unchanged reload); and the course read ended in `catch (_) {}` followed
//    by `if (!course) redirect('/admin/courses')`, so a failed query was indistinguishable from a
//    course that does not exist.
const causeOf = (e: any): string => e?.cause?.message || e?.message || 'unknown error';
const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));
// Declared here, above every reader below - `const` is not hoisted.
const lessonLinkOk = (l: any): boolean => { const v = lessonVideo(l); return !!v && v.ok; };
const lessonLinkNote = (l: any): string => {
  const v = lessonVideo(l);
  if (!v) return '';
  if (!v.ok) return 'This link will not play: ' + v.reason;
  if (v.kind === 'link') return 'Opens elsewhere in a new tab.';
  return 'Plays in the lesson (' + v.description + ').';
};

/**
 * A SQL fragment holding `xs` in the form the named column of training_courses actually accepts.
 *
 * jsonb/json  -> a JSON array, cast
 * text[]      -> textArray() (one text parameter that Postgres unpacks; see src/lib/pg-array.ts)
 * text/varchar-> the lines joined, which is the only lossless single-value form
 */
async function courseArrayValue(column: string, xs: string[]) {
  let udt = '';
  try {
    const r = await db.execute(sql`
      SELECT udt_name FROM information_schema.columns
      WHERE table_name = 'training_courses' AND column_name = ${column} LIMIT 1
    `);
    udt = String((rowsOf(r)[0] as any)?.udt_name || '');
  } catch (e: any) {
    console.error('[admin/courses/edit] column shape', column, causeOf(e));
  }
  if (udt === 'jsonb' || udt === 'json') return sql`${JSON.stringify(xs)}::jsonb`;
  if (udt.startsWith('_')) return textArray(xs);
  if (udt) return sql`${xs.join('\n')}`;
  // Unknown shape: refuse to write rather than corrupt the column.
  return null;
}

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/courses');

// This page INSERTs training_modules (description, sort_order) and ORDERs BY sort_order. Neither
// column was created anywhere in the repository — src/lib/aquintutor-authoring.ts builds the table
// with summary / order_in_course — so adding a module threw and the ordering control here could not
// order anything. Both spellings are now created and kept in step by that bootstrap; this page has
// to call it for that to happen in its process.
await ensureAquintutorAuthoringSchema();

// EVERY WRITE ON THIS PAGE WAS FRONTED BY user.role === 'applicant' AND NOTHING ELSE.
//
// src/middleware.ts maps this path to the lms section and getViewableSectionKeys() enforces
// VIEW there and only VIEW, so any account that could OPEN this console could also change what it
// holds. src/lib/auth/permissions.ts says in as many words never to use role !== 'applicant' as an
// authorisation test; the identical repair was already made on /admin/ai-interview-templates and
// /admin/hr/training.
//
// GATED ON 'edit', NOT 'delete', DELIBERATELY: canAccessSection() gives a built-in role holding a
// section view/edit/export and reserves delete for super_admin, so asking for 'delete' here would
// take an action away from a role that holds this section today. Narrowing it further is a policy
// decision for a human; refusing a custom VIEW-ONLY role is the mechanism fix, and that is this.
const canWrite = await canAccessSection(user as any, 'lms', 'edit');

let okMsg = '';
let errorMsg = '';
let course: any = null;
let modules: any[] = [];
let lessons: any[] = [];

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  if (!canWrite) {
    errorMsg = 'Your role can open this course but cannot change it. Nothing was saved.';
  } else
  try {
    if (action === 'update_meta') {
      const title = (fd.get('title') as string || '').trim();
      const slug = (fd.get('slug') as string || '').trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
      const shortDesc = (fd.get('short_desc') as string || '').trim() || null;
      const description = (fd.get('description') as string || '').trim() || null;
      const subtitle = (fd.get('subtitle') as string || '').trim() || null;
      const category = (fd.get('category') as string || '').trim();
      const level = (fd.get('level') as string || '').trim();
      const accessType = (fd.get('access_type') as string || '').trim();
      const durationHours = parseFloat(fd.get('duration_hours') as string || '0') || 0;
      const durationWeeks = parseInt(fd.get('duration_weeks') as string || '12') || 12;
      const creditHours = parseFloat(fd.get('credit_hours') as string || '3') || 3;
      const courseCode = (fd.get('course_code') as string || '').trim().toUpperCase().slice(0, 20) || null;
      const schoolId = (fd.get('school_id') as string || '').trim() || null;
      const departmentId = (fd.get('department_id') as string || '').trim() || null;
      const pricingModel = (fd.get('pricing_model') as string || 'free').trim();
      const isFree = fd.get('is_free') === 'on';
      const instructorName = (fd.get('instructor_name') as string || '').trim() || null;
      const instructorTitle = (fd.get('instructor_title') as string || '').trim() || null;
      const learningOutcomes = ((fd.get('learning_outcomes') as string || '').trim().split('\n').map(s => s.trim()).filter(Boolean));
      const prerequisites = ((fd.get('prerequisites') as string || '').trim().split('\n').map(s => s.trim()).filter(Boolean));
      const tags = ((fd.get('tags') as string || '').trim().split(',').map(s => s.trim()).filter(Boolean));
      const outcomesVal = await courseArrayValue('learning_outcomes', learningOutcomes);
      const prereqVal = await courseArrayValue('prerequisites', prerequisites);
      const tagsVal = await courseArrayValue('tags', tags);
      const unwritable = [
        outcomesVal ? '' : 'learning outcomes',
        prereqVal ? '' : 'prerequisites',
        tagsVal ? '' : 'tags',
      ].filter(Boolean);
      if (!title) {
        errorMsg = 'A course needs a title. Nothing was saved.';
      } else {
        const r = await db.execute(sql`
          UPDATE training_courses SET
            title = ${title}, slug = ${slug}, short_desc = ${shortDesc}, description = ${description},
            subtitle = ${subtitle}, course_code = ${courseCode}, credit_hours = ${creditHours},
            duration_weeks = ${durationWeeks}, pricing_model = ${pricingModel},
            school_id = ${schoolId}::uuid, department_id = ${departmentId}::uuid,
            category = ${category}, level = ${level}, access_type = ${accessType}, is_free = ${isFree},
            duration_hours = ${durationHours},
            instructor_name = ${instructorName}, instructor_title = ${instructorTitle},
            ${outcomesVal ? sql`learning_outcomes = ${outcomesVal},` : sql``}
            ${prereqVal ? sql`prerequisites = ${prereqVal},` : sql``}
            ${tagsVal ? sql`tags = ${tagsVal},` : sql``}
            updated_at = NOW()
          WHERE id = ${id}
          RETURNING id
        `);
        if (!rowsOf(r).length) errorMsg = 'Nothing was saved - this course no longer exists.';
        else if (unwritable.length) okMsg = 'Course details saved, except ' + unwritable.join(' and ') + ': that column is not present on this database, so those values were NOT stored.';
        else okMsg = 'Course details saved.';
      }
    } else if (action === 'add_module') {
      const title = (fd.get('title') as string || '').trim();
      const description = (fd.get('description') as string || '').trim() || null;
      const sortOrder = parseInt(fd.get('sort_order') as string || '99');
      if (!title) {
        errorMsg = 'A module needs a title. Nothing was added.';
      } else {
        const r = await db.execute(sql`INSERT INTO training_modules (course_id, title, description, sort_order) VALUES (${id}, ${title}, ${description}, ${sortOrder}) RETURNING id`);
        if (rowsOf(r).length) okMsg = 'Module added.';
        else errorMsg = 'The module was not added.';
      }
    } else if (action === 'delete_module') {
      const moduleId = fd.get('module_id') as string;
      const r = await db.execute(sql`DELETE FROM training_modules WHERE id = ${moduleId} AND course_id = ${id} RETURNING id`);
      if (rowsOf(r).length) okMsg = 'Module deleted.';
      else errorMsg = 'Nothing was deleted - that module is not on this course any more.';
    } else if (action === 'add_lesson') {
      const title = (fd.get('title') as string || '').trim();
      const moduleId = (fd.get('module_id') as string || '').trim() || null;
      const type = (fd.get('type') as string || 'text').trim();
      const content = (fd.get('content') as string || '').trim() || null;
      const rawVideo = (fd.get('video_url') as string || '').trim();
      // "Opens elsewhere" does not relax the checks - https, a real public host and no embedded
      // credentials are still required. It only means we hand out a button instead of a player.
      const opensElsewhere = fd.get('video_opens_elsewhere') === 'on';
      const durationMins = parseInt(fd.get('duration_mins') as string || '0');
      const sortOrder = parseInt(fd.get('sort_order') as string || '99');
      const isPreview = fd.get('is_preview') === 'on';
      // Resolved BEFORE the insert, so an unusable link never reaches the table.
      const link = rawVideo ? resolveVideoLink(rawVideo, { allowLinkOut: opensElsewhere }) : null;
      if (!title) {
        errorMsg = 'A lesson needs a title. Nothing was added.';
      } else if (link && !link.ok) {
        errorMsg = 'Nothing was added. ' + link.reason
          + (link.canLinkOut ? ' If it is meant to open in a new tab rather than play here, tick "opens elsewhere" and add it again.' : '');
      } else {
        const r = await db.execute(sql`
          INSERT INTO training_lessons (course_id, module_id, title, type, content, video_url, duration_mins, sort_order, is_preview)
          VALUES (${id}, ${moduleId}, ${title}, ${type}, ${content}, ${link ? link.originalUrl : null}, ${durationMins}, ${sortOrder}, ${isPreview})
          RETURNING id
        `);
        const newId = (rowsOf(r)[0] as any)?.id;
        if (newId) {
          // The pasted address and the derived player address are both stored. A derived half that
          // could not be written says so rather than riding along inside "Lesson added."
          let note = '';
          if (link && link.ok) note = (await persistLessonVideo(String(newId), link)).note;
          okMsg = 'Lesson added.'
            + (link && link.ok ? ' ' + describeVideoLink(link) : '')
            + (note ? ' ' + note : '');
        }
        else errorMsg = 'The lesson was not added.';
      }
    } else if (action === 'delete_lesson') {
      const lessonId = fd.get('lesson_id') as string;
      const r = await db.execute(sql`DELETE FROM training_lessons WHERE id = ${lessonId} AND course_id = ${id} RETURNING id`);
      if (rowsOf(r).length) okMsg = 'Lesson deleted.';
      else errorMsg = 'Nothing was deleted - that lesson is not on this course any more.';
    } else if (action === 'publish') {
      const r = await db.execute(sql`UPDATE training_courses SET is_published = true, updated_at = NOW() WHERE id = ${id} RETURNING slug`);
      const row = rowsOf(r)[0] as any;
      if (row) okMsg = 'Course published. Visible at /aquintutor/courses/' + row.slug + '.';
      else errorMsg = 'Nothing was published - this course no longer exists.';
    } else if (action === 'unpublish') {
      const r = await db.execute(sql`UPDATE training_courses SET is_published = false, updated_at = NOW() WHERE id = ${id} RETURNING id`);
      if (rowsOf(r).length) okMsg = 'Course unpublished.';
      else errorMsg = 'Nothing was unpublished - this course no longer exists.';
    }
  } catch (e: any) {
    // e.message on a drizzle error is only the failed SQL; the database's reason is on e.cause, and
    // nothing at all was being logged.
    console.error('[admin/courses/edit]', action, 'failed -', causeOf(e));
    okMsg = '';
    errorMsg = 'Nothing was saved. Reason: ' + causeOf(e);
  }
}

// J: this read used to end in `catch (_) {}` and fall into the redirect below, so a pooler timeout
// and "there is no such course" left the operator on the same screen with the same explanation.
let courseReadFailed = '';
try {
  const r = await db.execute(sql`SELECT * FROM training_courses WHERE id = ${id} LIMIT 1`);
  course = rowsOf(r)[0] || null;
} catch (e: any) {
  console.error('[admin/courses/edit] course read', causeOf(e));
  courseReadFailed = causeOf(e);
}
if (!course) return Astro.redirect('/admin/courses?' + (courseReadFailed ? 'error=read' : 'error=missing'));

// J: an unreadable module or lesson list must not draw as "this course has no lessons" on the
// screen somebody uses to decide whether a course is ready to publish.
let outlineReadFailed = '';
try {
  const r = await db.execute(sql`SELECT id, title, description, sort_order FROM training_modules WHERE course_id = ${id} ORDER BY sort_order ASC`);
  modules = rowsOf(r);
} catch (e: any) {
  console.error('[admin/courses/edit] modules read', causeOf(e));
  outlineReadFailed = 'The module list could not be read.';
}
try {
  const r = await db.execute(sql`SELECT id, title, type, content, video_url, duration_mins, sort_order, is_preview, module_id FROM training_lessons WHERE course_id = ${id} ORDER BY sort_order ASC`);
  lessons = rowsOf(r);
} catch (e: any) {
  console.error('[admin/courses/edit] lessons read', causeOf(e));
  outlineReadFailed = (outlineReadFailed ? outlineReadFailed + ' ' : '') + 'The lesson list could not be read.';
}

const lessonsByModule: Record<string, any[]> = {};
const unmoduledLessons: any[] = [];
for (const l of lessons) {
  if (l.module_id) {
    (lessonsByModule[l.module_id] = lessonsByModule[l.module_id] || []).push(l);
  } else {
    unmoduledLessons.push(l);
  }
}

let schools: any[] = [];
let departments: any[] = [];
// An empty School / Department picker reads as "this organisation has none". Both are optional on
// the form, so a failed read is reported rather than drawn as an empty list.
let pickerReadFailed = '';
try {
  const r = await db.execute(sql`SELECT id, code, name, slug FROM schools WHERE is_published = true ORDER BY display_order ASC`);
  schools = rowsOf(r);
} catch (e: any) {
  console.error('[admin/courses/edit] schools read', causeOf(e));
  pickerReadFailed = 'The School and Department pickers could not be filled.';
}
try {
  const r = await db.execute(sql`SELECT id, school_id, name, slug FROM academic_departments WHERE is_published = true ORDER BY display_order ASC`);
  departments = rowsOf(r);
} catch (e: any) {
  console.error('[admin/courses/edit] departments read', causeOf(e));
  pickerReadFailed = 'The School and Department pickers could not be filled.';
}

const CATEGORIES = ['general', 'technology', 'business', 'design', 'mathematics', 'liberal-arts', 'language', 'communication', 'compliance', 'hr'];
const LEVELS = ['beginner', 'intermediate', 'advanced'];
const ACCESS = [
  { v: 'public', l: 'Public' },
  { v: 'both', l: 'Public + portal' },
  { v: 'employees', l: 'Employees only' },
  { v: 'applicants', l: 'Applicants only' },
];
const LESSON_TYPES = ['text', 'video', 'quiz', 'pdf', 'link'];

const learningOutcomesText = Array.isArray(course.learning_outcomes) ? course.learning_outcomes.join('\n') : '';
const prerequisitesText = Array.isArray(course.prerequisites) ? course.prerequisites.join('\n') : '';
const tagsText = Array.isArray(course.tags) ? course.tags.join(', ') : '';
---
<AdminLayout title={'Edit: ' + course.title} activeNav="courses">
<div style="padding:0 0 80px;">
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;position:sticky;top:0;z-index:10;">
    <a href="/admin/courses" style="font-size:11px;font-family:'Geist Mono',monospace;color:#6e6e78;text-decoration:none;display:inline-block;margin-bottom:6px;">&larr; Courses</a>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
      <div style="min-width:0;">
        <h1 style="font-size:16px;font-weight:700;color:#fff;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{course.title}</h1>
        <p style="font-size:11px;font-family:'Geist Mono',monospace;color:#6e6e78;margin:2px 0 0;">/aquintutor/courses/{course.slug}</p>
      </div>
      <div style="display:flex;gap:6px;flex-shrink:0;">
        <a href={'/aquintutor/courses/' + course.slug} target="_blank" rel="noopener" style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;text-decoration:none;font-size:11px;font-weight:600;padding:7px 12px;border-radius:8px;">Preview</a>
        {course.is_published ? (
          <form method="POST" style="margin:0;"><input type="hidden" name="action" value="unpublish" /><button type="submit" style="background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.3);color:#fbbf24;font-size:11px;font-weight:600;padding:7px 12px;border-radius:8px;cursor:pointer;">Unpublish</button></form>
        ) : (
          <form method="POST" style="margin:0;"><input type="hidden" name="action" value="publish" /><button type="submit" style="background:#FF4F00;border:none;color:#fff;font-size:11px;font-weight:600;padding:7px 12px;border-radius:8px;cursor:pointer;">Publish</button></form>
        )}
      </div>
    </div>
  </div>

  {errorMsg && <div style="margin:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {okMsg && <div style="margin:12px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}
  {(outlineReadFailed || pickerReadFailed) && (
    <div style="margin:12px 16px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:12.5px;line-height:1.55;">
      {outlineReadFailed} {pickerReadFailed} This is not the same as "there are none" - do not judge whether this course is ready to publish from what is drawn below until the page loads cleanly.
    </div>
  )}

  <div style="padding:16px;display:flex;flex-direction:column;gap:14px;max-width:900px;margin:0 auto;">

    <!-- COURSE META FORM -->
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#FF7040;margin:0 0 14px;">Course details</p>
      <form method="POST" style="display:flex;flex-direction:column;gap:12px;">
        <input type="hidden" name="action" value="update_meta" />
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:10px;">
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Title</label>
            <input type="text" name="title" value={course.title} required style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Slug</label>
            <input type="text" name="slug" value={course.slug} required style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;font-family:'Geist Mono',monospace;" />
          </div>
        </div>

        <!-- ACADEMIC ASSIGNMENT -->
        <div style="display:grid;grid-template-columns:1fr 1fr 100px 100px 100px;gap:10px;">
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">School</label>
            <select name="school_id" id="schoolSelect" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              <option value="">(unassigned)</option>
              {schools.map((s: any) => <option value={s.id} selected={course.school_id === s.id}>{s.code} &middot; {s.name}</option>)}
            </select>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Department</label>
            <select name="department_id" id="deptSelect" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              <option value="">(unassigned)</option>
              {departments.map((d: any) => <option value={d.id} data-school={d.school_id} selected={course.department_id === d.id}>{d.name}</option>)}
            </select>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Course code</label>
            <input type="text" name="course_code" value={course.course_code || ''} placeholder="CS-101" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;font-family:'Geist Mono',monospace;text-transform:uppercase;" />
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Weeks</label>
            <input type="number" name="duration_weeks" min="1" value={course.duration_weeks || 12} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;font-family:'Geist Mono',monospace;" />
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Credit hrs</label>
            <input type="number" step="0.5" name="credit_hours" min="0" value={course.credit_hours || 3} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;font-family:'Geist Mono',monospace;" />
          </div>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Subtitle (one-line italic line that runs under the title)</label>
          <input type="text" name="subtitle" value={course.subtitle || ''} placeholder="A concise tagline shown italicised on cards + course detail" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Short description</label>
          <input type="text" name="short_desc" value={course.short_desc || ''} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Full description (paragraphs supported)</label>
          <textarea name="description" rows="5" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;resize:vertical;line-height:1.6;">{course.description || ''}</textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;">
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Category</label>
            <select name="category" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              {CATEGORIES.map(c => <option value={c} selected={course.category === c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Level</label>
            <select name="level" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              {LEVELS.map(l => <option value={l} selected={course.level === l}>{l}</option>)}
            </select>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Access</label>
            <select name="access_type" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              {ACCESS.map(a => <option value={a.v} selected={course.access_type === a.v}>{a.l}</option>)}
            </select>
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Duration (hours)</label>
            <input type="number" step="0.5" name="duration_hours" value={course.duration_hours || 0} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;" />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:200px 1fr;gap:10px;align-items:end;">
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Pricing model</label>
            <select name="pricing_model" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
              <option value="free" selected={course.pricing_model === 'free'}>Free (included in 1 CHF enrolment)</option>
              <option value="freemium" selected={course.pricing_model === 'freemium'}>Freemium (free audit, paid credential)</option>
              <option value="paid" selected={course.pricing_model === 'paid'}>Paid (one-time fee)</option>
              <option value="subscription" selected={course.pricing_model === 'subscription'}>Subscription</option>
            </select>
          </div>
          <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#d8d8de;cursor:pointer;">
            <input type="checkbox" name="is_free" checked={course.is_free} />
            <span>Mark as free</span>
          </label>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Instructor name</label>
            <input type="text" name="instructor_name" value={course.instructor_name || ''} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
          </div>
          <div>
            <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Instructor title</label>
            <input type="text" name="instructor_title" value={course.instructor_title || ''} style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
          </div>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Learning outcomes (one per line)</label>
          <textarea name="learning_outcomes" rows="4" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;resize:vertical;">{learningOutcomesText}</textarea>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Prerequisites (one per line)</label>
          <textarea name="prerequisites" rows="3" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;resize:vertical;">{prerequisitesText}</textarea>
        </div>
        <div>
          <label style="display:block;font-size:10px;font-weight:700;color:#6e6e78;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;">Tags (comma-separated)</label>
          <input type="text" name="tags" value={tagsText} placeholder="ai, reasoning, foundational-models" style="width:100%;background:#15151a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;color:#fff;font-size:13px;outline:none;" />
        </div>
        <button type="submit" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:13px;padding:10px 18px;border-radius:8px;cursor:pointer;align-self:flex-start;">Save details</button>
      </form>
    </div>

    <!-- MODULES -->
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#FF7040;margin:0;">Modules ({modules.length})</p>
        <button type="button" onclick="document.getElementById('addModuleForm').style.display='block';this.style.display='none';" style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;font-size:11px;font-weight:600;padding:6px 10px;border-radius:6px;cursor:pointer;">+ Add module</button>
      </div>

      <form id="addModuleForm" method="POST" style="display:none;background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:12px;margin-bottom:12px;flex-direction:column;gap:8px;">
        <input type="hidden" name="action" value="add_module" />
        <input type="text" name="title" placeholder="Module title" required style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;" />
        <input type="text" name="description" placeholder="Optional description" style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;" />
        <input type="number" name="sort_order" placeholder="Order (lower = first)" value={modules.length + 1} style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;width:140px;" />
        <div style="display:flex;gap:6px;"><button type="submit" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Add</button></div>
      </form>

      {modules.length === 0 && <p style="font-size:12px;color:#6e6e78;font-style:italic;">No modules yet. Lessons can also be added without a module.</p>}
      {modules.map((m: any, mi: number) => (
        <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <div style="flex:1;min-width:0;">
            <p style="font-size:13px;font-weight:600;color:#fff;margin:0;"><span style="font-family:'Geist Mono',monospace;font-size:10px;color:#FF7040;margin-right:8px;">{String(mi + 1).padStart(2, '0')}</span>{m.title}</p>
            {m.description && <p style="font-size:11px;color:#6e6e78;margin:3px 0 0;">{m.description}</p>}
            <p style="font-size:10.5px;color:#6e6e78;margin:3px 0 0;">{(lessonsByModule[m.id] || []).length} lessons . sort {m.sort_order}</p>
          </div>
          <form method="POST" style="margin:0;" data-danger="Delete module and ALL its lessons?">
            <input type="hidden" name="action" value="delete_module" />
            <input type="hidden" name="module_id" value={m.id} />
            <button type="submit" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;font-size:11px;padding:5px 9px;border-radius:6px;cursor:pointer;">Delete</button>
          </form>
        </div>
      ))}
    </div>

    <!-- LESSONS -->
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#FF7040;margin:0;">Lessons ({lessons.length})</p>
        <button type="button" onclick="document.getElementById('addLessonForm').style.display='flex';this.style.display='none';" style="background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;font-size:11px;font-weight:600;padding:6px 10px;border-radius:6px;cursor:pointer;">+ Add lesson</button>
      </div>

      <form id="addLessonForm" method="POST" style="display:none;background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:12px;margin-bottom:12px;flex-direction:column;gap:8px;">
        <input type="hidden" name="action" value="add_lesson" />
        <input type="text" name="title" placeholder="Lesson title" required style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;" />
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;">
          <select name="module_id" style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12px;outline:none;">
            <option value="">No module</option>
            {modules.map((m: any) => <option value={m.id}>{m.title}</option>)}
          </select>
          <select name="type" style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12px;outline:none;">
            {LESSON_TYPES.map(t => <option value={t}>{t}</option>)}
          </select>
          <input type="number" name="duration_mins" placeholder="Mins" value="10" style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12px;outline:none;" />
        </div>
        <div>
          <input id="lessonVideoUrl" type="url" inputmode="url" autocomplete="off" name="video_url" placeholder="Video link - paste the address shown when the video is open" style="width:100%;min-height:44px;background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;" />
          <p style="font-size:11px;color:#6e6e78;margin:5px 0 0;line-height:1.5;">Nothing is uploaded. The lesson plays the video from where it already lives.</p>
          <!-- Live check: the same resolver the save handler runs, so this sentence and the saved
               outcome cannot disagree. Only the server's sentence is rendered, never the input. -->
          <p id="lessonVideoCheck" role="status" aria-live="polite" style="display:none;font-size:12px;line-height:1.5;margin:7px 0 0;padding:8px 10px;border-radius:6px;"></p>
          <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#d8d8de;cursor:pointer;margin-top:7px;min-height:44px;">
            <input type="checkbox" name="video_opens_elsewhere" id="lessonVideoLinkOut" style="width:18px;height:18px;margin-top:12px;flex-shrink:0;" />
            <span style="line-height:1.5;padding-top:10px;">This one opens elsewhere &ndash; give learners a button to a new tab instead of playing it here.</span>
          </label>
        </div>
        <textarea name="content" placeholder="Lesson content (markdown supported for text type)" rows="5" style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12.5px;outline:none;resize:vertical;font-family:inherit;line-height:1.55;"></textarea>
        <div style="display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:#d8d8de;cursor:pointer;">
            <input type="checkbox" name="is_preview" />
            <span>Free preview (visible without enrolment)</span>
          </label>
          <input type="number" name="sort_order" placeholder="Order" value={lessons.length + 1} style="background:#15151a;border:1px solid #1a1a1f;border-radius:6px;padding:8px 10px;color:#fff;font-size:12px;outline:none;width:90px;" />
        </div>
        <div style="display:flex;gap:6px;"><button type="submit" style="background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Add lesson</button></div>
      </form>

      {lessons.length === 0 && <p style="font-size:12px;color:#6e6e78;font-style:italic;">No lessons yet.</p>}
      {lessons.map((l: any, li: number) => {
        const mod = modules.find((mm: any) => mm.id === l.module_id);
        return (
          <div style="background:#08080a;border:1px solid #1a1a1f;border-radius:8px;padding:10px 12px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
            <div style="flex:1;min-width:0;">
              <p style="font-size:12.5px;color:#fff;margin:0;font-weight:500;"><span style="font-family:'Geist Mono',monospace;font-size:10px;color:#6e6e78;margin-right:8px;">{String(li + 1).padStart(2, '0')}</span>{l.title}</p>
              <p style="font-size:10.5px;color:#6e6e78;margin:3px 0 0;">
                <span style="text-transform:uppercase;">{l.type}</span>
                {l.duration_mins > 0 && <span> . {l.duration_mins}m</span>}
                {mod && <span> . in: {mod.title}</span>}
                {l.is_preview && <span style="color:#FF7040;"> . FREE PREVIEW</span>}
              </p>
              {/* What a learner will actually get from this lesson's link, resolved the same way the
                  player resolves it. A link that stopped matching a known shape is visible HERE, to
                  the person who can fix it, instead of only to whoever opens the lesson. */}
              {lessonLinkNote(l) && <p style={'font-size:10.5px;margin:3px 0 0;color:' + (lessonLinkOk(l) ? '#6e6e78' : '#fca5a5') + ';'}>{lessonLinkNote(l)}</p>}
            </div>
            <form method="POST" style="margin:0;" data-danger="Delete lesson?">
              <input type="hidden" name="action" value="delete_lesson" />
              <input type="hidden" name="lesson_id" value={l.id} />
              <button type="submit" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;font-size:11px;padding:5px 9px;border-radius:6px;cursor:pointer;">Delete</button>
            </form>
          </div>
        );
      })}
    </div>

  </div>
</div>
<script is:inline>
// LIVE CHECK ON THE VIDEO FIELD. Advisory in one direction only: it cannot let anything through,
// because the save handler resolves the link again server-side and refuses on its own. What it buys
// is that the author finds out while they are still looking at the field.
(function () {
  var input = document.getElementById('lessonVideoUrl');
  var out = document.getElementById('lessonVideoCheck');
  var linkOut = document.getElementById('lessonVideoLinkOut');
  if (!input || !out) return;
  var timer = null, seq = 0;
  function paint(text, tone) {
    out.textContent = text;
    out.style.display = text ? 'block' : 'none';
    if (tone === 'ok') { out.style.background = 'rgba(16,185,129,0.12)'; out.style.border = '1px solid rgba(16,185,129,0.35)'; out.style.color = '#6ee7b7'; }
    else if (tone === 'bad') { out.style.background = 'rgba(239,68,68,0.10)'; out.style.border = '1px solid rgba(239,68,68,0.32)'; out.style.color = '#fca5a5'; }
    else { out.style.background = 'rgba(255,255,255,0.04)'; out.style.border = '1px solid #1a1a1f'; out.style.color = '#9a9aa4'; }
  }
  function check() {
    var value = (input.value || '').trim();
    if (!value) { paint('', ''); return; }
    var mine = ++seq;
    paint('Checking that link...', '');
    fetch('/api/admin/video-link/check', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: value, allowLinkOut: !!(linkOut && linkOut.checked) })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (mine !== seq) return;
      if (!d || d.ok !== true) { paint('We could not check that link just now. The link is checked again on the server before anything is stored.', ''); return; }
      // A SHARING SETTING WE CANNOT SEE FROM HERE IS THE MOST COMMON REASON A LESSON VIDEO "DOES NOT
      // WORK": it plays for the author and shows every learner a sign-in wall. The resolver returns
      // that sentence when one applies, and it belongs on this line rather than in a support ticket
      // three weeks later.
      var extra = '';
      if (d.recognised && d.warning) extra = ' — ' + d.warning;
      else if (d.recognised && d.mediaKind === 'audio') extra = ' — this is sound only; learners get an audio player, not a picture.';
      paint(d.message + extra, d.recognised ? 'ok' : 'bad');
    }).catch(function () {
      if (mine !== seq) return;
      paint('We could not check that link just now (no answer from the server). It is checked again before it is stored.', '');
    });
  }
  input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(check, 450); });
  input.addEventListener('blur', function () { clearTimeout(timer); check(); });
  if (linkOut) linkOut.addEventListener('change', check);
})();
</script>
<script src="/admin-danger.js" defer></script>
<script is:inline>
  /* FAIL CLOSED. If /admin-danger.js did not load — cached 404, blocked request, parse error —
     every data-danger control above would submit on the FIRST click with no confirmation at all.
     These are delete and revoke buttons, so the safe direction when the guard is missing is a
     dialog, not nothing. This runs only in that case and adds no behaviour when the guard is
     present. */
  window.addEventListener('load', function () {
    if (window.installDanger) return;
    console.warn('[admin-danger] guard script did not load; falling back to confirm()');
    Array.prototype.forEach.call(document.querySelectorAll('[data-danger]'), function (el) {
      var q = el.getAttribute('data-danger');
      var form = el.tagName === 'FORM' ? el : el.form;
      if (form) form.addEventListener('submit', function (e) { if (!confirm(q)) e.preventDefault(); });
      else el.addEventListener('click', function (e) { if (!confirm(q)) e.preventDefault(); });
    });
  });
</script>
</AdminLayout>
