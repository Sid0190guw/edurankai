---
// /admin/courses/edit — THE DOOR TO EDITING WHAT ALREADY EXISTS.
//
// WHY THIS PAGE EXISTS. /admin/hr/training can create a course, add a module, add a lesson, publish
// and DELETE. It cannot change one single field of any of them. A course was created there with a
// misspelt title, published with the typo, and the only repair the product offered was to destroy
// the course and everything pointing at it. This is the entry point to the screens that change
// things instead of destroying them.
//
// IT HOLDS NO SECOND CATALOGUE. Every course listed here is the same training_courses row that
// /admin/hr/training, /admin/courses, the portal player and the AquinTutor runner all read. Nothing
// on this screen writes; it only opens.
//
// THREE DIFFERENT SENTENCES FOR THREE DIFFERENT SILENCES, which is the rule on every screen in this
// build: a list that could not be READ, a list that is genuinely EMPTY, and a figure that is not
// CONFIGURED on this database are three separate facts and are never drawn the same way. A failed
// read that renders as "no courses yet" is how a duplicate of a course that already exists gets
// created.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { safeRows, clip } from '@/lib/page-safety';
import { flashFailed } from '@/lib/flash-tone';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { AUTHOR, ensureContentCrudSchema, presentColumns } from '@/lib/content-crud';

const PATH = '/admin/courses/edit';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!can(user as any, 'admin.access')) return Astro.redirect('/admin');

// EVERY const ABOVE ANY HANDLER OR READER THAT USES IT. `const` is not hoisted, and a const read
// before its declaration throws on the first line of the block that reads it — that has taken
// pages down on this project.
const canAuthor = can(user as any, AUTHOR);

const params = Astro.url.searchParams;
const msg = String(params.get('msg') || '').slice(0, 500);
const q = String(params.get('q') || '').trim().slice(0, 80);

// The archive columns are added additively on first use. ensureOnce SWALLOWS a failed ALTER, so its
// return proves nothing — presentColumns() goes and asks information_schema, and this page renders
// what that answer says rather than what the ensure implied.
await ensureContentCrudSchema();
const cols = await presentColumns();
const hasCourseArchive = cols.has('training_courses.archived_at');

// SELECT * rather than a column list: training_courses has NO CREATE TABLE anywhere in this
// repository, so naming a column that this particular database lacks would take the whole list down
// with a syntax-level error rather than degrade.
const list = await safeRows('[courses/edit] catalogue', () => db.execute(sql`
  SELECT c.*,
         (SELECT COUNT(*)::int FROM training_modules m WHERE m.course_id = c.id) AS module_count,
         (SELECT COUNT(*)::int FROM training_lessons l WHERE l.course_id = c.id) AS lesson_count
    FROM training_courses c
   ORDER BY c.created_at DESC
   LIMIT 500`));

// Enrolments in a SEPARATE query on purpose. training_enrollments has no CREATE TABLE in this
// repository either; folding it into the query above as a subquery would mean one absent table
// takes down the entire catalogue, and an unreadable catalogue that draws as "none" is the failure
// this whole build is about.
const enrol = await safeRows('[courses/edit] enrolment counts', () => db.execute(sql`
  SELECT course_id, COUNT(*)::int AS n FROM training_enrollments GROUP BY course_id`));
const enrolments = new Map<string, number>();
for (const r of enrol.rows) enrolments.set(String(r.course_id), Number(r.n) || 0);

interface Row {
  id: string; title: string; slug: string; category: string; level: string;
  isPublished: boolean; archivedAt: string | null; moduleCount: number; lessonCount: number;
}

const all: Row[] = list.rows.map((r: any) => ({
  id: String(r.id),
  title: r.title ? String(r.title) : 'Untitled course',
  slug: r.slug ? String(r.slug) : '',
  category: r.category ? String(r.category) : '',
  level: r.level ? String(r.level) : '',
  isPublished: r.is_published === true,
  archivedAt: r.archived_at ? String(r.archived_at) : null,
  moduleCount: Number(r.module_count) || 0,
  lessonCount: Number(r.lesson_count) || 0,
}));

const needle = q.toLowerCase();
const matches = (r: Row) => !needle || r.title.toLowerCase().includes(needle) || r.slug.toLowerCase().includes(needle);
const live = all.filter((r) => !r.archivedAt).filter(matches);
const archived = all.filter((r) => !!r.archivedAt).filter(matches);

const fmtEnrol = (id: string): string => {
  if (!enrol.ok) return 'enrolments unreadable';
  const n = enrolments.get(id) || 0;
  return n + (n === 1 ? ' enrolled' : ' enrolled');
};
---
<AdminLayout title="Edit a course" activeNav="courses">
  <style>
    .ce{max-width:1000px;margin:0 auto;padding:16px 14px 96px}
    .ce h1{font-size:20px;font-weight:700;letter-spacing:-.01em;margin:0 0 4px;color:var(--o-hi,#fff)}
    .ce .lede{font-size:13px;line-height:1.6;color:#9aa6b6;margin:0 0 14px;max-width:70ch}
    .ce .flash{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.34);color:#34d399;
      border-radius:10px;padding:11px 13px;font-size:13px;line-height:1.55;margin-bottom:14px;overflow-wrap:anywhere}
    .ce .flash.warn{background:rgba(220,38,38,.1);border-color:rgba(220,38,38,.36);color:#fca5a5}
    .ce .notice{background:rgba(255,79,0,.07);border:1px solid rgba(255,79,0,.26);color:#ffb08a;
      border-radius:11px;padding:12px 13px;font-size:12.5px;line-height:1.6;margin-bottom:12px}
    .ce .card{background:var(--o-bg2,#11151c);border:1px solid var(--o-stroke,#1a1a1f);
      border-radius:14px;padding:14px;margin-bottom:12px}
    .ce h2{font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.13em;
      text-transform:uppercase;color:#FF7040;font-weight:700;margin:0 0 10px}
    .ce .muted{font-size:12.5px;line-height:1.6;color:#9aa6b6;overflow-wrap:anywhere}
    .ce .item{border-top:1px solid rgba(255,255,255,.06);padding:12px 0}
    .ce .item:first-of-type{border-top:none}
    .ce .ttl{color:var(--o-hi,#fff);font-weight:650;font-size:14.5px;line-height:1.35;overflow-wrap:anywhere}
    .ce .pill{font-family:'Geist Mono',ui-monospace,monospace;font-size:9px;font-weight:700;
      padding:3px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;
      background:rgba(255,255,255,.07);color:#9aa6b6;display:inline-block;white-space:nowrap}
    .ce .pill.live{background:rgba(16,185,129,.15);color:#34d399}
    .ce .pill.off{background:rgba(220,38,38,.13);color:#fca5a5}
    .ce .meta{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:6px 0}
    .ce .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .ce .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;
      padding:10px 15px;border-radius:10px;border:1px solid var(--o-stroke,#2a2a32);background:transparent;
      color:#c9ccd4;font-size:13.5px;font-weight:600;font-family:inherit;text-decoration:none;cursor:pointer}
    .ce .btn.primary{background:#FF4F00;border-color:#FF4F00;color:#fff}
    .ce input[type=search]{width:100%;background:var(--o-bg0,#08080a);border:1px solid var(--o-stroke,#2a2a32);
      border-radius:10px;padding:11px 12px;font-size:15px;color:var(--o-hi,#fff);min-height:44px;
      box-sizing:border-box;font-family:inherit}
    .ce svg{width:15px;height:15px;flex:none;stroke:currentColor;fill:none;stroke-width:1.7;
      stroke-linecap:round;stroke-linejoin:round}
  </style>

  <div class="ce">
    <h1>Edit a course</h1>
    <p class="lede">
      The training screen can create a course, publish it and delete it. It cannot change a single
      field of one. These screens change things: rename, re-level, re-time, reorder, move, copy,
      archive and restore — and they refuse to delete anything a person has already used.
    </p>

    {msg && <p class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</p>}

    {!canAuthor && (
      <div class="notice">
        You can open this catalogue but not change it. Editing teaching material needs the
        <b> Write lessons</b> permission; publishing, archiving and restoring need
        <b> Publish lessons</b>; permanently deleting needs
        <b> Set what counts as finishing a course</b>. Everything below is readable and nothing on
        it will save.
      </div>
    )}

    <form method="get" class="card" role="search">
      <h2>Find a course</h2>
      <input type="search" name="q" value={q} placeholder="Title or web address" aria-label="Search courses by title or web address" />
      <div class="acts"><button class="btn primary" type="submit">Search</button>
      {q && <a class="btn" href={PATH}>Clear</a>}</div>
    </form>

    {!list.ok && (
      <p class="flash warn" role="alert">
        The course list COULD NOT BE READ, so nothing below is a complete picture and this is not an
        empty catalogue. Reason: {list.error}
      </p>
    )}

    <div class="card">
      <h2>Courses ({live.length})</h2>

      {list.ok && all.length === 0 && (
        <p class="muted">
          This catalogue is genuinely empty — the read succeeded and returned no rows. There is
          nothing to edit yet. Courses are created on the training screen or in the learning
          catalogue; this screen only changes ones that already exist.
        </p>
      )}

      {list.ok && all.length > 0 && live.length === 0 && (
        <p class="muted">
          {q
            ? 'No live course matches "' + q + '". The catalogue itself is not empty.'
            : 'Every course on this database is archived. The archived list is below.'}
        </p>
      )}

      {live.map((c) => (
        <div class="item">
          <div class="ttl">{clip(c.title, 90)}</div>
          <div class="meta">
            {c.isPublished ? <span class="pill live">Published</span> : <span class="pill">Draft</span>}
            {c.level && <span class="pill">{c.level}</span>}
            {c.category && <span class="pill">{c.category}</span>}
          </div>
          <p class="muted">
            {c.slug ? '/' + c.slug : 'No web address set — the course pages cannot resolve it.'}
            {' · ' + c.moduleCount + (c.moduleCount === 1 ? ' module' : ' modules')}
            {' · ' + c.lessonCount + (c.lessonCount === 1 ? ' lesson' : ' lessons')}
            {' · ' + fmtEnrol(c.id)}
          </p>
          <div class="acts">
            <a class="btn primary" href={PATH + '/' + c.id}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Course details
            </a>
            <a class="btn" href={PATH + '/' + c.id + '/curriculum'}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h10"/></svg>
              Curriculum
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="card">
      <h2>Archived ({hasCourseArchive ? archived.length : 'not configured'})</h2>
      {!hasCourseArchive && (
        <p class="muted">
          Archiving is NOT CONFIGURED on this database: training_courses has no archived_at column,
          and the additive ALTER that adds it did not land. That is not the same as having nothing
          archived — it means the question cannot be asked. Until it lands, the course screens offer
          no archive control rather than a button that would do nothing.
        </p>
      )}
      {hasCourseArchive && archived.length === 0 && (
        <p class="muted">
          Nothing is archived. This one is a genuine empty: the column exists and no course carries
          an archive date.
        </p>
      )}
      {hasCourseArchive && archived.map((c) => (
        <div class="item">
          <div class="ttl">{clip(c.title, 90)}</div>
          <div class="meta">
            <span class="pill off">Archived</span>
            {c.level && <span class="pill">{c.level}</span>}
          </div>
          <p class="muted">
            {c.moduleCount + (c.moduleCount === 1 ? ' module' : ' modules')}
            {' · ' + c.lessonCount + (c.lessonCount === 1 ? ' lesson' : ' lessons')}
            {' · ' + fmtEnrol(c.id)}
            {' · nothing was deleted when it was archived'}
          </p>
          <div class="acts">
            <a class="btn" href={PATH + '/' + c.id}>Open and restore</a>
          </div>
        </div>
      ))}
    </div>

    <div class="card">
      <h2>What these screens will not do</h2>
      <p class="muted">
        They will not delete a course, module or lesson that anybody has enrolled on, made progress
        in, completed, answered a question in or been given a certificate for. Pressing delete counts
        those first and shows you what it found; if it finds anything — or if a count cannot be run at
        all — the deletion is refused and archiving is offered instead. An unreadable count is
        treated exactly like a non-zero one.
      </p>
    </div>
  </div>
</AdminLayout>
