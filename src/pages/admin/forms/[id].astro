---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { canAccessSection } from '@/lib/auth/permissions';
import { publicUrl } from '@/lib/public-origin';
import { normalizeFormFields, validateFormForPublishing } from '@/lib/forms/form-schema';
import { saveFormRoleLink } from '@/lib/forms/form-role-link';
import { qrDataUri } from '@/lib/qr';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');
const canWrite = await canAccessSection(user as any, 'content', 'edit');

const { id } = Astro.params;
function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }
let roles: any[] = [];
let reviewers: any[] = [];
let roleLink: any = null;
let roleLinkSettingsAvailable = true;
try {
  roleLink = rows(await db.execute(sql`SELECT * FROM form_role_links WHERE form_id = ${id} LIMIT 1`))[0] || null;
} catch (e: any) {
  roleLinkSettingsAvailable = false;
  console.error(
    '[admin/forms] recruitment-link settings unavailable:',
    e?.cause?.code || 'unknown database error',
    e?.cause?.message || e?.message || 'Unknown error',
  );
}
try {
  roles = rows(await db.execute(sql`
    SELECT r.id, r.title, r.slug, r.level, r.engagement_type, r.is_open, r.application_deadline
    FROM roles r
    WHERE (r.is_open = true AND (r.application_deadline IS NULL OR r.application_deadline > NOW()))
       OR r.id = ${roleLink?.role_id || null}
    ORDER BY r.title
  `));
} catch (e: any) {
  roleLinkSettingsAvailable = false;
  console.error(
    '[admin/forms] Careers roles unavailable:',
    e?.cause?.code || 'unknown database error',
    e?.cause?.message || e?.message || 'Unknown error',
  );
}
if (canWrite) {
  try {
    reviewers = rows(await db.execute(sql`
      SELECT id, name
      FROM users
      WHERE is_active = true AND role IN ('hr', 'recruiter', 'reviewer', 'department_head')
      ORDER BY name
    `));
  } catch (e: any) {
    console.error('[admin/forms] reviewer list unavailable:', e?.cause?.message || e?.message);
  }
}
// EVERY WRITE ON THIS PAGE WAS FRONTED BY user.role === 'applicant' AND NOTHING ELSE.
//
// src/middleware.ts maps this path to the content section and getViewableSectionKeys() enforces
// VIEW there and only VIEW, so any account that could OPEN this console could also change what it
// holds. src/lib/auth/permissions.ts says in as many words never to use role !== 'applicant' as an
// authorisation test; the identical repair was already made on /admin/ai-interview-templates and
// /admin/hr/training.
//
// GATED ON 'edit', NOT 'delete', DELIBERATELY: canAccessSection() gives a built-in role holding a
// section view/edit/export and reserves delete for super_admin, so asking for 'delete' here would
// take an action away from a role that holds this section today. Narrowing it further is a policy
// decision for a human; refusing a custom VIEW-ONLY role is the mechanism fix, and that is this.
let okMsg = '', errMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (!canWrite) {
    errMsg = 'Your role can open this form but cannot change it. Nothing was saved.';
  } else
  try {
    if (fd.get('action') === 'save') {
      const title = (fd.get('title') as string || '').trim();
      const description = (fd.get('description') as string || '').trim() || null;
      const feeChf = parseInt(fd.get('fee_chf') as string || '0') || 0;
      const successMessage = (fd.get('success_message') as string || '').trim() || null;
      const isPublished = fd.get('is_published') === 'on';
      const submittedFields = JSON.parse(fd.get('fields_json') as string || '[]');
      const fields = normalizeFormFields(submittedFields);
      const linkedRoleId = String(fd.get('application_role_id') || '').trim();
      const nameFieldKey = String(fd.get('application_name_key') || '').trim();
      const emailFieldKey = String(fd.get('application_email_key') || '').trim();
      const phoneFieldKey = String(fd.get('application_phone_key') || '').trim() || null;
      const reviewerUserId = String(fd.get('application_reviewer_id') || '').trim() || null;
      if (linkedRoleId) {
        const role = roles.find((candidate) => String(candidate.id) === linkedRoleId);
        const existingRoleId = roleLink?.role_id ? String(roleLink.role_id) : null;
        if (!role || (!role.is_open && linkedRoleId !== existingRoleId) ||
          (role.application_deadline && new Date(role.application_deadline).getTime() <= Date.now() && linkedRoleId !== existingRoleId)) {
          throw new Error('Choose an open Careers role with a future deadline.');
        }
        if (feeChf > 0) throw new Error('Recruitment applications use the existing fee-free application policy.');
        if (!fields.some((field) => field.key === nameFieldKey && field.type === 'text' && field.required)) {
          throw new Error('Map the applicant name to a text question before linking this form.');
        }
        if (!fields.some((field) => field.key === emailFieldKey && field.type === 'email' && field.required)) {
          throw new Error('Map the account email to an email question before linking this form.');
        }
        if (phoneFieldKey && !fields.some((field) => field.key === phoneFieldKey && field.type === 'phone')) {
          throw new Error('The mapped phone question must use the phone type.');
        }
        if (reviewerUserId && !reviewers.some((candidate) => String(candidate.id) === reviewerUserId)) {
          throw new Error('Choose an active HR, recruiter, reviewer, or department-head account for the assignment.');
        }
      }
      const publicationError = isPublished ? validateFormForPublishing(fields) : null;
      if (publicationError) throw new Error(publicationError);
      await db.transaction(async (tx) => {
        await tx.execute(sql`UPDATE forms SET title = ${title}, description = ${description}, fee_chf = ${feeChf}, success_message = ${successMessage}, is_published = ${isPublished}, fields = ${JSON.stringify(fields)}::jsonb, updated_at = NOW() WHERE id = ${id}`);
        await saveFormRoleLink(tx, {
          available: roleLinkSettingsAvailable,
          formId: String(id || ''),
          existingRoleId: roleLink?.role_id ? String(roleLink.role_id) : null,
          existingNameFieldKey: roleLink?.name_field_key ? String(roleLink.name_field_key) : null,
          existingEmailFieldKey: roleLink?.email_field_key ? String(roleLink.email_field_key) : null,
          existingPhoneFieldKey: roleLink?.phone_field_key ? String(roleLink.phone_field_key) : null,
          existingReviewerUserId: roleLink?.reviewer_user_id ? String(roleLink.reviewer_user_id) : null,
          roleId: linkedRoleId,
          nameFieldKey,
          emailFieldKey,
          phoneFieldKey,
          reviewerUserId,
          createdBy: String(user.id),
        });
      });
      okMsg = roleLinkSettingsAvailable
        ? 'Saved.'
        : 'Form settings saved. Recruitment-link settings were unavailable and left unchanged.';
    }
  } catch (e: any) {
    console.error(
      '[admin/forms] save failed:',
      e?.cause?.code || 'unknown database error',
      e?.cause?.message || e?.message || 'Unknown error',
    );
    errMsg = 'The form could not be saved. No changes were saved. Please try again or contact an administrator.';
  }
}

const form: any = rows(await db.execute(sql`SELECT * FROM forms WHERE id = ${id} LIMIT 1`))[0];
if (!form) return Astro.redirect('/admin/forms');
const fields = normalizeFormFields(form.fields);
const publicFormUrl = publicUrl('/f/' + form.slug);
const publicFormQr = await qrDataUri(publicFormUrl, { size: 180 });
const emailShareUrl = 'mailto:?subject=' + encodeURIComponent('Please complete this form: ' + form.title) +
  '&body=' + encodeURIComponent(publicFormUrl);
const responseUrl = new URL(Astro.request.url);
const responseSearch = String(responseUrl.searchParams.get('q') || '').trim().slice(0, 120);
const responsePageParam = Number.parseInt(responseUrl.searchParams.get('responsePage') || '1', 10);
const responsePage = Number.isSafeInteger(responsePageParam) && responsePageParam > 0 ? responsePageParam : 1;
const responsePattern = '%' + responseSearch.replace(/[\\%_]/g, '\\$&') + '%';
function validDateParam(value: string | null): string {
  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return '';
  const parsed = new Date(value + 'T00:00:00.000Z');
  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value ? value : '';
}
const responseStartDate = validDateParam(responseUrl.searchParams.get('startDate'));
const responseEndDate = validDateParam(responseUrl.searchParams.get('endDate'));
let responseFilter = sql`form_id = ${id}`;
if (responseSearch) {
  responseFilter = sql`${responseFilter} AND (respondent_name ILIKE ${responsePattern} OR respondent_email ILIKE ${responsePattern} OR respondent_phone ILIKE ${responsePattern} OR data::text ILIKE ${responsePattern})`;
}
if (responseStartDate) responseFilter = sql`${responseFilter} AND created_at >= ${responseStartDate}::date`;
if (responseEndDate) responseFilter = sql`${responseFilter} AND created_at < (${responseEndDate}::date + INTERVAL '1 day')`;
const responseCount = rows(await db.execute(sql`SELECT COUNT(*)::int AS total FROM form_responses WHERE ${responseFilter}`));
const responseTotal = Number(responseCount[0]?.total || 0);
const responsePageSize = 50;
const responsePageCount = Math.max(1, Math.ceil(responseTotal / responsePageSize));
const responseCurrentPage = Math.min(responsePage, responsePageCount);
const responses = rows(await db.execute(sql`SELECT * FROM form_responses WHERE ${responseFilter} ORDER BY created_at DESC LIMIT ${responsePageSize} OFFSET ${(responseCurrentPage - 1) * responsePageSize}`));
const responseMetrics: any = rows(await db.execute(sql`
  SELECT
    COUNT(*)::int AS total,
    COUNT(*) FILTER (WHERE payment_status = 'none')::int AS no_payment_required,
    COUNT(*) FILTER (WHERE payment_status = 'paid')::int AS paid,
    COUNT(*) FILTER (WHERE payment_status = 'pending')::int AS payment_pending,
    COUNT(*) FILTER (WHERE payment_status NOT IN ('none', 'paid', 'pending'))::int AS other_status
  FROM form_responses WHERE form_id = ${id}
`))[0] || {};
const dailyMetrics = rows(await db.execute(sql`
  SELECT to_char(created_at, 'YYYY-MM-DD') AS day, COUNT(*)::int AS total
  FROM form_responses
  WHERE form_id = ${id} AND created_at >= NOW() - INTERVAL '14 days'
  GROUP BY to_char(created_at, 'YYYY-MM-DD')
  ORDER BY day ASC
`));
const distributableFields = fields.filter((field) =>
  ['select', 'radio', 'checkbox', 'yes_no', 'rating', 'linear_scale'].includes(field.type),
);
const answerDistribution = distributableFields.length
  ? rows(await db.execute(sql`
      WITH answer_counts AS (
        SELECT answer_pair.key, answer_value.value AS answer, COUNT(*)::int AS total
        FROM form_responses AS response
        CROSS JOIN LATERAL jsonb_each(
          CASE WHEN jsonb_typeof(response.data) = 'object' THEN response.data ELSE '{}'::jsonb END
        ) AS answer_pair(key, value)
        CROSS JOIN LATERAL jsonb_array_elements_text(
          CASE
            WHEN jsonb_typeof(answer_pair.value) = 'array' THEN answer_pair.value
            ELSE jsonb_build_array(answer_pair.value)
          END
        ) AS answer_value(value)
        WHERE response.form_id = ${id}
          AND answer_pair.key IN (${sql.join(distributableFields.map((field) => sql`${field.key}`), sql`, `)})
          AND answer_value.value <> ''
        GROUP BY answer_pair.key, answer_value.value
      ), ranked AS (
        SELECT key, answer, total,
          ROW_NUMBER() OVER (PARTITION BY key ORDER BY total DESC, answer ASC) AS position
        FROM answer_counts
      )
      SELECT key, answer, total FROM ranked WHERE position <= 10 ORDER BY key, position
    `))
  : [];
function responseHref(nextPage: number): string {
  const params = new URLSearchParams();
  params.set('responsePage', String(nextPage));
  if (responseSearch) params.set('q', responseSearch);
  if (responseStartDate) params.set('startDate', responseStartDate);
  if (responseEndDate) params.set('endDate', responseEndDate);
  return '/admin/forms/' + id + '?' + params.toString();
}
const responseFirst = responseTotal === 0 ? 0 : (responseCurrentPage - 1) * responsePageSize + 1;
const responseLast = Math.min(responseCurrentPage * responsePageSize, responseTotal);
const fmt = (d: any) => d ? new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : '';
const externalUrl = (raw: string) => {
  try {
    const url = new URL(raw);
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null;
  } catch {
    return null;
  }
};
const urlParts = (raw: string) => {
  const parts: { text: string; url: string | null }[] = [];
  const matcher = /https?:\/\/[^\s<>"']+/gi;
  let cursor = 0;
  for (const match of raw.matchAll(matcher)) {
    const start = match.index ?? 0;
    let candidate = match[0];
    while (/[),.!?;:]$/.test(candidate)) candidate = candidate.slice(0, -1);
    if (start > cursor) parts.push({ text: raw.slice(cursor, start), url: null });
    parts.push({ text: candidate, url: externalUrl(candidate) });
    if (candidate.length < match[0].length) parts.push({ text: match[0].slice(candidate.length), url: null });
    cursor = start + match[0].length;
  }
  if (cursor < raw.length) parts.push({ text: raw.slice(cursor), url: null });
  return parts.length ? parts : [{ text: raw, url: null }];
};
---
<AdminLayout title={'Form - ' + form.title} activeNav="forms">
  <div class="admin-page" style="max-width:1000px;">
    <a href="/admin/forms" style="font-size:11px;color:#FF7040;text-decoration:none;font-weight:600;">&lt; All forms</a>
    <h1 class="admin-page-title" style="margin-top:8px;">{form.title}</h1>
    <section class="form-sharing" aria-labelledby="formSharingTitle">
      <div class="form-sharing-heading">
        <div>
          <h2 id="formSharingTitle">Share and publish</h2>
          <p>{form.is_published ? 'This form is publicly available.' : 'Publish this form before sharing it with respondents.'}</p>
        </div>
        <a href={'/f/' + form.slug + '?preview=1'} target="_blank" rel="noopener noreferrer" class="response-link">Preview form</a>
      </div>
      <label class="fl" for="publicFormUrl">Public respondent link</label>
      <div class="form-share-row">
        <input id="publicFormUrl" class="fi" value={publicFormUrl} readonly />
        <button type="button" class="form-share-button" data-copy-target="publicFormUrl">Copy link</button>
        <button type="button" class="form-share-button" data-share-form>Share</button>
        <a class="form-share-button" href={emailShareUrl}>Share by email</a>
        <a class="form-share-button" href={publicFormUrl} target="_blank" rel="noopener noreferrer">Open form</a>
      </div>
      <label class="fl" for="formEmbedCode">Responsive embed code</label>
      <div class="form-share-row form-embed-row">
        <textarea id="formEmbedCode" class="fi" rows="3" readonly>{`<iframe src="${publicFormUrl}" title="EduRankAI form" width="100%" height="800" loading="lazy"></iframe>`}</textarea>
        <button type="button" class="form-share-button" data-copy-target="formEmbedCode">Copy embed</button>
      </div>
      {publicFormQr && <div class="form-qr">
        <img src={publicFormQr} alt="QR code for the public form link" width="144" height="144" />
        <span>Scan to open the respondent form</span>
      </div>}
      <p id="formShareStatus" role="status" aria-live="polite" class="form-share-status"></p>
    </section>
    {errMsg && <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 13px;margin:12px 0;font-size:12.5px;">{errMsg}</div>}
    {okMsg && <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 13px;margin:12px 0;font-size:12.5px;">{okMsg}</div>}

    <form method="POST" id="formEditor" style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;margin-top:14px;">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="fields_json" id="fields_json" />
      <div class="form-top-grid">
        <div><label class="fl">Title</label><input name="title" value={form.title} class="fi" /></div>
        <div><label class="fl">Fee (CHF)</label><input name="fee_chf" type="number" min="0" value={form.fee_chf || 0} class="fi" /></div>
      </div>
      <div style="margin-top:10px;"><label class="fl">Description</label><textarea name="description" rows="2" class="fi">{form.description || ''}</textarea></div>
      <div style="margin-top:10px;"><label class="fl">Success message (after submit)</label><input name="success_message" value={form.success_message || ''} placeholder="Thanks! Your response is recorded." class="fi" /></div>
      <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#c8c3b8;margin-top:10px;cursor:pointer;"><input type="checkbox" name="is_published" checked={form.is_published} /> Published (publicly fillable)</label>

      <section style="margin-top:16px;padding:14px;border:1px solid #39414d;border-radius:9px;">
        <h2 style="font-size:13px;color:#fff;margin:0 0 5px;">Careers application link</h2>
        <p class="field-note">Optionally link this form to one existing open role. The respondent must sign in with a verified applicant account; submissions create an application through the existing Careers workflow.</p>
        {!roleLinkSettingsAvailable && <p role="alert" class="field-note">Recruitment-link settings could not be loaded. They are disabled and will be left unchanged when saving this form.</p>}
        <label class="fl">Careers role</label>
        <select name="application_role_id" class="fi" disabled={!roleLinkSettingsAvailable}>
          <option value="">Not a recruitment form</option>
          {roles.map((role: any) => <option value={role.id} selected={String(roleLink?.role_id || '') === String(role.id)}>{role.title} · {role.slug}{role.is_open && (!role.application_deadline || new Date(role.application_deadline).getTime() > Date.now()) ? '' : ' · currently linked, closed'}</option>)}
        </select>
        <label class="fl" style="margin-top:10px;">Assign new applications to (optional)
          <select name="application_reviewer_id" class="fi" disabled={!roleLinkSettingsAvailable}>
            <option value="">Leave unassigned</option>
            {reviewers.map((reviewer: any) => <option value={reviewer.id} selected={String(roleLink?.reviewer_user_id || '') === String(reviewer.id)}>{reviewer.name}</option>)}
          </select>
        </label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:10px;">
            <label class="fl">Applicant name question
              <select name="application_name_key" class="fi" disabled={!roleLinkSettingsAvailable}>
                <option value="">Choose text question</option>
                {fields.filter((field) => field.type === 'text').map((field) => <option value={field.key} selected={roleLink?.name_field_key === field.key}>{field.label}</option>)}
              </select>
            </label>
            <label class="fl">Verified account email question
              <select name="application_email_key" class="fi" disabled={!roleLinkSettingsAvailable}>
                <option value="">Choose email question</option>
                {fields.filter((field) => field.type === 'email').map((field) => <option value={field.key} selected={roleLink?.email_field_key === field.key}>{field.label}</option>)}
              </select>
            </label>
            <label class="fl">Phone question (optional)
              <select name="application_phone_key" class="fi" disabled={!roleLinkSettingsAvailable}>
                <option value="">No phone question</option>
                {fields.filter((field) => field.type === 'phone').map((field) => <option value={field.key} selected={roleLink?.phone_field_key === field.key}>{field.label}</option>)}
              </select>
            </label>
        </div>
      </section>
      <p style="font-size:12px;font-weight:700;color:#fff;margin:16px 0 8px;">Questions</p>
      <p class="field-note">This starts as a blank form. Selfie, location, and signature questions are always optional; respondents choose whether to provide them.</p>
      <div id="fieldList" style="display:flex;flex-direction:column;gap:8px;"></div>
      <button type="button" id="addField" style="margin-top:10px;font-size:12px;background:#222831;border:1px solid #2a3038;color:#fff;padding:7px 14px;border-radius:7px;cursor:pointer;">+ Add your first question</button>

      <div style="margin-top:16px;"><button type="submit" class="admin-btn admin-btn-primary">Save form</button></div>
    </form>

    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:18px;margin-top:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
        <p style="font-size:13px;font-weight:700;color:#fff;margin:0;">Responses ({responseTotal})</p>
        <form method="GET" action={'/admin/forms/' + id} style="display:flex;gap:7px;flex-wrap:wrap;align-items:center;">
          <input type="search" name="q" value={responseSearch} placeholder="Search responses" aria-label="Search responses" class="fi" style="width:min(260px,65vw);" />
          <label class="filter-label">From <input type="date" name="startDate" value={responseStartDate} class="fi date-filter" /></label>
          <label class="filter-label">To <input type="date" name="endDate" value={responseEndDate} class="fi date-filter" /></label>
          <button type="submit" class="admin-btn">Search</button>
          {(responseSearch || responseStartDate || responseEndDate) && <a href={'/admin/forms/' + id} class="admin-btn" style="display:inline-flex;align-items:center;text-decoration:none;">Clear</a>}
        </form>
      </div>
      <p class="field-note">Showing {responseFirst}-{responseLast} of {responseTotal} matching responses.</p>
      <div style="overflow-x:auto;">
        <table class="response-table" style="width:100%;border-collapse:collapse;font-size:12px;">
          <thead><tr style="text-align:left;border-bottom:1px solid #3a414c;"><th style="padding:8px;">When</th><th style="padding:8px;">Name</th><th style="padding:8px;">Email</th><th style="padding:8px;">Phone</th><th style="padding:8px;">Fee</th><th style="padding:8px;">Response</th></tr></thead>
          <tbody>
            {responses.map((r: any) => {
              const responseData = r.data && typeof r.data === 'object' ? r.data : {};
              return (
                <tr style="border-bottom:1px solid #303640;color:#e3e7ed;vertical-align:top;">
                  <td style="padding:9px 8px;white-space:nowrap;">{fmt(r.created_at)}</td>
                  <td style="padding:9px 8px;font-weight:600;">{r.respondent_name || '-'}</td>
                  <td style="padding:9px 8px;">{r.respondent_email ? <a href={'mailto:' + r.respondent_email} class="response-link">{r.respondent_email}</a> : '-'}</td>
                  <td style="padding:9px 8px;">{r.respondent_phone ? <a href={'tel:' + r.respondent_phone} class="response-link">{r.respondent_phone}</a> : '-'}</td>
                  <td style="padding:9px 8px;"><span class={r.payment_status === 'paid' ? 'payment-paid' : 'payment-other'}>{r.payment_status}</span></td>
                  <td style="padding:9px 8px;min-width:170px;">
                    <details class="response-details">
                      <summary>Open response</summary>
                      <div class="response-profile">
                        <div class="profile-heading">
                          <strong>{r.respondent_name || 'Form response'}</strong>
                          <span>{fmt(r.created_at)} · {r.payment_status}</span>
                        </div>
                        {fields.map((field: any) => {
                          const value = responseData[field.key];
                          if (value === undefined || value === null || value === '') return null;
                          const valueString = typeof value === 'string' ? value : '';
                          const selfie = field.type === 'selfie' && /^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(valueString);
                          const signature = field.type === 'signature' && /^data:image\/png;base64,[A-Za-z0-9+/=]+$/.test(valueString);
                          const location = field.type === 'location' && typeof value === 'object' && Number.isFinite(Number(value.latitude)) && Number.isFinite(Number(value.longitude));
                          const contactLink = field.type === 'email' && valueString ? 'mailto:' + valueString : field.type === 'phone' && valueString ? 'tel:' + valueString : null;
                          const parts = valueString ? urlParts(valueString) : [];
                          return (
                            <div class="profile-value">
                              <div class="profile-label">{field.label}</div>
                              {selfie ? <a href={valueString} target="_blank" rel="noopener noreferrer"><img class="response-image" src={valueString} alt="Respondent selfie" /></a>
                                : signature ? <a href={valueString} target="_blank" rel="noopener noreferrer"><img class="response-signature" src={valueString} alt="Submitted signature" /></a>
                                : location ? <span>{Number(value.latitude).toFixed(6)}, {Number(value.longitude).toFixed(6)}{value.accuracy ? ' (accuracy about ' + Math.round(Number(value.accuracy)) + ' m)' : ''}</span>
                                : field.type === 'acknowledgment' && typeof value === 'object' ? <span>{value.acknowledged ? 'Acknowledged' : 'Not acknowledged'}: {String(value.statement || field.label)}{value.acknowledgedAt && <small class="ack-time"> · {fmt(value.acknowledgedAt)}</small>}</span>
                                : typeof value === 'boolean' ? <span>{value ? 'Acknowledged' : 'Not acknowledged'}</span>
                                : Array.isArray(value) ? <span>{value.map(String).join(', ') || '-'}</span>
                                : contactLink ? <a class="response-link" href={contactLink}>{valueString}</a>
                                : <span class="profile-text">{parts.map((part) => part.url ? <a class="response-link" href={part.url} target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text)}</span>}
                            </div>
                          );
                        })}
                      </div>
                    </details>
                  </td>
                </tr>
              );
            })}
            {responses.length === 0 && <tr><td colspan="6" style="padding:14px 8px;color:#c3cbd6;">{responseSearch ? 'No responses match your search.' : 'No responses yet.'}</td></tr>}
          </tbody>
        </table>
      </div>
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-top:12px;">
        {responseCurrentPage > 1
          ? <a class="admin-btn" href={responseHref(responseCurrentPage - 1)} style="text-decoration:none;">Previous</a>
          : <span class="admin-btn" style="opacity:.45;">Previous</span>}
        <span style="font-size:11.5px;color:#c3cbd6;">Page {responseCurrentPage} of {responsePageCount}</span>
        {responseCurrentPage < responsePageCount
          ? <a class="admin-btn" href={responseHref(responseCurrentPage + 1)} style="text-decoration:none;">Next</a>
          : <span class="admin-btn" style="opacity:.45;">Next</span>}
      </div>
      <a href={'/api/forms/export/' + form.id} style="font-size:11px;color:#60a5fa;text-decoration:none;display:inline-block;margin-top:8px;">Export CSV</a>
      <span style="color:#6b7280;margin:0 8px;">|</span>
      <a href={'/api/forms/export-json/' + form.id} style="font-size:11px;color:#60a5fa;text-decoration:none;display:inline-block;margin-top:8px;">Export JSON</a>
    </div>

    <section class="analytics-panel" aria-labelledby="analyticsHeading">
      <div class="analytics-heading">
        <div>
          <h2 id="analyticsHeading">Submission analytics</h2>
          <p>Measured records only. Drafts, incomplete attempts, and time-to-completion are not tracked.</p>
        </div>
        <span>{Number(responseMetrics.total || 0)} total records</span>
      </div>
      <div class="analytics-cards">
        <div><span>Free submissions</span><strong>{Number(responseMetrics.no_payment_required || 0)}</strong></div>
        <div><span>Paid submissions</span><strong>{Number(responseMetrics.paid || 0)}</strong></div>
        <div><span>Payment pending</span><strong>{Number(responseMetrics.payment_pending || 0)}</strong></div>
        {Number(responseMetrics.other_status || 0) > 0 && <div><span>Other payment states</span><strong>{Number(responseMetrics.other_status)}</strong></div>}
      </div>
      <h3>Daily submissions · past 14 days</h3>
      {dailyMetrics.length > 0 ? (
        <div class="analytics-trend" role="list">
          {dailyMetrics.map((day: any) => (
            <div class="analytics-day" role="listitem">
              <span>{day.day}</span>
              <strong>{Number(day.total || 0)}</strong>
              <span>submissions</span>
            </div>
          ))}
        </div>
      ) : <p class="analytics-empty">No submissions were recorded in the past 14 days.</p>}
      {distributableFields.length > 0 && (
        <>
          <h3>Answer distributions</h3>
          <p class="analytics-empty">Top recorded answers for configured choice and scale questions. Counts include submissions that answered that question.</p>
          <div class="distribution-grid">
            {distributableFields.map((field) => {
              const answers = answerDistribution.filter((answer: any) => answer.key === field.key);
              return (
                <div class="distribution-card">
                  <h4>{field.label}</h4>
                  {answers.length > 0 ? answers.map((answer: any) => (
                    <div class="distribution-row"><span>{answer.answer}</span><strong>{Number(answer.total)}</strong></div>
                  )) : <p class="analytics-empty">No answers recorded.</p>}
                </div>
              );
            })}
          </div>
        </>
      )}
    </section>
  </div>

  <style>
    .fl{display:block;font-size:10px;font-weight:600;color:#b7bfcb;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:4px}
    .fi{width:100%;padding:8px 10px;background:#08080a;border:1px solid #424956;border-radius:6px;color:#f4f6f8;font-size:12.5px;font-family:inherit;outline:none}
    .fi::placeholder{color:#a5adba;opacity:1}
    .fi:focus{border-color:#FF7040;box-shadow:0 0 0 2px rgba(255,112,64,.18)}
    .filter-label{display:flex;align-items:center;gap:5px;color:#c3cbd6;font-size:11px}
    .date-filter{width:145px}
    .fld{background:#151a22;border:1px solid #39414d;border-radius:8px;padding:10px}
    .field-note{margin:0 0 10px;color:#c3cbd6;font-size:12px;line-height:1.5}
    .form-top-grid{display:grid;grid-template-columns:minmax(0,2fr) 110px;gap:10px}
    .response-table th{color:#c3cbd6}
    .response-table a{overflow-wrap:anywhere}
    .response-link{color:#8bc5ff;text-decoration:underline;text-underline-offset:2px}
    .response-link:hover{color:#c1e1ff}
    .payment-paid{color:#83e6b6}
    .payment-other{color:#d5dbe4}
    .response-details summary{color:#8bc5ff;cursor:pointer;text-decoration:underline;text-underline-offset:2px;font-weight:600}
    .response-profile{margin-top:10px;padding:14px;background:#10151d;border:1px solid #3a424f;border-radius:10px;min-width:min(560px,75vw)}
    .profile-heading{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-bottom:10px;margin-bottom:4px;border-bottom:1px solid #3a424f}
    .profile-heading strong{color:#fff;font-size:14px}
    .profile-heading span{color:#c3cbd6}
    .profile-value{padding:9px 0;border-bottom:1px solid #2e3540;display:grid;grid-template-columns:minmax(110px, .7fr) minmax(150px, 1.3fr);gap:12px}
    .profile-label{color:#b7c1ce;font-weight:600}
    .profile-text{white-space:pre-wrap;overflow-wrap:anywhere;color:#f0f2f5}
    .ack-time{display:block;color:#adb7c4;margin-top:3px}
    .response-image{display:block;max-width:240px;max-height:240px;border-radius:8px;border:1px solid #495261}
    .response-signature{display:block;max-width:360px;max-height:140px;background:#fff;border-radius:6px;padding:4px}
    .analytics-panel{margin-top:16px;padding:18px;background:#0f0f14;border:1px solid #303640;border-radius:12px}
    .analytics-heading{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
    .analytics-heading h2{margin:0;color:#fff;font-size:15px}
    .analytics-heading p,.analytics-empty{margin:5px 0 0;color:#c3cbd6;font-size:12px;line-height:1.5}
    .analytics-heading>span{color:#e3e7ed;font-size:12px;font-weight:600}
    .analytics-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:9px;margin:14px 0}
    .analytics-cards>div{display:flex;flex-direction:column;gap:5px;padding:11px;background:#151a22;border:1px solid #39414d;border-radius:8px}
    .analytics-cards span,.analytics-day span{color:#c3cbd6;font-size:11px}
    .analytics-cards strong{color:#fff;font-size:20px}
    .analytics-panel h3{margin:14px 0 8px;color:#e3e7ed;font-size:12px}
    .analytics-trend{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
    .analytics-day{min-width:90px;display:flex;flex-direction:column;gap:4px;padding:9px;background:#151a22;border:1px solid #303640;border-radius:7px}
    .analytics-day strong{color:#8bc5ff;font-size:16px}
    .distribution-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px}
    .distribution-card{padding:11px;background:#151a22;border:1px solid #303640;border-radius:8px}
    .distribution-card h4{margin:0 0 8px;color:#fff;font-size:12px}
    .distribution-row{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-top:1px solid #303640;color:#e3e7ed;font-size:11px}
    .distribution-row span{overflow-wrap:anywhere}
    .distribution-row strong{color:#8bc5ff}
    .form-sharing{margin:14px 0;padding:15px;border:1px solid #39414d;border-radius:10px;background:#10141b}
    .form-sharing-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
    .form-sharing-heading h2{margin:0;color:#fff;font-size:14px}
    .form-sharing-heading p,.form-share-status{margin:4px 0 0;color:#aeb7c4;font-size:11px}
    .form-share-row{display:flex;align-items:stretch;gap:8px;margin:5px 0 12px}
    .form-share-row .fi{min-width:0;flex:1}
    .form-share-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:8px 12px;border:1px solid #45505e;border-radius:7px;background:#202833;color:#f4f6f9;font-size:11px;font-weight:700;text-decoration:none;white-space:nowrap;cursor:pointer}
    .form-share-button:hover{background:#2a3542}
    .form-embed-row{align-items:flex-start}
    .form-share-status:empty{display:none}
    .form-qr{display:flex;align-items:center;gap:12px;color:#c8d0da;font-size:11px}
    .form-qr img{width:112px;height:112px;border:5px solid #fff;border-radius:5px;background:#fff}
    @media(max-width:640px){.form-share-row{flex-wrap:wrap}.form-share-row .fi{flex-basis:100%}.form-sharing-heading{align-items:flex-start;flex-direction:column}}
    @media(max-width:640px){.form-top-grid{grid-template-columns:1fr}.profile-value{grid-template-columns:1fr;gap:4px}.response-profile{min-width:270px}}
  </style>
  <script is:inline define:vars={{ initial: fields }}>
    (function () {
      var shareStatus = document.getElementById('formShareStatus');
      document.querySelectorAll('[data-copy-target]').forEach(function (button) {
        button.addEventListener('click', function () {
          var target = document.getElementById(button.getAttribute('data-copy-target'));
          var value = target && ('value' in target ? target.value : target.textContent);
          if (!value || !navigator.clipboard || !navigator.clipboard.writeText) {
            shareStatus.textContent = 'Clipboard access is unavailable. Select and copy the text directly.';
            if (target) { target.focus(); target.select(); }
            return;
          }
          navigator.clipboard.writeText(value).then(function () {
            shareStatus.textContent = button.getAttribute('data-copy-target') === 'publicFormUrl'
              ? 'Public link copied.'
              : 'Embed code copied.';
          }).catch(function () {
            shareStatus.textContent = 'Could not copy automatically. Select and copy the text directly.';
            target.focus();
            target.select();
          });
        });
      });
      var shareButton = document.querySelector('[data-share-form]');
      if (shareButton) {
        shareButton.addEventListener('click', function () {
          var link = document.getElementById('publicFormUrl').value;
          if (navigator.share) {
            navigator.share({ title: document.querySelector('.admin-page-title').textContent, url: link })
              .then(function () { shareStatus.textContent = 'Form shared.'; })
              .catch(function (error) {
                if (error && error.name !== 'AbortError') shareStatus.textContent = 'Sharing was unavailable. Copy the public link instead.';
              });
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(link).then(function () {
              shareStatus.textContent = 'Public link copied. You can paste it into a message.';
            }).catch(function () {
              shareStatus.textContent = 'Could not share automatically. Copy the public link instead.';
            });
          } else {
            shareStatus.textContent = 'Use Copy link to share this form.';
          }
        });
      }
      var TYPES = ['text','textarea','email','phone','url','number','currency','percentage','duration','rating','linear_scale','date','time','datetime','select','radio','checkbox','yes_no','acknowledgment','selfie','location','signature'];
      var OPTIONAL_TYPES = ['selfie','location','signature'];
      var list = document.getElementById('fieldList');
      function escapeAttr(value) {
        return String(value || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      }
      function row(f) {
        f = f || { type: 'text', label: '', required: false, options: [] };
        if (TYPES.indexOf(f.type) < 0) f.type = 'text';
        var previousFields = Array.prototype.slice.call(list.querySelectorAll('.fld'));
        var sourceOptions = '<option value="">Always show</option>' + previousFields.map(function (previous, index) {
          var savedKey = previous.getAttribute('data-key') || '';
          var label = previous.querySelector('.f-label').value.trim();
          var key = savedKey || label.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'').slice(0,40) || ('field_'+index);
          return label ? '<option value="'+escapeAttr(key)+'"'+(f.condition && f.condition.fieldKey===key?' selected':'')+'>'+escapeAttr(label)+'</option>' : '';
        }).join('');
        var d = document.createElement('div'); d.className = 'fld';
        d.setAttribute('data-key', f.key || '');
        d.innerHTML =
          '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">' +
            '<select class="fi f-type" aria-label="Question type" style="max-width:160px;">' + TYPES.map(function(t){return '<option value="'+t+'"'+(f.type===t?' selected':'')+'>'+t+'</option>';}).join('') + '</select>' +
            '<input class="fi f-label" aria-label="Question label" placeholder="Question / label" value="'+escapeAttr(f.label)+'" style="flex:1;min-width:160px;" />' +
            '<label class="f-required-wrap" style="font-size:11px;color:#e0e5ec;display:flex;gap:5px;align-items:center;"><input type="checkbox" class="f-req"'+(f.required?' checked':'')+(OPTIONAL_TYPES.indexOf(f.type)>=0?' disabled':'')+'/> required</label>' +
            '<button type="button" class="f-up" aria-label="Move question up" style="background:none;border:none;color:#c3cbd6;cursor:pointer;font-size:12px;">up</button>' +
            '<button type="button" class="f-down" aria-label="Move question down" style="background:none;border:none;color:#c3cbd6;cursor:pointer;font-size:12px;">down</button>' +
            '<button type="button" class="f-duplicate" style="background:none;border:none;color:#8bc5ff;cursor:pointer;font-size:12px;">duplicate</button>' +
            '<button type="button" class="f-del" style="background:none;border:none;color:#fca5a5;cursor:pointer;font-size:12px;">remove</button>' +
          '</div>' +
          '<input class="fi f-opts" placeholder="Options (comma-separated) - for select/radio/checkbox" value="'+escapeAttr((f.options||[]).join(', '))+'" style="margin-top:6px;display:'+(['select','radio','checkbox'].indexOf(f.type)>=0?'block':'none')+';" />' +
          '<textarea class="fi f-description" aria-label="Question description" placeholder="Description or instructions (optional)" rows="2" style="margin-top:6px;">'+escapeAttr(f.description)+'</textarea>' +
          '<div class="f-logic" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">' +
            '<input class="fi f-section" aria-label="Section name" placeholder="Section (default: General)" value="'+escapeAttr(f.section || 'General')+'" style="flex:1;min-width:150px;" />' +
            '<select class="fi f-condition-source" aria-label="Show question based on" style="flex:1;min-width:150px;">'+sourceOptions+'</select>' +
            '<select class="fi f-condition-op" aria-label="Visibility condition" style="width:145px;">' +
              '<option value="equals"'+(f.condition && f.condition.operator==='equals'?' selected':'')+'>is</option>' +
              '<option value="not_equals"'+(f.condition && f.condition.operator==='not_equals'?' selected':'')+'>is not</option>' +
              '<option value="answered"'+(f.condition && f.condition.operator==='answered'?' selected':'')+'>has an answer</option>' +
              '<option value="not_answered"'+(f.condition && f.condition.operator==='not_answered'?' selected':'')+'>has no answer</option>' +
            '</select>' +
            '<input class="fi f-condition-value" aria-label="Matching answer" placeholder="Matching answer" value="'+escapeAttr(f.condition && f.condition.value)+'" style="flex:1;min-width:140px;" />' +
          '</div>' +
          '<div class="f-advanced" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">' +
            '<input class="fi f-placeholder" aria-label="Placeholder" placeholder="Placeholder (optional)" value="'+escapeAttr(f.placeholder)+'" style="flex:1;min-width:140px;" />' +
            '<input class="fi f-example" aria-label="Example" placeholder="Example or help text (optional)" value="'+escapeAttr(f.example)+'" style="flex:1;min-width:140px;" />' +
            '<input class="fi f-min" aria-label="Minimum value or length" type="number" placeholder="Minimum" value="'+(f.min == null ? '' : escapeAttr(f.min))+'" style="width:100px;" />' +
            '<input class="fi f-max" aria-label="Maximum value or length" type="number" placeholder="Maximum" value="'+(f.max == null ? '' : escapeAttr(f.max))+'" style="width:100px;" />' +
            '<input class="fi f-minlength" aria-label="Minimum characters" type="number" min="0" placeholder="Min chars" value="'+(f.minLength == null ? '' : escapeAttr(f.minLength))+'" style="width:100px;" />' +
            '<input class="fi f-maxlength" aria-label="Maximum characters" type="number" min="1" placeholder="Max chars" value="'+(f.maxLength == null ? '' : escapeAttr(f.maxLength))+'" style="width:100px;" />' +
          '</div>' +
          '<p class="f-help" style="margin:7px 0 0;color:#c3cbd6;font-size:11px;line-height:1.45;"></p>';
        d.querySelector('.f-del').addEventListener('click', function(){ d.remove(); });
        d.querySelector('.f-up').addEventListener('click', function(){
          if (d.previousElementSibling) list.insertBefore(d, d.previousElementSibling);
        });
        d.querySelector('.f-down').addEventListener('click', function(){
          if (d.nextElementSibling) list.insertBefore(d.nextElementSibling, d);
        });
        d.querySelector('.f-duplicate').addEventListener('click', function(){
          row({
            type: typeSel.value,
            label: d.querySelector('.f-label').value + ' copy',
            required: required.checked,
            options: opts.value.split(',').map(function(s){return s.trim();}).filter(Boolean),
            description: d.querySelector('.f-description').value,
            placeholder: d.querySelector('.f-placeholder').value,
            example: d.querySelector('.f-example').value,
            min: d.querySelector('.f-min').value,
            max: d.querySelector('.f-max').value,
            minLength: d.querySelector('.f-minlength').value,
            maxLength: d.querySelector('.f-maxlength').value,
            section: d.querySelector('.f-section').value,
            condition: d.querySelector('.f-condition-source').value ? {
              fieldKey: d.querySelector('.f-condition-source').value,
              operator: d.querySelector('.f-condition-op').value,
              value: d.querySelector('.f-condition-value').value
            } : null
          });
        });
        var typeSel = d.querySelector('.f-type'); var opts = d.querySelector('.f-opts'); var required = d.querySelector('.f-req'); var help = d.querySelector('.f-help');
        var conditionSource = d.querySelector('.f-condition-source');
        var conditionOperator = d.querySelector('.f-condition-op');
        var conditionValue = d.querySelector('.f-condition-value');
        function updateConditionControls() {
          var hasSource = !!conditionSource.value;
          conditionOperator.style.display = hasSource ? 'block' : 'none';
          conditionValue.style.display = hasSource && ['equals','not_equals'].indexOf(conditionOperator.value)>=0 ? 'block' : 'none';
        }
        function updateType() {
          var choiceType = ['select','radio','checkbox'].indexOf(typeSel.value)>=0;
          var textType = ['text','textarea','email','phone','url'].indexOf(typeSel.value)>=0;
          opts.style.display = choiceType ? 'block':'none';
          var numericType = ['number','currency','percentage','duration','rating','linear_scale'].indexOf(typeSel.value)>=0;
          d.querySelector('.f-placeholder').style.display = textType || numericType ? 'block':'none';
          d.querySelector('.f-min').style.display = numericType ? 'block':'none';
          d.querySelector('.f-max').style.display = numericType ? 'block':'none';
          d.querySelector('.f-minlength').style.display = textType ? 'block':'none';
          d.querySelector('.f-maxlength').style.display = textType ? 'block':'none';
          required.disabled = OPTIONAL_TYPES.indexOf(typeSel.value)>=0;
          if (required.disabled) required.checked = false;
          updateConditionControls();
          help.textContent = typeSel.value === 'acknowledgment'
            ? 'Write the exact acknowledgment or consent statement in the label. You may mark it required.'
            : typeSel.value === 'selfie'
              ? 'Optional live camera capture. The respondent must press the camera button and approve browser access.'
              : typeSel.value === 'location'
                ? 'Optional location capture. The respondent must press the location button and approve browser access.'
                : typeSel.value === 'signature'
                  ? 'Optional signature drawn by the respondent.'
                  : '';
        }
        typeSel.addEventListener('change', updateType);
        conditionSource.addEventListener('change', updateConditionControls);
        conditionOperator.addEventListener('change', updateConditionControls);
        updateType();
        list.appendChild(d);
      }
      (initial || []).forEach(row);
      document.getElementById('addField').addEventListener('click', function(){ row(); });
      document.getElementById('formEditor').addEventListener('submit', function(){
        var out = [];
        var usedKeys = Object.create(null);
        list.querySelectorAll('.fld').forEach(function(d, i){
          var label = d.querySelector('.f-label').value.trim(); if (!label) return;
          var type = d.querySelector('.f-type').value;
          var required = d.querySelector('.f-req').checked;
          var optsRaw = d.querySelector('.f-opts').value;
          var options = (['select','radio','checkbox'].indexOf(type)>=0 && optsRaw) ? optsRaw.split(',').map(function(s){return s.trim();}).filter(Boolean) : [];
          var storedKey = d.getAttribute('data-key') || '';
          var baseKey = storedKey || label.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'').slice(0,40) || ('field_'+i);
          var key = baseKey;
          var suffix = 2;
          while (!storedKey && usedKeys[key]) {
            var ending = '_'+suffix++;
            key = baseKey.slice(0,40-ending.length)+ending;
          }
          usedKeys[key] = true;
          d.setAttribute('data-key', key);
          out.push({
            key: key,
            type: type,
            label: label,
            required: required,
            options: options,
            description: d.querySelector('.f-description').value.trim(),
            placeholder: d.querySelector('.f-placeholder').value.trim(),
            example: d.querySelector('.f-example').value.trim(),
            min: d.querySelector('.f-min').value || null,
            max: d.querySelector('.f-max').value || null,
            minLength: d.querySelector('.f-minlength').value || null,
            maxLength: d.querySelector('.f-maxlength').value || null,
            section: d.querySelector('.f-section').value.trim() || 'General',
            condition: d.querySelector('.f-condition-source').value ? {
              fieldKey: d.querySelector('.f-condition-source').value,
              operator: d.querySelector('.f-condition-op').value,
              value: d.querySelector('.f-condition-value').value.trim()
            } : null
          });
        });
        document.getElementById('fields_json').value = JSON.stringify(out);
      });
    })();
  </script>
</AdminLayout>
