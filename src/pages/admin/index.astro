---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
// EVERY READ ON THIS PAGE IS BOUNDED. The three try/catch blocks below already reported a failed
// read honestly, per panel -- but a pooler that accepts the connection and then never answers the
// query is not a failure they could catch, because postgres-js has no query timeout and the await
// simply never settled. That is the 504 on this URL: not a slow dashboard, a render that never
// finished. A bound turns it into the 'could not be read' state these panels already have, and
// db-timeout.ts's circuit breaker means that once the database really has gone away the remaining
// reads are refused instantly rather than each waiting out its own fuse.
// BOUNDING THE WAIT WAS HALF THE ANSWER. THE OTHER HALF IS ASKING AGAIN.
//
// Each of the three reads below was bounded at the 8s default and none of them was retried, so one
// stalled connection cost this page a full eight seconds and three of them in a row opened the
// process-global breaker - after which the remaining reads were refused instantly and every tile
// painted 0 under the "some of the figures could not be read" banner. The founder read "the company
// has no staff and no applications" off a database that was answering in 140ms.
//
// What actually fails here is OPENING a connection: ~810ms when it works, no answer at all a fair
// fraction of the time, at a rate that does not move with load. That failure is per-attempt, so a
// second attempt is a genuinely independent draw - and it usually reuses the connection the
// abandoned attempt left in the pool, which is why the pair costs no more than the single 8s wait
// it replaces. All three are pure SELECTs, so withDbRetry's idempotency condition holds.
import { withDbRetry } from '@/lib/db-timeout';
import { adminSectionLabel } from '@/lib/admin-sections';
// THE FIRST SCREEN SOMEBODY SEES HAS TO SAY WHAT TO DO FIRST.
//
// Eight tiles rendering 0 and five Quick Actions offered as unordered peers is not an onboarding.
// Nothing on this page said that departments come before employees, that employees come before the
// organization graph, or that a payroll run cannot be undone — so the honest reading of it on a
// fresh deployment was "the company has nothing", when the truth was "nobody has set anything up".
// Those are different sentences and they need different actions.
//
// readSetupStatus() is six independent COUNTs behind safeRows: one missing table degrades to "that
// step has not been set up" rather than taking the banner, or the page, down with it.
import { readSetupStatus, outstandingSteps, uncheckableSteps } from '@/lib/day-one';
// The three states, in one shape, for the two panels on this page that had only two.
import DayOne from '@/components/admin/DayOne.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

const deniedKey = Astro.url.searchParams.get('denied');
const deniedLabel = deniedKey ? adminSectionLabel(deniedKey) : '';

const firstName = user.name ? user.name.split(' ')[0] : 'there';
// The greeting follows the reader's day, not the server's. This process runs UTC and the people
// reading it are in IST, so getHours() said "Good evening" through the whole IST morning.
const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', hour12: false }).format(new Date()));
const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';

// EIGHT TILES, ONE STATEMENT, ONE CATCH. A single missing table anywhere in the subquery list makes
// the whole statement throw, and every tile then renders the zero it was initialised with — an admin
// console that says the company has no applications, no staff and no open roles, in the confident
// typography of a real answer. `const` before the reads that populate it.
let statsError = '';
// A ZERO A READER CANNOT TELL APART FROM "NONE" IS THE WHOLE PROBLEM, so keep the two apart.
// statsError is the banner's variable and the panels below borrow it when THEY fail, which means it
// cannot answer "did the tile numbers themselves come back?". This flag can, and only the tiles read
// it: when it is set they say so instead of animating up to a confident 0.
let countsUnreadable = false;

let appCount = 0, roleCount = 0, userCount = 0, eventCount = 0, newThisWeek = 0;
let empCount = 0, pendingLeave = 0, heiCount = 0;
let statusRows: any[] = [];
let recentApps: any[] = [];

try {
  // ARCHIVED APPLICATIONS ARE EXCLUDED EVERYWHERE ON THIS PAGE.
  // The dashboard counted every application ever received, so archiving a pile of them changed
  // nothing here and the tile disagreed with /admin/applications, which defaults to the active
  // filter. Same for "new this week", the pipeline breakdown and the recent list below: all four
  // now read the same set the Applications page shows, so the numbers agree.
  const counts = await withDbRetry(() => db.execute(sql`
    SELECT
      (SELECT COUNT(*) FROM applications WHERE is_archived = false AND status NOT IN ('hired','rejected','withdrawn','pending_payment'))::int as a,
      (SELECT COUNT(*) FROM roles WHERE is_open = true)::int as r,
      -- "Active Staff" must mean exactly that: an active, non-applicant account.
      -- is_active was never checked, so deactivated accounts were still counted.
      (SELECT COUNT(*) FROM users WHERE role != 'applicant' AND is_active = true)::int as u,
      (SELECT COUNT(*) FROM events)::int as e,
      (SELECT COUNT(*) FROM applications WHERE is_archived = false AND created_at >= NOW() - INTERVAL '7 days')::int as nw,
      (SELECT COUNT(*) FROM hei_institutions WHERE is_published = true)::int as h,
      (SELECT COUNT(*) FROM hr_employees WHERE is_active = true)::int as emp,
      (SELECT COUNT(*) FROM hr_leave_request WHERE status = 'pending')::int as lv
  `), 'admin.dashboard.counts', 4000, 2500);
  // postgres-js driver returns array directly, not {rows:[]}
  const row = (Array.isArray(counts) ? counts[0] : counts?.rows?.[0]) as any;
  if (row) {
    appCount = Number(row.a) || 0;
    roleCount = Number(row.r) || 0;
    userCount = Number(row.u) || 0;
    eventCount = Number(row.e) || 0;
    newThisWeek = Number(row.nw) || 0;
    heiCount = Number(row.h) || 0;
    empCount = Number(row.emp) || 0;
    pendingLeave = Number(row.lv) || 0;
  } else {
    // Eight scalar COUNTs always produce exactly one row, so no row means we did not get an answer
    // even though nothing threw. That is unknown, not zero: leaving the eight variables at their
    // initialised 0 here is precisely how this page came to state that the company has no staff.
    countsUnreadable = true;
    statsError = 'the figures query returned no row';
    console.error('Dashboard stats error: counts statement returned no row');
  }
} catch(e: any) {
  // The real Postgres reason is on e.cause; e.message is only the failed statement.
  statsError = e?.cause?.message || e?.message || 'unknown reason';
  countsUnreadable = true;
  console.error('Dashboard stats error:', statsError);
}
// EACH PANEL OWNS ITS OWN FAILURE. Folding both of these into `statsError` meant a thrown pipeline
// query printed "No pipeline data yet" under a banner about the TILES, and a reader with no reason
// to connect the two read the empty panel as an answer. These two flags let each panel say, in its
// own space, that it does not know.
let pipelineError = '';
let recentError = '';
try {
  const rs = await withDbRetry(() => db.execute(sql`SELECT status, COUNT(*)::int as n FROM applications WHERE is_archived = false GROUP BY status ORDER BY n DESC`), 'admin.dashboard.pipeline', 4000, 2000);
  statusRows = (Array.isArray(rs) ? rs : (rs?.rows || [])) as any[];
} catch(e: any) {
  pipelineError = e?.cause?.message || e?.message || 'the pipeline breakdown could not be read';
  if (!statsError) statsError = pipelineError;
  console.error('Dashboard pipeline error:', pipelineError);
}
try {
  const rra = await withDbRetry(() => db.execute(sql`SELECT id, first_name, last_name, email, role_title_snapshot, status, created_at FROM applications WHERE is_archived = false ORDER BY created_at DESC LIMIT 6`), 'admin.dashboard.recent', 4000, 2000);
  recentApps = (Array.isArray(rra) ? rra : (rra?.rows || [])) as any[];
} catch(e: any) {
  recentError = e?.cause?.message || e?.message || 'the recent applications list could not be read';
  if (!statsError) statsError = recentError;
  console.error('Dashboard recent-applications error:', recentError);
}

// -------------------------------------------------------------------------------------------------
// WHAT HAS NOT BEEN SET UP, AND WHICH ONE TO DO FIRST.
//
// This never throws and never blanks the page: readSetupStatus() answers per step, and a step it
// could not count is reported as unknown rather than as "not done". The banner below states both,
// separately, because "five things are outstanding" and "we could not check two of them" are
// different claims and only one of them is a to-do list.
// -------------------------------------------------------------------------------------------------
let setupTodo: Awaited<ReturnType<typeof readSetupStatus>> = [];
let setupUnknown: Awaited<ReturnType<typeof readSetupStatus>> = [];
let setupCheckFailed = '';
try {
  const setupStatuses = await readSetupStatus();
  setupTodo = outstandingSteps(setupStatuses);
  setupUnknown = uncheckableSteps(setupStatuses);
} catch (e: any) {
  // readSetupStatus() is written not to throw. If it ever does, say so — an absent banner would be
  // read as "everything is set up", which is the one thing this page must not imply by silence.
  setupCheckFailed = e?.cause?.message || e?.message || 'unknown error';
  console.error('Dashboard setup-status error:', setupCheckFailed);
}
/** The earliest outstanding step. The steps under it depend on it, so it is the only useful "next". */
const nextStep = setupTodo.length > 0 ? setupTodo[0].step : null;

const STATUS_COLOR: Record<string,string> = {
  submitted:'#fbbf24',reviewing:'#60a5fa',shortlisted:'#34d399',
  interview:'#a78bfa',offered:'#f97316',hired:'#10b981',
  rejected:'#f87171',withdrawn:'#6b7280',task_sent:'#e879f9',
};
---
<AdminLayout title="Dashboard" activeNav="dashboard">
<div style="padding-bottom:80px;">

  {deniedLabel && (
    <div style="margin:12px 16px 0;background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.28);border-radius:10px;padding:11px 14px;display:flex;align-items:center;gap:10px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
      <p style="font-size:12.5px;color:#fca5a5;margin:0;">You don't have access to <b>{deniedLabel}</b>. Ask an admin to grant it under Custom Roles.</p>
    </div>
  )}

  {statsError && (
    <div style="margin:12px 16px 0;background:rgba(232,196,106,0.08);border:1px solid rgba(232,196,106,0.35);border-radius:10px;padding:11px 14px;display:flex;align-items:flex-start;gap:10px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e8c46a" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
      <p style="font-size:12.5px;color:#e8c46a;margin:0;line-height:1.55;">Some of the figures below could not be read, so any zero on this page may mean "unknown" rather than "none": {statsError}</p>
    </div>
  )}

  {/* WHAT HAS NOT BEEN SET UP YET — above the tiles, because on a fresh deployment the tiles are
      all zero and this is the sentence that explains why. It is not a nag: it disappears entirely
      once every required step has something recorded against it. */}
  {nextStep && (
    <div style="margin:12px 16px 0;background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.30);border-radius:10px;padding:12px 14px;">
      <p style="font-size:12.5px;color:#fcd34d;margin:0;line-height:1.65;">
        <strong style="color:#fde68a;">This platform is not set up yet.</strong>
        {' '}{setupTodo.length === 1 ? 'One step of first-run setup has nothing recorded against it' : setupTodo.length + ' steps of first-run setup have nothing recorded against them'},
        so several screens below will be empty for that reason rather than because there is nothing to show.
        Start with <a href={nextStep.href} style="color:#fcd34d;font-weight:700;text-decoration:underline;text-underline-offset:3px;">{nextStep.label}</a>
        {' '}— {nextStep.blocks}
      </p>
      <p style="margin:6px 0 0;">
        <a href="/admin/setup" style="display:inline-flex;align-items:center;min-height:44px;color:#FF7040;font-size:13px;font-weight:600;text-decoration:underline;text-underline-offset:3px;">See all six steps, in order</a>
      </p>
    </div>
  )}

  {setupUnknown.length > 0 && (
    <div style="margin:12px 16px 0;background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.30);border-radius:10px;padding:12px 14px;">
      <p style="font-size:12.5px;color:#fca5a5;margin:0;line-height:1.65;">
        {setupUnknown.length === 1 ? 'One first-run setup step could not be checked' : setupUnknown.length + ' first-run setup steps could not be checked'},
        so this page cannot tell you whether the platform is set up.
        {' '}<a href="/admin/setup" style="color:#fca5a5;font-weight:700;text-decoration:underline;text-underline-offset:3px;">The setup page names each one and the reason it failed.</a>
      </p>
    </div>
  )}

  {setupCheckFailed && (
    <div style="margin:12px 16px 0;background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.30);border-radius:10px;padding:12px 14px;">
      <p style="font-size:12.5px;color:#fca5a5;margin:0;line-height:1.65;">
        The first-run setup check itself failed, so the absence of a setup banner on this page means
        nothing either way: {setupCheckFailed}
      </p>
    </div>
  )}

  <div style="background:linear-gradient(135deg,#0f0f14 0%,#15151a 100%);border-bottom:1px solid #1a1a1f;">
    <div class="dash-wrap" style="padding:26px 22px 22px;">
      <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.14em;text-transform:uppercase;margin:0 0 4px;">{new Date().toLocaleDateString('en-IN',{ timeZone: 'Asia/Kolkata',weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p>
      <h1 style="font-size:clamp(22px,3vw,30px);font-weight:800;color:#fff;margin:0 0 3px;line-height:1.1;letter-spacing:-0.02em;">{greeting}, {firstName}.</h1>
      <p style="font-size:12.5px;color:#8a8a94;margin:0;">EduRankAI Admin · Live data</p>
    </div>
  </div>

  <div class="dash-wrap" style="padding:20px 22px 0;">
    <div class="dash-stats">
      {[
        {label:'Applications',value:appCount,sub:countsUnreadable?'in progress · this week is not counted either':newThisWeek+' new this week · in progress',href:'/admin/applications',color:'#FF7040'},
        {label:'Open Roles',value:roleCount,sub:'actively hiring',href:'/admin/roles',color:'#60a5fa'},
        // Sign-in accounts, NOT headcount. This sits next to the Employees tile and the two will
        // legitimately differ (an admin account is not an employee record), so say which is which.
        {label:'Active Staff',value:userCount,sub:'active sign-in accounts',href:'/admin/users',color:'#a78bfa'},
        {label:'Events',value:eventCount,sub:'total events',href:'/admin/events',color:'#34d399'},
      ].map(s=>(
        <a href={s.href} class="ds-tap ds-reveal dash-card" style="text-decoration:none;background:#0f0f14;border:1px solid #1a1a1f;border-radius:16px;padding:20px;display:block;position:relative;overflow:hidden;">
          <div style={`position:absolute;inset:0;pointer-events:none;background:radial-gradient(180px 120px at 82% -10%, ${s.color}33, transparent 70%);`}></div>
          <div style={`position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg, ${s.color}, transparent);box-shadow:0 0 12px ${s.color};`}></div>
          {/* NO data-count WHEN THE FIGURE IS UNKNOWN. era-motion.js animates every [data-count]
              element from 0 up to its value, so leaving the attribute on would have this tile count
              confidently up to zero — the single most believable false statement on the console.
              Without the attribute the script never touches it and the word stands. */}
          {countsUnreadable ? (
            <p class="ds-count" title="This figure could not be read. It is not a count of zero." style={`font-size:20px;font-weight:700;color:#e8c46a;margin:0;line-height:1.35;font-family:'Space Grotesk','Geist Mono',monospace;letter-spacing:-0.01em;position:relative;`}>not read</p>
          ) : (
            <p class="ds-count" data-count={s.value} style={`font-size:38px;font-weight:800;color:${s.color};margin:0;line-height:1;font-family:'Space Grotesk','Geist Mono',monospace;letter-spacing:-0.02em;text-shadow:0 0 24px ${s.color}55;position:relative;`}>0</p>
          )}
          <p style="font-size:13px;font-weight:700;color:#fff;margin:9px 0 2px;position:relative;">{s.label}</p>
          <p style="font-size:10.5px;color:#9aa6b6;margin:0;position:relative;">{s.sub}</p>
        </a>
      ))}
    </div>

    <div class="dash-mini" style="margin-top:12px;">
      {[
        {label:'Employees on record',value:empCount,href:'/admin/hr/employees',color:'#10b981'},
        {label:'Pending Leave',value:pendingLeave,href:'/admin/hr/leave',color:'#fbbf24'},
        {label:'HEI Published',value:heiCount,href:'/admin/hei/institutions',color:'#FF7040'},
      ].map(s=>(
        <a href={s.href} class="ds-tap ds-reveal dash-card" style="text-decoration:none;background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:12px;text-align:center;display:block;">
          {countsUnreadable ? (
            <p class="ds-count" title="This figure could not be read. It is not a count of zero." style="font-size:14px;font-weight:700;color:#e8c46a;margin:0;line-height:1.3;font-family:'Geist Mono',monospace;">not read</p>
          ) : (
            <p class="ds-count" data-count={s.value} style={`font-size:24px;font-weight:800;color:${s.color};margin:0;line-height:1;font-family:'Geist Mono',monospace;`}>0</p>
          )}
          <p style="font-size:10.5px;color:#9aa6b6;margin:5px 0 0;line-height:1.3;">{s.label}</p>
        </a>
      ))}
    </div>

    <div class="dash-two" style="margin-top:18px;">
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9aa6b6;margin:0;">Application Pipeline</p>
          <a href="/admin/applications" style="font-size:10.5px;color:#FF7040;text-decoration:none;font-weight:600;">View all →</a>
        </div>
        {statusRows.length > 0 ? (
          <div style="display:flex;flex-direction:column;gap:10px;">
            {statusRows.map((row:any)=>{
              if (!row || !row.status) return null;
              // The percentage needs a denominator, and the denominator comes from the tiles query.
              // When that did not answer, appCount is 0 and every stage would have printed "0%"
              // beside a real count - a share of nothing, stated as a fact. Print the count alone.
              const pctKnown = !countsUnreadable && appCount > 0;
              const pct = pctKnown ? Math.round((row.n/appCount)*100) : 0;
              const color = STATUS_COLOR[row.status] || '#6e6e78';
              return (
                <div>
                  <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                    <span style={`font-size:11.5px;font-weight:600;color:${color};text-transform:capitalize;`}>{row.status.replace('_',' ')}</span>
                    <span style="font-size:11px;color:#8a8a94;font-family:'Geist Mono',monospace;">{pctKnown ? row.n + ' · ' + pct + '%' : row.n}</span>
                  </div>
                  <div style="background:#15151a;border-radius:100px;height:5px;overflow:hidden;">
                    <div style={`background:${color};height:100%;width:${pct}%;border-radius:100px;box-shadow:0 0 8px ${color}88;`}></div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          /* THREE STATES, NOT ONE SENTENCE. "No pipeline data yet." was printed over a failed read,
             over an unconfigured platform and over a genuinely quiet week alike. */
          <DayOne
            state={pipelineError ? 'unreadable' : (nextStep ? 'unconfigured' : 'empty')}
            thing="The application pipeline"
            error={pipelineError || null}
            unconfiguredBody="No job role has been opened yet, so nobody can have applied. The pipeline fills itself once applications arrive; there is nothing to configure here."
            emptyBody="No application is in progress. Archived, hired, rejected and withdrawn applications are not counted here."
            actionLabel={nextStep ? 'Open a role so people can apply' : ''}
            actionHref={nextStep ? '/admin/roles/new' : ''}
            compact={true}
          />
        )}
      </div>

      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:14px;padding:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9aa6b6;margin:0;">Recent Applications</p>
          <a href="/admin/applications" style="font-size:10.5px;color:#FF7040;text-decoration:none;font-weight:600;">View all →</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:7px;">
          {recentApps.length === 0 && (
            <DayOne
              state={recentError ? 'unreadable' : (nextStep ? 'unconfigured' : 'empty')}
              thing="The recent applications list"
              error={recentError || null}
              unconfiguredBody="Nothing has been received. Applications arrive from the public careers page once a role is open there."
              emptyBody="No application has been received. This list ignores archived applications."
              actionLabel={nextStep ? 'Open a role on the careers page' : ''}
              actionHref={nextStep ? '/admin/roles/new' : ''}
              compact={true}
            />
          )}
          {recentApps.map((a:any)=>{
            if (!a) return null;
            const name = ((a.first_name||'')+' '+(a.last_name||'')).trim()||a.email||'Unknown';
            const color = STATUS_COLOR[a.status||'']||'#6e6e78';
            const date = a.created_at ? new Date(a.created_at).toLocaleDateString('en-IN',{ timeZone: 'Asia/Kolkata',day:'numeric',month:'short'}) : '';
            return (
              <a href={`/admin/applications/${a.id}`} class="dash-row" style="text-decoration:none;background:#121218;border:1px solid #1a1a1f;border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:10px;">
                <div style={`width:34px;height:34px;border-radius:50%;background:${color}22;border:1px solid ${color}44;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:${color};flex-shrink:0;`}>{name.substring(0,1).toUpperCase()}</div>
                <div style="flex:1;min-width:0;">
                  <p style="font-size:13px;font-weight:600;color:#fff;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{name}</p>
                  <p style="font-size:11px;color:#8a8a94;margin:1px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{a.role_title_snapshot||'No role'}</p>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0;">
                  <span style={`font-size:9px;font-weight:700;padding:2px 7px;border-radius:100px;text-transform:uppercase;background:${color}22;color:${color};`}>{a.status}</span>
                  <span style="font-size:10px;color:#8a8a94;">{date}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div style="margin-top:18px;padding-bottom:8px;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#9aa6b6;margin:0 0 10px;">Quick Actions</p>
      {/* THESE ARE STILL PEERS AND THEY STILL DO NOT IMPLY AN ORDER — that is what /admin/setup is
          for, and it is the first card so that somebody who has never seen this product finds the
          order before they find "Run Payroll", which cannot be undone. Departments is here because
          it is the actual first thing and was not offered anywhere on this page. */}
      <div class="dash-qa">
        {[
          {label:'Set up the platform',href:'/admin/setup',color:'#fbbf24'},
          {label:'Departments',href:'/admin/departments',color:'#f472b6'},
          {label:'New Role',href:'/admin/roles/new',color:'#60a5fa'},
          {label:'Add Employee',href:'/admin/hr/employees',color:'#10b981'},
          {label:'Leave Requests',href:'/admin/hr/leave',color:'#fbbf24'},
          {label:'Run Payroll',href:'/admin/hr/payroll',color:'#a78bfa'},
          {label:'HEI Institutions',href:'/admin/hei/institutions',color:'#FF7040'},
          {label:'Lab Feedback',href:'/admin/feedback',color:'#67e8f9'},
          {label:'View Public Site',href:'/',color:'#6e6e78'},
        ].map(action=>(
          <a href={action.href} class="dash-qa-card" style={`text-decoration:none;background:#0f0f14;border:1px solid #1a1a1f;border-left:3px solid ${action.color};border-radius:10px;padding:13px 14px;display:flex;align-items:center;justify-content:space-between;gap:8px;`}>
            <span style={`font-size:12.5px;font-weight:600;color:${action.color};`}>{action.label}</span>
            <span style={`font-size:13px;color:${action.color};opacity:0.6;`}>→</span>
          </a>
        ))}
      </div>
    </div>
  </div>

</div>

<style>
  .dash-wrap { max-width: 1180px; margin: 0 auto; }
  .dash-stats { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; }
  .dash-mini { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 10px; }
  .dash-two { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .dash-qa { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
  .dash-card, .dash-row, .dash-qa-card { transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .dash-card:hover { transform: translateY(-2px); border-color: #2a2a33; }
  .dash-row:hover { background: #16161d; border-color: #2a2a33; }
  .dash-qa-card:hover { transform: translateY(-1px); background: #15151c; }
  @media (min-width: 760px) {
    .dash-stats { grid-template-columns: repeat(4, minmax(0,1fr)); }
    .dash-two { grid-template-columns: 1fr 1fr; align-items: start; }
    .dash-qa { grid-template-columns: repeat(3, minmax(0,1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dash-card, .dash-row, .dash-qa-card { transition: none; }
    .dash-card:hover, .dash-qa-card:hover { transform: none; }
  }
</style>
</AdminLayout>
