---
// /admin/finance/invoices/settings — NUMBERING SERIES AND TAX COMPONENTS.
//
// TWO PIECES OF CONFIGURATION, both of which decide what every future invoice looks like, and neither
// of which is written into code:
//
//   NUMBERING   a series is a prefix and a counter. The counter is bumped INSIDE the statement that
//               inserts an invoice, so two people creating invoices in the same second get
//               consecutive numbers rather than the same one. The counter only moves forwards - this
//               page refuses to set it back, because a number already issued must never be issued
//               again to a different document.
//
//   TAX         a component is a code, a label, and either a percentage of the subtotal or a fixed
//               amount. THIS PRODUCT SHIPS NONE. Rates are jurisdiction-specific, they change, and a
//               rate written into the code would be a compliance claim the platform cannot stand
//               behind - the same decision src/lib/payroll.ts made after hardcoded statutory rates
//               were printed on payslips as though they were the law. What is configured here is
//               printed with the label somebody typed and nothing more.
//
// THE GATE: `invoices.manage` OR the `finance` section at edit level, for the reason written out on
// the console - a CUSTOM role holding the finance section resolves as `finance.edit` and never as the
// capability, so gating on the capability alone would be a narrowing dressed up as a mechanism change.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { can, canAccessSection } from '@/lib/auth/permissions';
import {
  listSeries,
  saveSeries,
  listTaxComponents,
  saveTaxComponent,
  taxBasisLabel,
  directionLabel,
  TAX_BASES,
  DIRECTIONS,
  type InvoiceSeries,
  type TaxComponent,
} from '@/lib/invoices';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// CONSTANTS FIRST — `const` is not hoisted.
const PAGE = '/admin/finance/invoices/settings';

const financeDesk = await canAccessSection(user, 'finance', 'edit');
const mayManage = can(user as any, 'invoices.manage') || financeDesk;
if (!mayManage) return Astro.redirect('/admin/finance/invoices');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';

  if (action === 'series') {
    const r = await saveSeries({
      id: String(fd.get('id') || ''),
      code: String(fd.get('code') || ''),
      label: String(fd.get('label') || ''),
      direction: String(fd.get('direction') || 'receivable'),
      prefix: String(fd.get('prefix') || ''),
      pad: String(fd.get('pad') || '4'),
      nextNumber: String(fd.get('next_number') || '1'),
      isActive: String(fd.get('is_active') || '') === 'on',
    }, String(user.id));
    flash = r.ok ? 'Numbering saved.' : 'Error: ' + (r.error || 'Could not save that series.');
  } else if (action === 'component') {
    const r = await saveTaxComponent({
      id: String(fd.get('id') || ''),
      code: String(fd.get('code') || ''),
      label: String(fd.get('label') || ''),
      basis: String(fd.get('basis') || 'percent_of_subtotal'),
      value: String(fd.get('value') || '0'),
      note: String(fd.get('note') || ''),
      isActive: String(fd.get('is_active') || '') === 'on',
    }, String(user.id));
    flash = r.ok ? 'Tax component saved.' : 'Error: ' + (r.error || 'Could not save that component.');
  }

  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash));
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const series: InvoiceSeries[] = await listSeries();
const components: TaxComponent[] = await listTaxComponents(true);
---
<AdminLayout title="Invoice numbering and tax" activeNav="invoice-settings">
  <div class="admin-page set-page">
    <div class="admin-page-header"><div class="admin-page-title-block">
      <div class="admin-page-eyebrow">Finance · Invoicing</div>
      <h1 class="admin-page-title">Numbering and tax</h1>
      <p class="admin-page-sub">
        What every future invoice is numbered, and what tax lines it can carry. Both are configuration
        an administrator sets - this platform ships no tax rate and makes no compliance claim.
      </p>
    </div></div>

    {msg && <div class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</div>}

    <p class="crossref"><a class="ext" href="/admin/finance/invoices">Back to invoices</a></p>

    <!-- ===================================================================================== -->
    <h2 class="sec">Numbering series · {series.length}</h2>
    <p class="sec-note">
      A number is the prefix followed by the counter, zero padded. The counter is bumped in the same
      database statement that creates the invoice, so two people creating one at the same moment get
      consecutive numbers rather than a collision. It can be moved FORWARD (to start a new year at
      1001, say) and never backward: a number already issued belongs to a document that exists.
    </p>

    <div class="tablewrap">
      <table class="tbl">
        <thead><tr><th>Code</th><th>Name</th><th>Direction</th><th>Next number</th><th>Active</th></tr></thead>
        <tbody>
          {series.map((s) => (
            <tr>
              <td>{s.code}</td>
              <td>{s.label}</td>
              <td>{directionLabel(s.direction)}</td>
              <td>{s.prefix}{String(s.nextNumber).padStart(s.pad, '0')}</td>
              <td>{s.isActive ? 'Yes' : 'Retired'}</td>
            </tr>
          ))}
          {series.length === 0 && <tr><td colspan="5">No series yet. Nothing can be numbered until one exists.</td></tr>}
        </tbody>
      </table>
    </div>

    {series.map((s) => (
      <details class="maker">
        <summary>Edit {s.code} · {s.label}</summary>
        <form method="POST" class="grid-form">
          <input type="hidden" name="action" value="series"/>
          <input type="hidden" name="id" value={s.id}/>
          <input type="hidden" name="code" value={s.code}/>
          <label class="fl">Name<input class="fi" name="label" value={s.label} required/></label>
          <label class="fl">Direction
            <select class="fi" name="direction">
              {DIRECTIONS.map((d) => <option value={d} selected={s.direction === d}>{directionLabel(d)}</option>)}
            </select>
          </label>
          <label class="fl">Prefix<input class="fi" name="prefix" value={s.prefix} required/></label>
          <label class="fl">Digits<input class="fi" name="pad" type="number" min="1" max="10" value={String(s.pad)}/></label>
          <label class="fl">Next number<input class="fi" name="next_number" type="number" min={String(s.nextNumber)} value={String(s.nextNumber)}/></label>
          <label class="check"><input type="checkbox" name="is_active" checked={s.isActive}/><span>Active</span></label>
          <button class="btn btn-go" type="submit">Save series</button>
        </form>
      </details>
    ))}

    <details class="maker">
      <summary>Add a numbering series</summary>
      <form method="POST" class="grid-form">
        <input type="hidden" name="action" value="series"/>
        <label class="fl">Code<input class="fi" name="code" required placeholder="INV2027"/></label>
        <label class="fl">Name<input class="fi" name="label" required placeholder="Sales invoices 2027"/></label>
        <label class="fl">Direction
          <select class="fi" name="direction">
            {DIRECTIONS.map((d) => <option value={d}>{directionLabel(d)}</option>)}
          </select>
        </label>
        <label class="fl">Prefix<input class="fi" name="prefix" required placeholder="INV-2027-"/></label>
        <label class="fl">Digits<input class="fi" name="pad" type="number" min="1" max="10" value="4"/></label>
        <label class="fl">Start at<input class="fi" name="next_number" type="number" min="1" value="1"/></label>
        <label class="check"><input type="checkbox" name="is_active" checked/><span>Active</span></label>
        <button class="btn btn-go" type="submit">Add series</button>
      </form>
    </details>

    <!-- ===================================================================================== -->
    <h2 class="sec">Tax components · {components.length}</h2>
    <p class="sec-note">
      A component is a label and a rate this organisation has decided on. It is applied to an invoice
      while that invoice is a draft, and the label, basis and value are COPIED onto it at that moment -
      so changing a rate here changes what future invoices carry and nothing about what an issued one
      already said. Nothing here is validated against any tax authority, and no invoice this platform
      prints claims to be.
    </p>

    <div class="tablewrap">
      <table class="tbl">
        <thead><tr><th>Code</th><th>Label</th><th>Basis</th><th class="num">Value</th><th>Active</th></tr></thead>
        <tbody>
          {components.map((c) => (
            <tr>
              <td>{c.code}</td>
              <td>{c.label}</td>
              <td>{taxBasisLabel(c.basis)}</td>
              <td class="num">{c.basis === 'percent_of_subtotal' ? c.value + '%' : c.value}</td>
              <td>{c.isActive ? 'Yes' : 'Retired'}</td>
            </tr>
          ))}
          {components.length === 0 && (
            <tr><td colspan="5">
              None configured. Invoices will total their lines with no tax line at all, which is the
              honest default rather than a guess at what applies here.
            </td></tr>
          )}
        </tbody>
      </table>
    </div>

    {components.map((c) => (
      <details class="maker">
        <summary>Edit {c.code} · {c.label}</summary>
        <form method="POST" class="grid-form">
          <input type="hidden" name="action" value="component"/>
          <input type="hidden" name="id" value={c.id}/>
          <input type="hidden" name="code" value={c.code}/>
          <label class="fl">Label<input class="fi" name="label" value={c.label} required/></label>
          <label class="fl">Basis
            <select class="fi" name="basis">
              {TAX_BASES.map((b) => <option value={b} selected={c.basis === b}>{taxBasisLabel(b)}</option>)}
            </select>
          </label>
          <label class="fl">Value<input class="fi" name="value" type="number" min="0" step="0.0001" value={String(c.value)} required/></label>
          <label class="fl fl-wide">Note<input class="fi" name="note" value={c.note || ''} placeholder="What this is, for whoever reads it next"/></label>
          <label class="check"><input type="checkbox" name="is_active" checked={c.isActive}/><span>Active</span></label>
          <button class="btn btn-go" type="submit">Save component</button>
        </form>
      </details>
    ))}

    <details class="maker">
      <summary>Add a tax component</summary>
      <form method="POST" class="grid-form">
        <input type="hidden" name="action" value="component"/>
        <label class="fl">Code<input class="fi" name="code" required placeholder="service_tax"/></label>
        <label class="fl">Label<input class="fi" name="label" required placeholder="Printed on the invoice exactly as written"/></label>
        <label class="fl">Basis
          <select class="fi" name="basis">
            {TAX_BASES.map((b) => <option value={b}>{taxBasisLabel(b)}</option>)}
          </select>
        </label>
        <label class="fl">Value<input class="fi" name="value" type="number" min="0" step="0.0001" required/></label>
        <label class="fl fl-wide">Note<input class="fi" name="note" placeholder="What this is, for whoever reads it next"/></label>
        <label class="check"><input type="checkbox" name="is_active" checked/><span>Active</span></label>
        <button class="btn btn-go" type="submit">Add component</button>
      </form>
    </details>
  </div>

  <style>
    /* MOBILE FIRST. Tables scroll inside their own box; the page never scrolls sideways. */
    .set-page{ max-width:940px; }
    .flash{ margin:0 0 16px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3);
      color:#6ee7b7; border-radius:8px; padding:10px 14px; font-size:13px; overflow-wrap:anywhere; }
    .flash.warn{ background:rgba(248,113,113,0.09); border-color:rgba(248,113,113,0.38); color:#fca5a5; }
    .crossref{ font-size:13px; color:#8a8a94; margin:0 0 18px; }
    .ext{ color:#f97316; overflow-wrap:anywhere; }
    .sec{ font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase;
      color:#c2410c; font-weight:700; margin:26px 0 6px; }
    .sec-note{ font-size:12.5px; color:#8a8a94; margin:0 0 12px; line-height:1.6; overflow-wrap:anywhere; }

    .tablewrap{ overflow-x:auto; -webkit-overflow-scrolling:touch; border:1px solid #1a1a1f;
      border-radius:10px; background:#0f0f14; margin-bottom:12px; }
    .tbl{ width:100%; border-collapse:collapse; font-size:12.5px; min-width:520px; }
    .tbl th{ text-align:left; color:#8a8a94; font-size:10px; text-transform:uppercase; letter-spacing:0.08em;
      padding:9px 10px; border-bottom:1px solid #1a1a1f; white-space:nowrap; }
    .tbl td{ padding:9px 10px; border-bottom:1px solid #151519; color:#cfd6da; vertical-align:top; }
    .tbl td.num, .tbl th.num{ text-align:right; font-family:'Geist Mono',monospace; white-space:nowrap; }

    .maker{ background:#0f0f14; border:1px solid #1a1a1f; border-radius:10px; padding:12px 14px;
      margin-bottom:8px; }
    .maker summary{ cursor:pointer; color:#fff; font-size:13px; font-weight:700; min-height:36px;
      display:flex; align-items:center; overflow-wrap:anywhere; }

    .grid-form{ display:grid; grid-template-columns:1fr; gap:8px; width:100%; margin-top:10px; }
    .fl{ display:flex; flex-direction:column; gap:4px; font-size:11px; color:#8a8a94;
      text-transform:uppercase; letter-spacing:0.06em; min-width:0; }
    .fi{ background:#08080b; border:1px solid #262630; border-radius:7px; padding:11px 10px; color:#fff;
      font-size:13px; outline:none; font-family:inherit; min-width:0; width:100%;
      text-transform:none; letter-spacing:0; }
    .check{ display:flex; gap:9px; align-items:center; font-size:13px; color:#cfd6da; min-height:44px; }
    .check input{ width:20px; height:20px; flex:0 0 auto; }
    /* 44px minimum touch target on every control. */
    .btn{ border:none; border-radius:7px; padding:0 16px; min-height:44px; color:#fff; font-size:12px;
      font-weight:700; cursor:pointer; font-family:'Geist Mono',monospace; white-space:nowrap; }
    .btn-go{ background:#c2410c; }

    @media (min-width:620px){
      .grid-form{ grid-template-columns:repeat(2, minmax(0, 1fr)); align-items:end; }
      .fl-wide{ grid-column:1 / -1; }
    }
  </style>
</AdminLayout>
