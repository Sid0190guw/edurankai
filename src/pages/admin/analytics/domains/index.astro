---
// /admin/analytics/domains — the entry point for the domain dashboards.
//
// THIS PAGE RENDERS NOTHING, AND THAT IS THE POINT. Every dashboard, including the executive
// roll-up, is drawn by ./[domain].astro from one set of markup; a second copy of that markup here —
// to serve as a "directory" — would be the thing that drifts. The roll-up IS the directory: it
// carries one figure from each domain and the tab strip that reaches them.
//
// The gate is not repeated here either. It is on the page this hands off to, where it cannot be
// bypassed by typing the deeper URL, and duplicating it would create a second place for the
// permission to be wrong.
const params = Astro.url.searchParams;
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
const from = DATE_RE.test(String(params.get('from') || '')) ? String(params.get('from')) : '';
const to = DATE_RE.test(String(params.get('to') || '')) ? String(params.get('to')) : '';
const query = from && to ? '?from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to) : '';
return Astro.redirect('/admin/analytics/domains/executive' + query);
---
