---
// /admin/analytics/workforce — WORKFORCE ANALYTICS. AGGREGATE ONLY, SUPPRESSED BELOW THE PLATFORM
// MINIMUM GROUP SIZE.
//
// =================================================================================================
// WHY THIS URL AND NOT /admin/analytics
// =================================================================================================
//
// /admin/analytics ALREADY EXISTS and is the WEBSITE traffic console: analytics_pageviews,
// analytics_sessions, visitor devices, countries, live sessions. A different subject on a different
// data model, and taking its route would have replaced a working screen with this one. Two paths,
// no duplicated module: nothing here reads anything that page reads, and nothing there is moved.
//
// =================================================================================================
// THE SCREEN THAT MUST NOT EXIST, AND WHY THIS ONE IS NOT IT
// =================================================================================================
//
// Nothing on this page is a row per person. Every number behind it comes from a COUNT, an AVG or a
// GROUP BY in src/lib/analytics-workforce.ts, and not one of those queries selects a name, an id or
// an email. There is no drill-down, no "show me the three people in this band", and no export of
// individuals. A manager who needs to see one person's attendance sees it on that person's own
// record, through a relationship the organization graph records — not by filtering a company-wide
// table down to one row and calling it a report.
//
// SUPPRESSION IS REAL, AND SO IS THE TOTAL. A band below the platform minimum group size is
// withheld, AND the breakdown total is withheld with it: publishing 34 next to two visible bands
// adding to 31 discloses the third exactly. That rule is implemented once, in suppressBands(), and
// this page renders whatever it is handed.
//
// NO WELLNESS DATA IS READ, ANYWHERE BEHIND THIS SCREEN. Not aggregated, not counted, not joined.
// The protection is the absence of the query, not a permission that a future edit could widen.
// Neither is salary, gender, date of birth, a government id or a bank column.
//
// =================================================================================================
// THE GATE
// =================================================================================================
//
// `analytics.view`, asked with can() — the built-in matrix — granted to super_admin and hr, the two
// roles that already hold employee.manage and can therefore already read every individual employee
// record one at a time. This hands them the aggregate instead, which is the narrower artefact.
//
// THE PAGE MUST ASK, BECAUSE MIDDLEWARE CANNOT. src/middleware.ts maps admin paths to section keys
// for its own permission gate, and there is no section key for /admin/analytics — so the only thing
// standing in front of this URL is canOpenAdmin(), which admits every admin-capable role including
// the `editor` that offer letters once handed to interns. This check is therefore the real gate, and
// removing it would open aggregate people data to seven roles.
//
// const BEFORE ANY HANDLER: there is no POST handler here at all. The view and the period live in
// the URL, so the state is shareable and there is nothing above the declarations to reach a const
// early.
//
// CLIENT JAVASCRIPT: NONE. The bars are CSS widths on a server-rendered number.
// MOBILE FIRST: 360px, 44px targets, single column, nothing scrolls the page sideways.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  ANALYTICS_VIEWS,
  parseAnalyticsView,
  buildAnalytics,
  MIN_GROUP,
  TOO_FEW_LABEL,
} from '@/lib/analytics-workforce';

const PATH = '/admin/analytics/workforce';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// THE GATE. See the header: middleware has no section key for this path, so this line is what
// stands in front of the data.
if (!can(user as any, 'analytics.view')) return Astro.redirect('/admin');

// ------------------------------------------------------------------------------------------------
// EVERY CONST BEFORE ITS FIRST USE.
// ------------------------------------------------------------------------------------------------

const params = Astro.url.searchParams;
const view = parseAnalyticsView(params.get('view'));

const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
const todayIso = new Date().toISOString().slice(0, 10);
const defaultFrom = new Date(Date.now() - 30 * 86400000).toISOString().slice(0, 10);
const fromParam = String(params.get('from') || '');
const toParam = String(params.get('to') || '');
const from = DATE_RE.test(fromParam) ? fromParam : defaultFrom;
const to = DATE_RE.test(toParam) ? toParam : todayIso;

const model = await buildAnalytics(view, { from, to });

const hrefFor = (v: string) =>
  PATH + '?view=' + encodeURIComponent(v) + '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to);

/** The widest visible band, so the bars have a scale. Suppressed bands contribute nothing. */
const widestIn = (bands: any[]): number => {
  let max = 0;
  for (const b of bands) if (!b.suppressed && typeof b.count === 'number' && b.count > max) max = b.count;
  return max;
};

/** Bar width as a percentage string. A suppressed band gets no bar at all — an empty bar next to
 *  "too few to report" still draws a shape somebody would try to read. */
const barWidth = (count: number | null, max: number): string => {
  if (count === null || max <= 0) return '0%';
  return String(Math.max(4, Math.round((count / max) * 100))) + '%';
};

const periodMatters = view === 'attendance' || view === 'leave' || view === 'recruitment';
---

<AdminLayout title="Workforce analytics" activeNav="">
  <div class="an">
    <header class="an__head">
      <h1>Workforce analytics</h1>
      <p>{model.explanation}</p>
    </header>

    <nav class="an__tabs" aria-label="Analytics views">
      {ANALYTICS_VIEWS.map((v) => (
        <a class="an__tab" href={hrefFor(v.key)} aria-current={v.key === view ? 'page' : null}>{v.label}</a>
      ))}
    </nav>

    <p class="an__note">
      The per-domain dashboards — payroll, learning, finance, work delivery and an executive roll-up,
      each figure carrying what it counts and over what period — are at
      <a href="/admin/analytics/domains/executive">the domain dashboards</a>. They read the same
      suppression rule as this page, from the same function, and are scoped through the organization
      graph so a department head sees their department rather than the company.
    </p>

    {periodMatters && (
      <form class="an__period" method="get" action={PATH}>
        <input type="hidden" name="view" value={view} />
        <label for="an-from">From</label>
        <input class="an__field" id="an-from" name="from" type="date" value={from} max={todayIso} />
        <label for="an-to">To</label>
        <input class="an__field" id="an-to" name="to" type="date" value={to} max={todayIso} />
        <button class="an__go" type="submit">Apply</button>
      </form>
    )}

    {!periodMatters && (
      <p class="an__note">
        This view describes the organization as it stands now. Employee records are updated in place,
        so there is no way to ask what these numbers were on a past date, and a date filter here would
        be decoration over a number that ignored it.
      </p>
    )}

    <p class="an__rule">
      Anything covering fewer than {MIN_GROUP} people is not reported. Below that a count stops being
      a statistic and starts describing somebody. When a band is withheld its breakdown total is
      withheld too, because the missing number would otherwise be a subtraction away.
    </p>

    {model.degraded && (
      <p class="an__warn">
        Part of this view could not be read, so it is incomplete. What could not be read is named on
        the panel it belongs to. Nothing here is estimated to fill a gap.
      </p>
    )}

    {model.panels.map((panel) => (
      <section class="an__panel">
        <h2>{panel.label}</h2>
        <p class="an__blurb">{panel.blurb}</p>

        {!panel.available && <p class="an__warn">{panel.note}</p>}

        {panel.metrics.length > 0 && (
          <div class="an__metrics">
            {panel.metrics.map((m) => (
              <div class="an__metric">
                <b>{m.suppressed ? TOO_FEW_LABEL : (m.value === null ? 'Not available' : m.value)}</b>
                <span>{m.label}</span>
                {m.hint && <small>{m.hint}</small>}
              </div>
            ))}
          </div>
        )}

        {panel.bands.length > 0 && (
          <div class="an__bands">
            <h3>{panel.bandsTitle}</h3>
            {panel.bands.map((b) => (
              <div class="an__band">
                <div class="an__bandtop">
                  <span>{b.label}</span>
                  <strong>{b.suppressed ? TOO_FEW_LABEL : String(b.count)}</strong>
                </div>
                <div class="an__track">
                  <div class="an__fill" style={'width:' + barWidth(b.count, widestIn(panel.bands))}></div>
                </div>
              </div>
            ))}
          </div>
        )}

        {panel.available && panel.note && <p class="an__note">{panel.note}</p>}
        {panel.available && panel.bands.length === 0 && !panel.note && panel.metrics.length === 0 && (
          <p class="an__note">There is nothing recorded to report on for this period.</p>
        )}
      </section>
    ))}

    <p class="an__foot">
      Every number on this page is a count or an average across a group. No query behind it returns a
      row per person, and there is nowhere on this screen to reach one. Individual health and
      wellness data is never read here at all, by anyone, including the founder: that is enforced by
      there being no such query rather than by a permission somebody could widen later.
    </p>
  </div>
</AdminLayout>

<style>
  .an { max-width: 860px; margin: 0 auto; padding: 4px 0 32px; }
  .an__head h1 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  .an__head p { margin: 6px 0 0; font-size: 0.8125rem; line-height: 1.6; color: #564E43; }

  .an__tabs { display: flex; gap: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch;
    padding: 12px 0 2px; margin: 0; scrollbar-width: thin; }
  .an__tab { flex: none; display: inline-flex; align-items: center; min-height: 40px; padding: 8px 14px;
    border: 1px solid #DFDCD8; border-radius: 999px; background: #FDFDFC; color: #564E43;
    font-size: 0.8125rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .an__tab[aria-current="page"] { background: #1B1813; border-color: #1B1813; color: #FFFFFF; }
  .an__tab:focus-visible { outline: 2px solid #6F52E5; outline-offset: 2px; }

  .an__period { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 14px 0 0; }
  .an__period label { font-size: 0.75rem; font-weight: 650; color: #564E43; }
  .an__field { flex: 1 1 140px; min-width: 0; min-height: 44px; padding: 10px 12px;
    border: 1px solid #DFDCD8; border-radius: 8px; background: #FDFDFC; color: #1B1813;
    font: inherit; font-size: 0.875rem; }
  .an__go { flex: 1 1 110px; min-height: 44px; padding: 10px 16px; border: 1px solid #1B1813;
    border-radius: 8px; background: #1B1813; color: #FFFFFF; font: inherit; font-size: 0.875rem;
    font-weight: 650; cursor: pointer; }
  .an__go:focus-visible { outline: 2px solid #6F52E5; outline-offset: 2px; }

  .an__rule { margin: 14px 0 0; padding: 11px 13px; border: 1px solid #CDD8EA; border-radius: 10px;
    background: #F1F5FB; font-size: 0.8125rem; line-height: 1.6; color: #224E91; }
  .an__warn { margin: 12px 0 0; padding: 10px 12px; border: 1px solid #EADECD; border-radius: 10px;
    background: #FBF7F1; font-size: 0.8125rem; line-height: 1.55; color: #6D470D; }
  .an__note { margin: 12px 0 0; font-size: 0.75rem; line-height: 1.6; color: #70685C; }

  .an__panel { margin: 16px 0 0; padding: 14px; border: 1px solid #DFDCD8; border-radius: 12px;
    background: #FDFDFC; }
  .an__panel h2 { margin: 0; font-size: 1rem; font-weight: 680; letter-spacing: -0.01em; }
  .an__blurb { margin: 4px 0 0; font-size: 0.8125rem; line-height: 1.55; color: #564E43; }

  .an__metrics { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 0; }
  .an__metric { flex: 1 1 180px; min-width: 0; padding: 11px 13px; border: 1px solid #DFDCD8;
    border-radius: 10px; background: #F8F8F6; }
  .an__metric b { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.375rem; line-height: 1.15; overflow-wrap: anywhere; }
  .an__metric span { display: block; margin-top: 3px; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #70685C; }
  .an__metric small { display: block; margin-top: 6px; font-size: 0.75rem; line-height: 1.5;
    color: #70685C; }

  .an__bands { margin: 16px 0 0; }
  .an__bands h3 { margin: 0 0 8px; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #70685C; font-weight: 650; }
  .an__band { margin-bottom: 10px; }
  .an__bandtop { display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    font-size: 0.8125rem; }
  .an__bandtop span { overflow-wrap: anywhere; }
  .an__bandtop strong { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: nowrap; }
  .an__track { margin-top: 4px; height: 8px; border-radius: 999px; background: #EFEDE9; overflow: hidden; }
  .an__fill { height: 100%; background: #1B1813; }

  .an__foot { margin: 20px 0 0; padding: 14px 0 0; border-top: 1px solid #DFDCD8;
    font-size: 0.75rem; line-height: 1.7; color: #70685C; }

  @media (forced-colors: active) {
    .an__fill { background: CanvasText; }
  }
</style>
