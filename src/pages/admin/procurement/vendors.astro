---
// /admin/procurement/vendors — WHO WE BUY FROM.
//
// An address book, and deliberately nothing more: a name, a category, somebody to contact and a
// note. NO bank details, NO payment terms, NO credit limit. Anything that moves money lives in the
// finance module and is not duplicated here — two places holding one supplier's account details is
// one place too many, and the one nobody remembers is the one that goes stale.
//
// A VENDOR IS NEVER DELETED. Purchase requests and orders point at it, and that history is the
// evidence behind money the company spent. Retiring one hides it from the pick list on the request
// form and leaves every past record intact and readable.
//
// NO REAL COMPANY IS NAMED anywhere in this page, its placeholders or its examples. The list starts
// empty and is filled in by whoever runs purchasing here.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { flashFailed } from '@/lib/flash-tone';
import { can, canAccessSection } from '@/lib/auth/permissions';
import {
  listVendors,
  createVendor,
  setVendorActive,
  categoryLabel,
  PROCUREMENT_CATEGORIES,
} from '@/lib/procurement';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// -------------------------------------------------------------------------------------------------
// CONSTANTS FIRST — `const` is not hoisted, and a const declared under the POST handler that reads
// it throws on that handler's first line while the page still reports success.
// -------------------------------------------------------------------------------------------------
const PAGE = '/admin/procurement/vendors';

// THE SAME GATE AS THE CONSOLE, asked the same way: `procurement.view` OR the `finance` section at
// edit level, because a custom role holding that section resolves as `finance.edit` and never as
// `procurement.view`, and gating on the capability alone would shut out every custom role that can
// open /admin/finance today.
const financeDesk = await canAccessSection(user, 'finance', 'edit');
if (!(can(user as any, 'procurement.view') || financeDesk)) return Astro.redirect('/admin');

/** Adding and retiring a vendor is the write half, and it is a separate permission. */
const mayManage = can(user as any, 'procurement.manage') || financeDesk;

// -------------------------------------------------------------------------------------------------
// WRITES
// -------------------------------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';

  if (!mayManage) {
    flash = 'You can read the vendor list. Changing it is a separate permission.';
  } else if (action === 'create') {
    const r = await createVendor({
      name: String(fd.get('name') || ''),
      category: String(fd.get('category') || ''),
      contactName: String(fd.get('contact_name') || ''),
      contactEmail: String(fd.get('contact_email') || ''),
      contactPhone: String(fd.get('contact_phone') || ''),
      website: String(fd.get('website') || ''),
      notes: String(fd.get('notes') || ''),
    }, String(user.id));
    flash = r.ok ? 'Vendor added.' : 'Error: ' + (r.error || 'Could not add that vendor.');
  } else if (action === 'retire' || action === 'restore') {
    const r = await setVendorActive(String(fd.get('id') || ''), action === 'restore', String(user.id));
    if (!r.ok) flash = 'Error: ' + (r.error || 'Could not change that vendor.');
    else if (r.changed === false) flash = 'That was already the case. Nothing changed.';
    else flash = action === 'restore' ? 'Vendor restored.' : 'Vendor retired. Past records are unchanged.';
  }

  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash));
}

// -------------------------------------------------------------------------------------------------
// READS
// -------------------------------------------------------------------------------------------------
/**
 * The sentence the Retire button asks, BUILT HERE rather than inside the JSX attribute.
 *
 * A regex literal beside a string concatenation inside an `.astro` attribute expression
 * desynchronises the template parser, and the compiler then reports missing closing tags a hundred
 * lines further down — the same family as the "no Record<string,string> typed maps inside JSX" rule
 * in CLAUDE.md. A named function keeps the attribute to one call and the sentence readable.
 *
 * NAMES THE VENDOR, because this is a stack of cards with an identically worded button in the same
 * corner of every one, and on a narrow screen the button wraps under the card body — so the name a
 * person is reading and the button their thumb is on are not necessarily the same card. It also
 * says what retiring does and does NOT do: "Retire" reads as "delete" to somebody who has not used
 * this screen, and the file header is explicit that a vendor is never deleted.
 */
function retireVendorConfirm(v: any): string {
  const name = String(v?.name === null || v?.name === undefined ? '' : v.name).replace(/[^\w \-.,]/g, '').slice(0, 60);
  return 'return confirm("Retire the vendor ' + (name || 'this vendor') +
    '?\\n\\nThey stop being offered on new purchase requests. Orders already placed with them are not changed, and they stay in the retired list below.")';
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
const vendors = await listVendors({ includeInactive: true });
const active = vendors.filter((v) => v.isActive);
const retired = vendors.filter((v) => !v.isActive);
---
<AdminLayout title="Vendors" activeNav="">
  <div class="admin-page vend-page">
    <div class="admin-page-header"><div class="admin-page-title-block">
      <div class="admin-page-eyebrow">Finance · Purchasing</div>
      <h1 class="admin-page-title">Vendors</h1>
      <p class="admin-page-sub">
        Who we buy from, and who to talk to there. An address book - no account details, no payment
        terms. A vendor is retired rather than deleted, so the purchase records that point at it keep
        making sense.
      </p>
    </div></div>

    {msg && <div class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</div>}

    <p class="crossref">Back to <a href="/admin/procurement">Procurement</a>.</p>

    {mayManage && (
      <div class="card card-block">
        <div class="card-title">Add a vendor</div>
        <form method="POST" class="grid-form">
          <input type="hidden" name="action" value="create"/>
          <label class="fl">Name<input class="fi" name="name" required maxlength="300" placeholder="Supplier name"/></label>
          <label class="fl">Category
            <select class="fi" name="category">
              <option value="">Not categorised</option>
              {PROCUREMENT_CATEGORIES.map((c) => (<option value={c}>{categoryLabel(c)}</option>))}
            </select>
          </label>
          <label class="fl">Contact name<input class="fi" name="contact_name" maxlength="300"/></label>
          <label class="fl">Contact email<input class="fi" name="contact_email" type="email" maxlength="300"/></label>
          <label class="fl">Contact phone<input class="fi" name="contact_phone" type="tel" maxlength="40"/></label>
          <label class="fl">Website<input class="fi" name="website" type="url" placeholder="https://"/></label>
          <label class="fl fl-wide">Note<input class="fi" name="notes" maxlength="2000" placeholder="What we buy from them, anything worth knowing"/></label>
          <button class="btn btn-go" type="submit">Add vendor</button>
        </form>
      </div>
    )}

    {!mayManage && (
      <div class="banner banner-note">
        <div>
          <strong>Read access.</strong>
          <p>You can see the vendor list. Adding or retiring one is a separate permission.</p>
        </div>
      </div>
    )}

    <h2 class="sec">In use · {active.length}</h2>
    {active.length === 0 && (
      <p class="empty">
        No vendors recorded yet. Until one is added, a person raising a request names a supplier in
        their own words on the request itself - nothing is blocked by this list being empty.
      </p>
    )}
    {active.map((v) => (
      <div class="card">
        <div class="card-main">
          <div class="card-title">{v.name}{v.category && <span class="chip">{categoryLabel(v.category)}</span>}</div>
          <div class="card-sub">
            {v.contactName || 'No named contact'}
            {v.contactEmail ? ' · ' + v.contactEmail : ''}
            {v.contactPhone ? ' · ' + v.contactPhone : ''}
          </div>
          {v.website && (
            <div class="card-sub"><a class="ext" href={v.website} target="_blank" rel="noopener noreferrer">{v.website}</a></div>
          )}
          {v.notes && <div class="card-sub">{v.notes}</div>}
        </div>
        {/* NAMES THE VENDOR. This is a stack of cards with an identically worded button in the
            same corner of every one, and on a phone the button wraps under the card body — so the
            name a person is looking at and the button they tap are not necessarily the same row.
            The sentence also says what retiring does and does not do, because "Retire" reads as
            "delete" to somebody who has not used this screen before.

            THIS COMMENT MOVED OUT OF THE `&&` EXPRESSION, and that is the whole change here. It sat
            as the first child inside `{mayManage && ( ... )}`, where `{/* ... *​/}` is not a JSX
            comment at all — inside the parentheses it parses as an object literal followed by an
            adjacent element, which is the ".astro specifics" trap in CLAUDE.md. It did not merely
            break this page: astro compiled the file to `Expected ")" but found "$$render"` and
            `npm run build` FAILED OUTRIGHT, so every workflow sharing this worktree had a red
            build. Nothing about the markup or the condition changed. */}
        {mayManage && (
          <form method="POST" class="inline-form" onsubmit={retireVendorConfirm(v)}>
            <input type="hidden" name="action" value="retire"/>
            <input type="hidden" name="id" value={v.id}/>
            <button class="btn btn-thin" type="submit">Retire</button>
          </form>
        )}
      </div>
    ))}

    <h2 class="sec">Retired · {retired.length}</h2>
    {retired.length === 0 && <p class="empty">Nothing retired.</p>}
    {retired.map((v) => (
      <div class="card">
        <div class="card-main">
          <div class="card-title">{v.name}<span class="chip">Retired</span></div>
          <div class="card-sub">
            Hidden from the request form. Every past request and order that names them is unchanged.
          </div>
        </div>
        {mayManage && (
          <form method="POST" class="inline-form">
            <input type="hidden" name="action" value="restore"/>
            <input type="hidden" name="id" value={v.id}/>
            <button class="btn btn-thin" type="submit">Restore</button>
          </form>
        )}
      </div>
    ))}
  </div>

  <style>
    /* MOBILE FIRST: the base rules are the 360px rules. min-width:0 on every flex child, because a
       flex item defaults to min-width:auto and a long unbroken URL would otherwise push the card
       wider than the phone and make the PAGE scroll sideways. */
    .vend-page{ max-width:1000px; }
    .flash{ margin:0 0 16px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3);
      color:#6ee7b7; border-radius:8px; padding:10px 14px; font-size:13px; overflow-wrap:anywhere; }
    .flash.warn{ background:rgba(248,113,113,0.09); border-color:rgba(248,113,113,0.38); color:#fca5a5; }
    .banner{ display:flex; gap:12px; align-items:flex-start; border-radius:10px; padding:14px;
      margin:0 0 18px; font-size:13px; line-height:1.5; }
    .banner-note{ background:rgba(148,163,184,0.08); border:1px solid rgba(148,163,184,0.28); color:#cbd5e1; }
    .banner p{ margin:6px 0 0; color:#d8d2bd; }
    .crossref{ font-size:13px; color:#8a8a94; margin:0 0 20px; }
    .crossref a, .ext{ color:#f97316; overflow-wrap:anywhere; }
    .sec{ font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase;
      color:#c2410c; font-weight:700; margin:26px 0 8px; }
    .empty{ color:#8a8a94; font-size:13px; margin:0 0 18px; line-height:1.6; }
    .card{ display:flex; gap:12px; background:#0f0f14; border:1px solid #1a1a1f; border-radius:10px;
      padding:12px 14px; margin-bottom:8px; flex-wrap:wrap; align-items:flex-start; }
    .card-block{ flex-direction:column; }
    .card-main{ flex:1 1 220px; min-width:0; overflow-wrap:anywhere; }
    .card-title{ color:#fff; font-weight:700; font-size:14px; display:flex; flex-wrap:wrap; gap:8px;
      align-items:center; }
    .card-sub{ color:#8a8a94; font-size:12px; margin-top:3px; line-height:1.5; overflow-wrap:anywhere; }
    .grid-form{ display:grid; grid-template-columns:1fr; gap:8px; width:100%; margin-top:12px; }
    .inline-form{ display:flex; gap:6px; flex-wrap:wrap; flex:0 0 auto; }
    .fl{ display:flex; flex-direction:column; gap:4px; font-size:11px; color:#8a8a94;
      text-transform:uppercase; letter-spacing:0.06em; min-width:0; }
    .fi{ background:#08080b; border:1px solid #262630; border-radius:7px; padding:11px 10px; color:#fff;
      font-size:13px; outline:none; font-family:inherit; width:100%; min-width:0;
      text-transform:none; letter-spacing:0; }
    /* 44px minimum touch target — a control that needs a second attempt gets pressed twice. */
    .btn{ border:none; border-radius:7px; padding:0 16px; min-height:44px; color:#fff; font-size:12px;
      font-weight:700; cursor:pointer; font-family:'Geist Mono',monospace; white-space:nowrap; }
    .btn-go{ background:#c2410c; }
    .btn-thin{ background:transparent; border:1px solid #333; color:#cfd6da; font-size:11px; }
    .chip{ font-family:'Geist Mono',monospace; font-size:10px; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; border-radius:999px; padding:3px 9px; background:#1a1a1f; color:#8a8a94; }
    @media (min-width:620px){
      .grid-form{ grid-template-columns:repeat(2, minmax(0, 1fr)); align-items:end; }
      .fl-wide{ grid-column:1 / -1; }
    }
  </style>
</AdminLayout>
