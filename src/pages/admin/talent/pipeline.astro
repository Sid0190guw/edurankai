---
// /admin/talent/pipeline — THE EVALUATION PIPELINE, ON A SCREEN.
//
// WHY THIS PAGE EXISTS. src/lib/talent/stages.ts is the configurable seven-stage engine, and until
// this page it was imported by nothing but its own test. The repository has a gate for exactly that
// (src/lib/orphan-detect.test.ts): a library module nothing imports is dead code, and dead code
// accumulates silently. An engine with a passing test suite and no door is the most convincing kind
// of dead code, because it looks maintained.
//
// So this is the door. It is READ-ONLY on purpose — editing a pipeline is a separate piece of work
// with its own audit requirements, and a half-built editor would be worse than an honest register.
// What it does do is let somebody answer, without opening a SQL client: what are the stages, which
// carry a pass mark, which may be passed over, and what does a candidate see while sitting on each.
//
// THE THREE STATES ARE DISTINCT. A pipeline that reads back, a pipeline that is genuinely absent,
// and a read that failed must never look alike — success-but-empty rendering identically to failure
// is the defect this project has paid for repeatedly. ensureDefaultPipeline() returns a
// TalentResult, so the failure carries its reason and the page prints it.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  ensureDefaultPipeline, passScoreOf, isRequiredOf, publicStageFor, applicationStatusFor,
  DEFAULT_PIPELINE_SLUG,
} from '@/lib/talent/stages';
import { STAGE_TYPE_LABELS, STAGE_EXPECTS_EVALUATION } from '@/lib/talent/types';

// Declared before anything below reads them: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
const user = Astro.locals.user!;
const mayView = can(user, 'roles.view') || can(user, 'roles.edit');
if (!mayView) return Astro.redirect('/admin');

const result = await ensureDefaultPipeline(user.id);
const pipeline = result.ok ? (result.data || null) : null;
const loadError = result.ok ? '' : (result.error || 'The pipeline could not be read.');

// Everything the table needs, resolved in frontmatter. Comparisons must not appear inside JSX on
// this project, so each row is decided here and the template only renders strings.
const rows = (pipeline?.stages || []).map((s) => {
  const passScore = passScoreOf(s);
  const required = isRequiredOf(s);
  const expects = STAGE_EXPECTS_EVALUATION[s.stageType];
  return {
    ordinal: String(s.ordinal),
    key: s.key,
    label: s.label,
    typeLabel: STAGE_TYPE_LABELS[s.stageType] || s.stageType,
    passLabel: passScore === null ? 'No pass mark' : passScore + '%',
    requiredLabel: required ? 'Required' : 'Optional',
    requiredClass: required ? 'text-neutral-900' : 'text-neutral-500',
    slaLabel: s.slaHours === null ? 'No target' : Math.round(s.slaHours / 24) + ' days',
    expectsLabel: expects ? String(expects) : 'No evidence of its own',
    terminalLabel: s.isTerminal ? 'Ends the pipeline' : '',
    publicStep: publicStageFor(s.key),
    appStatus: applicationStatusFor(s.key),
    blurb: s.candidateBlurb,
  };
});

const stageCount = rows.length;
const hasStages = stageCount > 0;
---

<AdminLayout title="Evaluation pipeline">
  <div class="mx-auto w-full max-w-5xl px-5 py-8">

    <h1 class="text-2xl font-semibold tracking-tight text-neutral-900">Evaluation pipeline</h1>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-600">
      The internal stages every application is worked through. Candidates never see these names: each
      one projects onto one of the six published steps, which is what appears in their portal.
    </p>

    {loadError && (
      <div class="mt-6 rounded-lg border border-rose-300 bg-rose-50 p-4">
        <p class="text-sm font-medium text-rose-900">The pipeline could not be read</p>
        <p class="mt-1 text-sm leading-relaxed text-rose-800">{loadError}</p>
        <p class="mt-2 text-xs text-rose-700">
          The talent tables may not exist on this environment yet. They are created on first use, or
          by applying the schema mirror by hand.
        </p>
      </div>
    )}

    {!loadError && !hasStages && (
      <div class="mt-6 rounded-lg border border-dashed border-neutral-300 p-6">
        <p class="text-sm font-medium text-neutral-900">No stages are configured</p>
        <p class="mt-1 text-sm leading-relaxed text-neutral-600">
          The default pipeline exists but carries no stages. That is not a normal state; it usually
          means a partial seed. Re-opening this page re-runs the seed.
        </p>
      </div>
    )}

    {!loadError && hasStages && (
      <div class="mt-6">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <p class="text-sm font-medium text-neutral-900">{pipeline?.name}</p>
          <p class="text-xs text-neutral-500">
            {DEFAULT_PIPELINE_SLUG} &middot; version {String(pipeline?.version)} &middot; {String(stageCount)} stages
          </p>
        </div>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[56rem] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-neutral-300">
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">#</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Stage</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Type</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Pass mark</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Optionality</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Target</th>
                <th class="py-2 pr-3 text-xs font-medium uppercase tracking-wide text-neutral-500">Candidate sees</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-neutral-200 align-top">
                  <td class="py-3 pr-3 tabular-nums text-neutral-500">{r.ordinal}</td>
                  <td class="py-3 pr-3">
                    <p class="font-medium text-neutral-900">{r.label}</p>
                    <p class="mt-0.5 font-mono text-xs text-neutral-500">{r.key}</p>
                    <p class="mt-1 max-w-xs text-xs leading-relaxed text-neutral-600">{r.blurb}</p>
                    {r.terminalLabel && <p class="mt-1 text-xs font-medium text-neutral-700">{r.terminalLabel}</p>}
                  </td>
                  <td class="py-3 pr-3 text-neutral-700">
                    <p>{r.typeLabel}</p>
                    <p class="mt-0.5 text-xs text-neutral-500">Expects: {r.expectsLabel}</p>
                  </td>
                  <td class="py-3 pr-3 text-neutral-700">{r.passLabel}</td>
                  <td class={'py-3 pr-3 ' + r.requiredClass}>{r.requiredLabel}</td>
                  <td class="py-3 pr-3 text-neutral-700">{r.slaLabel}</td>
                  <td class="py-3 pr-3">
                    <p class="text-neutral-900">{r.publicStep}</p>
                    <p class="mt-0.5 text-xs text-neutral-500">status: {r.appStatus}</p>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 rounded-lg border border-neutral-200 bg-neutral-50 p-4">
          <p class="text-sm font-medium text-neutral-900">How to read the last column</p>
          <p class="mt-1 text-sm leading-relaxed text-neutral-600">
            A candidate is never shown a stage name from this table. Each internal stage maps onto one
            of the six published steps, which is what their portal shows and what the recruitment
            policy commits to. Two internal stages can map onto the same published step; that is
            intended, and it is how the internal pipeline can be changed without breaking a promise
            made in public.
          </p>
        </div>
      </div>
    )}
  </div>
</AdminLayout>
