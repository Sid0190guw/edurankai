  .note--err { background: rgba(200,60,60,0.12); border: 1px solid rgba(200,60,60,0.4); }
  .problems {
    border: 1px solid rgba(200,60,60,0.4); background: rgba(200,60,60,0.08); border-radius: 6px;
    padding: 10px 12px 10px 28px; margin: 0 0 14px; font-size: 12px; color: #e0b0b0; max-width: 80ch;
  }
  .problems li { margin-bottom: 4px; line-height: 1.5; }
  .secret {
    border: 1px solid rgba(255,190,80,0.5); background: rgba(255,190,80,0.08);
    border-radius: 8px; padding: 14px 16px; margin-bottom: 18px;
  }
  .secret__eyebrow { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 6px; color: #d9b169; }
  .secret__code {
    font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 18px; letter-spacing: 0.04em;
    margin: 0 0 10px; user-select: all; word-break: break-all;
  }
  .secret__acts { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .secret__note { font-size: 12px; color: #b9bec7; margin: 0 0 8px; max-width: 80ch; line-height: 1.5; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 16px; }
  .tile { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 4px; }
  .tile__n { font-size: 22px; font-weight: 600; }
  .tile__l { font-size: 11px; color: #9aa0aa; text-transform: uppercase; letter-spacing: 0.06em; }
  .panel { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px 12px; margin-bottom: 16px; }
  .panel summary, .mini summary { cursor: pointer; font-size: 12px; }
  .mini { border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; padding: 6px 8px; }
  .stack { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; max-width: 460px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field__label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #9aa0aa; }
  .field__help { font-size: 11px; color: #8b919b; line-height: 1.5; }
  .check { display: flex; gap: 6px; align-items: center; font-size: 12px; }
  .filters { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 12px; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tab {
    font-size: 12px; padding: 5px 10px; border-radius: 999px; text-decoration: none; color: #9aa0aa;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .tab--on { color: inherit; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.06); }
  .tablewrap { overflow-x: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; margin-bottom: 20px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 1050px; }
  th { text-align: left; padding: 10px 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #9aa0aa; border-bottom: 1px solid rgba(255,255,255,0.1); }
  td { padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; }
