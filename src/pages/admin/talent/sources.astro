  .mono { display: block; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: #8b919b; margin-top: 2px; }
  .mono.warn { color: #d9a05b; }
  .pill { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.18); margin-top: 4px; }
  .pill--live { border-color: rgba(46,160,90,0.55); color: #7fd6a0; }
  .pill--used { border-color: rgba(120,150,220,0.5); color: #a8bdf0; }
  .pill--off { border-color: rgba(200,60,60,0.5); color: #e08b8b; }
  .acts { display: flex; flex-direction: column; gap: 8px; min-width: 220px; }
  form.inline { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
  /* The written reason sits beside its own destructive button, so it can never be filled in for one
     row and submitted against another. */
  form.inline input[type=text] { flex: 1 1 160px; min-width: 0; }
  .btn { border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.06); color: inherit; padding: 6px 10px; border-radius: 5px; font-size: 12px; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn--go { border-color: rgba(46,160,90,0.5); }
  .btn--warn { border-color: rgba(200,60,60,0.5); }
  input[type=text], select {
    background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.14); color: inherit;
    padding: 5px 7px; border-radius: 4px; font-size: 12px;
  }
  .quarantine { margin-top: 26px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 18px; }
  .warnline {
    font-size: 12px; color: #d9a05b; border: 1px solid rgba(255,190,80,0.35);
    background: rgba(255,190,80,0.06); border-radius: 8px; padding: 10px 12px; margin: 0 0 14px;
    max-width: 80ch; line-height: 1.5;
  }
  .muted { color: #6f757e; font-size: 12px; max-width: 60ch; line-height: 1.5; }
  .empty { color: #9aa0aa; font-size: 13px; max-width: 70ch; line-height: 1.6; }
  .mono-inline { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: #b9bec7; }
</style>
