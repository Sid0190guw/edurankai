  .acts { display: flex; flex-direction: column; gap: 8px; min-width: 260px; }
  .rowform, .editform, .grantform, .newform { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .newform { align-items: flex-end; gap: 10px; }
  .editform { max-width: 420px; }
  .field { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: #9aa0aa; }
  .field.wide { flex: 1 1 320px; }
  .field.wide input { width: 100%; }
  .btn { border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.06); color: inherit; padding: 6px 10px; border-radius: 5px; font-size: 12px; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn--go { border-color: rgba(46,160,90,0.5); }
  .btn--warn { border-color: rgba(200,60,60,0.5); }
  input[type=text], input[type=date], select {
    background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.14); color: inherit;
    padding: 5px 7px; border-radius: 4px; font-size: 12px;
  }
  .rowform input[type=text] { width: 160px; }
  .editform input[type=text] { width: 190px; }
  .muted { color: #6f757e; font-size: 12px; line-height: 1.5; }
  .empty { color: #9aa0aa; font-size: 13px; max-width: 80ch; line-height: 1.6; }
</style>
