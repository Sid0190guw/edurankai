  .legend__item { display: flex; flex-direction: column; gap: 4px; }
  .legend__note { font-size: 11px; color: #9aa0aa; line-height: 1.5; }
  .block { margin-bottom: 30px; }
  .block h2 { font-size: 15px; margin: 0 0 6px; }
  .blurb { color: #9aa0aa; font-size: 12px; line-height: 1.6; max-width: 90ch; margin: 0 0 12px; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .tab {
    font-size: 12px; padding: 5px 10px; border-radius: 999px; text-decoration: none; color: #9aa0aa;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .tab--on { color: inherit; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.06); }
  .search { display: flex; gap: 6px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
  .search input[type=text] { min-width: 340px; }
  .tablewrap { overflow-x: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; margin-bottom: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 980px; }
  th { text-align: left; padding: 10px 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #9aa0aa; border-bottom: 1px solid rgba(255,255,255,0.1); }
  td { padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; }
  td strong { display: block; }
  .mono { display: block; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: #8b919b; margin-top: 2px; line-height: 1.5; }
  .mono.warn { color: #d9a05b; }
  .why { display: block; font-size: 12px; }
  .pill { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.18); }
