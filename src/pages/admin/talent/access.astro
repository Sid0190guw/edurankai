  .pill--off { border-color: rgba(200,60,60,0.5); color: #e08b8b; }
  .pill--public { border-color: rgba(120,150,220,0.5); color: #a8bdf0; }
  .pill--internal { border-color: rgba(255,255,255,0.25); color: #c8ccd3; }
  .pill--restricted { border-color: rgba(255,190,80,0.55); color: #d9b169; }
