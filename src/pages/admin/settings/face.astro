---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { parseLiveDescriptor, normDesc, euclid, causeOf, DESCRIPTOR_DIMS, FACE_2FA_THRESHOLD } from '@/lib/auth/face';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

// WHAT CHANGED, AND WHY
//
// THIS WAS THE FOURTH UNGUARDED DOOR INTO user_face_enrollments, and the only self-service one that
// could DEACTIVATE the row. That row is simultaneously an accepted FIRST factor at sign-in, the
// 'face' SECOND factor read by src/lib/auth/two-factor.ts, and what /api/portal/attendance/punch
// trusts when it marks somebody present.
//
// The enrol action validated only Array.isArray(parsed) && parsed.length === 128 - so 128 strings,
// or the all-zero vector face-api returns for "no face found", went straight into the jsonb column -
// and then ran ON CONFLICT (user_id) DO UPDATE SET face_descriptor = whatever was posted, with
// nothing compared against anything. Any signed-in admin session, including a stolen one, could
// REPLACE the enrolled face by posting one form field.
//
// The remove action was worse, and it is what made the replacement gate on the two API doors
// (/api/auth/enroll-face, /api/auth/enroll-face-selfie) escapable: both gate re-enrolment on
// matchEnrolledFace(), which looks only at is_active = true. One POST here set is_active = false,
// and the very next enrolment - here or through either API - was then treated as a FIRST enrolment
// and let through free. Remove, then enrol your own face: a complete takeover of the biometric
// factor from a borrowed session, persisting through a password change.
//
// Both acts now have to prove control of the face already on file, which is the same rule
// /api/2fa/disable applies to the authenticator: turning a second factor off is not a thing a
// session alone may do.
//
// FIRST enrolment is untouched - no row, no obstacle - and that is the daily path (middleware forces
// it on a first protected page load). Re-capturing in better light or on a new phone still passes;
// a genuinely different face does not, and the refusal points at the government-ID flow so somebody
// whose appearance really has changed is never dead-ended.

// Declared before the handler that reads them - const is not hoisted.
const AUDIT_UA = (Astro.request.headers.get('user-agent') || '').slice(0, 500);
const ID_RECOVERY_HINT = 'If your appearance has changed, re-verify with a government ID at /identity-setup and enrol again from there.';

type StoredEnrolment = { present: boolean; active: boolean; stored: number[] | null; enrolledAt: any };

/**
 * The enrolment row REGARDLESS of is_active.
 *
 * matchEnrolledFace() filters on is_active = true on purpose - an inactive factor must not satisfy a
 * sign-in step. But for deciding whether a REPLACEMENT has to be proved, a deactivated row still
 * says "a face is on file for this account", and reading it that way is what closes the
 * remove-then-re-enrol hole described above.
 *
 * Throws on a database failure rather than reporting "no enrolment": an auth path must never turn
 * "the database is down" into "you may enrol whatever you like".
 */
async function readEnrolment(userId: string): Promise<StoredEnrolment> {
  const r = await db.execute(sql`
    SELECT face_descriptor, is_active, enrolled_at
    FROM user_face_enrollments WHERE user_id = ${userId} LIMIT 1
  `);
  // postgres-js returns a plain array. Never r.rows[0].
  const rows = Array.isArray(r) ? r : ((r as any)?.rows || []);
  if (rows.length === 0) return { present: false, active: false, stored: null, enrolledAt: null };
  const row = rows[0] as any;
  const parsed = normDesc(row.face_descriptor);
  const usable = parsed && parsed.length === DESCRIPTOR_DIMS && parsed.every((n) => Number.isFinite(n)) ? parsed : null;
  return { present: true, active: row.is_active === true, stored: usable, enrolledAt: row.enrolled_at ?? null };
}

/** Record the attempt. The measured distance stays in the audit row and out of every response -
 *  a numeric distance is a gradient an attacker can hill-climb toward the stored template. */
async function auditFace(verdict: 'verified' | 'rejected', method: string, distance: number | null, reason?: string) {
  await db.execute(sql`
    INSERT INTO identity_verifications (user_id, email, claimed_name, face_match_distance, face_match_passed, verdict, method, reject_reason, user_agent)
    VALUES (${user!.id}, ${(user as any)?.email || null}, ${(user as any)?.name || null}, ${distance}, ${verdict === 'verified'}, ${verdict}, ${method}, ${reason || null}, ${AUDIT_UA})
  `).catch((e: any) => console.error('[admin/settings/face] audit', causeOf(e)));
}

let okMsg = '', errorMsg = '';
let enrolled = false;
let enrolledAt: any = null;
// J: an unreadable enrolment table must not render as "not enrolled" next to a live enrol camera.
let statusReadFailed = false;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  try {
    const existing = await readEnrolment(user.id);

    if (action === 'enroll') {
      // parseLiveDescriptor enforces what "a descriptor" means: exactly 128 finite numbers, not all
      // zeros. The old test accepted 128 strings and wrote them into the column, where they would
      // never match anything again.
      const live = parseLiveDescriptor(fd.get('face_descriptor'));
      const deviceInfo = ((fd.get('device_info') as string) || AUDIT_UA || '').slice(0, 500) || null;
      if (!live) {
        errorMsg = 'No usable face in that capture (we need ' + DESCRIPTOR_DIMS + ' numbers and a face that is actually visible). Try again in better light.';
      } else if (existing.present && !existing.stored) {
        // A row exists but its template cannot be read. Silently overwriting it is exactly the act
        // this gate exists to refuse, so say so instead of guessing.
        errorMsg = 'A face is already enrolled on this account but the stored template could not be read, so it cannot be replaced from here. ' + ID_RECOVERY_HINT;
        await auditFace('rejected', 'self_enroll_replace', null, 'stored template unreadable');
      } else if (existing.present && existing.stored) {
        const distance = euclid(existing.stored, live);
        if (distance >= FACE_2FA_THRESHOLD) {
          errorMsg = 'That does not match the face already enrolled on this account, so it was not replaced. ' + ID_RECOVERY_HINT;
          await auditFace('rejected', 'self_enroll_replace', distance, 'live capture does not match the enrolled face');
        } else {
          const w = await db.execute(sql`
            UPDATE user_face_enrollments
               SET face_descriptor = ${JSON.stringify(live)}::jsonb,
                   device_info = ${deviceInfo},
                   enrolled_at = NOW(),
                   is_active = true
             WHERE user_id = ${user.id}
            RETURNING id
          `);
          const wrote = (Array.isArray(w) ? w : ((w as any)?.rows || [])).length;
          if (!wrote) {
            errorMsg = 'The enrolment was not saved. Nothing on your account was changed.';
          } else {
            okMsg = existing.active ? 'Face re-enrolled. The new capture replaced the previous one.' : 'Face 2FA is active again on this account.';
            await auditFace('verified', 'self_enroll_replace', distance);
          }
        }
      } else {
        const w = await db.execute(sql`
          INSERT INTO user_face_enrollments (user_id, face_descriptor, device_info, is_active)
          VALUES (${user.id}, ${JSON.stringify(live)}::jsonb, ${deviceInfo}, true)
          ON CONFLICT (user_id) DO UPDATE SET
            face_descriptor = EXCLUDED.face_descriptor,
            device_info = EXCLUDED.device_info,
            enrolled_at = NOW(),
            is_active = true
          RETURNING id
        `);
        const wrote = (Array.isArray(w) ? w : ((w as any)?.rows || [])).length;
        if (!wrote) {
          errorMsg = 'The enrolment was not saved. Nothing on your account was changed.';
        } else {
          okMsg = 'Face enrolled. Face 2FA is now active for your account.';
          await auditFace('verified', 'self_enroll', null);
        }
      }
    } else if (action === 'remove') {
      const live = parseLiveDescriptor(fd.get('face_descriptor'));
      if (!existing.present || !existing.active) {
        errorMsg = 'There is no active face enrolment on this account to remove.';
      } else if (!live) {
        errorMsg = 'To turn Face 2FA off, capture your face once so we can confirm it is you. Nothing was changed.';
      } else if (!existing.stored) {
        errorMsg = 'The stored template could not be read, so removal could not be confirmed and nothing was changed. ' + ID_RECOVERY_HINT;
        await auditFace('rejected', 'self_disable_face', null, 'stored template unreadable');
      } else {
        const distance = euclid(existing.stored, live);
        if (distance >= FACE_2FA_THRESHOLD) {
          errorMsg = 'That capture does not match the face enrolled on this account, so Face 2FA was NOT turned off.';
          await auditFace('rejected', 'self_disable_face', distance, 'live capture does not match the enrolled face');
        } else {
          const w = await db.execute(sql`
            UPDATE user_face_enrollments SET is_active = false WHERE user_id = ${user.id} AND is_active = true RETURNING id
          `);
          const wrote = (Array.isArray(w) ? w : ((w as any)?.rows || [])).length;
          if (!wrote) {
            errorMsg = 'Nothing was changed - there was no active enrolment left to turn off.';
          } else {
            // HONEST ABOUT WHAT HAPPENS NEXT. Every /admin and /portal path sits behind the
            // face-enrolment gate in src/middleware.ts, so the next protected page asks for a new
            // enrolment. The old copy promised "you will only need password to login", which was
            // never true on this product.
            okMsg = 'Face 2FA turned off. Every admin and portal page still requires a face enrolment, so the next page you open will ask you to enrol again.';
            await auditFace('verified', 'self_disable_face', distance);
          }
        }
      }
    }
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the failed SQL, and it was being
    // printed to the operator.
    console.error('[admin/settings/face]', causeOf(e));
    errorMsg = 'We could not complete that just now, so nothing on your account was changed. Please try again.';
  }
}

try {
  const cur = await readEnrolment(user.id);
  enrolled = cur.present && cur.active;
  enrolledAt = cur.enrolledAt;
} catch (e: any) {
  console.error('[admin/settings/face] status', causeOf(e));
  statusReadFailed = true;
}
---
<AdminLayout title="Face 2FA Enrollment" activeNav="settings">
<div style="padding-bottom:80px;">
  <div style="background:#08080a;border-bottom:1px solid #1a1a1f;padding:14px 16px;">
    <p style="font-size:10px;font-family:'Geist Mono',monospace;color:#FF7040;letter-spacing:0.12em;text-transform:uppercase;margin:0;">Security</p>
    <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0;">Face 2FA Enrollment</h1>
  </div>

  {errorMsg && <div style="margin:10px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;">{errorMsg}</div>}
  {okMsg && <div style="margin:10px 16px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;border-radius:8px;padding:10px 14px;font-size:13px;">{okMsg}</div>}

  <div style="padding:16px;display:flex;flex-direction:column;gap:14px;">

    {statusReadFailed && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:14px;">
        <p style="font-size:13px;font-weight:600;color:#fca5a5;margin:0 0 4px;">Your face enrolment could not be read</p>
        <p style="font-size:12px;color:#8a8a94;margin:0;line-height:1.5;">This is not the same as "not enrolled". The card below cannot be trusted until this page loads cleanly, so nothing can be enrolled or removed from here right now.</p>
      </div>
    )}

    <!-- Status card -->
    <div style={`background:#0f0f14;border:1px solid ${enrolled ? 'rgba(16,185,129,0.3)' : '#1a1a1f'};border-radius:12px;padding:16px;display:flex;align-items:center;gap:14px;`}>
      <div style={`width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:${enrolled ? 'rgba(16,185,129,0.15)' : '#15151a'};`}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={enrolled ? '#10b981' : '#6e6e78'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <div style="flex:1;">
        <p style={`font-size:14px;font-weight:600;margin:0;color:${enrolled ? '#10b981' : '#fff'};`}>{enrolled ? 'Face 2FA Active' : 'Face 2FA Not Enrolled'}</p>
        <p style="font-size:12px;color:#6e6e78;margin:3px 0 0;">
          {enrolled ? `Enrolled - login requires face verification` : 'Enroll your face to add an extra layer of security'}
        </p>
      </div>
    </div>

    <!-- How it works -->
    <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;padding:14px;">
      <p style="font-size:12px;font-weight:600;color:#fff;margin:0 0 10px;">How Face 2FA works</p>
      {[
        'Your face is converted to a mathematical descriptor (128 numbers) - no photo is stored',
        'On login: enter password first, then verify your face via camera',
        'The descriptor is stored on your account and the comparison is made on the server - the stored template is never sent back to any browser',
        'Works on any device with a camera - phone, laptop, tablet',
      ].map((item, i) => (
        <div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;">
          <div style="width:18px;height:18px;border-radius:50%;background:#FF4F0022;border:1px solid #FF4F0044;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#FF7040;flex-shrink:0;margin-top:1px;">{i+1}</div>
          <p style="font-size:12px;color:#8a8a94;margin:0;line-height:1.5;">{item}</p>
        </div>
      ))}
    </div>

    <!-- Camera enrollment -->
    {!enrolled && !statusReadFailed && (
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
        <div style="padding:14px 16px;border-bottom:1px solid #1a1a1f;">
          <p style="font-size:13px;font-weight:600;color:#fff;margin:0;">Enroll Your Face</p>
          <p style="font-size:11px;color:#6e6e78;margin:4px 0 0;">Position your face in the frame and click Capture</p>
        </div>
        <div style="padding:16px;">
          <!-- Camera view -->
          <div style="position:relative;background:#000;border-radius:10px;overflow:hidden;margin-bottom:12px;aspect-ratio:4/3;">
            <video id="videoEl" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;display:block;transform:scaleX(-1);"></video>
            <canvas id="canvasEl" style="display:none;"></canvas>
            <div id="faceOverlay" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
              <div style="width:160px;height:200px;border:2px solid rgba(255,79,0,0.6);border-radius:50%;"></div>
            </div>
            <div id="cameraStatus" style="position:absolute;bottom:12px;left:0;right:0;text-align:center;">
              <span style="background:rgba(0,0,0,0.7);color:#fff;font-size:11px;padding:4px 12px;border-radius:100px;">Starting camera...</span>
            </div>
          </div>
          <div id="loadingBar" style="background:#15151a;border-radius:100px;height:3px;margin-bottom:12px;display:none;">
            <div id="loadingProg" style="background:#FF4F00;height:100%;width:0%;border-radius:100px;transition:width 0.3s;"></div>
          </div>
          <button id="captureBtn" onclick="startCapture()" disabled style="width:100%;background:#FF4F00;border:none;color:#fff;font-weight:600;font-size:14px;padding:12px;border-radius:10px;cursor:pointer;opacity:0.5;">Loading face detection...</button>
        </div>
      </div>
    )}

    <!-- Remove enrollment. Turning a second factor off proves control of it first, exactly as
         /api/2fa/disable does for the authenticator: the button captures a face and the server
         compares it to the enrolled template before it deactivates anything. -->
    {enrolled && !statusReadFailed && (
      <div style="background:#0f0f14;border:1px solid rgba(239,68,68,0.2);border-radius:12px;padding:14px;">
        <p style="font-size:13px;font-weight:600;color:#fff;margin:0 0 4px;">Remove Face 2FA</p>
        <p style="font-size:11.5px;color:#8a8a94;margin:0 0 10px;line-height:1.5;">You are asked to capture your face once so we can confirm it is you before the factor is switched off. Every admin and portal page requires a face enrolment, so the next page you open will ask you to enrol again.</p>
        <form id="removeForm" method="POST">
          <input type="hidden" name="action" value="remove" />
          <input type="hidden" id="removeDescriptorInput" name="face_descriptor" />
          <button type="button" id="removeBtn" onclick="startRemoveCapture()" style="width:100%;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#fca5a5;font-weight:600;font-size:13px;padding:12px;border-radius:10px;cursor:pointer;">Capture and remove Face 2FA</button>
        </form>
      </div>
    )}

    <!-- Re-enroll if already enrolled -->
    {enrolled && !statusReadFailed && (
      <div style="background:#0f0f14;border:1px solid #1a1a1f;border-radius:12px;overflow:hidden;">
        <div style="padding:14px 16px;border-bottom:1px solid #1a1a1f;">
          <p style="font-size:13px;font-weight:600;color:#fff;margin:0;">Re-enroll Face</p>
          <p style="font-size:11px;color:#6e6e78;margin:4px 0 0;">Update your face data if recognition is failing</p>
        </div>
        <div style="padding:16px;">
          <div style="position:relative;background:#000;border-radius:10px;overflow:hidden;margin-bottom:12px;aspect-ratio:4/3;">
            <video id="videoEl" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;display:block;transform:scaleX(-1);"></video>
            <div id="faceOverlay" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
              <div style="width:160px;height:200px;border:2px solid rgba(16,185,129,0.6);border-radius:50%;"></div>
            </div>
            <div id="cameraStatus" style="position:absolute;bottom:12px;left:0;right:0;text-align:center;">
              <span style="background:rgba(0,0,0,0.7);color:#fff;font-size:11px;padding:4px 12px;border-radius:100px;">Starting camera...</span>
            </div>
          </div>
          <button id="captureBtn" onclick="startCapture()" disabled style="width:100%;background:#15151a;border:1px solid #1a1a1f;color:#d8d8de;font-weight:600;font-size:13px;padding:12px;border-radius:10px;cursor:pointer;opacity:0.5;">Loading face detection...</button>
        </div>
      </div>
    )}

  </div>
</div>

<!-- Hidden form for enrollment submission -->
<form id="enrollForm" method="POST" style="display:none;">
  <input type="hidden" name="action" value="enroll" />
  <input type="hidden" id="faceDescriptorInput" name="face_descriptor" />
  <input type="hidden" id="deviceInfoInput" name="device_info" />
</form>

<!-- TensorFlow.js + face-api.js -->
<script is:inline src="/vendor/face-api/face-api.min.js"></script>
<script is:inline>
var videoEl = document.getElementById('videoEl');
var canvasEl = document.getElementById('canvasEl');
var captureBtn = document.getElementById('captureBtn');
var statusEl = document.getElementById('cameraStatus');
var loadingBar = document.getElementById('loadingBar');
var loadingProg = document.getElementById('loadingProg');
var stream = null;
var modelsLoaded = false;

function setStatus(msg, color) {
  if (statusEl) statusEl.innerHTML = '<span style="background:rgba(0,0,0,0.7);color:' + (color||'#fff') + ';font-size:11px;padding:4px 12px;border-radius:100px;">' + msg + '</span>';
}

async function init() {
  try {
    setStatus('Loading face detection models...');
    if (loadingBar) loadingBar.style.display = 'block';
    
    var MODEL_URL = '/vendor/face-api/models';
    await Promise.all([
      faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
      faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
      faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
    ]);
    if (loadingProg) loadingProg.style.width = '60%';
    modelsLoaded = true;
    
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640, height: 480 } });
    if (videoEl) videoEl.srcObject = stream;
    if (loadingProg) loadingProg.style.width = '100%';
    
    setTimeout(function() {
      if (loadingBar) loadingBar.style.display = 'none';
      setStatus('Position your face in the oval', '#10b981');
      if (captureBtn) {
        captureBtn.disabled = false;
        captureBtn.style.opacity = '1';
        captureBtn.textContent = 'Capture & Enroll Face';
      }
    }, 500);
    
    // Live detection loop
    detectLoop();
  } catch(e) {
    setStatus('Camera error: ' + e.message, '#ef4444');
    console.error(e);
  }
}

async function detectLoop() {
  if (!videoEl || !modelsLoaded) return;
  try {
    var det = await faceapi.detectSingleFace(videoEl, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks(true);
    if (det) {
      setStatus('Face detected - ready to capture', '#10b981');
      if (captureBtn) captureBtn.style.background = '#10b981';
    } else {
      setStatus('No face detected - adjust position', '#fbbf24');
      if (captureBtn) captureBtn.style.background = '#FF4F00';
    }
  } catch(e) {}
  setTimeout(detectLoop, 500);
}

async function startCapture() {
  if (!modelsLoaded || !videoEl) return;
  if (captureBtn) { captureBtn.disabled = true; captureBtn.textContent = 'Capturing...'; }
  setStatus('Analyzing face...', '#fbbf24');
  
  try {
    // Capture 3 samples and average them for better accuracy
    var descriptors = [];
    for (var i = 0; i < 3; i++) {
      var det = await faceapi.detectSingleFace(videoEl, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks(true)
        .withFaceDescriptor();
      if (det) descriptors.push(Array.from(det.descriptor));
      await new Promise(function(r) { setTimeout(r, 300); });
    }
    
    if (descriptors.length === 0) {
      setStatus('No face detected. Please try again.', '#ef4444');
      if (captureBtn) { captureBtn.disabled = false; captureBtn.textContent = 'Capture & Enroll Face'; }
      return;
    }
    
    // Average the descriptors
    var avg = new Array(128).fill(0);
    descriptors.forEach(function(d) { d.forEach(function(v, i) { avg[i] += v / descriptors.length; }); });
    
    document.getElementById('faceDescriptorInput').value = JSON.stringify(avg);
    document.getElementById('deviceInfoInput').value = navigator.userAgent;
    
    setStatus('Face captured! Saving...', '#10b981');
    document.getElementById('enrollForm').submit();
  } catch(e) {
    setStatus('Error: ' + e.message, '#ef4444');
    if (captureBtn) { captureBtn.disabled = false; captureBtn.textContent = 'Capture & Enroll Face'; }
  }
}

// Removing the factor takes the same live capture as enrolling it, so the server has something
// to compare. Nothing is deactivated on the client - the form posts and the server decides.
async function startRemoveCapture() {
  var btn = document.getElementById('removeBtn');
  var input = document.getElementById('removeDescriptorInput');
  var form = document.getElementById('removeForm');
  if (!btn || !input || !form) return;
  if (!modelsLoaded || !videoEl) {
    btn.textContent = 'Camera is still starting - try again in a moment';
    return;
  }
  if (!confirm('Turn Face 2FA off? You will be asked to enrol again on the next page you open.')) return;
  btn.disabled = true;
  btn.textContent = 'Capturing...';
  try {
    var d = null;
    for (var i = 0; i < 3 && !d; i++) {
      var det = await faceapi.detectSingleFace(videoEl, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks(true)
        .withFaceDescriptor();
      if (det) d = Array.from(det.descriptor);
      await new Promise(function(r) { setTimeout(r, 300); });
    }
    if (!d) {
      btn.disabled = false;
      btn.textContent = 'No face detected - try again';
      return;
    }
    input.value = JSON.stringify(d);
    form.submit();
  } catch (e) {
    btn.disabled = false;
    btn.textContent = 'Could not capture: ' + (e && e.message ? e.message : 'unknown error');
  }
}

// Start on load
if (videoEl) init();
</script>
</AdminLayout>
