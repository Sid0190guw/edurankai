---
// src/pages/admin/team/roles.astro — the role console. Everything an organisation needs to decide
// who can do what, without a developer.
//
// WHY IT LOOKS LIKE THIS. The previous version of this page could create a role and tick a
// four-column page matrix. What it could not do was answer the questions that actually get asked
// after an access incident: which permissions exist, which of them open the admin console, who is
// holding one right now, and what will this person SEE when they sign in. Those answers lived in
// four source files, so in practice roles were handed out by whoever could read TypeScript.
//
// Every list here is DERIVED, never typed out:
//   - the permission picker comes from permission_catalogue (listPermissionGroups), so a permission
//     invented next week appears here with no edit to this file;
//   - the sidebar preview calls navForPermissions() from src/lib/admin-nav.ts — the same function
//     that builds the real sidebar, on the same catalogue, with the permissions this role actually
//     holds. It is not a description of the menu; it is the menu;
//   - the holders are the real assignments.
// A hand-copied summary of a permission model is one edit away from lying, and a lying access page
// is worse than none: it gets read once, believed, and never questioned again.
//
// ONE SAVE WRITES BOTH RECORDS, and that is the point of applyRolePermissions(). Ticking
// `applications.view` writes a row in role_permission_grants (which hasPermission() and the sidebar
// read) AND the matching page-key row in role_permissions (which getViewableSectionKeys() and
// middleware read). Writing only the first would produce a link that redirects on click — the exact
// gap registry.ts and admin-nav.ts both document. The "What they will see" panel compares the two
// answers and says so if they ever diverge, rather than assuming they cannot.
//
// NO JAVASCRIPT. Every form posts to this page and every control is a link or a submit button, so
// the console works with scripting off and adds nothing to the page weight. The delete confirmation
// is a panel rather than a confirm() dialog for the same reason.
//
// THE GATE is can(user, 'users.edit') plus can(user, 'admin.access') — both already in the
// Permission union. Inventing a new string here would make can() answer false for EVERY role,
// including super_admin, and the whole console would redirect everyone away; that has happened on
// this project before. users.edit is what makes this a super-admin screen: no other built-in role
// holds it, which is correct for the page that hands out admin console access.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  ensureRegistrySchema,
  listRoles,
  listPermissionGroups,
  permissionsForRole,
  sectionMatrixForRole,
  sectionMatrixKeys,
  listRoleMembers,
  listAssignableUsers,
  createRole,
  updateRole,
  deleteRole,
  applyRolePermissions,
  assignRoleToUser,
  unassignRoleFromUser,
  registerPermission,
  isSensitiveKey,
  slugifyRoleKey,
  PERM_ADMIN_ACCESS,
  type Actor,
  type RoleRecord,
  type RoleGrantRecord,
  type RoleMember,
  type SectionGrant,
} from '@/lib/auth/registry';
import {
  ADMIN_NAV,
  navForPermissions,
  flattenNav,
  isNavGroup,
  NAV_SECTION_PROBLEMS,
  type AdminNavEntry,
} from '@/lib/admin-nav';
import { adminSectionLabel } from '@/lib/admin-sections';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (!can(user, 'users.edit') || !can(user, 'admin.access')) return Astro.redirect('/admin');

// ---------------------------------------------------------------------------------------- helpers
// Declared BEFORE the POST handler that uses them. `const` is not hoisted, and a handler reaching a
// later declaration has thrown on its first line while the page reported success on this project.
const actor: Actor = {
  id: String(user.id),
  email: (user as any).email ?? null,
  name: (user as any).name ?? null,
  ip: (Astro.request.headers.get('x-forwarded-for') || '').split(',')[0].trim() || null,
};

const COLORS = ['orange', 'blue', 'green', 'purple', 'red', 'gold', 'pink'];

function colorStyle(c: string): string {
  if (c === 'blue') return 'background:rgba(59,130,246,0.15);color:#60a5fa;';
  if (c === 'green') return 'background:rgba(16,185,129,0.15);color:#10b981;';
  if (c === 'purple') return 'background:rgba(139,92,246,0.15);color:#a78bfa;';
  if (c === 'red') return 'background:rgba(220,38,38,0.15);color:#fca5a5;';
  if (c === 'gold') return 'background:rgba(251,191,36,0.15);color:#fbbf24;';
  if (c === 'pink') return 'background:rgba(236,72,153,0.15);color:#f9a8d4;';
  return 'background:rgba(255,79,0,0.15);color:#FF7040;';
}

function when(value: any): string {
  if (!value) return 'date not recorded';
  try { return new Date(value).toLocaleDateString('en-IN', { dateStyle: 'medium' }); } catch { return String(value); }
}

function personLabel(p: { name: string | null; email: string | null }): string {
  return String(p.name || '').trim() || String(p.email || '').trim() || 'unnamed account';
}

// ------------------------------------------------------------------------------------ page state
let errorMsg = '';
let okMsg = '';
const problems: string[] = [];
let adminAccessNotice = '';
// Set by the POST handler so the panel the admin was working in stays open afterwards.
let focusRoleId = '';
let focusTab = '';
let openCreate = false;
// What the admin typed into the create form, kept so a rejected name does not cost them the rest.
let draftName = '';
let draftKey = '';
let draftDescription = '';
let draftColor = 'orange';

// ---------------------------------------------------------------------------------- POST handler
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') || '');
  const roleId = String(fd.get('role_id') || '').trim();
  focusRoleId = roleId;

  try {
    if (action === 'create_role') {
      focusTab = 'permissions';
      draftName = String(fd.get('name') || '');
      draftKey = String(fd.get('key') || '');
      draftDescription = String(fd.get('description') || '');
      draftColor = String(fd.get('color') || 'orange');
      const result = await createRole({
        name: draftName, key: draftKey, description: draftDescription, color: draftColor,
      }, actor);
      if (result.ok && result.data) {
        focusRoleId = result.data.id;
        okMsg = 'Role created with the key "' + result.data.key + '". It holds no permissions yet: tick what it may do below, then add people to it.';
      } else if (!result.ok) {
        errorMsg = result.error;
        openCreate = true;
      }
    } else if (action === 'update_role') {
      focusTab = 'settings';
      const result = await updateRole(roleId, {
        name: String(fd.get('name') || ''),
        key: String(fd.get('key') || ''),
        description: String(fd.get('description') || ''),
        color: String(fd.get('color') || 'orange'),
      }, actor);
      if (result.ok) okMsg = 'Role details saved.';
      else errorMsg = result.error;
    } else if (action === 'delete_role') {
      focusTab = 'delete';
      const result = await deleteRole(roleId, actor);
      if (result.ok) {
        okMsg = 'Role deleted. What it granted is recorded in the audit log.';
        focusRoleId = '';
        focusTab = '';
      } else {
        errorMsg = result.error;
      }
    } else if (action === 'save_permissions') {
      focusTab = 'permissions';
      const wanted = fd.getAll('perm').map((v) => String(v));
      const held = await permissionsForRole(roleId);
      if (wanted.length === 0 && held.length > 0 && String(fd.get('confirm_empty') || '') !== 'yes') {
        // A save with nothing ticked strips the role bare. That is a legitimate thing to want and a
        // terrible thing to do by accident — a mis-scrolled page or a half-loaded form looks exactly
        // the same to the server as a deliberate one.
        errorMsg = 'Nothing was ticked, and this role currently holds ' + held.length + ' permission'
          + (held.length === 1 ? '' : 's') + '. Nothing was changed. To genuinely strip it bare, tick'
          + ' "Remove every permission from this role" and save again.';
      } else {
        const result = await applyRolePermissions(roleId, wanted, actor);
        if (!result.ok) {
          errorMsg = result.error;
        } else if (result.data) {
          const { granted, revoked } = result.data;
          for (const p of result.data.problems) problems.push(p);
          if (granted.length === 0 && revoked.length === 0) {
            okMsg = 'No change — this role already held exactly that.';
          } else {
            const parts: string[] = [];
            if (granted.length > 0) parts.push('granted ' + granted.length);
            if (revoked.length > 0) parts.push('revoked ' + revoked.length);
            okMsg = 'Permissions saved: ' + parts.join(', ') + '. Every one is in the audit log under your name.';
          }
          if (granted.includes(PERM_ADMIN_ACCESS)) {
            adminAccessNotice = 'Recorded in the audit log: ' + (actor.email || actor.name || actor.id)
              + ' granted admin console access to this role.';
          }
        }
      }
    } else if (action === 'assign_user') {
      focusTab = 'people';
      const result = await assignRoleToUser(String(fd.get('user_id') || '').trim(), roleId, actor);
      if (result.ok) okMsg = 'Added to the role. The assignment is in the audit log under your name.';
      else errorMsg = result.error;
    } else if (action === 'unassign_user') {
      // Removing a holder from the delete confirmation should leave you on the delete confirmation,
      // watching the blocking list shrink, not bounce you to another tab mid-decision.
      focusTab = String(fd.get('return_tab') || 'people');
      const result = await unassignRoleFromUser(String(fd.get('user_id') || '').trim(), roleId, actor);
      if (result.ok) okMsg = 'Removed from the role.';
      else errorMsg = result.error;
    } else if (action === 'register_permission') {
      focusTab = 'permissions';
      const key = String(fd.get('new_key') || '');
      const result = await registerPermission({
        key,
        label: String(fd.get('new_label') || ''),
        group: String(fd.get('new_group') || 'Other'),
        description: String(fd.get('new_description') || ''),
        isSensitive: String(fd.get('new_sensitive') || '') === 'on',
      }, actor);
      if (result.ok) {
        okMsg = 'Added "' + key.trim().toLowerCase() + '" to the catalogue. It is now grantable — but'
          + ' nothing checks it until a page or an API route asks hasPermission() for it.';
      } else {
        errorMsg = result.error;
      }
    } else {
      errorMsg = 'Unknown action. Nothing was changed.';
    }
  } catch (err: any) {
    // The real Postgres reason is on e.cause; e.message is only the SQL that failed.
    errorMsg = 'Nothing was saved: ' + (err?.cause?.message || err?.message || 'unknown error');
  }
}

// ----------------------------------------------------------------------------------------- reads
const url = new URL(Astro.request.url);
const paramRole = url.searchParams.get('role') || '';
const paramTab = url.searchParams.get('tab') || '';
const searchQuery = (url.searchParams.get('q') || '').trim();
const wantCreate = openCreate || url.searchParams.get('new') === '1';

await ensureRegistrySchema();
const roles: RoleRecord[] = await listRoles();

const selectedId = focusRoleId || paramRole;
const role: RoleRecord | null = roles.find((r) => r.id === selectedId) || null;
const TABS = ['permissions', 'people', 'sidebar', 'settings', 'delete'];
const rawTab = focusTab || paramTab || 'permissions';
const tab = role ? (TABS.includes(rawTab) ? rawTab : 'permissions') : '';

let grants: RoleGrantRecord[] = [];
let matrix: SectionGrant[] = [];
let members: RoleMember[] = [];
let candidates: { id: string; name: string | null; email: string | null; builtinRole: string; isActive: boolean }[] = [];
let permissionGroups: { label: string; permissions: any[] }[] = [];

if (role) {
  grants = await permissionsForRole(role.id);
  matrix = await sectionMatrixForRole(role.id);
  if (tab === 'people' || tab === 'delete') {
    members = await listRoleMembers(role.id);
    if (tab === 'people') candidates = await listAssignableUsers(searchQuery, 40);
  }
  if (tab === 'permissions') permissionGroups = await listPermissionGroups();
}

// --------------------------------------------------------------------------------------- derived
const heldKeys = new Set(grants.map((g) => g.key));
const explicitKeys = new Set(grants.filter((g) => g.source === 'grant').map((g) => g.key));
const grantsAdminAccess = heldKeys.has(PERM_ADMIN_ACCESS);
// A page_key stored on this role that the section registry does not contain. Nothing can grant it,
// nothing checks it, and the next save drops it. Said out loud rather than silently cleaned up.
const strayPageKeys = matrix.filter((m) => !m.known).map((m) => m.pageKey);

// The sidebar this role produces, from the SAME function the sidebar itself is built with
// (navForPermissions in src/lib/admin-nav.ts) and the same permission keys a holder resolves to —
// explicit grants unioned with the section matrix, which is exactly what permissionsForRole returns.
// Nothing here is a second copy of the menu, so this panel cannot disagree with what people get.
const navTree: AdminNavEntry[] = role ? navForPermissions(ADMIN_NAV, heldKeys) : [];
const navCount = flattenNav(navTree).length;
const navTotal = flattenNav(ADMIN_NAV).length;

// The same question asked of the record the DOOR reads. Middleware resolves a path to a section key
// and checks getViewableSectionKeys(), which consults role_permissions and nothing else — so an
// entry that appears in navTree but not here is a link this console promised and the middleware
// would refuse. Saving permissions through this console keeps the two in step; this comparison is
// what proves it rather than assuming it. 'dashboard' is added because the door adds it for anyone
// holding a custom role.
const navEnforced = role ? navForPermissions(ADMIN_NAV, ['dashboard.view', ...sectionMatrixKeys(matrix)]) : [];
const enforcedIds = new Set(flattenNav(navEnforced).map((i) => i.id));
// Deduplicated by id: one nav id legitimately appears twice in the catalogue, and naming the same
// entry twice in a warning makes the warning look wrong.
const seenPromised = new Set<string>();
const promisedNotEnforced = flattenNav(navTree).filter((i) => {
  if (enforcedIds.has(i.id) || seenPromised.has(i.id)) return false;
  seenPromised.add(i.id);
  return true;
});

// The sections that actually produce links, read off role_permissions for the same reason.
const viewableSections = matrix.filter((m) => m.view && m.known).map((m) => m.pageKey);

const memberCount = role ? role.memberCount : 0;
const totalRoles = roles.length;
const totalHolders = roles.reduce((n, r) => n + r.memberCount, 0);
const adminGrantingRoles = roles.filter((r) => r.grantsAdminAccess);

function tabHref(roleId: string, name: string): string {
  return '/admin/team/roles?role=' + encodeURIComponent(roleId) + '&tab=' + name;
}
---

<AdminLayout title="Role console" activeNav="team-roles">
  <div class="rc">

    <header class="rc-head">
      <p class="rc-eyebrow">Access &middot; roles and permissions</p>
      <h1>Role console</h1>
      <p class="rc-lede">
        Create a role, decide exactly what it may do, put people in it, and see the console those
        people will actually be handed. Every permission below is read from the live catalogue, so
        the list is complete by construction rather than by somebody remembering to update it. Every
        change here is written to the <a href="/admin/audit">audit log</a> under your name.
      </p>
    </header>

    <div class="rc-tiles">
      <div class="rc-tile"><p class="rc-k">Roles</p><p class="rc-v">{totalRoles}</p><p class="rc-s">{adminGrantingRoles.length} grant console access</p></div>
      <div class="rc-tile"><p class="rc-k">Assignments</p><p class="rc-v">{totalHolders}</p><p class="rc-s">people holding a custom role</p></div>
      <div class="rc-tile"><p class="rc-k">Sidebar entries</p><p class="rc-v">{navTotal}</p><p class="rc-s">available to grant</p></div>
    </div>

    {errorMsg && <div class="rc-note rc-bad"><strong>Not done.</strong> {errorMsg}</div>}
    {okMsg && <div class="rc-note rc-good">{okMsg}</div>}
    {adminAccessNotice && <div class="rc-note rc-warn"><strong>Console access granted.</strong> {adminAccessNotice}</div>}
    {problems.length > 0 && (
      <div class="rc-note rc-bad">
        <strong>Read these before assuming the save was complete:</strong>
        <ul class="rc-problems">{problems.map((p) => <li>{p}</li>)}</ul>
      </div>
    )}

    <div class="rc-note">
      <strong>What a grant of <code>admin.access</code> does today.</strong> It is recorded, resolvable
      and honoured by <code>hasPermission()</code>, and it is the permission an intern once held
      through the built-in <code>editor</code> role. It does <em>not</em>, by itself, open
      <code>/admin</code>: the door is <code>canOpenAdmin()</code>, which reads the built-in role on
      the account, so the person also needs an admin-capable role in
      <a href="/admin/users">Users</a>. That is a deliberate limit, not an oversight &mdash; this
      console cannot widen the blast radius of the incident it was built after. See
      <a href="/admin/access-preview">Access preview</a> for which built-in roles qualify.
    </div>

    {NAV_SECTION_PROBLEMS.length > 0 && (
      <div class="rc-note rc-bad">
        <strong>Sidebar entries gated on a section that does not exist:</strong>
        {NAV_SECTION_PROBLEMS.map((p) => p.id + ' to ' + p.section).join(', ')}. No role can be granted
        those keys, so those entries stay hidden from every restricted admin however this console is
        used. The fix is in <code>src/lib/admin-sections.ts</code> or <code>src/lib/admin-nav.ts</code>.
      </div>
    )}

    <div class="rc-body">

      {/* ------------------------------------------------------------------ left: the roles */}
      <aside class="rc-list">
        <div class="rc-list-head">
          <h2>Roles</h2>
          <a class="rc-btn rc-primary" href="/admin/team/roles?new=1">New role</a>
        </div>

        {roles.length === 0 && (
          <p class="rc-empty">No custom roles yet. A custom role replaces the built-in section
          defaults for whoever holds it, so start with what the job actually needs.</p>
        )}

        <ul class="rc-roles">
          {roles.map((r) => (
            <li class={role && r.id === role.id ? 'rc-role rc-current' : 'rc-role'}>
              <a class="rc-role-link" href={tabHref(r.id, 'permissions')}>
                <span class="rc-pill" style={colorStyle(r.color)}>{r.name}</span>
                <span class="rc-role-meta">
                  {r.memberCount} {r.memberCount === 1 ? 'person' : 'people'} &middot; {r.permissionCount} granted
                </span>
                {r.key && <span class="rc-key">{r.key}</span>}
              </a>
              {r.grantsAdminAccess && (
                <span class="rc-flag" title="This role grants admin.access">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.2 18 17H2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M10 8v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="10" cy="14.6" r="0.9" fill="currentColor" /></svg>
                  console access
                </span>
              )}
            </li>
          ))}
        </ul>
      </aside>

      {/* ----------------------------------------------------------------- right: the panels */}
      <section class="rc-panel">

        {wantCreate && (
          <form method="POST" class="rc-card">
            <input type="hidden" name="_action" value="create_role" />
            <h2>New role</h2>
            <p class="rc-sub">
              A new role can do nothing until you grant it something. That is the correct starting
              point: a role that inherits "roughly what the last one had" is how somebody ends up
              holding a permission nobody chose to give them.
            </p>

            <label class="rc-field">
              <span class="rc-label">Name</span>
              <input class="rc-input" name="name" required minlength="2" maxlength="80" placeholder="HEI Editor" value={draftName} />
              <span class="rc-hint">What people will call it. You can change this later.</span>
            </label>

            <label class="rc-field">
              <span class="rc-label">Key</span>
              <input class="rc-input" name="key" maxlength="80" placeholder="hei-editor" value={draftKey} />
              <span class="rc-hint">
                The permanent identifier, for anything that needs to name this role without depending
                on its label. Lowercase letters, digits, dashes and underscores. Leave it blank to
                derive one from the name. It cannot be changed afterwards, because a key that can be
                edited is just a second name.
              </span>
            </label>

            <label class="rc-field">
              <span class="rc-label">Description</span>
              <textarea class="rc-input" name="description" rows="2" maxlength="500" placeholder="Who this is for and what it is meant to cover.">{draftDescription}</textarea>
            </label>

            <label class="rc-field">
              <span class="rc-label">Colour</span>
              <select class="rc-input" name="color">
                {COLORS.map((c) => <option value={c} selected={c === draftColor}>{c}</option>)}
              </select>
            </label>

            <div class="rc-actions">
              <button class="rc-btn rc-primary" type="submit">Create role</button>
              <a class="rc-btn" href="/admin/team/roles">Cancel</a>
            </div>
          </form>
        )}

        {!role && !wantCreate && (
          <div class="rc-card rc-placeholder">
            <h2>Pick a role</h2>
            <p class="rc-sub">
              Choose a role on the left to edit what it may do, see who holds it, and preview the
              admin console its holders are handed. To see what the <em>built-in</em> roles grant
              instead, read <a href="/admin/access-preview">Access preview</a> &mdash; those are set
              in source and are not editable here.
            </p>
          </div>
        )}

        {role && (
          <div class="rc-card">
            <div class="rc-role-head">
              <div>
                <h2><span class="rc-pill rc-pill-lg" style={colorStyle(role.color)}>{role.name}</span></h2>
                <p class="rc-role-facts">
                  {role.key ? role.key : 'no key set'} &middot; {memberCount} {memberCount === 1 ? 'person holds it' : 'people hold it'} &middot; created {when(role.createdAt)}
                </p>
                {role.description && <p class="rc-sub">{role.description}</p>}
              </div>
              {grantsAdminAccess && (
                <span class="rc-badge rc-badge-alarm">grants admin.access</span>
              )}
            </div>

            <nav class="rc-tabs">
              <a class={tab === 'permissions' ? 'rc-tab rc-tab-on' : 'rc-tab'} href={tabHref(role.id, 'permissions')}>What it may do</a>
              <a class={tab === 'people' ? 'rc-tab rc-tab-on' : 'rc-tab'} href={tabHref(role.id, 'people')}>Who holds it ({memberCount})</a>
              <a class={tab === 'sidebar' ? 'rc-tab rc-tab-on' : 'rc-tab'} href={tabHref(role.id, 'sidebar')}>What they will see</a>
              <a class={tab === 'settings' ? 'rc-tab rc-tab-on' : 'rc-tab'} href={tabHref(role.id, 'settings')}>Details</a>
              <a class={tab === 'delete' ? 'rc-tab rc-tab-on rc-tab-danger' : 'rc-tab'} href={tabHref(role.id, 'delete')}>Delete</a>
            </nav>

            {strayPageKeys.length > 0 && (
              <div class="rc-note rc-bad">
                <strong>Stored page keys that no longer exist:</strong> {strayPageKeys.join(', ')}.
                Nothing checks them and no checkbox below can control them. The next save of this
                role's permissions removes them.
              </div>
            )}

            {/* ------------------------------------------------------------- permissions */}
            {tab === 'permissions' && (
              <form method="POST" class="rc-perms">
                <input type="hidden" name="_action" value="save_permissions" />
                <input type="hidden" name="role_id" value={role.id} />

                <p class="rc-sub">
                  Every permission that exists, straight from the catalogue &mdash; {grants.length} of
                  them are held by this role today. Ticking a section permission such as
                  <code>applications.view</code> also puts that section in the holder's sidebar and
                  lets the URL open, because this console writes both records from one list.
                </p>

                <div class="rc-note rc-warn">
                  <strong>One permission is not like the others.</strong> <code>admin.access</code> is
                  the entrance to this console. Turning it on writes an audit entry naming you, and
                  the grant is refused outright if that entry cannot be written &mdash; a sensitive
                  permission is not granted off the record. Read the note at the top of this page for
                  what it does and does not open today.
                </div>

                {permissionGroups.map((group) => {
                  const heldHere = group.permissions.filter((p: any) => heldKeys.has(p.key)).length;
                  return (
                    <details class="rc-group" open={heldHere > 0}>
                      <summary>
                        <span class="rc-group-name">{group.label}</span>
                        <span class="rc-group-count">{heldHere} of {group.permissions.length}</span>
                      </summary>
                      <ul class="rc-perm-list">
                        {group.permissions.map((p: any) => {
                          const held = heldKeys.has(p.key);
                          const viaMatrixOnly = held && !explicitKeys.has(p.key);
                          const sensitive = isSensitiveKey(p.key, p.isSensitive);
                          const isDoor = p.key === PERM_ADMIN_ACCESS;
                          return (
                            <li class={isDoor ? 'rc-perm rc-perm-door' : 'rc-perm'}>
                              <label class="rc-perm-label">
                                <input type="checkbox" name="perm" value={p.key} checked={held} />
                                <span class="rc-perm-body">
                                  <span class="rc-perm-title">
                                    {p.label}
                                    <code class="rc-perm-key">{p.key}</code>
                                    {sensitive && <span class="rc-badge rc-badge-warn">sensitive</span>}
                                    {viaMatrixOnly && <span class="rc-badge">held via the older page matrix</span>}
                                  </span>
                                  {p.description && <span class="rc-perm-desc">{p.description}</span>}
                                </span>
                              </label>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  );
                })}

                {permissionGroups.length === 0 && (
                  <div class="rc-note rc-bad">
                    <strong>The permission catalogue could not be read.</strong> That is a database
                    problem, not an empty catalogue &mdash; do not save this form while it says this,
                    or you will be telling the system this role holds nothing.
                  </div>
                )}

                <div class="rc-save">
                  <button class="rc-btn rc-primary" type="submit">Save permissions</button>
                  <label class="rc-confirm">
                    <input type="checkbox" name="confirm_empty" value="yes" />
                    <span>Remove every permission from this role</span>
                  </label>
                </div>
                <p class="rc-hint">
                  Saving replaces this role's permissions with exactly what is ticked. Unticking
                  something removes it. Each grant and each revoke is logged separately under your
                  name, so the record shows what changed rather than only that something did.
                </p>
              </form>
            )}

            {/* ------------------------- the catalogue itself: a separate form, never nested */}
            {tab === 'permissions' && (
              <details class="rc-group">
                <summary>
                  <span class="rc-group-name">Add a permission to the catalogue</span>
                  <span class="rc-group-count">rarely needed</span>
                </summary>
                <div class="rc-newperm">
                  <p class="rc-sub">
                    A key here is a promise that something checks it. Registering
                    <code>reports.export</code> does not create a check: a page or an API route
                    still has to ask <code>hasPermission()</code> for it. Write in the description
                    what it is meant to control, so whoever grants it later knows what they are
                    handing over. Section permissions appear on their own and never need adding here.
                  </p>
                  <form method="POST">
                    <input type="hidden" name="_action" value="register_permission" />
                    <input type="hidden" name="role_id" value={role.id} />
                    <div class="rc-grid2">
                      <label class="rc-field">
                        <span class="rc-label">Key</span>
                        <input class="rc-input" name="new_key" placeholder="reports.export" />
                      </label>
                      <label class="rc-field">
                        <span class="rc-label">Label</span>
                        <input class="rc-input" name="new_label" placeholder="Export reports" />
                      </label>
                      <label class="rc-field">
                        <span class="rc-label">Group</span>
                        <input class="rc-input" name="new_group" placeholder="System" />
                      </label>
                      <label class="rc-field rc-field-check">
                        <input type="checkbox" name="new_sensitive" />
                        <span class="rc-hint">Sensitive: granting it must be provably on the record</span>
                      </label>
                    </div>
                    <label class="rc-field">
                      <span class="rc-label">What it controls</span>
                      <textarea class="rc-input" name="new_description" rows="2" placeholder="Which screen or action asks for this, in plain words."></textarea>
                    </label>
                    <button class="rc-btn" type="submit">Add to catalogue</button>
                  </form>
                </div>
              </details>
            )}

            {/* ------------------------------------------------------------------ people */}
            {tab === 'people' && (
              <div class="rc-people">
                <p class="rc-sub">
                  Anyone here holds everything this role grants. A custom role <em>replaces</em> the
                  built-in section defaults for whoever holds it, so someone who could previously
                  reach a section by virtue of their built-in role may lose it by gaining this one
                  &mdash; check the sidebar preview before you add people.
                </p>

                {members.length === 0 && <p class="rc-empty">Nobody holds this role.</p>}

                {members.length > 0 && (
                  <ul class="rc-members">
                    {members.map((m) => (
                      <li class={m.isActive ? 'rc-member' : 'rc-member rc-dim'}>
                        <div class="rc-member-who">
                          <span class="rc-member-name">{personLabel(m)}</span>
                          <span class="rc-member-mail">{m.email}</span>
                          <span class="rc-member-meta">
                            {m.builtinRole} &middot; {m.isActive ? 'active' : 'deactivated'} &middot; added {when(m.assignedAt)}
                          </span>
                        </div>
                        <form method="POST">
                          <input type="hidden" name="_action" value="unassign_user" />
                          <input type="hidden" name="role_id" value={role.id} />
                          <input type="hidden" name="user_id" value={m.userId} />
                          <button class="rc-btn rc-danger" type="submit">Remove</button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}

                <h3 class="rc-subh">Add someone</h3>
                <form method="GET" class="rc-search">
                  <input type="hidden" name="role" value={role.id} />
                  <input type="hidden" name="tab" value="people" />
                  <input class="rc-input" type="search" name="q" value={searchQuery} placeholder="Search by name or email" />
                  <button class="rc-btn" type="submit">Search</button>
                </form>

                {candidates.length === 0 && (
                  <p class="rc-empty">
                    {searchQuery
                      ? 'No active staff account matches that. Applicant accounts cannot hold a staff role.'
                      : 'Search for the person by name or email.'}
                  </p>
                )}

                {candidates.length > 0 && (
                  <ul class="rc-candidates">
                    {candidates.filter((c) => !members.some((m) => m.userId === c.id)).map((c) => (
                      <li class="rc-candidate">
                        <div class="rc-member-who">
                          <span class="rc-member-name">{personLabel(c)}</span>
                          <span class="rc-member-mail">{c.email}</span>
                          <span class="rc-member-meta">{c.builtinRole}</span>
                        </div>
                        <form method="POST">
                          <input type="hidden" name="_action" value="assign_user" />
                          <input type="hidden" name="role_id" value={role.id} />
                          <input type="hidden" name="user_id" value={c.id} />
                          <button class="rc-btn rc-primary" type="submit">Add to role</button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}
                {candidates.length >= 40 && (
                  <p class="rc-hint">Showing the first 40 matches. Narrow the search to find someone further down.</p>
                )}
              </div>
            )}

            {/* ----------------------------------------------------------------- sidebar */}
            {tab === 'sidebar' && (
              <div class="rc-nav">
                <p class="rc-sub">
                  The admin console a holder of this role is handed. This is not a description of the
                  menu: it is the menu, built by the same function the sidebar itself calls, from the
                  permissions this role actually holds. If the list is smaller than you expected,
                  the permissions tab is what to change.
                </p>

                <div class="rc-note">
                  <strong>Two things this preview cannot know.</strong> Someone assigned several
                  custom roles gets the union of them, not only this one. And a visible link is not
                  permission to open the page: middleware re-checks the section on every request, and
                  a super admin is never filtered at all, so a super admin holding this role still
                  sees everything.
                </div>

                {promisedNotEnforced.length > 0 && (
                  <div class="rc-note rc-bad">
                    <strong>Promised here, refused at the door:</strong>
                    {promisedNotEnforced.map((i) => i.label).join(', ')}. These are held as registry
                    grants but are not in this role's page-permission rows, which is the record the
                    middleware reads &mdash; so the link would appear and then redirect. Open the
                    permissions tab and save once: this console writes both records together and the
                    disagreement goes away.
                  </div>
                )}

                <p class="rc-count">
                  {navCount} {navCount === 1 ? 'entry' : 'entries'} out of {navTotal},
                  from {viewableSections.length} viewable {viewableSections.length === 1 ? 'section' : 'sections'}.
                </p>

                {viewableSections.length > 0 && (
                  <ul class="rc-chips">
                    {viewableSections.map((k) => <li class="rc-chip">{adminSectionLabel(k)}</li>)}
                  </ul>
                )}

                <div class="rc-navtree">
                  {navTree.map((entry) => (
                    isNavGroup(entry)
                      ? (
                        <div class="rc-navgroup">
                          <h3 class="rc-subh">{entry.label}</h3>
                          <ul class="rc-chips">
                            {entry.children.map((c) => <li class="rc-chip"><a href={c.href}>{c.label}</a></li>)}
                          </ul>
                        </div>
                      )
                      : <span class="rc-chip rc-chip-solo"><a href={entry.href}>{entry.label}</a></span>
                  ))}
                </div>

                {navCount === 0 && (
                  <p class="rc-empty">
                    This role opens nothing. Someone holding only this role would see an admin
                    console with no navigation at all.
                  </p>
                )}
              </div>
            )}

            {/* ---------------------------------------------------------------- settings */}
            {tab === 'settings' && (
              <form method="POST" class="rc-settings">
                <input type="hidden" name="_action" value="update_role" />
                <input type="hidden" name="role_id" value={role.id} />

                <label class="rc-field">
                  <span class="rc-label">Name</span>
                  <input class="rc-input" name="name" required minlength="2" maxlength="80" value={role.name} />
                </label>

                <label class="rc-field">
                  <span class="rc-label">Key</span>
                  {role.key
                    ? <input class="rc-input" value={role.key} readonly disabled />
                    : <input class="rc-input" name="key" maxlength="80" placeholder={slugifyRoleKey(role.name)} />}
                  <span class="rc-hint">
                    {role.key
                      ? 'Permanent. Anything referencing this role uses it, and changing it would break those references without saying so.'
                      : 'This role predates keys. Set one now and it becomes permanent; leave it blank and the role keeps working without one.'}
                  </span>
                </label>

                <label class="rc-field">
                  <span class="rc-label">Description</span>
                  <textarea class="rc-input" name="description" rows="3" maxlength="500">{role.description || ''}</textarea>
                </label>

                <label class="rc-field">
                  <span class="rc-label">Colour</span>
                  <select class="rc-input" name="color">
                    {COLORS.map((c) => <option value={c} selected={role.color === c}>{c}</option>)}
                  </select>
                </label>

                <div class="rc-actions">
                  <button class="rc-btn rc-primary" type="submit">Save details</button>
                </div>
              </form>
            )}

            {/* ------------------------------------------------------------------ delete */}
            {tab === 'delete' && (
              <div class="rc-delete">
                {members.length > 0 && (
                  <div class="rc-note rc-bad">
                    <strong>
                      {members.length} {members.length === 1 ? 'person still holds' : 'people still hold'} this role,
                      so it cannot be deleted.
                    </strong>
                    Deleting it now would take away whatever it grants without telling any of them,
                    and the first symptom would be somebody unable to do their job with no
                    explanation. Move them first.
                  </div>
                )}

                {members.length > 0 && (
                  <ul class="rc-members">
                    {members.map((m) => (
                      <li class="rc-member">
                        <div class="rc-member-who">
                          <span class="rc-member-name">{personLabel(m)}</span>
                          <span class="rc-member-mail">{m.email}</span>
                          <span class="rc-member-meta">{m.builtinRole} &middot; added {when(m.assignedAt)}</span>
                        </div>
                        <form method="POST">
                          <input type="hidden" name="_action" value="unassign_user" />
                          <input type="hidden" name="role_id" value={role.id} />
                          <input type="hidden" name="user_id" value={m.userId} />
                          <input type="hidden" name="return_tab" value="delete" />
                          <button class="rc-btn rc-danger" type="submit">Remove from role</button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}

                {members.length === 0 && (
                  <div class="rc-note">
                    <strong>Nobody holds this role.</strong> Deleting it removes the role and the
                    <span>{grants.length}</span>
                    permission{grants.length === 1 ? '' : 's'} it holds. What it granted is written
                    to the audit log first, so the record survives the role.
                  </div>
                )}

                <form method="POST" class="rc-actions">
                  <input type="hidden" name="_action" value="delete_role" />
                  <input type="hidden" name="role_id" value={role.id} />
                  <button class="rc-btn rc-danger" type="submit" disabled={members.length > 0}>
                    Delete "{role.name}"
                  </button>
                  <a class="rc-btn" href={tabHref(role.id, 'permissions')}>Cancel</a>
                </form>
              </div>
            )}
          </div>
        )}
      </section>
    </div>

    <p class="rc-closing">
      Custom roles are additive to the built-in matrix and never subtract from it: to take an ability
      away from someone, change their role in <a href="/admin/users">Users</a>. What the built-in
      roles grant, and who holds them, is in <a href="/admin/access-preview">Access preview</a>.
    </p>
  </div>
</AdminLayout>

<style>
