  .rc-btn { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 7px 13px; border-radius: 7px; border: 1px solid #2a2a30; background: #14141b; color: #d8d8de; cursor: pointer; font-family: inherit; }
  .rc-btn:hover { text-decoration: none; border-color: #3a3a44; }
  .rc-btn.rc-primary { background: #FF4F00; border-color: #FF4F00; color: #0b0b0f; }
  .rc-btn.rc-danger { color: #fca5a5; border-color: #7f1d1d; background: rgba(127, 29, 29, 0.16); }
  .rc-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .rc-members, .rc-candidates { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .rc-member, .rc-candidate { display: flex; gap: 10px; justify-content: space-between; align-items: center; flex-wrap: wrap; border: 1px solid #1f1f26; border-radius: 10px; background: #0c0c11; padding: 9px 11px; }
