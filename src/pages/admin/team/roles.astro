  .rc-perm-body { min-width: 0; }
  .rc-perm-title { display: block; font-size: 12.5px; color: #e8e8ee; line-height: 1.5; }
  .rc-perm-key { margin-left: 6px; }
  .rc-perm-desc { display: block; font-size: 11.5px; color: #8a8a94; line-height: 1.55; margin-top: 3px; }

  .rc-badge { display: inline-block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.04em; padding: 2px 7px; border-radius: 100px; background: #1a1a22; color: #8a8a94; margin-left: 6px; vertical-align: middle; }
  .rc-badge.rc-badge-warn { background: rgba(251, 191, 36, 0.14); color: #fbbf24; }
  .rc-badge.rc-badge-alarm { background: rgba(220, 38, 38, 0.16); color: #fca5a5; margin-left: 0; }

  .rc-save { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 14px; }
  .rc-confirm { display: inline-flex; gap: 7px; align-items: center; font-size: 11.5px; color: #fca5a5; }
  .rc-confirm input { accent-color: #dc2626; width: 15px; height: 15px; }

  .rc-field { display: block; margin-bottom: 12px; }
  .rc-field-check { display: flex; gap: 8px; align-items: center; }
  .rc-label { display: block; font-size: 10px; font-weight: 600; color: #8a8a94; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 5px; }
  .rc-input { width: 100%; padding: 8px 10px; background: #08080a; border: 1px solid #1f1f26; border-radius: 6px; color: #fff; font-size: 12.5px; font-family: inherit; outline: none; }
  .rc-input:focus { border-color: #FF4F00; }
