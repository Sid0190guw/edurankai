---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { randomBytes, createHmac } from 'node:crypto';
import { db } from '@/lib/db';
import { applications, offerLetters, users, applicationMessages, roles } from '@/lib/db/schema';
// The offer path had NO compensation guard at all - see the doc comment on offerCompensationFor.
import { offerCompensationFor } from '@/lib/compensation-text';
import { generateInternalHandle } from '@/lib/auth/handle';
import { eq } from 'drizzle-orm';
import { resolveEngagementPolicy, shortCommitment } from '@/lib/engagement-policy';
// The funnel engine. applications.stage is never written by hand from here — advanceStage() owns the
// column, its history table and the notification that goes with a move.
import { advanceStage } from '@/lib/application-stages';
import { civilToday } from '@/lib/page-safety';
// One place decides how much time is left and whether a revoke may be offered. The candidate's
// page has counted these dates down since the table was written; this side showed nothing.
import { offerClock } from '@/lib/offer-clock';
// A work mode was written into every offer letter as "Remote" by default. The company does not
// offer remote work: permanent roles are on site, and hybrid exists only for internships and
// apprenticeships. The same module the careers pages use decides it here, so an offer letter cannot
// promise terms the job posting does not.
import { allowedWorkModes, workModeTitle, resolveWorkMode } from '@/lib/work-mode';
import RichMessageComposer from '@/components/admin/RichMessageComposer.astro';
import { sendLetterEmail, LETTER_TOKENS } from '@/lib/hr/letter-mail';
import { publicUrl } from '@/lib/public-origin';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role === 'applicant') return Astro.redirect('/portal');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/applications');

let errorMsg = '';
let successMsg = '';
// Declared before the POST handler that assigns it. There is NO EMAIL FALLBACK on this page, so the
// push is the only thing that tells a candidate an offer exists — and it sat inside a bare catch
// while the page printed "Offer sent." A candidate who is never told has not been sent anything.
let candidateNotTold = '';
// The candidate's six-step tracker, reported separately from the letter itself. Declared here,
// above the POST handler that assigns it.
let stageNotMoved = '';

const found = await db.select().from(applications).where(eq(applications.id, id)).limit(1);
if (found.length === 0) return Astro.redirect('/admin/applications');
const app: any = found[0];

// THE SLUG IS THE ONLY THING THAT MAY MAKE A TRAINEE PAID (the allowlist in compensation-text.ts),
// and applications stores no slug snapshot - only roleId and roleTitleSnapshot. One lookup, so the
// offer letter is judged by the same four fields the job advert is. A general application carries no
// roleId and a failed read leaves the slug empty; both land on the unpaid side, which is the only
// safe direction for a document somebody signs.
let payRoleSlug = '';
if (app.roleId) {
  try {
    const rr = await db.select({ slug: roles.slug }).from(roles).where(eq(roles.id, app.roleId)).limit(1);
    if (rr.length > 0) payRoleSlug = String(rr[0].slug || '');
  } catch (e: any) {
    console.error('[offer-letter] role slug lookup -', e?.cause?.message || e?.message);
  }
}
const payRole = {
  level: app.level, engagementType: app.engagementType,
  title: app.roleTitleSnapshot, slug: payRoleSlug,
};

const existing = await db.select().from(offerLetters).where(eq(offerLetters.applicationId, id)).limit(1);
let existingOffer = existing.length > 0 ? existing[0] : null;

// The application-status wording used on /admin/applications/[id], repeated here as pairs rather
// than a typed Record so it is safe to read from this .astro file. Declared ABOVE the POST handler
// that reads it, because `const` is not hoisted.
const APP_STATUS_WORDS: ReadonlyArray<readonly [string, string]> = [
  ['submitted', 'Submitted'], ['reviewing', 'Under Review'], ['task_sent', 'Task / Walkthrough sent'],
  ['interview', 'Interview'], ['offer', 'Offer Extended'], ['hired', 'Hired'],
  ['rejected', 'Closed'], ['withdrawn', 'Withdrawn'],
];
function appStatusWord(s: string): string {
  const hit = APP_STATUS_WORDS.find((p) => p[0] === String(s || ''));
  return hit ? hit[1] : String(s || 'unset');
}

function genToken(): string {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789abcdefghjkmnpqrstuvwxyz';
  let t = '';
  const bytes = randomBytes(32);
  for (let i = 0; i < 32; i++) t += chars[bytes[i] % chars.length];
  return t;
}

function integrityHmac(parts: string[]): string {
  const secret = import.meta.env.OFFER_INTEGRITY_SECRET || process.env.OFFER_INTEGRITY_SECRET || 'dev-fallback-change-in-prod';
  return createHmac('sha256', secret).update(parts.join('|')).digest('hex').slice(0, 16);
}

function genPassword(): string {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  const pwBytes = randomBytes(16);
  let p = '';
  for (let i = 0; i < 16; i++) {
    if (i > 0 && i % 4 === 0) p += '-';
    p += chars[pwBytes[i] % chars.length];
  }
  return p;
}

async function createUserAccount(email: string, fullName: string, plaintextPw: string, templateType: string): Promise<{userId: string, handle: string, isNew: boolean} | null> {
  try {
    const { hashPassword } = await import('@/lib/auth/password');
    const existing = await db.select({ id: users.id }).from(users).where(eq(users.email, email)).limit(1);
    if (existing.length > 0) {
      // Existing account: keep their password (they already know it) - never reset
      // it here or we lock the applicant out of the portal they signed up through.
      // Just ensure the account is active and carries an internal handle.
      const existingUserId = existing[0].id;
      const u = await db.select({ h: users.internalHandle, n: users.name }).from(users).where(eq(users.id, existingUserId)).limit(1);
      let handle = u[0]?.h || null;
      if (!handle) {
        handle = await generateInternalHandle(fullName);
      }
      await db.update(users).set({ internalHandle: handle, isActive: true, updatedAt: new Date() }).where(eq(users.id, existingUserId));
      return { userId: existingUserId, handle, isNew: false };
    }
    // A candidate who has not accepted yet is NOT staff. This used to create the account as
    // 'editor', which meant merely SENDING an offer handed out internal access — and 'editor'
    // passes every `role !== 'applicant'` test in the codebase. The account is created as
    // 'applicant' (which is all /portal and /portal/employee need) and promoted to 'editor' when
    // the offer is actually signed, in /portal/offer/[token].astro.
    // Promote to super_admin manually via /admin/users only after verification.
    let role: any = 'applicant';
    const hashed = await hashPassword(plaintextPw);
    const inserted = await db.insert(users).values({
      email,
      name: fullName,
      passwordHash: hashed,
      role,
      isActive: true
    }).returning({ id: users.id });
    const newUserId = inserted[0]?.id;
    if (!newUserId) return null;
    const handle = await generateInternalHandle(fullName);
    await db.update(users).set({ internalHandle: handle }).where(eq(users.id, newUserId));
    return { userId: newUserId, handle, isNew: true };
  } catch (e) {
    console.error('createUserAccount failed:', e);
    return null;
  }
}

// THE LETTER COULD NOT BE SENT TO THE PERSON IT WAS ABOUT.
//
// This page generates a real record — offer_letters, with a token, a reference number and an
// integrity hash — moves the application to "offer", creates the portal account and pushes a
// notification. It said so about itself, in its own comment forty lines below: "this file sends no
// email either. The candidate learned about their offer only if an admin told them by hand."
//
// A push notification reaches a device that has granted permission and installed the app. An offer
// is the one message a candidate reads in their inbox. So this is the missing step, and it is a
// LINK rather than a copy of the letter on purpose: the offer at /portal/offer/<token> is the
// signable document, and a candidate who treats an emailed copy as the artefact is a candidate who
// never signs.
//
// Declared ABOVE the POST handler that assigns them. `const` is not hoisted and this page's own
// header says what that has cost here before.
let letterSendOk = '';
let letterSendErr = '';
let letterSendRemoved: { kind: string; name: string; reason: string }[] = [];

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  try {
    if (action === 'extend_offer') {
      // Milestone only: mark the application stage as "offer extended" without
      // sending the formal letter. The letter is a separate step below.
      await db.update(applications).set({ status: 'offer', updatedAt: new Date() }).where(eq(applications.id, id));
      // The same omission as the letter branch below, on the milestone-only path: status moved and
      // applications.stage did not, so the candidate's six-step tracker went on showing an earlier
      // step after they had been told an offer was coming.
      try {
        const _moved = await advanceStage({
          applicationId: id,
          toStage: 'decision',
          actorUserId: user.id,
          actorName: user.name || user.email || 'People desk',
          note: 'Offer extended. The formal letter follows.',
        });
        if (!_moved.ok) {
          console.error('[offer-letter] tracker did not move for application', id, '-', _moved.error);
          stageNotMoved = 'The offer stage is recorded, but the candidate’s six-step tracker did not move: '
            + (_moved.error || 'unknown reason') + ' - they still see the previous step.';
        }
      } catch (e: any) {
        console.error('[offer-letter] tracker did not move for application', id, '-', e?.cause?.message || e?.message);
        stageNotMoved = 'The offer stage is recorded, but the candidate’s six-step tracker did not move: '
          + (e?.cause?.message || e?.message || 'unknown reason') + ' - they still see the previous step.';
      }
      try {
        await db.insert(applicationMessages).values({
          applicationId: id,
          senderUserId: user.id,
          senderRole: 'system',
          senderName: 'System',
          body: 'Offer extended to the candidate. A formal offer letter will follow.',
          isSystem: true
        });
      } catch (e: any) {
        // The thread entry is what the candidate reads on their application page. The stage change
        // above has committed, so this cannot abort — but it must not vanish either.
        console.error('[offer-letter] the "offer extended" thread message was not written for', id, '-', e?.cause?.message || e?.message);
        candidateNotTold = 'The offer stage was recorded, but the note explaining it was NOT added to the candidate\'s thread.';
      }
      // Nothing on this page notified anyone: this branch bypasses [id].astro entirely, so
      // neither pushNotify.applicationStatus nor pushApplicant.offerExtended ran, and this file
      // sends no email either. The candidate learned about their offer only if an admin told them
      // by hand. Both sends are individually guarded — the enclosing try/catch sets
      // errorMsg = 'Failed: ...', so an unguarded push throw would report failure to the admin
      // even though the offer stage had already committed.
      // Build the name inline: fullName/shortId are declared with const further down the file.
      const _candName = ((app.firstName || '') + ' ' + (app.lastName || '')).trim() || app.email || 'The candidate';
      const _roleTitle = app.roleTitleSnapshot || 'the role';
      if (app.applicantUserId) {
        try {
          const { sendPushToUser } = await import('@/lib/push');
          await sendPushToUser(app.applicantUserId, {
            type: 'applicant_offer',
            title: 'You have an offer',
            body: 'An offer has been extended for ' + _roleTitle + '. The formal letter follows shortly.',
            url: '/portal/applications/' + id,
            tag: 'offer-extended-' + id,
          });
        } catch (e: any) {
          console.error('[offer-letter] "offer extended" notification failed for', id, '-', e?.cause?.message || e?.message);
          candidateNotTold = 'The candidate was NOT notified that an offer has been extended — tell them yourself.';
        }
      } else {
        candidateNotTold = 'This application has no portal account attached, so the candidate could not be notified that an offer has been extended.';
      }
      try {
        const { sendPushToAdmins } = await import('@/lib/push');
        await sendPushToAdmins({
          type: 'offer_extended',
          title: 'Offer extended',
          body: _candName + ' - ' + _roleTitle,
          url: '/admin/applications/' + id,
          tag: 'offer-extended-admin-' + id,
        }, user.id);
      } catch (e: any) {
        // Admin-side notice only — never blocks the offer, but never silent either.
        console.error('[offer-letter] admin notification failed -', e?.cause?.message || e?.message);
      }
      app.status = 'offer';
      successMsg = 'Offer extension confirmed. Application stage is now "Offer". Send the formal letter below when ready.';
    } else if (action === 'email_offer') {
      // Only ever for a letter that already exists and has already been issued. Emailing a DRAFT
      // would hand somebody a link to a document the desk has not finished writing.
      if (!existingOffer) {
        errorMsg = 'There is no offer letter to email yet. Generate and send it first.';
      } else if (existingOffer.status === 'draft') {
        errorMsg = 'That offer is still a draft. Send it first, then email the candidate their link.';
      } else {
        const out = await sendLetterEmail({
          actorUserId: user.id,
          typeKey: 'offer:offer',
          noteHtml: String(fd.get('noteHtml') || ''),
          // NO letterHtml. The letter lives at its token URL, where it can be read AND SIGNED; a
          // copy in the message body would be the same words with none of the consequence.
          ctx: {
            recipientName: existingOffer.candidateName || '',
            recipientEmail: String(fd.get('recipientEmail') || existingOffer.candidateEmail || '').trim(),
            roleTitle: existingOffer.roleTitle || '',
            department: existingOffer.department || '',
            refNumber: existingOffer.refNumber || '',
            issueDate: existingOffer.offerDate || '',
            letterUrl: publicUrl('/portal/offer/' + existingOffer.token),
          },
        });
        letterSendRemoved = out.removed;
        if (out.sent) letterSendOk = out.message;
        else letterSendErr = out.message;
      }
    } else if (action === 'generate') {
      const candidateName = ((fd.get('candidateName') as string) || '').trim();
      const candidateEmail = ((fd.get('candidateEmail') as string) || '').trim();
      const roleTitle = ((fd.get('roleTitle') as string) || '').trim();
      const department = ((fd.get('department') as string) || '').trim();
      // THE LAST INTERN FALLBACK IN A WRITE PATH.
      //
      // This form has no templateType input. `fd.get('templateType')` is therefore ALWAYS null, and
      // this line was writing template_type = 'intern' onto every single offer letter this page has
      // ever generated — Chief Officers included. The letter page treats that column as an override
      // REQUEST and refuses it wherever the agreed fields contradict it, which is why the leak was
      // no longer visible; but with no level recorded and no employment type typed, 'intern' was
      // still enough to supply the engagement and select the internship template on its own.
      //
      // The default is now "no request". A human who wants a specific template asks for one; nobody
      // asks for one by omission.
      const templateType = ((fd.get('templateType') as string) || '').trim();
      const employmentType = ((fd.get('employmentType') as string) || '').trim();
      // Clamped, not trusted. A stale form, a resubmitted page or a hand-built request must not be
      // able to put "Remote" into a signed offer letter.
      const submittedWorkMode = ((fd.get('workMode') as string) || '').trim();
      const workMode = workModeTitle(resolveWorkMode(employmentType, app.level, submittedWorkMode));
      const duration = ((fd.get('duration') as string) || '').trim();
      const hoursCommitment = ((fd.get('hoursCommitment') as string) || '').trim();
      // NORMALISED, not trusted. This box is free text and an operator can type a stipend into it
      // for a role that pays nothing - which is exactly how 49 job rows came to advertise stipends
      // before roleSchema started healing them. The offer letter is the document the candidate acts
      // on, so it gets the same treatment.
      const compensation = offerCompensationFor(payRole, ((fd.get('compensation') as string) || 'Unpaid').trim());
      const reportingTo = ((fd.get('reportingTo') as string) || '').trim();
      const candidatePhone = ((fd.get('candidatePhone') as string) || '').trim();
      const candidateCity = ((fd.get('candidateCity') as string) || '').trim();
      const offerDate = ((fd.get('offerDate') as string) || '').trim();
      const joiningDate = ((fd.get('joiningDate') as string) || '').trim();
      const expiryDate = ((fd.get('expiryDate') as string) || '').trim();
      const responseDeadline = ((fd.get('responseDeadline') as string) || '').trim();
      const signatoryName = ((fd.get('signatoryName') as string) || '').trim();
      const signatoryTitle = ((fd.get('signatoryTitle') as string) || '').trim();
      const customNote = ((fd.get('customNote') as string) || '').trim();
      const refNumber = ((fd.get('refNumber') as string) || '').trim();
      // The operator's covering message, written in the composer on the generate form. Read here
      // with every other field; the send below is the only thing that uses it.
      const offerNoteHtml = String((fd.get('noteHtml') as string) || '');
      const saveDraft = fd.get('saveDraft') === '1';
      // The Founder's wellbeing remark is optional per offer — some candidates would not welcome
      // it. The checkbox is unchecked by default, so it is only added when the sender opts in.
      const includeFounderRemark = fd.get('includeFounderRemark') === '1';

      if (!candidateName || !candidateEmail || !roleTitle || !signatoryName) {
        errorMsg = 'Required: candidate name, email, role, and signatory.';
      } else {
        const integrityHash = integrityHmac([refNumber, candidateName, roleTitle, department, offerDate, employmentType]);
        const contentBlob = {
          // THE AGREED LEVEL TRAVELS WITH THE LETTER. It was never stored, so the letter had to go
          // back to the application row to find out who it was describing — and if that row was
          // later edited, or the level had never been set on it, the document silently changed
          // meaning. It is the field the candidate was assessed at; it belongs in the record of
          // what was offered.
          level: app.level || '',
          candidateName, candidateEmail, candidatePhone, candidateCity,
          roleTitle, department, employmentType, workMode, duration,
          hoursCommitment, compensation, reportingTo,
          offerDate, joiningDate, expiryDate, responseDeadline,
          signatoryName, signatoryTitle, customNote, templateType,
          includeFounderRemark
        };

        if (existingOffer) {
          const wasDraft = existingOffer.status === 'draft';
          const sendingNow = !saveDraft;
          // Draft -> Send transition: create the account now if it wasn't yet.
          let acct: any = null;
          let tempPw = '';
          if (wasDraft && sendingNow && !existingOffer.createdUserId) {
            tempPw = genPassword();
            acct = await createUserAccount(candidateEmail, candidateName, tempPw, templateType);
          }
          const newStatus = sendingNow ? 'sent' : 'draft';
          const setVals: any = {
            templateType, content: contentBlob,
            candidateName, candidateEmail, roleTitle, department,
            refNumber, integrityHash,
            offerDate: offerDate || null,
            joiningDate: joiningDate || null,
            expiryDate: expiryDate || null,
            responseDeadline: responseDeadline || null,
            status: newStatus,
            updatedAt: new Date()
          };
          if (acct?.userId) setVals.createdUserId = acct.userId;
          await db.update(offerLetters).set(setVals).where(eq(offerLetters.id, existingOffer.id));
          if (wasDraft && sendingNow) {
            if (app.status !== 'hired' && app.status !== 'offer') {
              await db.update(applications).set({ status: 'offer', updatedAt: new Date() }).where(eq(applications.id, id));
              app.status = 'offer';
            }
            // AND THE CANDIDATE'S OWN TRACKER MOVES WITH IT.
            //
            // Issuing the letter wrote applications.status and stopped. applications.stage — the six
            // steps the candidate is actually shown on /portal/applications/[id] — was left where it
            // was, so somebody holding an offer letter in their hand was still being told "01 ·
            // Submitted: your application is in our queue". advanceStage() owns that column, its
            // history and the notification; it reports rather than throwing, so a tracker that does
            // not move never un-sends an offer that has.
            try {
              const _moved = await advanceStage({
                applicationId: id,
                toStage: 'decision',
                actorUserId: user.id,
                actorName: user.name || user.email || 'People desk',
                note: 'Offer letter issued.',
              });
              if (!_moved.ok) {
                console.error('[offer-letter] tracker did not move for application', id, '-', _moved.error);
                stageNotMoved = 'The offer is issued, but the candidate’s six-step tracker did not move: '
                  + (_moved.error || 'unknown reason') + ' - they still see the previous step.';
              }
            } catch (e: any) {
              console.error('[offer-letter] tracker did not move for application', id, '-', e?.cause?.message || e?.message);
              stageNotMoved = 'The offer is issued, but the candidate’s six-step tracker did not move: '
                + (e?.cause?.message || e?.message || 'unknown reason') + ' - they still see the previous step.';
            }
            // This was a no-op: pushNotify has no `offerSent` member (only offerSigned /
            // offerDeclined), so the guard was always false and the candidate was never told
            // their offer letter had been issued.
            const _to = acct?.userId || existingOffer.createdUserId || app.applicantUserId;
            if (_to) {
              try {
                const { sendPushToUser } = await import('@/lib/push');
                await sendPushToUser(_to, {
                  type: 'applicant_offer',
                  title: 'Your offer letter is ready',
                  body: roleTitle ? 'Your offer for ' + roleTitle + ' is ready to review and sign.' : 'Your offer letter is ready to review and sign.',
                  url: '/portal/offer/' + existingOffer.token,   // straight to the signable document
                  tag: 'offer-letter-' + id,
                });
              } catch (e: any) {
                console.error('[offer-letter] candidate notification failed for application', id, '-', e?.cause?.message || e?.message);
                candidateNotTold = 'The candidate was NOT notified that their offer letter is ready — send them the link yourself.';
              }
            } else {
              candidateNotTold = 'This offer has no portal account attached, so nobody could be notified — send the candidate the link yourself.';
            }
            try {
              const { sendPushToAdmins } = await import('@/lib/push');
              await sendPushToAdmins({
                type: 'offer_extended',
                title: 'Offer letter sent',
                body: (candidateName || 'Candidate') + (roleTitle ? ' - ' + roleTitle : ''),
                url: '/admin/applications/' + id,
                tag: 'offer-letter-admin-' + id,
              }, user.id);
            } catch (e: any) {
              // Admin-side notice only — never blocks the offer, but never silent either.
              console.error('[offer-letter] admin notification failed -', e?.cause?.message || e?.message);
            }

            // THE SEND. Placed here, inside if (wasDraft && sendingNow), because that is the only
            // branch where an offer is actually ISSUED: a draft save and a re-save of an
            // already-sent letter both reach this action and neither may mail the candidate.
            // The record is committed and the stage is moved by this point, which is why
            // sendLetterEmail() is contractually incapable of throwing - a failure here must not
            // undo work that has already happened.
            //
            // NOTHING DERIVED FROM successMsg. That string interpolates the plaintext temporary
            // password one line below, and LetterContext has no password field precisely so a
            // credential cannot ride along with a letter. The covering note is the operator's own
            // text and nothing else.
            {
              const out = await sendLetterEmail({
                actorUserId: user.id,
                typeKey: 'offer:offer',
                noteHtml: offerNoteHtml,
                ctx: {
                  recipientName: candidateName,
                  recipientEmail: candidateEmail,
                  roleTitle,
                  department,
                  refNumber,
                  issueDate: offerDate,
                  signatoryName,
                  signatoryTitle,
                  letterUrl: publicUrl('/portal/offer/' + existingOffer.token),
                },
              });
              letterSendRemoved = out.removed;
              if (out.sent) letterSendOk = out.message;
              else letterSendErr = out.message;
            }

            // "Issued", not "sent". The offer record is committed either way, but whether anything
            // reached the candidate is now a real question with a real answer, and it is appended to
            // this line by the folding at the foot of the handler. A green banner reading "sent"
            // beside a red one reading "not sent" is the contradiction this wording removes.
            successMsg = acct?.isNew
              ? 'Offer issued. TEMPORARY PASSWORD (copy now, shown once): ' + tempPw + ' — email ' + candidateEmail + (acct.handle ? ' OR handle ' + acct.handle : '') + '. Token: ' + existingOffer.token + '.'
              : 'Offer issued. Token: ' + existingOffer.token + '.';
          } else {
            successMsg = saveDraft ? 'Draft saved (not sent). Token: ' + existingOffer.token : 'Offer updated. Token: ' + existingOffer.token;
          }
        } else {
          const token = genToken();
          let createdUserId: string | null = null;
          let internalHandle: string | null = null;
          let accountIsNew = false;
          let plaintextPw = '';
          // Only provision an account + advance + notify when actually sending.
          if (!saveDraft) {
            plaintextPw = genPassword();
            const accountResult = await createUserAccount(candidateEmail, candidateName, plaintextPw, templateType);
            createdUserId = accountResult?.userId || null;
            internalHandle = accountResult?.handle || null;
            accountIsNew = accountResult?.isNew || false;
          }

          await db.insert(offerLetters).values({
            token,
            applicationId: id,
            generatedByUserId: user.id,
            status: saveDraft ? 'draft' : 'sent',
            templateType,
            content: contentBlob,
            candidateName,
            candidateEmail,
            roleTitle,
            department: department || null,
            refNumber,
            integrityHash,
            offerDate: offerDate || null,
            joiningDate: joiningDate || null,
            expiryDate: expiryDate || null,
            responseDeadline: responseDeadline || null,
            // plaintextPassword intentionally omitted - do not store plaintext passwords
            createdUserId: createdUserId
          });
          if (saveDraft) {
            successMsg = 'Draft saved (not sent). Review it, then click "Generate & send" to issue. Token: ' + token + '.';
          } else {
            // Sending the formal letter implies the offer is extended - advance
            // the application stage so status reflects it everywhere.
            if (app.status !== 'hired' && app.status !== 'offer') {
              await db.update(applications).set({ status: 'offer', updatedAt: new Date() }).where(eq(applications.id, id));
              app.status = 'offer';
            }
            // AND THE CANDIDATE'S OWN TRACKER MOVES WITH IT.
            //
            // Issuing the letter wrote applications.status and stopped. applications.stage — the six
            // steps the candidate is actually shown on /portal/applications/[id] — was left where it
            // was, so somebody holding an offer letter in their hand was still being told "01 ·
            // Submitted: your application is in our queue". advanceStage() owns that column, its
            // history and the notification; it reports rather than throwing, so a tracker that does
            // not move never un-sends an offer that has.
            try {
              const _moved = await advanceStage({
                applicationId: id,
                toStage: 'decision',
                actorUserId: user.id,
                actorName: user.name || user.email || 'People desk',
                note: 'Offer letter issued.',
              });
              if (!_moved.ok) {
                console.error('[offer-letter] tracker did not move for application', id, '-', _moved.error);
                stageNotMoved = 'The offer is issued, but the candidate’s six-step tracker did not move: '
                  + (_moved.error || 'unknown reason') + ' - they still see the previous step.';
              }
            } catch (e: any) {
              console.error('[offer-letter] tracker did not move for application', id, '-', e?.cause?.message || e?.message);
              stageNotMoved = 'The offer is issued, but the candidate’s six-step tracker did not move: '
                + (e?.cause?.message || e?.message || 'unknown reason') + ' - they still see the previous step.';
            }
            // The common path: a brand-new letter being issued. Nothing here notified anyone
            // before, and this file sends no email either, so the candidate only found out if an
            // admin copied the token out of successMsg and messaged them by hand.
            if (createdUserId) {
              try {
                const { sendPushToUser } = await import('@/lib/push');
                await sendPushToUser(createdUserId, {
                  type: 'applicant_offer',
                  title: 'Your offer letter is ready',
                  body: roleTitle ? 'Your offer for ' + roleTitle + ' is ready to review and sign.' : 'Your offer letter is ready to review and sign.',
                  url: '/portal/offer/' + token,   // straight to the signable document
                  tag: 'offer-letter-' + id,
                });
              } catch (e: any) {
                console.error('[offer-letter] candidate notification failed for application', id, '-', e?.cause?.message || e?.message);
                candidateNotTold = 'The candidate was NOT notified that their offer letter is ready — send them the link yourself.';
              }
            } else {
              candidateNotTold = 'No portal account was created for this candidate, so nobody could be notified — send them the offer link yourself.';
            }
            try {
              const { sendPushToAdmins } = await import('@/lib/push');
              await sendPushToAdmins({
                type: 'offer_extended',
                title: 'Offer letter sent',
                body: (candidateName || 'Candidate') + (roleTitle ? ' - ' + roleTitle : ''),
                url: '/admin/applications/' + id,
                tag: 'offer-letter-admin-' + id,
              }, user.id);
            } catch (e: any) {
              // Admin-side notice only — never blocks the offer, but never silent either.
              console.error('[offer-letter] admin notification failed -', e?.cause?.message || e?.message);
            }

            // THE SEND. Placed here, inside the else of if (saveDraft), because that is the only
            // branch where an offer is actually ISSUED: a draft save and a re-save of an
            // already-sent letter both reach this action and neither may mail the candidate.
            // The record is committed and the stage is moved by this point, which is why
            // sendLetterEmail() is contractually incapable of throwing - a failure here must not
            // undo work that has already happened.
            //
            // NOTHING DERIVED FROM successMsg. That string interpolates the plaintext temporary
            // password one line below, and LetterContext has no password field precisely so a
            // credential cannot ride along with a letter. The covering note is the operator's own
            // text and nothing else.
            {
              const out = await sendLetterEmail({
                actorUserId: user.id,
                typeKey: 'offer:offer',
                noteHtml: offerNoteHtml,
                ctx: {
                  recipientName: candidateName,
                  recipientEmail: candidateEmail,
                  roleTitle,
                  department,
                  refNumber,
                  issueDate: offerDate,
                  signatoryName,
                  signatoryTitle,
                  letterUrl: publicUrl('/portal/offer/' + token),
                },
              });
              letterSendRemoved = out.removed;
              if (out.sent) letterSendOk = out.message;
              else letterSendErr = out.message;
            }
            if (accountIsNew) {
              successMsg = 'Offer letter issued. Login at edurankai.in/admin/login with email ' + candidateEmail + (internalHandle ? ' OR handle ' + internalHandle : '') + '. TEMPORARY PASSWORD (shown once, copy now and send to the candidate): ' + plaintextPw + ' — they should change it after first sign-in. Offer token: ' + token + '.';
            } else {
              successMsg = 'Offer letter issued. Token: ' + token + '. Existing account — the candidate keeps their current password (handle ' + (internalHandle || candidateEmail) + ').';
            }
          }
        }
      }
    } else if (action === 'withdraw' && existingOffer) {
      const reason = ((fd.get('reason') as string) || '').trim();
      await db.update(offerLetters).set({
        status: 'withdrawn',
        withdrawnAt: new Date(),
        withdrawnReason: reason || null,
        updatedAt: new Date()
      }).where(eq(offerLetters.id, existingOffer.id));

      // THE PERSON WHOSE JOB IT WAS IS TOLD.
      //
      // Every other branch of this handler pushes the candidate and reports separately when it could
      // not. This one updated the row and printed "Offer withdrawn." — so somebody who had been told
      // they had a job found out only if they happened to re-open the token, which is the one link
      // they had no reason to open again. The withdrawal is already committed by this point; a failed
      // notification is reported to the person who pressed the button rather than swallowed.
      // `roleTitle` IS DECLARED IN THE `generate` BRANCH, NOT THIS ONE.
      //
      // The two push bodies below read a `const` that is block-scoped to a sibling branch, so every
      // withdrawal raised a ReferenceError — AFTER the UPDATE above had already committed. The offer
      // was withdrawn, the candidate was never told, the notification code never ran, and the whole
      // handler fell into the outer catch, which printed a failure for something that had in fact
      // happened. The operator's reasonable next move is to press Withdraw again.
      //
      // The title is taken from the OFFER ROW — the document actually being withdrawn — falling back
      // to the application snapshot, so the sentence names the role the candidate was told about.
      const _wRole = String((existingOffer as any).roleTitle || app.roleTitleSnapshot || '').trim();
      const _wTo = existingOffer.createdUserId || app.applicantUserId;
      if (_wTo) {
        try {
          const { sendPushToUser } = await import('@/lib/push');
          await sendPushToUser(_wTo, {
            type: 'applicant_offer',
            title: 'Your offer has been withdrawn',
            body: reason
              ? 'The offer for ' + (_wRole || 'this role') + ' has been withdrawn: ' + reason
              : 'The offer for ' + (_wRole || 'this role') + ' has been withdrawn. Open it for the details.',
            url: '/portal/offer/' + existingOffer.token,
            tag: 'offer-withdrawn-' + id,
          });
        } catch (e: any) {
          console.error('[offer-letter] withdrawal notification failed for application', id, '-', e?.cause?.message || e?.message);
          candidateNotTold = 'The offer is withdrawn, but the candidate was NOT notified - tell them yourself.';
        }
      } else {
        candidateNotTold = 'The offer is withdrawn, but no portal account is attached, so the candidate could not be notified - tell them yourself.';
      }
      // THE APPLICATION IS NOT CLOSED BY THIS, AND THE SCREEN NOW SAYS SO.
      //
      // Withdrawing the letter moves offer_letters.status and nothing else. applications.status is
      // left reading "Offer Extended" for an offer that no longer exists, and the candidate's own
      // six-step tracker is left on 05 · Decision — so the application sits in the funnel with a
      // live-looking offer against it and no owner. Deciding what the application becomes (closed,
      // or back under review for another role) is a judgement, not a default, so this states the
      // outstanding step and where it is done rather than guessing at it.
      successMsg = 'Offer withdrawn. The application is still marked "' + appStatusWord(app.status)
        + '" — set its final status on the application page (Status panel at /admin/applications/' + id
        + '), or it stays in the funnel with no live offer against it.';
    }
  } catch (err: any) {
    // `.message` on a drizzle error is only the failed SQL; the reason lives on `.cause`.
    const real = err?.cause?.message || err?.message;
    console.error('[offer-letter] action failed for application', id, '-', real);
    errorMsg = 'Failed: ' + (real || 'Unknown');
  }

  // "Offer sent." was printed whatever happened to the notification. It is still printed — the
  // letter IS sent and the token IS valid — but the one thing that reaches the candidate is now
  // reported separately when it did not happen.
  if (candidateNotTold) errorMsg = (errorMsg ? errorMsg + ' ' : '') + candidateNotTold;
  if (stageNotMoved) errorMsg = (errorMsg ? errorMsg + ' ' : '') + stageNotMoved;
  // Kept as its OWN pair rather than folded into successMsg/errorMsg: "the offer was issued" and
  // "the candidate has it in their inbox" are different facts, and this page's history is entirely
  // about the second one being assumed from the first.
  if (letterSendOk) successMsg = (successMsg ? successMsg + ' ' : '') + letterSendOk;
  if (letterSendErr) errorMsg = (errorMsg ? errorMsg + ' ' : '') + letterSendErr;

  const refresh = await db.select().from(offerLetters).where(eq(offerLetters.applicationId, id)).limit(1);
  existingOffer = refresh.length > 0 ? refresh[0] : null;
}

// The covering message the composer opens with, so the operator is never handed a blank box on the
// one screen where the wording matters most.
//
// IT TELLS THEM HOW TO GET IN, and that is not padding. /portal/offer/[token].astro:16 redirects
// anyone who is not signed in to /portal/login, and an owner check refuses the token to anybody
// else - so the link in this email is NOT self-authenticating. For a candidate whose account was
// created seconds ago by this very page, the only credential is a temporary password printed once
// on the admin's screen. An email that just says "here is your offer, click here" walks that person
// into a login wall with nothing to type. The reset link works because the account already exists
// under their address, so it is the one route they can complete alone.
//
// {{tokens}} rather than values: the composer substitutes them server-side after sanitising.
const offerNoteDefault = [
  '<p>Dear {{name}},</p>',
  '<p>We are glad to offer you the position of {{role}}. Your offer letter is ready and is waiting '
    + 'for you to read and sign.</p>',
  '<p>Open it using the button below and sign in with this email address. If you have not set a '
    + 'password yet, choose &ldquo;Forgot password&rdquo; on the sign-in page and we will send you a '
    + 'link to set one.</p>',
  '<p>The letter carries the reference {{ref}} and is dated {{date}}. Please read it in full before '
    + 'signing, and reply to this message if anything in it is not what you expected.</p>',
  '<p>{{signatory}}<br/>EduRankAI People Operations</p>',
].join(String.fromCharCode(10));

const currentOffer = existingOffer;
const shortId = id.substring(0, 8).toUpperCase();
const fullName = ((app.firstName || '') + ' ' + (app.lastName || '')).trim();
const defaultRef = 'ERA-2026-' + shortId.substring(0, 6);

// The work modes this candidate's engagement may actually be offered. Declared here, above the
// form that renders it: a const is not hoisted, and this page's POST handler runs first.
const offerWorkModes = allowedWorkModes(app.engagementType, app.level).map(workModeTitle);
const offerWorkModeNote = offerWorkModes.length > 1
  ? 'On site, or hybrid by arrangement. Internships and apprenticeships only. Remote is not offered.'
  : 'Permanent roles are on site. Hybrid is available on internships and apprenticeships only.';

const fallbackDefaults = {
  candidateName: fullName,
  candidateEmail: app.email,
  candidatePhone: app.phone || '',
  candidateCity: app.city || '',
  roleTitle: app.roleTitleSnapshot || '',
  department: app.departmentSnapshot || '',
  employmentType: app.engagementType || 'Internship',
  // On site unless this is an internship or apprenticeship, where hybrid may be selected below.
  workMode: workModeTitle(resolveWorkMode(app.engagementType, app.level, null)),
  duration: app.level === 'Intern' ? '3 Months' : '12 Months',
  // From src/lib/engagement-policy.ts, resolved per level. This box used to default every intern
  // to "2.5 hrs/day, 5 days/week" — a figure that appears nowhere in the published internship
  // policy, which is six days and about 40 hours of TOTAL ENGAGEMENT — and every non-intern to the
  // bare word "Full-time", which tells a Chief Officer nothing at all about what they owe.
  hoursCommitment: shortCommitment(resolveEngagementPolicy({
    level: app.level,
    engagementType: app.engagementType,
    roleTitle: app.roleTitleSnapshot,
  })),
  // app.compensation is the CANDIDATE'S OWN EXPECTED CTC (schema.ts:180, written by apply/step-5
  // from a field placeheld "e.g. 25 LPA INR"), so it may never reach a trainee offer: the old
  // one-field level test missed 'Intern' rows stored with engagementType 'Full-Time', and the
  // internship template then printed "This internship carries a stipend of 25 LPA INR".
  compensation: offerCompensationFor(payRole, app.compensation || 'To be discussed'),
  reportingTo: '',
  // THE DATE ON THE OFFER, CUT IN THE WRONG CALENDAR. `new Date().toISOString()` is the UTC day on a
  // UTC server whose candidates and signatories are in IST, so between 00:00 and 05:29 IST this
  // opened - and, once saved, PRINTED on the letter - with YESTERDAY's date, and the response
  // deadline, expiry and joining date are all read against it. civilToday() is the Asia/Kolkata
  // civil date, the same repair /admin/finance/invoices already carries.
  offerDate: civilToday(),
  joiningDate: '',
  expiryDate: '',
  responseDeadline: '',
  signatoryName: user.name || 'Siddharth Prasad',
  signatoryTitle: 'Founder & CEO',
  customNote: '',
  // No template is requested by default. The letter is written from the agreed fields
  // (src/lib/offer-templates.ts decides); nothing here pre-selects a seniority for anyone.
  templateType: '',
  includeFounderRemark: false
};

const defaults: any = currentOffer && currentOffer.content ? currentOffer.content : fallbackDefaults;
const refNum = (currentOffer && currentOffer.refNumber) ? currentOffer.refNumber : defaultRef;
const isWithdrawn = currentOffer && currentOffer.status === 'withdrawn';
const isSigned = currentOffer && currentOffer.status === 'signed';
const isDeclined = currentOffer && currentOffer.status === 'declined';

// Two independent milestones surfaced as status:
//  1. Offer extension - the application stage ('offer' or 'hired')
//  2. Offer letter    - whether the formal letter exists and its sign state
const offerExtended = app.status === 'offer' || app.status === 'hired';
const STAGE_LABELS: Record<string, string> = {
  submitted: 'Submitted', reviewing: 'Under review', task_sent: 'Task sent',
  interview: 'Interview', offer: 'Offer extended', hired: 'Hired',
  rejected: 'Closed', withdrawn: 'Withdrawn'
};
const stageLabel = STAGE_LABELS[app.status] || app.status;
// THE CLOCK, AND THE STATUS LINE THAT USED TO IGNORE IT.
//
// This read "Sent - awaiting signature" for an offer whose expiry had passed a fortnight earlier —
// the row said `sent`, and nothing on this side ever compared a date. offerClock() reads the same
// two columns the candidate's page has always counted down, so the two surfaces can no longer
// disagree about whether an offer is still open.
const clock = offerClock(currentOffer as any, civilToday());
const letterStatusLabel = !currentOffer ? 'Not sent'
  : isSigned ? 'Signed by candidate'
  : isWithdrawn ? 'Revoked'
  : isDeclined ? 'Declined'
  : clock.state === 'expired' ? 'Expired - no longer signable'
  : clock.state === 'overdue' ? 'Sent - reply overdue'
  : 'Sent - awaiting signature';

// Colour for the clock line. Kept out of JSX because a conditional chain that long is unreadable
// inline, and .astro will not take a typed Record here.
const clockTone = clock.state === 'expired' || clock.state === 'overdue' ? '#f87171'
  : clock.state === 'due_soon' ? '#fbbf24'
  : clock.state === 'signed' ? '#4ade80'
  : '#9aa0aa';
---
<AdminLayout title="Offer Letter">

  <div class="mb-4">
    <a href={'/admin/applications/' + id} class="text-[0.78rem] text-white/50 hover:text-white">&larr; Back to application</a>
  </div>

  {errorMsg && <div class="bg-red-500/10 border border-red-500/30 text-red-300 rounded-lg p-3 mb-4 text-[0.85rem]">{errorMsg}</div>}
  {successMsg && <div class="bg-leaf-bg/20 border border-leaf-border/50 text-leaf rounded-lg p-3 mb-4 text-[0.85rem]">{successMsg}</div>}
  {/*
    The sanitiser's report. It was being assigned and rendered nowhere, which meant an operator
    could paste something into the covering message, have part of it removed on the way out, and
    never learn that the copy the candidate received differs from the one they wrote. Shown the way
    /admin/hr/recommendation.astro shows it, so the two desks answer the same question the same way.
  */}
  {letterSendRemoved.length > 0 && (
    <div class="bg-gold-bg/20 border border-gold-border/50 text-gold-deep rounded-lg p-3 mb-4 text-[0.82rem] leading-relaxed">
      Some markup was removed from the covering message before sending, so the emailed copy is not
      byte-identical to what you wrote: {letterSendRemoved.map((x) => x.name).join(', ')}.
    </div>
  )}

  <div class="mb-5 pb-4 border-b border-white/8">
    <p class="font-mono text-[0.7rem] text-white/40">{shortId}</p>
    <h1 class="font-display text-[1.6rem] font-semibold text-white">Offer Letter</h1>
    <p class="text-[0.85rem] text-white/60 mt-1">For <strong class="text-white">{fullName}</strong> &middot; {app.roleTitleSnapshot}</p>
  </div>

  <!-- DUAL STATUS PANEL: offer extension + offer letter, always visible -->
  <div class="mb-5 grid grid-cols-1 md:grid-cols-2 gap-3">
    <!-- Milestone 1: offer extension (application stage) -->
    <div class={'p-4 rounded-xl border ' + (offerExtended ? 'bg-leaf-bg/20 border-leaf-border/50' : 'bg-white/5 border-white/10')}>
      <p class="text-[0.62rem] font-mono uppercase tracking-wider font-bold mb-1 text-white/50">Offer extension</p>
      <div class="flex items-center gap-2">
        <span class={'inline-block w-2 h-2 rounded-full ' + (offerExtended ? 'bg-leaf' : 'bg-white/30')}></span>
        <p class="text-[0.95rem] font-semibold text-white">{offerExtended ? 'Extended' : 'Not yet extended'}</p>
      </div>
      <p class="text-[0.74rem] text-white/55 mt-1">Application stage: <strong class="text-white/80">{stageLabel}</strong></p>
      {!offerExtended && (
        <form method="POST" class="mt-3">
          <input type="hidden" name="action" value="extend_offer" />
          <button type="submit" class="bg-leaf/20 hover:bg-leaf/30 border border-leaf-border/50 text-leaf font-semibold py-2 px-4 rounded-lg text-[0.82rem]">Confirm offer extension</button>
        </form>
      )}
    </div>

    <!-- Milestone 2: offer letter (document) -->
    <div class={'p-4 rounded-xl border ' + (isSigned ? 'bg-leaf-bg/20 border-leaf-border/50' : (isWithdrawn || isDeclined) ? 'bg-red-500/10 border-red-500/30' : currentOffer ? 'bg-burn-pale/20 border-burn-dim/50' : 'bg-white/5 border-white/10')}>
      <p class="text-[0.62rem] font-mono uppercase tracking-wider font-bold mb-1 text-white/50">Offer letter</p>
      <div class="flex items-center gap-2">
        <span class={'inline-block w-2 h-2 rounded-full ' + (isSigned ? 'bg-leaf' : (isWithdrawn || isDeclined) ? 'bg-red-400' : currentOffer ? 'bg-burn' : 'bg-white/30')}></span>
        <p class="text-[0.95rem] font-semibold text-white">{letterStatusLabel}</p>
      </div>
      {currentOffer ? (
        <>
          <p class="text-[0.74rem] text-white/55 mt-1">Ref: {currentOffer.refNumber} &middot; Hash: {currentOffer.integrityHash}</p>

          {/* THE CLOCK. Server-rendered from the civil date in Asia/Kolkata, then kept honest by the
              script at the foot of this page: a tab left open overnight used to keep showing
              yesterday's figure, which is the one moment the number matters. */}
          <p
            class="text-[0.78rem] mt-2 leading-relaxed"
            style={'color:' + clockTone + ';'}
            data-offer-clock
            data-deadline={clock.responseDeadline || ''}
            data-expiry={clock.expiryDate || ''}
            data-state={clock.state}
          >{clock.sentence}</p>

          <div class="flex gap-3 mt-2">
            <a href={'/portal/offer/' + currentOffer.token} target="_blank" class="text-[0.76rem] text-burn hover:underline font-mono">Applicant link &rarr;</a>
            <a href={'/offer/verify/' + currentOffer.token} target="_blank" class="text-[0.76rem] text-sky hover:underline font-mono">Public verify &rarr;</a>
          </div>

          {/* EMAIL IT. One click, from the same panel that holds the link — because the link being
              on this screen and the candidate having it are two different things, and until now
              only the first one ever happened. */}
          {currentOffer.status !== 'draft' && (
            <details class="mt-3 border-t border-white/10 pt-3">
              <summary class="text-[0.78rem] text-burn cursor-pointer select-none">Email this offer to the candidate</summary>
              <form method="POST" class="mt-2">
                <input type="hidden" name="action" value="email_offer" />
                <label class="block text-[0.7rem] font-semibold uppercase tracking-wide text-white/55 mb-1.5" for="offerSendTo">Send to</label>
                <input
                  id="offerSendTo"
                  name="recipientEmail"
                  type="email"
                  value={currentOffer.candidateEmail || ''}
                  class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-white text-[0.85rem] mb-3"
                />
                <RichMessageComposer
                  id="offer-note"
                  name="noteHtml"
                  label="Your message"
                  hint="Written above the link. Leave it empty and a plain covering note is used instead."
                  tokens={LETTER_TOKENS}
                  value={'<p>Dear {{name}},</p><p>We are glad to offer you the role of {{role}}. Your offer letter is linked below &mdash; please read it in full and sign it there.</p>'}
                />
                <button type="submit" class="mt-3 w-full bg-burn hover:bg-burn/90 text-white font-semibold py-2 px-4 rounded-lg text-[0.85rem]">Send the offer by email</button>
                <p class="text-[0.7rem] text-white/45 mt-2 leading-relaxed">The message links to the signable copy. Nothing is attached, so there is no second version of the letter in circulation.</p>
              </form>
            </details>
          )}

          {/* REVOKE. The handler for this has existed, complete and tested against its own failure
              modes, since the page was written — and no form ever submitted it, so no letter on this
              product could be taken back. It is a disclosure rather than a bare button because it
              notifies the candidate the moment it is pressed, and it demands a reason because
              "withdrawn, no reason recorded" is the version nobody can defend later. */}
          {clock.canRevoke && (
            <details class="mt-3 border-t border-white/10 pt-3">
              <summary class="text-[0.76rem] text-red-300 cursor-pointer select-none">
                {clock.revokeIsRescission ? 'Revoke this signed offer' : 'Revoke this offer letter'}
              </summary>
              <div class="mt-2">
                <p class="text-[0.73rem] text-white/55 leading-relaxed mb-2">
                  {clock.revokeIsRescission
                    ? 'The candidate has already signed. Revoking now withdraws an offer they have accepted and may have acted on, so the reason below is the record of why.'
                    : 'The candidate is told immediately, with the reason you give. The application stage is not changed, and a corrected letter can still be issued from the form below.'}
                </p>
                {/* NO confirm() ON THIS FORM, DELIBERATELY.
                    Admin pages open inside the side panel in public/era/era-sidepanel.js, which
                    frames them with sandbox="allow-same-origin allow-scripts allow-forms
                    allow-popups". `allow-modals` is not among them, so the browser IGNORES
                    window.confirm() there and RETURNS FALSE. Any form guarded by
                    onsubmit="return confirm(...)" therefore cancels its own submit, silently, with
                    no dialog and no error — which is exactly what this button did when it was
                    pressed with a reason already typed into it.
                    The guard here is native HTML instead: a required reason and a required
                    acknowledgement, both enforced by the browser with no script at all. That is a
                    stronger check than a modal anyway — a modal is one reflexive click, and it can
                    be suppressed by the browser a second time round. */}
                <form method="POST">
                  <input type="hidden" name="action" value="withdraw" />
                  <textarea
                    name="reason"
                    required
                    rows="2"
                    maxlength="500"
                    placeholder="Why is this being revoked? The candidate sees this."
                    class="w-full bg-black/30 border border-white/15 rounded-lg p-2 text-[0.8rem] text-white"
                  ></textarea>
                  <label class="flex items-start gap-2 mt-2 text-[0.73rem] text-white/65 leading-snug cursor-pointer">
                    <input type="checkbox" name="ack" required class="mt-0.5 accent-red-500" />
                    <span>
                      {clock.revokeIsRescission
                        ? 'I understand this withdraws an offer the candidate has already signed, and that they are notified now with the reason above.'
                        : 'I understand the candidate is notified now, with the reason above.'}
                    </span>
                  </label>
                  <button type="submit" class="mt-2 bg-red-500/15 hover:bg-red-500/25 border border-red-500/40 text-red-300 font-semibold py-2 px-4 rounded-lg text-[0.8rem]">
                    Revoke and notify the candidate
                  </button>
                </form>
              </div>
            </details>
          )}
        </>
      ) : (
        <p class="text-[0.74rem] text-white/55 mt-1">Fill the form below and send the formal letter.</p>
      )}
    </div>
  </div>

  <form method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <input type="hidden" name="action" value="generate" />

    <div class="lg:col-span-2 flex flex-col gap-4">

      <div class="bg-white/5 border border-white/10 rounded-xl p-5">
        <h2 class="font-display text-[1rem] font-semibold text-white mb-3">Candidate</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div><label class="ofl">Name *</label><input type="text" name="candidateName" required value={defaults.candidateName} class="ofi" /></div>
          <div><label class="ofl">Email *</label><input type="email" name="candidateEmail" required value={defaults.candidateEmail} class="ofi" /></div>
          <div><label class="ofl">Phone</label><input type="text" name="candidatePhone" value={defaults.candidatePhone} class="ofi" /></div>
          <div><label class="ofl">City</label><input type="text" name="candidateCity" value={defaults.candidateCity} class="ofi" /></div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-5">
        <h2 class="font-display text-[1rem] font-semibold text-white mb-3">Role &amp; Terms</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div><label class="ofl">Role *</label><input type="text" name="roleTitle" required value={defaults.roleTitle} class="ofi" /></div>
          <div><label class="ofl">Department</label><input type="text" name="department" value={defaults.department} class="ofi" /></div>
          <div><label class="ofl">Employment Type</label>
            <select name="employmentType" class="ofi">
              <option value="Internship" selected={defaults.employmentType === 'Internship'}>Internship</option>
              <option value="Apprenticeship" selected={defaults.employmentType === 'Apprenticeship'}>Apprenticeship</option>
              <option value="Full-Time" selected={defaults.employmentType === 'Full-Time'}>Full-Time</option>
              <option value="Contract" selected={defaults.employmentType === 'Contract'}>Contract</option>
              <option value="Part-Time" selected={defaults.employmentType === 'Part-Time'}>Part-Time</option>
            </select>
          </div>
          <div><label class="ofl">Work Mode</label>
            <select name="workMode" class="ofi">
              {offerWorkModes.map((m) => (
                <option value={m} selected={defaults.workMode === m}>{m}</option>
              ))}
            </select>
            <p class="text-[0.68rem] text-white/40 mt-1">{offerWorkModeNote}</p>
          </div>
          <div><label class="ofl">Duration</label><input type="text" name="duration" value={defaults.duration} class="ofi" /></div>
          <div><label class="ofl">Hours</label><input type="text" name="hoursCommitment" value={defaults.hoursCommitment} class="ofi" /></div>
          <div class="md:col-span-2">
            <label class="ofl">Compensation</label>
            <input type="text" id="compInput" name="compensation" value={defaults.compensation} class="ofi" />
            <div class="flex flex-wrap gap-1.5 mt-2">
              {/* THESE PRESETS NO LONGER STATE HOURS. They carried "(2.5 hrs/day, 5 days/week)"
                  inside the COMPENSATION sentence, which put a third working-time figure into the
                  candidate's letter — one that disagreed with the Hours field beside it and with
                  the published internship policy. Compensation states money; hours come from the
                  Hours field, which is filled from src/lib/engagement-policy.ts. */}
              <button type="button" class="comp-preset" data-comp="Unpaid during the internship. USD 1,000 on conversion to full-time upon successful completion of the project and meeting the eligibility criteria.">Product intern</button>
              <button type="button" class="comp-preset" data-comp="Unpaid during the internship. A one-time reward of USD 550 on successful completion of the internship and meeting the eligibility criteria.">Other intern (unpaid)</button>
              <button type="button" class="comp-preset" data-comp="Market-leading, top-competitive compensation (finalised at offer).">Full-time / contract / freelance</button>
            </div>
            <p class="text-[0.68rem] text-white/40 mt-1.5">Quick-fill the standard compensation language, then edit if needed. Working hours are a separate field &mdash; do not restate them here.</p>
          </div>
          <div><label class="ofl">Reporting To</label><input type="text" name="reportingTo" value={defaults.reportingTo} placeholder="Head of AI / Founder" class="ofi" /></div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-5">
        <h2 class="font-display text-[1rem] font-semibold text-white mb-3">Dates</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div><label class="ofl">Offer Date</label><input type="date" name="offerDate" value={defaults.offerDate} class="ofi" /></div>
          <div><label class="ofl">Joining Date</label><input type="date" name="joiningDate" value={defaults.joiningDate} class="ofi" /></div>
          <div><label class="ofl">Response Deadline</label><input type="date" name="responseDeadline" value={defaults.responseDeadline} class="ofi" /></div>
          <div><label class="ofl">Offer Expiry</label><input type="date" name="expiryDate" value={defaults.expiryDate} class="ofi" /></div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-5">
        <h2 class="font-display text-[1rem] font-semibold text-white mb-3">Signatory</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div><label class="ofl">Name *</label><input type="text" name="signatoryName" required value={defaults.signatoryName} class="ofi" /></div>
          <div><label class="ofl">Title</label><input type="text" name="signatoryTitle" value={defaults.signatoryTitle} class="ofi" /></div>
          <div><label class="ofl">Ref Number</label><input type="text" name="refNumber" value={refNum} class="ofi" /></div>
          <div class="md:col-span-2"><label class="ofl">Custom Note (optional)</label><textarea name="customNote" rows="3" class="ofi resize-y">{defaults.customNote || ''}</textarea></div>
          <div class="md:col-span-2">
            <label class="flex items-start gap-2.5 cursor-pointer bg-white/5 border border-white/10 rounded-lg p-3">
              <input type="checkbox" name="includeFounderRemark" value="1" checked={defaults.includeFounderRemark === true} class="mt-0.5 w-4 h-4 accent-[#FF4F00] shrink-0" />
              <span class="text-[0.82rem] text-white/80 leading-relaxed">Include the Founder's wellbeing remark (the note on daily fitness, meditation and scripture). Off by default &mdash; tick only for candidates you know would welcome it.</span>
            </label>
          </div>
        </div>
      </div>

      <details class="mb-5 rounded-lg border border-ink/15 bg-white/[0.02] p-4">
        <summary class="cursor-pointer text-[0.85rem] text-white/70">The message that goes with it</summary>
        <p class="mt-2 mb-3 text-[0.78rem] leading-relaxed text-white/50">
          Sent with the offer letter when it is issued. Nothing is emailed on a draft save, or when
          you update a letter that has already gone out. The letter itself is not attached: the
          candidate opens the signable copy on the site, which is the version that can be signed.
        </p>
        <RichMessageComposer
          id="offer-note"
          name="noteHtml"
          label="Covering message"
          hint="Type it, or paste formatted text or HTML - the candidate sees normal formatted text, not tags."
          tokens={LETTER_TOKENS}
          value={offerNoteDefault}
        />
      </details>

      <div class="flex gap-3 flex-wrap">
        <button type="submit" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 px-6 rounded-lg text-[0.95rem]">
          {!currentOffer ? 'Generate & send offer letter' : (currentOffer.status === 'draft' ? 'Generate & send offer letter' : 'Update offer letter')}
        </button>
        {(!currentOffer || currentOffer.status === 'draft') && (
          <button type="submit" name="saveDraft" value="1" class="bg-white/5 hover:bg-white/10 text-ink border border-ink/20 font-semibold py-3 px-6 rounded-lg text-[0.95rem]">
            Save as draft
          </button>
        )}
        <a href={'/admin/offer/blank?from=' + id} class="bg-ink hover:bg-ink/80 text-white border border-white/20 font-semibold py-3 px-6 rounded-lg text-[0.95rem] no-underline inline-flex items-center">Preview / Download PDF &rarr;</a>
      </div>
    </div>

    <div class="lg:col-span-1">
      <div class="bg-white/5 border border-white/10 rounded-xl p-5 sticky top-4">
        <h3 class="font-display text-[1rem] font-semibold text-white mb-3">How this works</h3>
        <ol class="space-y-2 text-[0.82rem] text-white/70 leading-relaxed list-decimal pl-5">
          <li>Fill in offer details on the left.</li>
          <li>Click <strong class="text-white">Generate &amp; Send Offer</strong> to create a record.</li>
          <li>System creates a secure link at <code class="text-[0.72rem] bg-white/10 px-1 rounded">/portal/offer/[token]</code></li>
          <li>Applicant reviews and signs digitally.</li>
          <li>On signing, application status auto-changes to <strong class="text-leaf">hired</strong>.</li>
          <li>Use <strong>Preview / Download PDF</strong> for a standalone PDF version.</li>
        </ol>
      </div>
    </div>
  </form>

  <style>
    .ofl { display:block;font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-bottom:6px; }
    .ofi { width:100%;padding:9px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;font-size:13px;font-family:inherit;outline:none;transition:border-color 0.15s; }
    .ofi:focus { border-color:#FF4F00; }
    textarea.ofi { resize:vertical; }
    .ofi option { background:#0a0a0c; }
    .comp-preset { background:rgba(255,79,0,0.1);border:1px solid rgba(255,79,0,0.35);color:#FF7040;font-size:11px;font-weight:600;padding:4px 10px;border-radius:100px;cursor:pointer; }
    .comp-preset:hover { background:rgba(255,79,0,0.2); }
  </style>

  <script is:inline>
    document.querySelectorAll('.comp-preset').forEach(function(b) {
      b.addEventListener('click', function() {
        var inp = document.getElementById('compInput');
        if (inp) { inp.value = b.getAttribute('data-comp'); inp.focus(); }
      });
    });

    // -------------------------------------------------------------------------------------------
    // KEEP THE CLOCK HONEST ON A TAB THAT STAYS OPEN.
    //
    // The sentence above is rendered on the server from today's civil date in Asia/Kolkata. Admin
    // tabs on this product stay open for days — the applications list refreshes itself every five
    // minutes and this page does not — so "expires in 1 day" would still read "expires in 1 day"
    // the morning after it expired. That is the single moment the number has to be right.
    //
    // This recomputes from the same two dates, in the same zone, and rewrites the line when the
    // civil day changes underneath it. It never invents a state the server did not: a signed,
    // revoked or declined offer is left exactly as rendered, because those do not move with time.
    (function () {
      var el = document.querySelector('[data-offer-clock]');
      if (!el) return;
      var frozen = ['signed', 'withdrawn', 'declined', 'draft', 'none'];
      if (frozen.indexOf(el.getAttribute('data-state') || '') !== -1) return;

      function istToday() {
        var p = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit'
        }).format(new Date());
        return p;   // en-CA formats as YYYY-MM-DD
      }
      function days(from, to) {
        if (!from || !to) return null;
        var f = from.split('-').map(Number), t = to.split('-').map(Number);
        return Math.round((Date.UTC(t[0], t[1] - 1, t[2]) - Date.UTC(f[0], f[1] - 1, f[2])) / 86400000);
      }
      function phrase(n) {
        if (n === 0) return 'today';
        if (n === 1) return 'tomorrow';
        if (n === -1) return 'yesterday';
        return n > 0 ? 'in ' + n + ' days' : Math.abs(n) + ' days ago';
      }

      var startedOn = istToday();
      setInterval(function () {
        var today = istToday();
        if (today === startedOn) return;      // same civil day, the server line still holds
        startedOn = today;

        var deadline = el.getAttribute('data-deadline') || '';
        var expiry = el.getAttribute('data-expiry') || '';
        var dd = days(today, deadline);
        var ed = days(today, expiry);

        if (ed !== null && ed < 0) {
          el.textContent = 'This offer expired ' + phrase(ed) + ' (' + expiry + '). The candidate can no longer sign it. '
            + 'Reload for the full picture.';
          el.style.color = '#f87171';
          return;
        }
        if (dd !== null && dd < 0) {
          el.textContent = 'The reply was due ' + phrase(dd) + ' (' + deadline + ') and none has come.';
          el.style.color = '#f87171';
          return;
        }
        var soonest = null;
        if (dd !== null) soonest = dd;
        if (ed !== null && (soonest === null || ed < soonest)) soonest = ed;
        if (soonest === null) return;
        var isDeadline = dd !== null && dd === soonest;
        el.textContent = (isDeadline ? 'A reply is due ' : 'It expires ') + phrase(soonest)
          + ' (' + (isDeadline ? deadline : expiry) + ').';
        el.style.color = soonest <= 3 ? '#fbbf24' : '#9aa0aa';
      }, 60000);
    })();
  </script>
</AdminLayout>