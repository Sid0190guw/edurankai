---
// /admin/mentors — the only surface that can put a mentor on the marketplace, and the only one that
// can answer a booking request.
//
// WHY IT HAD TO EXIST. src/lib/mentors.ts held createMentor() and bookSession() and nothing in the
// repository called either. /portal/mentors listed `mentors` — a table with no INSERT anywhere — so
// the marketplace could only ever render an empty grid whose empty state blamed the learner's filter.
// A booking screen with no way to add a mentor is not a marketplace; it is a picture of one.
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import {
  listMentors, createMentor, setMentorVerified, setMentorActive,
  pendingSessions, setSessionStatus, SUBJECTS, LANGUAGES,
} from '@/lib/mentors';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
// Authorization from the capability matrix, never from a users.role string comparison.
if (!can(user as any, 'admin.access')) return Astro.redirect('/portal');
const mayEdit = can(user as any, 'content.edit');

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  if (!mayEdit) {
    errMsg = 'Your account can read this console but not change it.';
  } else {
    const fd = await Astro.request.formData();
    const action = String(fd.get('action') || '');

    if (action === 'create') {
      const res = await createMentor({
        fullName: String(fd.get('full_name') || ''),
        title: String(fd.get('title') || ''),
        bio: String(fd.get('bio') || ''),
        subjects: fd.getAll('subjects').map(String),
        languages: fd.getAll('languages').map(String),
        yearsExperience: fd.get('years') ? Number(fd.get('years')) : null,
        rate: Number(fd.get('rate') || 0),
        availability: String(fd.get('availability') || ''),
        verified: false,
      });
      if (res.ok) okMsg = 'Mentor created at /portal/mentors/' + res.slug + '. They are NOT on the public grid until you verify them below.';
      else errMsg = res.error;

    } else if (action === 'verify' || action === 'unverify') {
      const res = await setMentorVerified(String(fd.get('mentor_id') || ''), action === 'verify', String(fd.get('notes') || ''));
      if (res.ok) okMsg = action === 'verify' ? 'Verified. This mentor is now visible to learners.' : 'Verification withdrawn. This mentor is off the public grid.';
      else errMsg = res.error;

    } else if (action === 'activate' || action === 'deactivate') {
      const res = await setMentorActive(String(fd.get('mentor_id') || ''), action === 'activate');
      if (res.ok) okMsg = action === 'activate' ? 'Mentor reactivated.' : 'Mentor paused. Existing sessions are untouched.';
      else errMsg = res.error;

    } else if (action === 'session') {
      const res = await setSessionStatus(
        String(fd.get('session_id') || ''),
        String(fd.get('status') || '') as any,
        { meetLink: String(fd.get('meet_link') || '') },
      );
      if (!res.ok) errMsg = res.error;
      else if (!res.changed) okMsg = 'That session was already in this state — nothing was changed, and no counter was moved.';
      else okMsg = 'Session updated.';
    }
  }
}

const mentorsRes = await listMentors({ includeUnlisted: true });
const sessionsRes = await pendingSessions(150);

function fmt(d: string | null): string {
  if (!d) return 'No time set';
  try {
    return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  } catch { return String(d); }
}
---
<AdminLayout title="Mentors" activeNav="mentors">
  <div style="max-width:1100px;margin:0 auto;padding:26px 20px 80px;">
    <p style="font-family:ui-monospace,monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#FF4F00;font-weight:700;margin:0 0 6px;">Marketplace</p>
    <h1 style="font-size:28px;font-weight:700;margin:0 0 6px;">Mentors and booking requests</h1>
    <p style="font-size:14px;color:#6b6455;margin:0 0 22px;max-width:70ch;line-height:1.6;">
      A mentor created here is invisible to learners until it is verified. Verification requires a written
      note saying what was checked, because a verification nobody can audit is not one. Confirming a booking
      requires a meeting link, so no learner is told a session is confirmed with no way to join it.
    </p>

    {okMsg && <div style="background:#EBF5EF;border:1px solid #1A6B35;border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">{okMsg}</div>}
    {errMsg && <div style="background:#FFF3EE;border:1px solid #FF4F00;border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">{errMsg}</div>}
    {!mayEdit && <div style="background:#F3EFE8;border:1px solid rgba(14,11,8,0.12);border-radius:10px;padding:12px 16px;margin-bottom:18px;font-size:14px;">Read-only: your account does not hold content.edit, so the forms below will refuse.</div>}

    <!-- ===================== booking requests ===================== -->
    <section style="background:#fff;border:1px solid rgba(14,11,8,0.10);border-radius:14px;padding:20px;margin-bottom:22px;">
      <h2 style="font-size:18px;font-weight:700;margin:0 0 14px;">Booking requests</h2>

      {!sessionsRes.ok ? (
        <p style="font-size:14px;color:#2E2520;line-height:1.6;margin:0;">
          The booking table could not be read, so this is <strong>not</strong> a statement that there are no
          requests waiting. A learner may be waiting on a reply you cannot see.
          <span style="display:block;font-family:ui-monospace,monospace;font-size:12px;color:#7A6F68;margin-top:6px;">Reason recorded: {sessionsRes.ok ? '' : sessionsRes.reason}</span>
        </p>
      ) : sessionsRes.value.length === 0 ? (
        <p style="font-size:14px;color:#7A6F68;margin:0;">No session has been requested yet.</p>
      ) : (
        <div style="display:flex;flex-direction:column;gap:10px;">
          {sessionsRes.value.map((s) => (
            <div style="border:1px solid rgba(14,11,8,0.10);border-radius:10px;padding:14px;">
              <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                <div>
                  <p style="font-size:15px;font-weight:600;margin:0;">{s.learnerName || 'Learner'} with {s.mentorName || 'a removed mentor'}</p>
                  <p style="font-size:12.5px;color:#7A6F68;margin:2px 0 0;">{fmt(s.scheduledAt)} · {s.durationMinutes} min · {s.currency} {(s.amountMinor / 100).toFixed(2)} · {s.status}</p>
                </div>
                <span style="font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 9px;border-radius:100px;background:#F3EFE8;align-self:flex-start;">payment {s.paymentStatus}</span>
              </div>
              {s.topic && <p style="font-size:13.5px;color:#2E2520;margin:8px 0 0;line-height:1.6;">{s.topic}</p>}

              {s.status !== 'completed' && s.status !== 'cancelled' && (
                <form method="POST" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:10px;">
                  <input type="hidden" name="action" value="session" />
                  <input type="hidden" name="session_id" value={s.id} />
                  <input type="url" name="meet_link" placeholder="Meeting link (required to confirm)" value={s.meetLink || ''}
                    style="flex:1;min-width:220px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 10px;font-size:13px;" />
                  <select name="status" style="border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 10px;font-size:13px;">
                    <option value="scheduled">Confirm</option>
                    <option value="completed">Mark completed</option>
                    <option value="cancelled">Cancel</option>
                  </select>
                  <button type="submit" style="background:#0E0B08;color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:13px;font-weight:600;cursor:pointer;">Apply</button>
                </form>
              )}
              {s.learnerRating != null && (
                <p style="font-size:12.5px;color:#7A6F68;margin:8px 0 0;">Rated {s.learnerRating}/5 by the learner{s.learnerReview ? ' — ' + s.learnerReview : ''}</p>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- ===================== create ===================== -->
    <section style="background:#fff;border:1px solid rgba(14,11,8,0.10);border-radius:14px;padding:20px;margin-bottom:22px;">
      <h2 style="font-size:18px;font-weight:700;margin:0 0 14px;">Add a mentor</h2>
      <form method="POST" style="display:grid;gap:12px;">
        <input type="hidden" name="action" value="create" />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
          <label style="font-size:13px;">Full name
            <input type="text" name="full_name" required maxlength="200" style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;" />
          </label>
          <label style="font-size:13px;">Headline
            <input type="text" name="title" maxlength="300" placeholder="e.g. Physics, twelve years of teaching" style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;" />
          </label>
          <label style="font-size:13px;">Rate (CHF per hour)
            <input type="number" name="rate" min="0" max="100000" step="1" required style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;" />
          </label>
          <label style="font-size:13px;">Years of experience
            <input type="number" name="years" min="0" max="80" style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;" />
          </label>
        </div>
        <label style="font-size:13px;">Biography
          <textarea name="bio" rows="3" maxlength="4000" style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;"></textarea>
        </label>
        <label style="font-size:13px;">Usual availability
          <input type="text" name="availability" maxlength="2000" placeholder="e.g. Weekday evenings, 18:00 to 21:00 IST" style="display:block;width:100%;margin-top:4px;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:8px 10px;font-size:14px;" />
        </label>
        <fieldset style="border:1px solid rgba(14,11,8,0.10);border-radius:10px;padding:10px 12px;">
          <legend style="font-size:12px;color:#7A6F68;padding:0 4px;">Subjects (at least one — a mentor with none matches no filter)</legend>
          <div style="display:flex;flex-wrap:wrap;gap:10px;">
            {SUBJECTS.map((s) => (
              <label style="font-size:12.5px;display:flex;align-items:center;gap:4px;">
                <input type="checkbox" name="subjects" value={s} />{s.replace(/-/g, ' ')}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset style="border:1px solid rgba(14,11,8,0.10);border-radius:10px;padding:10px 12px;">
          <legend style="font-size:12px;color:#7A6F68;padding:0 4px;">Languages (at least one)</legend>
          <div style="display:flex;flex-wrap:wrap;gap:10px;">
            {LANGUAGES.map((l) => (
              <label style="font-size:12.5px;display:flex;align-items:center;gap:4px;">
                <input type="checkbox" name="languages" value={l} />{l.toUpperCase()}
              </label>
            ))}
          </div>
        </fieldset>
        <div><button type="submit" style="background:#FF4F00;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-size:14px;font-weight:700;cursor:pointer;">Create mentor</button></div>
      </form>
    </section>

    <!-- ===================== roster ===================== -->
    <section style="background:#fff;border:1px solid rgba(14,11,8,0.10);border-radius:14px;padding:20px;">
      <h2 style="font-size:18px;font-weight:700;margin:0 0 14px;">Roster</h2>

      {!mentorsRes.ok ? (
        <p style="font-size:14px;color:#2E2520;line-height:1.6;margin:0;">
          The mentor table could not be read. This page cannot tell you whether the roster is empty or
          whether the database is unreachable, so it is saying which one it actually knows: neither.
          <span style="display:block;font-family:ui-monospace,monospace;font-size:12px;color:#7A6F68;margin-top:6px;">Reason recorded: {mentorsRes.ok ? '' : mentorsRes.reason}</span>
        </p>
      ) : mentorsRes.value.length === 0 ? (
        <p style="font-size:14px;color:#7A6F68;margin:0;">No mentor has been created yet. Use the form above; the public grid stays empty until one is verified.</p>
      ) : (
        <div style="display:flex;flex-direction:column;gap:10px;">
          {mentorsRes.value.map((m) => (
            <div style="border:1px solid rgba(14,11,8,0.10);border-radius:10px;padding:14px;">
              <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                <div>
                  <p style="font-size:15px;font-weight:600;margin:0;">
                    <a href={'/portal/mentors/' + m.slug} style="color:inherit;">{m.fullName}</a>
                  </p>
                  <p style="font-size:12.5px;color:#7A6F68;margin:2px 0 0;">
                    {m.title || 'No headline'} · CHF {m.rate.toFixed(0)}/h · {m.sessionsCompleted} completed ·
                    {m.ratingAvg == null ? ' not rated yet' : ' ' + m.ratingAvg.toFixed(1) + ' from ' + m.ratingCount}
                  </p>
                </div>
                <div style="display:flex;gap:6px;align-items:flex-start;">
                  <span style={'font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 9px;border-radius:100px;' + (m.verified ? 'background:#EBF5EF;color:#1A6B35;' : 'background:#F3EFE8;color:#7A6F68;')}>{m.verified ? 'verified' : 'unverified'}</span>
                  <span style={'font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 9px;border-radius:100px;' + (m.isActive ? 'background:#EBF0FF;color:#1045BB;' : 'background:#F3EFE8;color:#7A6F68;')}>{m.isActive ? 'active' : 'paused'}</span>
                </div>
              </div>
              {m.verificationNotes && <p style="font-size:12.5px;color:#7A6F68;margin:8px 0 0;">Verification record: {m.verificationNotes}</p>}

              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
                {!m.verified ? (
                  <form method="POST" style="display:flex;gap:6px;flex:1;min-width:280px;">
                    <input type="hidden" name="action" value="verify" />
                    <input type="hidden" name="mentor_id" value={m.id} />
                    <input type="text" name="notes" required minlength="10" placeholder="What did you check? (min 10 characters)"
                      style="flex:1;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 10px;font-size:13px;" />
                    <button type="submit" style="background:#1A6B35;color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:13px;font-weight:600;cursor:pointer;">Verify</button>
                  </form>
                ) : (
                  <form method="POST">
                    <input type="hidden" name="action" value="unverify" />
                    <input type="hidden" name="mentor_id" value={m.id} />
                    <input type="hidden" name="notes" value={m.verificationNotes || ''} />
                    <button type="submit" style="background:#fff;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 14px;font-size:13px;cursor:pointer;">Withdraw verification</button>
                  </form>
                )}
                <form method="POST">
                  <input type="hidden" name="action" value={m.isActive ? 'deactivate' : 'activate'} />
                  <input type="hidden" name="mentor_id" value={m.id} />
                  <button type="submit" style="background:#fff;border:1px solid rgba(14,11,8,0.15);border-radius:8px;padding:7px 14px;font-size:13px;cursor:pointer;">{m.isActive ? 'Pause' : 'Reactivate'}</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</AdminLayout>
