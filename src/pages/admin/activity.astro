---
// The platform activity feed. Everything is recorded here; only alerts interrupt.
//
// Super admin only. This is a cross-cutting view of the whole organisation — who changed what, whose
// data was exported, which permissions moved — so it is deliberately narrower than the rest of the
// admin, which is scoped by section.
import AdminLayout from '@/layouts/AdminLayout.astro';
import { can } from '@/lib/auth/permissions';
import { listActivity, flushDigest } from '@/lib/activity-feed';

const user = Astro.locals.user!;
// audit.view — held by super_admin alone in PERMS_BY_ROLE, the same population the literal role test
// admitted. /admin/activity has no PATH_SECTION entry, so this line is the whole gate after
// canOpenAdmin() and must stay in the frontmatter, above the POST handler below.
if (!can(user as any, 'audit.view')) return Astro.redirect('/admin');

let msg = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'digest') {
    const r = await flushDigest();
    msg = r.sent ? `Digest sent covering ${r.count} activities.` : 'Nothing pending to digest.';
  }
}

const filter = String(Astro.url.searchParams.get('event') || '');
const items = await listActivity({ event: filter || undefined, limit: 300 });

// Counts by event, so the shape of the day is visible without reading every line.
const counts = new Map<string, number>();
for (const i of items) counts.set(i.event, (counts.get(i.event) || 0) + 1);
const top = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const REACH_COLOUR: Record<string, string> = { push: '#f87171', digest: '#fbbf24', 'log-only': '#6e6e78' };
const when = (s: string) => { try { return new Date(s).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }); } catch { return s; } };
---
<AdminLayout title="Activity">
  <div style="max-width:1000px;">
    <h1 style="font-family:'Fraunces',serif;font-size:26px;margin:0 0 4px;">Activity</h1>
    <p style="font-size:13px;color:#8a8a94;margin:0 0 16px;line-height:1.55;">
      Every recorded event. Only <span style="color:#f87171;">alerts</span> push a notification &mdash;
      money moving, a permission changing, data leaving. Routine activity is rolled into a digest, so
      the bell stays worth reading.
    </p>

    {msg && <div style="padding:10px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #14532d;background:rgba(20,83,45,0.2);font-size:13px;">{msg}</div>}

    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">
      <form method="POST" style="margin:0;">
        <input type="hidden" name="_action" value="digest" />
        <button type="submit" style="background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;font-size:12px;padding:7px 12px;border-radius:6px;cursor:pointer;">Send digest now</button>
      </form>
      {filter && <a href="/admin/activity" style="font-size:12px;color:#FF4F00;">Clear filter: {filter}</a>}
      <span style="font-size:11.5px;color:#6e6e78;margin-left:auto;">{items.length} shown</span>
    </div>

    {top.length > 0 && (
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;">
        {top.map(([e, n]) => (
          <a href={'/admin/activity?event=' + encodeURIComponent(e)}
             style="font-size:11px;background:#12121a;border:1px solid #2a2a30;color:#a0a0a8;padding:4px 9px;border-radius:100px;text-decoration:none;">
            {e.replace(/[._]/g, ' ')} <span style="color:#6e6e78;">{n}</span>
          </a>
        ))}
      </div>
    )}

    {items.length === 0 ? (
      <div style="border:1px solid #2a2a30;border-radius:12px;background:#0f0f14;padding:24px;text-align:center;">
        <p style="font-size:13px;color:#8a8a94;margin:0;">
          Nothing recorded yet. Events appear here once producers emit them through the event bus.
        </p>
      </div>
    ) : (
      <div style="border:1px solid #2a2a30;border-radius:12px;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
          <thead>
            <tr style="background:#12121a;">
              {['When', 'Event', 'Detail', ''].map((h) => (
                <th style="text-align:left;padding:8px 10px;font-size:9.5px;text-transform:uppercase;letter-spacing:0.08em;color:#6e6e78;font-weight:700;">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {items.map((i) => (
              <tr style="border-top:1px solid #1a1a22;">
                <td style="padding:7px 10px;color:#8a8a94;white-space:nowrap;">{when(i.createdAt)}</td>
                <td style="padding:7px 10px;color:#e8e8ee;font-family:'Geist Mono',monospace;font-size:11.5px;">{i.event}</td>
                <td style="padding:7px 10px;color:#a0a0a8;">{i.summary}</td>
                <td style="padding:7px 10px;">
                  <span style={`font-size:9px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:${REACH_COLOUR[i.reach] || '#6e6e78'};`}>{i.reach}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <p style="font-size:11.5px;color:#6e6e78;margin:16px 0 0;line-height:1.6;">
      Nothing is discarded &mdash; high-volume events are recorded without pushing, so they are here
      even when they never reached the bell. Routing lives in ROUTING in src/lib/activity-feed.ts;
      anything unlisted defaults to digest rather than push, so a new event type cannot flood the
      bell by omission.
    </p>
  </div>
</AdminLayout>
