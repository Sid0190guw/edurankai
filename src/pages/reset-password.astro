---
// /reset-password?token=... — the ONLY surface on this platform that sets a password from a
// recovery flow.
//
// It exists because the recovery endpoints used to return a freshly generated password in an HTTP
// response body to an unauthenticated caller. They no longer produce a credential at all: they mail
// a single-use, hashed, expiring, purpose-bound token (src/lib/auth/recovery.ts), and this page is
// where that token is redeemed.
//
// Order of operations matters and is deliberate:
//   GET  peeks at the token (does NOT burn it), so an expired link and a wrong link can be told
//        apart and a reload does not consume the one chance the person has.
//   POST consumes the token FIRST, atomically, and only then writes the new hash. If the write
//        somehow fails, the token is already spent — the safe direction. The reverse order would
//        let a replay set the password twice.
//
// Nothing here reads a user id, an email, or a role from the request. The token is the only thing
// that names the account.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { peekRecoveryToken, consumeRecoveryToken, causeOf } from '@/lib/auth/recovery';
import { hashPassword } from '@/lib/auth/password';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

export const prerender = false;

// Declared before the handler below — `const` is not hoisted.
const MIN_PASSWORD = 10;

const url = new URL(Astro.request.url);
let token = (url.searchParams.get('token') || '').toString();

let errorMsg = '';
let doneMsg = '';
let holderEmail: string | null = null;

if (Astro.request.method === 'POST') {
  let formToken = '';
  let pw = '';
  let pw2 = '';
  try {
    const fd = await Astro.request.formData();
    formToken = String(fd.get('token') || '');
    pw = String(fd.get('password') || '');
    pw2 = String(fd.get('password2') || '');
  } catch (e: any) {
    console.error('[reset-password] form', causeOf(e));
  }
  token = formToken || token;

  if (!token) {
    errorMsg = 'That reset link is incomplete. Request a new one.';
  } else if (pw.length < MIN_PASSWORD) {
    errorMsg = 'Choose a password of at least ' + MIN_PASSWORD + ' characters.';
  } else if (pw.length > 200) {
    errorMsg = 'That password is too long.';
  } else if (pw !== pw2) {
    errorMsg = 'The two passwords do not match.';
  } else {
    // Burn the token before anything else. Single-use is enforced by the UPDATE, not by this page.
    const holder = await consumeRecoveryToken(token, 'password-reset');
    if (!holder) {
      errorMsg = 'That reset link has expired or has already been used. Request a new one below.';
    } else if (!holder.isActive) {
      // A DEACTIVATED ACCOUNT IS NOT RECOVERABLE FROM HERE, AND THIS PAGE USED TO REACTIVATE IT.
      //
      // The UPDATE below carried `is_active = true` alongside the password. Nothing on this platform
      // ever creates a user with is_active = false — the column defaults to true in
      // src/lib/db/schema.ts and every signup path sets it explicitly — so that clause could only
      // ever undo the one thing that sets it false: offboarding, which writes it in the same
      // transaction as hr_employees.employment_status = 'exited' and reports "The account is
      // deactivated, so no sign-in method works."
      //
      // It works. An offboarded person knows their own date of birth and still holds the personal
      // mailbox on users.email, so /api/auth/forgot-password mails them a genuine one-time link;
      // opening it restored their login. Revocation that a revoked user can reverse unaided is not
      // revocation, and it was reversible with no admin involved and no audit line saying so.
      //
      // The token is already burned at this point, which is the safe direction: a refusal here does
      // not leave a live link lying in a mailbox. Nothing about the account changes.
      errorMsg = 'That account has been deactivated, so its password cannot be reset here. Email hr@edurankai.in if you think that is wrong.';
    } else {
      try {
        const hash = await hashPassword(pw);
        await db.execute(sql`
          UPDATE users SET password_hash = ${hash}, updated_at = NOW()
          WHERE id = ${holder.userId}
        `);
        // Audited. NOT swallowed into silence: if the audit row cannot be written the reset still
        // stands (the password is already changed and refusing now would strand the person), but the
        // reason is logged rather than discarded.
        try {
          const { logAudit } = await import('@/lib/audit');
          await logAudit({
            userId: holder.userId,
            action: 'auth.password.reset',
            entity: 'user',
            entityId: holder.userId,
            diff: { via: 'emailed one-time recovery link' },
          });
        } catch (e: any) {
          console.error('[reset-password] audit', causeOf(e));
        }
        // EVERY OTHER SESSION ON THAT ACCOUNT IS ENDED HERE, AND IT USED NOT TO BE.
        //
        // The reason somebody reaches this page is very often that they believe someone else has
        // their account. A password change that leaves the old sessions alive answers the wrong
        // question: sessions last 30 days and renew themselves on use (src/lib/auth/session.ts), so
        // whoever was already signed in stays signed in for a month after the credential they used
        // to get in has been replaced, and nothing on this page or in the audit says so. That is the
        // same shape as the reactivation fault this file was already repaired for once: a revocation
        // the revoked party does not notice is not a revocation.
        //
        // invalidateAllUserSessions() has existed in src/lib/auth/session.ts since sessions were
        // written and was called from NOWHERE in the codebase. This is its caller.
        //
        // Nobody loses daily access. Redemption happens from an emailed link, in a browser that is
        // signed out by definition, and the page's next sentence is already 'Sign in with it now'.
        // Failure does NOT undo the reset — the password is already changed and refusing now would
        // strand the person — but it is stated on screen, because 'your password is new and your
        // other devices are still signed in' is something the person needs to know rather than
        // something to leave in a log.
        let sessionsCleared = true;
        try {
          const { invalidateAllUserSessions } = await import('@/lib/auth/session');
          await invalidateAllUserSessions(holder.userId);
        } catch (e: any) {
          sessionsCleared = false;
          console.error('[reset-password] could not end existing sessions', causeOf(e));
        }
        holderEmail = holder.email;
        doneMsg = sessionsCleared
          ? 'Your password has been changed, and every device that was signed in has been signed out. Sign in with it now.'
          : 'Your password has been changed. We could not sign your other devices out, so if you are resetting because someone else had access, tell hr@edurankai.in. Sign in with your new password now.';
      } catch (e: any) {
        // NEVER swallowed in a credential path.
        console.error('[reset-password] write', causeOf(e));
        errorMsg = 'We could not save that password. The link has been used up — request a new one, and tell hr@edurankai.in if it happens again.';
      }
    }
  }
}

// GET (or a POST that fell through to a re-render): is the link still good?
let linkLive = false;
if (!doneMsg && token) {
  const peek = await peekRecoveryToken(token, 'password-reset');
  // A deactivated account is told so BEFORE the form is drawn, so nobody types a new password twice
  // into a page that was never going to accept it. The token is left unburned on this path — there
  // is nothing to spend it on.
  linkLive = !!peek && peek.isActive;
  if (!peek && !errorMsg) {
    errorMsg = 'That reset link has expired or has already been used. Request a new one below.';
  } else if (peek && !peek.isActive && !errorMsg) {
    errorMsg = 'That account has been deactivated, so its password cannot be reset here. Email hr@edurankai.in if you think that is wrong.';
  }
} else if (!doneMsg && !token && !errorMsg) {
  errorMsg = 'This page needs a reset link. Start from the recovery form below.';
}
---
<BaseLayout title="Set a new password" description="Redeem a one-time EduRankAI password reset link." noindex={true}>
  <section class="px-[5vw] py-12 md:py-20 max-w-md mx-auto">
    <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-3">Recover access</p>
    <h1 class="font-display text-[clamp(1.6rem,4vw,2.4rem)] font-semibold text-ink leading-[1.1] tracking-tight mb-3">
      Set a new password
    </h1>

    {doneMsg && (
      <div class="bg-white border border-ink/10 rounded-2xl p-5 md:p-6">
        <p class="text-[0.95rem] text-ink font-semibold mb-2">{doneMsg}</p>
        {holderEmail && <p class="text-[0.85rem] text-ink-soft mb-4">Account: {holderEmail}</p>}
        <div class="flex flex-wrap gap-3">
          <a href="/portal/login" class="bg-burn hover:bg-burn/90 text-white font-semibold py-2.5 px-5 rounded-lg text-[0.9rem]">Sign in</a>
          <a href="/admin/login" class="bg-ink hover:bg-burn text-white font-semibold py-2.5 px-5 rounded-lg text-[0.9rem]">Admin sign in</a>
        </div>
      </div>
    )}

    {!doneMsg && errorMsg && (
      <div class="mb-5 bg-[#fee2e2] border border-[#fca5a5] text-[#991b1b] rounded-lg px-4 py-3 text-[0.85rem]">{errorMsg}</div>
    )}

    {!doneMsg && linkLive && (
      <form method="POST" class="bg-white border border-ink/10 rounded-2xl p-5 md:p-6 flex flex-col gap-4">
        <input type="hidden" name="token" value={token} />
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">New password</label>
          <input type="password" name="password" required minlength={MIN_PASSWORD} autocomplete="new-password"
                 class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
          <p class="text-[0.72rem] text-ink-soft mt-1.5">At least {MIN_PASSWORD} characters. Use something you have not used elsewhere.</p>
        </div>
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Repeat new password</label>
          <input type="password" name="password2" required minlength={MIN_PASSWORD} autocomplete="new-password"
                 class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
        </div>
        <button type="submit" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 px-6 rounded-lg text-[0.95rem]">
          Save new password
        </button>
        <p class="text-[0.72rem] text-ink-soft">This link works once. After you save, it stops working.</p>
      </form>
    )}

    {!doneMsg && !linkLive && (
      <div class="bg-cream-2 border border-ink/10 rounded-2xl p-5">
        <p class="text-[0.85rem] text-ink-2 leading-relaxed mb-3">Request a fresh link from the recovery form.</p>
        <a href="/forgot-password" class="inline-block bg-burn hover:bg-ink text-white font-semibold text-[0.85rem] py-2 px-5 rounded-lg transition-colors">Back to recovery</a>
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-4 text-[0.85rem]">
      <a href="/portal/login" class="text-burn hover:underline font-semibold">Back to sign in</a>
      <span class="text-ink-soft/50">&middot;</span>
      <a href="mailto:hr@edurankai.in" class="text-burn hover:underline font-semibold">Email HR</a>
    </div>
  </section>
</BaseLayout>
