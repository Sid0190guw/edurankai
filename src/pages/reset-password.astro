---
// /reset-password?token=... — where the single-use link from a recovery email is redeemed.
//
// This page exists because the recovery endpoints no longer hand back a password. They mail a
// token; this is the surface that spends it. The token is read from the query string by the inline
// script and posted to /api/auth/reset-password, which is the only place users.password_hash is
// written by a recovery flow.
//
// No server-side work happens here on purpose: the frontmatter must not look the token up, because
// a page render is a GET that browsers, prefetchers and link scanners perform on their own, and a
// single-use token spent by a mail scanner is a support ticket.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { issueRecoveryCsrf } from '@/lib/auth/recovery';

// Minting the CSRF token is the ONLY server-side work this page does, and it touches no token and
// no account — a GET that a mail scanner performs must not spend the reset link.
const csrfToken = issueRecoveryCsrf(Astro.cookies);
---
<BaseLayout title="Set a new password" description="Set a new password for your EduRankAI account using the single-use link sent to your email." noindex={true}>

  <section class="px-[5vw] py-12 md:py-20 max-w-md mx-auto">
    <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-3">Recover access</p>
    <h1 class="font-display text-[clamp(1.6rem,4vw,2.4rem)] font-semibold text-ink leading-[1.1] tracking-tight mb-3">
      Set a new password
    </h1>
    <p class="text-[0.92rem] text-ink-soft leading-relaxed mb-8">
      Choose a new password for your account. The link that brought you here works once and expires 30 minutes after it was sent.
    </p>

    <div id="csrfHolder" data-token={csrfToken} hidden></div>

    <form id="resetForm" class="bg-white border border-ink/10 rounded-2xl p-5 md:p-6 flex flex-col gap-4">
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">New password</label>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
        <p class="text-[0.72rem] text-ink-soft mt-1.5">At least 8 characters. Use something you have not used elsewhere.</p>
      </div>

      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Confirm new password</label>
        <input type="password" name="confirm" required minlength="8" autocomplete="new-password" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.95rem] outline-none focus:border-burn bg-cream-2" />
      </div>

      <button type="submit" id="submitBtn" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 px-6 rounded-lg text-[0.95rem]">
        Set password
      </button>

      <div id="result" style="display:none;"></div>
    </form>

    <div class="mt-6 flex flex-wrap gap-4 text-[0.85rem]">
      <a href="/portal/login" class="text-burn hover:underline font-semibold">Back to sign in</a>
      <span class="text-ink-soft/50">&middot;</span>
      <a href="/forgot-password" class="text-burn hover:underline font-semibold">Request a new link</a>
      <span class="text-ink-soft/50">&middot;</span>
      <a href="mailto:hr@edurankai.in" class="text-burn hover:underline font-semibold">Email HR</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var token = (params.get('token') || '').trim();

      // Take the token out of the address bar as soon as it is in memory. A query string is the one
      // part of a URL that travels: it is written to session history, it is what gets pasted into a
      // support chat when someone says "this link did not work", and it rides along as the Referer on
      // any navigation away from this page. The token is still single-use and still expires, but it
      // has no reason to sit somewhere it can be copied by accident. replaceState does not reload and
      // does not add a history entry, so nothing else about the page changes.
      if (token && window.history && window.history.replaceState) {
        try { window.history.replaceState(null, '', window.location.pathname); } catch (_) {}
      }

      var csrfHolder = document.getElementById('csrfHolder');
      var eraCsrf = (csrfHolder && csrfHolder.getAttribute('data-token')) || '';
      var form = document.getElementById('resetForm');
      var result = document.getElementById('result');
      var btn = document.getElementById('submitBtn');

      function show(html) { result.style.display = 'block'; result.innerHTML = html; }
      function fail(msg) {
        show('<div style="background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;padding:12px 14px;border-radius:8px;font-size:13.5px;">' + msg + '</div>');
      }

      if (!token) {
        btn.disabled = true;
        fail('This page needs the link from your email. Open that link again, or request a new one.');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        var pw = (fd.get('password') || '').toString();
        var confirm = (fd.get('confirm') || '').toString();
        if (pw.length < 8) { fail('Password must be at least 8 characters.'); return; }
        if (pw !== confirm) { fail('The two passwords do not match.'); return; }

        btn.disabled = true;
        var prev = btn.textContent;
        btn.textContent = 'Setting...';
        result.style.display = 'none';

        fetch('/api/auth/reset-password', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': eraCsrf },
          body: JSON.stringify({ token: token, password: pw }),
        }).then(function (r) { return r.json(); }).then(function (d) {
          btn.textContent = prev;
          if (d && d.ok) {
            form.querySelectorAll('input').forEach(function (i) { i.disabled = true; });
            var notice = d.notified === false
              ? '<p style="margin:8px 0 0;font-size:12px;color:#15803d;">We could not send the confirmation email, so check with hr@edurankai.in if you did not expect this change.</p>'
              : '<p style="margin:8px 0 0;font-size:12px;color:#15803d;">A confirmation has been emailed to you. All other sessions were signed out.</p>';
            show(
              '<div style="background:#dcfce7;border:1px solid #86efac;color:#166534;padding:14px 16px;border-radius:10px;font-size:13.5px;line-height:1.7;">' +
                '<p style="font-weight:600;margin:0 0 8px;">' + (d.message || 'Your password is set.') + '</p>' +
                notice +
                '<div style="margin-top:10px;">' +
                  '<a href="/portal/login" style="background:#FF4F00;color:#fff;text-decoration:none;font-weight:600;font-size:13px;padding:8px 14px;border-radius:6px;">Sign in</a>' +
                '</div>' +
              '</div>'
            );
          } else {
            btn.disabled = false;
            fail((d && d.error) || 'We could not set your password. Request a new link.');
          }
        }).catch(function () {
          btn.disabled = false;
          btn.textContent = prev;
          fail('Network error - try again.');
        });
      });
    })();
  </script>
</BaseLayout>
