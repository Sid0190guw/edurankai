---
// /apply/gateway — THE FRONT DOOR. Every applicant passes through here, external or internal.
//
// Nothing on this page decides anything. It collects two facts (do you hold a code, and what is your
// email) and posts them to /api/talent/gateway, which decides server-side and sets the signed gate
// pass. A page that decided for itself would be a client-side authorization check, and the whole
// point of the gate is that there is exactly one place the answer comes from.
//
// WHY THE "NO CODE" DOOR IS AN EXPLICIT CHOICE AND NOT A FALLBACK. If a failed code silently dropped
// somebody into the ordinary application flow, the person whose code was merely mistyped would end
// up with an application AND a selection — two contradictory records of one hire. So a failed code
// stays on this screen with its reason, and the open door has to be chosen deliberately.
import BaseLayout from '@/layouts/BaseLayout.astro';
// From gate-pass, not gateway: this screen only needs to know whether a pass already exists and
// whether the gate can sign one. It has no business opening a database connection to render.
import { verifyGatePass, gateUnavailable, GATE_COOKIE } from '@/lib/talent/gate-pass';

// Declared before anything below uses them: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
const user = Astro.locals.user || null;
const prefillEmail = user?.email ? String(user.email) : '';
const isInternal = !!user;

// Somebody who already holds a live pass does not need to be asked again. Sending them onward is
// also what makes the browser Back button behave: the gate stops being a wall they bounce off.
const existing = verifyGatePass(Astro.cookies.get(GATE_COOKIE)?.value ?? null);
if (existing) {
  return Astro.redirect(existing.door === 'code' ? '/onboarding' : '/apply/step-1');
}

// If the gate cannot sign a pass, it says so instead of quietly letting everyone through. This is
// the same fail-closed reading the API takes.
const unavailable = gateUnavailable();

const opportunityId = Astro.url.searchParams.get('opportunity') || '';
const opportunityTitle = Astro.url.searchParams.get('for') || '';
const hasOpportunity = opportunityId.length > 0;
---

<BaseLayout
  title="Application gate"
  description="Every application to EduRankAI starts here. If you have been selected and hold an authorization code, enter it to go straight to onboarding."
  noindex={true}
>
  <main class="mx-auto w-full max-w-2xl px-5 py-12 sm:py-16">

    <p class="text-xs uppercase tracking-[0.18em] text-neutral-500">Step 0</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">
      Before you apply
    </h1>
    <p class="mt-4 text-base leading-relaxed text-neutral-600">
      Everyone starts here, whether you are applying from outside or already work with us.
      It takes one question to answer.
      {hasOpportunity && opportunityTitle ? ' You are applying for ' + opportunityTitle + '.' : ''}
    </p>

    {unavailable && (
      <div class="mt-8 rounded-lg border border-amber-300 bg-amber-50 p-4">
        <p class="text-sm font-medium text-amber-900">The application gate is not available right now.</p>
        <p class="mt-1 text-sm text-amber-800">
          No application can be accepted until it is back. Please try again shortly, or write to the
          people desk if this persists.
        </p>
      </div>
    )}

    <div id="gate-error" class="mt-8 hidden rounded-lg border border-rose-300 bg-rose-50 p-4">
      <p class="text-sm font-medium text-rose-900">We could not accept that</p>
      <p id="gate-error-text" class="mt-1 text-sm leading-relaxed text-rose-800"></p>
    </div>

    <div class="mt-8 space-y-4">

      <!-- DOOR 1 — an authorization code. -->
      <section class="rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-none text-neutral-700" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" />
          </svg>
          <div class="min-w-0">
            <h2 class="text-base font-semibold text-neutral-900">I have an authorization code</h2>
            <p class="mt-1 text-sm leading-relaxed text-neutral-600">
              You were told you had been selected and sent a code beginning ERA-SEL. Enter it and you
              go straight to onboarding, with no application to fill in. A code can be used once and
              it expires.
            </p>
          </div>
        </div>

        <form id="code-form" class="mt-5 space-y-4" novalidate>
          <div>
            <label for="code" class="block text-sm font-medium text-neutral-800">Authorization code</label>
            <input
              id="code" name="code" type="text" autocomplete="off" spellcheck="false"
              placeholder="ERA-SEL-XXXX-XXXX-XXXX"
              class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 font-mono text-sm uppercase tracking-wide text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
            />
            <p class="mt-1.5 text-xs text-neutral-500">
              Codes never contain the characters O, I, L, 0 or 1.
            </p>
          </div>
          <div>
            <label for="code-email" class="block text-sm font-medium text-neutral-800">
              The email address your selection email was sent to
            </label>
            <input
              id="code-email" name="email" type="email" autocomplete="email" required
              value={prefillEmail}
              class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
            />
          </div>
          <button
            type="submit" data-gate-submit
            disabled={unavailable}
            class="w-full rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
          >Continue to onboarding</button>
        </form>
      </section>

      <!-- DOOR 2 — no code. -->
      <section class="rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-none text-neutral-700" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
          </svg>
          <div class="min-w-0">
            <h2 class="text-base font-semibold text-neutral-900">I do not have a code</h2>
            <p class="mt-1 text-sm leading-relaxed text-neutral-600">
              This is the ordinary route, and it is the right one for almost everybody. You will fill
              in an application and it goes to a human reviewer.
              {isInternal ? ' Applying from inside the organisation uses this same route.' : ''}
            </p>
          </div>
        </div>

        <form id="open-form" class="mt-5 space-y-4" novalidate>
          <div>
            <label for="open-email" class="block text-sm font-medium text-neutral-800">Your email address</label>
            <input
              id="open-email" name="email" type="email" autocomplete="email" required
              value={prefillEmail}
              class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900"
            />
          </div>
          <button
            type="submit" data-gate-submit
            disabled={unavailable}
            class="w-full rounded-lg border border-neutral-900 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
          >Continue to the application</button>
        </form>
      </section>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>

<script define:vars={{ opportunityId }}>
  // Kept at the top level and out of any conditional: a script inside a JSX conditional breaks the
  // Astro parser on this project.
  const errBox = document.getElementById('gate-error');
  const errText = document.getElementById('gate-error-text');

  function showError(message) {
    errText.textContent = message || 'Something went wrong. Please try again.';
    errBox.classList.remove('hidden');
    errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function clearError() {
    errBox.classList.add('hidden');
    errText.textContent = '';
  }
  function setBusy(form, busy) {
    const btn = form.querySelector('[data-gate-submit]');
    if (!btn) return;
    btn.disabled = busy;
    btn.dataset.label = btn.dataset.label || btn.textContent;
    btn.textContent = busy ? 'Checking...' : btn.dataset.label;
  }

  async function send(form, payload) {
    clearError();
    setBusy(form, true);
    try {
      const res = await fetch('/api/talent/gateway', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      let data = {};
      try { data = await res.json(); } catch (_) { data = {}; }
      if (!res.ok || !data.ok) {
        // The server's sentence is shown verbatim. The page never invents a reason of its own and
        // never infers one from the status code, because the wording is the disclosure control.
        showError(data.error);
        return;
      }
      window.location.href = data.next || '/apply/step-1';
    } catch (_) {
      showError('We could not reach the gate. Check your connection and try again.');
    } finally {
      setBusy(form, false);
    }
  }

  document.getElementById('code-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.currentTarget;
    const code = form.querySelector('#code').value.trim();
    const email = form.querySelector('#code-email').value.trim();
    if (!code) { showError('Enter the authorization code from your selection email.'); return; }
    if (!email) { showError('Enter the email address your selection email was sent to.'); return; }
    send(form, { door: 'code', code: code, email: email, opportunityId: opportunityId || null });
  });

  document.getElementById('open-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.currentTarget;
    const email = form.querySelector('#open-email').value.trim();
    if (!email) { showError('Enter your email address.'); return; }
    send(form, { door: 'open', email: email });
  });
</script>
