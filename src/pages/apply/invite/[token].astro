---
// /apply/invite/<token> — the landing page for an invitation an administrator sent.
//
// WHAT THIS PAGE IS ALLOWED TO DO. It reads the token, records that the link was opened, and shows
// the person what they were invited to. It does NOT grant anything: the invitation is bound to an
// email address, and every decision that depends on it — the fee waiver, the link back to the
// invitation record — is taken later, server-side, from that email. So a forwarded link gets
// somebody to the application form, which is a page anyone can reach from /careers anyway, and gets
// them nothing else.
//
// ONE SENTENCE FOR EVERY FAILURE. Used, withdrawn, expired and never-existed all render INVALID_LINK.
// Telling the outside which one it was answers a question we have no reason to answer.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { findByToken, markOpened, isLive, INVALID_LINK, ensureInvitationSchema } from '@/lib/hiring/invitations';

export const prerender = false;

// Declared before anything below uses them: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
const token = String(Astro.params.token || '');

try { await ensureInvitationSchema(); } catch { /* production has this from the hand-run .sql */ }

const invitation = await findByToken(token);
const valid = !!invitation && isLive(invitation.status);

// Recording that it opened must never be able to stop the person walking through the door.
if (valid && invitation) {
  await markOpened(invitation.id);
}

const roleTitle = invitation?.roleTitle || '';
const applyHref = '/apply' + (invitation?.roleSlug ? '?role=' + encodeURIComponent(invitation.roleSlug) : '');
const invitedBy = invitation?.invitedByName || '';
const expiresOn = invitation?.expiresAt ? String(invitation.expiresAt).slice(0, 10) : '';

// Comparisons are resolved here: a `<` inside a JSX expression breaks the Astro parser on this
// project, and so does an arrow character inside a JSX string.
const headline = roleTitle ? 'You are invited to apply' : 'You are invited to apply';
const subhead = roleTitle
  ? 'for ' + roleTitle
  : 'You can choose which opportunity to apply for.';
---

<BaseLayout
  title={valid ? 'An invitation to apply' : 'Invitation link'}
  description="An invitation to apply at EduRankAI."
  noindex={true}
>
  <main class="mx-auto w-full max-w-2xl px-5 py-12 sm:py-16">

    {valid ? (
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500">Invitation</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">{headline}</h1>
        <p class="mt-2 text-lg text-neutral-600">{subhead}</p>

        {invitedBy ? (
          <p class="mt-6 text-sm text-neutral-600">
            {invitedBy} asked us to send you this.
          </p>
        ) : null}

        {invitation && invitation.note ? (
          <blockquote class="mt-5 rounded-lg border-l-4 border-[#FF4F00] bg-neutral-50 px-4 py-3 text-sm italic leading-relaxed text-neutral-700">
            {invitation.note}
          </blockquote>
        ) : null}

        {invitation && invitation.waiveFee ? (
          <p class="mt-5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            The application fee has been waived for you. It is applied automatically when you reach
            that step, as long as you apply with <strong>{invitation.email}</strong>.
          </p>
        ) : null}

        <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
          <h2 class="text-base font-semibold text-neutral-900">What happens next</h2>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-neutral-600">
            <li>You fill in the application, the same one everybody fills in.</li>
            <li>A person reads it. An invitation is not an offer and does not decide the outcome.</li>
            <li>
              Apply with the address this was sent to
              {invitation ? <strong> {invitation.email}</strong> : null}
              , so we can connect your application to this invitation.
            </li>
          </ul>

          <a
            href={applyHref}
            class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 sm:w-auto"
          >Continue to the application</a>

          {expiresOn ? (
            <p class="mt-3 text-xs text-neutral-500">This link stops working after {expiresOn}.</p>
          ) : null}
        </div>
      </div>
    ) : (
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-neutral-500">Invitation</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">This link is not usable</h1>
        <p class="mt-3 text-base leading-relaxed text-neutral-600">{INVALID_LINK}</p>

        <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
          <h2 class="text-base font-semibold text-neutral-900">You can still apply</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            Nothing here is only reachable by invitation. Every open opportunity is listed publicly,
            and the ordinary application is the same one an invitation leads to.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href="/careers"
              class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800"
            >See open opportunities</a>
            <a
              href="/apply"
              class="inline-flex items-center justify-center rounded-lg border border-neutral-300 px-4 py-2.5 text-sm font-medium text-neutral-900 transition hover:bg-neutral-50"
            >Start an application</a>
          </div>
        </div>

        <p class="mt-6 text-sm text-neutral-600">
          If you believe this link should work, reply to the email it came in and ask for a new one.
        </p>
      </div>
    )}

    <p class="mt-8 text-xs leading-relaxed text-neutral-500">
      EduRankAI is the technology platform; accredited partners award credentials. Internships are
      unpaid unless a stipend is explicitly recorded on the engagement.
    </p>
  </main>
</BaseLayout>
