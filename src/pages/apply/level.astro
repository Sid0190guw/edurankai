---
// Step 2 — career level. Exists because applicants were applying several rungs above their
// experience without realising it: an intern applying for Chief of Staff, for instance. Neither
// side benefits from that — the applicant spends an hour on a form that cannot succeed, and a
// reviewer spends time declining it.
//
// This shows the whole ladder with what each rung actually requires, marks the one they are
// applying to, and asks them to state where they are today. A large gap produces a clear warning
// and asks them to confirm deliberately — it does NOT block them. People change careers, and a
// self-assessment is not evidence; the decision stays with a human reviewer. What it does buy is
// an informed applicant and a declared expectation the reviewer can see.
import ApplyLayout from '@/layouts/ApplyLayout.astro';
import { db } from '@/lib/db';
import { roles } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { getActiveDraft, saveDraft } from '@/lib/apply/draft';
import { safeDraft } from '@/lib/apply/data';

const user = Astro.locals.user;
const next = Astro.url.pathname + Astro.url.search;
if (!user) return Astro.redirect('/portal/signup?next=' + encodeURIComponent(next));
if (user.role !== 'applicant') return Astro.redirect('/admin');

const roleSlug = Astro.url.searchParams.get('role') || '';
const draft = safeDraft(await getActiveDraft(user.id));

let role: any = null;
const slug = roleSlug || draft?.roleSlug || '';
if (slug) {
  try {
    const found = await db.select().from(roles).where(eq(roles.slug, slug)).limit(1);
    role = found[0] || null;
  } catch (_) {}
}

// Ordered senior-to-junior, matching the levelEnum in schema.ts. The index is the comparison basis
// for the gap warning below.
const LADDER: { level: string; title: string; blurb: string; typical: string }[] = [
  { level: 'C-Level', title: 'C-Level', blurb: 'Sets direction for the whole organisation and owns the outcome of an entire function.', typical: 'Typically 15+ years, including several years leading leaders.' },
  { level: 'Lead', title: 'Lead / Head', blurb: 'Owns a team and a domain end to end — the plan, the people and the delivery.', typical: 'Typically 8-15 years, with direct experience managing a team.' },
  { level: 'Senior', title: 'Senior', blurb: 'Works independently on hard problems and raises the standard of everyone around them.', typical: 'Typically 5-8 years of hands-on professional experience.' },
  { level: 'Mid', title: 'Mid', blurb: 'Delivers substantial work with little supervision and mentors newer colleagues.', typical: 'Typically 2-5 years of professional experience.' },
  { level: 'Junior', title: 'Junior', blurb: 'Delivers well-defined work with regular guidance and grows quickly.', typical: 'Typically 0-2 years of professional experience.' },
  { level: 'Intern', title: 'Intern', blurb: 'Learning through real work on live projects, with a mentor and structured review.', typical: 'Currently studying, or recently graduated.' },
  { level: 'Apprentice', title: 'Apprentice', blurb: 'Earning while learning a craft from the ground up, no prior experience assumed.', typical: 'No professional experience required.' },
];
const rank = (l: string) => { const i = LADDER.findIndex((x) => x.level === l); return i < 0 ? LADDER.length - 1 : i; };

const roleLevel = role?.level || draft?.roleLevel || '';
const prev = (draft as any)?.level || {};

let errorMsg = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const currentLevel = (fd.get('currentLevel') as string || '').trim();
  const yearsExperience = (fd.get('yearsExperience') as string || '').trim();
  const gapAck = fd.get('gapAck') === 'on';
  const gapReason = (fd.get('gapReason') as string || '').trim();

  const validLevel = LADDER.some((l) => l.level === currentLevel);
  // A gap of 2+ rungs is where a mismatch stops being a stretch and starts being a mis-apply.
  const gap = validLevel && roleLevel ? rank(currentLevel) - rank(roleLevel) : 0;
  const bigGap = gap >= 2;

  if (!validLevel) errorMsg = 'Please tell us which level best describes you today.';
  else if (bigGap && !gapAck) errorMsg = 'This role sits well above the level you selected. Please tick the box to confirm you still want to apply.';
  else {
    await saveDraft(user.id, user.email, {
      ...draft,
      level: { currentLevel, yearsExperience, roleLevel, gap, gapAck, gapReason },
      ...(slug && !draft?.roleSlug ? { roleSlug: slug } : {}),
    }, 3);
    return Astro.redirect('/apply/step-2' + (slug ? '?role=' + slug : ''));
  }
}
---
<ApplyLayout step={2} totalSteps={7} stepTitle="Career level" stepSubtitle="So we can review you against the right bar." roleTitle={role?.title}>

  {errorMsg && (
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl p-4 mb-5 text-[0.86rem]">{errorMsg}</div>
  )}

  {roleLevel && (
    <div class="bg-cream-2 border border-ink/10 rounded-xl p-4 mb-6">
      <p class="text-[0.72rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-1">You are applying for</p>
      <p class="text-[1rem] font-semibold text-ink">{role?.title || 'this role'}</p>
      <p class="text-[0.85rem] text-ink-soft mt-1">Level: <strong class="text-burn">{roleLevel}</strong></p>
    </div>
  )}

  <p class="text-[0.86rem] text-ink-soft leading-relaxed mb-4">
    Every role at EduRankAI sits on one of these levels. Read them, then tell us where you are today.
    Applying above your current level is allowed &mdash; people change fields and grow fast &mdash; we
    just want you and the reviewer looking at the same expectations.
  </p>

  <form method="POST" class="space-y-5">
    <div class="space-y-2 mb-2">
      {LADDER.map((l) => (
        <label class={`block border rounded-xl p-4 cursor-pointer transition-colors ${l.level === roleLevel ? 'border-burn bg-burn/[0.05]' : 'border-ink/10 hover:border-ink/25'}`}>
          <div class="flex items-start gap-3">
            <input type="radio" name="currentLevel" value={l.level} required
              checked={prev.currentLevel === l.level}
              data-level-rank={LADDER.findIndex((x) => x.level === l.level)}
              class="mt-1 w-4 h-4 accent-burn shrink-0" />
            <div class="min-w-0">
              <p class="text-[0.92rem] font-semibold text-ink">
                {l.title}
                {l.level === roleLevel && (
                  <span class="ml-2 text-[0.62rem] font-mono uppercase tracking-[0.12em] text-burn border border-burn/40 rounded-full px-2 py-0.5 align-middle">This role</span>
                )}
              </p>
              <p class="text-[0.84rem] text-ink-soft leading-relaxed mt-0.5">{l.blurb}</p>
              <p class="text-[0.78rem] text-ink-soft/70 mt-1">{l.typical}</p>
            </div>
          </div>
        </label>
      ))}
    </div>

    <label class="block">
      <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Years of professional experience</span>
      <input type="text" name="yearsExperience" inputmode="numeric" placeholder="e.g. 0, 3, 12"
        value={prev.yearsExperience || ''}
        class="w-full text-[0.9rem] border border-ink/15 rounded-lg px-3 py-2.5" />
      <span class="block text-[0.76rem] text-ink-soft mt-1">Internships and part-time work count. Enter 0 if you are still studying.</span>
    </label>

    {/* Shown by the script below only when the selected level is well under the role's. Rendered
        server-side too so it still works with JavaScript disabled and on a failed POST. */}
    <div id="gapBox" hidden={!(prev.gap >= 2)} data-role-rank={roleLevel ? rank(roleLevel) : ''}
      class="border border-amber-300 bg-amber-50 rounded-xl p-4">
      <p class="text-[0.86rem] text-amber-900 leading-relaxed mb-3">
        <strong>This role sits well above the level you selected.</strong> You are welcome to apply,
        but it will be reviewed against the bar for <strong>{roleLevel || 'this level'}</strong>, not
        the level you chose. If you would rather start where your experience fits,
        <a href="/careers" class="underline">browse other open roles</a>.
      </p>
      <label class="flex items-start gap-2.5 cursor-pointer">
        <input type="checkbox" name="gapAck" checked={!!prev.gapAck} class="mt-0.5 w-4 h-4 accent-burn shrink-0" />
        <span class="text-[0.84rem] text-amber-900">I understand, and I still want to apply for this role.</span>
      </label>
      <label class="block mt-3">
        <span class="block text-[0.8rem] font-semibold text-amber-900 mb-1.5">Why are you a fit for this level? (optional)</span>
        <textarea name="gapReason" rows="3" placeholder="Prior experience, transferable work, or anything that would not show up in a job title."
          class="w-full text-[0.88rem] border border-amber-300 rounded-lg px-3 py-2.5 bg-white">{prev.gapReason || ''}</textarea>
      </label>
    </div>

    <div class="flex items-center justify-between gap-3 pt-2">
      <a href={'/apply/step-1' + (slug ? '?role=' + slug : '')} class="text-[0.85rem] text-ink-soft hover:text-ink underline underline-offset-2">Back</a>
      <button type="submit" class="bg-burn text-white border-0 rounded-lg font-semibold text-[0.9rem] px-6 py-3 cursor-pointer">Continue</button>
    </div>
  </form>

  <script is:inline>
    /* Reveal the gap warning as soon as a level is chosen, so the applicant learns about the
       mismatch here rather than after submitting. The server re-checks on POST — this is guidance,
       not the gate. */
    (function () {
      var box = document.getElementById('gapBox');
      if (!box) return;
      var roleRank = box.dataset.roleRank;
      if (roleRank === '' || roleRank == null) return;
      roleRank = Number(roleRank);
      document.querySelectorAll('input[name="currentLevel"]').forEach(function (r) {
        r.addEventListener('change', function () {
          var mine = Number(r.dataset.levelRank);
          // Higher index = more junior, so a positive difference means applying upward.
          box.hidden = !(mine - roleRank >= 2);
        });
      });
    })();
  </script>
</ApplyLayout>
