---
import { getActiveDraft } from '@/lib/apply/draft';

const user = Astro.locals.user;
const url = new URL(Astro.request.url);
const roleSlugFromUrl = url.searchParams.get('role') || '';

if (!user) {
  const next = '/apply' + (roleSlugFromUrl ? '?role=' + roleSlugFromUrl : '');
  return Astro.redirect('/portal/signup?next=' + encodeURIComponent(next));
}

if (user.role !== 'applicant') {
  return Astro.redirect('/admin');
}

// REFUSE AT THE DOOR, NOT AT STEP SIX. The submission path checks this too — that is the gate that
// actually protects the data — but sending somebody through six steps of a form and refusing at the
// end is a cruelty the check at the top makes unnecessary. Resolved by slug because that is all this
// page has; a slug that matches nothing simply falls through to the normal flow.
if (roleSlugFromUrl) {
  try {
    const { db } = await import('@/lib/db');
    const { sql } = await import('drizzle-orm');
    const res: any = await db.execute(sql`
      SELECT id, is_open, job_status, application_deadline FROM roles WHERE slug = ${roleSlugFromUrl} LIMIT 1`);
    const rows = Array.isArray(res) ? res : (res?.rows || []);
    const row = rows[0];
    if (row) {
      const { effectiveJobStatus } = await import('@/lib/xscale/taxonomy');
      const status = effectiveJobStatus({
        jobStatus: row.job_status, isOpen: row.is_open, applicationDeadline: row.application_deadline,
      });
      if (!status.acceptsApplications) {
        return Astro.redirect('/careers/' + roleSlugFromUrl);
      }
    }
  } catch (e: any) {
    // FAILS OPEN. The real gate is at submission; a lookup failure here must not stop an applicant.
    console.error('[apply] status precheck:', e?.cause?.message || e?.message);
  }
}

const draft = await getActiveDraft(user.id);

// If user came from a specific role URL AND that role differs from draft's role,
// reset their progress to step 1 with the new role.
// Otherwise, resume at last saved step.
let resumeStep = 1;
let useRoleSlug = roleSlugFromUrl;

if (draft) {
  const draftRoleSlug = (draft.data as any)?.roleSlug || '';
  if (roleSlugFromUrl && roleSlugFromUrl !== draftRoleSlug) {
    // Different role - start over but keep the new role
    resumeStep = 1;
    useRoleSlug = roleSlugFromUrl;
  } else {
    // Same role or no URL - resume where they left off
    resumeStep = draft.step || 1;
    useRoleSlug = draftRoleSlug || roleSlugFromUrl;
    if (resumeStep < 1 || resumeStep > 7) resumeStep = 1;
  }
}

const target = '/apply/step-' + resumeStep + (useRoleSlug ? '?role=' + useRoleSlug : '');
return Astro.redirect(target);
---
