---
import ApplyLayout from '@/layouts/ApplyLayout.astro';
import { db } from '@/lib/db';
import { roles, departments } from '@/lib/db/schema';
import { eq, and, asc } from 'drizzle-orm';
import { getActiveDraft, saveDraft } from '@/lib/apply/draft';
import { safeDraft } from '@/lib/apply/data';
import { publicCompensation, isTraineeRole } from '@/lib/compensation-text';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');
if (user.role !== 'applicant') return Astro.redirect('/admin');

const url = new URL(Astro.request.url);
const roleSlugFromUrl = url.searchParams.get('role') || '';

const draftRow = await getActiveDraft(user.id);
const draft = safeDraft(draftRow?.data);
const s2 = draft.step2 || {};

if (!draft.step1) {
  return Astro.redirect('/apply/step-1' + (roleSlugFromUrl ? '?role=' + roleSlugFromUrl : ''));
}

const activeRoleSlug = roleSlugFromUrl || s2.roleSlug || draft.roleSlug || '';

let preselected = null;
let preselectedDept = null;
if (activeRoleSlug) {
  const found = await db.select().from(roles).where(eq(roles.slug, activeRoleSlug)).limit(1);
  if (found.length > 0) {
    preselected = found[0];
    const dept = await db.select().from(departments).where(eq(departments.id, found[0].departmentId)).limit(1);
    if (dept.length > 0) preselectedDept = dept[0];
  }
}

// THE FORM BODY IS READ BEFORE ANY OF THE QUERIES BELOW, and that ordering is the whole fix.
// Choosing a department submits this form so the server can load that department's roles. The
// department the person just chose therefore arrives in the POST body and NOWHERE ELSE - it is not
// in the draft yet, because only a completed step is saved. Reading it after the roles query (which
// is what this page used to do) meant the query ran against the OLD department every time, so the
// role select stayed on "Select a department first" no matter what was picked, and the handler
// then rejected the same submission with "Please select a role." for not carrying one.
// `const` is not hoisted, so this has to sit above its first use rather than beside the handler.
const isPost = Astro.request.method === 'POST';
const fd = isPost ? await Astro.request.formData() : null;
// 'dept' is set by the department select's onchange before it submits. It is what separates "I am
// changing department, load its roles" from "I am done, continue" - the two submissions are
// otherwise identical, and treating the first as the second is what produced the error banner.
const intent = ((fd?.get('intent') as string) || 'continue').trim();
const submittedDeptId = ((fd?.get('departmentId') as string) || '').trim();

// Only load departments and roles list when there's NO pre-selected role
const allDepts = preselected ? [] : await db.select().from(departments).orderBy(asc(departments.sortOrder));
// draft.deptChoice, NOT draft.step2. step2 is the flag steps 3-6 read as "a role was chosen and
// validated" (`if (!draft.step2?.roleSlug) ...`), so a department picked on the way to choosing a
// role cannot be stored in it - writing a role-less step2 would let somebody who only opened the
// department dropdown walk through the rest of the application and stage a submission with no role.
const selectedDeptId = preselected?.departmentId
  || submittedDeptId || s2.departmentId || draft.deptChoice?.departmentId || '';

let rolesInSelectedDept: { id: string; title: string; slug: string; level: string }[] = [];
if (!preselected && selectedDeptId) {
  rolesInSelectedDept = await db.select({
    id: roles.id, title: roles.title, slug: roles.slug, level: roles.level
  }).from(roles).where(and(eq(roles.departmentId, selectedDeptId), eq(roles.isOpen, true))).orderBy(asc(roles.sortOrder), asc(roles.title));
}

let errorMsg = '';
// Read by the radio group at the foot of the form. Held in its own variable rather than written
// back onto s2, because s2 is the same object as draft.step2 and mutating it here would edit the
// draft that the branch below spreads.
let openToOtherForRender = String(s2.openToOther || draft.deptChoice?.openToOther || '');

// A department change is not an attempt to continue, so it must not be answered with a validation
// error. The roles for the chosen department are already loaded above; re-rendering is all it needs.
if (isPost && intent === 'dept' && !preselected) {
  // Nothing else here writes the chosen department, and without this a refresh or a Back would drop
  // it. Saved at step 2 - the step the person is still on - so this never advances the draft.
  // The radio answer travels in this same POST, so it is carried across rather than reset: losing
  // an answer the person already gave is exactly what makes a reloading form feel broken.
  openToOtherForRender = ((fd?.get('openToOther') as string) || openToOtherForRender).trim();
  await saveDraft(user.id, user.email, {
    ...draft, deptChoice: { departmentId: selectedDeptId, openToOther: openToOtherForRender }
  }, 2);
}

if (isPost && intent !== 'dept' && fd) {
  // If pre-selected, use the locked role. Otherwise read from form.
  const submittedRoleSlug = preselected ? preselected.slug : ((fd.get('roleSlug') as string || '').trim());
  const openToOther = (fd.get('openToOther') as string || '').trim();
  // Kept for the re-render as well as the save. Every branch below can set errorMsg and fall through
  // to render, and without this the radio group comes back unchecked on the same screen that tells
  // the person something went wrong - losing an answer they had just given.
  openToOtherForRender = openToOther || openToOtherForRender;

  if (submittedRoleSlug) {
    const roleCheck = await db.select({ id: roles.id, title: roles.title, departmentId: roles.departmentId, level: roles.level })
      .from(roles).where(eq(roles.slug, submittedRoleSlug)).limit(1);

    // Someone who declined an offer for THIS role cannot pick it again for 30 days. Checked here,
    // at the moment the role is chosen, so they are told before filling in four more steps rather
    // than at submission. It is the only consequence of declining — the account is untouched and
    // every other role stays open, which is why the message names the role and the date.
    let reapplyBlock: { blocked: boolean; message?: string } = { blocked: false };
    if (roleCheck.length > 0) {
      const { checkReapplyBlock } = await import('@/lib/reapply-window');
      reapplyBlock = await checkReapplyBlock(user.id, roleCheck[0].id as string);
    }

    if (reapplyBlock.blocked) {
      errorMsg = reapplyBlock.message || 'You cannot apply for this role yet.';
    } else if (roleCheck.length > 0) {
      const r = roleCheck[0];
      const newDraft = {
        ...draft,
        roleSlug: submittedRoleSlug,
        step2: {
          roleSlug: submittedRoleSlug,
          roleTitle: r.title,
          departmentId: r.departmentId,
          level: r.level,
          openToOther: openToOther
        }
      };
      await saveDraft(user.id, user.email, newDraft, 3);
      return Astro.redirect('/apply/step-3?role=' + submittedRoleSlug);
    } else {
      errorMsg = 'That role does not exist or is no longer open.';
    }
  } else {
    errorMsg = 'Please select a role.';
  }
}

const initOpenToOther = openToOtherForRender;
const isInternOrApprentice = !!preselected && isTraineeRole(preselected);
// Every internship and apprenticeship is unpaid except the flagship LLM Engineering Internship,
// which is decided by slug in src/lib/compensation-text.ts. This screen used to read the stored
// pay string and call any trainee row that did not start with "Unpaid" a paid internship - and
// this is the last screen before someone commits to applying, so a wrong claim here is the one
// they act on. publicCompensation() returns null when there is nothing publishable, which also
// keeps the engagement-terms box from showing an equity promise the firm does not offer.
const termsText = publicCompensation(preselected);
const paysStipend = isInternOrApprentice && !!termsText;

const levelColors: Record<string, string> = {
  'C-Level': 'bg-plum-bg text-plum border-plum-border',
  'Lead': 'bg-leaf-bg text-leaf border-leaf-border',
  'Senior': 'bg-sky-bg text-sky border-sky-border',
  'Mid': 'bg-burn-pale text-burn border-burn-dim',
  'Junior': 'bg-cream-2 text-ink-soft border-ink/15',
  'Intern': 'bg-gold-bg text-gold-deep border-gold-border',
  'Apprentice': 'bg-leaf-bg text-leaf border-leaf-border'
};
const levelChipClass = preselected ? (levelColors[preselected.level] || 'bg-cream-2 text-ink-soft border-ink/15') : '';
---
<ApplyLayout step={3} totalSteps={7} stepTitle="Role Preference" stepSubtitle={preselected ? 'Confirm your selection and continue.' : 'Choose a department and role.'} roleTitle={preselected?.title}>

  {errorMsg && (
    <div style="background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.25);color:#b91c1c;font-size:0.85rem;padding:11px 14px;border-radius:8px;margin-bottom:18px;line-height:1.6;">
      {errorMsg}
    </div>
  )}

  {termsText && (
    <div class="bg-burn-pale border border-burn-dim rounded-lg p-4 mb-6 text-[0.82rem] text-ink-2 leading-relaxed">
      <p class="font-semibold text-burn mb-1.5">Engagement terms</p>
      <p class="whitespace-pre-wrap">{termsText}</p>
    </div>
  )}

  <form method="POST" class="flex flex-col gap-5">

    <!-- Read by the frontmatter to tell a department change apart from a Continue. The department
         select rewrites it to 'dept' before submitting; the Continue button leaves it alone. -->
    <input type="hidden" name="intent" value="continue" />

    {preselected ? (
      <div class="bg-cream-2 border-2 border-burn-dim rounded-xl p-5 flex flex-col gap-3">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-[0.6rem] font-mono uppercase tracking-wider text-burn font-bold mb-1">Role</p>
            <p class="font-display text-[1.2rem] font-semibold text-ink leading-tight">{preselected.title}</p>
          </div>
          <a href="/careers" class="text-[0.72rem] font-mono text-ink-soft hover:text-burn underline whitespace-nowrap">Change role</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-3 border-t border-burn-dim/40">
          <span class={'text-[0.7rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border ' + levelChipClass}>{preselected.level}</span>
          <span class="text-[0.7rem] font-semibold text-ink-soft bg-white border border-ink/10 px-2.5 py-1 rounded-md">{preselectedDept?.name || 'Department'}</span>
          <span class="text-[0.7rem] font-semibold text-ink-soft bg-white border border-ink/10 px-2.5 py-1 rounded-md">{preselected.engagementType}</span>
          <span class="text-[0.7rem] font-semibold text-ink-soft bg-white border border-ink/10 px-2.5 py-1 rounded-md">{preselected.location}</span>
        </div>
        {isInternOrApprentice && !paysStipend && (
          <div class="mt-3 flex items-start gap-2 bg-leaf-bg border border-leaf-border rounded-lg px-3 py-2.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1c7a45" stroke-width="2" class="mt-0.5 shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
            <p class="text-[0.78rem] text-leaf leading-relaxed">Please note this is an <b>unpaid internship</b> — you apply for the experience, mentorship and the work itself.</p>
          </div>
        )}
        {isInternOrApprentice && paysStipend && (
          <div class="mt-3 flex items-start gap-2 bg-gold-bg border border-gold-border rounded-lg px-3 py-2.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a6a12" stroke-width="2" class="mt-0.5 shrink-0"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <p class="text-[0.78rem] text-gold-deep leading-relaxed">This is a <b>paid internship</b> — {termsText}</p>
          </div>
        )}
      </div>
    ) : (
      <>
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Department <span class="text-burn">*</span></label>
          <select name="departmentId" required onchange="this.form.intent.value='dept';this.form.submit()" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2">
            <option value="">Select a department...</option>
            {allDepts.map((d) => {
              const sel = selectedDeptId === d.id;
              return <option value={d.id} selected={sel}>{d.name}</option>;
            })}
          </select>
        </div>

        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Role Title <span class="text-burn">*</span></label>
          {!selectedDeptId ? (
            <select disabled class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] bg-cream-2/40 text-ink-soft">
              <option>Select a department first</option>
            </select>
          ) : rolesInSelectedDept.length === 0 ? (
            <div class="px-3.5 py-2.5 border border-ink/15 rounded-lg bg-cream-2/40 text-[0.85rem] text-ink-soft">
              No open roles in this department right now. <a href="mailto:hr@edurankai.in" class="text-burn font-semibold hover:underline">Write to HR</a>
            </div>
          ) : (
            <select name="roleSlug" required class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2">
              <option value="">Select a role...</option>
              {rolesInSelectedDept.map((r) => {
                const sel = activeRoleSlug === r.slug;
                return <option value={r.slug} selected={sel}>{r.title} ({r.level})</option>;
              })}
            </select>
          )}
        </div>
      </>
    )}

    <div>
      <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Open to similar roles if this one is filled?</label>
      <div class="grid grid-cols-2 gap-2">
        <label class={'flex items-center gap-2 px-3.5 py-2.5 border rounded-lg cursor-pointer text-[0.85rem] transition-all ' + (initOpenToOther === 'Yes' ? 'border-burn bg-burn-pale text-burn font-semibold' : 'border-ink/15 bg-cream-2 hover:border-burn-dim')}>
          <input type="radio" name="openToOther" value="Yes" checked={initOpenToOther === 'Yes'} class="accent-burn" />
          <span>Yes, absolutely</span>
        </label>
        <label class={'flex items-center gap-2 px-3.5 py-2.5 border rounded-lg cursor-pointer text-[0.85rem] transition-all ' + (initOpenToOther === 'No' ? 'border-burn bg-burn-pale text-burn font-semibold' : 'border-ink/15 bg-cream-2 hover:border-burn-dim')}>
          <input type="radio" name="openToOther" value="No" checked={initOpenToOther === 'No'} class="accent-burn" />
          <span>This role only</span>
        </label>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <a href={'/apply/step-1' + (activeRoleSlug ? '?role=' + activeRoleSlug : '')} class="px-5 py-3 border border-ink/15 rounded-lg text-[0.88rem] font-medium text-ink-soft hover:border-burn-dim hover:text-ink transition-all flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        Back
      </a>
      <button type="submit" class="flex-1 bg-ink hover:bg-ink/90 text-white font-semibold py-3 rounded-lg text-[0.9rem] transition-all flex items-center justify-center gap-2">
        Continue
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </div>

  </form>

</ApplyLayout>

