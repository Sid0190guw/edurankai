---
import ApplyLayout from '@/layouts/ApplyLayout.astro';
import BeforeYouApply from '@/components/BeforeYouApply.astro';
import { db } from '@/lib/db';
import { roles } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { getActiveDraft, saveDraft } from '@/lib/apply/draft';
import { safeDraft } from '@/lib/apply/data';
import { getProfileCommon, saveCommonFromStep1 } from '@/lib/applicant-profile';

const user = Astro.locals.user;
if (!user) {
  const url = new URL(Astro.request.url);
  const roleSlug = url.searchParams.get('role') || '';
  const next = '/apply/step-1' + (roleSlug ? '?role=' + roleSlug : '');
  return Astro.redirect('/portal/signup?next=' + encodeURIComponent(next));
}
if (user.role !== 'applicant') return Astro.redirect('/admin');

// Auto-promote any user still on access_status='pending' so the apply flow
// never silently gates someone whose signup partially failed. Belt-and-braces
// — the signup path was sometimes leaving applicants stuck at 'pending' when
// the phone-column UPDATE threw and the catch swallowed it.
try {
  const { sql } = await import('drizzle-orm');
  await db.execute(sql`UPDATE users SET access_status = 'approved', updated_at = NOW() WHERE id = ${user.id} AND access_status = 'pending'`);
} catch (_) {}

const url = new URL(Astro.request.url);
const roleSlug = url.searchParams.get('role') || '';

let preselectedRole: any = null;
let roleFeeAmount: number | null = null;
let roleFeeCurrency = 'CHF';
let isIntern = false;   // the extra due-diligence fields are collected ONLY for internships/apprenticeships
if (roleSlug) {
  const found = await db.select({ title: roles.title, slug: roles.slug, departmentId: roles.departmentId, level: roles.level, engagementType: roles.engagementType })
    .from(roles).where(eq(roles.slug, roleSlug)).limit(1);
  if (found.length > 0) {
    preselectedRole = found[0];
    const lvl = String((found[0] as any).level || '');
    const eng = String((found[0] as any).engagementType || '');
    isIntern = lvl === 'Intern' || lvl === 'Apprentice' || eng === 'Internship' || eng === 'Apprenticeship';
  }
  try {
    const { sql } = await import('drizzle-orm');
    const feeRow = await db.execute(sql`SELECT application_fee_amount, application_fee_currency FROM roles WHERE slug = ${roleSlug} LIMIT 1`);
    const feeRs = (Array.isArray(feeRow) ? feeRow : ((feeRow as any)?.rows || [])) as any[];
    if (feeRs[0]) {
      roleFeeAmount = feeRs[0].application_fee_amount != null ? Number(feeRs[0].application_fee_amount) : null;
      roleFeeCurrency = feeRs[0].application_fee_currency || 'CHF';
    }
  } catch (_) {}
}

const draftRow = await getActiveDraft(user.id);
const draft = safeDraft(draftRow?.data);
// Pre-fill from the saved profile so a fresh application isn't blank; any
// in-progress draft values still take precedence over the saved profile.
const profileCommon = await getProfileCommon(user.id);
const s1 = { ...profileCommon, ...(draft.step1 || {}) };

let errorMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  // Photo: a small live-camera capture OR uploaded image, as a data URL. Documents are NEVER
  // uploaded — they are Google Drive links. Cap the image size so the DB row stays small.
  const _photoData = (fd.get('photoData') as string || '').trim();
  const _photoUrlHidden = (fd.get('photoUrl') as string || '').trim();
  const photoValue = (_photoData.startsWith('data:image/') && _photoData.length < 400000) ? _photoData : _photoUrlHidden;
  const data = {
    firstName: (fd.get('firstName') as string || '').trim(),
    lastName: (fd.get('lastName') as string || '').trim(),
    email: (fd.get('email') as string || '').trim().toLowerCase(),
    phoneCountry: (fd.get('phoneCountry') as string || '+91').trim(),
    phone: (fd.get('phone') as string || '').trim(),
    currentCity: (fd.get('currentCity') as string || '').trim(),
    linkedin: (fd.get('linkedin') as string || '').trim(),
    resumeLink: (fd.get('resumeLink') as string || '').trim(),
    dateOfBirth: (fd.get('dateOfBirth') as string || '').trim(),
    birthTime: (fd.get('birthTime') as string || '').trim(),
    birthPlace: (fd.get('birthPlace') as string || '').trim(),
    photoUrl: photoValue,
    familyAnnualIncome: (fd.get('familyAnnualIncome') as string || '').trim(),
    instagram: (fd.get('instagram') as string || '').trim(),
    twitter: (fd.get('twitter') as string || '').trim(),
    youtube: (fd.get('youtube') as string || '').trim(),
    github: (fd.get('github') as string || '').trim(),
    portfolio: (fd.get('portfolio') as string || '').trim(),
    otherSocial: (fd.get('otherSocial') as string || '').trim(),
    favouriteFood: (fd.get('favouriteFood') as string || '').trim(),
    musicGenre: (fd.get('musicGenre') as string || '').trim(),
    preferredName: (fd.get('preferredName') as string || '').trim(),
    pronouns: (fd.get('pronouns') as string || '').trim(),
    citizenship: (fd.get('citizenship') as string || '').trim(),
    languages: (fd.get('languages') as string || '').trim(),
    activities: (fd.get('activities') as string || '').trim(),
    honors: (fd.get('honors') as string || '').trim(),
    accommodations: (fd.get('accommodations') as string || '').trim(),
    additionalInfo: (fd.get('additionalInfo') as string || '').trim(),
    bgCheckConsent: fd.get('bgCheckConsent') === 'yes'
  };

  const missing = [];
  if (!data.firstName) missing.push('First name');
  if (!data.lastName) missing.push('Last name');
  if (!data.email || !/.+@.+\..+/.test(data.email)) missing.push('Valid email');
  if (!data.phone || data.phone.length < 7) missing.push('Phone number');
  if (!data.currentCity) missing.push('Current city');
  if (!data.resumeLink) missing.push('Resume / Portfolio link');
  if (!data.dateOfBirth) missing.push('Date of birth');
  if (!data.birthPlace) missing.push('Birth place');
  // Intern/apprentice applications only: family income + at least one social/online profile.
  if (isIntern) {
    if (!data.familyAnnualIncome) missing.push('Family annual income');
    const anySocial = [data.instagram, data.twitter, data.youtube, data.github, data.portfolio, data.otherSocial, data.linkedin].some((v) => v && v.trim());
    if (!anySocial) missing.push('At least one social / online profile');
    if (!data.bgCheckConsent) missing.push('Consent to the background check (tick the box)');
  }

  if (missing.length > 0) {
    errorMsg = 'Please fill in: ' + missing.join(', ');
  } else {
    const newDraft = { ...draft, step1: data };
    if (roleSlug && !newDraft.roleSlug) newDraft.roleSlug = roleSlug;
    await saveDraft(user.id, user.email, newDraft, 2);
    // Persist the common info to the applicant's profile so their NEXT
    // application pre-fills automatically (survives draft deletion on submit).
    await saveCommonFromStep1(user.id, user.email, data);
    return Astro.redirect('/apply/step-2' + (roleSlug ? '?role=' + roleSlug : ''));
  }
}

const initFirstName = s1.firstName || (user.name ? user.name.split(' ')[0] : '');
const initLastName = s1.lastName || (user.name && user.name.split(' ').length > 1 ? user.name.split(' ').slice(1).join(' ') : '');
const initEmail = s1.email || user.email;

const COUNTRY_CODES = [
  { code: '+91', label: 'IN +91' },
  { code: '+1', label: 'US +1' },
  { code: '+44', label: 'UK +44' },
  { code: '+90', label: 'TR +90' },
  { code: '+971', label: 'AE +971' },
  { code: '+61', label: 'AU +61' },
  { code: '+65', label: 'SG +65' },
  { code: '+49', label: 'DE +49' },
  { code: '+33', label: 'FR +33' },
  { code: '+81', label: 'JP +81' },
  { code: '+86', label: 'CN +86' },
  { code: '+880', label: 'BD +880' },
  { code: '+92', label: 'PK +92' },
  { code: '+977', label: 'NP +977' },
  { code: '+94', label: 'LK +94' },
  { code: '+62', label: 'ID +62' },
  { code: '+60', label: 'MY +60' },
  { code: '+66', label: 'TH +66' },
  { code: '+82', label: 'KR +82' },
  { code: '+27', label: 'ZA +27' },
  { code: '+234', label: 'NG +234' },
  { code: '+254', label: 'KE +254' },
  { code: '+20', label: 'EG +20' },
  { code: '+966', label: 'SA +966' },
  { code: '+972', label: 'IL +972' },
  { code: '+98', label: 'IR +98' },
  { code: '+7', label: 'RU +7' },
  { code: '+39', label: 'IT +39' },
  { code: '+34', label: 'ES +34' },
  { code: '+31', label: 'NL +31' },
  { code: '+46', label: 'SE +46' },
  { code: '+52', label: 'MX +52' },
  { code: '+55', label: 'BR +55' },
  { code: '+54', label: 'AR +54' },
  { code: '+64', label: 'NZ +64' }
];

const todayDate = new Date().toISOString().split('T')[0];
---
<ApplyLayout step={1} totalSteps={6} stepTitle="Personal Info" stepSubtitle="Quick basics — just enough to reach you." roleTitle={preselectedRole?.title}>

  <BeforeYouApply feeAmount={roleFeeAmount ?? undefined} feeCurrency={roleFeeCurrency} roleLevel={preselectedRole?.level} />

  {errorMsg && (
    <div style="background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.25);color:#b91c1c;font-size:0.85rem;padding:11px 14px;border-radius:8px;margin-bottom:18px;line-height:1.6;">
      WARNING: {errorMsg}
    </div>
  )}

  <form method="POST" class="flex flex-col gap-5">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">First Name <span class="text-burn">*</span></label>
        <input type="text" name="firstName" required value={initFirstName} placeholder="Aryan" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      </div>
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Last Name <span class="text-burn">*</span></label>
        <input type="text" name="lastName" required value={initLastName} placeholder="Sharma" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Email <span class="text-burn">*</span></label>
        <input type="email" name="email" required value={initEmail} placeholder="aryan@email.com" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      </div>
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Phone <span class="text-burn">*</span></label>
        <div class="flex gap-2">
          <select name="phoneCountry" class="px-2 py-2.5 border border-ink/15 rounded-lg text-[0.82rem] bg-cream-2 outline-none focus:border-burn min-w-[110px]">
            {COUNTRY_CODES.map((c) => {
              const sel = (s1.phoneCountry || '+91') === c.code;
              return <option value={c.code} selected={sel}>{c.label}</option>;
            })}
          </select>
          <input type="tel" name="phone" required value={s1.phone || ''} placeholder="98765 43210" class="flex-1 px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Current City <span class="text-burn">*</span></label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[0.85rem] pointer-events-none">PIN</span>
          <input type="text" name="currentCity" required value={s1.currentCity || ''} placeholder="e.g. Bangalore, India" class="w-full pl-12 pr-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
        </div>
      </div>
      <div>
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">LinkedIn <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
        <input type="url" name="linkedin" value={s1.linkedin || ''} placeholder="linkedin.com/in/yourname" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      </div>
    </div>

    <div>
      <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Resume / Portfolio Link <span class="text-burn">*</span></label>
      <div class="bg-sky-bg border border-sky-border rounded-lg p-3.5 mb-2 text-[0.8rem] text-ink-2 leading-relaxed">
        <p class="font-semibold text-sky mb-1.5">Upload your resume to Google Drive first</p>
        <p class="text-[0.78rem]">1. Upload PDF to Google Drive then Share then set to "Anyone with the link" then paste the link below</p>
        <p class="text-[0.78rem] mt-1">OR paste a GitHub, LinkedIn, or portfolio site link directly</p>
      </div>
      <input type="url" name="resumeLink" required value={s1.resumeLink || ''} placeholder="https://drive.google.com/... or https://github.com/..." class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      <p class="text-[0.7rem] text-ink-soft mt-1.5 italic">Google Drive (PDF) or GitHub or Portfolio site or LinkedIn profile</p>
    </div>

    <div class="border-t border-ink/8 pt-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Date of Birth <span class="text-burn">*</span></label>
          <input type="date" name="dateOfBirth" required value={s1.dateOfBirth || ''} max={todayDate} class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
        </div>
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Birth Time <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
          <input type="time" name="birthTime" value={s1.birthTime || ''} class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          <p class="text-[0.7rem] text-ink-soft mt-1 italic">As per birth certificate</p>
        </div>
      </div>

      <div class="mt-4">
        <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Birth Place <span class="text-burn">*</span></label>
        <input type="text" name="birthPlace" required value={s1.birthPlace || ''} placeholder="City and country where you were born" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
      </div>
    </div>

    <div class="border-t border-ink/8 pt-5">
      <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Your photo <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
      <div class="flex items-start gap-4 flex-wrap">
        <div class="rounded-xl overflow-hidden bg-cream-2 border border-ink/15 flex items-center justify-center" style="width:132px;height:132px;flex-shrink:0;">
          <video id="photoVideo" autoplay playsinline muted style="display:none;width:100%;height:100%;object-fit:cover;transform:scaleX(-1);"></video>
          <img id="photoPreview" alt="" style="display:none;width:100%;height:100%;object-fit:cover;" />
          <span id="photoPlaceholder" class="text-[0.72rem] text-ink-soft text-center px-2">No photo yet</span>
        </div>
        <div class="flex flex-col gap-2">
          <div class="flex gap-2 flex-wrap">
            <button type="button" id="photoStart" class="text-[0.8rem] font-semibold px-3 py-2 rounded-lg bg-ink text-white">Take photo</button>
            <button type="button" id="photoCapture" class="text-[0.8rem] font-semibold px-3 py-2 rounded-lg bg-burn text-white" style="display:none;">Capture</button>
            <label class="text-[0.8rem] font-semibold px-3 py-2 rounded-lg border border-ink/20 text-ink cursor-pointer inline-flex items-center">Upload<input type="file" id="photoFile" accept="image/*" style="display:none;" /></label>
            <button type="button" id="photoClear" class="text-[0.8rem] font-semibold px-3 py-2 rounded-lg border border-ink/20 text-ink-soft" style="display:none;">Clear</button>
          </div>
          <p class="text-[0.7rem] text-ink-soft italic max-w-xs">Take a live photo with your camera, or upload one. Kept small. Recent passport-style preferred. Documents are never uploaded &mdash; share those as Google Drive links.</p>
        </div>
      </div>
      <input type="hidden" name="photoData" id="photoData" value={s1.photoUrl && String(s1.photoUrl).startsWith('data:') ? s1.photoUrl : ''} />
      <input type="hidden" name="photoUrl" value={s1.photoUrl && !String(s1.photoUrl).startsWith('data:') ? s1.photoUrl : ''} />
    </div>

    {isIntern && (
    <div class="border-t border-ink/8 pt-5">
      <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-1">A bit more about you</label>
      <p class="text-[0.72rem] text-ink-soft italic mb-3">For internship applications: your income bracket helps with fee support and eligibility, and your public profiles are part of our standard background check &mdash; they also let us see your creative or technical work. The rest just helps us know you.</p>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Family annual income <span class="text-burn">*</span></label>
          <select name="familyAnnualIncome" required class="w-full md:max-w-sm px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2">
            <option value="" disabled selected={!s1.familyAnnualIncome}>Select a range</option>
            {['Below 1 lakh', '1-4 lakh', '5-12 lakh', '13-30 lakh', '31-80 lakh', '81 lakh - 5 crore', '6-100 crore', '101-250 crore', '251 crore+'].map((b) => (
              <option value={b} selected={s1.familyAnnualIncome === b}>{b} / year (INR)</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Social &amp; online presence <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(add any that apply &mdash; at least one)</span></label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input type="text" name="instagram" value={s1.instagram || ''} placeholder="Instagram - @handle or link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
            <input type="text" name="twitter" value={s1.twitter || ''} placeholder="X / Twitter - @handle or link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
            <input type="text" name="youtube" value={s1.youtube || ''} placeholder="YouTube - channel link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
            <input type="text" name="github" value={s1.github || ''} placeholder="GitHub - username or link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
            <input type="text" name="portfolio" value={s1.portfolio || ''} placeholder="Portfolio / Behance / Dribbble - link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
            <input type="text" name="otherSocial" value={s1.otherSocial || ''} placeholder="Other - any public profile link" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          </div>
          <p class="text-[0.7rem] text-ink-soft italic mt-1">Public profiles only. At least one is required for internship applications.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Favourite food <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <input type="text" name="favouriteFood" value={s1.favouriteFood || ''} placeholder="e.g. dosa, biryani, pasta" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          </div>
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Music you enjoy <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <input type="text" name="musicGenre" value={s1.musicGenre || ''} placeholder="e.g. classical, lo-fi, rock, indie" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Preferred name <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <input type="text" name="preferredName" value={s1.preferredName || ''} placeholder="What should we call you?" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          </div>
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Pronouns <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <select name="pronouns" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2">
              <option value="" selected={!s1.pronouns}>Prefer not to say</option>
              {['She/her', 'He/him', 'They/them', 'Self-describe'].map((p) => (
                <option value={p} selected={s1.pronouns === p}>{p}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Citizenship / work authorization <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <select name="citizenship" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2">
              <option value="" selected={!s1.citizenship}>Select</option>
              {['Indian citizen', 'OCI / PIO', 'Foreign national (needs work visa)', 'Other'].map((c) => (
                <option value={c} selected={s1.citizenship === c}>{c}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Languages known <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <input type="text" name="languages" value={s1.languages || ''} placeholder="e.g. English (fluent), Hindi, Tamil" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 transition-colors" />
          </div>
        </div>

        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Activities &amp; extracurriculars <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
          <textarea name="activities" rows="3" placeholder="A few that matter - role, organization, what you did. One per line. Clubs, projects, volunteering, creative or technical work." class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 resize-y">{s1.activities || ''}</textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Honors &amp; awards <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <textarea name="honors" rows="2" placeholder="Recognitions, scholarships, competitions won" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 resize-y">{s1.honors || ''}</textarea>
          </div>
          <div>
            <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Accommodations you'd like <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
            <textarea name="accommodations" rows="2" placeholder="Anything we can do to support you in the process" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 resize-y">{s1.accommodations || ''}</textarea>
          </div>
        </div>

        <div>
          <label class="block text-[0.68rem] font-bold uppercase tracking-wider text-ink-soft mb-2">Anything else we should know <span class="text-ink-soft/60 font-normal normal-case tracking-normal">(optional)</span></label>
          <textarea name="additionalInfo" rows="3" placeholder="Context, gaps, circumstances, or anything you'd like to add" class="w-full px-3.5 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-cream-2 resize-y">{s1.additionalInfo || ''}</textarea>
        </div>

        <label class="flex items-start gap-2.5 p-3 bg-cream-2/60 border border-ink/12 rounded-lg cursor-pointer">
          <input type="checkbox" name="bgCheckConsent" value="yes" checked={s1.bgCheckConsent} required style="margin-top:2px;width:17px;height:17px;flex-shrink:0;accent-color:#FF4F00;" />
          <span class="text-[0.8rem] text-ink-2 leading-relaxed">I consent to EduRankAI reviewing my <strong>public</strong> profiles and information as part of standard screening for this internship. <span class="text-burn">*</span></span>
        </label>
      </div>
    </div>
    )}

    <div class="pt-2">
      <button type="submit" class="w-full bg-ink hover:bg-ink/90 text-white font-semibold py-3.5 rounded-lg text-[0.92rem] transition-all flex items-center justify-center gap-2">
        Continue
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </div>

  </form>

<script is:inline>
  /* Photo: live camera capture OR upload, resized to a small 320px square JPEG (data URL) so the
     stored image stays tiny. Documents are never uploaded — only this picture. */
  (function () {
    var video = document.getElementById('photoVideo');
    var img = document.getElementById('photoPreview');
    var ph = document.getElementById('photoPlaceholder');
    var start = document.getElementById('photoStart');
    var cap = document.getElementById('photoCapture');
    var file = document.getElementById('photoFile');
    var clear = document.getElementById('photoClear');
    var data = document.getElementById('photoData');
    if (!video || !data) return;
    var stream = null;
    function stop() { if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; } }
    function showImg(url) {
      img.src = url; img.style.display = 'block'; video.style.display = 'none'; ph.style.display = 'none';
      data.value = url; clear.style.display = ''; start.textContent = 'Retake';
    }
    function square(src, w, h) {
      var side = Math.min(w, h), c = document.createElement('canvas'); c.width = 320; c.height = 320;
      var x = c.getContext('2d'); x.drawImage(src, (w - side) / 2, (h - side) / 2, side, side, 0, 0, 320, 320);
      return c.toDataURL('image/jpeg', 0.82);
    }
    if (data.value && data.value.indexOf('data:') === 0) showImg(data.value);
    start.addEventListener('click', function () {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { alert('Camera not available — please use Upload.'); return; }
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } }).then(function (s) {
        stream = s; video.srcObject = s; video.style.display = 'block'; img.style.display = 'none'; ph.style.display = 'none';
        start.style.display = 'none'; cap.style.display = ''; clear.style.display = '';
      }).catch(function () { alert('Could not open the camera. You can upload a photo instead.'); });
    });
    cap.addEventListener('click', function () {
      var url = square(video, video.videoWidth || 320, video.videoHeight || 320); stop();
      cap.style.display = 'none'; start.style.display = ''; showImg(url);
    });
    file.addEventListener('change', function () {
      var f = file.files && file.files[0]; if (!f) return;
      var im = new Image(); im.onload = function () { showImg(square(im, im.width, im.height)); URL.revokeObjectURL(im.src); };
      im.src = URL.createObjectURL(f);
    });
    clear.addEventListener('click', function () {
      stop(); img.style.display = 'none'; video.style.display = 'none'; ph.style.display = 'block';
      data.value = ''; clear.style.display = 'none'; cap.style.display = 'none'; start.style.display = ''; start.textContent = 'Take photo';
    });
  })();
</script>

{/* Location capture. The notice is shown BEFORE the browser prompt appears — required under
    India's DPDP Act, and simply the honest way to ask. Device signals (timezone, locale) are sent
    without a prompt because they need no permission; precise location always asks, and a refusal is
    recorded as a refusal rather than retried. */}
<div
  data-era-apply
  data-step="step-1"
  data-era-geo-consent
  class="mt-8 rounded-xl border border-white/10 bg-white/[0.03] p-4"
>
  <p class="text-[0.7rem] font-mono uppercase tracking-[0.15em] text-white/40 mb-2">Verification notice</p>
  <p class="text-[0.82rem] text-white/70 leading-relaxed">
    We record where this application is submitted from &mdash; your approximate location from your
    internet connection, and your device's timezone and language settings. Your browser will also ask
    once whether to share your precise location; you can decline and still apply. This is used only to
    verify applications and prevent fraud, is visible only to our senior review team, and is never sold
    or shared. Write to <a href="mailto:hr@edurankai.in" class="text-burn underline">hr@edurankai.in</a>
    to ask what we hold about you or to have it deleted.
  </p>
</div>

<script src="/apply-location.js" is:inline defer></script>

</ApplyLayout>


