<script is:inline>
  /* Mandatory-location gate for security-classified roles. Ticking the box triggers the browser
     prompt immediately and reports the real outcome, so an applicant is never left believing they
     have granted access when the browser refused. This is a courtesy layer only — the binding check
     runs on the server at submission, because a browser-only gate can be bypassed.

     THE SUCCESS MESSAGE IS ONLY SHOWN ON A CONFIRMED WRITE. The browser granting permission is not
     the thing the server checks — it checks for a STORED point. This screen used to say "Location
     access granted. You can continue." the instant the browser said yes, then fire the recording off
     without ever looking at the reply, so a failed write looked exactly like a successful one and
     step 6 refused the application of someone who had done everything right. */
  (function () {
    var box = document.querySelector('[data-era-geo-gate]');
    var status = document.querySelector('[data-era-geo-status]');
    if (!box || !status) return;
    var granted = false;
    function say(msg, cls) { status.textContent = msg; status.className = 'text-[0.76rem] mt-3 ' + cls; }

    box.addEventListener('change', function () {
      if (!box.checked || granted) return;
      if (!navigator.geolocation) { box.checked = false; say('Your browser does not support location sharing, so this role cannot be applied to from this device.', 'text-red-400'); return; }
      var api = window.AquinApplyLocation;
      if (!api || !api.askPrecise) {
        box.checked = false;
        say('The location check could not start on this page. Please reload and tick the box again.', 'text-red-400');
        return;
      }
      say('Waiting for your browser to confirm location access...', 'text-white/60');
      /* force=true does two things: it bypasses the once-per-session guard (the server needs the
         grant actually recorded, not skipped as a repeat ask) and it waits for the server to confirm
         the row was written. */
      api.askPrecise(true).then(function (res) {
        var st = res && res.status;
        if (st !== 'granted') {
          box.checked = false;
          say(st === 'denied'
            ? 'Location access was blocked. Allow location for this site in your browser settings, then tick the box again.'
            : 'We could not read your location. Check that location services are on, then tick the box again.', 'text-red-400');
          return;
        }
        if (!res.stored) {
          box.checked = false;
          say('Your browser shared your location but we could not record it, so the application would be refused at the last step. Please check your connection and tick the box again.', 'text-red-400');
          return;
        }
        granted = true;
        say('Location received and recorded. You can continue.', 'text-green-400');
      });
    });
  })();
</script>

<script is:inline>
  /* HORIZON Patch 01 — offer the browser's own time zone as the default.
   *
   * WHY THIS IS NOT JUST `select.value = tz`. The server renders its option list from
   * Intl.supportedValuesOf('timeZone'), and on the Node build this runs on that list holds the
   * LEGACY names: Asia/Calcutta, Europe/Kiev, Asia/Rangoon. Browsers report the modern ones —
   * Asia/Kolkata, Europe/Kyiv, Asia/Yangon — so a plain assignment silently matches nothing and
   * leaves the field blank for a large part of the world, India included.
   *
   * So: try the exact value; if no option has it, ADD one. The server accepts either spelling
   * (canonicalTimezone in birth-input.ts resolves both through Intl), so the added option is a real
   * answer and not a workaround with a hole in it.
   *
   * A DEFAULT, NOT A DECISION. It is only applied when the field is empty, the source is recorded as
   * `device` rather than `declared`, and the person can change it or clear it. Nothing here guesses
   * a zone from a place name — that is exactly what the server refuses to do.
   */
  (function () {
    var sel = document.getElementById('birthTimezone');
    var src = document.getElementById('birthTimezoneSource');
    if (!sel || !src) return;
    if (sel.value) { if (!src.value) src.value = 'declared'; return; }

    var tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { tz = ''; }
    if (!tz) return;

    var found = false;
    for (var i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value === tz) { found = true; break; }
    }
    if (!found) {
      var opt = document.createElement('option');
      opt.value = tz;
      opt.textContent = tz;
      sel.insertBefore(opt, sel.options[1] || null);
    }
    sel.value = tz;
    src.value = 'device';

    /* Once the person touches it, it is their declaration and not the device's. */
    sel.addEventListener('change', function () { src.value = sel.value ? 'declared' : ''; });
  })();
</script>

</ApplyLayout>


