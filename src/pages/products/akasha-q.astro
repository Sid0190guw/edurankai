---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ensureVisvambharaAccessSchema, hasApprovedAccess } from '@/lib/visvambhara-access';
import { ensureAkashaQProduct } from '@/lib/products-seed';

// Akasha-Q is its own programme now, not a paragraph inside the aerospace page. It was written up
// as a Viśvambhara subsystem while the swarm was the only platform it had; the ladder it actually
// describes — bench, fibre, free-space, HAPS relay, CubeSat, LEO, constellation — is a
// communications platform in its own right, and the swarm is one of the things that rides on it.
// The seed row is what makes it reachable from /ecosystem and the homepage grid instead of being a
// page only someone who already knows the URL can find.
await ensureAkashaQProduct();

const user = Astro.locals.user;

// A PUBLIC MARKETING PAGE MUST NOT 500 BECAUSE THE DATABASE IS HAVING A BAD MINUTE.
//
// Both calls below open a connection, and both were awaited bare — the schema-ensure was the first
// statement in the frontmatter, so an unreachable pooler took the whole page down before a word of
// the public preview rendered. That was survivable while nothing linked here; it is not now that
// this page is on the homepage grid, in /ecosystem and in the sitemap.
//
// Guarded in the fail-closed direction, which is the only safe one: `approved` stays false when we
// cannot answer the question, so a reader sees the public preview and the access gate. A failure
// here can hide the full briefing from someone entitled to it; it can never show it to someone who
// is not.
let approved = false;
try {
  await ensureVisvambharaAccessSchema();
  if (user) approved = await hasApprovedAccess(user.id);
} catch (e: any) {
  console.error('[products/akasha-q] access check failed:', e?.cause?.message || e?.message);
}

// Every rung is a design study. Nothing here has flown, and the status word on each card is the
// only thing standing between a roadmap and a claim — it renders from this list rather than being
// typed into the card markup, so a rung cannot change status by someone editing prose around it.
const STAGES = [
  {
    n: '01',
    reach: 'Optical bench',
    title: 'Protocol on the ground',
    body: 'BB84 with decoy states on a bench at a partner photonics lab. Retires the protocol risk where a failure costs an afternoon.',
    status: 'Design study'
  },
  {
    n: '02',
    reach: 'Metro, tens of km',
    title: 'Fibre and short free-space',
    body: 'Key exchange between two fixed terminals across a city — dark fibre where it exists, a line-of-sight optical span where it does not. Retires terminal engineering and the key-management plumbing.',
    status: 'Design study'
  },
  {
    n: '03',
    reach: '20-30 km altitude',
    title: 'Airborne and HAPS relay',
    body: 'Free-space optical link between a ground terminal and a high-altitude platform. Retires atmospheric turbulence and moving-platform pointing, the two risks no bench can retire.',
    status: 'Design study'
  },
  {
    n: '04',
    reach: 'Low Earth orbit',
    title: 'CubeSat demonstrator',
    body: 'A single-photon detector and a space-qualified optical bench on a low-cost bus. Retires launch survival, orbital thermal cycling, and radiation tolerance of the detector.',
    status: 'Design study'
  },
  {
    n: '05',
    reach: 'Orbit to ground, service grade',
    title: 'Operational satellite',
    body: 'The first satellite delivering key material to ground stations on a schedule an operator can plan around, rather than on a demonstration pass.',
    status: 'Design study'
  },
  {
    n: '06',
    reach: 'Global',
    title: 'Constellation',
    body: 'Continuous key distribution wherever a terminal can see the sky. This is the end state the five rungs below it exist to reach.',
    status: 'Design study'
  }
];

// The layers are what the platform IS; the rungs above are only how far it reaches. Keeping them
// apart on the page is deliberate — a reader who skims the ladder should still not come away
// thinking the product is a satellite.
const LAYERS = [
  {
    label: 'Entropy',
    title: 'Randomness at the edge',
    body: 'Quantum entropy generated at the terminal, not drawn from an operating-system pool that a compromised host controls. Every key above this layer is only as unguessable as this layer is.'
  },
  {
    label: 'Key exchange',
    title: 'QKD, with a software floor under it',
    body: 'BB84, decoy-state and BBM92 where a line of sight and the hardware exist. Standardised post-quantum key encapsulation everywhere else, on the same key-management plane. The honest position: post-quantum cryptography in software covers most of what most operators need today, and it ships without an optical terminal. Quantum key distribution is what you add when key exchange must rest on physics rather than on an unproven hardness assumption.'
  },
  {
    label: 'Command',
    title: 'An uplink that cannot be forged',
    body: 'Authenticated command and control over narrow-beam optical links. A forged uplink is the failure that turns an autonomous system into a hostile one, and a narrow beam is spatially hard to jam in a way a broadcast radio channel is not.'
  },
  {
    label: 'Evidence',
    title: 'A record that survives the decade',
    body: 'Detections, decisions and transactions signed with post-quantum signatures anchored to distributed key material, so a record written today is still defensible after an adversary acquires a cryptographically relevant quantum computer.'
  },
  {
    label: 'Timing',
    title: 'Time and position, cross-checked',
    body: 'Authenticated timing relayed from the airborne or orbital node and cross-checked against the national satellite-navigation framework, so a spoofed position signal has to disagree with something instead of simply being believed.'
  }
];

// Named uses, not customers. Nothing here is deployed.
const USES = [
  { eye: 'Use 01', title: 'Autonomous fleet command', body: 'Forge-proof tasking and a jam-resistant uplink for any uncrewed system a hostile actor would want to redirect. The Viśvambhara swarm is the first fleet designed against this layer, not the reason it exists.' },
  { eye: 'Use 02', title: 'Evidence-grade records', body: 'Chains of custody that stay admissible after the cryptography under them is broken.' },
  { eye: 'Use 03', title: 'Disaster-zone links', body: 'A high-bandwidth uplink out of a region whose terrestrial fibre is under water or under rubble.' },
  { eye: 'Use 04', title: 'Long-lived state secrets', body: 'Material that must stay secret for decades, against an adversary recording the ciphertext today to decrypt later.' },
  { eye: 'Use 05', title: 'Settlement messaging', body: 'Authenticated inter-institution settlement instructions, with an offline backstop for when the link is down.' }
];
---
<BaseLayout title="Akasha-Q · Quantum-secure communications, ground to orbit · EduRankAI" description="Akasha-Q is EduRankAI's quantum-secure communications programme — entropy, key distribution, authenticated command and an unforgeable evidence chain, on a staged ladder from an optical bench to a satellite constellation. Design study; public preview.">

<style>
  body { background: #0a0a0c; color: #e8e8ee; }
  .aq-wrap { max-width: 1280px; margin: 0 auto; }
  .aq-hero { padding: 60px 5vw 44px; }
  .aq-eyebrow { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #67e8f9; font-weight: 700; margin: 0; }
  .aq-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(46px, 7vw, 88px); font-weight: 600; letter-spacing: -0.04em; margin: 14px 0 18px; line-height: 0.96; max-width: 1000px; }
  .aq-title em { font-style: italic; font-weight: 500; background: linear-gradient(135deg, #a78bfa, #67e8f9); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .aq-sub { font-size: 17px; color: #9aa6b6; max-width: 760px; line-height: 1.7; }

  .aq-status { margin: 26px 0 0; display: inline-flex; align-items: center; gap: 10px; font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #fbbf24; font-weight: 700; border: 1px solid rgba(251,191,36,0.32); border-left: 2px solid #fbbf24; border-radius: 9px; padding: 12px 16px; line-height: 1.6; }
  .aq-status svg { flex: none; }

  .aq-mission { padding: 0 5vw 40px; }
  .aq-pull { background: linear-gradient(135deg, rgba(167,139,250,0.08), rgba(103,232,249,0.04)); border-left: 3px solid #a78bfa; padding: 24px 28px; border-radius: 0 14px 14px 0; }
  .aq-pull p { font-family: 'Cormorant Garamond', serif; font-size: 20px; line-height: 1.55; font-style: italic; color: #fff; margin: 0; }

  .aq-row { display: grid; grid-template-columns: 220px 1fr; gap: 32px; padding: 24px 5vw; max-width: 1280px; margin: 0 auto; align-items: flex-start; border-top: 1px solid #1a1a25; }
  @media (max-width: 800px) { .aq-row { grid-template-columns: 1fr; gap: 12px; } }
  .aq-label { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #67e8f9; font-weight: 700; }
  .aq-body { font-size: 15px; color: #cfd6da; line-height: 1.75; }
  .aq-body strong { color: #fff; }

  .aq-layers { display: grid; gap: 10px; margin-top: 6px; }
  .aq-layer { background: #11131a; border: 1px solid #2a2a35; border-radius: 12px; padding: 18px 20px; }
  .aq-layer-eye { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #a78bfa; font-weight: 700; }
  .aq-layer-t { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: #fff; margin: 5px 0 7px; font-weight: 600; line-height: 1.2; }
  .aq-layer-d { font-size: 13.5px; color: #9aa6b6; line-height: 1.65; margin: 0; }

  .aq-stages { padding: 40px 5vw; max-width: 1280px; margin: 0 auto; }
  .aq-stage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
  .aq-stage { background: #11131a; border: 1px solid #2a2a35; border-radius: 12px; padding: 18px; display: flex; flex-direction: column; }
  .aq-stage-n { font-family: 'Geist Mono', monospace; font-size: 28px; color: #a78bfa; font-weight: 700; line-height: 1; margin: 0; }
  .aq-stage-reach { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.13em; text-transform: uppercase; color: #67e8f9; font-weight: 700; margin: 10px 0 0; }
  .aq-stage-t { font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #fff; margin: 4px 0 6px; font-weight: 600; line-height: 1.15; }
  .aq-stage-d { font-size: 12.5px; color: #9aa6b6; line-height: 1.55; margin: 0 0 14px; flex: 1; }
  .aq-stage-s { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #fbbf24; font-weight: 700; border-top: 1px solid #2a2a35; padding-top: 10px; margin: 0; }

  .aq-gate { padding: 48px 5vw 40px; max-width: 980px; margin: 0 auto; }
  .aq-gate-card { background: linear-gradient(135deg, #11131a, #1a1a25); border: 1px solid #2a2a35; border-radius: 18px; padding: 36px; text-align: center; }
  .aq-gate-eye { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #fbbf24; font-weight: 700; }
  .aq-gate-title { font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 600; margin: 10px 0 12px; letter-spacing: -0.02em; line-height: 1.1; }
  .aq-gate-sub { font-size: 15px; color: #9aa6b6; line-height: 1.65; max-width: 620px; margin: 0 auto 24px; }
  .aq-gate-btn { background: linear-gradient(135deg, #a78bfa, #67e8f9); color: #0a0a0c; padding: 14px 32px; border-radius: 10px; text-decoration: none; font-weight: 800; display: inline-block; font-family: 'Geist Mono', monospace; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }

  .aq-app-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
  @media (max-width: 700px) { .aq-app-grid { grid-template-columns: 1fr; } }
  .aq-app { background: #11131a; border: 1px solid #2a2a35; border-radius: 10px; padding: 16px; }
  .aq-app-eye { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #fbbf24; font-weight: 700; }
  .aq-app-t { font-family: 'Cormorant Garamond', serif; font-size: 17px; color: #fff; font-weight: 600; margin: 4px 0 6px; line-height: 1.2; }
  .aq-app-d { font-size: 12.5px; color: #9aa6b6; line-height: 1.55; margin: 0; }

  .aq-links { padding: 10px 5vw 80px; max-width: 1280px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 12px; }
  .aq-link { display: block; background: #11131a; border: 1px solid #2a2a35; border-radius: 12px; padding: 16px 20px; text-decoration: none; flex: 1 1 260px; }
  .aq-link:hover { border-color: #a78bfa; }
  .aq-link-eye { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #67e8f9; font-weight: 700; }
  .aq-link-t { font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #fff; font-weight: 600; margin: 5px 0 4px; }
  .aq-link-d { font-size: 12.5px; color: #9aa6b6; line-height: 1.55; margin: 0; }
</style>

<main>

  <!-- HERO -->
  <section class="aq-hero aq-wrap">
    <p class="aq-eyebrow">EduRankAI · Frontier research programme</p>
    <h1 class="aq-title"><em>Akasha-Q</em>.<br/>Quantum-secure communications, ground to orbit.</h1>
    <p class="aq-sub">A communications platform, not a satellite. Quantum entropy at the terminal, key distribution that does not rest on an unproven hardness assumption, an authenticated command channel, and an evidence chain that stays defensible for decades. Built to reach as far as the link has to go: an optical bench, a city, a high-altitude relay, and finally a constellation.</p>
    <p class="aq-status">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      Design study &middot; nothing on this page has flown
    </p>
  </section>

  <!-- MISSION CARD -->
  <section class="aq-mission aq-wrap">
    <div class="aq-pull">
      <p>We are not launching quantum satellites. We are building the trust layer that would make one worth launching — entropy, keys, authenticated command and an unforgeable record — and taking it up the ladder one rung at a time, each rung retiring a risk the rung above cannot afford to meet for the first time.</p>
    </div>
  </section>

  <!-- ROW: what it is -->
  <section class="aq-row">
    <div>
      <p class="aq-label">What Akasha-Q is</p>
    </div>
    <div class="aq-body">
      <p>Akasha-Q is a <strong>quantum-secure communications platform</strong>: five layers that together let two parties exchange keys, issue commands, and write records a future adversary cannot forge or quietly decrypt. It is a programme in its own right, with its own ladder and its own users.</p>
      <p>It is also the layer the <a href="/products/visvambhara" style="color:#67e8f9;">Viśvambhara</a> autonomous swarm is designed against — an uncrewed fleet is exactly the kind of system that has to assume its uplink is under attack. That programme is the first platform to carry an Akasha-Q terminal, not the reason the platform exists.</p>
      <div class="aq-layers">
        {LAYERS.map((l) => (
          <div class="aq-layer">
            <p class="aq-layer-eye">{l.label}</p>
            <p class="aq-layer-t">{l.title}</p>
            <p class="aq-layer-d">{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROW: threats -->
  <section class="aq-row">
    <div>
      <p class="aq-label">What it defends against</p>
    </div>
    <div class="aq-body">
      <p>Five attack surfaces, in the order they tend to be exploited:</p>
      <ol style="padding-left:20px;color:#cfd6da;line-height:1.85;font-size:14.5px;">
        <li><strong>Command injection and spoofing</strong> — a forged uplink redirects an autonomous system or talks it past its own refusal rules. Mitigated by an authenticated command channel keyed from the exchange layer.</li>
        <li><strong>Jamming and denial of service</strong> — a broadcast radio channel is trivially deniable. A narrow optical beam is spatially hard to jam, and a verdict-only upstream model keeps the mission alive when the link is thin.</li>
        <li><strong>Interception of the picture</strong> — traffic recorded today, decrypted in fifteen years. Key material derived from a quantum exchange is not vulnerable to that kind of patience.</li>
        <li><strong>Harvest now, decrypt later on the record</strong> — post-quantum signatures anchored to distributed keys keep an evidence chain admissible past the break.</li>
        <li><strong>Position and timing spoofing</strong> — authenticated timing from the relay, cross-checked against the national satellite-navigation framework, so a lie has to disagree with something.</li>
      </ol>
    </div>
  </section>

  <!-- LADDER -->
  <section class="aq-stages">
    <p class="aq-label" style="margin-bottom:6px;">How far it reaches</p>
    <p style="font-size:14.5px;color:#9aa6b6;line-height:1.7;max-width:760px;margin:0 0 18px;">Six rungs, ground to constellation. Each exists to retire a specific risk before the next one has to meet it somewhere failure is expensive. The status word on every card is the current one.</p>
    <div class="aq-stage-grid">
      {STAGES.map((s) => (
        <div class="aq-stage">
          <p class="aq-stage-n">{s.n}</p>
          <p class="aq-stage-reach">{s.reach}</p>
          <p class="aq-stage-t">{s.title}</p>
          <p class="aq-stage-d">{s.body}</p>
          <p class="aq-stage-s">{s.status}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- USES -->
  <section class="aq-row">
    <div>
      <p class="aq-label">Where the layer decides the outcome</p>
    </div>
    <div class="aq-body">
      <p>Five contexts where the quantum layer is the difference between a demonstration and something an operator can field. None of them is deployed today.</p>
      <div class="aq-app-grid">
        {USES.map((u) => (
          <div class="aq-app">
            <p class="aq-app-eye">{u.eye}</p>
            <p class="aq-app-t">{u.title}</p>
            <p class="aq-app-d">{u.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROW: the real bottleneck (public) -->
  <section class="aq-row">
    <div>
      <p class="aq-label">The real bottleneck</p>
    </div>
    <div class="aq-body">
      <p>It is <strong>optomechanical engineering, not quantum physics</strong>. The protocols are textbook and largely de-risked nationally. What stops programmes for years is the optical payload: sub-microradian acquisition, tracking and pointing at a counterpart moving at 7.6 km/s; a bench that holds sub-micron alignment through orbital thermal cycling; single-photon detectors that survive radiation; and a payload that survives launch and then re-aligns itself in orbit. Hiring and budget follow that reading — pointing and optomechanics first, quantum specialists second.</p>
    </div>
  </section>

  <!-- Gated section -->
  {!approved && (
    <section class="aq-gate">
      <div class="aq-gate-card">
        <p class="aq-gate-eye">Restricted briefing</p>
        <h2 class="aq-gate-title">The full execution blueprint requires <em style="color:#a78bfa;font-style:italic;">approved access</em>.</h2>
        <p class="aq-gate-sub">The detailed sections — corrected technical reality, the optomechanical moat, integration architecture, intellectual-property strategy, roadmap and budget, risk register and exit scenarios — are not part of the public preview. Access is granted through the same review as the rest of the restricted research line.</p>
        {user ? (
          <a href="/portal/visvambhara" class="aq-gate-btn">Request access &rarr;</a>
        ) : (
          <a href="/portal/login?next=/products/akasha-q" class="aq-gate-btn">Sign in to apply &rarr;</a>
        )}
      </div>
    </section>
  )}

  {approved && (
    <section class="aq-row">
      <div>
        <p class="aq-label" style="color:#86efac;">Approved &middot; Full briefing</p>
      </div>
      <div class="aq-body">
        <p><strong>Where a standalone framing is fragile.</strong> Sold purely as a quantum-communications company, the programme is exposed on four axes: buyers in this market want a track record; incumbents have effectively unlimited runway; the sales cycle is measured in years; and quantum key distribution is not universally better than software-only post-quantum cryptography. Each is a reason to keep a captive first platform and a working software floor under the optical path — not a reason to hide the programme inside another one.</p>
        <p><strong>The bottleneck, in detail.</strong> BB84, decoy-state and BBM92 are settled. The unsolved engineering is the terminal: acquisition, tracking and pointing to sub-microradian accuracy against a fast-moving counterpart; an optical bench that survives launch loads and then holds alignment through thermal cycling; detectors with usable dark-count rates after a radiation dose. Budget weight belongs on the bench and the pointing loop, not on protocol research.</p>
        <p><strong>Platform strategy.</strong> Rungs 03 and 04 are the two most expensive in the ladder, and both need a flying platform. Sharing a mechanical bus, thermal budget and power budget with an aerospace programme that exists anyway collapses them into a payload integration rather than a separate bus, launch contract and platform team. That is a cost argument about hardware, and it does not make the communications layer a subsystem of the vehicle carrying it.</p>
        <p><strong>QKD against post-quantum cryptography.</strong> The decision tree is the part of this briefing most often skipped. Software post-quantum key encapsulation covers the large majority of operator requirements today, ships without an optical terminal, and is the floor under every Akasha-Q deployment. The quantum path earns its cost only where key exchange must not depend on a hardness assumption at all, or where an evidence chain has to outlive that assumption. Selling it anywhere else is how this market loses credibility.</p>
        <p style="color:#9aa6b6;font-size:13px;font-style:italic;">Full blueprint — appendices, glossary, precedent missions, the QKD-versus-PQC decision tree, staged budget and risk register — available through the secure document portal. Contact the founding team.</p>
      </div>
    </section>
  )}

  <!-- Reachability: this page is not a dead end -->
  <section class="aq-links">
    <a href="/products/visvambhara" class="aq-link">
      <p class="aq-link-eye">Related programme</p>
      <p class="aq-link-t">Viśvambhara</p>
      <p class="aq-link-d">The autonomous aerospace swarm designed against this trust layer, and the first platform to carry a terminal.</p>
    </a>
    <a href="/ecosystem" class="aq-link">
      <p class="aq-link-eye">The rest of the lab</p>
      <p class="aq-link-t">Ecosystem</p>
      <p class="aq-link-d">Every venture and research line EduRankAI is building, with what is live and what is not.</p>
    </a>
    <a href="/careers" class="aq-link">
      <p class="aq-link-eye">Hiring</p>
      <p class="aq-link-t">Open roles</p>
      <p class="aq-link-d">Pointing systems and optomechanics lead this programme. Roles are listed by team, not by venture.</p>
    </a>
  </section>

</main>
</BaseLayout>
