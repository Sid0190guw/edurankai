---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HERO, MISSION, PILLARS } from '@/data/home';
// Edge-caching for anonymous visitors is handled centrally in middleware (isPublicCacheable).

// Safely fetch live role count with fallback
let liveRoleCount = 213;
try {
  const { db } = await import('@/lib/db');
  const { roles } = await import('@/lib/db/schema');
  const { eq } = await import('drizzle-orm');
  const result = await db.select({ id: roles.id }).from(roles).where(eq(roles.isOpen, true));
  if (result.length > 0) liveRoleCount = result.length;
} catch (err) {
  console.error('[homepage] live role count failed, using fallback:', err);
}

// A pillar may point off-site — the card below already sets target/rel for that case.
// PILLARS in src/data/home.ts currently holds internal links only, so `external` is
// declared optional rather than dropping the handling the template relies on.
type Pillar = {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  cta: string;
  external?: boolean;
};

const dynamicPillars: Pillar[] = PILLARS.map((p, i) => i === 2 ? { ...p, title: liveRoleCount + ' open roles' } : p);

const DIMENSIONS = [
  { letter: 'P', title: 'Physical', desc: 'Active health, energy, stamina, body awareness.', color: 'burn' },
  { letter: 'M', title: 'Mental', desc: 'Clarity, focus, resilience, learning capacity.', color: 'sky' },
  { letter: 'E', title: 'Emotional', desc: 'Self-awareness, empathy, regulation, feedback.', color: 'plum' },
  { letter: 'S', title: 'Social', desc: 'Collaboration, communication, team trust.', color: 'teal' },
  { letter: 'Sp', title: 'Spiritual', desc: 'Purpose, values, meaning beyond the task.', color: 'gold' }
];

---
<BaseLayout title="EduRankAI - Frontier AI Research & Engineering. Building toward ASI." description="EduRankAI is an advanced AI research and engineering company building foundational models, reasoning systems, and multimodal architectures — the intelligent infrastructure for education, careers, research and innovation.">

  <!-- ============ HERO ============ -->
  <section class="era-hero">
    <canvas id="era-hero-net" class="era-hero-net" aria-hidden="true"></canvas>
    <div class="era-hero-inner">
      <p class="eyebrow era-hero-eyebrow">{HERO.eyebrow}</p>
      <h1 class="era-hero-h1">
        {HERO.headline}<br/><em>{HERO.headlineEm}</em>
      </h1>
      <p class="era-hero-desc">{HERO.description}</p>
      <div class="era-hero-cta">
        <a href="/research" data-magnetic="0.15" class="btn-primary">Read the research</a>
        <a href="/ecosystem" data-magnetic="0.15" class="btn-ghost">Explore the ecosystem &rarr;</a>
      </div>
      <div class="era-hero-tags">
        <span>Foundation models</span><span>Reasoning systems</span><span>Multimodal intelligence</span><span>Research infrastructure</span>
      </div>
    </div>
    <div class="era-scrollcue" aria-hidden="true"><span></span></div>
  </section>

  <!-- ============ POSITIONING STRIP ============ -->
  <section class="era-strip">
    <div class="era-strip-inner">
      <p class="era-strip-lead">EduRankAI builds technology — it does not merely apply it.</p>
      <p class="era-strip-sub">An AI research and engineering company developing proprietary foundation models, reasoning systems and research infrastructure that power an ecosystem across education, careers, research and innovation.</p>
    </div>
  </section>

  <!-- ============ 3 PILLARS ============ -->
  <section class="era-sec">
    <div class="era-wrap">
      <div data-stagger="120" class="era-pillars">
        {dynamicPillars.map((p) => (
          <a href={p.href} target={p.external ? '_blank' : '_self'} rel={p.external ? 'noopener noreferrer' : ''} class="era-card era-pillar group">
            <p class="era-card-eyebrow">{p.eyebrow}</p>
            <h3 class="era-card-title">{p.title}</h3>
            <p class="era-card-body">{p.description}</p>
            <span class="era-card-link">{p.cta} <span>&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MISSION / RESEARCH THESIS ============ -->
  <section data-reveal class="era-sec era-bordered">
    <div class="era-wrap era-mission">
      <div class="era-mission-head">
        <p class="eyebrow mb-3">{MISSION.eyebrow}</p>
        <h2 class="section-title" set:html={MISSION.title}></h2>
      </div>
      <div class="era-mission-body">
        {MISSION.body.map((p) => (<p>{p}</p>))}
      </div>
    </div>
  </section>

  <!-- ============ 5 DIMENSIONS ============ -->
  <section data-reveal class="era-sec era-bordered">
    <div class="era-wrap">
      <div class="era-secintro">
        <p class="eyebrow mb-3">Why education</p>
        <h2 class="section-title mb-3">We see the <em>whole person.</em></h2>
        <p class="era-secintro-sub">Our reasoning models are anchored in education because learning is where intelligence develops — and the intelligence we want machines to have looks like the kind we cultivate in humans, across all five dimensions of being.</p>
      </div>
      <div class="era-dims">
        {DIMENSIONS.map((d) => (
          <div class={'era-card era-dim dim-' + d.color}>
            <div class="era-dim-badge">{d.letter}</div>
            <p class="era-dim-title">{d.title}</p>
            <p class="era-dim-desc">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BHARAT CLOSER ============ -->
  <section class="era-sec era-closer era-bordered">
    <div class="era-closer-inner">
      <p class="eyebrow mb-4">Where we build</p>
      <h2 class="era-closer-h2">Rooted in <em>Bharat.</em><br/>Built for everyone.</h2>
      <p class="era-closer-p">Every breakthrough in modern AI has come from one geography. We think the next one comes from a different place. EduRankAI is a frontier lab built in India — because the most consequential ideas should not all be born within a five-mile radius of the same bay.</p>
      <div class="era-hero-cta" style="justify-content:center;">
        <a href="/careers" class="btn-primary">Join us &rarr;</a>
        <a href="/ecosystem" class="btn-ghost">Explore the ecosystem</a>
      </div>
    </div>
  </section>

  <style>
    /* ===== EduRankAI homepage — premium research-first system. Saffron = #FF4F00 signature. ===== */
    .era-hero { position: relative; overflow: hidden; padding: clamp(90px, 15vh, 180px) 5vw clamp(70px, 11vh, 130px); isolation: isolate; }
    .era-hero-net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1;
      -webkit-mask-image: radial-gradient(120% 90% at 60% 30%, #000 45%, transparent 100%);
      mask-image: radial-gradient(120% 90% at 60% 30%, #000 45%, transparent 100%); opacity: 0.9; }
    .era-hero-inner { max-width: 1120px; margin: 0 auto; }
    .era-hero-eyebrow { margin-bottom: 22px; }
    .era-hero-h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -0.022em;
      font-size: clamp(2.7rem, 6.4vw, 5.4rem); line-height: 1.015; color: #16130f; margin: 0 0 26px; max-width: 16ch; }
    .era-hero-h1 em { font-style: italic; font-weight: 500; color: #FF4F00; }
    .era-hero-desc { font-size: clamp(1.02rem, 1.5vw, 1.2rem); line-height: 1.75; font-weight: 300; color: #4a463f; max-width: 40rem; margin: 0 0 34px; }
    .era-hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
    .era-hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 34px; }
    .era-hero-tags span { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: #6b6459; border: 1px solid rgba(22,19,15,0.12); border-radius: 100px; padding: 5px 12px; background: rgba(255,255,255,0.5); }
    .era-scrollcue { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); width: 22px; height: 34px;
      border: 1.5px solid rgba(22,19,15,0.2); border-radius: 12px; display: flex; justify-content: center; padding-top: 6px; }
    .era-scrollcue span { width: 3px; height: 8px; border-radius: 3px; background: #FF4F00; animation: eraScroll 1.7s var(--ease-out-expo, cubic-bezier(.16,1,.3,1)) infinite; }
    @keyframes eraScroll { 0% { opacity: 0; transform: translateY(-3px); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }

    .era-wrap { max-width: 1120px; margin: 0 auto; padding: 0 5vw; }
    .era-sec { padding: clamp(60px, 9vw, 120px) 0; }
    .era-bordered { border-top: 1px solid rgba(22,19,15,0.08); }

    /* positioning strip */
    .era-strip { background: #16130f; color: #fbf5f3; padding: clamp(46px, 7vw, 84px) 5vw; }
    .era-strip-inner { max-width: 1000px; margin: 0 auto; }
    .era-strip-lead { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.5rem, 3.2vw, 2.5rem); line-height: 1.18; letter-spacing: -0.015em; margin: 0 0 16px; }
    .era-strip-lead::after { content: ''; display: block; width: 46px; height: 3px; background: #FF4F00; margin-top: 20px; border-radius: 2px; }
    .era-strip-sub { font-size: clamp(0.95rem, 1.3vw, 1.08rem); line-height: 1.8; font-weight: 300; color: rgba(251,245,243,0.72); max-width: 44rem; margin: 0; }

    /* cards */
    .era-card { display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(22,19,15,0.09); border-radius: 20px;
      padding: 26px; transition: transform .5s var(--ease-out-expo, cubic-bezier(.16,1,.3,1)), box-shadow .5s ease, border-color .4s ease; will-change: transform; }
    .era-card:hover { transform: translateY(-6px); border-color: rgba(255,79,0,0.4); box-shadow: 0 26px 50px -22px rgba(22,19,15,0.28); }
    .era-pillars { display: grid; grid-template-columns: 1fr; gap: 16px; }
    @media (min-width: 820px) { .era-pillars { grid-template-columns: repeat(3, 1fr); } }
    .era-card-eyebrow { font-family: 'Geist Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: #FF4F00; font-weight: 700; margin: 0 0 14px; }
    .era-card-title { font-family: 'Fraunces', serif; font-size: 1.4rem; font-weight: 600; color: #16130f; line-height: 1.15; margin: 0 0 12px; }
    .era-card-body { font-size: 0.9rem; line-height: 1.65; font-weight: 300; color: #5a544b; flex: 1; margin: 0 0 18px; }
    .era-card-link { font-size: 0.84rem; font-weight: 600; color: #FF4F00; display: inline-flex; align-items: center; gap: 6px; transition: gap .3s ease; }
    .era-card:hover .era-card-link { gap: 11px; }

    /* mission editorial grid */
    .era-mission { display: grid; grid-template-columns: 1fr; gap: 30px; }
    @media (min-width: 860px) { .era-mission { grid-template-columns: 4fr 7fr; gap: 60px; } }
    .era-mission-body p { font-size: 1rem; line-height: 1.95; font-weight: 300; color: #46413a; margin: 0 0 20px; }
    .era-mission-body p:last-child { margin-bottom: 0; }

    /* section intros */
    .era-secintro { max-width: 46rem; margin: 0 0 46px; }
    .era-secintro-sub { font-size: 0.98rem; line-height: 1.85; font-weight: 300; color: #5a544b; margin: 0; }


    /* five dimensions */
    .era-dims { display: grid; grid-template-columns: 1fr; gap: 12px; }
    @media (min-width: 560px) { .era-dims { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1000px) { .era-dims { grid-template-columns: repeat(5, 1fr); } }
    .era-dim { padding: 22px; }
    .era-dim-badge { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 600; border: 1px solid; margin-bottom: 14px; }
    .era-dim-title { font-family: 'Fraunces', serif; font-size: 1.05rem; font-weight: 600; color: #16130f; margin: 0 0 6px; }
    .era-dim-desc { font-size: 0.79rem; line-height: 1.6; font-weight: 300; color: #6b6459; margin: 0; }
    .dim-burn .era-dim-badge { color: #FF4F00; background: #fff2ec; border-color: #ffd4c2; }
    .dim-sky .era-dim-badge { color: #1045BB; background: #eef2ff; border-color: #c9d6ff; }
    .dim-plum .era-dim-badge { color: #a11d6b; background: #fdeef7; border-color: #f3c9e2; }
    .dim-teal .era-dim-badge { color: #0a7ea4; background: #e9f7fb; border-color: #bfe6f1; }
    .dim-gold .era-dim-badge { color: #8a5a00; background: #fdf6e6; border-color: #f0dfab; }

    /* closer */
    .era-closer { background: linear-gradient(180deg, rgba(251,245,243,0.5), rgba(251,245,243,0.9)); text-align: center; }
    .era-closer-inner { max-width: 46rem; margin: 0 auto; padding: 0 5vw; }
    .era-closer-h2 { font-family: 'Fraunces', serif; font-weight: 600; letter-spacing: -0.02em; font-size: clamp(2rem, 4.6vw, 3.3rem); line-height: 1.08; color: #16130f; margin: 0 0 22px; }
    .era-closer-h2 em { font-style: italic; font-weight: 500; color: #FF4F00; }
    .era-closer-p { font-size: 1rem; line-height: 1.85; font-weight: 300; color: #46413a; margin: 0 0 30px; }

    @media (prefers-reduced-motion: reduce) {
      .era-scrollcue span { animation: none; }
      .era-card { transition: none; }
    }
  </style>

  <script is:inline>
    /* Signature node-network backdrop — the EduRankAI research visual language: computational nodes
       drifting and connecting. Self-contained, capped for 60fps, paused off-tab, off under reduced motion. */
    (function () {
      var c = document.getElementById('era-hero-net');
      if (!c || !c.getContext) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ctx = c.getContext('2d'), dpr = Math.min(window.devicePixelRatio || 1, 2);
      var nodes = [], W = 0, H = 0, raf = 0, running = true;
      function size() {
        var r = c.getBoundingClientRect(); W = r.width; H = r.height;
        c.width = W * dpr; c.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var target = Math.max(24, Math.min(70, Math.floor(W * H / 16000)));
        nodes = [];
        for (var i = 0; i < target; i++) nodes.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25 });
      }
      function frame() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < nodes.length; i++) {
          var n = nodes[i];
          if (!reduce) { n.x += n.vx; n.y += n.vy; }
          if (n.x < 0 || n.x > W) n.vx *= -1;
          if (n.y < 0 || n.y > H) n.vy *= -1;
        }
        for (var a = 0; a < nodes.length; a++) {
          for (var b = a + 1; b < nodes.length; b++) {
            var dx = nodes[a].x - nodes[b].x, dy = nodes[a].y - nodes[b].y, dd = dx * dx + dy * dy;
            if (dd < 15000) {
              var al = (1 - dd / 15000) * 0.16;
              ctx.strokeStyle = 'rgba(255,79,0,' + al + ')'; ctx.lineWidth = 1;
              ctx.beginPath(); ctx.moveTo(nodes[a].x, nodes[a].y); ctx.lineTo(nodes[b].x, nodes[b].y); ctx.stroke();
            }
          }
        }
        for (var j = 0; j < nodes.length; j++) {
          ctx.beginPath(); ctx.arc(nodes[j].x, nodes[j].y, 1.6, 0, 6.2832);
          ctx.fillStyle = 'rgba(22,19,15,0.28)'; ctx.fill();
        }
        if (running && !reduce) raf = requestAnimationFrame(frame);
      }
      size(); frame();
      var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { size(); if (reduce) frame(); }, 200); });
      document.addEventListener('visibilitychange', function () {
        running = !document.hidden;
        if (running && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); } else { cancelAnimationFrame(raf); }
      });
    })();
  </script>

</BaseLayout>
