---
// /upcoming — where a feature that is not open yet explains itself.
//
// Reached by redirect from src/middleware.ts, which catches every door into a held-back feature at
// once rather than leaving six pages to each remember. The querystring names which one, so this page
// can say something specific instead of a generic "coming soon" that answers nobody.
//
// THE POINT IS THE SENTENCE ABOUT WHAT TO DO NOW. Somebody who came here wanted to send a message.
// Telling them the feature is coming does not help them; telling them where the decision they were
// about to make actually belongs does.
//
// No layout gate: this page must render for a signed-out visitor who followed an old link as
// happily as for an employee, and it discloses nothing.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UPCOMING, upcomingFeature } from '@/lib/upcoming';

const key = String(Astro.url.searchParams.get('f') || '');
const feature = upcomingFeature(key);
---

<BaseLayout title={feature ? feature.label + ' is coming' : 'Not open yet'}>
  <main style="max-width:620px;margin:0 auto;padding:64px 20px 96px;">

    <p style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;opacity:0.55;margin:0 0 12px;">
      Not open yet
    </p>

    {feature ? (
      <div>
        <h1 style="font-size:1.9rem;line-height:1.2;margin:0 0 16px;">{feature.label} is coming</h1>
        <p style="font-size:1.02rem;line-height:1.7;opacity:0.85;margin:0 0 28px;">{feature.note}</p>
        {feature.insteadHref && (
          <a href={feature.insteadHref}
             style="display:inline-block;min-height:46px;line-height:46px;padding:0 20px;border-radius:10px;background:#FF4F00;color:#fff;font-weight:600;">
            {feature.insteadLabel || 'Go back'}
          </a>
        )}
      </div>
    ) : (
      <div>
        <h1 style="font-size:1.9rem;line-height:1.2;margin:0 0 16px;">That part is not open yet</h1>
        <p style="font-size:1.02rem;line-height:1.7;opacity:0.85;margin:0 0 20px;">
          You followed a link to something being finished rather than something that broke. These are
          the parts currently held back:
        </p>
        <ul style="margin:0 0 28px;padding-left:20px;line-height:1.9;">
          {UPCOMING.map((f) => (<li><strong>{f.label}</strong></li>))}
        </ul>
        <a href="/portal/employee"
           style="display:inline-block;min-height:46px;line-height:46px;padding:0 20px;border-radius:10px;background:#FF4F00;color:#fff;font-weight:600;">
          Back to your workspace
        </a>
      </div>
    )}

  </main>
</BaseLayout>
