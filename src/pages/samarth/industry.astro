---
// /samarth/industry - Component 01: tertiary, secondary and manufacturing transformation.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { SECTORS, TOPICS, CLIENT_EMPOWERMENT } from '@/lib/samarth/catalog';

const related = TOPICS.filter((t) => ['manufacturing-transformation', 'industrial-automation', 'robotics', 'intelligent-systems', 'enterprise-software', 'ai-engineering'].includes(t.slug));
---
<SamarthShell
  title="Industrial and Enterprise Technology Transformation | SAMARTH"
  description="SAMARTH helps service organisations, industry and manufacturers adopt intelligent systems, automation, AI and engineering, from assessment to delivery, worldwide."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Industry', href: '/samarth/industry' }]}
  active="industry">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Component 01</p>
    <h1 class="sam-h1">Industrial and enterprise <em>technology transformation</em></h1>
    <p class="sam-lead">Technology adoption, research, engineering, intelligent systems and complete transformation for organisations across services, industry and manufacturing, in any country.</p>
    <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register for a consultation</a></div>
  </section>

  {SECTORS.map((s) => (
    <section class="sam-sec" id={s.id}>
      <div class="sam-wrap">
        <p class="sam-eyebrow">{s.id === 'manufacturing' ? 'Dedicated vertical' : 'Sector'}</p>
        <h2 class="sam-h2">{s.title}</h2>
        <p class="sam-p" style="max-width:46rem;">{s.lead}</p>
        <div class="sam-grid two" style="margin-top:14px;">
          <div class="sam-card">
            <h3 class="sam-h3">Industries</h3>
            <div>{s.industries.map((i) => <span class="sam-tag">{i}</span>)}</div>
          </div>
          <div class="sam-card">
            <h3 class="sam-h3">{s.id === 'manufacturing' ? 'Services' : 'Potential solutions'}</h3>
            <ul class="sam-list">{s.solutions.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
        {s.id === 'manufacturing' && <p class="sam-note" style="margin-top:14px;">The aim is to help conventional manufacturers become connected, intelligent and technology-driven operations, starting from the losses that matter most on the lines they already run.</p>}
      </div>
    </section>
  ))}

  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div>
        <h2 class="sam-h2">Your team keeps the capability</h2>
        <p class="sam-p">Every delivery includes what your people need to operate, maintain and develop what was built.</p>
        <ul class="sam-list">{CLIENT_EMPOWERMENT.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2 class="sam-h2">Related capabilities</h2>
        <div class="sam-grid">{related.map((t) => <a class="sam-card" href={'/samarth/services/' + t.slug} style="padding:16px;"><h3 class="sam-h3" style="font-size:1rem;">{t.title}</h3><p class="sam-p" style="font-size:0.84rem;margin:0;">{t.description}</p></a>)}</div>
      </div>
    </div>
  </section>
</SamarthShell>
