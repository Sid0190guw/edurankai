---
// /samarth/consultation - the consultation workflow and the PUBLISHED booking fees, shown before
// anybody books: fee, currency, tax, any payment charge, the terms, and how payment is confirmed.
//
// Only APPROVED fee rows are shown (src/lib/samarth/fees.ts). No amount is ever invented: when no
// fee has been approved the page says so, and registration still works up to the fee step.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { approvedFees, breakdownFor, type FeeRow } from '@/lib/samarth/fees';
import { categoryLabel, APPLICANT_CATEGORIES, ANY_CATEGORY } from '@/lib/samarth/categories';
import { formatMoney, currencyDef } from '@/lib/samarth/currency';
import { CONSULTATION_PROCESS, AI_ASSISTANCE_NOTICE } from '@/lib/samarth/catalog';

const fees = await approvedFees();
// Tables that do not exist yet mean no fee has been published, which is exactly what the page then
// says. Only a real read failure is reported as an error (and kept out of the edge cache).
const notSetUp = !fees.ready && !!(fees as any).missing;
const readFailed = !fees.ready && !notSetUp;
if (readFailed) Astro.response.headers.set('x-era-degraded', '1');
const list: FeeRow[] = fees.ready ? fees.value : [];
const order = [ANY_CATEGORY, ...APPLICANT_CATEGORIES.map((c) => c.value)];
const grouped = order
  .map((cat) => ({ cat, rows: list.filter((f) => f.category === cat).sort((a, b) => a.currency.localeCompare(b.currency)) }))
  .filter((g) => g.rows.length);

const FAQ = [
  { q: 'Who pays the consultation booking fee?', a: 'Every applicant: governments and public-sector bodies, international organisations, businesses, startups, universities, research institutions and individuals. The fee for your category and currency is shown here and again before you pay.' },
  { q: 'Is the booking fee part of a later package or project?', a: 'No. It is separate from consultancy packages, engineering costs, government project proposals, infrastructure projects and implementation charges. Any later engagement has its own approved quotation and terms.' },
  { q: 'Can a government body pay against an invoice?', a: 'Yes. Any applicant may choose payment against an invoice, which suits procurement rules that require one. The call is booked once the payment is recorded.' },
  { q: 'How do I know my payment went through?', a: 'Your request moves to "fee paid" only when the payment provider confirms the payment to our server, or when the SAMARTH team records a payment against your invoice. A redirect in your browser is never treated as payment. You receive an email and a receipt.' },
  { q: 'Is the consultation given by AI?', a: 'No. ' + AI_ASSISTANCE_NOTICE },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SamarthShell
  title="SAMARTH Consultation and Booking Fee"
  description="How a SAMARTH consultation works: registration, your details and requirements, the consultation booking fee by category and currency, call booking and a human consultant."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Consultation', href: '/samarth/consultation' }]}
  jsonLd={[faqLd]}
  active="consultation">

  <section class="sam-wrap sam-hero" style="padding-bottom:24px;">
    <p class="sam-eyebrow">Consultation</p>
    <h1 class="sam-h1">One path for <em>every applicant</em></h1>
    <p class="sam-lead">Registration, your details, your project requirements, the consultation booking fee, booking the call, and a human consultant. Governments and public-sector bodies follow the same path and also record their department, authorised representative and procurement requirements.</p>
    <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register</a><a class="sam-btn ghost" href="/samarth/r">Continue an existing request</a></div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">The six steps</h2>
      <ol class="sam-steps" style="margin-top:14px;">
        {CONSULTATION_PROCESS.map((s) => <li><strong>{s.step}.</strong> {s.detail}</li>)}
      </ol>
    </div>
  </section>

  <section class="sam-sec" id="fees">
    <div class="sam-wrap">
      <p class="sam-eyebrow">Consultation booking fee</p>
      <h2 class="sam-h2">Fees by applicant category and currency</h2>
      <p class="sam-p" style="max-width:48rem;">Shown in the currency it is priced in. Payment online is charged in Indian rupees at the live reference exchange rate, which is shown to you with the rupee amount before you pay; your card issuer may apply its own conversion. Payment against an invoice is also available.</p>

      {readFailed && <div class="sam-flash err">The published fees could not be loaded just now. Please reload in a moment. Nothing about your request is affected.</div>}

      {!readFailed && grouped.length === 0 && (
        <div class="sam-note">
          <strong>The consultation booking fee has not been published yet.</strong> It is being set for each applicant category and currency and will appear here once approved. You can register and describe your project now; booking opens as soon as the fee for your category and currency is published, and we will let you know.
        </div>
      )}

      {grouped.map((g) => (
        <div class="sam-card" style="margin-bottom:14px;">
          <h3 class="sam-h3">{g.cat === ANY_CATEGORY ? 'All applicant categories' : categoryLabel(g.cat)}</h3>
          {g.cat === ANY_CATEGORY && <p class="sam-p" style="font-size:0.84rem;">Applies to every category that has no fee of its own in that currency.</p>}
          <div class="sam-scroll">
            <table class="sam-table">
              <thead><tr><th>Currency</th><th>Fee</th><th>Tax</th><th>Payment charge</th><th>Total</th></tr></thead>
              <tbody>
                {g.rows.map((f) => {
                  const b = breakdownFor(f);
                  return (
                    <tr>
                      <td>{f.currency}<br /><span style="font-size:0.75rem;color:#7a7266;">{currencyDef(f.currency)?.name}</span></td>
                      <td>{formatMoney(f.taxMode === 'inclusive' ? f.amountMinor : b.base, f.currency)}{f.taxMode === 'inclusive' ? ' incl. tax' : ''}</td>
                      <td>{f.taxMode === 'none' ? 'None' : f.taxLabel + ' ' + (f.taxRateBp / 100) + '%' + (f.taxMode === 'inclusive' ? ' (included)' : '')}</td>
                      <td>{f.processingBp ? (f.processingBp / 100) + '%' : 'None'}{f.chargesNote ? <span style="display:block;font-size:0.75rem;color:#7a7266;">{f.chargesNote}</span> : ''}</td>
                      <td><strong>{formatMoney(b.total, f.currency)}</strong></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {g.rows.map((f) => (
            <details style="margin-top:10px;">
              <summary style="cursor:pointer;font-size:0.86rem;font-weight:600;">Payment terms ({f.currency})</summary>
              <p class="sam-p" style="white-space:pre-wrap;font-size:0.86rem;margin-top:8px;">{f.terms}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div>
        <h2 class="sam-h2">How payment is confirmed</h2>
        <ol class="sam-steps">
          <li><strong>Before you pay</strong> you see the fee, its currency, any tax, any payment charge, the total, the terms and, for online payment, the rupee amount and exchange rate.</li>
          <li><strong>Online:</strong> the payment provider confirms the payment directly to our server. Your browser returning from the payment page is never treated as proof of payment.</li>
          <li><strong>Against an invoice:</strong> the SAMARTH team issues the invoice, and records your payment with its reference when it arrives.</li>
          <li><strong>Then</strong> you receive a confirmation email and receipt, and your request opens for call booking.</li>
        </ol>
      </div>
      <div>
        <h2 class="sam-h2">What the fee is not</h2>
        <p class="sam-p">The booking fee secures a formal consultation call with a SAMARTH consultant. It is separate from, and not part of, consultancy packages, engineering costs, government project proposals, infrastructure projects and implementation charges.</p>
        <p class="sam-p">Anything proposed after the consultation is a separate engagement with its own scope, price, terms and an internally approved quotation, which you accept or decline. See the <a href="/samarth/consultancy" style="color:#FF4F00;">consultancy packages</a>.</p>
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-narrow">
      <h2 class="sam-h2">Questions</h2>
      {FAQ.map((f) => (
        <details class="sam-card" style="margin-bottom:10px;padding:16px 18px;">
          <summary style="cursor:pointer;font-weight:650;">{f.q}</summary>
          <p class="sam-p" style="margin:10px 0 0;">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</SamarthShell>
