---
// /samarth/engineering - engineering, technology transfer, intelligent infrastructure, delivery
// models and client empowerment (spec Parts 7, 8 and 9).
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { ENGINEERING_DOMAINS, REGULATED_WORK_NOTICE, TECHNOLOGY_TRANSFER, INTELLIGENT_INFRASTRUCTURE, INFRASTRUCTURE_LIFECYCLE, DELIVERY_MODELS, ACCOUNTABILITY_NOTICE, CLIENT_EMPOWERMENT } from '@/lib/samarth/catalog';
---
<SamarthShell
  title="Engineering, Technology Transfer and Intelligent Infrastructure | SAMARTH"
  description="SAMARTH delivers software, AI, advanced computing, industrial systems, energy and intelligent infrastructure, and technology transfer, with internal teams and selected partners."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Engineering', href: '/samarth/engineering' }]}
  active="engineering">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Beyond consultancy reports</p>
    <h1 class="sam-h1">Engineering, technology transfer and <em>intelligent infrastructure</em></h1>
    <p class="sam-lead">Complete technology development, acquisition, integration, engineering and deployment, from a website to a computing facility. Every engineering engagement is scoped and quoted separately after a consultation.</p>
    <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register for a consultation</a></div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">What we build</h2>
      <div class="sam-grid three" style="margin-top:14px;">
        {ENGINEERING_DOMAINS.map((d) => <div class="sam-card" id={d.id}><h3 class="sam-h3">{d.title}</h3><ul class="sam-list">{d.items.map((x) => <li>{x}</li>)}</ul></div>)}
      </div>
      <p class="sam-note" style="margin-top:16px;">{REGULATED_WORK_NOTICE}</p>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div>
        <h2 class="sam-h2">Technology transfer</h2>
        <ul class="sam-list">{TECHNOLOGY_TRANSFER.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2 class="sam-h2">Intelligent infrastructure</h2>
        <ul class="sam-list">{INTELLIGENT_INFRASTRUCTURE.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Infrastructure lifecycle</h2>
      <ol class="sam-steps" style="margin-top:14px;">{INFRASTRUCTURE_LIFECYCLE.map((s) => <li>{s}</li>)}</ol>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Three ways to deliver</h2>
      <div class="sam-grid three" style="margin-top:14px;">
        {DELIVERY_MODELS.map((m, i) => <div class="sam-card"><p class="sam-eyebrow" style="margin-bottom:6px;">Model {String.fromCharCode(65 + i)}</p><h3 class="sam-h3">{m.title}</h3><p class="sam-p" style="font-size:0.88rem;margin:0;">{m.detail}</p></div>)}
      </div>
      <p class="sam-note" style="margin-top:16px;">{ACCOUNTABILITY_NOTICE}</p>
      <a class="sam-btn ghost" href="/samarth/partners">Register as a technology partner</a>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Client empowerment</h2>
      <p class="sam-p">Clients must be able to operate, maintain and develop what is delivered to them.</p>
      <div>{CLIENT_EMPOWERMENT.map((x) => <span class="sam-tag">{x}</span>)}</div>
    </div>
  </section>
</SamarthShell>
