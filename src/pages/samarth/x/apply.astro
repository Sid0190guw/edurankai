---
// /samarth/x/apply - the public SAMARTH X expression of interest. Free; never creates a payment.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { parseX, createX, X_DOMAINS } from '@/lib/samarth/x';
import { countryOptions } from '@/lib/samarth/validate';
import { setAccessCookie, isSecureRequest } from '@/lib/samarth/access';
import { emailXReceived, alertAdmins } from '@/lib/samarth/notify';
import { publicMessage } from '@/lib/samarth/schema';
import { clientIp, overPublicFormLimit } from '@/lib/public-form-limit';
import { SAMARTH_X } from '@/lib/samarth/catalog';

const COUNTRIES = countryOptions();
let error = '';
let f: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const get = (n: string) => String(fd.get(n) ?? '');
  for (const [k, v] of fd.entries()) if (typeof v === 'string') f[k] = v;
  if (get('website_hp')) return Astro.redirect('/samarth/x');
  const p = parseX(get, false);
  if (p.problems.length) error = p.problems.join(' ');
  else {
    const limit = await overPublicFormLimit('samarth-x', clientIp(Astro.request.headers), { whenUnavailable: 'refuse', max: 6 });
    if (limit.blocked) error = 'Several applications have come from your connection in the last hour. Please try again later.';
    else {
      const r = await createX(p.value, 'eoi', { userId: null, name: p.value.name });
      if (!r.ok) error = publicMessage(r.error);
      else {
        setAccessCookie(Astro.cookies, r.ref, r.token, isSecureRequest(Astro.url));
        await emailXReceived(p.value.email, p.value.name, r.ref, r.token);
        await alertAdmins('samarth_x', 'New SAMARTH X application', r.ref + ': ' + p.value.name + (p.value.ventureName ? ' (' + p.value.ventureName + ')' : '') + ', ' + p.value.domain + '.', '/admin/samarth/x/' + r.id, 'samx-' + r.id);
        return Astro.redirect('/samarth/x/status/' + r.ref + '?welcome=1');
      }
    }
  }
}
---
<SamarthShell
  title="Apply to SAMARTH X"
  description="Express your interest in SAMARTH X as an individual or a team. No fee at any stage."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'SAMARTH X', href: '/samarth/x' }, { label: 'Apply', href: '/samarth/x/apply' }]}
  active="x">
  <section class="sam-narrow" style="padding:36px 16px 80px;">
    <p class="sam-eyebrow">SAMARTH X &middot; Expression of interest</p>
    <h1 class="sam-h1" style="font-size:clamp(2rem,4.6vw,3rem);">Tell us what you want to build</h1>
    <p class="sam-p">{SAMARTH_X.noFee} An expression of interest is an application for consideration, not admission.</p>
    {error && <div class="sam-flash err" role="alert">{error}</div>}
    <form method="POST" class="sam-form">
      <div class="sam-hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
      <fieldset><legend class="sam-legend">Applying as</legend>
        <div class="sam-choice" style="margin-top:8px;">
          <label><input type="radio" name="applicant_kind" value="individual" checked={f.applicant_kind !== 'team'} /><span><b>An individual</b></span></label>
          <label><input type="radio" name="applicant_kind" value="team" checked={f.applicant_kind === 'team'} /><span><b>A team</b><small>Add your team members below.</small></span></label>
        </div>
      </fieldset>
      <div class="sam-row2">
        <div class="sam-field"><label for="name">Your name</label><input id="name" name="name" type="text" required maxlength="200" value={f.name || ''} /></div>
        <div class="sam-field"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="254" value={f.email || ''} /></div>
      </div>
      <div class="sam-row2">
        <div class="sam-field"><label for="country">Country</label><select id="country" name="country" required><option value="">Choose a country</option>{COUNTRIES.map((c) => <option value={c.code} selected={f.country === c.code}>{c.name}</option>)}</select></div>
        <div class="sam-field"><label for="phone">Phone (optional)</label><input id="phone" name="phone" type="tel" maxlength="32" value={f.phone || ''} /></div>
      </div>
      <div class="sam-row2">
        <div class="sam-field"><label for="venture_name">Proposed startup or project name (optional)</label><input id="venture_name" name="venture_name" type="text" maxlength="200" value={f.venture_name || ''} /></div>
        <div class="sam-field"><label for="domain">Technology domain</label><select id="domain" name="domain" required><option value="">Choose one</option>{X_DOMAINS.map((d) => <option value={d} selected={f.domain === d}>{d}</option>)}</select></div>
      </div>
      <div class="sam-field"><label for="problem">The problem you want to solve</label><textarea id="problem" name="problem" required maxlength="4000">{f.problem || ''}</textarea></div>
      <div class="sam-field"><label for="proposed_system">The AI or intelligent system you propose to build</label><textarea id="proposed_system" name="proposed_system" required maxlength="4000">{f.proposed_system || ''}</textarea></div>
      <div class="sam-field"><label for="skills">Your technical skills</label><textarea id="skills" name="skills" required maxlength="3000">{f.skills || ''}</textarea></div>
      <div class="sam-field"><label for="previous_work">Previous work (optional)</label><textarea id="previous_work" name="previous_work" maxlength="4000">{f.previous_work || ''}</textarea></div>
      <div class="sam-row2">
        <div class="sam-field"><label for="github_url">Code repository (optional)</label><input id="github_url" name="github_url" type="url" maxlength="800" placeholder="https://" value={f.github_url || ''} /></div>
        <div class="sam-field"><label for="portfolio_url">Portfolio (optional)</label><input id="portfolio_url" name="portfolio_url" type="url" maxlength="800" placeholder="https://" value={f.portfolio_url || ''} /></div>
      </div>
      <div class="sam-field"><label for="prototype_url">Prototype or demo link (optional)</label><input id="prototype_url" name="prototype_url" type="url" maxlength="800" placeholder="https://" value={f.prototype_url || ''} /></div>
      <fieldset><legend class="sam-legend">Team members (for team applications)</legend>
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <div class="sam-row2" style="margin-bottom:8px;grid-template-columns:1fr 1fr 1fr;">
            <input name={'team_name_' + i} type="text" maxlength="200" placeholder="Name" value={f['team_name_' + i] || ''} aria-label={'Member ' + (i + 1) + ' name'} />
            <input name={'team_role_' + i} type="text" maxlength="200" placeholder="Role" value={f['team_role_' + i] || ''} aria-label={'Member ' + (i + 1) + ' role'} />
            <input name={'team_link_' + i} type="url" maxlength="800" placeholder="https:// profile" value={f['team_link_' + i] || ''} aria-label={'Member ' + (i + 1) + ' link'} />
          </div>
        ))}
      </fieldset>
      <div class="sam-field"><label for="vision">Your entrepreneurial vision (optional)</label><textarea id="vision" name="vision" maxlength="3000">{f.vision || ''}</textarea></div>
      <div class="sam-field"><label for="market">Expected market (optional)</label><textarea id="market" name="market" maxlength="3000">{f.market || ''}</textarea></div>
      <div class="sam-field"><label for="resources_needed">Resources you would need (optional)</label><textarea id="resources_needed" name="resources_needed" maxlength="3000">{f.resources_needed || ''}</textarea></div>
      <label class="sam-check"><input type="checkbox" name="consent_privacy" value="yes" required /><span>I agree that SAMARTH may store and use this information to assess my application, as described in the <a href="/p/privacy" style="color:#FF4F00;">privacy notice</a>.</span></label>
      <div class="sam-cta"><button class="sam-btn" type="submit">Submit expression of interest</button></div>
    </form>
  </section>
</SamarthShell>
