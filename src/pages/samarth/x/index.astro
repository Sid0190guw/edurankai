---
// /samarth/x - SAMARTH X, the venture-building and incubation programme (spec Part 10). No fee.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { SAMARTH_X } from '@/lib/samarth/catalog';
import { X_CRITERIA } from '@/lib/samarth/x-scoring';
---
<SamarthShell
  title="SAMARTH X: Venture Building and Incubation"
  description="SAMARTH X is a selective, no-fee venture-building programme for exceptional people and teams building AI systems, intelligent systems and advanced technology startups."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'SAMARTH X', href: '/samarth/x' }]}
  active="x">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">SAMARTH X</p>
    <h1 class="sam-h1">For people who <em>build</em></h1>
    <p class="sam-lead">{SAMARTH_X.lead}</p>
    <p class="sam-note">{SAMARTH_X.noFee}</p>
    <div class="sam-cta"><a class="sam-btn" href="/samarth/x/apply">Express your interest</a><a class="sam-btn ghost" href="/samarth/events">SAMARTH events</a></div>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Three ways in, one evaluation</h2>
      <div class="sam-grid three" style="margin-top:14px;">{SAMARTH_X.channels.map((c) => <div class="sam-card"><h3 class="sam-h3">{c.title}</h3><p class="sam-p" style="font-size:0.88rem;margin:0;">{c.detail}</p></div>)}</div>
    </div>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div><h2 class="sam-h2">What selected builders may receive</h2><p class="sam-p">Allocated according to each project's needs and its demonstrated progress.</p><ul class="sam-list">{SAMARTH_X.resources.map((x) => <li>{x}</li>)}</ul></div>
      <div><h2 class="sam-h2">What we expect of you</h2><ul class="sam-list">{SAMARTH_X.responsibilities.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div><h2 class="sam-h2">How applications are assessed</h2><p class="sam-p">Reviewers score each application on six criteria. Scores inform a human panel; they never decide by themselves.</p><ul class="sam-list">{X_CRITERIA.map((c) => <li><strong>{c.label}.</strong> {c.help}</li>)}</ul></div>
      <div><h2 class="sam-h2">The best six</h2><p class="sam-p">{SAMARTH_X.incubation}</p><a class="sam-btn" href="/samarth/x/apply">Express your interest</a></div>
    </div>
  </section>
</SamarthShell>
