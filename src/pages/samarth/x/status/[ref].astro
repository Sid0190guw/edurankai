---
// /samarth/x/status/<ref> - a SAMARTH X applicant's private view of their application.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { getXByRef, transitionX, xMessage } from '@/lib/samarth/x';
import { eventsFor } from '@/lib/samarth/store-core';
import { checkAccess, isSecureRequest } from '@/lib/samarth/access';
import { alertAdmins } from '@/lib/samarth/notify';
import { normaliseRef, isRef, clean } from '@/lib/samarth/validate';
import { statusDef, statusLabel } from '@/lib/samarth/workflow';

const ref = normaliseRef(Astro.params.ref);
const PAGE = '/samarth/x/status/' + ref;
if (!isRef(ref, 'X')) return Astro.redirect('/samarth/r');
const loaded = await getXByRef(ref);
if (!loaded.ready) return new Response('Your application could not be loaded just now. Please reload in a moment.', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '15' } });
const c = loaded.value;
const access = c ? checkAccess(Astro.cookies, Astro.url, ref, c.accessHash, isSecureRequest(Astro.url)) : { ok: false as const };
if (c && access.ok && access.fromLink) return Astro.redirect(PAGE);
Astro.response.headers.set('Cache-Control', 'no-store');
const allowed = !!c && access.ok;
const TERMINAL = ['ALUMNI', 'NOT_SELECTED', 'WITHDRAWN'];

if (allowed && c && Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const action = String(fd.get('action') ?? '');
  const who = { userId: null, name: c.name };
  if (action === 'withdraw') {
    if (String(fd.get('confirm') ?? '') !== 'yes') return Astro.redirect(PAGE + '?err=' + encodeURIComponent('Tick the box to confirm.'));
    const r = await transitionX(c.id, 'WITHDRAWN', 'applicant', 'Withdrawn by the applicant.', who);
    return Astro.redirect(PAGE + '?' + (r.ok ? 'msg=' + encodeURIComponent('Your application is withdrawn.') : 'err=' + encodeURIComponent(r.error)));
  }
  const body = String(fd.get('body') ?? '');
  const r = await xMessage(c.id, body, true, who);
  if (r.ok) await alertAdmins('samarth_x', 'Message from a SAMARTH X applicant', c.ref + ': ' + clean(body, 140), '/admin/samarth/x/' + c.id, 'samxmsg-' + c.id + '-' + Date.now());
  return Astro.redirect(PAGE + '?' + (r.ok ? 'msg=' + encodeURIComponent('Message sent.') : 'err=' + encodeURIComponent(r.error)));
}
const events = allowed && c ? await eventsFor('x', c.id, true) : null;
const msg = Astro.url.searchParams.get('msg') || '';
const err = Astro.url.searchParams.get('err') || '';
const welcome = Astro.url.searchParams.get('welcome') === '1';
---
<SamarthShell title={'SAMARTH X application ' + ref} description="Your SAMARTH X application." noindex={true} active="x">
  <section class="sam-narrow" style="padding:30px 16px 80px;">
    {!allowed && (
      <div><h1 class="sam-h1" style="font-size:2rem;">This link is not valid</h1><p class="sam-p">Ask for a new link with your reference and email address.</p><a class="sam-btn" href="/samarth/r">Get a new link</a></div>
    )}
    {allowed && c && (
      <div>
        <p class="sam-eyebrow">SAMARTH X &middot; {c.ref}</p>
        <h1 class="sam-h1" style="font-size:clamp(1.8rem,4vw,2.6rem);">{c.ventureName || c.name}</h1>
        <p class="sam-p"><span class="sam-chip">{statusLabel('x', c.status)}</span> {statusDef('x', c.status)?.public}</p>
        {welcome && <div class="sam-flash ok">Your application is received. Your reference is <strong>{c.ref}</strong>, and a private link to this page has been emailed to you. There is no fee at any stage.</div>}
        {msg && <div class="sam-flash ok">{msg}</div>}
        {err && <div class="sam-flash err">{err}</div>}
        <h2 class="sam-h2" style="margin-top:20px;">History</h2>
        {events && !events.ready && <div class="sam-flash err">The history could not be loaded just now.</div>}
        {events && events.ready && <ul class="sam-timeline">{events.value.map((ev) => <li><span class="when">{ev.createdAt.slice(0, 16).replace('T', ' ')} UTC</span><p class="what">{ev.toStatus ? statusLabel('x', ev.toStatus) + (ev.body ? ': ' : '') : ''}{ev.body}</p></li>)}</ul>}
        {!TERMINAL.includes(c.status) && (
          <div>
            <form method="POST" class="sam-form" style="margin-top:14px;">
              <input type="hidden" name="action" value="message" />
              <div class="sam-field"><label for="body">Message the SAMARTH X team</label><textarea id="body" name="body" required maxlength="4000"></textarea></div>
              <div class="sam-cta"><button class="sam-btn ghost" type="submit">Send</button></div>
            </form>
            <details class="sam-card" style="margin-top:18px;"><summary style="cursor:pointer;font-weight:600;">Withdraw my application</summary>
              <form method="POST" class="sam-form" style="margin-top:12px;"><input type="hidden" name="action" value="withdraw" /><label class="sam-check"><input type="checkbox" name="confirm" value="yes" /><span>I want to withdraw. This cannot be undone.</span></label><button class="sam-btn ghost" type="submit">Withdraw</button></form>
            </details>
          </div>
        )}
      </div>
    )}
  </section>
</SamarthShell>
