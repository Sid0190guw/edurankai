---
// /samarth - the SAMARTH hub. Static content from src/lib/samarth/catalog.ts; no database, so it is
// edge-cached for anonymous visitors (src/middleware.ts) and renders even when the database is down.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { SAMARTH, SECTORS, ENGINEERING_DOMAINS, TOPICS, CONSULTATION_PROCESS, SAMARTH_X, AI_ASSISTANCE_NOTICE } from '@/lib/samarth/catalog';
import { SITE } from '@/lib/site';

const base = SITE.url.replace(/\/+$/, '');
const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': base + '/samarth#org',
  name: 'SAMARTH', alternateName: 'SAMARTH by EduRankAI', url: base + '/samarth', description: SAMARTH.description, slogan: SAMARTH.tagline,
  parentOrganization: { '@type': 'Organization', name: SITE.name, url: base },
  areaServed: { '@type': 'Place', name: 'Worldwide' },
  knowsAbout: TOPICS.map((t) => t.title),
};
const catalogLd = {
  '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'SAMARTH services', url: base + '/samarth/services',
  itemListElement: TOPICS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: t.title, url: base + '/samarth/services/' + t.slug, provider: { '@id': base + '/samarth#org' }, areaServed: 'Worldwide' } })),
};
---
<SamarthShell
  title="SAMARTH: Technology Consulting, Engineering and Venture Building"
  description="SAMARTH by EduRankAI: technology consultancy, engineering, technology transfer, intelligent infrastructure and venture building for governments, industry and institutions worldwide."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }]}
  jsonLd={[orgLd, catalogLd]}
  active="home">

  <section class="sam-wrap sam-hero">
    <p class="sam-eyebrow">EduRankAI &middot; SAMARTH</p>
    <h1 class="sam-h1">From research to reality. <em>From technology to transformation.</em></h1>
    <p class="sam-lead">{SAMARTH.statement}</p>
    <div class="sam-cta">
      <a class="sam-btn" href="/samarth/register">Register for a consultation</a>
      <a class="sam-btn ghost" href="/samarth/consultation">How a consultation works</a>
    </div>
    <p class="sam-p" style="margin-top:18px;font-size:0.85rem;">{SAMARTH.reach}</p>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <p class="sam-eyebrow">Who we work with</p>
      <h2 class="sam-h2">Any legitimate technological ambition, at any scale</h2>
      <p class="sam-p" style="max-width:46rem;">From a website to an enterprise platform, from a computing cluster to a modernised factory, from a single municipal system to national digital infrastructure. Governments at every level and in every country, public bodies, businesses, manufacturers, universities, research institutions and individuals all start the same way.</p>
      <div class="sam-grid three" style="margin-top:18px;">
        {SECTORS.map((s) => (
          <a class="sam-card" href={'/samarth/industry#' + s.id}>
            <p class="sam-eyebrow" style="margin-bottom:8px;">{s.id === 'manufacturing' ? 'Dedicated vertical' : 'Sector'}</p>
            <h3 class="sam-h3">{s.title}</h3>
            <p class="sam-p" style="font-size:0.88rem;">{s.lead}</p>
          </a>
        ))}
      </div>
      <div class="sam-grid two" style="margin-top:14px;">
        <a class="sam-card" href="/samarth/government">
          <p class="sam-eyebrow" style="margin-bottom:8px;">Dedicated vertical</p>
          <h3 class="sam-h3">Government and digital infrastructure</h3>
          <p class="sam-p" style="font-size:0.88rem;">Local, district, state or provincial, national and international public bodies, from a single departmental system to national platforms.</p>
        </a>
        <a class="sam-card" href="/samarth/engineering">
          <p class="sam-eyebrow" style="margin-bottom:8px;">Beyond reports</p>
          <h3 class="sam-h3">Engineering, technology transfer and infrastructure</h3>
          <p class="sam-p" style="font-size:0.88rem;">{ENGINEERING_DOMAINS.map((d) => d.title).join(', ')}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <p class="sam-eyebrow">How it starts</p>
      <h2 class="sam-h2">Every engagement begins with a consultation</h2>
      <p class="sam-p" style="max-width:46rem;">The same path for every applicant, including governments and public-sector bodies. The consultation booking fee is shown, with its currency, any tax, any payment charge and its terms, before you commit. Anything after the consultation is a separate engagement with its own approved quotation and terms.</p>
      <ol class="sam-steps" style="margin-top:16px;">
        {CONSULTATION_PROCESS.map((s) => <li><strong>{s.step}.</strong> {s.detail}</li>)}
      </ol>
      <p class="sam-note neutral" style="margin-top:16px;">{AI_ASSISTANCE_NOTICE}</p>
      <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register</a><a class="sam-btn ghost" href="/samarth/consultation">See the booking fee</a></div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <p class="sam-eyebrow">Capabilities</p>
      <h2 class="sam-h2">What SAMARTH does</h2>
      <div class="sam-grid four" style="margin-top:16px;">
        {TOPICS.map((t) => (
          <a class="sam-card" href={'/samarth/services/' + t.slug} style="padding:18px;">
            <h3 class="sam-h3" style="font-size:1.02rem;">{t.title}</h3>
            <p class="sam-p" style="font-size:0.82rem;margin:0;">{t.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div>
        <p class="sam-eyebrow">Delivery</p>
        <h2 class="sam-h2">The best expertise, not only our own</h2>
        <p class="sam-p">SAMARTH delivers through its own research and engineering teams, through carefully selected external partners, or jointly. Every quotation states who is responsible for each part of the work. Qualified companies, laboratories, manufacturers and engineers can register as partners.</p>
        <a class="sam-btn ghost" href="/samarth/partners">Partner ecosystem</a>
      </div>
      <div>
        <p class="sam-eyebrow">SAMARTH X</p>
        <h2 class="sam-h2">For exceptional builders</h2>
        <p class="sam-p">{SAMARTH_X.lead} {SAMARTH_X.noFee}</p>
        <a class="sam-btn ghost" href="/samarth/x">About SAMARTH X</a>
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-narrow" style="text-align:center;">
      <h2 class="sam-h2">{SAMARTH.philosophy}</h2>
      <div class="sam-cta" style="justify-content:center;margin-top:18px;"><a class="sam-btn" href="/samarth/register">Register for a consultation</a></div>
    </div>
  </section>
</SamarthShell>
