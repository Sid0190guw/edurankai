---
// /samarth/partners/status/<ref> - a registered partner's private view of their registration.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { getPartnerByRef, partnerNote } from '@/lib/samarth/partners';
import { eventsFor } from '@/lib/samarth/store-core';
import { checkAccess, isSecureRequest } from '@/lib/samarth/access';
import { alertAdmins } from '@/lib/samarth/notify';
import { normaliseRef, isRef, clean } from '@/lib/samarth/validate';
import { statusDef, statusLabel } from '@/lib/samarth/workflow';

const ref = normaliseRef(Astro.params.ref);
const PAGE = '/samarth/partners/status/' + ref;
if (!isRef(ref, 'P')) return Astro.redirect('/samarth/r');
const loaded = await getPartnerByRef(ref);
if (!loaded.ready) return new Response('Your registration could not be loaded just now. Please reload in a moment.', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '15' } });
const p = loaded.value;
const access = p ? checkAccess(Astro.cookies, Astro.url, ref, p.accessHash, isSecureRequest(Astro.url)) : { ok: false as const };
if (p && access.ok && access.fromLink) return Astro.redirect(PAGE);
Astro.response.headers.set('Cache-Control', 'no-store');
const allowed = !!p && access.ok;

if (allowed && p && Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const body = String(fd.get('body') ?? '');
  const r = await partnerNote(p.id, body, true, { userId: null, name: p.contactName });
  if (r.ok) await alertAdmins('samarth_partner', 'Message from a SAMARTH partner', p.ref + ' (' + p.orgName + '): ' + clean(body, 140), '/admin/samarth/partners/' + p.id, 'sampmsg-' + p.id + '-' + Date.now());
  return Astro.redirect(PAGE + '?' + (r.ok ? 'msg=' + encodeURIComponent('Message sent.') : 'err=' + encodeURIComponent(r.error)));
}
const events = allowed && p ? await eventsFor('partner', p.id, true) : null;
const msg = Astro.url.searchParams.get('msg') || '';
const err = Astro.url.searchParams.get('err') || '';
const welcome = Astro.url.searchParams.get('welcome') === '1';
---
<SamarthShell title={'SAMARTH partner registration ' + ref} description="Your SAMARTH partner registration." noindex={true} active="partners">
  <section class="sam-narrow" style="padding:30px 16px 80px;">
    {!allowed && (
      <div><h1 class="sam-h1" style="font-size:2rem;">This link is not valid</h1><p class="sam-p">Ask for a new link with your reference and email address.</p><a class="sam-btn" href="/samarth/r">Get a new link</a></div>
    )}
    {allowed && p && (
      <div>
        <p class="sam-eyebrow">Partner registration &middot; {p.ref}</p>
        <h1 class="sam-h1" style="font-size:clamp(1.8rem,4vw,2.6rem);">{p.orgName}</h1>
        <p class="sam-p"><span class="sam-chip">{statusLabel('partner', p.status)}</span> {statusDef('partner', p.status)?.public}</p>
        {welcome && <div class="sam-flash ok">Your registration is received. Your reference is <strong>{p.ref}</strong>, and a private link to this page has been emailed to you.</div>}
        {msg && <div class="sam-flash ok">{msg}</div>}
        {err && <div class="sam-flash err">{err}</div>}
        <h2 class="sam-h2" style="margin-top:20px;">History</h2>
        {events && !events.ready && <div class="sam-flash err">The history could not be loaded just now.</div>}
        {events && events.ready && <ul class="sam-timeline">{events.value.map((ev) => <li><span class="when">{ev.createdAt.slice(0, 16).replace('T', ' ')} UTC</span><p class="what">{ev.toStatus ? statusLabel('partner', ev.toStatus) + (ev.body ? ': ' : '') : ''}{ev.body}</p></li>)}</ul>}
        <form method="POST" class="sam-form" style="margin-top:14px;">
          <div class="sam-field"><label for="body">Message the SAMARTH partnerships team</label><textarea id="body" name="body" required maxlength="4000"></textarea></div>
          <div class="sam-cta"><button class="sam-btn ghost" type="submit">Send</button></div>
        </form>
      </div>
    )}
  </section>
</SamarthShell>
