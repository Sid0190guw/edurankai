---
// /samarth/partners - the technology partner ecosystem and public registration (spec Part 8).
// Registration is free and is not approval; approval is not an award.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { parsePartner, registerPartner, PARTNER_KINDS, PARTNER_DOMAINS } from '@/lib/samarth/partners';
import { DELIVERY_MODELS, ACCOUNTABILITY_NOTICE, REGULATED_WORK_NOTICE } from '@/lib/samarth/catalog';
import { countryOptions, parseDocLinks } from '@/lib/samarth/validate';
import { setAccessCookie, isSecureRequest } from '@/lib/samarth/access';
import { emailPartnerReceived, alertAdmins } from '@/lib/samarth/notify';
import { clientIp, overPublicFormLimit } from '@/lib/public-form-limit';

const COUNTRIES = countryOptions();
let error = '';
let f: Record<string, string> = {};
let picked: string[] = [];

if (Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const get = (n: string) => String(fd.get(n) ?? '');
  const getAll = (n: string) => fd.getAll(n).map((v) => String(v));
  f = Object.fromEntries(['org_name', 'org_kind', 'country', 'website', 'contact_name', 'contact_email', 'contact_phone', 'capabilities', 'qualifications', 'certifications', 'previous_projects', 'regulatory', 'security', 'commercial'].map((k) => [k, get(k)]));
  picked = getAll('domains');
  if (get('website_hp')) return Astro.redirect('/samarth/partners');
  const docs = parseDocLinks(get, 4);
  const p = parsePartner(get, getAll, docs.links);
  if (docs.invalid) p.problems.push('Document links must be full web addresses starting with https://');
  if (p.problems.length) {
    error = p.problems.join(' ');
  } else {
    const limit = await overPublicFormLimit('samarth-partner', clientIp(Astro.request.headers), { whenUnavailable: 'refuse', max: 6 });
    if (limit.blocked) error = 'Several registrations have come from your connection in the last hour. Please try again later.';
    else {
      const r = await registerPartner(p.value);
      if (!r.ok) error = r.error;
      else {
        setAccessCookie(Astro.cookies, r.ref, r.token, isSecureRequest(Astro.url));
        await emailPartnerReceived(p.value.contactEmail, p.value.contactName, r.ref, r.token);
        await alertAdmins('samarth_partner', 'New SAMARTH partner registration', r.ref + ': ' + p.value.orgName + ' (' + p.value.country + ').', '/admin/samarth/partners/' + r.id, 'sampart-' + r.id);
        return Astro.redirect('/samarth/partners/status/' + r.ref + '?welcome=1');
      }
    }
  }
}
---
<SamarthShell
  title="SAMARTH Technology Partner Ecosystem"
  description="Engineering companies, laboratories, manufacturers, technology providers and specialists can register as SAMARTH technology partners. Registration is free."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Partners', href: '/samarth/partners' }]}
  active="partners">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Delivery and technology partners</p>
    <h1 class="sam-h1">Work with SAMARTH as a <em>technology partner</em></h1>
    <p class="sam-lead">SAMARTH is not limited to its own teams. It identifies and selects the best-qualified companies, engineers, laboratories, manufacturers and technology providers for each piece of work.</p>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap">
      <div class="sam-grid three">{DELIVERY_MODELS.map((m) => <div class="sam-card"><h2 class="sam-h3">{m.title}</h2><p class="sam-p" style="font-size:0.88rem;margin:0;">{m.detail}</p></div>)}</div>
      <p class="sam-note" style="margin-top:14px;">{ACCOUNTABILITY_NOTICE} Registration is free. It is not approval, and approval after due diligence makes a partner eligible to be considered, never entitled to work.</p>
    </div>
  </section>
  <section class="sam-sec" id="register">
    <div class="sam-narrow">
      <h2 class="sam-h2">Register as a partner</h2>
      {error && <div class="sam-flash err" role="alert">{error}</div>}
      <form method="POST" class="sam-form">
        <div class="sam-hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
        <div class="sam-row2">
          <div class="sam-field"><label for="org_name">Organisation or your name</label><input id="org_name" name="org_name" type="text" required maxlength="300" value={f.org_name || ''} /></div>
          <div class="sam-field"><label for="org_kind">Kind of partner</label><select id="org_kind" name="org_kind" required><option value="">Choose one</option>{PARTNER_KINDS.map((k) => <option value={k.value} selected={f.org_kind === k.value}>{k.label}</option>)}</select></div>
        </div>
        <div class="sam-row2">
          <div class="sam-field"><label for="country">Country</label><select id="country" name="country" required><option value="">Choose a country</option>{COUNTRIES.map((c) => <option value={c.code} selected={f.country === c.code}>{c.name}</option>)}</select></div>
          <div class="sam-field"><label for="website">Website (optional)</label><input id="website" name="website" type="url" maxlength="800" placeholder="https://" value={f.website || ''} /></div>
        </div>
        <div class="sam-row2">
          <div class="sam-field"><label for="contact_name">Contact name</label><input id="contact_name" name="contact_name" type="text" required maxlength="200" value={f.contact_name || ''} /></div>
          <div class="sam-field"><label for="contact_email">Contact email</label><input id="contact_email" name="contact_email" type="email" required maxlength="254" value={f.contact_email || ''} /></div>
        </div>
        <div class="sam-field"><label for="contact_phone">Phone, with country code (optional)</label><input id="contact_phone" name="contact_phone" type="tel" maxlength="32" value={f.contact_phone || ''} /></div>
        <fieldset><legend class="sam-legend">Domains you work in</legend>
          <div class="sam-choice" style="margin-top:8px;">{PARTNER_DOMAINS.map((d) => <label><input type="checkbox" name="domains" value={d.value} checked={picked.includes(d.value)} /><span><b>{d.label}</b></span></label>)}</div>
        </fieldset>
        <div class="sam-field"><label for="capabilities">Technical capabilities</label><textarea id="capabilities" name="capabilities" required maxlength="6000">{f.capabilities || ''}</textarea></div>
        <div class="sam-field"><label for="qualifications">Qualifications of your team (optional)</label><textarea id="qualifications" name="qualifications" maxlength="4000">{f.qualifications || ''}</textarea></div>
        <div class="sam-field"><label for="certifications">Certifications and accreditations you hold (optional)</label><textarea id="certifications" name="certifications" maxlength="4000">{f.certifications || ''}</textarea><span class="hint">These are checked with the issuer during due diligence.</span></div>
        <div class="sam-field"><label for="previous_projects">Previous projects (optional)</label><textarea id="previous_projects" name="previous_projects" maxlength="6000">{f.previous_projects || ''}</textarea><span class="hint">Name clients only where you have their permission.</span></div>
        <div class="sam-field"><label for="regulatory">Regulatory eligibility for regulated work (optional)</label><textarea id="regulatory" name="regulatory" maxlength="4000">{f.regulatory || ''}</textarea><span class="hint">{REGULATED_WORK_NOTICE.split('.')[0]}.</span></div>
        <div class="sam-row2">
          <div class="sam-field"><label for="security">Security and data protection (optional)</label><textarea id="security" name="security" maxlength="4000">{f.security || ''}</textarea></div>
          <div class="sam-field"><label for="commercial">Commercial and financial details (optional)</label><textarea id="commercial" name="commercial" maxlength="4000">{f.commercial || ''}</textarea></div>
        </div>
        <fieldset><legend class="sam-legend">Supporting documents (optional, as links)</legend>
          {[0, 1, 2, 3].map((i) => <div class="sam-row2" style="margin-bottom:8px;"><input name={'doc_label_' + i} type="text" maxlength="120" placeholder="What it is" aria-label={'Document ' + (i + 1) + ' name'} /><input name={'doc_url_' + i} type="url" maxlength="800" placeholder="https://" aria-label={'Document ' + (i + 1) + ' link'} /></div>)}
        </fieldset>
        <label class="sam-check"><input type="checkbox" name="consent_privacy" value="yes" required /><span>I agree that SAMARTH may store and use this information to assess us as a partner, as described in the <a href="/p/privacy" style="color:#FF4F00;">privacy notice</a>.</span></label>
        <div class="sam-cta"><button class="sam-btn" type="submit">Register</button></div>
      </form>
    </div>
  </section>
</SamarthShell>
