---
// /samarth/services - every SAMARTH capability page.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { TOPICS } from '@/lib/samarth/catalog';
---
<SamarthShell
  title="SAMARTH Capabilities"
  description="SAMARTH capabilities: technology consultancy, AI engineering, intelligent systems, automation, manufacturing, government infrastructure, computing, data centres, robotics, energy and more."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Capabilities', href: '/samarth/services' }]}
  active="services">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Capabilities</p>
    <h1 class="sam-h1">What SAMARTH <em>does</em></h1>
    <p class="sam-lead">Each capability page explains the problems it addresses, the scope of work, how an engagement runs, what is delivered and where the limits are.</p>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap sam-grid three">
      {TOPICS.map((t) => (
        <a class="sam-card" href={'/samarth/services/' + t.slug}>
          <h2 class="sam-h3">{t.title}</h2>
          <p class="sam-p" style="font-size:0.88rem;margin:0;">{t.description}</p>
        </a>
      ))}
    </div>
  </section>
</SamarthShell>
