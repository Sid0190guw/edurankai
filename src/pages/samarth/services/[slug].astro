---
// /samarth/services/<slug> - one capability, rendered from src/lib/samarth/catalog.ts TOPICS.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { topicBySlug, TOPICS, type Topic } from '@/lib/samarth/catalog';
import { SITE } from '@/lib/site';

const topic = topicBySlug(Astro.params.slug);
if (!topic) return new Response(null, { status: 404, statusText: 'Not found' });
const base = SITE.url.replace(/\/+$/, '');
const related = topic.related.map((s) => TOPICS.find((t) => t.slug === s)).filter(Boolean) as Topic[];
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: topic.title, description: topic.description, url: base + '/samarth/services/' + topic.slug,
  serviceType: topic.title, areaServed: 'Worldwide',
  provider: { '@type': 'Organization', name: 'SAMARTH', url: base + '/samarth', parentOrganization: { '@type': 'Organization', name: SITE.name, url: base } },
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: topic.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SamarthShell
  title={topic.title + ' | SAMARTH'}
  description={topic.description}
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Capabilities', href: '/samarth/services' }, { label: topic.title, href: '/samarth/services/' + topic.slug }]}
  jsonLd={[serviceLd, faqLd]}
  active="services">
  <article>
    <header class="sam-wrap sam-hero" style="padding-bottom:20px;">
      <p class="sam-eyebrow">SAMARTH capability</p>
      <h1 class="sam-h1">{topic.title}</h1>
      <p class="sam-lead">{topic.lead}</p>
      <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register for a consultation</a><a class="sam-btn ghost" href="/samarth/consultation">How it works</a></div>
    </header>
    <section class="sam-sec">
      <div class="sam-wrap sam-grid two">
        <div><h2 class="sam-h2">Problems organisations bring</h2><ul class="sam-list">{topic.problems.map((x) => <li>{x}</li>)}</ul></div>
        <div><h2 class="sam-h2">Scope of work</h2><ul class="sam-list">{topic.scope.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>
    <section class="sam-sec">
      <div class="sam-wrap">
        <h2 class="sam-h2">How an engagement runs</h2>
        <ol class="sam-steps" style="margin-top:14px;">{topic.approach.map((a) => <li><strong>{a.step}.</strong> {a.detail}</li>)}</ol>
      </div>
    </section>
    <section class="sam-sec">
      <div class="sam-wrap sam-grid two">
        <div><h2 class="sam-h2">What is delivered</h2><ul class="sam-list">{topic.deliverables.map((x) => <li>{x}</li>)}</ul></div>
        <div><h2 class="sam-h2">Limits we state plainly</h2>{topic.boundaries.map((x) => <p class="sam-note neutral">{x}</p>)}</div>
      </div>
    </section>
    <section class="sam-sec">
      <div class="sam-narrow">
        <h2 class="sam-h2">Questions</h2>
        {topic.faq.map((f) => <details class="sam-card" style="margin-bottom:10px;padding:16px 18px;"><summary style="cursor:pointer;font-weight:650;">{f.q}</summary><p class="sam-p" style="margin:10px 0 0;">{f.a}</p></details>)}
      </div>
    </section>
    <section class="sam-sec">
      <div class="sam-wrap">
        <h2 class="sam-h2">Related capabilities</h2>
        <div class="sam-grid three" style="margin-top:14px;">{related.map((t) => <a class="sam-card" href={'/samarth/services/' + t.slug}><h3 class="sam-h3">{t.title}</h3><p class="sam-p" style="font-size:0.86rem;margin:0;">{t.description}</p></a>)}</div>
      </div>
    </section>
  </article>
</SamarthShell>
