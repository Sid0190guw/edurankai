---
// /samarth/r - "I already registered": a new private link by email, for an application, a partner
// registration or a SAMARTH X application. The answer is the same whether or not the reference and
// email matched, so this page cannot be used to discover who has applied.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { normaliseRef, isRef, cleanEmail, newToken, hashToken } from '@/lib/samarth/validate';
import { emailNewLink } from '@/lib/samarth/notify';
import { clientIp, overPublicFormLimit } from '@/lib/public-form-limit';
import { ensureSamarthSchema } from '@/lib/samarth/schema';

const SAME_ANSWER = 'If that reference and email address match a request, a new private link is on its way to that address. Any earlier link stops working.';
let done = '';
let error = '';

if (Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const ref = normaliseRef(fd.get('ref'));
  const email = cleanEmail(fd.get('email'));
  if (!isRef(ref) || !email) {
    error = 'Enter your reference (it looks like SAM-A-XXXXXXXX) and the email address you used.';
  } else {
    const limit = await overPublicFormLimit('samarth-resend', clientIp(Astro.request.headers), { whenUnavailable: 'refuse', max: 6 });
    if (limit.blocked) {
      error = 'Several links have been requested from your connection. Please wait an hour, or write to connect@edurankai.in.';
    } else {
      const kind = ref.charAt(4);
      const table = kind === 'A' ? 'samarth_applications' : kind === 'P' ? 'samarth_partners' : kind === 'X' ? 'samarth_x_candidates' : '';
      const emailCol = kind === 'X' ? 'email' : 'contact_email';
      try {
        await ensureSamarthSchema();
        if (table) {
          const token = newToken();
          const r = await db.execute(sql`UPDATE ${sql.identifier(table)} SET access_hash = ${hashToken(token)}, updated_at = NOW() WHERE ref = ${ref} AND lower(${sql.identifier(emailCol)}) = ${email} RETURNING ref`);
          const rows = Array.isArray(r) ? r : ((r as any)?.rows || []);
          if (rows.length) await emailNewLink(email, ref, token, kind === 'P' ? 'partner' : kind === 'X' ? 'x' : 'application');
        }
        done = SAME_ANSWER;
      } catch (e: any) {
        console.error('[samarth/r] resend failed for', ref, '-', String(e?.cause?.message || e?.message || e));
        error = 'We could not process that just now. Please try again in a moment.';
      }
    }
  }
}
---
<SamarthShell title="Continue a SAMARTH request" description="Get a new private link to your SAMARTH consultation request, partner registration or SAMARTH X application." noindex={true} crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Continue a request', href: '/samarth/r' }]} active="consultation">
  <section class="sam-narrow" style="padding:36px 16px 80px;max-width:560px;">
    <p class="sam-eyebrow">Continue</p>
    <h1 class="sam-h1" style="font-size:2.2rem;">Get a new private link</h1>
    <p class="sam-p">Your request is opened with a private link we emailed you. If you no longer have it, enter your reference and the email address you used, and we will send a new one.</p>
    {done && <div class="sam-flash ok" role="status">{done}</div>}
    {error && <div class="sam-flash err" role="alert">{error}</div>}
    <form method="POST" class="sam-form">
      <div class="sam-field"><label for="ref">Reference</label><input id="ref" name="ref" type="text" required maxlength="20" placeholder="SAM-A-XXXXXXXX" autocomplete="off" style="text-transform:uppercase;" /></div>
      <div class="sam-field"><label for="email">Email address</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email" /></div>
      <div class="sam-cta"><button class="sam-btn" type="submit">Send a new link</button><a class="sam-btn ghost" href="/samarth/register">Start a new request</a></div>
    </form>
  </section>
</SamarthShell>
