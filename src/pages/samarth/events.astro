---
// /samarth/events - published SAMARTH events. Each links to its platform event page, where people
// register. Reads the events table, so it is not edge-cached.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { listSamarthEvents, eventKindLabel } from '@/lib/samarth/events';

const events = await listSamarthEvents(true);
if (!events.ready) Astro.response.headers.set('x-era-degraded', '1');
const now = Date.now();
const list = events.ready ? events.value : [];
const upcoming = list.filter((e) => e.status === 'upcoming' && (!e.endsAt || new Date(e.endsAt).getTime() >= now)).reverse();
const past = list.filter((e) => !upcoming.includes(e));
const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString('en-GB', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' UTC' : 'Date to be announced');
const MODE: Record<string, string> = { online: 'Online', in_person: 'In person', hybrid: 'Hybrid' };
---
<SamarthShell
  title="SAMARTH Events, Hackathons and Challenges"
  description="SAMARTH hackathons, AI challenges, intelligent-systems competitions, technology and research events. Outstanding participants may be considered for SAMARTH X."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Events', href: '/samarth/events' }]}
  active="events">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Events</p>
    <h1 class="sam-h1">Hackathons, challenges and <em>events</em></h1>
    <p class="sam-lead">SAMARTH organises hackathons, AI and intelligent-systems challenges, entrepreneurship and startup competitions, research events and institutional programmes. Outstanding participants may be invited into the SAMARTH X evaluation, which charges no fee.</p>
    <div class="sam-cta"><a class="sam-btn ghost" href="/samarth/x">About SAMARTH X</a></div>
  </section>
  <section class="sam-sec">
    <div class="sam-wrap">
      {!events.ready && <div class="sam-flash err">Events could not be loaded just now. Please reload in a moment.</div>}
      <h2 class="sam-h2">Upcoming</h2>
      {events.ready && upcoming.length === 0 && <p class="sam-p">No SAMARTH event is open for registration right now. New events are announced here and on <a href="/events" style="color:#FF4F00;">the events page</a>.</p>}
      <div class="sam-grid two" style="margin-top:12px;">
        {upcoming.map((e) => (
          <a class="sam-card" href={'/events/' + e.slug}>
            <p class="sam-eyebrow" style="margin-bottom:6px;">{eventKindLabel(e.tags)} &middot; {MODE[e.mode] || e.mode}</p>
            <h3 class="sam-h3">{e.title}</h3>
            <p class="sam-p" style="font-size:0.88rem;margin:0 0 8px;">{e.description}</p>
            <p class="sam-p" style="font-size:0.82rem;margin:0;">{when(e.startsAt)}{e.location ? ' · ' + e.location : ''}</p>
          </a>
        ))}
      </div>
      {past.length > 0 && (
        <div style="margin-top:28px;">
          <h2 class="sam-h2">Past</h2>
          <ul class="sam-list">{past.map((e) => <li><a href={'/events/' + e.slug} style="color:inherit;">{e.title}</a> <span style="color:#7a7266;">({eventKindLabel(e.tags)}, {when(e.startsAt)})</span></li>)}</ul>
        </div>
      )}
    </div>
  </section>
</SamarthShell>
