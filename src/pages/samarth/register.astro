---
// /samarth/register - step 1 of the consultation workflow. Creates the request, issues its private
// link (emailed, and set as an HttpOnly cookie for this browser) and continues in the applicant
// workspace /samarth/r/<ref>. No account is needed.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { APPLICANT_CATEGORIES } from '@/lib/samarth/categories';
import { countryOptions, clean } from '@/lib/samarth/validate';
import { registerApplication } from '@/lib/samarth/applications';
import { setAccessCookie, isSecureRequest } from '@/lib/samarth/access';
import { emailRegistration } from '@/lib/samarth/notify';
import { clientIp, overPublicFormLimit } from '@/lib/public-form-limit';
import { AI_ASSISTANCE_NOTICE } from '@/lib/samarth/catalog';

// Declared before the POST handler that reads them.
const COUNTRIES = countryOptions();
let error = '';
let form: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  let fd: FormData;
  try { fd = await Astro.request.formData(); } catch { fd = new FormData(); }
  const get = (n: string) => String(fd.get(n) ?? '');
  form = { category: get('category'), country: get('country'), contact_name: get('contact_name'), contact_email: get('contact_email'), org_name: get('org_name') };
  if (get('website_hp')) {
    // A filled honeypot is a bot. It gets the same calm answer and nothing is stored.
    return Astro.redirect('/samarth/consultation');
  }
  const limit = await overPublicFormLimit('samarth-register', clientIp(Astro.request.headers), { whenUnavailable: 'refuse', max: 8 });
  if (limit.blocked) {
    error = 'Several requests have been made from your connection in the last hour. Please try again later, or write to connect@edurankai.in.';
  } else {
    const r = await registerApplication({
      category: get('category'), country: get('country'), contactName: get('contact_name'), contactEmail: get('contact_email'),
      orgName: get('org_name'), timezone: clean(get('timezone'), 64), consentPrivacy: get('consent_privacy') === 'yes',
      consentContact: get('consent_contact') === 'yes', source: 'web',
    });
    if (!r.ok) {
      error = r.error;
    } else {
      setAccessCookie(Astro.cookies, r.ref, r.token, isSecureRequest(Astro.url));
      const mailed = await emailRegistration(get('contact_email').trim().toLowerCase(), clean(get('contact_name'), 200), r.ref, r.token);
      return Astro.redirect('/samarth/r/' + r.ref + '?welcome=1' + (mailed ? '' : '&nomail=1') + '&k=' + encodeURIComponent(r.token));
    }
  }
}
---
<SamarthShell
  title="Register for a SAMARTH Consultation"
  description="Register for a consultation with SAMARTH. Governments, public bodies, businesses, startups, universities, research institutions and individuals from any country."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Register', href: '/samarth/register' }]}
  active="consultation">
  <section class="sam-narrow" style="padding:36px 16px 72px;">
    <p class="sam-eyebrow">Step 1 of 6 &middot; Registration</p>
    <h1 class="sam-h1" style="font-size:clamp(2rem,4.6vw,3rem);">Register for a consultation</h1>
    <p class="sam-p">Tell us who you are. You will get a reference and a private link to continue with your details, your project requirements, the consultation booking fee and booking your call. It takes about two minutes.</p>
    <p class="sam-note neutral">Every applicant, including governments and public-sector bodies, pays the consultation booking fee before a call is booked. The fee for your category and currency is shown on the <a href="/samarth/consultation#fees" style="color:#FF4F00;">consultation page</a> and again before you pay.</p>

    {error && <div class="sam-flash err" role="alert">{error}</div>}

    <form method="POST" class="sam-form">
      <div class="sam-hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="timezone" id="tzField" value="" />

      <fieldset>
        <legend class="sam-legend">You are applying as</legend>
        <div class="sam-choice" style="margin-top:8px;">
          {APPLICANT_CATEGORIES.map((c) => (
            <label><input type="radio" name="category" value={c.value} required checked={form.category === c.value} /><span><b>{c.label}</b><small>{c.hint}</small></span></label>
          ))}
        </div>
      </fieldset>

      <div class="sam-row2">
        <div class="sam-field">
          <label for="country">Country</label>
          <select id="country" name="country" required>
            <option value="">Choose a country</option>
            {COUNTRIES.map((c) => <option value={c.code} selected={form.country === c.code}>{c.name}</option>)}
          </select>
        </div>
        <div class="sam-field">
          <label for="org_name">Organisation <span style="font-weight:400;color:#7a7266;">(not needed for individuals)</span></label>
          <input id="org_name" name="org_name" type="text" maxlength="300" value={form.org_name || ''} autocomplete="organization" />
        </div>
      </div>
      <div class="sam-row2">
        <div class="sam-field">
          <label for="contact_name">Your name</label>
          <input id="contact_name" name="contact_name" type="text" maxlength="200" required value={form.contact_name || ''} autocomplete="name" />
        </div>
        <div class="sam-field">
          <label for="contact_email">Email</label>
          <input id="contact_email" name="contact_email" type="email" maxlength="254" required value={form.contact_email || ''} autocomplete="email" />
          <span class="hint">Your private link is sent here. Official bodies may use an official address.</span>
        </div>
      </div>

      <label class="sam-check"><input type="checkbox" name="consent_privacy" value="yes" required /><span>I agree that SAMARTH may store and use the information in this request to assess it and contact me about it, as described in the <a href="/p/privacy" style="color:#FF4F00;">privacy notice</a>.</span></label>
      <label class="sam-check"><input type="checkbox" name="consent_contact" value="yes" /><span>SAMARTH may also contact me about related services. (Optional.)</span></label>

      <p class="sam-p" style="font-size:0.8rem;">{AI_ASSISTANCE_NOTICE}</p>
      <div class="sam-cta"><button class="sam-btn" type="submit">Register and continue</button><a class="sam-btn ghost" href="/samarth/r">I already registered</a></div>
    </form>
  </section>
  <script is:inline>
    (function () { try { var tz = Intl.DateTimeFormat().resolvedOptions().timeZone; var f = document.getElementById('tzField'); if (f && tz) f.value = tz; } catch (e) {} })();
  </script>
</SamarthShell>
