---
// /samarth/consultancy - the published consultancy packages (spec Parts 6 and 13.1) and an estimator.
//
// THESE ARE NOT BOUGHT HERE. Every engagement starts with registration and the consultation booking
// fee; a package is a separate engagement afterwards, with its own approved quotation and terms. The
// estimator runs assessEligibility() from src/lib/samarth/pricing.ts in the browser, the same
// function the consultant's screen uses, and it is labelled as an estimate.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { PACKAGES, PUBLISHED_CODES, STANDARD_EXCLUSIONS, priceLabel, packageByCode, TURNOVER_BANDS, NEED_TYPES } from '@/lib/samarth/pricing';
import { APPLICANT_CATEGORIES } from '@/lib/samarth/categories';
import { SITE } from '@/lib/site';

const published = PUBLISHED_CODES.map((c) => packageByCode(c)!).filter(Boolean);
const base = SITE.url.replace(/\/+$/, '');
const offersLd = {
  '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'SAMARTH consultancy packages', url: base + '/samarth/consultancy',
  itemListElement: published.filter((p) => p.basePaise != null).map((p) => ({
    '@type': 'Offer', name: p.label, description: p.eligibility, url: base + '/samarth/consultancy#' + p.code,
    priceSpecification: { '@type': 'PriceSpecification', price: (p.basePaise as number) / 100, priceCurrency: 'INR', ...(p.priceKind === 'starting' || p.priceKind === 'onwards' ? { minPrice: (p.basePaise as number) / 100 } : {}) },
    seller: { '@type': 'Organization', name: 'SAMARTH by EduRankAI' },
  })),
};
---
<SamarthShell
  title="SAMARTH Consultancy Packages and Pricing"
  description="SAMARTH technology consultancy packages for micro businesses, medium and large enterprises, startups and governments. Packages are quoted after a consultation."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Consultancy packages', href: '/samarth/consultancy' }]}
  jsonLd={[offersLd]}
  active="consultancy">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Technology consultancy and engineering services</p>
    <h1 class="sam-h1">Consultancy <em>packages</em></h1>
    <p class="sam-lead">Published prices for the main consultancy engagements. A package is agreed after your consultation call, as a separate engagement with its own quotation and terms. Packages are never combined.</p>
    <p class="sam-note">Every engagement starts with registration and the <a href="/samarth/consultation#fees" style="color:#FF4F00;">consultation booking fee</a>, which is separate from these packages and from any engineering, government, infrastructure or implementation work.</p>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <div class="sam-scroll">
        <table class="sam-table">
          <thead><tr><th>Package</th><th>Who it is for</th><th>Price</th></tr></thead>
          <tbody>{published.map((p) => <tr id={p.code}><td><strong>{p.label}</strong></td><td>{p.eligibility}</td><td>{priceLabel(p)}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="sam-p" style="font-size:0.82rem;margin-top:10px;">Prices in Indian rupees. Applicants elsewhere receive their quotation in their own currency where possible. Turnover bands are commercial pricing criteria, not statutory business classifications. "Starting" and "onwards" prices are the minimum; the final fee follows scope confirmation.</p>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">What each package covers</h2>
      <div class="sam-grid three" style="margin-top:14px;">
        {PACKAGES.filter((p) => p.basePaise != null).map((p) => (
          <div class="sam-card"><p class="sam-eyebrow" style="margin-bottom:6px;">{priceLabel(p)}</p><h3 class="sam-h3">{p.label}</h3><ul class="sam-list">{p.scope.map((x) => <li>{x}</li>)}</ul>
          {p.excludes.length > 0 && <p class="sam-p" style="font-size:0.8rem;margin:8px 0 0;">Not included: {p.excludes.join('; ')}.</p>}</div>
        ))}
      </div>
      <div class="sam-card" style="margin-top:14px;">
        <h3 class="sam-h3">Never included in a consultancy fee</h3>
        <ul class="sam-list">{STANDARD_EXCLUSIONS.map((x) => <li>{x}</li>)}</ul>
        <p class="sam-p" style="font-size:0.86rem;margin:10px 0 0;">Engineering, government and infrastructure projects are quoted individually after discovery.</p>
      </div>
    </div>
  </section>

  <section class="sam-sec" id="estimate">
    <div class="sam-narrow">
      <h2 class="sam-h2">Which package might fit?</h2>
      <p class="sam-p">An estimate only. A SAMARTH consultant confirms the right engagement with you after the consultation call.</p>
      <div class="sam-form sam-card">
        <div class="sam-field"><label for="eCat">You are</label><select id="eCat">{APPLICANT_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}</select></div>
        <div class="sam-field"><label for="eTurn">Annual turnover</label><select id="eTurn">{TURNOVER_BANDS.map((b) => <option value={b.value}>{b.label}</option>)}</select></div>
        <div class="sam-field"><label for="eNeed">You are looking for</label><select id="eNeed">{NEED_TYPES.map((n) => <option value={n.value}>{n.label}</option>)}</select></div>
        <div id="eOut" class="sam-note" aria-live="polite">Choose your answers above.</div>
      </div>
      <div class="sam-cta" style="margin-top:16px;"><a class="sam-btn" href="/samarth/register">Register for a consultation</a></div>
    </div>
  </section>
  <script>
    import { assessEligibility, packageByCode, priceLabel } from '@/lib/samarth/pricing';
    const cat = document.getElementById('eCat') as HTMLSelectElement | null;
    const turn = document.getElementById('eTurn') as HTMLSelectElement | null;
    const need = document.getElementById('eNeed') as HTMLSelectElement | null;
    const out = document.getElementById('eOut');
    function run() {
      if (!cat || !turn || !need || !out) return;
      const r = assessEligibility({ category: cat.value, turnover: turn.value, need: need.value });
      const p = packageByCode(r.recommended);
      const alts = r.alternatives.map((c) => packageByCode(c)).filter(Boolean).map((x) => x!.label);
      out.textContent = 'Estimate: ' + (p ? p.label + ' (' + priceLabel(p) + ')' : 'a custom quotation') + '. ' + r.reasons.join(' ')
        + (alts.length ? ' Alternatively: ' + alts.join(' or ') + '.' : '')
        + (r.requiresHumanReview ? ' A consultant confirms eligibility before anything is quoted.' : '');
    }
    [cat, turn, need].forEach((el) => el && el.addEventListener('change', run));
    run();
  </script>
</SamarthShell>
