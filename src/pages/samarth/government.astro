---
// /samarth/government - the dedicated government vertical, worded for public bodies in any country.
import SamarthShell from '@/components/samarth/SamarthShell.astro';
import { GOVERNMENT_ENGAGEMENTS, GOVERNMENT_DOMAINS, GOVERNMENT_PROJECT_LEVELS, GOVERNMENT_LIFECYCLE } from '@/lib/samarth/catalog';
import { GOVERNMENT_LEVELS } from '@/lib/samarth/categories';
---
<SamarthShell
  title="Government Technology and Digital Infrastructure | SAMARTH"
  description="SAMARTH supports governments and public bodies at local, district, state or provincial, national and international level: digital governance, intelligent systems and digital infrastructure."
  crumbs={[{ label: 'SAMARTH', href: '/samarth' }, { label: 'Government', href: '/samarth/government' }]}
  active="government">
  <section class="sam-wrap sam-hero" style="padding-bottom:20px;">
    <p class="sam-eyebrow">Government vertical</p>
    <h1 class="sam-h1">Government technology and <em>digital infrastructure</em></h1>
    <p class="sam-lead">From one departmental system to district, state or provincial, national, multi-state and international transformation, for public bodies in any country.</p>
    <div class="sam-cta"><a class="sam-btn" href="/samarth/register">Register as a public body</a><a class="sam-btn ghost" href="/samarth/consultation">The consultation process</a></div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap sam-grid two">
      <div>
        <h2 class="sam-h2">Who we work with</h2>
        <ul class="sam-list">{GOVERNMENT_ENGAGEMENTS.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2 class="sam-h2">How public bodies apply</h2>
        <p class="sam-p">Government applicants follow the same registration and consultation booking fee as every other applicant, and also record:</p>
        <ul class="sam-list">
          <li>The level of government: {GOVERNMENT_LEVELS.map((l) => l.value).join(', ')}</li>
          <li>Jurisdiction, ministry, department or agency, and office</li>
          <li>The authorised representative and their designation, with an authorisation reference where available</li>
          <li>Procurement requirements: the expected route, any tender reference, formal proposal or detailed project report requirements, document language, and whether an invoice must precede payment</li>
        </ul>
        <p class="sam-note">Payment against an invoice is available for the booking fee, to suit procurement rules.</p>
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Service domains</h2>
      <div class="sam-grid three" style="margin-top:14px;">
        {GOVERNMENT_DOMAINS.map((d) => <div class="sam-card"><h3 class="sam-h3">{d.title}</h3><ul class="sam-list">{d.items.map((x) => <li>{x}</li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Six project levels</h2>
      <p class="sam-p">Complexity and engagement classifications, not price tiers. Every government engagement is quoted individually.</p>
      <div class="sam-grid three" style="margin-top:14px;">
        {GOVERNMENT_PROJECT_LEVELS.map((l) => <div class="sam-card"><p class="sam-eyebrow" style="margin-bottom:6px;">Level {l.level}</p><h3 class="sam-h3">{l.title}</h3><p class="sam-p" style="font-size:0.88rem;margin:0;">{l.detail}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sam-sec">
    <div class="sam-wrap">
      <h2 class="sam-h2">Project lifecycle</h2>
      <ol class="sam-steps" style="margin-top:14px;">{GOVERNMENT_LIFECYCLE.map((s) => <li>{s}</li>)}</ol>
      <p class="sam-note" style="margin-top:16px;">Proposals, tenders, approvals, correspondence, milestones and contracts are kept on record. A proposal, a meeting or an expression of interest is never presented as an awarded project, and every engagement complies with the procurement, financial, security and statutory requirements that apply to the contracting body.</p>
    </div>
  </section>
</SamarthShell>
