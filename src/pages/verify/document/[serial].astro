---
// /verify/document/<serial> - public verification of an experience letter, no-objection certificate
// or relieving letter issued from /admin/hr/documents. Shows the stored document while it is valid;
// a revoked one shows only that it was revoked, when and why, so a withdrawn letter cannot be re-used.
// Not indexed: each page belongs to one person, and /verify/ is disallowed in robots.txt.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDocumentBySerial } from '@/lib/hr/hr-documents-store';
import { hrDocType, isDocumentSerial } from '@/lib/hr/hr-documents';
import { longDate } from '@/lib/hr/brand-doc';

const serial = String(Astro.params.serial || '').trim().toUpperCase();
const wellFormed = isDocumentSerial(serial);
const res = wellFormed ? await getDocumentBySerial(serial) : null;
const doc = res && res.ok ? res.value : null;
const unavailable = !!res && !res.ok;
const def = doc ? hrDocType(doc.docType) : null;
const state = unavailable ? 'unavailable' : !doc ? 'unknown' : doc.status === 'revoked' ? 'revoked' : 'valid';
if (state === 'unknown') Astro.response.status = 404;
if (state === 'unavailable') Astro.response.status = 503;
const issuedOn = doc ? longDate(String(doc.fields?.issueDate || doc.issuedAt.slice(0, 10))) : '';
---
<BaseLayout title={'Verify document ' + serial} description="Verify an EduRankAI HR document by its number." noindex={true}>
  <main class="vd">
    <p class="eye">EduRankAI document verification</p>
    <div class={'banner ' + state} role="status">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {state === 'valid' ? <path d="M20 6 9 17l-5-5"></path> : <path d="M12 8v5M12 16.5v.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>}
      </svg>
      <div>
        {state === 'valid' && <><strong>Valid.</strong> This {def ? def.label.toLowerCase() : 'document'} was issued by EduRankAI and has not been revoked.</>}
        {state === 'revoked' && <><strong>Revoked.</strong> EduRankAI issued this document and later revoked it{doc && doc.revokedAt ? ' on ' + longDate(doc.revokedAt.slice(0, 10)) : ''}. It must not be relied on.{doc && doc.revokedReason ? ' Reason: ' + doc.revokedReason : ''}</>}
        {state === 'unknown' && <><strong>Not found.</strong> No EduRankAI document has the number {serial || 'given'}. Check the number printed at the foot of the document, or write to hr@edurankai.in.</>}
        {state === 'unavailable' && <><strong>Cannot check right now.</strong> The register could not be read, so this page cannot say whether the document is valid. Try again shortly, or write to hr@edurankai.in.</>}
      </div>
    </div>

    {doc && (
      <dl class="facts">
        <div><dt>Document</dt><dd>{def ? def.label : 'HR document'}</dd></div>
        <div><dt>Number</dt><dd class="mono">{doc.serial}</dd></div>
        <div><dt>Issued to</dt><dd>{doc.employeeName}</dd></div>
        <div><dt>Date of issue</dt><dd>{issuedOn}</dd></div>
        <div><dt>Issued by</dt><dd>EduRankAI</dd></div>
      </dl>
    )}

    {doc && state === 'valid' && (
      <section class="doc" aria-label="The document as issued">
        <Fragment set:html={doc.html} />
      </section>
    )}
  </main>

  <style>
    .vd { max-width: 820px; margin: 0 auto; padding: 36px 16px 72px; color: #0E0B08; }
    .eye { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #6b635c; font-weight: 700; margin: 0 0 10px; }
    .banner { display: flex; gap: 14px; align-items: flex-start; border-radius: 14px; padding: 18px 20px; font-size: 15px; line-height: 1.55; margin-bottom: 18px; }
    .banner svg { flex-shrink: 0; margin-top: 1px; }
    .banner.valid { background: #ecf7f0; border: 1px solid #86efac; color: #14532d; }
    .banner.revoked, .banner.unknown { background: #fff1f0; border: 1px solid #fca5a5; color: #7f1d1d; }
    .banner.unavailable { background: #fffbea; border: 1px solid #fcd34d; color: #713f12; }
    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin: 0 0 20px; }
    .facts div { background: #fff; border: 1px solid #e7dcc8; border-radius: 10px; padding: 10px 12px; }
    .facts dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #6b635c; }
    .facts dd { margin: 3px 0 0; font-weight: 600; font-size: 14px; }
    .mono { font-family: Consolas, Menlo, monospace; }
    .doc { overflow-x: auto; }
  </style>
</BaseLayout>
