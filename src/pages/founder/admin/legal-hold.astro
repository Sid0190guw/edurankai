---
// Founder console for retained business communications.
//
// There is deliberately NO "browse all messages" view here. Access happens under a numbered matter
// with a written reason, and every access is logged against the person whose messages were read.
// That constraint is the difference between a defensible business record and surveillance, and it
// is enforced in the library rather than by this page choosing not to offer a button.
import AdminLayout from '@/layouts/AdminLayout.astro';
import {
  canAccessHeldRecords, openMatter, closeMatter, listMatters,
  accessLogForMatter, disclosureText, DISCLOSURE_VERSION,
} from '@/lib/legal-hold';
import { logAudit } from '@/lib/audit';

const user = Astro.locals.user!;
// Founder only. Not admins, not super admins generally — see canAccessHeldRecords.
if (!canAccessHeldRecords(user as any)) return Astro.redirect('/admin');

let msg = '';
let err = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') || '');
  try {
    if (action === 'open') {
      const r = await openMatter({
        title: String(fd.get('title') || ''),
        reason: String(fd.get('reason') || ''),
        openedBy: user.id,
        subjectUserIds: String(fd.get('subjects') || '').split(',').map((s) => s.trim()).filter(Boolean),
      });
      if (r.ok) msg = `Matter ${r.reference} opened.`; else err = r.error || 'Could not open.';
    } else if (action === 'close') {
      await closeMatter(String(fd.get('id') || ''), user.id);
      msg = 'Matter closed. No further access can be logged against it.';
    }
    if (msg) await logAudit({ userId: user.id, action: 'legal_hold.' + action, entity: 'legal_matter', entityId: String(fd.get('id') || ''), ipAddress: Astro.clientAddress });
  } catch (e: any) {
    err = e?.cause?.message || e?.message || 'Something went wrong.';
  }
}

const open = await listMatters('open');
const closed = await listMatters('closed');
const selectedId = String(Astro.url.searchParams.get('matter') || '');
const accesses = selectedId ? await accessLogForMatter(selectedId) : [];

const card = 'border:1px solid #2a2a30;border-radius:12px;background:#0f0f14;padding:14px;margin-bottom:10px;';
const inp = 'width:100%;background:#12121a;border:1px solid #2a2a30;color:#e8e8ee;padding:8px 10px;border-radius:6px;font-size:12.5px;font-family:inherit;';
const when = (s: string) => { try { return new Date(s).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }); } catch { return s; } };
---
<AdminLayout title="Legal hold">
  <div style="max-width:940px;">
    <h1 style="font-family:'Fraunces',serif;font-size:26px;margin:0 0 4px;">Legal hold</h1>
    <p style="font-size:13px;color:#8a8a94;margin:0 0 16px;line-height:1.6;">
      Retained business communications &mdash; groups, direct messages, application threads and work
      mail. Access happens under a numbered matter with a written reason, and every access is logged
      against the person whose messages were read.
    </p>

    {msg && <div style="padding:10px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #14532d;background:rgba(20,83,45,0.2);font-size:13px;">{msg}</div>}
    {err && <div style="padding:10px 14px;border-radius:8px;margin-bottom:14px;border:1px solid #7f1d1d;background:rgba(127,29,29,0.2);font-size:13px;">{err}</div>}

    <div style="border:1px solid #b45309;background:rgba(180,83,9,0.1);border-radius:12px;padding:14px;margin-bottom:18px;">
      <p style="font-size:12.5px;font-weight:700;color:#fbbf24;margin:0 0 6px;">Before you open a matter</p>
      <p style="font-size:12px;color:#d4d4d8;margin:0;line-height:1.6;">
        The reason you write is the record of why this access was justified, and it is written before
        anything is read rather than reconstructed afterwards. Write it as though it will be read by
        the person whose messages you are about to look at &mdash; because they are entitled to ask
        for it, and the disclosure notice promises they can.
      </p>
    </div>

    {/* Open a matter */}
    <details style={card} open={open.length === 0}>
      <summary style="cursor:pointer;font-size:13px;font-weight:600;">Open a matter</summary>
      <form method="POST" style="display:flex;flex-direction:column;gap:10px;margin-top:12px;">
        <input type="hidden" name="_action" value="open" />
        <label style="font-size:11px;color:#8a8a94;">Title
          <input name="title" required maxlength="200" placeholder="e.g. Harassment complaint HR-118" style={inp} />
        </label>
        <label style="font-size:11px;color:#8a8a94;">Reason &mdash; at least 20 characters, specific
          <textarea name="reason" required rows="3" minlength="20" maxlength="4000"
            placeholder="What happened, who raised it, when, and what you need to establish." style={inp}></textarea>
        </label>
        <label style="font-size:11px;color:#8a8a94;">Subject user IDs (comma separated, optional)
          <input name="subjects" style={inp} placeholder="Leave blank if not yet known" />
        </label>
        <button type="submit" style="background:#FF4F00;border:0;color:#fff;font-weight:700;font-size:12.5px;padding:9px 16px;border-radius:6px;cursor:pointer;align-self:flex-start;">Open matter</button>
      </form>
    </details>

    <h2 style="font-family:'Fraunces',serif;font-size:17px;margin:20px 0 8px;">Open matters ({open.length})</h2>
    {open.length === 0 && <div style={card}><p style="font-size:12.5px;color:#8a8a94;margin:0;">No open matters. Nothing is being accessed.</p></div>}
    {open.map((m) => (
      <div style={card}>
        <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;">
          <div style="min-width:220px;flex:1;">
            <p style="font-size:13.5px;font-weight:700;color:#e8e8ee;margin:0;">
              <span style="font-family:'Geist Mono',monospace;color:#FF4F00;">{m.reference}</span> &nbsp;{m.title}
            </p>
            <p style="font-size:11.5px;color:#6e6e78;margin:3px 0 0;">Opened {when(m.openedAt)}</p>
            <p style="font-size:12px;color:#a0a0a8;margin:8px 0 0;line-height:1.55;">{m.reason}</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;">
            <a href={'/founder/admin/legal-hold?matter=' + m.id}
               style="font-size:11.5px;background:#1a1a22;border:1px solid #2a2a30;color:#e8e8ee;padding:6px 12px;border-radius:6px;text-decoration:none;text-align:center;">Access log</a>
            <form method="POST" style="margin:0;">
              <input type="hidden" name="_action" value="close" />
              <input type="hidden" name="id" value={m.id} />
              <button type="submit" onclick="return confirm('Close this matter? No further access can be logged against it.');"
                style="width:100%;font-size:11.5px;background:#1a1a22;border:1px solid #2a2a30;color:#8a8a94;padding:6px 12px;border-radius:6px;cursor:pointer;">Close</button>
            </form>
          </div>
        </div>
      </div>
    ))}

    {selectedId && (
      <>
        <h2 style="font-family:'Fraunces',serif;font-size:17px;margin:20px 0 8px;">Access log</h2>
        {accesses.length === 0 ? (
          <div style={card}><p style="font-size:12.5px;color:#8a8a94;margin:0;">Nothing has been accessed under this matter yet.</p></div>
        ) : (
          <div style="border:1px solid #2a2a30;border-radius:12px;overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;font-size:12px;">
              <thead><tr style="background:#12121a;">
                {['When', 'Who looked', 'Source', 'Items', 'Justification'].map((h) => (
                  <th style="text-align:left;padding:8px 10px;font-size:9.5px;text-transform:uppercase;letter-spacing:0.08em;color:#6e6e78;font-weight:700;">{h}</th>
                ))}
              </tr></thead>
              <tbody>
                {accesses.map((a) => (
                  <tr style="border-top:1px solid #1a1a22;">
                    <td style="padding:7px 10px;color:#8a8a94;white-space:nowrap;">{when(a.createdAt)}</td>
                    <td style="padding:7px 10px;color:#e8e8ee;">{a.accessedByName || a.accessedBy}</td>
                    <td style="padding:7px 10px;color:#a0a0a8;">{a.sourceKind}</td>
                    <td style="padding:7px 10px;color:#a0a0a8;font-family:monospace;">{a.itemCount}</td>
                    <td style="padding:7px 10px;color:#a0a0a8;">{a.justification}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )}

    {closed.length > 0 && (
      <>
        <h2 style="font-family:'Fraunces',serif;font-size:17px;margin:22px 0 8px;">Closed ({closed.length})</h2>
        {closed.slice(0, 20).map((m) => (
          <div style={card}>
            <p style="font-size:12.5px;color:#a0a0a8;margin:0;">
              <span style="font-family:'Geist Mono',monospace;color:#6e6e78;">{m.reference}</span> &nbsp;{m.title}
              <span style="color:#6e6e78;"> &middot; closed {m.closedAt ? when(m.closedAt) : ''}</span>
            </p>
          </div>
        ))}
      </>
    )}

    <div style={card + 'margin-top:22px;'}>
      <p style="font-size:12.5px;font-weight:700;color:#e8e8ee;margin:0 0 8px;">The notice staff are shown (version {DISCLOSURE_VERSION})</p>
      <ul style="margin:0;padding-left:18px;">
        {disclosureText().map((t) => (<li style="font-size:12px;color:#a0a0a8;line-height:1.6;margin-bottom:5px;">{t}</li>))}
      </ul>
      <p style="font-size:11.5px;color:#6e6e78;margin:10px 0 0;line-height:1.6;">
        Retention is only defensible if people were told. If this wording changes materially, raise
        DISCLOSURE_VERSION so everyone re-acknowledges rather than being assumed to have seen it.
      </p>
    </div>
  </div>
</AdminLayout>
