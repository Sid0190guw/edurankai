---
// /founder/console — the entrance to the person views, and the honest state of the org graph.
//
// =================================================================================================
// WHY THIS PAGE EXISTS AT ALL
// =================================================================================================
//
// The deliverable of this pass is /founder/console/person/[id] — one person, everything at once. A
// person page needs a way IN: a URL you can only reach by pasting a uuid is not "one click", and
// roughly forty-nine pages in this product are already unreachable for exactly that reason. This is
// the directory that makes the person view reachable, and the place the sidebar entry points at.
//
// IT IS NOT THE FULL FOUR-QUESTION CONSOLE. The load board, the org-wide approvals queue and the
// one-click assign action are a separate build, and two of the three are blocked on decisions the
// founder has to make (see the notes handed back with this pass). What is here is what can be said
// truthfully today: the state of the organization graph, and every active person, each one click
// from their own page.
//
// =================================================================================================
// GATING — THE SAME FOUR LINES AS /founder/admin, VERBATIM
// =================================================================================================
//
// An EMAIL EQUALITY, not a capability, and deliberately so: no new capability key is introduced by
// this console, because a key outside the union in src/lib/auth/permissions.ts answers false for
// every role including super_admin. The page is not in the admin nav's security model at all — it
// is behind its own door, exactly like /founder/admin.
//
// =================================================================================================
// NO POST HANDLER, DELIBERATELY
// =================================================================================================
//
// This page reads. The search is a GET form, so the state is in the URL and survives a back button,
// and there is no handler above the declarations to reach a `const` early — the hoisting trap that
// has taken pages down on this project. No action is reimplemented here: every button links to the
// screen that owns it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/founder-console.css';
import { composeWorkspace } from '@/lib/workforce/composer';
import { resolveOrgViewerScope } from '@/lib/org-chart';
import { reportingLineCoverage, coverageSentence } from '@/lib/org-assignment';
import { employeeOptions } from '@/lib/projects';
import { countOrDash } from '@/lib/founder-console';

const PATH = '/founder/console';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=/founder/console');
const isFounder = user.role === 'super_admin' && (user.email || '').toLowerCase() === 'siddharth@edurankai.in';
if (!isFounder) return Astro.redirect('/');

// ---- Query state, before anything reads it ------------------------------------------------------
const q = String(Astro.url.searchParams.get('q') || '').trim().slice(0, 80);
const qLower = q.toLowerCase();

// ---- The composition. One per request; composeWorkspace memoises on Astro.locals. ---------------
let composed: any = null;
try {
  composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
} catch (e: any) {
  console.error('[founder/console] compose', e?.cause?.message || e?.message);
}
const holds = (key: string): boolean => {
  try {
    return composed?.context?.holds ? composed.context.holds(key) === true : false;
  } catch {
    return false;
  }
};

// ---- Three reads, each allowed to fail on its own ------------------------------------------------
// resolveOrgViewerScope asks isInitialized() FIRST and the capability second, so an empty graph can
// never be dressed up here as a permission problem.
const settled = await Promise.allSettled([
  resolveOrgViewerScope(String(user.id), holds),
  reportingLineCoverage(),
  employeeOptions(500),
]);

const scope: any = settled[0].status === 'fulfilled' ? settled[0].value : null;
const coverage: any =
  settled[1].status === 'fulfilled' ? settled[1].value : { ok: false, withEdge: 0, columnOnly: 0, error: 'read failed' };
const people: any[] = settled[2].status === 'fulfilled' ? (settled[2].value as any[]) : [];
if (settled[0].status === 'rejected') console.error('[founder/console] scope', (settled[0].reason as any)?.cause?.message || (settled[0].reason as any)?.message);
if (settled[1].status === 'rejected') console.error('[founder/console] coverage', (settled[1].reason as any)?.cause?.message || (settled[1].reason as any)?.message);
if (settled[2].status === 'rejected') console.error('[founder/console] people', (settled[2].reason as any)?.cause?.message || (settled[2].reason as any)?.message);

// scope === null means resolveOrgViewerScope itself threw, which is a different fact from a graph
// with no rows in it. Both are unknowable; only one of them has a backfill as the fix.
const scopeRead = scope !== null;
const graphReady = scopeRead && scope.initialized === true;
const scopeDegraded = scopeRead && scope.degraded === true;

// employeeOptions() returns [] both for an empty register and for a failed read — it swallows its
// own error. So an empty list is never rendered as "there is nobody here".
const peopleRead = settled[2].status === 'fulfilled';
const filtered = qLower
  ? people.filter((p) =>
      String(p.fullName || '').toLowerCase().includes(qLower) ||
      String(p.designation || '').toLowerCase().includes(qLower))
  : people;
const listCapped = people.length >= 500;

const coverageLine = coverage.ok ? coverageSentence({ columnOnly: coverage.columnOnly, withEdge: coverage.withEdge }) : '';
---

<BaseLayout title="Founder Console" description="" showNav={false} showFooter={false} noindex={true}>
  <div class="fc">
    <header class="fc-top">
      <div>
        <p class="fc-eyebrow">EduRankAI &middot; Private</p>
        <h1 class="fc-h1">The <em>organization</em>, one click deep</h1>
        <p class="fc-sub">
          Every active person, each one click from a single page that gathers where they sit, what
          they are carrying and what is waiting on them. Nothing here is computed twice: each panel
          is read from the library that owns the question.
        </p>
      </div>
      <div class="fc-top-actions">
        <a href="/founder/admin" class="fc-btn ghost">Direct line &amp; revenue</a>
        <a href="/admin" class="fc-btn ghost">Admin</a>
      </div>
    </header>

    {!graphReady && (
      <div class="fc-note warn">
        <strong>The organization graph has not been described yet.</strong>
        {scopeRead
          ? ' No reporting lines, department heads, mentors or delegations are recorded, so every "who reports to whom" question below is unknowable rather than empty. Nothing is guessed from job titles or account settings.'
          : ' The graph could not be read just now, so its state is unknown — this is not the same as it being empty, and no reporting relationship shown or omitted below should be trusted until it answers.'}
        {' '}
        <a href="/admin/setup#org-graph">Open the graph setup step</a>, or record a line one person at
        a time from <a href="/admin/hr/employees">each employee record</a>.
      </div>
    )}

    {scopeDegraded && scope.gaps && scope.gaps.length > 0 && (
      <div class="fc-note">
        Some of this could not be read just now: {scope.gaps.join(', ')}. Treat anything missing below
        as unread rather than absent.
      </div>
    )}

    <div class="fc-stats">
      <div class="fc-stat">
        <span class="fc-stat-k">Reporting lines in the graph</span>
        <span class="fc-stat-v">{coverage.ok ? countOrDash(coverage.withEdge) : '—'}</span>
        <span class="fc-stat-s">
          {coverage.ok
            ? 'Active people with a manager on their record and an open edge in the graph.'
            : 'This could not be counted, so it is not zero — it is unknown.'}
        </span>
      </div>
      <div class="fc-stat accent">
        <span class="fc-stat-k">Behind the graph</span>
        <span class="fc-stat-v">{coverage.ok ? countOrDash(coverage.columnOnly) : '—'}</span>
        <span class="fc-stat-s">
          {coverage.ok
            ? 'Active people with a manager recorded only on the older employee field. This is the backfill.'
            : 'Unknown. A failed count is not an all-clear.'}
        </span>
      </div>
      <div class="fc-stat">
        <span class="fc-stat-k">People listed here</span>
        <span class="fc-stat-v">{peopleRead ? countOrDash(people.length) : '—'}</span>
        <span class="fc-stat-s">
          {peopleRead
            ? (listCapped
              ? 'Active employee records, capped at 500. There may be more.'
              : 'Active employee records. Name and designation only are read.')
            : 'The register could not be read.'}
        </span>
      </div>
      <div class="fc-stat">
        <span class="fc-stat-k">Graph state</span>
        <span class="fc-stat-v" style="font-size:1.15rem;line-height:1.3;padding-top:6px;">
          {scopeRead ? (graphReady ? 'Recorded' : 'Not described') : 'Unknown'}
        </span>
        <span class="fc-stat-s">
          Any active relationship of any type flips this on, including a single project-manager edge.
          Reporting coverage is the number to the left.
        </span>
      </div>
    </div>

    {coverageLine && <div class="fc-note">{coverageLine}</div>}

    <div class="fc-card">
      <h2 class="fc-card-h">Who is here</h2>
      <p class="fc-card-b">
        Active employee records. Only the name and the designation are read to draw this list &mdash;
        opening a person reads more, and says on the page exactly what it did not read.
      </p>

      <form method="GET" class="fc-find">
        <input type="search" name="q" value={q} placeholder="Find a person by name or designation" aria-label="Find a person" />
        <button type="submit" class="fc-btn primary">Find</button>
        {q && <a href="/founder/console" class="fc-btn ghost">Clear</a>}
      </form>

      {!peopleRead && (
        <div class="fc-empty">
          <b>The employee register could not be read</b>
          Nobody is listed because the query did not answer, not because there is nobody. Try again;
          if it keeps failing the reason is in the server log under [founder/console].
        </div>
      )}

      {peopleRead && people.length === 0 && (
        <div class="fc-empty">
          <b>No active employee records came back</b>
          That is either an empty register or a read that returned nothing without saying why &mdash;
          this list cannot tell the two apart, so it does not claim either. <a href="/admin/hr/employees">Open the employee register</a> to check.
        </div>
      )}

      {peopleRead && people.length > 0 && filtered.length === 0 && (
        <div class="fc-empty">
          <b>Nobody here matches that</b>
          The search runs over the names already loaded onto this page, so it cannot reach past the
          500-record cap. Clear it to see the full list.
        </div>
      )}

      {filtered.length > 0 && (
        <ul class="fc-list">
          {filtered.map((p: any) => (
            <li>
              <a class="fc-row" href={'/founder/console/person/' + p.employeeId}>
                <span class="fc-row-main">
                  <p class="fc-row-t">{p.fullName || 'Unnamed record'}</p>
                  <p class="fc-row-s">{p.designation || 'No designation recorded'}</p>
                </span>
                <span class="fc-row-r">Open</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {listCapped && (
        <p class="fc-card-b" style="margin-top:14px;">
          The register read stops at 500 people. If there are more than that, the rest are not on this
          page and the search above will not find them.
        </p>
      )}
    </div>

    <div class="fc-note">
      <strong>What this console will never show.</strong> Individual health and wellness data is out
      of bounds to everyone here, the founder included, and no page under /founder/console imports
      the wellness module at all. Legal-hold records need an open numbered matter and a written
      reason from the reader, which is a different door with its own access log &mdash; they are read
      at <a href="/founder/admin/held-records">held records</a> and nowhere else.
    </div>
  </div>
</BaseLayout>
