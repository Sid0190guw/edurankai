---
// /founder/console/person/[id]/intelligence — THE DOOR FOR src/lib/founder-intel/founder-profile.ts.
//
// WHY THIS FILE EXISTS. buildFounderProfile() was written, tested and left with no route in front of
// it: the repository orphan gate flagged founder-profile.ts as "imported only by its own test",
// which on this project means a built feature nobody can reach. Eighteen sections, the seven
// questions, the temporal readout and the role comparison were all sitting behind no URL.
//
// IT IS A SECOND READING, NOT A SECOND SOURCE. /founder/console/person/[id] composes the operational
// view — where they sit, what they are doing, what is overdue. This page composes the ASSEMBLED
// RECORD through Patch 11 and arranges it the way the founder brief asks for. Neither page queries
// what the other queries, so the two cannot disagree.
//
// THE GATE IS THE SAME ONE THE SIBLING PAGE USES, and it is deliberately an identity rather than a
// capability: isFounder() checks super_admin AND the founder address, so the audit trail for this
// screen has exactly one possible subject. `holds` is still the ordinary can() — the founder view
// does NOT bypass ratification, so a capability the organisation has not ratified renders as
// withheld here exactly as it does for a super admin.
//
// WHAT IS ABSENT RATHER THAN FILTERED: individual health, wellness and consult data. CLAUDE.md
// places it beyond every admin AND the founder. There is no query for it here and no panel that
// would fill if it existed; NEVER_ON_THIS_SCREEN is printed at the foot so the absence is stated
// rather than merely true.
//
// const BEFORE THE HANDLER. Every comparison resolved in the frontmatter — `<` and `<=` inside a
// JSX expression break .astro parsing and this project has lost a deploy to exactly that.
// ---------------------------------------------------------------------------------------------

import BaseLayout from '@/layouts/BaseLayout.astro';
import { can } from '@/lib/auth/permissions';
import { isFounder } from '@/lib/founder-intel/founder-access';
import { buildFounderProfile } from '@/lib/founder-intel/founder-profile';
import { askAll } from '@/lib/founder-intel/questions';
import { SECTION_STATUS_MEANING, screenTerminology } from '@/lib/horizon/contracts';

const id = String(Astro.params.id || '');
const PATH = '/founder/console/person/' + id + '/intelligence';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=' + encodeURIComponent(PATH));
if (!isFounder(user as any)) return Astro.redirect('/');

const CARD = 'background:#fff;border:1px solid rgba(0,0,0,0.10);border-radius:14px;padding:16px 18px;margin-bottom:16px;';
const HD = 'font-size:10.5px;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;opacity:0.55;margin:0 0 10px;';
const ACCENT = '#FF4F00';

// The comparison is a real piece of work and is not run on an ordinary page open. ?roles=1 asks.
const runRoleComparison = new URL(Astro.request.url).searchParams.get('roles') === '1';

const profile = await buildFounderProfile({
  employeeId: id,
  viewer: {
    id: String((user as any).id || ''),
    role: String((user as any).role || ''),
    email: String((user as any).email || ''),
    name: String((user as any).name || ''),
  },
  holds: (k: string) => can(user as any, k as any),
  ipAddress: Astro.request.headers.get('x-forwarded-for'),
  runRoleComparison,
});

// ---- EVERYTHING THE MARKUP READS, RESOLVED HERE ------------------------------------------------
const refusal = profile.refusal;
const displayName = profile.displayName || 'This person';
const sections = profile.sections;
const signals = profile.signals;
const temporal = profile.temporal;
const roles = profile.roles;
const notShown = profile.notShown;
const asOfLabel = new Date(profile.asOf).toLocaleString('en-IN');
const title = displayName + ' — assembled record';

const openLogNote = profile.base ? profile.base.openLogNote : null;
const accessSentence = profile.base ? profile.base.access.sentence : '';
const conflicts = profile.base ? profile.base.conflicts : [];
const registeredPatches = profile.base ? profile.base.registeredPatches : [];
const registeredList = registeredPatches.join(', ');
const recordRefusal = profile.base ? profile.base.recordRefusal : null;

const hasConflicts = conflicts.length > 0;
const hasSignals = signals.length > 0;
const hasTemporal = temporal.horizons.length > 0;
const hasComparable = roles.comparable.length > 0;
const sectionCount = sections.length;
const withheldCount = sections.filter((s) => s.status === 'withheld').length;
const answeringCount = sections.filter((s) => s.status === 'ok').length;

// Rule 19 at the boundary rather than trusted: every provider-supplied label goes through the
// terminology screen before it reaches the page, and the substitutions are counted so an operator
// finds out rather than the founder reading a birth-based word on somebody's record.
let substitutions = 0;
const safeText = (s: unknown) => {
  const c = screenTerminology(String(s || ''));
  if (!c.clean) substitutions += 1;
  return c.text;
};
for (const s of sections) { safeText(s.title); safeText(s.blurb); safeText(s.sentence); }
for (const s of signals) { safeText(s.label); safeText(s.statement); }
const hadSubstitutions = substitutions > 0;

// Lookup maps read through a function: a typed Record subscripted inside an .astro expression is one
// of the shapes that has broken parsing here, and a helper costs nothing.
const statusMeaning = (k: string) => (SECTION_STATUS_MEANING as any)[k] || '';

const statusLabel = (s: string) => {
  if (s === 'ok') return 'Answered';
  if (s === 'empty') return 'Nothing recorded';
  if (s === 'unreadable') return 'Could not be read';
  if (s === 'not_supplied') return 'Never wired up';
  if (s === 'withheld') return 'Withheld from this viewer';
  return s;
};

const statusColour = (s: string) => {
  if (s === 'ok') return '#1f7a3d';
  if (s === 'empty') return '#6e6e78';
  if (s === 'unreadable') return '#b3261e';
  if (s === 'not_supplied') return '#8a6d00';
  if (s === 'withheld') return '#5b5b66';
  return '#5b5b66';
};

// The seven questions are asked of the roll-up, not of each section's copy of a signal: the founder
// asks them of a finding, and the finding is the same one wherever it was surfaced.
const questioned = signals.slice(0, 12).map((s) => ({ signal: s, answers: askAll(s, profile.linked) }));
const questionedShown = questioned.length;
const moreSignals = signals.length - questionedShown;
const hasMoreSignals = moreSignals > 0;
---

<BaseLayout title={title}>
  <main style="max-width:920px;margin:0 auto;padding:20px 16px 64px;">

    <p style="margin:0 0 14px;font-size:0.85rem;">
      <a href={'/founder/console/person/' + id} style={'color:' + ACCENT + ';font-weight:600;'}>
        Back to the operational view
      </a>
    </p>

    {refusal ? (
      <div style={CARD}>
        <p style={HD}>Nothing was composed</p>
        <p style="margin:0;">{refusal}</p>
      </div>
    ) : (
      <div>

        {/* ---- WHAT THIS IS ---- */}
        <div style={CARD}>
          <p style={HD}>Assembled record</p>
          <h1 style="font-size:1.5rem;margin:0 0 6px;">{displayName}</h1>
          <p style="margin:0 0 10px;font-size:0.92rem;">{profile.sentence}</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;font-size:0.8rem;">
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {sectionCount} sections
            </span>
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {answeringCount} answered
            </span>
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {withheldCount} withheld
            </span>
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              Read {asOfLabel}
            </span>
          </div>
          {accessSentence && (
            <p style="margin:12px 0 0;font-size:0.84rem;opacity:0.75;">{accessSentence}</p>
          )}
          {openLogNote && (
            <p style="margin:8px 0 0;font-size:0.84rem;color:#b3261e;">{openLogNote}</p>
          )}
          {hadSubstitutions && (
            <p style="margin:8px 0 0;font-size:0.84rem;color:#8a6d00;">
              {substitutions} label(s) supplied by a producing module named a birth-based method and
              were replaced with the neutral term before rendering. That is a copy defect in the
              producing module, not a setting on this page.
            </p>
          )}
        </div>

        {/* ---- THE EIGHTEEN SECTIONS ---- */}
        {sections.map((s) => (
          <details open={s.openByDefault} style={CARD}>
            <summary style="cursor:pointer;font-weight:600;font-size:1rem;display:flex;justify-content:space-between;gap:12px;align-items:baseline;">
              <span>{safeText(s.title)}</span>
              <span style={'font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;white-space:nowrap;color:' + statusColour(s.status) + ';'}>
                {statusLabel(s.status)}
              </span>
            </summary>

            <p style="margin:12px 0 0;font-size:0.86rem;opacity:0.75;">{safeText(s.blurb)}</p>
            <p style="margin:8px 0 0;font-size:0.88rem;">{safeText(s.sentence)}</p>
            <p style="margin:8px 0 0;font-size:0.8rem;opacity:0.6;">
              {statusMeaning(s.status)}
            </p>
            <p style="margin:8px 0 0;font-size:0.8rem;opacity:0.6;">
              Owed by {s.owedBy}
              {s.fromProvider ? ' · answered by the producing patch' : ' · answered by the assembling adapter'}
              {s.requiredCapability ? ' · needs ' + s.requiredCapability : ''}
            </p>
            {s.depthSentence && (
              <p style="margin:8px 0 0;font-size:0.8rem;opacity:0.6;">{s.depthSentence}</p>
            )}
            {s.accessLogNote && (
              <p style="margin:8px 0 0;font-size:0.82rem;color:#b3261e;">{s.accessLogNote}</p>
            )}

            {s.signals.length > 0 && (
              <div style="margin:12px 0 0;display:grid;gap:8px;">
                {s.signals.map((sig: any) => (
                  <div style="padding:8px 0;border-top:1px solid rgba(0,0,0,0.06);">
                    <p style="margin:0;font-size:0.88rem;font-weight:600;">{safeText(sig.label)}</p>
                    <p style="margin:4px 0 0;font-size:0.86rem;">{safeText(sig.statement)}</p>
                    <p style="margin:4px 0 0;font-size:0.76rem;opacity:0.6;">
                      {String(sig.weightClass || '')} · produced by {String(sig.producedBy || 'an unnamed module')}
                      {sig.disputed ? ' · DISPUTED by a named human' : ''}
                    </p>
                  </div>
                ))}
              </div>
            )}

            {s.patterns.length > 0 && (
              <div style="margin:12px 0 0;display:grid;gap:8px;">
                {s.patterns.map((p: any) => (
                  <div style="padding:8px 0;border-top:1px solid rgba(0,0,0,0.06);">
                    <p style="margin:0;font-size:0.88rem;font-weight:600;">{safeText(p.label)}</p>
                    <p style="margin:4px 0 0;font-size:0.86rem;">{safeText(p.statement)}</p>
                  </div>
                ))}
              </div>
            )}
          </details>
        ))}

        {/* ---- THE SEVEN QUESTIONS ---- */}
        <div style={CARD}>
          <p style={HD}>The seven questions</p>
          {!hasSignals ? (
            <p style="margin:0;font-size:0.9rem;">
              No module raised a signal about this person. That is a statement about what has been
              recorded, not a finding about them.
            </p>
          ) : (
            <div style="display:grid;gap:16px;">
              {questioned.map((q) => (
                <div style="border-top:1px solid rgba(0,0,0,0.06);padding-top:12px;">
                  <p style="margin:0;font-size:0.92rem;font-weight:600;">{safeText(q.signal.label)}</p>
                  <p style="margin:4px 0 10px;font-size:0.88rem;">{safeText(q.signal.statement)}</p>
                  <div style="display:grid;gap:8px;">
                    {q.answers.map((a) => (
                      <div>
                        <p style="margin:0;font-size:0.78rem;font-weight:700;opacity:0.6;">{a.label}</p>
                        <p style="margin:2px 0 0;font-size:0.86rem;">{safeText(a.headline)}</p>
                        {a.lines.length > 0 && (
                          <ul style="margin:4px 0 0;padding-left:18px;font-size:0.84rem;">
                            {a.lines.map((l) => (
                              <li style="margin:2px 0;">
                                {l.href
                                  ? <a href={l.href} style={'color:' + ACCENT + ';'}>{safeText(l.text)}</a>
                                  : safeText(l.text)}
                                {l.note ? <span style="opacity:0.6;"> · {String(l.note)}</span> : ''}
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
              {hasMoreSignals && (
                <p style="margin:0;font-size:0.82rem;opacity:0.65;">
                  {moreSignals} further signal(s) were raised and are listed in their own sections
                  above. The seven questions are asked here of the twelve heaviest.
                </p>
              )}
            </div>
          )}
        </div>

        {/* ---- TIME ---- */}
        <div style={CARD}>
          <p style={HD}>Over time</p>
          <p style="margin:0 0 10px;font-size:0.88rem;">{temporal.sentence}</p>
          {temporal.error && (
            <p style="margin:0 0 10px;font-size:0.84rem;color:#b3261e;">{temporal.error}</p>
          )}
          {hasTemporal && (
            <div style="display:grid;gap:8px;">
              {temporal.horizons.map((h) => (
                <div style="padding:8px 0;border-top:1px solid rgba(0,0,0,0.06);">
                  <p style="margin:0;font-size:0.88rem;font-weight:600;">
                    {String(h.horizon)}
                    {h.stale ? <span style="color:#8a6d00;font-weight:500;"> · stale</span> : ''}
                  </p>
                  <p style="margin:4px 0 0;font-size:0.86rem;">{safeText(h.summary)}</p>
                  <p style="margin:4px 0 0;font-size:0.76rem;opacity:0.6;">
                    Confidence {String(h.confidenceBand)} · computed {String(h.computedAt).slice(0, 10)}
                  </p>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* ---- ROLES ---- */}
        <div style={CARD}>
          <p style={HD}>Role comparison</p>
          <p style="margin:0 0 10px;font-size:0.88rem;">{roles.sentence}</p>
          {roles.error && (
            <p style="margin:0 0 10px;font-size:0.84rem;color:#b3261e;">{roles.error}</p>
          )}
          {!roles.ran && hasComparable && (
            <p style="margin:0 0 10px;font-size:0.85rem;">
              <a href={PATH + '?roles=1'} style={'color:' + ACCENT + ';font-weight:600;'}>
                Run the comparison
              </a>
              <span style="opacity:0.6;"> — it is real work, so it is not run on an ordinary open.</span>
            </p>
          )}
          {hasComparable && (
            <div style="display:grid;gap:6px;">
              {roles.comparable.map((r) => (
                <p style="margin:0;font-size:0.86rem;">
                  <a href={'/admin/roles/' + r.id} style={'color:' + ACCENT + ';'}>{safeText(r.title)}</a>
                  <span style="opacity:0.6;">
                    {' · ' + r.requirementCount + ' mapped requirement(s)'}
                    {r.isOpen ? ' · open' : ' · not open'}
                  </span>
                </p>
              ))}
            </div>
          )}
        </div>

        {/* ---- WHAT THIS SCREEN WILL NEVER SHOW ---- */}
        <div style={CARD}>
          <p style={HD}>What this screen will never show</p>
          <div style="display:grid;gap:10px;">
            {notShown.map((n) => (
              <div>
                <p style="margin:0;font-size:0.88rem;font-weight:600;">{n.what}</p>
                <p style="margin:2px 0 0;font-size:0.84rem;opacity:0.75;">{n.because}</p>
                <p style="margin:2px 0 0;font-size:0.78rem;opacity:0.55;">{n.where}</p>
              </div>
            ))}
          </div>
        </div>

        {/* ---- THE WIRING, PRINTED ---- */}
        <div style={CARD}>
          <p style={HD}>Wiring</p>
          <p style="margin:0;font-size:0.84rem;opacity:0.75;">
            {registeredPatches.length === 0
              ? 'No producing patch is registered with the assembled record, so every section that '
                + 'depends on one reads as never wired up rather than as empty.'
              : 'Registered patches: ' + registeredList}
          </p>
          {recordRefusal && (
            <p style="margin:8px 0 0;font-size:0.84rem;color:#b3261e;">{recordRefusal}</p>
          )}
          {hasConflicts && (
            <div style="margin:10px 0 0;">
              <p style="margin:0 0 4px;font-size:0.84rem;font-weight:600;color:#8a6d00;">
                Ownership conflicts
              </p>
              {conflicts.map((c: any) => (
                <p style="margin:2px 0;font-size:0.82rem;opacity:0.8;">
                  {String(c.section || c.key || '')} — {String(c.reason || c.detail || 'claimed twice')}
                </p>
              ))}
            </div>
          )}
        </div>

      </div>
    )}
  </main>
</BaseLayout>
