---
// /founder/console/person/[id] — ONE PERSON, EVERYTHING AT ONCE.
//
// The console linked here and this page did not exist, so every row on it led to a 404. That is the
// defect this file closes first.
//
// WHAT IT COMPOSES, AND WHY NOTHING IS RE-QUERIED. Manager, mentor and delegates come from
// org-chart.ts; direct reports from org-graph.ts; work from employee-tasks; leave from hr-leave;
// learning from performance-learning. Each is the function the screen that owns it already uses, so
// a figure here cannot disagree with the figure there. A founder acting on a number that only this
// page believes is worse than a founder with no number at all.
//
// WHAT THIS PAGE MUST NEVER SHOW, and it is absent rather than filtered:
//   - individual wellness or health data. CLAUDE.md places it beyond every admin AND the founder.
//     There is no query for it here, no panel that would fill if the data existed, and no import
//     that could reach it. Absence is the mechanism; a hidden panel is not.
//   - legal-hold records, which require an open numbered matter and a written reason from whoever
//     reads them. A founder console is not that, so it does not ask.
//
// EVERY ACTION LINKS OUT. Nothing is reimplemented here — assigning, approving and editing happen on
// the screens that own them, with their confirmations and their audit. This page is a view.
//
// const BEFORE THE HANDLER. MOBILE FIRST.
// ---------------------------------------------------------------------------------------------

import BaseLayout from '@/layouts/BaseLayout.astro';
import { countOrDash } from '@/lib/founder-console';
import { personDetail } from '@/lib/org-chart';
import { getDirectReports } from '@/lib/org-graph';
import { sql } from 'drizzle-orm';
import { db } from '@/lib/db';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login?next=/founder/console');
const isFounder = user.role === 'super_admin' && (user.email || '').toLowerCase() === 'siddharth@edurankai.in';
if (!isFounder) return Astro.redirect('/');

const CARD = 'background:#fff;border:1px solid rgba(0,0,0,0.10);border-radius:14px;padding:16px 18px;margin-bottom:16px;';
const HD = "font-size:10.5px;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;opacity:0.55;margin:0 0 10px;";

const id = String(Astro.params.id || '');
const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);

/** Every read carries its own failure. One dead source degrades one panel, never the page. */
async function safe<T>(label: string, fn: () => Promise<T>, fallback: T): Promise<{ value: T; error: string | null }> {
  try {
    return { value: await fn(), error: null };
  } catch (e: any) {
    const why = e?.cause?.message || e?.message || 'unknown error';
    console.error('[founder/person] ' + label + ':', why);
    return { value: fallback, error: why };
  }
}

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

// ---- THE RECORD ---------------------------------------------------------------------------------
const rec = !isUuid ? { value: null as any, error: null } : await safe('record', async () => {
  const r = rowsOf(await db.execute(sql`
    SELECT e.id, e.full_name, e.designation, e.employment_type, e.classification,
           e.classification_reviewed_at, e.date_of_joining, e.work_email, e.is_active,
           e.employee_code, d.name AS department_name
    FROM hr_employees e
    LEFT JOIN departments d ON d.id::text = e.department_id::text
    WHERE e.id = ${id}::uuid`));
  return rowsOf(r).length ? rowsOf(r)[0] : (r[0] || null);
}, null);

const person = rec.value;

// ---- ORGANIZATION -------------------------------------------------------------------------------
const detail = !isUuid ? { value: { managerName: null, mentorName: null, delegateNames: [] }, error: null }
  : await safe('detail', () => personDetail(id), { managerName: null, mentorName: null, delegateNames: [] });

const reports = !isUuid ? { value: [] as any[], error: null }
  : await safe('reports', () => getDirectReports(id), [] as any[]);

// ---- WORK ---------------------------------------------------------------------------------------
const work = !isUuid ? { value: [] as any[], error: null } : await safe('work', async () => {
  // employee_tasks, keyed on employee_id. OPEN is assigned through blocked: what is theirs right now.
  const r = await db.execute(sql`
    SELECT id, title, status, priority, due_on
    FROM employee_tasks
    WHERE employee_id = ${id}::uuid
      AND status IN ('assigned','accepted','in_progress','blocked')
    ORDER BY (due_on IS NULL), due_on ASC
    LIMIT 40`);
  return rowsOf(r);
}, [] as any[]);

// ---- LEAVE --------------------------------------------------------------------------------------
const leave = !isUuid ? { value: [] as any[], error: null } : await safe('leave', async () => {
  const { listLeave } = await import('@/lib/hr-leave');
  return await listLeave({ employeeId: id });
}, [] as any[]);

// ---- LEARNING -----------------------------------------------------------------------------------
const learning = !isUuid ? { value: [] as any[], error: null } : await safe('learning', async () => {
  const { learningPathFor } = await import('@/lib/performance-learning');
  return await learningPathFor(id);
}, [] as any[]);

const overdue = work.value.filter((t: any) => t.due_on && new Date(String(t.due_on)) < new Date());
const pendingLeave = leave.value.filter((l: any) => String(l.status || '') === 'pending');
const title = person ? String(person.full_name || 'Person') : 'Person';
---

<BaseLayout title={title}>
  <main style="max-width:900px;margin:0 auto;padding:20px 16px 72px;">

    <p style="margin:0 0 14px;font-size:0.85rem;">
      <a href="/founder/console" style="color:#FF4F00;font-weight:600;">Back to the console</a>
    </p>

    {!isUuid ? (
      <div style={CARD}>
        <p style="margin:0;">That is not a valid person reference, so nothing was looked up.</p>
      </div>
    ) : rec.error ? (
      <div style={CARD}>
        <p style="margin:0;">This person could not be read. The reason given was: {rec.error}</p>
      </div>
    ) : !person ? (
      <div style={CARD}>
        <p style="margin:0;">
          No employee record exists with that reference. It may have been removed, or the link may be
          from an older version of the console.
        </p>
      </div>
    ) : (
      <div>
        {/* ---- WHO ---- */}
        <div style={CARD}>
          <p style={HD}>Person</p>
          <h1 style="font-size:1.5rem;margin:0 0 6px;">{String(person.full_name || 'Unnamed')}</h1>
          <p style="margin:0 0 10px;opacity:0.75;font-size:0.92rem;">
            {[person.designation, person.department_name, person.employment_type]
              .filter(Boolean).map(String).join(' · ') || 'No role, department or engagement recorded'}
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;font-size:0.82rem;">
            {person.employee_code && (
              <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
                {String(person.employee_code)}
              </span>
            )}
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {person.is_active ? 'Active' : 'Not active'}
            </span>
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {person.classification
                ? String(person.classification)
                : 'Classification not set'}
            </span>
            <span style="padding:4px 10px;border:1px solid rgba(0,0,0,0.12);border-radius:999px;">
              {person.classification_reviewed_at
                ? 'Reviewed ' + String(person.classification_reviewed_at).slice(0, 10)
                : 'Never reviewed'}
            </span>
          </div>
          <p style="margin:12px 0 0;font-size:0.85rem;">
            <a href={'/admin/hr/employees/' + id} style="color:#FF4F00;font-weight:600;">Open the HR record</a>
            <span style="opacity:0.4;"> · </span>
            <a href="/portal/tasks" style="color:#FF4F00;font-weight:600;">Assign work</a>
            <span style="opacity:0.4;"> · </span>
            <a href="/admin/hr/classification" style="color:#FF4F00;font-weight:600;">Classification</a>
          </p>
        </div>

        {/* ---- WHERE THEY SIT ---- */}
        <div style={CARD}>
          <p style={HD}>Where they sit</p>
          {detail.error ? (
            <p style="margin:0;">The organization graph could not be read. The reason given was: {detail.error}</p>
          ) : (
            <div style="display:grid;gap:8px;font-size:0.92rem;">
              <p style="margin:0;">
                <span style="opacity:0.6;">Reports to </span>
                {detail.value.managerName
                  ? <strong>{detail.value.managerName}</strong>
                  : <span style="opacity:0.7;">nobody — no reporting relationship is recorded in the graph,
                      so their requests have no approver.
                      <a href="/admin/org/graph" style="color:#FF4F00;font-weight:600;"> Fix the graph</a>
                    </span>}
              </p>
              <p style="margin:0;">
                <span style="opacity:0.6;">Mentor </span>
                {detail.value.mentorName ? <strong>{detail.value.mentorName}</strong> : <span style="opacity:0.55;">none</span>}
              </p>
              <p style="margin:0;">
                <span style="opacity:0.6;">Acting for them </span>
                {detail.value.delegateNames.length
                  ? <strong>{detail.value.delegateNames.join(', ')}</strong>
                  : <span style="opacity:0.55;">nobody</span>}
              </p>
              <p style="margin:0;">
                <span style="opacity:0.6;">Direct reports </span>
                {reports.error
                  ? <span style="opacity:0.7;">could not be read: {reports.error}</span>
                  : reports.value.length === 0
                    ? <span style="opacity:0.55;">none recorded</span>
                    : <strong>{reports.value.map((r: any) => r.fullName || 'Unnamed').join(', ')}</strong>}
              </p>
            </div>
          )}
        </div>

        {/* ---- WHAT THEY ARE DOING ---- */}
        <div style={CARD}>
          <p style={HD}>Work in hand — {work.error ? '—' : countOrDash(work.value.length)}</p>
          {work.error ? (
            <p style="margin:0;">This could not be read. The reason given was: {work.error}</p>
          ) : work.value.length === 0 ? (
            <p style="margin:0;">
              Nothing is assigned to them. That is a fact about the organization, not a gap in the
              data — nobody has given them work through the task board.
            </p>
          ) : (
            <div>
              {overdue.length > 0 && (
                <p style="margin:0 0 10px;color:#c62828;font-weight:600;font-size:0.88rem;">
                  {overdue.length} past its date
                </p>
              )}
              <div style="display:grid;gap:8px;">
                {work.value.map((t: any) => (
                  <div style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid rgba(0,0,0,0.06);">
                    <span style="font-size:0.9rem;">{String(t.title || 'Untitled')}</span>
                    <span style="font-size:0.8rem;opacity:0.65;white-space:nowrap;">
                      {String(t.status || '')}
                      {t.due_on ? ' · ' + String(t.due_on).slice(0, 10) : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* ---- LEAVE ---- */}
        <div style={CARD}>
          <p style={HD}>Leave</p>
          {leave.error ? (
            <p style="margin:0;">This could not be read. The reason given was: {leave.error}</p>
          ) : leave.value.length === 0 ? (
            <p style="margin:0;">No leave has been requested.</p>
          ) : (
            <div>
              {pendingLeave.length > 0 && (
                <p style="margin:0 0 8px;font-weight:600;font-size:0.88rem;">
                  {pendingLeave.length} waiting for a decision
                  <a href="/admin/hr/leave" style="color:#FF4F00;"> — open the queue</a>
                </p>
              )}
              <p style="margin:0;font-size:0.88rem;opacity:0.75;">
                {leave.value.length} requests on record.
              </p>
            </div>
          )}
        </div>

        {/* ---- LEARNING ---- */}
        <div style={CARD}>
          <p style={HD}>Learning</p>
          {learning.error ? (
            <p style="margin:0;">This could not be read. The reason given was: {learning.error}</p>
          ) : learning.value.length === 0 ? (
            <p style="margin:0;">Nothing has been assigned to them.
              <a href="/admin/hr/performance/learning" style="color:#FF4F00;font-weight:600;"> Assign a course</a>
            </p>
          ) : (
            <div style="display:grid;gap:6px;">
              {learning.value.slice(0, 12).map((l: any) => (
                <p style="margin:0;font-size:0.9rem;">
                  {String(l.title || l.courseTitle || 'Course')}
                  <span style="opacity:0.6;"> · {String(l.state || l.status || 'assigned')}</span>
                </p>
              ))}
            </div>
          )}
        </div>

        {/* The limit, stated rather than left as an unexplained absence. */}
        <p style="margin:0;font-size:0.8rem;opacity:0.6;line-height:1.6;">
          Health and wellness records are not shown here and cannot be reached from this page by
          anyone, including the founder. Legal-hold records need an open matter and a written reason,
          which a console is not.
        </p>
      </div>
    )}

  </main>
</BaseLayout>
