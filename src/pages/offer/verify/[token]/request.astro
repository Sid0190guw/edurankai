---
// The formal-certification request form the two buttons on the verify page point at.
//
// Until this existed those buttons 404'd, which is worse than the manual email route they replaced.
//
// Free path (individual / educational institution) completes here: the request is recorded and the
// team notified. Firm path records the request as awaiting payment and tells them we will send a
// payment link — the card leg is not wired yet, and taking a card number we cannot charge would be
// worse than saying plainly that an invoice follows.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { createRequest, notifyNewRequest, isFreePath, FIRM_VERIFICATION_FEE_CHF, type VerifierKind } from '@/lib/offer-verification';

const token = String(Astro.params.token || '');
const qKind = String(Astro.url.searchParams.get('kind') || 'institution');
const kind: VerifierKind = qKind === 'firm' ? 'firm' : qKind === 'individual' ? 'individual' : 'institution';
const free = isFreePath(kind);

const rows = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

// Confirm the token belongs to a real offer before collecting anyone's details. Nothing about the
// candidate is shown here — only that the reference is valid.
let validToken = false;
try {
  validToken = rows(await db.execute(sql`SELECT 1 FROM offer_letters WHERE token = ${token} LIMIT 1`)).length > 0;
} catch { validToken = false; }

let done = false;
let err = '';

if (Astro.request.method === 'POST' && validToken) {
  const fd = await Astro.request.formData();
  const res = await createRequest({
    token,
    kind,
    requesterName: String(fd.get('name') || ''),
    requesterEmail: String(fd.get('email') || ''),
    requesterPhone: String(fd.get('phone') || ''),
    organisation: String(fd.get('organisation') || ''),
    designation: String(fd.get('designation') || ''),
    orgWebsite: String(fd.get('website') || ''),
    purpose: String(fd.get('purpose') || ''),
    ip: Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || Astro.clientAddress || null,
    userAgent: Astro.request.headers.get('user-agent'),
  });
  if (res.ok) {
    done = true;
    await notifyNewRequest({
      id: res.id || '', kind, token,
      requesterName: String(fd.get('name') || ''),
      organisation: String(fd.get('organisation') || ''),
    });
  } else {
    err = res.error || 'Could not submit that.';
  }
}

const label = kind === 'firm' ? 'Employer, firm or organisation'
  : kind === 'individual' ? 'Individual' : 'Educational institution';
const field = 'w-full px-3 py-3 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-white';
---
<BaseLayout title="Request offer-letter certification" description="Request a formal certification of an EduRankAI offer letter.">
  <section class="px-[5vw] py-10 md:py-14 max-w-xl mx-auto">
    {!validToken ? (
      <div class="border border-ink/12 rounded-xl p-6 text-center">
        <h1 class="font-display text-[1.3rem] font-semibold text-ink mb-2">Reference not recognised</h1>
        <p class="text-[0.88rem] text-ink-soft leading-relaxed">
          We could not find an offer letter with that reference. Please check the link or QR code, or
          write to <a href="mailto:hr@edurankai.in" class="text-burn underline">hr@edurankai.in</a>.
        </p>
      </div>
    ) : done ? (
      <div class="border border-green-200 bg-green-50 rounded-xl p-6">
        <h1 class="font-display text-[1.3rem] font-semibold text-green-900 mb-2">Request received</h1>
        <p class="text-[0.88rem] text-green-900 leading-relaxed">
          {free
            ? 'Our team will send the signed certification to the email you gave, usually within two working days.'
            : `We will email you a payment link for the ${FIRM_VERIFICATION_FEE_CHF} CHF certification fee, charged in INR at the live rate. The certification is issued once payment clears.`}
        </p>
        <p class="text-[0.8rem] text-green-900/80 mt-3">Reference: <span class="font-mono">{token.slice(0, 12)}</span></p>
      </div>
    ) : (
      <>
        <p class="text-[0.7rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-2">{label}</p>
        <h1 class="font-display text-[1.5rem] md:text-[1.9rem] font-semibold text-ink mb-2">Request a formal certification</h1>
        <p class="text-[0.88rem] text-ink-soft leading-relaxed mb-2">
          {free
            ? 'There is no charge for individuals or educational institutions.'
            : `This path carries a ${FIRM_VERIFICATION_FEE_CHF} CHF fee, charged in INR at the live exchange rate. We will email a payment link.`}
        </p>
        <p class="text-[0.8rem] text-ink-soft leading-relaxed mb-6">
          A certification confirms the letter is genuine and states the role and dates. It does not
          disclose salary, contact details or the candidate's application.
        </p>

        {err && <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl p-3.5 mb-4 text-[0.86rem]">{err}</div>}

        <form method="POST" class="flex flex-col gap-3.5">
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Your name <span class="text-burn">*</span></span>
            <input name="name" required maxlength="120" class={field} />
          </label>
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Your work email <span class="text-burn">*</span></span>
            <input name="email" type="email" required maxlength="160" class={field} />
          </label>
          {kind !== 'individual' && (
            <label class="block">
              <span class="block text-[0.78rem] font-semibold text-ink mb-1">
                {kind === 'firm' ? 'Organisation' : 'Institution'} <span class="text-burn">*</span>
              </span>
              <input name="organisation" required maxlength="160" class={field} />
            </label>
          )}
          <div class="grid sm:grid-cols-2 gap-3.5">
            <label class="block">
              <span class="block text-[0.78rem] font-semibold text-ink mb-1">Your role there</span>
              <input name="designation" maxlength="120" class={field} />
            </label>
            <label class="block">
              <span class="block text-[0.78rem] font-semibold text-ink mb-1">Phone</span>
              <input name="phone" maxlength="40" class={field} />
            </label>
          </div>
          {kind !== 'individual' && (
            <label class="block">
              <span class="block text-[0.78rem] font-semibold text-ink mb-1">Website</span>
              <input name="website" type="url" placeholder="https://" maxlength="200" class={field} />
            </label>
          )}
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Why you need it</span>
            <textarea name="purpose" rows="3" maxlength="600" class={field}
              placeholder="e.g. pre-employment background check, admissions verification"></textarea>
          </label>
          <p class="text-[0.74rem] text-ink-soft leading-relaxed">
            We record who requests a verification and why. The candidate may be told that a
            verification was requested.
          </p>
          <button type="submit" class="w-full bg-burn text-white font-semibold py-3.5 rounded-lg text-[0.95rem]">
            {free ? 'Submit request' : 'Request payment link'}
          </button>
          <a href={`/offer/verify/${token}`} class="text-center text-[0.84rem] text-ink-soft underline underline-offset-2">Back to the free authenticity check</a>
        </form>
      </>
    )}
  </section>
</BaseLayout>
