---
// /akasha-q/demo — AQ-DEMO-UI-001, the demonstration control room.
//
// A working reference implementation of the twelve-panel specification in Part 26 §26.5, running
// against a simulated AQ-NODE-01. It exists so the decision logic and the interface contract can be
// exercised and criticised before any hardware is committed.
//
// HONESTY BOUNDARY, enforced in the page copy below: this is a simulation of the SPECIFICATION.
// There is no physical measurement, no entropy source and no optical link behind it, and no result
// it produces constitutes evidence at any level. That statement is part of the page, not a footnote.
//
// THE FIRST ENGINE ASSERTED ITS CONCLUSIONS AND WAS REPLACED. Each injection wrote a display value
// and then, on the next statement, wrote the domain status it wanted to show: contradiction set
// temp-A to 41.2 and set physical='UNDETERMINED' independently. Nothing compared the two
// temperatures, so making them identical still produced UNDETERMINED. No displayed number
// influenced any decision, which is precisely the failure criterion AQ-SCN-002 names for
// Scenario 2 -- "any injected degradation is not DETECTED; a domain resolves a contradiction by
// picking a value" -- and precisely the demonstration theatre Part 26 exists to prevent.
//
// The engine below derives. One direction only:
//   INPUTS -> derive() -> domain confidence + the sentence that produced it
//          -> assess() -> trust state
//          -> gates()  -> Q1/Q2/Q3 from the COMMAND against a roster, Q4 from the STATE
//          -> decide() -> DENY | ABSTAIN | SAFE-HOLD | EXECUTE
// Injections write inputs and nothing else. Every threshold lives in R and is rendered in P6, so a
// reader can check a conclusion against the rule that produced it instead of trusting a colour.
//
// The script is `is:inline` so Astro passes it through untouched — it is a self-contained IIFE with
// no imports and no build-time dependency.
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="AQ-DEMO-UI-001 Control Room · Akasha-Q"
  description="Working reference implementation of the Akasha-Q demonstration control room: twelve live panels over a simulated AQ-NODE-01, with Scenario 2 degradation injection. Simulation of a specification; not instrumented hardware.">

<style>
  body { background:#0a0a0c; color:#e8e8ee; }
  .aqd-wrap { max-width:1420px; margin:0 auto; padding:34px 4vw 90px; font-family:'Space Grotesk',system-ui,sans-serif; }
  .aqd-back { display:inline-block; font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:#67e8f9; text-decoration:none; margin-bottom:22px; }
  .aqd-back:hover { text-decoration:underline; }
  .aqd-eyebrow { font-family:'Geist Mono',monospace; font-size:10.5px; letter-spacing:0.18em; text-transform:uppercase; color:#a78bfa; font-weight:700; margin:0 0 7px; }
  .aqd-h1 { font-family:'Cormorant Garamond',serif; font-size:clamp(28px,4vw,44px); font-weight:600; letter-spacing:-0.03em; margin:0 0 10px; line-height:1.08; }
  .aqd-sub { font-size:14.5px; color:#9aa6b6; max-width:82ch; line-height:1.65; margin:0 0 20px; }
  .aqd-ctl { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 16px; padding:13px 15px; background:#11131a; border:1px solid #2a2a35; border-radius:11px; }
  .aqd-lab { font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:0.13em; text-transform:uppercase; color:#7e8a99; font-weight:700; }
  .aqd-wrap button { font-family:'Geist Mono',monospace; font-size:11px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; padding:8px 12px; border:1px solid #2a2a35; background:#171922; color:#c8d2dc; cursor:pointer; border-radius:6px; }
  .aqd-wrap button:hover { border-color:#67e8f9; color:#67e8f9; }
  .aqd-wrap button:focus-visible { outline:2px solid #67e8f9; outline-offset:2px; }
  .aqd-wrap button.on { background:rgba(251,191,36,0.12); border-color:#fbbf24; color:#fbbf24; }
  .aqd-wrap button.primary { background:rgba(103,232,249,0.10); border-color:#67e8f9; color:#67e8f9; }
  .aqd-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  @media (max-width:1000px) { .aqd-grid { grid-template-columns:1fr; } }
  .aqd-p { background:#11131a; border:1px solid #2a2a35; border-radius:11px; padding:12px 14px; min-width:0; }
  .aqd-p h2 { font-family:'Geist Mono',monospace; font-size:9.5px; letter-spacing:0.14em; text-transform:uppercase; color:#7e8a99; font-weight:700; margin:0 0 9px; padding-bottom:7px; border-bottom:1px solid #22242e; display:flex; justify-content:space-between; gap:8px; }
  .aqd-p h2 span { color:#67e8f9; }
  .aqd-row { display:flex; justify-content:space-between; gap:10px; font-family:'Geist Mono',monospace; font-size:11.5px; padding:2.5px 0; color:#9aa6b6; }
  .aqd-row b { color:#e8e8ee; font-weight:500; }
  .aqd-tag { font-family:'Geist Mono',monospace; font-size:8.5px; letter-spacing:0.1em; padding:1px 4px; border:1px solid; border-radius:3px; text-transform:uppercase; }
  .t-meas { color:#86efac; border-color:#86efac; }
  .t-der { color:#67e8f9; border-color:#67e8f9; }
  .t-mod { color:#fbbf24; border-color:#fbbf24; }
  .aqd-state { font-family:'Geist Mono',monospace; font-size:23px; font-weight:700; letter-spacing:0.04em; margin:4px 0 2px; }
  .s-NORMAL { color:#86efac; } .s-RESTRICTED { color:#fbbf24; } .s-CRITICAL { color:#f87171; }
  .s-DENY { color:#f87171; } .s-RECOVERING { color:#67e8f9; }
  .aqd-dwell { font-family:'Geist Mono',monospace; font-size:11px; color:#7e8a99; }
  .aqd-q { display:flex; justify-content:space-between; font-family:'Geist Mono',monospace; font-size:11.5px; padding:4px 0; border-bottom:1px solid #22242e; }
  .aqd-q:last-child { border:0; }
  .ok { color:#86efac; } .bad { color:#f87171; } .hold { color:#fbbf24; } .unk { color:#7e8a99; }
  .aqd-und { font-family:'Geist Mono',monospace; font-size:11px; color:#f87171; border:1px solid #f87171; padding:6px 8px; margin-top:8px; border-radius:6px; }
  .aqd-und.empty { color:#86efac; border-color:#2f5f43; }
  .aqd-log { font-family:'Geist Mono',monospace; font-size:10.5px; line-height:1.65; max-height:215px; overflow-y:auto; color:#9aa6b6; }
  .aqd-log div { padding:1.5px 0; border-bottom:1px solid #1c1e26; display:flex; gap:8px; cursor:pointer; }
  .aqd-log .ts { color:#616d7a; flex:none; }
  .aqd-log .inj { color:#fbbf24; font-weight:700; }
  .aqd-log .tr { color:#67e8f9; font-weight:700; }
  .aqd-log .dn { color:#f87171; font-weight:700; }
  .aqd-wide { grid-column:1/-1; }
  .aqd-trace { font-family:'Geist Mono',monospace; font-size:10.5px; color:#9aa6b6; white-space:pre-wrap; word-break:break-word; margin:0; }
  .aqd-note { font-size:13px; color:#9aa6b6; margin:16px 0 0; max-width:92ch; line-height:1.65; }
  .aqd-note b { color:#e8e8ee; }
  .aqd-legend { font-family:'Geist Mono',monospace; font-size:9.5px; color:#7e8a99; margin:7px 0 0; line-height:1.6; }
</style>

<main class="aqd-wrap">
  <a class="aqd-back" href="/akasha-q">&larr; Charter</a>
  <p class="aqd-eyebrow">Akasha-Q &middot; Part 26 &sect;26.5 &middot; reference implementation</p>
  <h1 class="aqd-h1">AQ-DEMO-UI-001 &mdash; Demonstration Control Room</h1>
  <p class="aqd-sub">
    All twelve panels, driven by a simulated AQ-NODE-01. Inject the Scenario&nbsp;2 degradations and
    watch confidence fall, the trust state degrade, and a valid authorised command receive
    <b>safe-hold</b> rather than execution. Every domain status, gate result and decision is
    <b>derived</b> from the inputs in P2 by the thresholds listed in P6 &mdash; change an input and the
    conclusion changes. The inputs themselves are synthetic constants tagged
    <span class="aqd-tag t-meas">SIM-OBS</span>; nothing here is measured.
  </p>

  <div class="aqd-ctl">
    <span class="aqd-lab">Scenario 2 injections</span>
    <button id="i-delay" type="button">Input delay</button>
    <button id="i-missing" type="button">Missing input</button>
    <button id="i-contra" type="button">Contradiction</button>
    <button id="i-stale" type="button">Stale timing</button>
    <button id="i-qual" type="button">Reduced quality</button>
    <span class="aqd-lab" style="margin-left:12px;">Command</span>
    <button id="send" type="button" class="primary">Send signed command</button>
    <button id="sendbad" type="button">Send forged command</button>
    <span class="aqd-lab" style="margin-left:12px;">Run</span>
    <button id="reset" type="button">Reset to nominal</button>
  </div>

  <div class="aqd-grid">
    <div class="aqd-p"><h2>P1 System status <span id="p1v">&mdash;</span></h2><div id="p1"></div></div>
    <div class="aqd-p"><h2>P3 Time state</h2><div id="p3"></div></div>
    <div class="aqd-p"><h2>P5 Current state</h2><p class="aqd-state" id="p5s">NORMAL</p><p class="aqd-dwell" id="p5d">in state 0s</p></div>

    <div class="aqd-p"><h2>P2 Input sources</h2><div id="p2"></div></div>
    <div class="aqd-p"><h2>P4 Input quality</h2><div id="p4"></div></div>
    <div class="aqd-p"><h2>P6 Domain confidence <span>higher is better</span></h2><div id="p6"></div><p class="aqd-und empty" id="p6u">UNDETERMINED: none</p><p class="aqd-legend" id="p6r"></p></div>

    <div class="aqd-p"><h2>P7 Decision status</h2><div id="p7"></div></div>
    <div class="aqd-p"><h2>P8 Authorization <span>Q1&ndash;Q4</span></h2><div id="p8"></div></div>
    <div class="aqd-p"><h2>P9 Action / response</h2><div id="p9"></div></div>

    <div class="aqd-p"><h2>P10 Active faults</h2><div id="p10"></div></div>
    <div class="aqd-p" style="grid-column:span 2;"><h2>P11 Event timeline <span id="p11c">0</span></h2><div class="aqd-log" id="p11"></div></div>

    <div class="aqd-p aqd-wide"><h2>P12 Trace reference <span>select an event in P11</span></h2><p class="aqd-trace" id="p12">No event selected.</p></div>
  </div>

  <p class="aqd-note">
    <b>What to try.</b> Send the signed command while nominal &mdash; Q1&ndash;Q4 all pass and it
    <b>executes</b>. Now inject <b>Stale timing</b> and send again: holdover becomes 671&nbsp;s, which
    the timing rule scores against its 900&nbsp;s bound, so confidence falls and the state degrades
    &mdash; identity, key and authority still pass, but Q4 gates it and the result is
    <b>SAFE-HOLD</b>. Then send the <b>forged</b> command: Q2 fails and the result is <b>DENY</b>.
    Those are not the same outcome and the model does not treat them as one. Inject
    <b>Contradiction</b> to see the physical domain go <b>UNDETERMINED</b>: temp-A and temp-B differ
    by more than the 1.5&nbsp;C tolerance, so the model reports that it has no answer rather than
    choosing one.</p>
  <p class="aqd-note">
    <b>Honesty boundary.</b> A simulation of the specification, not instrumented hardware. It
    exercises the decision logic and interface contract of Part&nbsp;26 &sect;26.5. Every figure in P2
    is a synthetic constant chosen to be plausible &mdash; 0.9987&nbsp;H/bit, 36.9&nbsp;C,
    &minus;21.4&nbsp;dBm are <b>not readings</b>, and <span class="aqd-tag t-meas">SIM-OBS</span>
    means simulated observation, never measured. The thresholds in P6 are stipulated for this
    demonstration, not characterised against hardware. Q2 compares a key identifier against a roster
    entry; no signature is verified and no key material exists here. The node, config, build and
    policy identifiers are simulation constants declared in this file, not deployment provenance.
    Nothing shown here constitutes evidence at any level.</p>
</main>

<script is:inline>
(function(){
// AQ-DEMO-UI-001 simulation engine. Derives; does not assert. See the frontmatter note.
var S,t0,seq,log=[],sel=null,runIx=0,cmdN=0;
var NL=String.fromCharCode(10);

// Simulation configuration constants. Declared here and nowhere else: not build provenance, and
// they name no released artefact.
var CFG={node:'AQ-NODE-01',cfg:'a3f9c1',build:'0.0.2-bench',pol:'p0.4',tsm:'v1'};

// Every threshold that decides anything lives here, and P6 renders them, so a reader can check a
// conclusion against the rule that produced it instead of trusting a colour. All STIPULATED for
// this demonstration; none characterised against hardware.
var R={
  TEMP_TOL_C:1.5, ENT_MIN:0.95, ENT_QUORUM:2, OPT_MIN_DBM:-30,
  HOLD_BOUND_S:900, HOLD_WARN_FRAC:0.5, LAT_MAX_MS:250, ATTEST_MAX_S:300
};

// The roster Q1/Q2/Q3 resolve against. The gates read THIS, not a literal true.
var ROSTER={'ops-01':{key:'K-7A',classes:['reconfigure','status']}};

function baseInputs(){return[
 {id:'ent-A',     v:0.9987, u:'H/bit', kind:'SIM-OBS',  present:true},
 {id:'ent-B',     v:0.9991, u:'H/bit', kind:'SIM-OBS',  present:true},
 {id:'temp-A',    v:36.9,   u:'C',     kind:'SIM-OBS',  present:true},
 {id:'temp-B',    v:36.8,   u:'C',     kind:'SIM-OBS',  present:true},
 {id:'opt-rx',    v:-21.4,  u:'dBm',   kind:'SIM-OBS',  present:true},
 {id:'attest-age',v:3,      u:'s',     kind:'SIM-OBS',  present:true},
 {id:'link-lat',  v:12,     u:'ms',    kind:'SIM-OBS',  present:true},
 {id:'holdover',  v:0,      u:'s',     kind:'DERIVED',  present:true},
 {id:'drift-est', v:0.4,    u:'ppb',   kind:'MODELLED', present:true}
];}

// Injections write INPUTS. That is the whole of what they do.
var INJ={
  delay:  {lab:'input delay',     apply:function(){setIn('link-lat',640)},        note:'link latency 12 ms -> 640 ms'},
  missing:{lab:'missing input',   apply:function(){getIn('opt-rx').present=false},note:'opt-rx withdrawn (absent, not zero)'},
  contra: {lab:'contradiction',   apply:function(){setIn('temp-A',41.2)},         note:'temp-A 36.9 C -> 41.2 C, against temp-B 36.8 C'},
  stale:  {lab:'stale timing',    apply:function(){setIn('holdover',671)},        note:'holdover 0 s -> 671 s'},
  qual:   {lab:'reduced quality', apply:function(){setIn('ent-B',0.7412)},        note:'ent-B 0.9991 -> 0.7412 H/bit'}
};

function now(){return((Date.now()-t0)/1000).toFixed(1)}
function g(id){return document.getElementById(id)}
// An unknown id is a programming error, not a silent blank.
function getIn(id){for(var i=0;i<S.src.length;i++){if(S.src[i].id===id)return S.src[i]}throw new Error('unknown input '+id)}
function setIn(id,v){getIn(id).v=v}
function fmt(s){return s.present?String(s.v):'--'}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function r(k,v){return'<div class="aqd-row"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>'}
function q(k,ok){return'<div class="aqd-q"><span>'+esc(k)+'</span><b class="'+(ok?'ok':'bad')+'">'+(ok?'PASS':'FAIL')+'</b></div>'}
function runId(){return'AQ-DEMO-'+CFG.cfg.toUpperCase()+'-R'+runIx}

// derive(): inputs -> domain confidence. Pure function of S.src. Each branch returns the SENTENCE
// that produced it, so P6, P10 and P12 quote one reason instead of inventing three.
function derive(){
  var D={},W={};
  var eA=getIn('ent-A'),eB=getIn('ent-B');
  var usable=[eA,eB].filter(function(s){return s.present&&s.v>=R.ENT_MIN});
  if(usable.length===0){D.entropy='UNDETERMINED';W.entropy='no entropy source at or above '+R.ENT_MIN+' H/bit'}
  else if(usable.length<R.ENT_QUORUM){D.entropy='LOW';W.entropy=usable.length+' of 2 sources at or above '+R.ENT_MIN+' H/bit (quorum '+R.ENT_QUORUM+') - no substitution permitted'}
  else{D.entropy='HIGH';W.entropy='2 of 2 sources at or above '+R.ENT_MIN+' H/bit'}

  var h=getIn('holdover');
  if(!h.present){D.timing='UNDETERMINED';W.timing='holdover unknown'}
  else if(h.v>R.HOLD_BOUND_S){D.timing='UNDETERMINED';W.timing='holdover '+h.v+' s is past the '+R.HOLD_BOUND_S+' s bound - timing cannot be asserted'}
  else if(h.v>R.HOLD_BOUND_S*R.HOLD_WARN_FRAC){D.timing='LOW';W.timing='holdover '+h.v+' s is past '+Math.round(R.HOLD_WARN_FRAC*100)+'% of the '+R.HOLD_BOUND_S+' s bound'}
  else{D.timing='HIGH';W.timing='holdover '+h.v+' s, inside the '+R.HOLD_BOUND_S+' s bound'}

  var a=getIn('attest-age');
  if(!a.present){D.crypto='UNDETERMINED';W.crypto='no key attestation present'}
  else if(a.v>R.ATTEST_MAX_S){D.crypto='LOW';W.crypto='attestation '+a.v+' s old, ceiling '+R.ATTEST_MAX_S+' s'}
  else{D.crypto='HIGH';W.crypto='attestation '+a.v+' s old, within the '+R.ATTEST_MAX_S+' s ceiling'}

  // CF-6. Two sources disagreeing beyond tolerance produce NO VALUE. The model does not average
  // them, does not prefer the earlier, and does not prefer the healthier.
  var tA=getIn('temp-A'),tB=getIn('temp-B'),ox=getIn('opt-rx');
  if(!tA.present||!tB.present){D.physical='UNDETERMINED';W.physical='a temperature source is absent - absence is not zero'}
  else if(Math.abs(tA.v-tB.v)>R.TEMP_TOL_C){D.physical='UNDETERMINED';
    W.physical='temp-A '+tA.v+' C and temp-B '+tB.v+' C differ by '+Math.abs(tA.v-tB.v).toFixed(1)+' C, tolerance '+R.TEMP_TOL_C+' C - no value selected (CF-6)'}
  else if(!ox.present){D.physical='UNDETERMINED';W.physical='opt-rx absent - absence is not zero'}
  else if(ox.v<R.OPT_MIN_DBM){D.physical='LOW';W.physical='opt-rx '+ox.v+' dBm below the '+R.OPT_MIN_DBM+' dBm floor'}
  else{D.physical='HIGH';W.physical='temp-A and temp-B agree within '+R.TEMP_TOL_C+' C; opt-rx '+ox.v+' dBm'}

  var L=getIn('link-lat');
  if(!L.present){D.link='UNDETERMINED';W.link='no link latency observation'}
  else if(L.v>R.LAT_MAX_MS){D.link='LOW';W.link='latency '+L.v+' ms exceeds the '+R.LAT_MAX_MS+' ms ceiling'}
  else{D.link='HIGH';W.link='latency '+L.v+' ms within the '+R.LAT_MAX_MS+' ms ceiling'}
  return{dom:D,why:W};
}

// Faults are DERIVED from the domains, not pushed alongside them. Two separately written lists
// drift; one computed from the other cannot.
function recompute(){
  var d=derive();
  S.dom=d.dom;S.why=d.why;
  var u=[],f=[],k;
  for(k in S.dom){
    if(S.dom[k]==='UNDETERMINED')u.push(k);
    if(S.dom[k]!=='HIGH')f.push({d:k,m:S.why[k]});
  }
  S.und=u;S.faults=f;
}
function assess(){
  recompute();
  var low=0,k;for(k in S.dom){if(S.dom[k]==='LOW')low++}
  var ns='NORMAL';
  if(S.und.length>=2||S.dom.entropy==='UNDETERMINED')ns='CRITICAL';
  else if(S.und.length>=1||low>=1)ns='RESTRICTED';
  if(low>=3)ns='CRITICAL';
  // DC-4: degradation is immediate, restoration never automatic. A run only climbs; returning to
  // NORMAL requires a new run, which is what Reset starts.
  //
  // RECOVERING IS UNREACHABLE HERE, AND THAT IS THE HONEST STATE OF IT. It sits in the ordering
  // because the vocabulary has it, but nothing assigns it: recovery needs new observations arriving
  // over time and this demonstration has no time axis on its inputs. DENY is absent from this map
  // entirely - it is a decision about a COMMAND, never a condition of the NODE.
  var order={NORMAL:0,RECOVERING:1,RESTRICTED:2,CRITICAL:3};
  if(order[ns]>order[S.state]){
    var before=S.state;S.state=ns;S.since=Date.now();
    ev('state','STATE '+before+' -> '+ns+' - '+S.faults.map(function(x){return x.d}).join(', ')+' degraded','tr',{stateBefore:before,stateAfter:ns});
  }
}
function inject(kind,btn){
  if(S.inj[kind])return;
  S.inj[kind]=true;if(btn)btn.classList.add('on');
  // Snapshot taken BEFORE the input changes, so the difference below is the consequence of THIS
  // injection and not a restatement of an earlier one.
  var before=JSON.parse(JSON.stringify(S.dom));
  INJ[kind].apply();
  ev('inject','INJECTED '+INJ[kind].lab+' - '+INJ[kind].note,'inj');
  assess();
  // ONLY WHAT CHANGED. Re-emitting every non-HIGH domain made a second injection look as though it
  // had degraded the first one's domain again. A timeline that repeats an unchanged fact cannot be
  // read as causation.
  for(var k in S.dom){
    if(S.dom[k]!==before[k])ev('derive','DERIVED '+k+' '+before[k]+' -> '+S.dom[k]+' - '+S.why[k],'');
  }
  render();
}

// GATES. Q1/Q2/Q3 are answered from the COMMAND against the roster; Q4 from the SYSTEM. That split
// is the whole reason DENY and SAFE-HOLD are different outcomes.
//
// WHAT Q2 IS NOT: it compares the key identifier on the command against the roster entry. That is
// an authorisation lookup, not signature verification - no key material, hash or algorithm exists
// in this file. The panel says "key matches roster entry" for exactly that reason.
function gates(cmd){
  var who=Object.prototype.hasOwnProperty.call(ROSTER,cmd.identity)?ROSTER[cmd.identity]:null;
  var q1=!!who;
  var q2=q1&&who.key===cmd.key;
  var q3=q2&&who.classes.indexOf(cmd.cls)>=0;
  var q4=q1&&q2&&q3&&S.state==='NORMAL'&&S.und.length===0;
  return{q1:q1,q2:q2,q3:q3,q4:q4};
}
function command(kind){
  cmdN++;
  if(kind==='forged')return{id:'CMD-'+cmdN,identity:'ops-01',key:'K-XX',cls:'reconfigure',lab:'forged signature'};
  return{id:'CMD-'+cmdN,identity:'ops-01',key:'K-7A',cls:'reconfigure',lab:'signed'};
}
function send(kind){
  var cmd=command(kind),G=gates(cmd),dec,reason,clause,action;
  if(!G.q1){dec='DENY';clause='L5.Q1';reason='identity "'+cmd.identity+'" is not on the roster - rejected on its own merits, not held'}
  else if(!G.q2){dec='DENY';clause='L5.Q2';reason='key "'+cmd.key+'" is not the key registered to '+cmd.identity+' - rejected on its own merits, not held'}
  else if(!G.q3){dec='DENY';clause='L5.Q3';reason=cmd.identity+' does not hold command class "'+cmd.cls+'" - rejected on its own merits, not held'}
  else if(S.state==='NORMAL'&&S.und.length===0){dec='EXECUTE';clause='L5.Q4';reason='identity, key and authority resolved; all domains determined; class "'+cmd.cls+'" permitted in NORMAL'}
  else if(S.state==='CRITICAL'){dec='SAFE-HOLD';clause='L5.Q4';reason='command valid and authorised; trust state CRITICAL - class withheld, still valid, queued within the freshness window'}
  else if(S.und.length){dec='ABSTAIN';clause='L5.Q4';reason='command valid and authorised, but '+S.und.join(' and ')+' undetermined - no confident basis to act, and none invented'}
  else{dec='SAFE-HOLD';clause='L5.Q4';reason='command valid and authorised; class "'+cmd.cls+'" not permitted below NORMAL and trust state is '+S.state+' - withheld, still valid'}
  action=dec==='EXECUTE'?{act:'reconfigure - attempted',res:'completed'}
        :dec==='DENY'?{act:'NO ACTION TAKEN',res:'rejected - not queued, not retried'}
        :dec==='ABSTAIN'?{act:'NO ACTION TAKEN',res:'abstained - recorded as a decision'}
        :{act:'NO ACTION TAKEN',res:'held - re-evaluated on state change'};
  S.command=cmd;
  S.decision={q1:G.q1,q2:G.q2,q3:G.q3,q4:G.q4,dec:dec,reason:reason,clause:clause+' / policy '+CFG.pol,
    at:now(),state:S.state,und:S.und.slice(),cmd:cmd,action:action};
  ev('decision','DECISION '+dec+' ('+cmd.id+', '+cmd.lab+') - '+reason,dec==='EXECUTE'?'':'dn',{decision:S.decision,action:action});
  render();
}
// Every event carries what it would take to reconstruct the decision without the page.
function ev(type,m,c,x){
  x=x||{};seq++;
  log.unshift({n:seq,t:now(),type:type,m:m,c:c||'',
    stateBefore:x.stateBefore!==undefined?x.stateBefore:S.state,
    stateAfter:x.stateAfter!==undefined?x.stateAfter:S.state,
    dom:JSON.parse(JSON.stringify(S.dom)),und:S.und.slice(),
    inj:Object.keys(S.inj),decision:x.decision||null,action:x.action||null,run:runIx});
  if(log.length>80)log.pop();
}
function init(){
  t0=Date.now();seq=0;log=[];sel=null;cmdN=0;runIx++;
  S={state:'NORMAL',since:Date.now(),src:baseInputs(),dom:{},why:{},und:[],faults:[],decision:null,command:null,inj:{}};
  recompute();
  ev('run','run started - configuration frozen '+CFG.cfg+', run '+runId(),'');
  render();
}
function reset(){
  var b=document.querySelectorAll('.aqd-ctl button.on');
  for(var i=0;i<b.length;i++)b[i].classList.remove('on');
  init();
}
function dwell(){return'in state '+((Date.now()-S.since)/1000).toFixed(0)+'s - '+(S.und.length?S.und.length+' domain(s) undetermined':'all domains determined')}

// A source is judged against the same rule that feeds its domain. Two sources that contradict each
// other are individually IN RANGE and jointly unusable; that is why P4 can read IN RANGE while P6
// reads UNDETERMINED.
function srcQuality(s){
  if(!s.present)return{t:'ABSENT',c:'bad'};
  if(s.id==='ent-A'||s.id==='ent-B')return s.v>=R.ENT_MIN?{t:'IN RANGE',c:'ok'}:{t:'BELOW '+R.ENT_MIN,c:'bad'};
  if(s.id==='opt-rx')return s.v>=R.OPT_MIN_DBM?{t:'IN RANGE',c:'ok'}:{t:'BELOW FLOOR',c:'bad'};
  if(s.id==='link-lat')return s.v<=R.LAT_MAX_MS?{t:'IN RANGE',c:'ok'}:{t:'OVER '+R.LAT_MAX_MS+' ms',c:'bad'};
  if(s.id==='attest-age')return s.v<=R.ATTEST_MAX_S?{t:'IN RANGE',c:'ok'}:{t:'STALE',c:'bad'};
  if(s.id==='holdover')return s.v<=R.HOLD_BOUND_S*R.HOLD_WARN_FRAC?{t:'IN RANGE',c:'ok'}:{t:'PAST WARN',c:'hold'};
  if(s.id==='temp-A'||s.id==='temp-B'){
    var o=getIn(s.id==='temp-A'?'temp-B':'temp-A');
    if(o.present&&Math.abs(s.v-o.v)>R.TEMP_TOL_C)return{t:'IN RANGE, DISAGREES',c:'hold'};
    return{t:'IN RANGE',c:'ok'};
  }
  return{t:'IN RANGE',c:'ok'};
}
function render(){
  g('p1v').textContent=CFG.node;
  g('p1').innerHTML=r('node',CFG.node)+r('config id',CFG.cfg)+r('build',CFG.build)+
    r('policy ver',CFG.pol)+r('trust-model',CFG.tsm)+r('scenario','S2 degraded-information')+r('run id',runId());
  var ho=getIn('holdover');
  g('p3').innerHTML=r('source',ho.v===0?'disciplined ref':'HOLDOVER')+r('temporal conf',S.dom.timing)+
    r('holdover',ho.v+' s')+r('bound',R.HOLD_BOUND_S+' s (stipulated)')+r('sequence','#'+seq);
  var p5=g('p5s');p5.textContent=S.state;p5.className='aqd-state s-'+S.state;
  g('p5d').textContent=dwell();
  g('p2').innerHTML=S.src.map(function(s){
    var c=s.kind==='SIM-OBS'?'t-meas':(s.kind==='DERIVED'?'t-der':'t-mod');
    return'<div class="aqd-row"><span>'+esc(s.id)+' <span class="aqd-tag '+c+'">'+esc(s.kind)+'</span></span><b>'+esc(fmt(s))+' '+esc(s.u)+'</b></div>'}).join('');
  g('p4').innerHTML=S.src.map(function(s){
    var st=srcQuality(s);
    return'<div class="aqd-row"><span>'+esc(s.id)+'</span><b class="'+st.c+'">'+esc(st.t)+'</b></div>'}).join('');
  g('p6').innerHTML=Object.keys(S.dom).map(function(k){
    var v=S.dom[k],c=v==='HIGH'?'ok':(v==='LOW'?'hold':'bad');
    return'<div class="aqd-row"><span>'+k+'</span><b class="'+c+'">'+v+'</b></div>'}).join('');
  var u=g('p6u');
  if(S.und.length){u.className='aqd-und';u.textContent='UNDETERMINED: '+S.und.join(', ')}
  else{u.className='aqd-und empty';u.textContent='UNDETERMINED: none'}
  g('p6r').innerHTML='confidence, not uncertainty - HIGH is good, UNDETERMINED means the model refuses to answer.<br>'+
    'rules: |temp-A minus temp-B| within '+R.TEMP_TOL_C+' C &middot; entropy at or above '+R.ENT_MIN+' H/bit x'+R.ENT_QUORUM+
    ' &middot; holdover within '+(R.HOLD_BOUND_S*R.HOLD_WARN_FRAC)+' s &middot; opt-rx at or above '+R.OPT_MIN_DBM+
    ' dBm &middot; latency within '+R.LAT_MAX_MS+' ms &middot; attest within '+R.ATTEST_MAX_S+' s';
  var d=S.decision;
  g('p7').innerHTML=d?(r('decision',d.dec)+r('command',d.cmd.id+' ('+d.cmd.lab+')')+r('reason',d.reason)+
    r('producing clause',d.clause)+r('at trust state',d.state)):
    '<div class="aqd-row"><span>no command received</span><b>--</b></div>';
  g('p8').innerHTML=d?
    q('Q1 identity on roster',d.q1)+q('Q2 key matches roster entry',d.q2)+q('Q3 holds command class',d.q3)+
    '<div class="aqd-q"><span>Q4 system condition permits</span><b class="'+(d.q4?'ok':'hold')+'">'+(d.q4?'PASS':'GATED')+'</b></div>':
    '<div class="aqd-q unk"><span>Q1-Q4</span><b>awaiting command</b></div>';
  g('p9').innerHTML=d?(r('action',d.action.act)+r('observed result',d.action.res)):
    '<div class="aqd-row"><span>idle</span><b>--</b></div>';
  g('p10').innerHTML=S.faults.length?S.faults.map(function(f){
    return'<div class="aqd-row"><span>'+esc(f.d)+'</span><b class="hold">'+esc(f.m)+'</b></div>'}).join(''):
    '<div class="aqd-row"><span>no active faults</span><b class="ok">CLEAR</b></div>';
  g('p11c').textContent=log.length+' events';
  g('p11').innerHTML=log.map(function(e,i){
    return'<div data-i="'+i+'"><span class="ts">'+e.t+'</span><span class="'+e.c+'">'+esc(e.m)+'</span></div>'}).join('');
  var nodes=g('p11').querySelectorAll('div[data-i]');
  for(var i=0;i<nodes.length;i++){(function(el){el.onclick=function(){sel=log[+el.getAttribute('data-i')];renderTrace()}})(nodes[i])}
  renderTrace();
}
function renderTrace(){
  var t=g('p12');
  if(!sel){t.textContent='No event selected. Click any line in P11.';return}
  var d=sel.decision,L=[];
  L.push('event id        AQ-EV-R'+sel.run+'-'+sel.n);
  L.push('run id          AQ-DEMO-'+CFG.cfg.toUpperCase()+'-R'+sel.run);
  L.push('sequence        '+sel.n+'   (deterministic: the nth model event of this run)');
  L.push('run time        +'+sel.t+' s   (wall clock - the one value here that varies run to run)');
  L.push('event type      '+sel.type);
  L.push('event           '+sel.m);
  L.push('trust state     '+sel.stateBefore+(sel.stateAfter!==sel.stateBefore?'  ->  '+sel.stateAfter:'  (unchanged)'));
  L.push('injections      '+(sel.inj.length?sel.inj.join(', '):'none'));
  L.push('domain conf     '+Object.keys(sel.dom).map(function(k){return k+'='+sel.dom[k]}).join('  '));
  L.push('undetermined    '+(sel.und.length?sel.und.join(', '):'none'));
  if(d){
    L.push('command         '+d.cmd.id+'  identity '+d.cmd.identity+'  key '+d.cmd.key+'  class '+d.cmd.cls);
    L.push('gates           Q1 '+(d.q1?'PASS':'FAIL')+'   Q2 '+(d.q2?'PASS':'FAIL')+'   Q3 '+(d.q3?'PASS':'FAIL')+'   Q4 '+(d.q4?'PASS':'GATED'));
    L.push('decision        '+d.dec);
    L.push('because         '+d.reason);
    L.push('clause          '+d.clause);
    L.push('action          '+d.action.act+'  -  '+d.action.res);
    L.push('gate limits     Q2 compares key identifiers against the roster; no signature is verified');
  }
  L.push('config identity '+CFG.cfg+' / build '+CFG.build);
  L.push('policy version  '+CFG.pol+'   trust-model '+CFG.tsm);
  L.push('provenance      simulation configuration constants; not deployment provenance');
  L.push('raw data ref    none - no measurement exists behind any figure in this run');
  L.push('replay handle   AQ-RPL-'+CFG.cfg+'-R'+sel.run+'-'+sel.n);
  t.textContent=L.join(NL);
}
g('i-delay').onclick=function(){inject('delay',this)};
g('i-missing').onclick=function(){inject('missing',this)};
g('i-contra').onclick=function(){inject('contra',this)};
g('i-stale').onclick=function(){inject('stale',this)};
g('i-qual').onclick=function(){inject('qual',this)};
g('send').onclick=function(){send('signed')};
g('sendbad').onclick=function(){send('forged')};
g('reset').onclick=reset;
init();
setInterval(function(){var e=g('p5d');if(e&&S)e.textContent=dwell()},1000);
})();
</script>
</BaseLayout>
