---
// /akasha-q — the programme charter hub.
//
// Reachable from /products/akasha-q and the sitemap. Reads src/lib/akasha-q/parts.ts, which is the
// only registry of Parts and completion artifacts — adding a Part there makes it appear here.
//
// No database access. This page must render if every other system is down, because it is the
// document surface, not an application surface.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PARTS, EVIDENCE_LEVELS, PROGRAMME_EVIDENCE_INDEX, artifactCounts } from '@/lib/akasha-q/parts';

const counts = artifactCounts();
const reached = EVIDENCE_LEVELS[PROGRAMME_EVIDENCE_INDEX];
---
<BaseLayout
  title="Akasha-Q Programme Charter · EduRankAI"
  description="The Akasha-Q scientific programme charter: master system architecture, demonstration and validation strategy, and the completion artifacts each Part gates. Design study; nothing has been built.">

<style>
  body { background:#0a0a0c; color:#e8e8ee; }
  .aqc-wrap { max-width:1120px; margin:0 auto; padding:56px 5vw 96px; }
  .aqc-eyebrow { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.22em; text-transform:uppercase; color:#67e8f9; font-weight:700; margin:0 0 14px; }
  .aqc-h1 { font-family:'Cormorant Garamond',serif; font-size:clamp(38px,6vw,68px); font-weight:600; letter-spacing:-0.035em; line-height:1.02; margin:0 0 18px; }
  .aqc-h1 em { font-style:italic; font-weight:500; background:linear-gradient(135deg,#a78bfa,#67e8f9); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  .aqc-sub { font-size:16.5px; color:#9aa6b6; max-width:70ch; line-height:1.7; margin:0 0 26px; }
  .aqc-band { display:inline-flex; align-items:center; gap:10px; font-family:'Geist Mono',monospace; font-size:11.5px; letter-spacing:0.12em; text-transform:uppercase; color:#fbbf24; font-weight:700; border:1px solid rgba(251,191,36,0.32); border-left:2px solid #fbbf24; border-radius:9px; padding:12px 16px; line-height:1.6; margin:0 0 34px; }
  .aqc-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin:0 0 40px; }
  .aqc-stat { background:#11131a; border:1px solid #2a2a35; border-radius:12px; padding:16px 18px; }
  .aqc-stat .n { font-family:'Geist Mono',monospace; font-size:26px; font-weight:700; color:#a78bfa; line-height:1; }
  .aqc-stat .k { font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#9aa6b6; margin-top:7px; }
  .aqc-label { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:#67e8f9; font-weight:700; margin:0 0 14px; }
  .aqc-part { display:block; background:#11131a; border:1px solid #2a2a35; border-radius:14px; padding:22px 24px; margin-bottom:12px; text-decoration:none; }
  .aqc-part:hover { border-color:#a78bfa; }
  .aqc-part-n { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:#a78bfa; font-weight:700; }
  .aqc-part-t { font-family:'Cormorant Garamond',serif; font-size:26px; color:#fff; font-weight:600; margin:6px 0 8px; line-height:1.15; }
  .aqc-part-s { font-size:14px; color:#9aa6b6; line-height:1.65; margin:0 0 12px; }
  .aqc-part-a { font-family:'Geist Mono',monospace; font-size:11px; color:#67e8f9; }
  .aqc-links { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
  .aqc-link { display:block; flex:1 1 250px; background:#11131a; border:1px solid #2a2a35; border-radius:12px; padding:16px 20px; text-decoration:none; }
  .aqc-link:hover { border-color:#a78bfa; }
  .aqc-link .e { font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#67e8f9; font-weight:700; }
  .aqc-link .t { font-family:'Cormorant Garamond',serif; font-size:19px; color:#fff; font-weight:600; margin:5px 0 4px; }
  .aqc-link .d { font-size:12.5px; color:#9aa6b6; line-height:1.55; margin:0; }
</style>

<main class="aqc-wrap">
  <p class="aqc-eyebrow">EduRankAI · Frontier research programme</p>
  <h1 class="aqc-h1"><em>Akasha-Q</em><br/>Scientific Programme Charter</h1>
  <p class="aqc-sub">
    The governing document series for the Akasha-Q quantum-secure communications programme. Each Part
    defines a body of work and the completion artifacts that must exist before the next Part begins.
    The charter is the programme's memory: what was decided, on what evidence, and what remains
    unresolved.
  </p>

  <p class="aqc-band">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
    Highest evidence level reached by any element: {reached} &middot; nothing has been built
  </p>

  <div class="aqc-stats">
    <div class="aqc-stat"><p class="n">{PARTS.length}</p><p class="k">Parts published here</p></div>
    <div class="aqc-stat"><p class="n">{counts.total}</p><p class="k">Completion artifacts</p></div>
    <div class="aqc-stat"><p class="n">{counts.drafted}</p><p class="k">Drafted</p></div>
    <div class="aqc-stat"><p class="n">{counts.inProgress}</p><p class="k">In progress</p></div>
  </div>

  <p class="aqc-label">Charter parts</p>
  {PARTS.map((p) => (
    <a class="aqc-part" href={'/akasha-q/charter/' + p.slug}>
      <p class="aqc-part-n">Part {p.n}</p>
      <p class="aqc-part-t">{p.title}</p>
      <p class="aqc-part-s">{p.summary}</p>
      <p class="aqc-part-a">{p.artifacts.length} completion artifacts &rarr;</p>
    </a>
  ))}

  <div class="aqc-links">
    <a class="aqc-link" href="/akasha-q/demo">
      <p class="e">Reference implementation</p>
      <p class="t">AQ-DEMO-UI-001</p>
      <p class="d">The demonstration control room, running against a simulated AQ-NODE-01. Inject the Scenario 2 degradations and watch the trust state fall.</p>
    </a>
    <a class="aqc-link" href="/products/akasha-q">
      <p class="e">Public programme page</p>
      <p class="t">Akasha-Q</p>
      <p class="d">The public description of the programme: five layers, six rungs, bench to constellation.</p>
    </a>
    <a class="aqc-link" href="/products/visvambhara">
      <p class="e">Related programme</p>
      <p class="t">Viśvambhara</p>
      <p class="d">The autonomous aerospace swarm designed to carry an Akasha-Q terminal.</p>
    </a>
  </div>
</main>
</BaseLayout>
