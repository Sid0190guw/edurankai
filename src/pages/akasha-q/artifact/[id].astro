---
// /akasha-q/artifact/<AQ-ID> — one charter completion artifact, rendered in full.
//
// Content comes from src/lib/akasha-q/artifact-docs.ts, which holds programme-authored body
// fragments. `set:html` is used deliberately and safely: the fragments are first-party charter text
// checked into the repository, contain no script or style tags, and never include user input. If
// that ever stops being true — if a document becomes editable from a form, say — this must switch to
// a sanitising renderer before the source changes, not after.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ARTIFACT_META, metaById } from '@/lib/akasha-q/artifact-docs';
import { PARTS } from '@/lib/akasha-q/parts';

// One chunk per document, loaded on demand. Inlining all 28 bodies into a single module took the
// whole dev server down and doubled build time; a lazy glob keeps 476 KB of charter text out of the
// module graph until the one requested document is actually asked for.
const BODIES = import.meta.glob('../../../lib/akasha-q/docs/*.html', {
  query: '?raw',
  import: 'default',
}) as Record<string, () => Promise<string>>;

export function getStaticPaths() {
  return ARTIFACT_META.map((d) => ({ params: { id: d.id } }));
}

export const prerender = false;

const { id } = Astro.params;
const doc = metaById(String(id || ''));
if (!doc) return Astro.redirect('/akasha-q');

const loader = BODIES['../../../lib/akasha-q/docs/' + doc.id + '.html'];
if (!loader) return Astro.redirect('/akasha-q');
const body = await loader();

// Which Part gates this artifact. Resolved here rather than duplicated into the doc data, so the
// registry in parts.ts stays the single place the relationship is declared.
const owner = PARTS.find((p) => p.artifacts.some((a) => a.id.toUpperCase() === doc.id));
const siblings = owner ? owner.artifacts.filter((a) => a.id.toUpperCase() !== doc.id) : [];
---
<BaseLayout title={doc.id + ' · Akasha-Q Charter'} description={doc.oneLine}>

<style>
  body { background:#0a0a0c; color:#e8e8ee; }
  .aqa-wrap { max-width:1080px; margin:0 auto; padding:44px 5vw 100px; }
  .aqa-back { display:inline-block; font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:#67e8f9; text-decoration:none; margin-bottom:26px; }
  .aqa-back:hover { text-decoration:underline; }
  .aqa-id { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:#a78bfa; font-weight:700; margin:0 0 10px; }
  .aqa-one { font-size:15.5px; color:#9aa6b6; line-height:1.7; max-width:72ch; margin:0 0 8px; }
  .aqa-meta { font-family:'Geist Mono',monospace; font-size:11px; color:#616d7a; margin:0 0 30px; padding-bottom:22px; border-bottom:1px solid #22242e; }

  /* Component vocabulary used by the authored fragments. */
  .aqa-doc h3 { font-family:'Cormorant Garamond',serif; font-size:clamp(26px,4vw,40px); font-weight:600; letter-spacing:-0.025em; line-height:1.1; color:#fff; margin:0 0 22px; }
  .aqa-doc h4 { font-family:'Geist Mono',monospace; font-size:11.5px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#67e8f9; margin:34px 0 10px; }
  .aqa-doc p { font-size:15px; color:#cfd6da; line-height:1.75; max-width:72ch; margin:0 0 14px; }
  .aqa-doc ul, .aqa-doc ol { max-width:72ch; padding-left:22px; margin:0 0 14px; color:#cfd6da; font-size:15px; line-height:1.75; }
  .aqa-doc li { margin-bottom:6px; }
  .aqa-doc strong { color:#fff; font-weight:600; }
  .aqa-doc code { font-family:'Geist Mono',monospace; font-size:0.87em; background:#191c24; padding:1px 5px; border-radius:3px; color:#c9d6e0; }
  .aqa-doc a { color:#67e8f9; }

  .aqa-doc .box { border:1px solid #2a2a35; border-left:3px solid #67e8f9; background:#11131a; padding:16px 18px; margin:20px 0; max-width:78ch; border-radius:0 10px 10px 0; }
  .aqa-doc .box.warn { border-left-color:#fbbf24; }
  .aqa-doc .box.deny { border-left-color:#f87171; }
  .aqa-doc .box.ok { border-left-color:#86efac; }
  .aqa-doc .box .lbl { font-family:'Geist Mono',monospace; font-size:10.5px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#67e8f9; display:block; margin-bottom:7px; }
  .aqa-doc .box.warn .lbl { color:#fbbf24; }
  .aqa-doc .box.deny .lbl { color:#f87171; }
  .aqa-doc .box.ok .lbl { color:#86efac; }
  .aqa-doc .box p { max-width:none; margin-bottom:10px; }
  .aqa-doc .box p:last-child { margin-bottom:0; }

  .aqa-doc .dgm { overflow-x:auto; background:#0d0f15; border:1px solid #2a2a35; border-radius:10px; padding:16px 18px; margin:18px 0; }
  .aqa-doc .dgm .cap { font-family:'Geist Mono',monospace; font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase; color:#7e8a99; margin:0 0 12px; padding-bottom:8px; border-bottom:1px solid #22242e; }
  .aqa-doc .dgm pre { font-family:'Geist Mono',monospace; font-size:12px; line-height:1.55; margin:0; color:#9fc4ce; white-space:pre; }

  .aqa-doc .tw { overflow-x:auto; margin:18px 0; border:1px solid #2a2a35; border-radius:10px; background:#11131a; }
  .aqa-doc table { border-collapse:collapse; width:100%; min-width:660px; font-size:13px; }
  .aqa-doc th { text-align:left; font-family:'Geist Mono',monospace; font-size:10px; font-weight:700; letter-spacing:0.11em; text-transform:uppercase; color:#7e8a99; padding:10px 13px; border-bottom:1px solid #2a2a35; vertical-align:bottom; background:#161922; }
  .aqa-doc td { padding:10px 13px; border-bottom:1px solid #1e212a; vertical-align:top; color:#b8c4cc; line-height:1.55; }
  .aqa-doc tr:last-child td { border-bottom:0; }
  .aqa-doc td.id { font-family:'Geist Mono',monospace; font-size:11.5px; color:#a78bfa; white-space:nowrap; }

  .aqa-doc .chip { display:inline-block; font-family:'Geist Mono',monospace; font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; padding:2px 7px; border-radius:3px; border:1px solid; vertical-align:1px; white-space:nowrap; }
  .aqa-doc .c-concept { color:#9aa6b6; border-color:#3a3f4b; }
  .aqa-doc .c-theory { color:#67e8f9; border-color:#67e8f9; }
  .aqa-doc .c-lab { color:#86efac; border-color:#86efac; }
  .aqa-doc .c-none { color:#fbbf24; border-color:#fbbf24; }
  .aqa-doc .c-deny { color:#f87171; border-color:#f87171; }

  .aqa-sib { margin-top:52px; padding-top:26px; border-top:1px solid #22242e; }
  .aqa-sib .k { font-family:'Geist Mono',monospace; font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase; color:#7e8a99; font-weight:700; margin:0 0 12px; }
  .aqa-sib a { display:inline-block; font-family:'Geist Mono',monospace; font-size:11.5px; color:#a78bfa; text-decoration:none; border:1px solid #2a2a35; border-radius:6px; padding:6px 10px; margin:0 6px 6px 0; }
  .aqa-sib a:hover { border-color:#a78bfa; }
</style>

<main class="aqa-wrap">
  <a class="aqa-back" href={owner ? '/akasha-q/charter/' + owner.slug : '/akasha-q'}>&larr; {owner ? 'Part ' + owner.n : 'Charter'}</a>
  <p class="aqa-id">{doc.id}</p>
  <p class="aqa-one">{doc.oneLine}</p>
  <p class="aqa-meta">
    Charter artifact &middot; {owner ? 'gated by Part ' + owner.n : 'unassigned'} &middot; revision 0, draft for internal review
  </p>

  <article class="aqa-doc" set:html={body}></article>

  {siblings.length > 0 && (
    <div class="aqa-sib">
      <p class="k">Other artifacts gated by Part {owner.n}</p>
      {siblings.map((s) => <a href={'/akasha-q/artifact/' + s.id}>{s.id}</a>)}
    </div>
  )}
</main>
</BaseLayout>
