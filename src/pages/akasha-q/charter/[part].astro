---
// /akasha-q/charter/<slug> — one charter Part and the completion artifacts it gates.
//
// Content comes from src/lib/akasha-q/parts.ts. A slug with no Part returns to the hub rather than
// 404ing, because a mistyped charter URL is a navigation error, not a missing document.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PARTS, partBySlug } from '@/lib/akasha-q/parts';

export function getStaticPaths() {
  return PARTS.map((p) => ({ params: { part: p.slug } }));
}

export const prerender = false;

const { part: slug } = Astro.params;
const part = partBySlug(String(slug || ''));
if (!part) return Astro.redirect('/akasha-q');

const STATUS_LABEL: Record<string, string> = {
  'drafted': 'Drafted',
  'in-progress': 'In progress',
  'not-started': 'Not started',
};
const STATUS_COLOR: Record<string, string> = {
  'drafted': '#86efac',
  'in-progress': '#fbbf24',
  'not-started': '#9aa6b6',
};
---
<BaseLayout
  title={'Part ' + part.n + ' · ' + part.title + ' · Akasha-Q Charter'}
  description={part.summary}>

<style>
  body { background:#0a0a0c; color:#e8e8ee; }
  .aqp-wrap { max-width:980px; margin:0 auto; padding:48px 5vw 96px; }
  .aqp-back { display:inline-block; font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:#67e8f9; text-decoration:none; margin-bottom:30px; }
  .aqp-back:hover { text-decoration:underline; }
  .aqp-n { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:#a78bfa; font-weight:700; margin:0 0 12px; }
  .aqp-h1 { font-family:'Cormorant Garamond',serif; font-size:clamp(32px,5.4vw,54px); font-weight:600; letter-spacing:-0.03em; line-height:1.06; margin:0 0 18px; }
  .aqp-sum { font-size:16px; color:#9aa6b6; line-height:1.72; max-width:70ch; margin:0 0 34px; }
  .aqp-label { font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:#67e8f9; font-weight:700; margin:0 0 6px; }
  .aqp-note { font-size:13.5px; color:#9aa6b6; line-height:1.65; max-width:70ch; margin:0 0 18px; }
  .aqp-art { text-decoration:none; background:#11131a; border:1px solid #2a2a35; border-radius:12px; padding:16px 18px; margin-bottom:9px; display:grid; grid-template-columns:170px 1fr auto; gap:14px; align-items:start; }
  @media (max-width:720px) { .aqp-art { grid-template-columns:1fr; gap:6px; } }
  .aqp-art:hover { border-color:#a78bfa; }
  .aqp-art-id { font-family:'Geist Mono',monospace; font-size:12px; color:#a78bfa; font-weight:600; }
  .aqp-art-n { font-family:'Cormorant Garamond',serif; font-size:18px; color:#fff; font-weight:600; margin:0 0 4px; line-height:1.2; }
  .aqp-art-p { font-size:12.5px; color:#9aa6b6; line-height:1.55; margin:0; }
  .aqp-art-s { font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; font-weight:700; white-space:nowrap; }
</style>

<main class="aqp-wrap">
  <a class="aqp-back" href="/akasha-q">&larr; Charter</a>
  <p class="aqp-n">Part {part.n}</p>
  <h1 class="aqp-h1">{part.title}</h1>
  <p class="aqp-sum">{part.summary}</p>

  <p class="aqp-label">Completion artifacts</p>
  <p class="aqp-note">
    These documents must exist, be internally reviewed and be baselined before the next Part begins.
    Status here is the artifact's real state, never its intended state.
  </p>

  {part.artifacts.map((a) => (
    <a class="aqp-art" href={'/akasha-q/artifact/' + a.id}>
      <p class="aqp-art-id">{a.id}</p>
      <div>
        <p class="aqp-art-n">{a.name}</p>
        <p class="aqp-art-p">{a.purpose}</p>
      </div>
      <p class="aqp-art-s" style={'color:' + (STATUS_COLOR[a.status] || '#9aa6b6') + ';'}>{STATUS_LABEL[a.status] || a.status}</p>
    </a>
  ))}
</main>
</BaseLayout>
