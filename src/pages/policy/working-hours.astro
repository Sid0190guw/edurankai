---
// /policy/working-hours — the ONE public page that states how working time works, per level.
//
// Every number on this page is read from src/lib/engagement-policy.ts. Nothing here is typed by
// hand. That is the point: the same figures were previously written into the intern catalog, the
// careers job-posting structured data, the careers terms panel, two admin offer forms, the
// recruitment policy and the work-culture policy, and they had already drifted apart into six
// different answers to "how many hours?".
//
// It also answers the question the founder was right to call vague: 40 is the TOTAL ENGAGEMENT
// for an internship, of which 5 hours a day is project work. Someone shown a bare 40 reasonably
// concludes they owe 40 hours of task output. The split is now impossible to omit.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ic } from '@/lib/policy-icons';
import {
  ENGAGEMENT_POLICIES, ENGAGEMENT_LEVEL_ORDER, STATUTORY, AICTE_HOURS_PER_CREDIT,
  WELLBEING_DOMAINS, WELLBEING_ASSESSED_AS,
  describeCommitment, describeProgrammeTotal, shortCommitment, commitmentFacts,
  totalProjectHours, totalWellbeingHours, totalEngagementHours, aicteCreditEquivalent,
  formatMinutes,
} from '@/lib/engagement-policy';

const levels = ENGAGEMENT_LEVEL_ORDER.map((level) => {
  const p = ENGAGEMENT_POLICIES[level];
  return {
    level,
    label: p.label,
    timeModel: p.timeModel,
    short: shortCommitment(p),
    headline: p.headline,
    measuredBy: p.measuredBy,
    statutoryNote: p.statutoryNote,
    facts: commitmentFacts(p),
    programmeTotal: describeProgrammeTotal(p),
  };
});

const modelNames = {
  counted: 'Hours are counted',
  scheduled: 'A scheduled week',
  'core-hours': 'Overlap, not hours',
  accountable: 'Accountability, not hours',
};
const modelIcons = { counted: 'timer', scheduled: 'clock', 'core-hours': 'handshake', accountable: 'compass' };
const modelBlurb = {
  counted: 'The hours themselves are the deliverable, because they are what gets certified. Interns and apprentices only.',
  scheduled: 'A defined working week under the statutory ceiling. Hours are recorded for compliance, never used as a performance score.',
  'core-hours': 'No hour count. A stated overlap window so colleagues can reach you, and objectives agreed for the cycle.',
  accountable: 'No hours are stated at all. Positions of management sit outside the working-hours provisions of the statute, and a fixed daily figure would be inaccurate rather than strict.',
};

const intern = ENGAGEMENT_POLICIES['Intern'];
const internTotal = totalEngagementHours(intern);
const internProject = totalProjectHours(intern);
const internWellbeing = totalWellbeingHours(intern);
const internCredits = aicteCreditEquivalent(intern);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Working Hours by Level — EduRankAI',
  description: 'How EduRankAI states working time at every level, from intern to C-level, and why one number cannot cover all of them.',
  publisher: { '@type': 'Organization', name: 'EduRankAI', url: 'https://edurankai.in' },
  inLanguage: 'en-IN',
  dateModified: '2026-08-06',
};
---
<BaseLayout
  title="Working Hours by Level — EduRankAI"
  description="How EduRankAI states working time at every level. Interns are counted and the split is always shown; senior roles are accountability based and carry no hour count.">

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="px-[5vw] py-12 md:py-16 max-w-5xl mx-auto">
    <a href="/careers" class="inline-flex items-center gap-2 text-[0.8rem] font-mono text-ink-soft hover:text-burn transition-colors mb-6"><span>&larr;</span> Back to Careers</a>

    <p class="eyebrow mb-3">EduRankAI &middot; Working Time &middot; 2026</p>
    <h1 class="section-title mb-5">Working hours, <em>per level.</em></h1>
    <p class="text-[0.98rem] md:text-[1.05rem] text-ink-2 leading-[1.85] font-light max-w-3xl mb-8">
      One number cannot describe an intern, a mid-level engineer and a Chief Officer. This page states each of them separately, and every figure on it is read from a single module in the codebase &mdash; there is no second copy anywhere to disagree with it.
    </p>

    <div class="bg-burn-pale/40 border-l-4 border-burn rounded-2xl p-6 md:p-7 mb-12">
      <p class="font-display text-[1.05rem] font-semibold text-ink mb-2">The correction that produced this page</p>
      <p class="text-[0.9rem] text-ink-2 leading-[1.85] font-light">
        Candidates were shown a bare &ldquo;40 hours&rdquo; with nothing around it. Forty is the <strong>total engagement</strong> for an internship. Of each day, {formatMinutes(intern.projectMinutesPerDay)} is project work and departmental responsibility and {formatMinutes(intern.wellbeingMinutesPerDay)} is holistic well-being and personal development. Read alone, &ldquo;40 hours&rdquo; tells someone they owe forty hours of task output. They do not. The total is never published again without its split.
      </p>
    </div>

    <nav class="bg-cream-2 border border-ink/10 rounded-xl p-5 mb-14 grid grid-cols-2 md:grid-cols-4 gap-3 text-[0.85rem]">
      <a href="#models" class="font-semibold text-burn hover:underline">Four models</a>
      <a href="#ladder" class="font-semibold text-burn hover:underline">Level by level</a>
      <a href="#internship" class="font-semibold text-burn hover:underline">The internship in full</a>
      <a href="#law" class="font-semibold text-burn hover:underline">Where the law sits</a>
      <a href="/policy/work-culture" class="font-semibold text-burn hover:underline">Work Culture &rarr;</a>
      <a href="/policy/recruitment" class="font-semibold text-burn hover:underline">Recruitment &amp; Conduct &rarr;</a>
    </nav>

    <section id="models" class="mb-16">
      <p class="eyebrow mb-3">01 &middot; Four models</p>
      <h2 class="font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-ink mb-3">Time is expressed four different ways here</h2>
      <p class="text-[0.9rem] text-ink-2 leading-[1.85] font-light mb-6 max-w-3xl">Which one applies to you is decided by the role, not by which template somebody opened.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {(['counted', 'scheduled', 'core-hours', 'accountable'] as const).map((m) => (
          <div class="bg-white border border-ink/10 rounded-xl p-5">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[1.4rem] text-burn shrink-0" set:html={ic(modelIcons[m])}></span>
              <span class="font-display text-[1.05rem] font-semibold text-ink">{modelNames[m]}</span>
            </div>
            <p class="text-[0.86rem] text-ink-2 leading-[1.75] font-light">{modelBlurb[m]}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="ladder" class="mb-16">
      <p class="eyebrow mb-3">02 &middot; Level by level</p>
      <h2 class="font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-ink mb-3">What each level actually owes</h2>
      <p class="text-[0.9rem] text-ink-2 leading-[1.85] font-light mb-6 max-w-3xl">Telling a Chief Officer they owe five hours a day is as wrong as telling an intern nothing at all. Both are stated honestly below.</p>

      <div class="flex flex-col gap-3">
        {levels.map((L) => (
          <div class="bg-white border border-ink/10 rounded-xl p-5 md:p-6">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
              <span class="text-[1.3rem] text-burn shrink-0" set:html={ic(modelIcons[L.timeModel])}></span>
              <span class="font-display text-[1.15rem] font-semibold text-ink">{L.label}</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-burn bg-burn-pale/50 border border-burn/20 rounded-full px-2.5 py-1 font-bold">{modelNames[L.timeModel]}</span>
            </div>
            <p class="text-[0.9rem] text-ink-2 leading-[1.8] font-light mb-4">{L.headline}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {L.facts.map((f) => (
                <div class="bg-cream-2 border border-ink/10 rounded-lg px-3 py-2 min-w-[7.5rem]">
                  <p class="text-[0.58rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-0.5">{f.k}</p>
                  <p class="text-[0.85rem] text-ink font-semibold">{f.v}</p>
                </div>
              ))}
            </div>
            {L.programmeTotal && (
              <p class="text-[0.84rem] text-ink-2 leading-[1.8] font-light mb-3">{L.programmeTotal}</p>
            )}
            <p class="text-[0.84rem] text-ink-2 leading-[1.8] font-light mb-2"><strong class="text-ink">Measured by.</strong> {L.measuredBy}</p>
            <p class="text-[0.8rem] text-ink-soft leading-[1.8] font-light"><strong class="text-ink-2">Where this stands legally.</strong> {L.statutoryNote}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="internship" class="mb-16">
      <p class="eyebrow mb-3">03 &middot; The internship in full</p>
      <h2 class="font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-ink mb-3">Every number, and what it is made of</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
          <p class="text-[0.6rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-1">Total engagement</p>
          <p class="font-display text-[1.5rem] font-semibold text-ink leading-none">{internTotal}<span class="text-[0.8rem] text-ink-soft font-normal"> hrs</span></p>
          <p class="text-[0.75rem] text-ink-soft mt-1">over {intern.durationWeeks} weeks</p>
        </div>
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
          <p class="text-[0.6rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-1">Project work</p>
          <p class="font-display text-[1.5rem] font-semibold text-ink leading-none">{internProject}<span class="text-[0.8rem] text-ink-soft font-normal"> hrs</span></p>
          <p class="text-[0.75rem] text-ink-soft mt-1">{formatMinutes(intern.projectMinutesPerDay)} a day</p>
        </div>
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
          <p class="text-[0.6rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-1">Well-being</p>
          <p class="font-display text-[1.5rem] font-semibold text-ink leading-none">{internWellbeing}<span class="text-[0.8rem] text-ink-soft font-normal"> hrs</span></p>
          <p class="text-[0.75rem] text-ink-soft mt-1">{formatMinutes(intern.wellbeingMinutesPerDay)} a day</p>
        </div>
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
          <p class="text-[0.6rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-1">Working days</p>
          <p class="font-display text-[1.5rem] font-semibold text-ink leading-none">{intern.daysPerWeek}<span class="text-[0.8rem] text-ink-soft font-normal"> / week</span></p>
          <p class="text-[0.75rem] text-ink-soft mt-1">{intern.restDaysPerWeek} full rest day</p>
        </div>
      </div>
      <p class="text-[0.9rem] text-ink-2 leading-[1.85] font-light mb-4">{describeCommitment(intern)}</p>

      <div class="bg-white border border-ink/10 rounded-xl p-5 md:p-6 mb-4">
        <p class="font-display text-[1.05rem] font-semibold text-ink mb-2 flex items-center gap-2"><span class="text-burn" set:html={ic('leaf')}></span>What the well-being time is</p>
        <p class="text-[0.88rem] text-ink-2 leading-[1.8] font-light mb-3">{formatMinutes(intern.wellbeingMinutesPerDay)} of each working day is yours, inside the engagement rather than on top of it. It covers:</p>
        <div class="flex flex-wrap gap-2 mb-4">
          {WELLBEING_DOMAINS.map((d) => (
            <span class="bg-cream-2 border border-ink/10 rounded-full px-3 py-1.5 text-[0.82rem] text-ink-2">{d}</span>
          ))}
        </div>
        <p class="text-[0.86rem] text-ink-2 leading-[1.8] font-light">{WELLBEING_ASSESSED_AS}</p>
      </div>

      <div class="bg-white border border-ink/10 rounded-xl p-5 md:p-6">
        <p class="font-display text-[1.05rem] font-semibold text-ink mb-2 flex items-center gap-2"><span class="text-burn" set:html={ic('graduation')}></span>Credits, and what we do not promise</p>
        <p class="text-[0.88rem] text-ink-2 leading-[1.8] font-light">Under the applicable AICTE internship framework one academic credit corresponds to a minimum of {AICTE_HOURS_PER_CREDIT} hours of work, which is why these particular hours are recorded and certified. {internTotal} hours is roughly {internCredits} credits by that measure. Your institution decides what it awards; EduRankAI is the technology platform and records the hours and the work. The internship is unpaid unless a stipend is explicitly recorded in your offer, and completing it does not constitute or guarantee an offer of employment.</p>
      </div>
    </section>

    <section id="law" class="mb-16">
      <p class="eyebrow mb-3">04 &middot; Where the law sits</p>
      <h2 class="font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-ink mb-3">The ceiling, the rest day, and who is outside both</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        <div class="bg-white border border-ink/10 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-2"><span class="text-[1.4rem] text-burn shrink-0" set:html={ic('scale')}></span><span class="font-display text-[1rem] font-semibold text-ink">The statutory ceiling</span></div>
          <p class="text-[0.86rem] text-ink-2 leading-[1.75] font-light">The applicable state Shops and Establishments Act caps a working day at {STATUTORY.maxHoursPerDay} hours and a working week at {STATUTORY.maxHoursPerWeek}, requires at least {STATUTORY.weeklyRestHours} consecutive hours of weekly rest, and requires a break of at least {STATUTORY.breakMinutes} minutes after five hours of continuous work. Nothing published on this site may exceed it, and a role configured above it falls back to the published policy rather than going out.</p>
        </div>
        <div class="bg-white border border-ink/10 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-2"><span class="text-[1.4rem] text-burn shrink-0" set:html={ic('compass')}></span><span class="font-display text-[1rem] font-semibold text-ink">Who sits outside it</span></div>
          <p class="text-[0.86rem] text-ink-2 leading-[1.75] font-light">Those Acts expressly do not apply their working-hours provisions to persons occupying a position of management or employed in a confidential capacity, and under the labour codes a person employed in a managerial or administrative capacity falls outside the definition of a worker. That is why our director and C-level roles state no hours: a fixed daily figure there would not be a stricter standard, it would be an inaccurate one.</p>
        </div>
        <div class="bg-white border border-ink/10 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-2"><span class="text-[1.4rem] text-burn shrink-0" set:html={ic('ban')}></span><span class="font-display text-[1rem] font-semibold text-ink">Overwork is a breach, not a badge</span></div>
          <p class="text-[0.86rem] text-ink-2 leading-[1.75] font-light">Working materially beyond your commitment for three consecutive weeks without approval is a policy breach at every level, including the ones with no hour count. At the levels that do have a scheduled week, agreed work beyond it is compensated with time off in lieu rather than absorbed.</p>
        </div>
        <div class="bg-white border border-ink/10 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-2"><span class="text-[1.4rem] text-burn shrink-0" set:html={ic('chart')}></span><span class="font-display text-[1rem] font-semibold text-ink">Hours are not a score</span></div>
          <p class="text-[0.86rem] text-ink-2 leading-[1.75] font-light">Where hours are recorded, they are recorded for statutory compliance and, for interns, for certification. They are not a performance measure at any level. Performance is the agreed objectives, reviewed on the cycle that applies to your role.</p>
        </div>
      </div>
      <p class="text-[0.82rem] text-ink-soft leading-[1.8] font-light max-w-3xl">This page describes EduRankAI&rsquo;s own policy and its basis. It is not legal advice, and where a specific state statute or your own institution&rsquo;s rules impose something stricter, the stricter rule governs.</p>
    </section>

    <div class="bg-ink text-white rounded-2xl p-8 md:p-10 text-center">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-burn mb-3">Still not sure what you would owe?</p>
      <h3 class="font-display text-[1.8rem] md:text-[2.2rem] font-semibold leading-tight mb-3">Every open role states its own working time on its page.</h3>
      <p class="text-[0.92rem] text-white/80 leading-relaxed mb-6 max-w-xl mx-auto">And the same figures appear in your offer letter, because they come from the same place.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/careers" class="inline-block bg-burn hover:bg-burn/90 font-semibold px-7 py-3 rounded-lg text-[0.95rem] min-h-[44px]">View open roles &rarr;</a>
        <a href="/policy/work-culture" class="inline-block bg-white/10 hover:bg-white/15 font-semibold px-7 py-3 rounded-lg text-[0.95rem] border border-white/20 min-h-[44px]">Work Culture</a>
        <a href="/policy/recruitment" class="inline-block bg-white/10 hover:bg-white/15 font-semibold px-7 py-3 rounded-lg text-[0.95rem] border border-white/20 min-h-[44px]">Recruitment &amp; Conduct</a>
      </div>
    </div>
  </section>
</BaseLayout>
