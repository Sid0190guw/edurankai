---
// /portal/enroll-face — the form-post door into face enrolment.
//
// =================================================================================================
// WHAT WAS WRONG HERE, AND WHY IT WAS THE WORST KIND OF WRONG
// =================================================================================================
//
// user_face_enrollments is not a preference. The descriptor in that row is simultaneously an
// accepted FIRST factor at the sign-in surfaces, the 'face' SECOND factor in
// src/lib/auth/two-factor.ts (verifyFaceSecondFactor reads exactly this row), and what
// /api/portal/attendance/punch trusts when it marks somebody present.
//
// This page wrote it with:
//   - `Array.isArray(parsed) && parsed.length === 128` as the only validation, so 128 strings, or
//     128 zeros (which is face-api's "no face found" result, not a face), went straight into the
//     jsonb column;
//   - `ON CONFLICT (user_id) DO UPDATE SET face_descriptor = <whatever was posted>`, with nothing
//     compared against anything. Any signed-in session — including a stolen one — could REPLACE the
//     enrolled face outright by posting one form field. That is persistence which survives a
//     password change, it hands the attacker a standalone sign-in method, it locks the real owner's
//     face out, and it enables attendance fraud on somebody else's likeness.
//
// Both API doors into this same table were hardened for precisely this and this page was left as a
// third, unguarded one: /api/auth/enroll-face measures the selfie against the government ID
// server-side (and deliberately ignores a client-supplied matchDistance), and
// /api/auth/enroll-face-selfie gates REPLACEMENT on matchEnrolledFace(). A guard that one surface
// out of three skips is not a guard.
//
// THE RULE NOW, IDENTICAL TO /api/auth/enroll-face-selfie:
//   - FIRST enrolment is unchanged. No active row, no obstacle. That is the daily path (middleware
//     forces it on a first protected page load) and nobody loses it.
//   - RE-ENROLMENT must match the face already on file. Re-capturing in better light, on a new
//     phone, or after a haircut still passes; a genuinely different face does not, and the refusal
//     points at the ID-match flow so somebody whose appearance really has changed is not dead-ended.
//   - The stored template is never serialised anywhere near the response, and the measured distance
//     is never returned — a numeric distance is a gradient an attacker can hill-climb toward the
//     stored template one probe at a time.
//
// A read that could not run does NOT resolve to "not enrolled": that would invite somebody to
// re-enrol over a working factor, and it is the one wrong answer a security screen must not give.
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { matchEnrolledFace, parseLiveDescriptor, causeOf, DESCRIPTOR_DIMS } from '@/lib/auth/face';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const isNew = new URL(Astro.request.url).searchParams.get('new') === '1';
let okMsg = '', errorMsg = '';
let enrolled = false;
// Did the status read actually run? An unreadable row is not an absent one.
let statusOk = true;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;
  if (action === 'enroll') {
    // parseLiveDescriptor enforces what "a descriptor" means: exactly 128 finite numbers, not all
    // zeros. `JSON.parse` + length 128 accepted strings and zero-vectors, both of which are stored
    // credentials that can never match a real face again.
    let posted: unknown = null;
    try { posted = JSON.parse(String(fd.get('face_descriptor') || '')); } catch (_) { posted = null; }
    const descriptor = parseLiveDescriptor(posted);

    if (!descriptor) {
      errorMsg = 'No usable face in that capture (we need ' + DESCRIPTOR_DIMS + ' numbers, and a face must be visible). Try again with better lighting.';
    } else {
      try {
        // REPLACEMENT IS GATED. matchEnrolledFace() reads the stored template and compares on the
        // server; `enrolled` is false when there is no active row, which is first enrolment and
        // passes straight through. It THROWS rather than reporting a false negative when the
        // database cannot be reached — an auth path must never turn "the database is down" into
        // "your face is wrong" — and the catch below says so instead of enrolling anyway.
        const existing = await matchEnrolledFace(String(user.id), descriptor);
        if (existing.enrolled && !existing.matched) {
          // The distance the SERVER measured stays in the log and out of the page.
          console.warn('[portal/enroll-face] replacement refused for user ' + user.id + ' (distance ' + existing.distance.toFixed(4) + ')');
          errorMsg = 'That does not look like the face already enrolled on this account, so nothing has been changed. '
            + 'If your appearance has genuinely changed, re-verify with your identity document instead — that flow checks the document itself.';
        } else {
          await db.execute(sql`
            INSERT INTO user_face_enrollments (user_id, face_descriptor, device_info, is_active)
            VALUES (${user.id}, ${JSON.stringify(descriptor)}::jsonb, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500) || null}, true)
            ON CONFLICT (user_id) DO UPDATE SET
              face_descriptor = EXCLUDED.face_descriptor,
              device_info = EXCLUDED.device_info,
              enrolled_at = NOW(),
              is_active = true
          `);
          return Astro.redirect('/portal?enrolled=1');
        }
      } catch (e: any) {
        // The real Postgres reason is on e.cause; e.message is only the failed SQL, and it used to
        // be printed at the person.
        console.error('[portal/enroll-face] enroll', causeOf(e));
        errorMsg = 'We could not save that enrolment just now. Nothing has been changed. Please try again in a moment.';
      }
    }
  } else if (action === 'skip') {
    return Astro.redirect('/portal');
  }
}

try {
  const r = await db.execute(sql`SELECT id FROM user_face_enrollments WHERE user_id = ${user.id} AND is_active = true LIMIT 1`);
  const rows = Array.isArray(r) ? r : (r?.rows || []);
  enrolled = rows.length > 0;
} catch (e: any) {
  statusOk = false;
  console.error('[portal/enroll-face] status', causeOf(e));
}
---
<!doctype html>
<html lang="en" style="background:#08080a;">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Set Up Face Login - EduRankAI</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #08080a; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: system-ui, sans-serif; padding: 16px; }
    .card { background: #0f0f14; border: 1px solid #1a1a1f; border-radius: 16px; width: 100%; max-width: 420px; overflow: hidden; }
    .card-header { padding: 24px; border-bottom: 1px solid #1a1a1f; text-align: center; }
    .card-body { padding: 20px; }
    .logo { font-size: 20px; font-weight: 800; color: #fff; margin-bottom: 16px; }
    .logo em { font-style: normal; color: #FF4F00; }
    .step-badge { background: rgba(255,79,0,0.1); border: 1px solid rgba(255,79,0,0.2); border-radius: 100px; padding: 4px 12px; font-size: 11px; font-weight: 700; color: #FF7040; display: inline-block; margin-bottom: 12px; }
    .cam-box { background: #000; border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; position: relative; margin-bottom: 14px; }
    .cam-box video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .oval { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
    .oval-ring { width: 160px; height: 200px; border: 2px solid rgba(255,79,0,0.6); border-radius: 50%; }
    .cam-status { position: absolute; bottom: 10px; left: 0; right: 0; text-align: center; }
    .cam-status span { background: rgba(0,0,0,0.7); color: #fff; font-size: 11px; padding: 3px 10px; border-radius: 100px; }
    .btn { width: 100%; border: none; font-weight: 600; font-size: 14px; padding: 12px; border-radius: 10px; cursor: pointer; }
    .btn-primary { background: #FF4F00; color: #fff; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-skip { background: transparent; color: #6e6e78; font-size: 13px; padding: 10px; }
    .benefit { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .benefit-icon { width: 32px; height: 32px; border-radius: 8px; background: rgba(255,79,0,0.1); color: #FF4F00; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  </style>
</head>
<body>
<div class="card">
  <div class="card-header">
    <div class="logo">EduRank<em>AI</em></div>
    {isNew && <div class="step-badge">Account Created - Step 2 of 2</div>}
    <h1 style="font-size:18px;font-weight:700;color:#fff;margin:0 0 6px;">{enrolled ? 'Update Face Login' : 'Set Up Face Login'}</h1>
    <p style="font-size:13px;color:#6e6e78;">{enrolled ? 'Your face is enrolled. You can update it here.' : 'Log in instantly with your face - no password needed next time.'}</p>
  </div>

  <div class="card-body">
    {errorMsg && <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:14px;line-height:1.55;">{errorMsg}</div>}

    {/* A failed read is said out loud rather than rendered as "not enrolled" — that sentence invites
        somebody to enrol over a working sign-in factor. */}
    {!statusOk && (
      <div style="background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3);color:#fbbf24;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:14px;line-height:1.55;">
        We could not read whether your face is already enrolled. What is shown below is not your
        current setup and nothing has been changed. Please reload in a moment.
      </div>
    )}

    <!-- Benefits -->
    {!enrolled && (
      <div style="margin-bottom:16px;">
        {/* These were three HTML entities rendered through set:html: &#128274; is the padlock emoji
            and &#9889; the high-voltage one. The house rule is no emojis anywhere - inline
            monochrome SVG only - and on a dark panel an emoji is also the one glyph on the screen
            that arrives in somebody else's colours and somebody else's font. Same three meanings,
            drawn as paths that inherit currentColor. */}
        {[
          { icon: 'lock', text: 'No password to remember or forget' },
          { icon: 'bolt', text: 'Log in in under 2 seconds' },
          { icon: 'lock', text: 'No photo is stored - only a numeric face signature' },
        ].map(b => (
          <div class="benefit">
            <div class="benefit-icon">
              {b.icon === 'bolt'
                ? <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
                : <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>}
            </div>
            <p style="font-size:13px;color:#d8d8de;margin:0;">{b.text}</p>
          </div>
        ))}
      </div>
    )}

    <!-- Camera -->
    <div class="cam-box">
      <video id="video" autoplay playsinline muted></video>
      <div class="oval"><div class="oval-ring" id="ovalRing"></div></div>
      <div class="cam-status"><span id="camStatus">Loading camera...</span></div>
    </div>

    <div style="background:#15151a;border-radius:100px;height:3px;margin-bottom:12px;">
      <div id="loadProg" style="background:#FF4F00;height:100%;width:0%;border-radius:100px;transition:width 0.4s;"></div>
    </div>

    <button id="captureBtn" class="btn btn-primary" disabled onclick="doCapture()">Loading face detection...</button>

    <form method="POST" style="margin-top:10px;">
      <input type="hidden" name="action" value="skip"/>
      <button type="submit" class="btn btn-skip">Skip for now - I'll set this up later</button>
    </form>
  </div>
</div>

<form id="enrollForm" method="POST" style="display:none;">
  <input type="hidden" name="action" value="enroll"/>
  <input type="hidden" id="faceInput" name="face_descriptor"/>
</form>

<script is:inline src="/vendor/face-api/face-api.min.js"></script>
<script is:inline>
var video = document.getElementById('video');
var captureBtn = document.getElementById('captureBtn');
var camStatus = document.getElementById('camStatus');
var loadProg = document.getElementById('loadProg');
var ovalRing = document.getElementById('ovalRing');
var modelsLoaded = false;

function setStatus(msg, color) {
  camStatus.innerHTML = '<span style="background:rgba(0,0,0,0.7);color:'+(color||'#fff')+';font-size:11px;padding:3px 10px;border-radius:100px;">'+msg+'</span>';
}

async function init() {
  try {
    setStatus('Loading face model...');
    loadProg.style.width = '20%';
    var MODEL_URL = '/vendor/face-api/models';
    // Initialise the TF backend BEFORE detection (else detect throws "backend not initialized").
    try {
      if (window.faceapi && faceapi.tf) {
        try { await faceapi.tf.setBackend('webgl'); } catch (_) {}
        if (faceapi.tf.getBackend && !faceapi.tf.getBackend()) { try { await faceapi.tf.setBackend('wasm'); } catch (_) {} }
        if (faceapi.tf.ready) await faceapi.tf.ready();
      }
    } catch (_) {}
    await Promise.all([
      faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
      faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
      faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
    ]);
    loadProg.style.width = '60%';
    var stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640 } });
    video.srcObject = stream;
    loadProg.style.width = '100%';
    setTimeout(function() {
      loadProg.style.display = 'none';
      modelsLoaded = true;
      captureBtn.disabled = false;
      captureBtn.textContent = 'Capture & Save Face';
      setStatus('Position face in oval', '#10b981');
      ovalRing.style.borderColor = 'rgba(16,185,129,0.7)';
      detectLoop();
    }, 400);
  } catch(e) {
    setStatus('Camera error: ' + e.message, '#ef4444');
  }
}

async function detectLoop() {
  if (!video || !modelsLoaded) return;
  try {
    var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks(true);
    if (det) {
      setStatus('Face detected - ready!', '#10b981');
      ovalRing.style.borderColor = 'rgba(255,79,0,0.8)';
      captureBtn.style.background = '#10b981';
    } else {
      setStatus('Center your face in the oval', '#fbbf24');
      ovalRing.style.borderColor = 'rgba(255,79,0,0.5)';
      captureBtn.style.background = '#FF4F00';
    }
  } catch(e) {}
  setTimeout(detectLoop, 600);
}

async function doCapture() {
  if (!modelsLoaded) return;
  captureBtn.disabled = true;
  captureBtn.textContent = 'Scanning...';
  setStatus('Analyzing face...', '#fbbf24');
  try {
    var descriptors = [];
    for (var i = 0; i < 5; i++) {
      var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks(true).withFaceDescriptor();
      if (det) descriptors.push(Array.from(det.descriptor));
      await new Promise(function(r) { setTimeout(r, 200); });
    }
    if (descriptors.length < 2) {
      setStatus('No face detected. Try again.', '#ef4444');
      captureBtn.disabled = false;
      captureBtn.textContent = 'Try Again';
      return;
    }
    var avg = new Array(128).fill(0);
    descriptors.forEach(function(d) { d.forEach(function(v, i) { avg[i] += v / descriptors.length; }); });
    document.getElementById('faceInput').value = JSON.stringify(avg);
    setStatus('Face captured! Saving...', '#10b981');
    document.getElementById('enrollForm').submit();
  } catch(e) {
    setStatus('Error: ' + e.message, '#ef4444');
    captureBtn.disabled = false;
    captureBtn.textContent = 'Try Again';
  }
}

init();
</script>
</body>
</html>
