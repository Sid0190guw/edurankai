---
// "Who has read my communications?" — the subject's own copy of the access log.
//
// The retention disclosure promises that access is logged and that the person whose messages were
// read can see it. accessHistoryFor() existed to serve exactly that and was called by nothing, so
// the promise was unkept: the only people who could see the log were the people doing the looking.
// A log visible only to them holds no one to account.
//
// This page shows a person their OWN history and nobody else's — the subject id comes from the
// session, never from the URL, so it cannot be pointed at someone else by editing the address bar.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { accessHistoryFor, disclosureText } from '@/lib/legal-hold';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

// "Nobody has accessed your records" is a promise being kept, so it must never be printed because a
// query failed. accessHistoryFor now distinguishes the two and this page prints whichever is true.
const historyResult = await accessHistoryFor(user.id);
const history = historyResult.ok ? historyResult.rows : [];
const historyError = historyResult.ok ? null : historyResult.reason;
const fmt = (s: string) => new Date(s).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
---

<BaseLayout title="Access to my records" description="Who has accessed your work communications, and why.">
  <section style="max-width:760px;margin:0 auto;padding:28px 18px 60px;">
    <p style="font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#c2410c;font-family:'Geist Mono',monospace;font-weight:700;margin:0 0 6px;">Your record</p>
    <h1 style="font-family:Fraunces,Georgia,serif;font-size:clamp(24px,5vw,32px);color:#1a1510;margin:0 0 10px;font-weight:600;">Access to my records</h1>
    <p style="font-size:14px;color:#5c5349;line-height:1.7;margin:0 0 24px;">
      Work communications on this platform are retained as business records. If anyone reads yours,
      it is recorded here — who, when, under which matter, and the reason they gave.
    </p>

    {historyError ? (
      <div style="background:#fff5f0;border:1px solid #f0b49a;border-radius:14px;padding:18px;">
        <p style="font-size:14px;color:#9a3412;margin:0;font-weight:600;">Your access log could not be read.</p>
        <p style="font-size:13px;color:#5c5349;margin:6px 0 0;line-height:1.65;">
          This is <b>not</b> a statement that nobody has accessed your records — it means the log itself
          could not be loaded just now. Nothing has been deleted. Please try again, and if it keeps
          failing write to connect@edurankai.in and we will produce the log by hand.
        </p>
        <p style="font-size:11.5px;color:#8a7f70;margin:8px 0 0;font-family:'Geist Mono',monospace;word-break:break-word;">{historyError}</p>
      </div>
    ) : history.length === 0 ? (
      <div style="background:#f4f9f4;border:1px solid #cfe5d3;border-radius:14px;padding:18px;">
        <p style="font-size:14px;color:#1c7a45;margin:0;font-weight:600;">Nobody has accessed your records.</p>
        <p style="font-size:13px;color:#5c5349;margin:6px 0 0;line-height:1.65;">
          If that changes, it will appear here without you having to ask.
        </p>
      </div>
    ) : (
      <div style="display:flex;flex-direction:column;gap:10px;">
        {history.map((h: any) => (
          <div style="background:#fff;border:1px solid #ece4d6;border-radius:14px;padding:15px 16px;">
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;justify-content:space-between;margin-bottom:8px;">
              <p style="font-size:14px;color:#1a1510;margin:0;font-weight:600;">{h.accessedByName || 'A reviewer'}</p>
              <p style="font-size:11.5px;color:#8a7f70;margin:0;font-family:'Geist Mono',monospace;">{fmt(h.createdAt)}</p>
            </div>
            <p style="font-size:12.5px;color:#5c5349;margin:0 0 8px;">
              Matter <b>{h.matterReference || 'unspecified'}</b>{h.matterTitle ? ' — ' + h.matterTitle : ''} ·
              {' '}{h.itemCount} item{h.itemCount === 1 ? '' : 's'} ({h.sourceKind})
            </p>
            <p style="font-size:13px;color:#1a1510;margin:0;line-height:1.6;background:#faf6ef;border-radius:9px;padding:9px 11px;">
              &ldquo;{h.justification}&rdquo;
            </p>
          </div>
        ))}
      </div>
    )}

    <div style="margin-top:28px;background:#faf6ef;border:1px solid #ece4d6;border-radius:14px;padding:16px 18px;">
      <p style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#8a7f70;font-family:'Geist Mono',monospace;font-weight:700;margin:0 0 10px;">The retention policy</p>
      {disclosureText().map((line: string) => (
        <p style="font-size:13px;color:#5c5349;line-height:1.7;margin:0 0 8px;">{line}</p>
      ))}
      <p style="font-size:13px;color:#5c5349;line-height:1.7;margin:8px 0 0;">
        Your personal messages in the portal are end-to-end encrypted. Their content cannot be read by
        anyone here, including under a legal matter — only the fact that a conversation took place.
      </p>
    </div>
  </section>
</BaseLayout>
