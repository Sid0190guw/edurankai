---
// The groups a person is in. Mobile-first: most people open this on a phone, so it is a single
// column of large tap targets rather than a table, and every action is a full-width button.
//
// Only groups this user is entitled to are fetched — visibleGroupsFor scopes at the query, so there
// is nothing here to accidentally render. Chat links are never in the listing; they are fetched
// per-group through joinLinkFor, which re-checks membership.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleGroupsFor, createSubGroup, joinGroup, leaveGroup, joinLinkFor } from '@/lib/work-groups';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/groups');

let msg = '';
let err = '';
let revealed: { id: string; url: string; label: string } | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') || '');
  const groupId = String(fd.get('groupId') || '');
  try {
    if (action === 'create') {
      const r = await createSubGroup({
        parentId: String(fd.get('parentId') || ''),
        creatorId: user.id,
        name: String(fd.get('name') || ''),
        description: String(fd.get('description') || ''),
        joinUrl: String(fd.get('joinUrl') || ''),
        joinLabel: String(fd.get('joinLabel') || ''),
      });
      if (r.ok) msg = 'Group created. You are its owner.'; else err = r.error || 'Could not create.';
    } else if (action === 'join') {
      const r = await joinGroup(groupId, user.id);
      if (r.ok) msg = 'Joined.'; else err = r.error || 'Could not join.';
    } else if (action === 'leave') {
      const r = await leaveGroup(groupId, user.id);
      if (r.ok) msg = 'Left the group.'; else err = r.error || 'Could not leave.';
    } else if (action === 'reveal') {
      // Fetched only on an explicit tap, and only for a member. Keeping it out of the listing means
      // an invite link cannot leak through a template change or a stray log line.
      const link = await joinLinkFor(groupId, user.id);
      if (link) revealed = { id: groupId, ...link };
      else err = 'No chat link is set for that group yet.';
    }
  } catch (e: any) {
    err = e?.cause?.message || e?.message || 'Something went wrong.';
  }
}

const groups = await visibleGroupsFor(user.id);
const mine = groups.filter((g) => g.isMember);
const discoverable = groups.filter((g) => !g.isMember);
const parentsICanAddTo = mine;   // you may create inside any group you belong to
---
<BaseLayout title="Your groups" description="Team groups you belong to at EduRankAI.">
  <section class="px-[5vw] py-8 md:py-12 max-w-2xl mx-auto">
    <h1 class="font-display text-[1.6rem] md:text-[2rem] font-semibold text-ink mb-1">Your groups</h1>
    <p class="text-[0.86rem] text-ink-soft mb-6">
      You are added to your organisation and department groups automatically. Groups you are not part
      of are not listed.
    </p>

    {msg && <div class="bg-green-50 border border-green-200 text-green-900 rounded-xl p-3.5 mb-4 text-[0.86rem]">{msg}</div>}
    {err && <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl p-3.5 mb-4 text-[0.86rem]">{err}</div>}

    {revealed && (
      <div class="bg-burn/[0.07] border border-burn/40 rounded-xl p-4 mb-5">
        <p class="text-[0.7rem] font-mono uppercase tracking-[0.14em] text-burn font-bold mb-2">Group chat link</p>
        <a href={revealed.url} target="_blank" rel="noopener noreferrer"
           class="block w-full text-center bg-burn text-white font-semibold py-3.5 rounded-lg text-[0.95rem]">
          {revealed.label}
        </a>
        <p class="text-[0.76rem] text-ink-soft mt-2.5 leading-relaxed">
          This link lets anyone who has it join. Please do not forward it &mdash; people are added to
          groups through onboarding so membership stays accurate.
        </p>
      </div>
    )}

    {mine.length === 0 && (
      <div class="border border-ink/10 rounded-xl p-6 text-center">
        <p class="text-[0.9rem] text-ink-soft">You are not in any groups yet. They are added when your onboarding completes.</p>
      </div>
    )}

    <div class="flex flex-col gap-3">
      {mine.map((g) => (
        <div class="border border-ink/12 rounded-xl p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-display text-[1.02rem] font-semibold text-ink leading-snug">{g.name}</p>
              {g.parentName && <p class="text-[0.74rem] text-ink-soft mt-0.5">in {g.parentName}</p>}
              {g.description && <p class="text-[0.84rem] text-ink-soft mt-1.5 leading-relaxed">{g.description}</p>}
            </div>
            {g.isMain && <span class="text-[0.58rem] font-mono uppercase tracking-[0.12em] text-burn border border-burn/40 rounded-full px-2 py-0.5 shrink-0">Core</span>}
          </div>
          <p class="text-[0.76rem] text-ink-soft mt-2">{g.memberCount} member{g.memberCount === 1 ? '' : 's'}</p>

          <div class="flex flex-col sm:flex-row gap-2 mt-3">
            {g.hasLink && (
              <form method="POST" class="flex-1">
                <input type="hidden" name="_action" value="reveal" />
                <input type="hidden" name="groupId" value={g.id} />
                <button type="submit" class="w-full bg-ink text-white font-semibold py-3 rounded-lg text-[0.88rem]">Open group chat</button>
              </form>
            )}
            {!g.isMain && (
              <form method="POST" class="sm:w-auto">
                <input type="hidden" name="_action" value="leave" />
                <input type="hidden" name="groupId" value={g.id} />
                <button type="submit" class="w-full px-4 py-3 border border-ink/15 rounded-lg text-[0.85rem] text-ink-soft">Leave</button>
              </form>
            )}
          </div>
        </div>
      ))}
    </div>

    {discoverable.length > 0 && (
      <>
        <h2 class="font-display text-[1.1rem] font-semibold text-ink mt-8 mb-1">Open to you</h2>
        <p class="text-[0.82rem] text-ink-soft mb-3">Sub-groups inside groups you already belong to.</p>
        <div class="flex flex-col gap-3">
          {discoverable.map((g) => (
            <div class="border border-ink/12 rounded-xl p-4">
              <p class="font-display text-[1rem] font-semibold text-ink">{g.name}</p>
              {g.parentName && <p class="text-[0.74rem] text-ink-soft mt-0.5">in {g.parentName}</p>}
              {g.description && <p class="text-[0.84rem] text-ink-soft mt-1.5 leading-relaxed">{g.description}</p>}
              <form method="POST" class="mt-3">
                <input type="hidden" name="_action" value="join" />
                <input type="hidden" name="groupId" value={g.id} />
                <button type="submit" class="w-full bg-burn text-white font-semibold py-3 rounded-lg text-[0.88rem]">Join</button>
              </form>
            </div>
          ))}
        </div>
      </>
    )}

    {parentsICanAddTo.length > 0 && (
      <details class="mt-8 border border-ink/12 rounded-xl">
        <summary class="p-4 cursor-pointer text-[0.92rem] font-semibold text-ink">Create a group</summary>
        <form method="POST" class="px-4 pb-4 flex flex-col gap-3">
          <input type="hidden" name="_action" value="create" />
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Inside which group</span>
            <select name="parentId" required class="w-full border border-ink/15 rounded-lg px-3 py-3 text-[0.9rem]">
              {parentsICanAddTo.map((g) => <option value={g.id}>{g.name}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Name</span>
            <input name="name" required maxlength="120" class="w-full border border-ink/15 rounded-lg px-3 py-3 text-[0.9rem]" placeholder="e.g. Frontend guild" />
          </label>
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">What it is for (optional)</span>
            <textarea name="description" rows="2" maxlength="400" class="w-full border border-ink/15 rounded-lg px-3 py-3 text-[0.9rem]"></textarea>
          </label>
          <label class="block">
            <span class="block text-[0.78rem] font-semibold text-ink mb-1">Chat link (optional)</span>
            <input name="joinUrl" type="url" placeholder="https://chat.whatsapp.com/... or a Slack invite" class="w-full border border-ink/15 rounded-lg px-3 py-3 text-[0.9rem]" />
            <span class="block text-[0.74rem] text-ink-soft mt-1">Only people in this group will ever see it.</span>
          </label>
          <button type="submit" class="w-full bg-ink text-white font-semibold py-3.5 rounded-lg text-[0.9rem]">Create group</button>
        </form>
      </details>
    )}
  </section>
</BaseLayout>
