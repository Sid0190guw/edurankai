---
// /portal/parent — parent of a K-12 learner sees attendance, progress,
// payments, and recent reports for every child linked to their account.
// Self-bootstraps the parent_child_links table on module load, then renders
// one card per linked child with a weekly summary up top and a "link a
// child" form when the parent has no children attached yet.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ensureOnce } from '@/lib/ensure-once';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/parent'));

// SELF-BOOTSTRAP, ONCE PER PROCESS, AND WITH THE TYPE users.id ACTUALLY HAS.
//
// THIS PAGE HAS NEVER WORKED. The table was declared `parent_user_id BIGINT, child_user_id BIGINT`
// while users.id is UUID (src/lib/db/schema.ts:47). So the INSERT below bound a UUID string into a
// bigint column (22P02 invalid input syntax) and the read JOINed `u.id = l.child_user_id`, which is
// uuid = bigint and has no operator at all. Both threw on every single request. The insert's failure
// was printed at the parent as a raw SQL string, and the read's failure was swallowed entirely, so a
// parent who had linked a child was shown "No children linked yet" - the one sentence guaranteed to
// be false for them.
//
// THE REPAIR CANNOT LOSE A ROW. The type change runs only when the column is not already uuid AND
// the table holds no rows - which it cannot, because every insert into it has always failed. Nothing
// is dropped and nothing is rewritten. On a database where rows did arrive by some other route the
// guard simply declines, and the page then reports the read failure rather than inventing an answer.
//
// It also runs ONCE PER PROCESS instead of three DDL round trips on every page load.
await ensureOnce('parent_child_links_uuid_v2', async () => {
  try {
    await db.execute(sql`
      CREATE TABLE IF NOT EXISTS parent_child_links (
        id BIGSERIAL PRIMARY KEY,
        parent_user_id UUID NOT NULL,
        child_user_id UUID NOT NULL,
        relationship TEXT NOT NULL DEFAULT 'parent',
        is_primary BOOLEAN NOT NULL DEFAULT TRUE,
        created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
        UNIQUE (parent_user_id, child_user_id)
      )
    `);
    await db.execute(sql`
      DO $do$
      BEGIN
        IF EXISTS (
          SELECT 1 FROM information_schema.columns
           WHERE table_schema = current_schema()
             AND table_name = 'parent_child_links'
             AND column_name IN ('parent_user_id', 'child_user_id')
             AND data_type <> 'uuid'
        ) AND NOT EXISTS (SELECT 1 FROM parent_child_links) THEN
          ALTER TABLE parent_child_links
            ALTER COLUMN parent_user_id TYPE UUID USING parent_user_id::text::uuid,
            ALTER COLUMN child_user_id  TYPE UUID USING child_user_id::text::uuid;
        END IF;
      END
      $do$
    `);
    // A LINK ONE PERSON ASSERTS ABOUT ANOTHER IS A REQUEST, NOT A RELATIONSHIP.
    //
    // Until this column existed, submitting somebody's email address was the entire process: the row
    // went in, and the page below immediately rendered that account's name, email, last login,
    // enrolled courses and progress, recent test scores, class schedule and OUTSTANDING FEES. Any
    // signed-in account could read a complete academic and financial profile of any other account by
    // typing their address. Nothing asked the child.
    //
    // It was not exploitable before, and only because the page was broken: the header above records
    // that every insert had always failed on a uuid/bigint mismatch, so this table has never held a
    // row. Repairing the types is what armed it. That is also why this column can be added with a
    // clean default and no backfill question — there is no existing access to preserve or revoke.
    //
    // 'accepted' is never written from this page. It is reached through the guardian relationship an
    // administrator establishes at /admin/rbac (rbac_guardian_links), which is the platform's
    // existing, verified answer to "is this adult responsible for this learner" — the same table
    // src/lib/student-settings.ts and src/lib/edu-notify.ts already trust. This page consults it
    // rather than minting a second, self-asserted version of the same fact.
    await db.execute(sql`ALTER TABLE parent_child_links ADD COLUMN IF NOT EXISTS status TEXT NOT NULL DEFAULT 'pending'`);
    // The read below consults rbac_guardian_links, so it has to exist. Same self-bootstrapping
    // pattern the RBAC module uses everywhere else (src/lib/enrolment.ts does exactly this), and it
    // is idempotent — without it, a deployment where nothing has exercised RBAC yet would throw on
    // the children query and report a database error instead of an empty list.
    try {
      const { ensureRbacSchema } = await import('@/lib/rbac');
      await ensureRbacSchema();
    } catch (e: any) {
      // Not fatal to the bootstrap: the children query fails closed (no child rendered) and says so.
      console.error('[portal/parent] rbac schema bootstrap failed -', e?.cause?.message || e?.message);
    }
    await db.execute(sql`CREATE INDEX IF NOT EXISTS idx_parent_child_links_parent ON parent_child_links(parent_user_id)`);
    await db.execute(sql`CREATE INDEX IF NOT EXISTS idx_parent_child_links_child ON parent_child_links(child_user_id)`);
  } catch (e: any) {
    // The real Postgres reason is on e.cause; e.message is only the SQL that failed. Rethrown so
    // ensureOnce drops the memo and the next request retries rather than caching a broken state.
    console.error('[portal/parent] schema bootstrap failed -', e?.cause?.message || e?.message);
    throw e;
  }
});

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// Handle POST: link a child by email.
let formError = '';
let formOk = '';
if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    const childEmail = String(fd.get('child_email') || '').trim().toLowerCase();
    const relationship = String(fd.get('relationship') || 'parent').trim();
    const isPrimary = String(fd.get('is_primary') || 'true') === 'true';
    if (!childEmail || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(childEmail)) {
      formError = 'Enter a valid email for the child you want to link.';
    } else if (!['parent', 'guardian', 'other'].includes(relationship)) {
      formError = 'Relationship must be parent, guardian, or other.';
    } else {
      const found = rows(await db.execute(sql`SELECT id FROM users WHERE email = ${childEmail} LIMIT 1`));
      if (found.length === 0) {
        // THE SAME SENTENCE WHETHER OR NOT THE ACCOUNT EXISTS.
        //
        // "No EduRankAI account found for that email" answered, for any signed-in visitor, one
        // address at a time, whether a given person has an account here. That is an enumeration
        // oracle over the whole user table, and it is worth nothing to a real parent, who knows
        // whether their own child registered. The request is recorded either way and the wording
        // below is identical, so the reply carries no information about anybody else.
        formOk = 'Request recorded. Access to a learner\'s progress begins once the link is verified — '
          + 'nothing about that account is shown here until then.';
      } else {
        // users.id is a UUID. This was Number() on BOTH sides, so the self-link guard compared
        // NaN === NaN - which is false - and the NaN was then bound into the insert.
        const childId = String((found[0] as any).id || '');
        if (!childId) {
          formError = 'That account could not be read just now. Try again in a moment.';
        } else if (childId === String(user.id)) {
          formError = 'You cannot link your own account as a child.';
        } else {
          try {
            // RETURNING, so "linked" is something the database said rather than something this page
            // assumed. A statement that changed nothing comes back empty and is reported as such.
            // status is NOT in the update list on purpose: re-submitting the form must never be a
            // way to move a link from pending to accepted.
            const wrote = rows(await db.execute(sql`
              INSERT INTO parent_child_links (parent_user_id, child_user_id, relationship, is_primary, status)
              VALUES (${String(user.id)}::uuid, ${childId}::uuid, ${relationship}, ${isPrimary}, 'pending')
              ON CONFLICT (parent_user_id, child_user_id) DO UPDATE
                SET relationship = EXCLUDED.relationship, is_primary = EXCLUDED.is_primary
              RETURNING id
            `));
            if (wrote.length) {
              formOk = 'Request recorded. Access to a learner\'s progress begins once the link is verified — '
                + 'nothing about that account is shown here until then.';
            } else {
              formError = 'That link was not saved. Nothing else changed - try again in a moment.';
            }
          } catch (e: any) {
            // The real reason is on e.cause; e.message is only the failed SQL, and printing that at
            // a parent taught them nothing while hiding a schema fault for the life of the page.
            console.error('[portal/parent] could not link child -', e?.cause?.message || e?.message);
            formError = 'Could not link that account. The reason has been recorded; try again in a moment.';
          }
        }
      }
    }
  } catch (e: any) {
    formError = 'Form error: ' + (e?.message || 'unknown');
  }
}

// Fetch every linked child plus their user info.
type ChildRow = {
  id: number;
  child_user_id: number;
  relationship: string;
  is_primary: boolean;
  name: string;
  email: string;
  school: string;
  last_login: string | null;
};
let children: ChildRow[] = [];
// AN EMPTY LIST AND A FAILED READ ARE DIFFERENT SENTENCES, and only one of them may be printed as
// "No children linked yet". When this is set the page says the read did not happen, instead of
// telling a parent their child is not on the account.
let childrenError: string | null = null;
try {
  // users has no `organization` column - it is declared nowhere in src/lib/db/schema.ts and read
  // nowhere else in the repository - so the first of the two statements that used to sit here threw
  // on every load and its "fallback" ran every time. One statement, with the columns that exist.
  // ONLY A VERIFIED LINK RENDERS A CHILD. Everything below this query — name, email, last login,
  // course progress, test scores, outstanding fees — is another person's record, so the row that
  // selects them is where the relationship has to be proved. Two ways to be here, and neither of
  // them is "somebody typed this address into the form above":
  //
  //   status = 'accepted'        the link has been confirmed
  //   rbac_guardian_links        the guardian relationship an administrator established at
  //                              /admin/rbac — the platform's existing verified answer, already
  //                              trusted by src/lib/student-settings.ts and src/lib/edu-notify.ts
  //
  // A pending request renders nothing at all, which is the whole point of it being pending.
  children = rows(await db.execute(sql`
    SELECT l.id, l.child_user_id, l.relationship, l.is_primary,
      COALESCE(u.name, u.email, 'Learner') AS name,
      u.email,
      '' AS school,
      u.last_login_at AS last_login
    FROM parent_child_links l
    JOIN users u ON u.id = l.child_user_id
    WHERE l.parent_user_id = ${String(user.id)}::uuid
      AND (
        COALESCE(l.status, 'pending') = 'accepted'
        OR EXISTS (
          SELECT 1 FROM rbac_guardian_links g
           WHERE g.guardian_user_id = l.parent_user_id
             AND g.minor_user_id = l.child_user_id
        )
      )
    ORDER BY l.is_primary DESC, l.created_at ASC
  `)) as ChildRow[];
} catch (e: any) {
  childrenError = String(e?.cause?.message || e?.message || 'unknown database error');
  console.error('[portal/parent] children read failed -', childrenError);
}

// Per-child: progress courses, last test, pending fees.
type CourseRow = { title: string; percent: number };
type TestRow = { title: string; percentage: number | null; submitted_at: string | null; total_score: number | null; max_score: number | null };
type FeeRow = { description: string; amount: number; currency: string; created_at: string };
type ChildDetail = {
  child: ChildRow;
  courses: CourseRow[];
  primaryCourse: string;
  primaryProgress: number;
  recentTests: TestRow[];
  pendingFees: FeeRow[];
  nextClass: string | null;
  weeklyClasses: number;
  weeklyProblems: number;
  /** Practice SESSIONS recorded this week. Not hours: practice_sessions stores no duration. */
  weeklyPractice: number;
  lastTestPct: number | null;
};
const details: ChildDetail[] = [];
// Which per-child reads did not happen. Named on the page rather than rendered as a zero, because a
// zero and a failed query look identical to a parent and only one of them is a fact about a child.
const readGaps = new Set<string>();

for (const child of children) {
  // COURSES THIS CHILD IS ENROLLED IN.
  //
  // "Try a few plausible shapes; never throw" is how this came to be permanently empty. It read
  // `trainings` (a table named nowhere else in the repository), `e.training_id` and
  // `e.progress_percent` (the column is progress_pct, and the join key is course_id - see
  // src/pages/api/aquintutor/start-enrollment.ts and src/pages/academy/[slug].astro). Every load
  // threw, the catch ate it, and the parent read "No active course" about a child who had several.
  let courses: CourseRow[] = [];
  try {
    courses = rows(await db.execute(sql`
      SELECT COALESCE(c.title, 'Course') AS title,
        COALESCE(e.progress_pct, 0)::int AS percent
      FROM training_enrollments e
      LEFT JOIN training_courses c ON c.id = e.course_id
      WHERE e.user_id = ${String(child.child_user_id)}::uuid
      ORDER BY COALESCE(e.progress_pct, 0) DESC
      LIMIT 6
    `)).map((r: any) => ({ title: r.title, percent: Number(r.percent || 0) }));
  } catch (e: any) {
    readGaps.add('courses');
    console.error('[portal/parent] course progress read failed -', e?.cause?.message || e?.message);
  }

  // Recent test scores from test_attempts (uses candidate_id, not user_id —
  // codebase convention; we honour both via UNION to be safe).
  let recentTests: TestRow[] = [];
  try {
    recentTests = rows(await db.execute(sql`
      SELECT COALESCE(t.title, 'Test') AS title,
        a.percentage::float AS percentage,
        a.submitted_at,
        a.total_score, a.max_score
      FROM test_attempts a
      LEFT JOIN tests t ON t.id = a.test_id
      WHERE a.candidate_id = ${child.child_user_id}
        AND a.status IN ('submitted', 'auto_submitted')
      ORDER BY a.submitted_at DESC NULLS LAST
      LIMIT 5
    `)).map((r: any) => ({
      title: String(r.title || 'Test'),
      percentage: r.percentage !== null ? Number(r.percentage) : null,
      submitted_at: r.submitted_at,
      total_score: r.total_score !== null ? Number(r.total_score) : null,
      max_score: r.max_score !== null ? Number(r.max_score) : null
    }));
  } catch (e: any) {
    readGaps.add('tests');
    console.error('[portal/parent] test history read failed -', e?.cause?.message || e?.message);
  }

  // PENDING FEES, from the ONE table that holds them.
  //
  // There is no `payment_intents` table anywhere in src/ or db/ - the name appears in this file and
  // nowhere else - so the first statement threw every time and fell into a "fallback" that also
  // threw: `payments.notes` is jsonb and COALESCE(jsonb, text, text) has no common type. Two dead
  // statements per child per load, and a fee list that could never contain anything.
  //
  // `payments` columns are the ones every writer in the product actually names (account-credit.ts,
  // fee-waiver.ts, create-order): order_id, amount_paise, currency, status, purpose, user_id.
  let pendingFees: FeeRow[] = [];
  try {
    pendingFees = rows(await db.execute(sql`
      SELECT COALESCE(NULLIF(purpose, ''), 'Fee') AS description,
        COALESCE(amount_paise, 0)::bigint AS amount,
        COALESCE(currency, 'INR') AS currency,
        created_at
      FROM payments
      WHERE user_id = ${String(child.child_user_id)}::uuid
        AND status IN ('created', 'pending', 'unpaid', 'failed')
      ORDER BY created_at DESC
      LIMIT 5
    `)).map((r: any) => ({
      description: String(r.description || 'Fee'),
      amount: Number(r.amount || 0),
      currency: String(r.currency || 'INR'),
      created_at: r.created_at
    }));
  } catch (e: any) {
    readGaps.add('fees');
    console.error('[portal/parent] pending fee read failed -', e?.cause?.message || e?.message);
  }

  // Next class — the child's next LIVE CLASS THEY HOLD A SEAT IN.
  //
  // This query used to read `live_classes.user_id` and `live_classes.start_at`. Neither column
  // exists: the table is created at /portal/liveclass with host_user_id and scheduled_at, and there
  // is no per-learner column on it at all — a seat is a row in live_class_enrollments. So the
  // statement threw on every page load, landed in this catch, and the tile rendered blank forever
  // rather than reporting anything. Blank looked like "no class scheduled", which is a different
  // claim from "this could not be read".
  let nextClass: string | null = null;
  try {
    const nc = rows(await db.execute(sql`
      SELECT c.title, c.scheduled_at
        FROM live_class_enrollments e
        JOIN live_classes c ON c.id = e.class_id
       WHERE e.user_id = ${child.child_user_id}
         AND c.scheduled_at > NOW()
         AND c.status = 'scheduled'
       ORDER BY c.scheduled_at ASC
       LIMIT 1
    `));
    if (nc.length > 0) {
      const r: any = nc[0];
      nextClass = String(r.title || 'Class') + ' to ' + new Date(r.scheduled_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'short', hour: '2-digit', minute: '2-digit' });
    }
  } catch (e: any) {
    readGaps.add('next class');
    console.error('[portal/parent] next class read failed -', e?.cause?.message || e?.message);
  }

  // THE WEEK, COUNTED FROM ROWS THAT EXIST.
  //
  // Two of the three figures here were fiction. "Hours studied" was the number of practice sessions
  // multiplied by 0.5 - practice_sessions records questions_attempted and questions_correct and no
  // duration at all, so half an hour per session was invented in this file and shown to a parent as
  // a measurement of their child. It is now the count of practice sessions, which is a thing that
  // was actually recorded, and the label below says that.
  //
  // "Classes attended" read live_classes.user_id and live_classes.start_at. The comment forty lines
  // above already establishes that neither column exists (the table has host_user_id and
  // scheduled_at, and a seat is a row in live_class_enrollments) - but only the OTHER query using
  // them was repaired, so this one went on throwing and the tile read 0 for everybody, forever.
  let weeklyClasses = 0;
  let weeklyProblems = 0;
  let weeklyPractice = 0;
  try {
    const wc = rows(await db.execute(sql`
      SELECT COUNT(*)::int AS n FROM test_attempts
      WHERE candidate_id = ${String(child.child_user_id)}::uuid
        AND submitted_at >= NOW() - INTERVAL '7 days'
    `));
    weeklyProblems = Number((wc[0] as any)?.n || 0);
  } catch (e: any) {
    readGaps.add('tests this week');
    console.error('[portal/parent] weekly attempts read failed -', e?.cause?.message || e?.message);
  }
  try {
    const wp = rows(await db.execute(sql`
      SELECT COUNT(*)::int AS n FROM practice_sessions
      WHERE user_id = ${String(child.child_user_id)}::uuid
        AND created_at >= NOW() - INTERVAL '7 days'
    `));
    weeklyPractice = Number((wp[0] as any)?.n || 0);
  } catch (e: any) {
    readGaps.add('practice this week');
    console.error('[portal/parent] weekly practice read failed -', e?.cause?.message || e?.message);
  }
  try {
    const wcl = rows(await db.execute(sql`
      SELECT COUNT(*)::int AS n
        FROM live_class_enrollments e
        JOIN live_classes c ON c.id = e.class_id
       WHERE e.user_id = ${String(child.child_user_id)}::uuid
         AND c.scheduled_at >= NOW() - INTERVAL '7 days'
         AND c.scheduled_at < NOW()
    `));
    weeklyClasses = Number((wcl[0] as any)?.n || 0);
  } catch (e: any) {
    readGaps.add('classes this week');
    console.error('[portal/parent] weekly class read failed -', e?.cause?.message || e?.message);
  }

  const primaryCourse = courses[0]?.title || 'No active course';
  const primaryProgress = courses[0]?.percent ?? 0;
  const lastTestPct = recentTests[0]?.percentage ?? null;

  details.push({
    child, courses, primaryCourse, primaryProgress,
    recentTests, pendingFees, nextClass,
    weeklyClasses, weeklyProblems, weeklyPractice, lastTestPct
  });
}

// Page-level weekly aggregates (sum across all children).
const agg = details.reduce((acc, d) => {
  acc.classes += d.weeklyClasses;
  acc.problems += d.weeklyProblems;
  acc.practice += d.weeklyPractice;
  if (d.lastTestPct !== null) acc.testTotal += d.lastTestPct, acc.testCount += 1;
  return acc;
}, { classes: 0, problems: 0, practice: 0, testTotal: 0, testCount: 0 });
const readGapList = Array.from(readGaps).sort().join(', ');
const weeklyTestPct = agg.testCount > 0 ? Math.round(agg.testTotal / agg.testCount) : null;

function fmtMoney(amount: number, currency: string): string {
  const major = currency === 'INR' || currency === 'USD' || currency === 'EUR' || currency === 'CHF' || currency === 'GBP'
    ? amount / 100 : amount;
  const sym = currency === 'INR' ? '₹' : currency === 'USD' ? '$' : currency === 'EUR' ? '€' : currency === 'CHF' ? 'CHF ' : currency === 'GBP' ? '£' : currency + ' ';
  // `timeZone` is a date option; Number.toLocaleString rejects it. It was silently doing nothing
  // useful to a currency amount and is a type error on this file.
  return sym + major.toLocaleString('en-IN', { maximumFractionDigits: 2 });
}
function fmtDate(d: any): string {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' }); } catch { return ''; }
}
function ago(d: any): string {
  if (!d) return 'never';
  try {
    const diff = (Date.now() - new Date(d).getTime()) / 1000;
    if (diff < 60) return 'just now';
    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
    if (diff < 7 * 86400) return Math.floor(diff / 86400) + 'd ago';
    return fmtDate(d);
  } catch { return 'never'; }
}
function initial(name: string): string {
  const t = (name || '').trim();
  return t ? t[0].toUpperCase() : 'L';
}
---
<BaseLayout title="Parent dashboard — EduRankAI" description="Attendance, progress, payments, and recent reports for every child linked to your EduRankAI account.">
  <section class="px-[5vw] py-10 md:py-14 max-w-5xl mx-auto">

    <a href="/portal" class="text-[0.78rem] font-mono uppercase tracking-wider text-burn hover:underline no-underline">&lt; Portal home</a>

    <div class="mt-4 mb-8">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.18em] text-burn font-bold mb-2">Portal · Parent dashboard</p>
      <h1 class="font-display text-[clamp(1.9rem,5vw,2.8rem)] font-semibold text-ink leading-[1.12] mb-3">
        Your child's <em class="not-italic text-burn font-display italic">complete picture</em>.
      </h1>
      <p class="text-[0.95rem] text-ink-soft leading-relaxed max-w-2xl">
        Attendance, progress, payments, recent reports &mdash; across every subject.
      </p>
    </div>

    {formError && (
      <div class="mb-5 bg-[rgba(239,68,68,0.06)] border border-[rgba(239,68,68,0.3)] rounded-xl px-4 py-3 text-[0.86rem] text-[#991b1b]">{formError}</div>
    )}
    {formOk && (
      <div class="mb-5 bg-[rgba(16,185,129,0.08)] border border-[rgba(16,185,129,0.3)] rounded-xl px-4 py-3 text-[0.86rem] text-[#047857]">{formOk}</div>
    )}

    {children.length === 0 ? (
      <div>
        <div class="bg-white border border-ink/10 rounded-2xl p-8 md:p-10 mb-6">
          {/* "No children linked yet" is a claim about this account, and it may only be made when the
              read that would have found them actually ran. When it did not, that is what is said, and
              the link form stays below either way so the page is still useful. */}
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.16em] text-burn font-bold mb-3">
            {childrenError ? 'Linked children could not be loaded' : 'No children linked yet'}
          </p>
          <h2 class="font-display text-[1.5rem] font-semibold text-ink mb-3 leading-[1.2]">
            {childrenError ? 'This is not the same as having none.' : 'Link your first child to begin.'}
          </h2>
          <p class="text-[0.92rem] text-ink-soft leading-relaxed max-w-xl mb-6">
            {childrenError
              ? 'The list of children on your account could not be read just now, so nothing below is a statement about who is linked. The reason has been recorded. Reload in a moment; if it keeps happening, tell us and quote the time.'
              : 'Your child needs an EduRankAI account first. Once they have one, drop their email below and pick the relationship — their dashboard appears here instantly.'}
          </p>
          <form method="post" class="bg-white border border-ink/10 rounded-2xl p-6 max-w-xl">
            <div class="mb-4">
              <label for="child_email" class="block text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Child's email</label>
              <input id="child_email" name="child_email" type="email" required placeholder="learner@example.com"
                class="w-full border border-ink/15 rounded-lg px-3 py-2.5 text-[0.92rem] text-ink bg-white focus:outline-none focus:border-burn" />
            </div>
            <div class="mb-4">
              <label for="relationship" class="block text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Relationship</label>
              <select id="relationship" name="relationship" class="w-full border border-ink/15 rounded-lg px-3 py-2.5 text-[0.92rem] text-ink bg-white focus:outline-none focus:border-burn">
                <option value="parent">Parent</option>
                <option value="guardian">Guardian</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="mb-5 flex items-center gap-2">
              <input id="is_primary" name="is_primary" type="checkbox" value="true" checked class="accent-burn" />
              <label for="is_primary" class="text-[0.85rem] text-ink-soft">I am the primary contact for this child</label>
            </div>
            <button type="submit" class="bg-burn text-white border-0 px-5 py-2.5 rounded-lg text-[0.88rem] font-semibold tracking-wide hover:bg-[#e64600] cursor-pointer">
              Link child
            </button>
          </form>
        </div>
      </div>
    ) : (
      <div>
        {/* Weekly summary */}
        <div class="bg-white border border-ink/10 rounded-2xl p-6 md:p-7 mb-8">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.16em] text-burn font-bold mb-3">This week</p>
          <p class="font-display text-[1.25rem] md:text-[1.45rem] text-ink leading-[1.35]">
            <strong class="text-ink font-semibold">{agg.classes}</strong> {agg.classes === 1 ? 'class' : 'classes'} attended, <strong class="text-ink font-semibold">{agg.problems}</strong> {agg.problems === 1 ? 'test' : 'tests'} taken, <strong class="text-ink font-semibold">{agg.practice}</strong> practice {agg.practice === 1 ? 'session' : 'sessions'}{weeklyTestPct !== null ? <>, <strong class="text-ink font-semibold">{weeklyTestPct}%</strong> on the last test</> : null}.
          </p>
          {readGapList && (
            <p class="text-[0.78rem] text-[#991b1b] mt-2">Not everything on this page could be read: {readGapList}. Those figures are missing, not zero.</p>
          )}
          {children.length > 1 && (
            <p class="text-[0.78rem] font-mono uppercase tracking-wider text-ink-soft mt-2">Aggregated across {children.length} children</p>
          )}
        </div>

        {/* Child cards */}
        <div class="space-y-6">
          {details.map((d) => (
            <article class="bg-white border border-ink/10 rounded-2xl p-6 md:p-7">
              <div class="flex items-start gap-4 mb-5">
                <div class="w-14 h-14 rounded-full bg-burn-pale border border-burn-dim flex items-center justify-center font-display text-[1.5rem] text-burn font-semibold shrink-0">
                  {initial(d.child.name)}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline gap-2 flex-wrap">
                    <h2 class="font-display text-[1.35rem] text-ink font-semibold leading-tight">{d.child.name}</h2>
                    <span class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft">{d.child.relationship}{d.child.is_primary ? ' · primary' : ''}</span>
                  </div>
                  <p class="text-[0.85rem] text-ink-soft mt-0.5">{d.child.school || 'School not on record'} &middot; last seen {ago(d.child.last_login)}</p>
                </div>
              </div>

              {/* Primary course + progress */}
              <div class="mb-5">
                <div class="flex items-baseline justify-between mb-1.5">
                  <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft">Primary course</p>
                  <p class="text-[0.85rem] text-ink font-semibold">{d.primaryProgress}%</p>
                </div>
                <p class="text-[0.95rem] text-ink mb-2">{d.primaryCourse}</p>
                <div class="h-2 w-full bg-cream-2 rounded-full overflow-hidden">
                  <div class="h-full bg-burn rounded-full" style={`width: ${Math.max(0, Math.min(100, d.primaryProgress))}%`}></div>
                </div>
              </div>

              {/* Courses list */}
              {d.courses.length > 1 && (
                <div class="mb-5">
                  <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">All courses</p>
                  <ul class="space-y-2">
                    {d.courses.slice(1).map((c) => (
                      <li class="flex items-center justify-between text-[0.88rem] gap-3">
                        <span class="text-ink truncate">{c.title}</span>
                        <span class="text-ink-soft shrink-0">{c.percent}%</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {/* Next class */}
              {d.nextClass && (
                <div class="mb-5 bg-burn-pale/60 border border-burn-dim rounded-xl px-4 py-3">
                  <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-burn font-bold mb-1">Next class</p>
                  <p class="text-[0.9rem] text-ink">{d.nextClass}</p>
                </div>
              )}

              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {/* Recent test scores */}
                <div>
                  <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Recent test scores</p>
                  {d.recentTests.length === 0 ? (
                    <p class="text-[0.85rem] text-ink-soft italic">No submitted tests yet.</p>
                  ) : (
                    <ul class="space-y-2">
                      {d.recentTests.map((t) => (
                        <li class="flex items-center justify-between text-[0.86rem] gap-3 border-b border-ink/5 pb-2 last:border-0 last:pb-0">
                          <div class="min-w-0 flex-1">
                            <p class="text-ink truncate">{t.title}</p>
                            <p class="text-[0.72rem] text-ink-soft">{fmtDate(t.submitted_at)}</p>
                          </div>
                          <span class="text-ink font-semibold shrink-0">{t.percentage !== null ? Math.round(t.percentage) + '%' : (t.total_score !== null && t.max_score ? t.total_score + '/' + t.max_score : '&mdash;')}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                {/* Pending fees */}
                <div>
                  <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Pending fees</p>
                  {d.pendingFees.length === 0 ? (
                    <p class="text-[0.85rem] text-[#047857] flex items-center gap-1.5">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      All clear.
                    </p>
                  ) : (
                    <ul class="space-y-2">
                      {d.pendingFees.map((f) => (
                        <li class="flex items-center justify-between text-[0.86rem] gap-3 border-b border-ink/5 pb-2 last:border-0 last:pb-0">
                          <div class="min-w-0 flex-1">
                            <p class="text-ink truncate">{f.description}</p>
                            <p class="text-[0.72rem] text-ink-soft">{fmtDate(f.created_at)}</p>
                          </div>
                          <span class="text-burn font-semibold shrink-0">{fmtMoney(f.amount, f.currency)}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>

              {/* Per-child weekly mini */}
              <div class="mt-5 pt-4 border-t border-ink/5 flex items-center gap-4 flex-wrap text-[0.78rem] font-mono uppercase tracking-wider text-ink-soft">
                <span class="flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  {d.weeklyClasses} classes this week
                </span>
                <span class="flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                  {d.weeklyProblems} tests
                </span>
                <span class="flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {d.weeklyPractice} practice
                </span>
              </div>
            </article>
          ))}
        </div>

        {/* Add another child */}
        <div class="mt-10 bg-white border border-ink/10 rounded-2xl p-6 md:p-7">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.16em] text-burn font-bold mb-2">Add another child</p>
          <h3 class="font-display text-[1.25rem] text-ink font-semibold mb-3">Link a second learner.</h3>
          <p class="text-[0.88rem] text-ink-soft mb-5 max-w-xl leading-relaxed">
            They will need their own EduRankAI account first. Once linked, their card appears alongside the others.
          </p>
          <form method="post" class="grid grid-cols-1 md:grid-cols-3 gap-3 items-end">
            <div>
              <label for="child_email_2" class="block text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Child's email</label>
              <input id="child_email_2" name="child_email" type="email" required placeholder="learner@example.com"
                class="w-full border border-ink/15 rounded-lg px-3 py-2.5 text-[0.92rem] text-ink bg-white focus:outline-none focus:border-burn" />
            </div>
            <div>
              <label for="relationship_2" class="block text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft mb-2">Relationship</label>
              <select id="relationship_2" name="relationship" class="w-full border border-ink/15 rounded-lg px-3 py-2.5 text-[0.92rem] text-ink bg-white focus:outline-none focus:border-burn">
                <option value="parent">Parent</option>
                <option value="guardian">Guardian</option>
                <option value="other">Other</option>
              </select>
              <input type="hidden" name="is_primary" value="false" />
            </div>
            <button type="submit" class="bg-burn text-white border-0 px-5 py-2.5 rounded-lg text-[0.88rem] font-semibold tracking-wide hover:bg-[#e64600] cursor-pointer">
              Link child
            </button>
          </form>
        </div>
      </div>
    )}

  </section>
</BaseLayout>
