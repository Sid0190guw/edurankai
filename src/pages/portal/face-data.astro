---
// /portal/face-data — see what facial data your account holds, and delete it.
//
// =================================================================================================
// THE PAGE AN APPLICANT ASKED FOR AND COULD NOT FIND
// =================================================================================================
//
// "I would now like to disable Face 2FA, but there is no option in my account settings to disable or
//  remove it."
//
// She was right. Enrolling a face took one tap; there was no way back. The only removal controls in
// the product were an admin turning off their own, and an admin deleting somebody else's from
// /admin/users. Nothing a person could do about their own face, which for biometric data is the one
// control that has to exist.
//
// So: what is held, said plainly and read from the database rather than assumed; and a button that
// deletes it and confirms by reading back.
//
// OPEN TO EVERY SIGNED-IN ACCOUNT, applicants included. Withdrawing consent to biometric processing
// is not a staff privilege.
//
// const BEFORE THE HANDLER — `const` is not hoisted, and that has taken pages down here.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faceHoldings, eraseFaceData, type ErasureResult } from '@/lib/auth/face-erasure';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/face-data');

let result: ErasureResult | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData().catch(() => null);
  if (String(fd?.get('action') || '') === 'erase') {
    result = await eraseFaceData(String(user.id), {
      alsoDeleteProfilePhoto: String(fd?.get('photo') || '') === 'yes',
      actorUserId: String(user.id),
      reason: 'Withdrawn by the account holder from /portal/face-data',
    });
  }
}

// Read AFTER the write, so the page shows the state that now exists.
const held = await faceHoldings(String(user.id));

const CARD = 'background:#fff;border:1px solid rgba(17,17,17,0.12);border-radius:14px;padding:20px 22px;margin-bottom:18px;';
const LBL = 'font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:#6b7280;';
---

<BaseLayout title="Your facial data - EduRankAI" description="See and delete the facial data held on your account.">
  <section style="padding:48px 20px;max-width:680px;margin:0 auto;">
    <p style={LBL + 'color:#DC5000;margin:0 0 8px;'}>Account privacy</p>
    <h1 style="font-size:28px;font-weight:700;color:#111;margin:0 0 8px;">Your facial data</h1>
    <p style="font-size:14px;color:#6b7280;margin:0 0 24px;line-height:1.65;">
      Face sign-in is optional. You can turn it off and delete what is held at any time, and keep
      your account, your applications and every other way of signing in.
    </p>

    {result && (
      <div style={CARD + (result.ok ? 'border-color:rgba(0,150,70,0.45);background:rgba(0,150,70,0.05);' : 'border-color:rgba(200,40,40,0.45);background:rgba(200,40,40,0.05);')}>
        <p style={'margin:0 0 6px;font-weight:700;font-size:15px;color:' + (result.ok ? '#166534' : '#991b1b') + ';'}>
          {result.ok ? 'Deleted.' : 'Nothing was deleted.'}
        </p>
        <p style="margin:0;font-size:13.5px;color:#374151;line-height:1.65;">{result.sentence}</p>
        {result.ok && result.completedAt && (
          <p style="margin:10px 0 0;font-size:12.5px;color:#6b7280;">
            Completed {new Date(result.completedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })} IST.
            Keep this page or the confirmation email as your record.
          </p>
        )}
      </div>
    )}

    <!-- WHAT IS HELD. Read from the database, not from what the enrolment screen once promised. -->
    <div style={CARD}>
      <p style={LBL + 'margin:0 0 12px;'}>What your account holds right now</p>

      {held.error ? (
        <p style="margin:0;font-size:13.5px;color:#991b1b;line-height:1.65;">
          We could not read this just now, so nothing below is a statement that nothing is held.
          Please reload in a moment. ({held.error})
        </p>
      ) : !held.enrolled ? (
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.65;">
          Nothing. There is no face enrolment on this account, so no facial image and no biometric
          template are stored.
        </p>
      ) : (
        <ul style="margin:0;padding-left:18px;font-size:14px;color:#374151;line-height:1.9;">
          <li>
            <strong>Face sign-in:</strong> {held.active ? 'on' : 'enrolled but currently switched off'}
            {held.enrolledAt ? ' since ' + new Date(held.enrolledAt).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'long', year: 'numeric' }) : ''}
          </li>
          <li>
            <strong>Biometric template:</strong> {held.hasTemplate
              ? 'stored - 128 numbers computed from your face. It cannot be turned back into a picture, but it identifies you and is biometric data.'
              : 'none stored'}
          </li>
          <li>
            <strong>Captured photograph:</strong> {held.hasImage
              ? 'STORED. The picture taken during enrolment is held on your record.'
              : 'not stored'}
          </li>
          {held.hasDerivedPhoto && (
            <li><strong>Profile picture:</strong> your account has one. If it came from the face capture, you can remove it below.</li>
          )}
        </ul>
      )}
    </div>

    <!-- WHO ELSE TOUCHES IT. Asked constantly, and the honest answer is short. -->
    <div style={CARD}>
      <p style={LBL + 'margin:0 0 10px;'}>Who processes it</p>
      <p style="margin:0;font-size:13.5px;color:#374151;line-height:1.7;">
        Nobody outside EduRankAI. Your face is read in your own browser, and the software that does
        it is served from this site rather than from an outside network. The template and any stored
        photograph sit in our own database. No facial data is sent to a third-party face recognition
        service, and none is used to train anything.
      </p>
    </div>

    {held.enrolled && !held.error && (
      <form method="POST" style={CARD + 'border-color:rgba(200,40,40,0.35);'}>
        <input type="hidden" name="action" value="erase" />
        <p style={LBL + 'margin:0 0 10px;color:#991b1b;'}>Turn it off and delete it</p>
        <p style="margin:0 0 14px;font-size:13.5px;color:#374151;line-height:1.7;">
          This deletes the biometric template and any stored photograph, and switches face sign-in
          off. It cannot be undone, and it does not affect your account, your applications, or your
          password, passkey and authenticator sign-in.
        </p>

        {held.hasDerivedPhoto && (
          <label style="display:flex;gap:9px;align-items:flex-start;margin:0 0 14px;font-size:13.5px;color:#374151;line-height:1.6;cursor:pointer;">
            <input type="checkbox" name="photo" value="yes" style="margin-top:3px;" />
            <span>Also remove my profile picture. Left unticked, your profile picture stays &mdash; deleting it unasked would be a separate surprise.</span>
          </label>
        )}

        <label style="display:flex;gap:9px;align-items:flex-start;margin:0 0 14px;font-size:13.5px;color:#374151;line-height:1.6;cursor:pointer;">
          <!-- A required acknowledgement rather than a confirm() dialog: admin pages are framed in a
               sandbox where confirm() is ignored and returns false, which silently cancels the very
               action somebody pressed. A native checkbox works everywhere. -->
          <input type="checkbox" name="ack" required style="margin-top:3px;" />
          <span>I understand this permanently deletes my facial data and cannot be undone.</span>
        </label>

        <button type="submit" style="min-height:46px;padding:0 20px;border:0;border-radius:10px;background:#b91c1c;color:#fff;font-weight:650;font-size:15px;cursor:pointer;">
          Delete my facial data
        </button>
      </form>
    )}

    <p style="margin-top:8px;font-size:13px;">
      <a href="/portal/security" style="color:#DC5000;font-weight:600;">Security settings</a>
      <span style="color:#9ca3af;"> &middot; </span>
      <a href="/portal" style="color:#DC5000;font-weight:600;">Back to portal</a>
    </p>
  </section>
</BaseLayout>
