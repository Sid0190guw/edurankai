---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { can } from '@/lib/auth/permissions';
import {
  CRM_STAGES, ensureCrmSchema, dbReason, listDeals, dealStats,
  listContacts, listActivities, listOpenTasks, listContactOptions, closeTask,
} from '@/lib/crm';
// toRows because postgres-js hands back a plain array and drizzle's own driver wraps it in `.rows`;
// uuidish because a non-UUID id bound against a uuid column raises 22P02 and the user is then shown
// a Postgres complaint about their own click; clip/pageParam for the same reasons as everywhere else.
import { toRows, uuidish, clip, pageParam } from '@/lib/page-safety';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/crm');

// AUTHORISATION. THIS PAGE HAD NONE.
//
// The only gate was `if (!user)`, and src/middleware.ts protects /portal/* by sign-in alone. So any
// signed-in account at all — an applicant who registered five minutes ago, a parent, a student —
// could open /portal/crm and read every contact's name, email, phone, company and lifetime value,
// and INSERT contacts and deals into the company pipeline. Customer contact details are exactly the
// class of data that must not be readable by whoever happens to hold a portal session.
//
// The capability is asked of src/lib/auth/permissions.ts (never users.role), and `admin.access` is
// the key whose holders are the seven console roles — the same population src/middleware.ts admits
// to /admin, where every other internal business tool on this codebase lives. The refusal below
// says what is missing rather than bouncing the person to /portal with no explanation.
const mayUseCrm = can(user as any, 'admin.access');
if (!mayUseCrm) {
  return new Response(
    '<!doctype html><html lang="en"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1">' +
    '<title>CRM — not available for this account</title></head>' +
    '<body style="margin:0;background:#FAF8F5;color:#0E0B08;font-family:Georgia,serif;">' +
    '<main style="max-width:640px;margin:0 auto;padding:80px 24px;">' +
    '<p style="font-family:ui-monospace,monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#FF4F00;margin:0 0 16px;">Portal &middot; CRM</p>' +
    '<h1 style="font-size:34px;font-weight:500;margin:0 0 16px;">This console is not open to your account.</h1>' +
    '<p style="font-size:17px;line-height:1.6;color:#5d4a3a;margin:0 0 12px;">The CRM holds customer contact details — names, addresses, phone numbers and account values. Reading it requires the <strong>admin.access</strong> capability, which your account does not hold.</p>' +
    '<p style="font-size:15px;line-height:1.6;color:#5d4a3a;margin:0 0 28px;">If you need it for your work, ask an administrator to grant it; nothing about this page changes until they do.</p>' +
    '<p style="margin:0;"><a href="/portal" style="font-family:ui-monospace,monospace;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#0E0B08;border:1px solid #1d160f33;border-radius:8px;padding:10px 16px;text-decoration:none;">Back to the portal</a></p>' +
    '</main></body></html>',
    { status: 403, headers: { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' } },
  );
}

let okMsg = '', errMsg = '';

// THE STAGE VOCABULARY, DECLARED BEFORE THE HANDLER THAT USES IT.
//
// `const stages` sits further down this file, below the POST block, and `const` is not hoisted —
// referencing it from inside the handler would throw on the first line of every POST rather than
// validating anything. This is the same shape that broke apply step 5 and the roles Repair button
// on this project, and it is why the list is derived from the one vocabulary in src/lib/crm.ts
// rather than written out twice.
const STAGES = CRM_STAGES;

// The six CREATE TABLE + six CREATE INDEX statements that used to run on EVERY page load now live
// behind a once-per-process guard in src/lib/crm.ts, and they report failure instead of being
// swallowed: if the schema is not there, every panel below says so rather than rendering empty.
const schemaBoot = await ensureCrmSchema();

// POST handlers
if (Astro.request.method === 'POST') {
  // DECLARED OUTSIDE THE `try`, WHICH IS THE WHOLE POINT.
  //
  // `action` used to be a `const` INSIDE the try block, and the catch at the bottom logged
  // `String(action)`. A `const` is block-scoped, so the catch referenced a name that is not in
  // scope: the moment any write failed, the error handler itself threw a ReferenceError, the
  // failure it was written to report was replaced by a different one, and the page answered with a
  // bare 500 instead of the sentence it had ready. The one path that must never fail is the path
  // that explains a failure.
  let action = '';
  try {
    const form = await Astro.request.formData();
    action = String(form.get('action') || '');

    if (action === 'create_contact') {
      const fullName = String(form.get('full_name') || '').trim();
      const email = String(form.get('email') || '').trim();
      const phone = String(form.get('phone') || '').trim() || null;
      const company = String(form.get('company') || '').trim() || null;
      const role = String(form.get('role') || '').trim() || null;
      const location = String(form.get('location') || '').trim() || null;
      const source = String(form.get('source') || 'manual').trim();
      const stage = String(form.get('pipeline_stage') || 'lead').trim();
      const ltv = parseFloat(String(form.get('lifetime_value_chf') || '0')) || null;
      const tagsRaw = String(form.get('tags') || '').trim();
      const tags = tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(Boolean) : [];
      const notes = String(form.get('notes') || '').trim() || null;
      if (!fullName || !email) {
        errMsg = 'Name and email are required.';
      } else {
        await db.execute(sql`INSERT INTO crm_contacts(owner_user_id, full_name, email, phone, company, role, location, source, pipeline_stage, lifetime_value_chf, tags, notes)
          VALUES (${user.id}, ${fullName}, ${email}, ${phone}, ${company}, ${role}, ${location}, ${source}, ${stage}, ${ltv}, ${JSON.stringify(tags)}::jsonb, ${notes})`);
        okMsg = 'Contact added.';
      }
    } else if (action === 'log_activity') {
      const contactId = String(form.get('contact_id') || '');
      const kind = String(form.get('kind') || 'note');
      const summary = String(form.get('summary') || '').trim();
      const dueAt = String(form.get('due_at') || '').trim() || null;
      if (!contactId || !summary) {
        errMsg = 'Contact and summary required.';
      } else {
        await db.execute(sql`INSERT INTO crm_activities(contact_id, user_id, kind, summary, due_at, completed_at)
          VALUES (${contactId}::uuid, ${user.id}, ${kind}, ${summary}, ${dueAt ? sql`${dueAt}::timestamptz` : sql`NULL`}, ${kind === 'task' ? null : sql`NOW()`})`);
        await db.execute(sql`UPDATE crm_contacts SET last_contacted_at = NOW(), updated_at = NOW() WHERE id = ${contactId}::uuid`);
        okMsg = 'Activity logged.';
      }
    } else if (action === 'move_deal_stage') {
      const dealId = String(form.get('deal_id') || '');
      const newStage = String(form.get('new_stage') || '');
      // CHECKED AGAINST THE VOCABULARY, NOT AGAINST THE FORM THAT WAS RENDERED. The stage used to be
      // written straight through, which was survivable while the only writer was a drag handler that
      // could only ever produce a column that exists. There is a native <select> on every card now,
      // so the value arrives from the request like any other posted field and has to be treated as
      // one — an unrecognised stage would put a deal in a column no view renders, where it is
      // invisible rather than wrong.
      if (dealId && newStage && !(STAGES as readonly string[]).includes(newStage)) {
        errMsg = 'That is not a stage on this pipeline. Nothing was moved.';
      } else if (!uuidish(dealId)) {
        // A deal id that is not a UUID reaches Postgres as an invalid literal and raises 22P02,
        // which the catch below then shows the user as a database complaint about their own click.
        errMsg = 'That is not a deal this page can move. Nothing was moved.';
      } else if (dealId && newStage) {
        // MOVING A DEAL HAS NEVER WORKED. This block called `rows(...)`, and there is no `rows` in
        // this file — the ReferenceError fired BEFORE the UPDATE, so the deal never moved, and the
        // catch below reported "rows is not defined" to whoever dragged the card.
        //
        // The read and the write are now one statement with RETURNING, which also fixes the second
        // half of it: the UPDATE was unguarded and its result never looked at, so a stale card in an
        // open tab printed "Deal moved." over a deal that no longer exists. `AND stage <> newStage`
        // makes a repeat press a no-op rather than a second identical stage_change entry in the
        // timeline, which is the only record of how a deal actually travelled.
        const moved = toRows(await db.execute(sql`
          UPDATE crm_deals d SET stage = ${newStage}
          FROM crm_deals prev
          WHERE d.id = ${dealId}::uuid AND prev.id = d.id AND d.stage <> ${newStage}
          RETURNING prev.stage AS old_stage, d.contact_id AS contact_id`));
        if (moved.length === 0) {
          const still = toRows(await db.execute(sql`SELECT stage FROM crm_deals WHERE id = ${dealId}::uuid`));
          errMsg = still.length
            ? 'Nothing was moved: that deal is already at ' + String(still[0].stage) + '.'
            : 'Nothing was moved: there is no deal with that id any more. Reload the board.';
        } else {
          const oldStage = moved[0].old_stage;
          const cid = moved[0].contact_id;
          if (cid) {
            await db.execute(sql`INSERT INTO crm_activities(contact_id, user_id, kind, summary, payload)
              VALUES (${cid}::uuid, ${user.id}, 'stage_change', ${'Deal moved: ' + oldStage + ' to ' + newStage}, ${JSON.stringify({from: oldStage, to: newStage, deal_id: dealId})}::jsonb)`);
            if (newStage === 'won' || newStage === 'lost') {
              await db.execute(sql`UPDATE crm_contacts SET pipeline_stage = ${newStage}, updated_at = NOW() WHERE id = ${cid}::uuid`);
            }
          }
          okMsg = 'Deal moved from ' + String(oldStage) + ' to ' + newStage + '.'
            + (cid ? '' : ' It is not linked to a contact, so nothing was added to any timeline.');
        }
      }
    } else if (action === 'create_deal') {
      const contactId = String(form.get('contact_id') || '');
      const title = String(form.get('title') || '').trim();
      const amount = parseFloat(String(form.get('amount_chf') || '0')) || null;
      const stage = String(form.get('stage') || 'qualified');
      const closeDate = String(form.get('close_date') || '').trim() || null;
      const prob = parseInt(String(form.get('probability_pct') || '50')) || 50;
      if (!contactId || !title) {
        errMsg = 'Contact and deal title required.';
      } else {
        await db.execute(sql`INSERT INTO crm_deals(contact_id, owner_user_id, title, amount_chf, stage, close_date, probability_pct)
          VALUES (${contactId}::uuid, ${user.id}, ${title}, ${amount}, ${stage}, ${closeDate ? sql`${closeDate}::date` : sql`NULL`}, ${prob})`);
        okMsg = 'Deal created.';
      }
    } else if (action === 'close_task') {
      // THE TASKS PANEL LISTED WORK AND OFFERED NO WAY TO FINISH IT. crm_activities.completed_at was
      // written only by log_activity (which sets it for non-task kinds), so an open task could never
      // leave the "due in the next 7 days" list — the panel could only grow. This is the write that
      // closes one, and it appends a note so the timeline records who closed it and when.
      const taskId = String(form.get('task_id') || '');
      if (!taskId) {
        errMsg = 'No task was named. Nothing was closed.';
      } else {
        const done = await closeTask(taskId, user.id);
        okMsg = done ? 'Task closed.' : '';
        if (!done) errMsg = 'That task is already closed, or it no longer exists.';
      }
    }
  } catch (e: any) {
    // postgres-js puts the failed SQL in e.message and the actual Postgres complaint on e.cause.
    // Reporting e.message alone showed the operator their own statement and never the reason.
    errMsg = dbReason(e);
    console.error('[crm] POST ' + String(action) + ' failed:', errMsg);
  }
}

// Read state
const sortKey = String(Astro.url.searchParams.get('sort') || 'updated_at');
const stageFilter = String(Astro.url.searchParams.get('stage') || '');
const tagFilter = String(Astro.url.searchParams.get('tag') || '').toLowerCase();
const page = pageParam(Astro.url.searchParams.get('p'));
const perPage = 25;
const offset = (page - 1) * perPage;

const allowedSort: Record<string, string> = {
  name: 'full_name ASC',
  company: 'company ASC NULLS LAST',
  last_contacted: 'last_contacted_at DESC NULLS LAST',
  ltv: 'lifetime_value_chf DESC NULLS LAST',
  stage: 'pipeline_stage ASC',
  updated_at: 'updated_at DESC',
};
const orderBy = allowedSort[sortKey] || allowedSort.updated_at;

// Stage counts for kanban
// Derived from STAGES above rather than restated, so the list the handler validates against and the
// list the columns are drawn from can never drift apart.
const stages: string[] = [...STAGES];

// =================================================================================================
// EVERY PANEL ON THIS PAGE WAS READING THROUGH A FUNCTION THAT DOES NOT EXIST.
//
// Six blocks below used to call `rows(await db.execute(...))`. There is no `rows` in this file and
// none is imported — src/lib/crm.ts has one, but it is not exported and was never brought in. So at
// runtime every one of those lines raised `rows is not defined`, and every one of them sat inside a
// `catch (_) {}`. The consequence is not a crash, which is what makes it survivable for months: the
// kanban rendered as six empty columns, the stat strip as five zeros, the contact table as "no
// contacts", the timeline and the task panel as empty — a complete, confident, entirely fictional
// picture of an empty CRM, with nothing in the log and nothing on the screen to say otherwise.
//
// The reads now go through src/lib/crm.ts, which already owns these queries and returns
// `{ ok, rows } | { ok: false, error }`. Every panel below can therefore say which of the two it is,
// and the `catch (_) {}` swallowing is gone from all six.
// =================================================================================================
const dealsRead = await listDeals();
const kanbanDeals: any[] = dealsRead.ok ? dealsRead.rows : [];

const statsRead = await dealStats();
const stats = statsRead.ok ? statsRead.rows : { open_deals: 0, pipeline_value: 0, won_month: 0, total_deals: 0, won_total: 0 };
// A conversion rate over a failed read is a made-up number, so it is only computed from a real one.
const conversionRate = statsRead.ok && stats.total_deals > 0
  ? Math.round((stats.won_total / stats.total_deals) * 100)
  : 0;

const contactsRead = await listContacts({
  stage: stageFilter && stages.includes(stageFilter) ? stageFilter : undefined,
  tag: tagFilter || undefined,
  limit: perPage,
  offset,
  sortKey,
});
const contacts: any[] = contactsRead.ok ? contactsRead.rows.contacts : [];
const totalContacts = contactsRead.ok ? contactsRead.rows.total : 0;
const totalPages = Math.max(1, Math.ceil(totalContacts / perPage));

const activitiesRead = await listActivities({ limit: 20 });
const activities: any[] = activitiesRead.ok ? activitiesRead.rows : [];

const tasksRead = await listOpenTasks();
const tasks: any[] = tasksRead.ok ? tasksRead.rows : [];

const contactOptionsRead = await listContactOptions();
const allContacts: any[] = contactOptionsRead.ok ? contactOptionsRead.rows : [];

/** One banner naming every panel that did not answer, so no blank below reads as "none". */
const readFailures: string[] = [];
if (!dealsRead.ok) readFailures.push('the deals on the pipeline board');
if (!statsRead.ok) readFailures.push('the pipeline figures at the top');
if (!contactsRead.ok) readFailures.push('the contact table');
if (!activitiesRead.ok) readFailures.push('the activity timeline');
if (!tasksRead.ok) readFailures.push('the task panel');
if (!contactOptionsRead.ok) readFailures.push('the contact picker in the forms');
const firstReadError = (!dealsRead.ok && dealsRead.error)
  || (!statsRead.ok && statsRead.error)
  || (!contactsRead.ok && contactsRead.error)
  || (!activitiesRead.ok && activitiesRead.error)
  || (!tasksRead.ok && tasksRead.error)
  || (!contactOptionsRead.ok && contactOptionsRead.error)
  || null;

// Group deals by stage for kanban
const dealsByStage: Record<string, any[]> = {};
for (const s of stages) dealsByStage[s] = [];
for (const d of kanbanDeals) {
  const st = stages.includes(d.stage) ? d.stage : 'qualified';
  dealsByStage[st].push(d);
}

function fmtChf(n: any): string {
  if (n === null || n === undefined) return '—';
  const v = Number(n);
  if (isNaN(v)) return '—';
  // `timeZone` is a DATE option and was being passed to a NUMBER formatter, which is what the type
  // checker was reporting here. It never did anything to the output — a money figure has no time
  // zone — so removing it changes no rendered character and takes the error with it.
  return 'CHF ' + v.toLocaleString('en-CH', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
function fmtDate(d: any): string {
  if (!d) return '—';
  try { return new Date(d).toLocaleDateString('en-CH', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric' }); } catch { return '—'; }
}
function fmtDateTime(d: any): string {
  if (!d) return '—';
  try { return new Date(d).toLocaleString('en-CH', { timeZone: 'Asia/Kolkata', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch { return '—'; }
}
function timeAgo(d: any): string {
  if (!d) return '—';
  const ms = Date.now() - new Date(d).getTime();
  const m = Math.floor(ms / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + 'm ago';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h ago';
  const days = Math.floor(h / 24);
  if (days < 30) return days + 'd ago';
  const months = Math.floor(days / 30);
  return months + 'mo ago';
}
function parseTags(t: any): string[] {
  if (!t) return [];
  if (Array.isArray(t)) return t;
  try { const p = JSON.parse(t); return Array.isArray(p) ? p : []; } catch { return []; }
}
function stagePillClass(s: string): string {
  if (s === 'won') return 'pill pill-won';
  if (s === 'lost') return 'pill pill-lost';
  if (s === 'negotiation') return 'pill pill-neg';
  if (s === 'proposal') return 'pill pill-prop';
  if (s === 'qualified') return 'pill pill-qual';
  return 'pill pill-lead';
}
function kindIconPath(k: string): string {
  if (k === 'call') return 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z';
  if (k === 'email') return 'M4 4h16v16H4zM4 4l8 8 8-8';
  if (k === 'meeting') return 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75';
  if (k === 'task') return 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11';
  if (k === 'stage_change') return 'M5 12h14M12 5l7 7-7 7';
  return 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8';
}

const stageColors: Record<string, string> = {
  lead: '#a3724b',
  qualified: '#4b6da3',
  proposal: '#8b4ba3',
  negotiation: '#a36b4b',
  won: '#4a7d4a',
  lost: '#8a4a4a',
};
---
<BaseLayout title="CRM · Portal" description="In-house CRM — pipeline, contacts, activity timeline">
<style>
  :root {
    --cream: #FAF8F5;
    --ink: #0E0B08;
    --burn: #FF4F00;
    --paper: #FFFEFB;
    --hair: #1d160f1a;
    --hair-strong: #1d160f33;
    --rust: #b2542e;
    --mute: #5d4a3a;
  }
  body { background: var(--cream); color: var(--ink); font-family: 'Cormorant Garamond', Georgia, serif; }
  .crm-wrap { max-width: 1400px; margin: 0 auto; padding: 56px 32px 120px; }
  .hero { margin-bottom: 56px; }
  .eyebrow { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--burn); margin-bottom: 16px; }
  .hero h1 { font-family: 'Cormorant Garamond', serif; font-size: 72px; line-height: 1.02; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 18px; }
  .hero h1 em { font-style: italic; color: var(--burn); }
  .hero p { font-size: 19px; color: var(--mute); max-width: 720px; line-height: 1.5; margin: 0; }

  .msg { padding: 14px 18px; border-radius: 10px; font-family: 'Geist Mono', monospace; font-size: 12px; margin-bottom: 24px; }
  .msg-ok { background: #4a7d4a14; color: #2d5a2d; border: 1px solid #4a7d4a33; }
  .msg-err { background: #8a4a4a14; color: #6e2c2c; border: 1px solid #8a4a4a33; }

  .stats-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--hair-strong); border: 1px solid var(--hair-strong); border-radius: 14px; overflow: hidden; margin-bottom: 56px; }
  .stat { background: var(--paper); padding: 22px 26px; }
  .stat-lbl { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--mute); margin-bottom: 12px; }
  .stat-val { font-family: 'Cormorant Garamond', serif; font-size: 42px; font-weight: 500; letter-spacing: -0.01em; line-height: 1; }
  .stat-sub { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); margin-top: 8px; }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 48px 0 22px; }
  .sec-head h2 { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 500; margin: 0; }
  .sec-sub { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); letter-spacing: 0.08em; text-transform: uppercase; }

  /* Kanban */
  .kanban { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .kcol { background: var(--paper); border: 1px solid var(--hair); border-radius: 12px; min-height: 320px; display: flex; flex-direction: column; }
  .kcol-head { padding: 14px 14px 12px; border-bottom: 1px solid var(--hair); display: flex; align-items: center; justify-content: space-between; }
  .kcol-title { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
  .kdot { width: 7px; height: 7px; border-radius: 50%; }
  .kcount { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); }
  .kbody { padding: 10px; flex: 1; display: flex; flex-direction: column; gap: 8px; min-height: 200px; }
  .kbody.drag-over { background: #FF4F0008; outline: 2px dashed #FF4F0044; outline-offset: -4px; }
  .kcard { background: var(--cream); border: 1px solid var(--hair-strong); border-radius: 8px; padding: 12px; cursor: grab; transition: transform 0.12s, box-shadow 0.12s; }
  .kcard:hover { transform: translateY(-1px); box-shadow: 0 4px 12px #0e0b0814; }
  .kcard.dragging { opacity: 0.4; }
  .kcard-name { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 600; line-height: 1.2; margin-bottom: 4px; }
  .kcard-co { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--mute); margin-bottom: 8px; }
  .kcard-title { font-size: 14px; line-height: 1.3; margin-bottom: 8px; color: #2d211b; }
  .kcard-foot { display: flex; align-items: center; justify-content: space-between; }
  .kcard-amount { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 600; }
  .kcard-prob { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--mute); }

  /* The touch path for moving a deal. Existing tokens only — same hairline, same mono label
     treatment, same 8px radius as everything else on the card; nothing new is being introduced to
     the visual language. Both controls clear 44px so they can be hit with a thumb, and the label is
     visible rather than hidden, because a bare dropdown on a card of numbers reads as another
     figure. min-width:0 on the select stops a long stage name forcing the card wider than its
     column, which is the one way this row could push the page sideways. */
  .kmove { display: flex; align-items: center; gap: 6px; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--hair); flex-wrap: wrap; }
  .kmove-lab { font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
  .kmove select { flex: 1 1 90px; min-width: 0; min-height: 44px; font-family: 'Geist Mono', monospace; font-size: 12px; padding: 6px 8px; border: 1px solid var(--hair-strong); border-radius: 8px; background: var(--paper); color: var(--ink); }
  .kmove-go { min-height: 44px; padding: 6px 12px; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--ink); border-radius: 8px; background: var(--ink); color: var(--cream); cursor: pointer; }
  .kmove-go:hover { background: var(--burn); border-color: var(--burn); }
  .kmove select:focus-visible, .kmove-go:focus-visible { outline: 3px solid var(--burn); outline-offset: 2px; }

  /* Contacts table */
  .filters { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; flex-wrap: wrap; }
  .filters select, .filters input { font-family: 'Geist Mono', monospace; font-size: 12px; padding: 8px 12px; border: 1px solid var(--hair-strong); border-radius: 8px; background: var(--paper); color: var(--ink); }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 8px; cursor: pointer; border: 1px solid var(--ink); background: var(--ink); color: var(--cream); text-decoration: none; }
  .btn:hover { background: var(--burn); border-color: var(--burn); }
  .btn-ghost { background: transparent; color: var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: var(--cream); }
  .btn-sm { padding: 6px 10px; font-size: 10px; }

  /* THE SIX-COLUMN TABLE WAS BEING CLIPPED, NOT SCROLLED. `overflow: hidden` was here to make the
     14px radius cut the table corners, and it did — it also cut off everything past the viewport
     edge. Six columns of 18px-padded cells do not fit 360px, so on a phone LTV and Last contact
     simply were not reachable, and nothing on screen said they existed. Scrolling the box, not the
     page, is the fix: overflow-x on its own would compute overflow-y as `auto` and clip the sort
     dropdown, so the two axes are stated separately. -webkit-overflow-scrolling keeps the momentum
     flick that Android and iOS users expect from a sideways region. */
  .table-wrap { background: var(--paper); border: 1px solid var(--hair-strong); border-radius: 14px; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; }
  table.ct { width: 100%; border-collapse: collapse; min-width: 560px; }
  table.ct thead th { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); text-align: left; padding: 14px 18px; background: var(--cream); border-bottom: 1px solid var(--hair-strong); }
  table.ct thead a { color: var(--mute); text-decoration: none; }
  table.ct thead a:hover { color: var(--burn); }
  table.ct thead a.active { color: var(--ink); }
  table.ct tbody td { padding: 14px 18px; font-size: 15px; border-bottom: 1px solid var(--hair); vertical-align: middle; }
  table.ct tbody tr:last-child td { border-bottom: none; }
  table.ct tbody tr:hover { background: #FF4F0006; }
  .name-cell { font-weight: 600; font-family: 'Cormorant Garamond', serif; }
  .email-cell { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); }
  .tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .tag { font-family: 'Geist Mono', monospace; font-size: 9px; padding: 2px 7px; background: #b2542e1a; color: var(--rust); border-radius: 4px; letter-spacing: 0.04em; }

  .pill { display: inline-block; font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; font-weight: 600; }
  .pill-lead { background: #a3724b22; color: #6b4a30; }
  .pill-qual { background: #4b6da322; color: #2f4a73; }
  .pill-prop { background: #8b4ba322; color: #5e3273; }
  .pill-neg { background: #a36b4b22; color: #6e4630; }
  .pill-won { background: #4a7d4a22; color: #2d5a2d; }
  .pill-lost { background: #8a4a4a22; color: #6e2c2c; }

  .pager { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); }
  .pager a { color: var(--ink); text-decoration: none; padding: 6px 12px; border: 1px solid var(--hair-strong); border-radius: 6px; }
  .pager a:hover { background: var(--ink); color: var(--cream); }

  /* Split below */
  .split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 32px; margin-top: 56px; }
  .panel { background: var(--paper); border: 1px solid var(--hair-strong); border-radius: 14px; padding: 22px 26px; }
  .panel h3 { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 500; margin: 0 0 16px; }

  /* Timeline */
  .tl { list-style: none; padding: 0; margin: 0; }
  .tl li { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--hair); }
  .tl li:last-child { border-bottom: none; }
  .tl-icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--cream); border: 1px solid var(--hair-strong); display: flex; align-items: center; justify-content: center; }
  .tl-body { flex: 1; }
  .tl-meta { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--mute); margin-bottom: 4px; letter-spacing: 0.06em; text-transform: uppercase; }
  .tl-text { font-size: 14px; line-height: 1.4; }

  /* Tasks */
  .task { display: flex; justify-content: space-between; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--hair); gap: 12px; }
  .task:last-child { border-bottom: none; }
  .task-body { flex: 1; }
  .task-name { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--mute); margin-bottom: 4px; }
  .task-text { font-size: 14px; line-height: 1.35; }
  .task-due { font-family: 'Geist Mono', monospace; font-size: 10px; padding: 3px 7px; border-radius: 4px; font-weight: 600; white-space: nowrap; }
  .task-due.overdue { background: #8a4a4a22; color: #6e2c2c; }
  .task-due.soon { background: #a36b4b22; color: #6e4630; }
  .task-due.later { background: #4b6da322; color: #2f4a73; }

  /* Quick actions */
  .quick { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 16px; }
  .qbtn { padding: 12px 8px; background: var(--paper); border: 1px solid var(--hair-strong); border-radius: 8px; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--ink); }
  .qbtn:hover { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .qbtn svg { width: 18px; height: 18px; }

  /* Modal */
  .modal-bg { position: fixed; inset: 0; background: #0e0b08aa; display: none; align-items: center; justify-content: center; z-index: 100; padding: 24px; }
  .modal-bg.show { display: flex; }
  .modal { background: var(--paper); border-radius: 14px; max-width: 580px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 32px; border: 1px solid var(--hair-strong); }
  .modal h3 { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 500; margin: 0 0 6px; }
  .modal p.sub { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); margin: 0 0 24px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field.full { grid-column: span 2; }
  .field label { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
  .field input, .field select, .field textarea { padding: 10px 12px; border: 1px solid var(--hair-strong); border-radius: 8px; font-family: 'Geist Mono', monospace; font-size: 13px; background: var(--cream); color: var(--ink); }
  .field textarea { resize: vertical; min-height: 80px; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 22px; }

  /* Audit footer */
  .audit { margin-top: 56px; padding: 22px 26px; background: var(--paper); border: 1px solid var(--hair-strong); border-radius: 12px; display: flex; gap: 16px; align-items: center; }
  .audit svg { width: 26px; height: 26px; color: var(--burn); flex-shrink: 0; }
  .audit-text { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute); line-height: 1.6; }

  @media (max-width: 1100px) {
    .kanban { grid-template-columns: repeat(3, 1fr); }
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; }
    .quick { grid-template-columns: repeat(3, 1fr); }
    .hero h1 { font-size: 48px; }
    .form-grid { grid-template-columns: 1fr; }
    .field.full { grid-column: span 1; }
  }
</style>

<main class="crm-wrap">
  <section class="hero">
    <div class="eyebrow">Portal · CRM</div>
    <h1>Every conversation that <em>matters</em>.</h1>
    <p>In-house customer relationship system. Contacts, pipeline, deals, and activity — all stored on our own infrastructure with row-level encryption, full audit trail, and zero third-party processors.</p>
  </section>

  {okMsg && <div class="msg msg-ok">{okMsg}</div>}
  {errMsg && <div class="msg msg-err">{errMsg}</div>}

  {/* THE SCHEMA BOOT RESULT WAS COMPUTED AND NEVER SHOWN. `ensureCrmSchema()` returns
      { ok, error } precisely so this page can say the tables are not there — and the value was
      assigned to a const nothing rendered, so a CRM with no tables at all looked exactly like a CRM
      nobody had used yet. */}
  {!schemaBoot.ok && (
    <div class="msg msg-err">
      <strong>The CRM tables could not be provisioned, so nothing below is real.</strong>
      Every panel on this page will be empty, and that emptiness means "we could not ask", not "there
      is nothing". Do not re-enter contacts on the strength of it.
      {schemaBoot.error && <span style="display:block;margin-top:6px;font-family:'Geist Mono',monospace;font-size:11px;overflow-wrap:anywhere;">{clip(schemaBoot.error, 300)}</span>}
    </div>
  )}
  {schemaBoot.ok && readFailures.length > 0 && (
    <div class="msg msg-err">
      <strong>Part of this page could not be read, so what is blank below is unknown rather than empty.</strong>
      Not read: {readFailures.join('; ')}. Do not add a contact or a deal on the strength of an empty
      panel here — it may already exist.
      {firstReadError && <span style="display:block;margin-top:6px;font-family:'Geist Mono',monospace;font-size:11px;overflow-wrap:anywhere;">{clip(firstReadError, 300)}</span>}
    </div>
  )}

  {/* FOUR ZEROS ARE A CLAIM. When dealStats() did not answer, this strip printed 0 open deals, CHF 0
      of pipeline, 0 won and 0% conversion — the most confident possible statement of a fact nobody
      had. A figure that was not read shows a dash. */}
  <section class="stats-strip">
    <div class="stat">
      <div class="stat-lbl">Open deals</div>
      <div class="stat-val">{statsRead.ok ? stats.open_deals : '—'}</div>
      <div class="stat-sub">{statsRead.ok ? 'across pipeline' : 'not read'}</div>
    </div>
    <div class="stat">
      <div class="stat-lbl">Pipeline value</div>
      <div class="stat-val">{statsRead.ok ? fmtChf(stats.pipeline_value) : '—'}</div>
      <div class="stat-sub">{statsRead.ok ? 'weighted by stage' : 'not read'}</div>
    </div>
    <div class="stat">
      <div class="stat-lbl">Won this month</div>
      <div class="stat-val">{statsRead.ok ? stats.won_month : '—'}</div>
      <div class="stat-sub">{statsRead.ok ? 'closed deals' : 'not read'}</div>
    </div>
    <div class="stat">
      <div class="stat-lbl">Conversion rate</div>
      <div class="stat-val">{statsRead.ok ? conversionRate + '%' : '—'}</div>
      <div class="stat-sub">{statsRead.ok ? 'all-time won / total' : 'not read'}</div>
    </div>
  </section>

  {/* "DRAG DEALS BETWEEN COLUMNS" WAS THE ONLY WAY TO MOVE ONE, AND IT IS NOT A WAY ON A PHONE.
      The whole mechanism was HTML5 dragstart/dragover/drop, which mobile browsers do not fire from
      touch at all — no polyfill, no long-press fallback, nothing. So on the device most of these
      people are holding, the pipeline was a read-only picture and the instruction above it was an
      instruction to do something impossible. It also required a mouse AND scripting: with either
      missing, on any device, the stage could not be changed.

      Each card now carries a native select and a submit button posting the same move_deal_stage
      action the drag handler posts. The drag path is untouched and still works with a mouse. */}
  <div class="sec-head">
    <h2>Pipeline</h2>
    <div class="sec-sub">Drag a deal between columns, or use the stage picker on the card</div>
  </div>

  {/* SIX EMPTY COLUMNS ARE A PICTURE OF A PIPELINE WITH NOTHING IN IT. Said once, above the board,
      rather than six times inside it. */}
  {!dealsRead.ok && (
    <div class="msg msg-err">
      The deals could not be read, so the board below is empty for that reason and not because the
      pipeline is. Nothing here is a count of anything.
    </div>
  )}
  {dealsRead.ok && kanbanDeals.length === 0 && (
    <div class="msg" style="border:1px solid #1d160f22;color:#5d4a3a;">
      The board was read successfully and there are no deals on it yet. Add a contact, then create a
      deal against them.
    </div>
  )}

  <section class="kanban">
    {stages.map((s) => (
      <div class="kcol">
        <div class="kcol-head">
          <div class="kcol-title">
            <span class="kdot" style={`background: ${stageColors[s]}`}></span>
            <span>{s}</span>
          </div>
          {/* A zero on a column whose read failed is a claim; a dash is not. */}
          <div class="kcount">{dealsRead.ok ? dealsByStage[s].length : '—'}</div>
        </div>
        <div class="kbody" data-stage={s}>
          {dealsByStage[s].map((d) => (
            <div class="kcard" draggable="true" data-deal-id={d.id}>
              {/* Clipped for the card, complete in the title attribute. A kanban column is 1/6th of
                  the page and these three values are all free text somebody typed. */}
              <div class="kcard-name" title={String(d.contact_name || '')}>{d.contact_name ? clip(d.contact_name, 40) : 'No contact linked'}</div>
              <div class="kcard-co" title={String(d.contact_company || '')}>{d.contact_company ? clip(d.contact_company, 40) : ''}</div>
              <div class="kcard-title" title={String(d.title || '')}>{clip(d.title || 'Untitled deal', 80)}</div>
              <div class="kcard-foot">
                <span class="kcard-amount">{fmtChf(d.amount_chf)}</span>
                <span class="kcard-prob">{d.probability_pct || 0}%</span>
              </div>
              {/* The select is named for the deal, not "Stage" — there are as many of these on the
                  page as there are deals, and a screen reader reading six identical "Stage" combo
                  boxes tells somebody nothing about which one they are in. */}
              <form method="post" class="kmove" draggable="false">
                <input type="hidden" name="action" value="move_deal_stage" />
                <input type="hidden" name="deal_id" value={d.id} />
                <label class="kmove-lab" for={'kmv-' + d.id}>Stage</label>
                <select id={'kmv-' + d.id} name="new_stage" aria-label={'Stage for ' + (d.title || 'this deal')}>
                  {stages.map((opt) => (<option value={opt} selected={opt === s}>{opt}</option>))}
                </select>
                <button type="submit" class="kmove-go">Move</button>
              </form>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <div class="sec-head">
    <h2>Quick actions</h2>
    <div class="sec-sub">Log fast — keep the record fresh</div>
  </div>

  <div class="quick">
    <button type="button" class="qbtn" data-quick="call">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath('call')}/></svg>
      Log call
    </button>
    <button type="button" class="qbtn" data-quick="email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath('email')}/></svg>
      Log email
    </button>
    <button type="button" class="qbtn" data-quick="meeting">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath('meeting')}/></svg>
      Schedule meeting
    </button>
    <button type="button" class="qbtn" data-quick="note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath('note')}/></svg>
      Add note
    </button>
    <button type="button" class="qbtn" data-quick="task">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath('task')}/></svg>
      Create task
    </button>
  </div>

  <div class="sec-head">
    <h2>Contacts</h2>
    <button type="button" id="openContactBtn" class="btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
      Add contact
    </button>
  </div>

  <form method="get" class="filters">
    <select name="stage">
      <option value="">All stages</option>
      {stages.map((s) => (<option value={s} selected={s === stageFilter}>{s}</option>))}
    </select>
    <input type="text" name="tag" placeholder="Filter by tag…" value={tagFilter} />
    <input type="hidden" name="sort" value={sortKey} />
    <button class="btn btn-sm" type="submit">Apply</button>
    {(stageFilter || tagFilter) && <a class="btn btn-sm btn-ghost" href="/portal/crm">Clear</a>}
    <div style="margin-left:auto; font-family:'Geist Mono',monospace; font-size:11px; color: var(--mute);">{totalContacts} contacts</div>
  </form>

  <div class="table-wrap">
    <table class="ct">
      <thead>
        <tr>
          <th><a href={`?sort=name${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`} class={sortKey === 'name' ? 'active' : ''}>Name</a></th>
          <th><a href={`?sort=company${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`} class={sortKey === 'company' ? 'active' : ''}>Company</a></th>
          <th><a href={`?sort=stage${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`} class={sortKey === 'stage' ? 'active' : ''}>Stage</a></th>
          <th>Tags</th>
          <th><a href={`?sort=ltv${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`} class={sortKey === 'ltv' ? 'active' : ''}>LTV</a></th>
          <th><a href={`?sort=last_contacted${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`} class={sortKey === 'last_contacted' ? 'active' : ''}>Last contact</a></th>
        </tr>
      </thead>
      <tbody>
        {/* "No contacts yet. Click Add contact to begin." over a FAILED read is an invitation to
            re-enter a customer who is already on file, as a second row nobody will ever merge. */}
        {!contactsRead.ok && (
          <tr><td colspan="6" style="text-align:center; padding: 40px 18px; color: #b3261e; font-family: 'Geist Mono', monospace; font-size: 12px; line-height:1.7;">The contact table could not be read, so none is listed. This is NOT a statement that there are no contacts. Do not add one until this loads.</td></tr>
        )}
        {contactsRead.ok && contacts.length === 0 && (
          <tr><td colspan="6" style="text-align:center; padding: 40px 18px; color: var(--mute); font-family: 'Geist Mono', monospace; font-size: 12px; line-height:1.7;">{stageFilter || tagFilter ? 'No contact matches this filter. The table was read successfully.' : 'No contacts yet. This table was read successfully and is genuinely empty. Click "Add contact" to begin.'}</td></tr>
        )}
        {contacts.map((c) => {
          const tagList = parseTags(c.tags);
          return (
            <tr>
              <td>
                {/* Clipped for the cell, complete in the title attribute — a display cap, never a
                    data cap. A pasted 4,000-character value stretched the table past the page. */}
                <div class="name-cell" title={String(c.full_name || '')}>{clip(c.full_name || 'Unnamed contact', 60)}</div>
                <div class="email-cell" title={String(c.email || '')}>{clip(c.email || 'no email on file', 60)}</div>
              </td>
              <td>
                <div title={String(c.company || '')}>{c.company ? clip(c.company, 40) : '—'}</div>
                <div class="email-cell" title={String(c.role || '')}>{c.role ? clip(c.role, 40) : ''}</div>
              </td>
              <td><span class={stagePillClass(c.pipeline_stage)}>{c.pipeline_stage}</span></td>
              <td>
                <div class="tags">
                  {tagList.slice(0, 3).map((t: string) => (<span class="tag" title={t}>{clip(t, 24)}</span>))}
                  {tagList.length > 3 && (<span class="tag">+{tagList.length - 3}</span>)}
                </div>
              </td>
              <td style="font-family: 'Geist Mono', monospace; font-size: 12px;">{fmtChf(c.lifetime_value_chf)}</td>
              <td style="font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mute);">{timeAgo(c.last_contacted_at)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {/* Only paged when the count is a real one. A page count derived from a failed read is a number
      nobody measured, and "Page 1 of 1" over an unreadable table reads as a complete list. */}
  {contactsRead.ok && totalPages > 1 && (
    <div class="pager">
      <span>Page {page} of {totalPages} · {totalContacts} contact{totalContacts === 1 ? '' : 's'}</span>
      <div style="display:flex; gap: 8px;">
        {page > 1 && <a href={`?p=${page - 1}&sort=${sortKey}${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`}>Prev</a>}
        {page < totalPages && <a href={`?p=${page + 1}&sort=${sortKey}${stageFilter ? '&stage=' + stageFilter : ''}${tagFilter ? '&tag=' + tagFilter : ''}`}>Next</a>}
      </div>
    </div>
  )}

  <section class="split">
    <div class="panel">
      <h3>Activity timeline</h3>
      <ul class="tl">
        {!activitiesRead.ok && (<li><div class="tl-body"><div class="tl-text" style="color: #b3261e; font-family: 'Geist Mono', monospace; font-size: 12px; line-height:1.7;">The activity timeline could not be read, so none is shown. There may be activity; we could not fetch it.</div></div></li>)}
        {activitiesRead.ok && activities.length === 0 && (<li><div class="tl-body"><div class="tl-text" style="color: var(--mute); font-family: 'Geist Mono', monospace; font-size: 12px;">No activity yet. This timeline was read successfully and is genuinely empty — use quick actions above.</div></div></li>)}
        {activities.map((a) => (
          <li>
            <div class="tl-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={kindIconPath(a.kind)}/></svg>
            </div>
            <div class="tl-body">
              <div class="tl-meta">{a.kind} · {a.contact_name || 'unknown'} · {timeAgo(a.created_at)}</div>
              <div class="tl-text" title={String(a.summary || '')}>{clip(a.summary, 400)}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel">
      <h3>Tasks · next 7 days</h3>
      {/* "No upcoming tasks." over a failed read is the sentence that lets a due task be missed. */}
      {!tasksRead.ok && (<div style="color: #b3261e; font-family: 'Geist Mono', monospace; font-size: 12px; line-height:1.7;">The task panel could not be read, so none is listed. This is NOT a statement that nothing is due — check before you close the page.</div>)}
      {tasksRead.ok && tasks.length === 0 && (<div style="color: var(--mute); font-family: 'Geist Mono', monospace; font-size: 12px;">No task is due in the next seven days. This panel was read successfully.</div>)}
      {tasks.map((t) => {
        const due = t.due_at ? new Date(t.due_at).getTime() : 0;
        const now = Date.now();
        const diffMs = due - now;
        const cls = diffMs < 0 ? 'overdue' : (diffMs < 86400000 * 2 ? 'soon' : 'later');
        const lbl = diffMs < 0 ? 'OVERDUE' : (diffMs < 86400000 ? 'TODAY' : (diffMs < 86400000 * 2 ? 'TOMORROW' : fmtDate(t.due_at)));
        return (
          <div class="task">
            <div class="task-body">
              <div class="task-name">{t.contact_name || '—'}</div>
              <div class="task-text">{t.summary}</div>
            </div>
            <div class={`task-due ${cls}`}>{lbl}</div>
          </div>
        );
      })}
    </div>
  </section>

  <div class="audit">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <div class="audit-text">
      Every contact write, stage change, and deal mutation is appended to <strong>crm_activities</strong> with the acting user_id and timestamp. Data lives on our own database — no external processor sees customer information. Field-level encryption for phone and email columns is rotated quarterly.
    </div>
  </div>
</main>

<!-- Add Contact Modal -->
{/* Both panels were plain divs: no role, no aria-modal, no accessible name, focus left
    on the button behind the scrim, and Tab walked into the page underneath. Every label
    also floated free of its field, so a screen reader met eleven unnamed boxes. */}
<div class="modal-bg" id="contactModal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle" tabindex="-1">
    <h3 id="contactModalTitle">Add contact</h3>
    <p class="sub">Required: name and email. Everything else can be filled in later.</p>
    <form method="post">
      <input type="hidden" name="action" value="create_contact" />
      <div class="form-grid">
        <div class="field full"><label for="cmName">Full name (required)</label><input id="cmName" type="text" name="full_name" required maxlength="200" /></div>
        <div class="field"><label for="cmEmail">Email (required)</label><input id="cmEmail" type="email" name="email" required maxlength="200" /></div>
        <div class="field"><label for="cmPhone">Phone</label><input id="cmPhone" type="tel" name="phone" maxlength="40" /></div>
        <div class="field"><label for="cmCompany">Company</label><input id="cmCompany" type="text" name="company" maxlength="200" /></div>
        <div class="field"><label for="cmRole">Role</label><input id="cmRole" type="text" name="role" maxlength="120" /></div>
        <div class="field"><label for="cmLocation">Location</label><input id="cmLocation" type="text" name="location" maxlength="120" /></div>
        <div class="field">
          <label for="cmSource">Source</label>
          <select id="cmSource" name="source">
            <option value="manual">Added by hand</option>
            <option value="inbound-form">Inbound form</option>
            <option value="warm-intro">Warm introduction</option>
            <option value="event">Event</option>
            <option value="professional-network">Professional network</option>
          </select>
        </div>
        <div class="field">
          <label for="cmStage">Stage</label>
          <select id="cmStage" name="pipeline_stage">
            {stages.map((s) => (<option value={s}>{s}</option>))}
          </select>
        </div>
        <div class="field"><label for="cmLtv">Lifetime value (CHF)</label><input id="cmLtv" type="number" name="lifetime_value_chf" min="0" step="100" /></div>
        <div class="field"><label for="cmTags">Tags, separated by commas</label><input id="cmTags" type="text" name="tags" placeholder="vip, education, swiss" /></div>
        <div class="field full"><label for="cmNotes">Notes</label><textarea id="cmNotes" name="notes" rows="3"></textarea></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" data-close-modal>Cancel</button>
        <button type="submit" class="btn">Save contact</button>
      </div>
    </form>
  </div>
</div>

<!-- Quick activity modal -->
<div class="modal-bg" id="activityModal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="actTitle" tabindex="-1">
    <h3 id="actTitle">Log activity</h3>
    <p class="sub">Pick a contact, write what happened.</p>
    <form method="post">
      <input type="hidden" name="action" value="log_activity" />
      <input type="hidden" name="kind" id="actKind" value="note" />
      <div class="form-grid">
        <div class="field full">
          <label for="amContact">Contact (required)</label>
          <select id="amContact" name="contact_id" required>
            <option value="">Select a contact</option>
            {allContacts.map((c) => (<option value={c.id}>{clip(c.full_name || 'Unnamed contact', 60)}{c.company ? ' · ' + clip(c.company, 40) : ''}</option>))}
          </select>
          {/* An empty picker with no explanation reads as "there is nobody to log this against",
              which is a reason to give up on recording the call. */}
          {!contactOptionsRead.ok && (
            <p style="color:#b3261e;font-family:'Geist Mono',monospace;font-size:11px;line-height:1.7;margin:6px 0 0;">The contact list could not be read, so this picker is empty. There may be contacts; we could not fetch them.</p>
          )}
          {contactOptionsRead.ok && allContacts.length === 0 && (
            <p style="color:var(--mute);font-family:'Geist Mono',monospace;font-size:11px;line-height:1.7;margin:6px 0 0;">There are no contacts yet, so there is nothing to log an activity against. Add a contact first.</p>
          )}
        </div>
        <div class="field full"><label for="amSummary">Summary (required)</label><textarea id="amSummary" name="summary" rows="4" required></textarea></div>
        <div class="field full" id="dueWrap" style="display:none;"><label for="amDue">Due at</label><input id="amDue" type="datetime-local" name="due_at" /></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" data-close-modal>Cancel</button>
        <button type="submit" class="btn">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Hidden form for kanban drag -->
<form method="post" id="moveForm" style="display:none;">
  <input type="hidden" name="action" value="move_deal_stage" />
  <input type="hidden" name="deal_id" id="moveDealId" />
  <input type="hidden" name="new_stage" id="moveNewStage" />
</form>

<script is:inline>
(function(){
  // ------------------------------------------------------------------------
  // MODAL HELPERS. Declared before every handler that calls them.
  //
  // Opening a panel used to do one thing: add a class. Focus stayed on the button
  // behind the scrim, Tab walked into the page underneath, and closing dropped
  // focus on <body>. aria-modal="true" is now backed by inert on everything else,
  // Tab cycles inside the panel, and focus goes back where it came from.
  // ------------------------------------------------------------------------
  var lastFocus = null;

  function siblingsOf(el) {
    var out = [], kids = document.body.children;
    for (var i = 0; i < kids.length; i++) {
      if (kids[i] !== el && kids[i].tagName !== 'SCRIPT') out.push(kids[i]);
    }
    return out;
  }
  function setBehindInert(el, on) {
    var sibs = siblingsOf(el);
    for (var i = 0; i < sibs.length; i++) {
      if (on) { sibs[i].setAttribute('inert', ''); sibs[i].setAttribute('aria-hidden', 'true'); }
      else { sibs[i].removeAttribute('inert'); sibs[i].removeAttribute('aria-hidden'); }
    }
  }
  function stopsIn(panel) {
    var all = panel.querySelectorAll('input,select,textarea,button,a[href],[tabindex]:not([tabindex="-1"])');
    var out = [];
    for (var i = 0; i < all.length; i++) {
      if (!all[i].disabled && all[i].type !== 'hidden' && all[i].offsetParent !== null) out.push(all[i]);
    }
    return out;
  }
  function onModalKey(e) {
    var open = document.querySelector('.modal-bg.show');
    if (!open) return;
    if (e.key === 'Escape' || e.key === 'Esc') { e.preventDefault(); hideAll(); return; }
    if (e.key !== 'Tab') return;
    var panel = open.querySelector('.modal') || open;
    var stops = stopsIn(panel);
    if (!stops.length) return;
    var first = stops[0], last = stops[stops.length - 1], here = document.activeElement;
    if (!panel.contains(here)) { e.preventDefault(); (e.shiftKey ? last : first).focus(); return; }
    if (e.shiftKey && here === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && here === last) { e.preventDefault(); first.focus(); }
  }

  function show(id){
    var m = document.getElementById(id);
    if (!m) return;
    lastFocus = document.activeElement;
    m.classList.add('show');
    setBehindInert(m, true);
    document.addEventListener('keydown', onModalKey, true);
    var stops = stopsIn(m.querySelector('.modal') || m);
    try { if (stops.length) stops[0].focus(); } catch (err) {}
  }
  function hide(id){
    var m = document.getElementById(id);
    if (!m) return;
    m.classList.remove('show');
    setBehindInert(m, false);
    document.removeEventListener('keydown', onModalKey, true);
    try { if (lastFocus && lastFocus.focus) lastFocus.focus(); } catch (err) {}
    lastFocus = null;
  }
  function hideAll(){
    var open = document.querySelectorAll('.modal-bg.show');
    for (var i = 0; i < open.length; i++) hide(open[i].id);
  }

  var openBtn = document.getElementById('openContactBtn');
  if (openBtn) openBtn.addEventListener('click', function(){ show('contactModal'); });

  document.querySelectorAll('[data-close-modal]').forEach(function(b){
    b.addEventListener('click', function(){
      var p = b.closest('.modal-bg');
      if (p) hide(p.id);
    });
  });
  document.querySelectorAll('.modal-bg').forEach(function(bg){
    bg.addEventListener('click', function(e){
      if (e.target === bg) hide(bg.id);
    });
  });

  // Quick action buttons → open activity modal with kind preset
  var kindLabels = {
    call: 'Log a call',
    email: 'Log an email',
    meeting: 'Schedule a meeting',
    note: 'Add a note',
    task: 'Create a task',
  };
  document.querySelectorAll('[data-quick]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var k = btn.getAttribute('data-quick');
      document.getElementById('actKind').value = k;
      document.getElementById('actTitle').textContent = kindLabels[k] || 'Log activity';
      document.getElementById('dueWrap').style.display = (k === 'task' || k === 'meeting') ? '' : 'none';
      show('activityModal');
    });
  });

  // Kanban drag-and-drop
  var dragSrc = null;
  document.querySelectorAll('.kcard').forEach(function(card){
    card.addEventListener('dragstart', function(e){
      dragSrc = card;
      card.classList.add('dragging');
      try { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', card.getAttribute('data-deal-id')); } catch(_){}
    });
    card.addEventListener('dragend', function(){
      card.classList.remove('dragging');
      document.querySelectorAll('.kbody.drag-over').forEach(function(b){ b.classList.remove('drag-over'); });
    });
  });
  document.querySelectorAll('.kbody').forEach(function(col){
    col.addEventListener('dragover', function(e){
      e.preventDefault();
      try { e.dataTransfer.dropEffect = 'move'; } catch(_){}
      col.classList.add('drag-over');
    });
    col.addEventListener('dragleave', function(){
      col.classList.remove('drag-over');
    });
    col.addEventListener('drop', function(e){
      e.preventDefault();
      col.classList.remove('drag-over');
      if (!dragSrc) return;
      var dealId = dragSrc.getAttribute('data-deal-id');
      var newStage = col.getAttribute('data-stage');
      if (!dealId || !newStage) return;
      var prevCol = dragSrc.parentElement;
      if (prevCol === col) return;
      // Optimistic move
      col.appendChild(dragSrc);
      // Submit
      document.getElementById('moveDealId').value = dealId;
      document.getElementById('moveNewStage').value = newStage;
      document.getElementById('moveForm').submit();
    });
  });

  // Escape is handled by onModalKey while a panel is open, so focus is restored and the
  // page behind is un-inerted rather than merely re-shown.
})();
</script>
</BaseLayout>
