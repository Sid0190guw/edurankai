---
// Legacy registration-fee activation page — deprecated.
// Account creation is FREE. The application fee is the only paid step, and it
// is per-application (not per-account). Anyone hitting this URL gets bounced
// straight to /portal so the legacy "pay 1 CHF to activate" prompt cannot
// gate an applicant by accident.
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

// Belt-and-braces: any user who landed here while still on 'pending' gets
// promoted to 'approved' before being bounced to /portal.
try {
  await db.execute(sql`UPDATE users SET access_status = 'approved', updated_at = NOW() WHERE id = ${user.id} AND access_status = 'pending'`);
} catch (e: any) {
  // THE ONE THING THIS PAGE STILL DOES, AND IT WAS ALLOWED TO FAIL IN SILENCE. The redirect below
  // is unconditional, so somebody who landed here still on 'pending' was bounced to /portal looking
  // exactly like somebody who had just been approved — while access_status stayed 'pending' and
  // every gate that reads it kept refusing them. There is no screen anywhere that would show this,
  // and no second attempt: they have already been redirected. The reason goes to the log so the
  // person can be unblocked by hand instead of being told to "try again".
  console.error('[portal/activate] access_status promotion failed for user', user.id, '-', e?.cause?.message || e?.message);
}

return Astro.redirect('/portal');
---
