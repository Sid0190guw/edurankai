---
// /portal/mentors/[slug] — the mentor a learner clicked, and the booking request they can make.
//
// THIS ROUTE DID NOT EXIST. /portal/mentors/index.astro rendered every mentor card as
// <a href={'/portal/mentors/' + m.slug}>, so the moment a mentor row existed, every click on the
// marketplace 404'd. It never showed up because src/lib/mentors.ts had no reachable INSERT, so the
// grid was permanently empty and the broken link was never exercised.
//
// It reads a real mentor, writes a real mentor_sessions row, and says plainly what it does NOT do:
// no money moves here. A booking is a REQUEST until a human confirms it.
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMentor, bookSession, sessionsForLearner, rateSession, DURATIONS } from '@/lib/mentors';

const { slug } = Astro.params as { slug: string };
const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/mentors/' + slug));

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  // A write path never swallows its exception: a booking that silently did nothing is the defect
  // this whole pass exists to remove.
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');

  if (action === 'book') {
    const res = await bookSession({
      mentorId: String(fd.get('mentor_id') || ''),
      learnerUserId: user.id,
      learnerName: user.name || user.email || 'Learner',
      learnerEmail: user.email || null,
      scheduledAt: String(fd.get('scheduled_at') || ''),
      durationMinutes: Number(fd.get('duration') || 60),
      topic: String(fd.get('topic') || ''),
    });
    if (res.ok) okMsg = 'Your request has been sent. It is recorded as pending until the mentor confirms a time — nothing has been charged.';
    else errMsg = res.error;
  } else if (action === 'rate') {
    const res = await rateSession(
      String(fd.get('session_id') || ''),
      user.id,
      Number(fd.get('rating') || 0),
      String(fd.get('review') || ''),
    );
    if (res.ok) okMsg = 'Thank you — your rating has been recorded against that session.';
    else errMsg = res.error;
  }
}

const mentorRes = await getMentor(slug);
const sessionsRes = await sessionsForLearner(user.id);

// Three distinct outcomes, three distinct pages. "Could not be read" is never rendered as "not
// found", and neither is rendered as an empty booking form.
const readFailed = !mentorRes.ok;
const mentor = mentorRes.ok ? mentorRes.value : null;
const notFound = mentorRes.ok && mentor === null;

const mySessions = mentor && sessionsRes.ok
  ? sessionsRes.value.filter((s) => s.mentorId === mentor.id)
  : [];
const sessionsFailed = !sessionsRes.ok;

// The earliest slot the server will accept, so the picker cannot offer a time bookSession() refuses.
const minSlot = new Date(Date.now() + 65 * 60 * 1000).toISOString().slice(0, 16);

function fmt(d: string | null): string {
  if (!d) return 'No time set';
  try {
    return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch { return String(d); }
}
const STATUS_WORDS: Record<string, string> = {
  pending: 'Awaiting the mentor’s reply',
  scheduled: 'Confirmed',
  completed: 'Completed',
  cancelled: 'Cancelled',
  refunded: 'Refunded',
};
---
<BaseLayout title={(mentor ? mentor.fullName : 'Mentor') + ' · Mentor marketplace'} description="Request a one-to-one session with a verified subject mentor." noindex={true}>

<section class="px-[5vw] pt-12 pb-6 max-w-4xl mx-auto">
  <a href="/portal/mentors" class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-ink-soft no-underline">Back to the marketplace</a>

  {readFailed && (
    <div class="mt-6 bg-white border border-burn/30 rounded-2xl p-8">
      <p class="font-display text-[1.4rem] font-semibold text-ink mb-2">This mentor could not be loaded.</p>
      <p class="text-[0.95rem] text-ink-2 leading-relaxed">
        The marketplace database did not answer, so we cannot show you this profile or whether they are
        taking bookings. This is a fault on our side, not an empty page — please try again shortly.
      </p>
      <p class="font-mono text-[0.7rem] text-ink-soft mt-4">Reason recorded: {mentorRes.ok ? '' : mentorRes.reason}</p>
    </div>
  )}

  {notFound && (
    <div class="mt-6 bg-white border border-ink/10 rounded-2xl p-8">
      <p class="font-display text-[1.4rem] font-semibold text-ink mb-2">No mentor at this address.</p>
      <p class="text-[0.95rem] text-ink-2 leading-relaxed">
        There is no mentor with the web address <span class="font-mono text-[0.85rem]">{slug}</span>. They may
        have been withdrawn from the marketplace.
      </p>
      <a href="/portal/mentors" class="btn-primary inline-block mt-5">See who is available</a>
    </div>
  )}
</section>

{mentor && (
  <section class="px-[5vw] pb-16 max-w-4xl mx-auto">
    {okMsg && <div class="bg-leaf/10 border border-leaf/30 rounded-xl px-5 py-4 mb-6 text-[0.92rem] text-ink">{okMsg}</div>}
    {errMsg && <div class="bg-burn/8 border border-burn/30 rounded-xl px-5 py-4 mb-6 text-[0.92rem] text-ink">{errMsg}</div>}

    <div class="bg-white border border-ink/10 rounded-2xl p-7 mb-6">
      <div class="flex items-start gap-4 mb-5">
        <div class="w-16 h-16 rounded-full bg-burn-pale text-burn flex items-center justify-center font-display text-[1.6rem] font-semibold flex-shrink-0">
          {mentor.fullName.charAt(0).toUpperCase()}
        </div>
        <div class="min-w-0">
          <h1 class="font-display text-[1.9rem] font-semibold text-ink leading-tight">{mentor.fullName}</h1>
          <p class="text-[0.92rem] text-ink-soft mt-0.5">{mentor.title || 'Mentor'}</p>
          {mentor.verified && (
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-leaf font-bold mt-1">Verified mentor</p>
          )}
        </div>
      </div>

      {mentor.bio && <p class="text-[0.95rem] text-ink-2 leading-[1.8] mb-5">{mentor.bio}</p>}

      <div class="grid sm:grid-cols-3 gap-4 pt-5 border-t border-ink/8">
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-ink-soft">Rate</p>
          <p class="font-display text-[1.3rem] font-semibold text-burn">CHF {mentor.rate.toFixed(0)}<span class="text-[0.65rem] text-ink-soft font-normal"> per hour</span></p>
        </div>
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-ink-soft">Sessions completed</p>
          <p class="font-display text-[1.3rem] font-semibold text-ink">{mentor.sessionsCompleted}</p>
        </div>
        <div>
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-ink-soft">Rating</p>
          {/* Null, not zero. "Not rated yet" and "rated 0" are different facts. */}
          <p class="font-display text-[1.3rem] font-semibold text-ink">
            {mentor.ratingAvg == null
              ? <span class="text-[0.85rem] font-normal text-ink-soft">Not rated yet</span>
              : <span>{mentor.ratingAvg.toFixed(1)} <span class="text-[0.7rem] text-ink-soft font-normal">from {mentor.ratingCount}</span></span>}
          </p>
        </div>
      </div>

      {mentor.subjects.length > 0 && (
        <div class="flex gap-1.5 flex-wrap mt-5">
          {mentor.subjects.map((s) => <span class="font-mono text-[0.6rem] uppercase tracking-[0.06em] px-2.5 py-1 rounded-full bg-cream-2 text-ink-soft">{s.replace(/-/g, ' ')}</span>)}
        </div>
      )}
      {mentor.languages.length > 0 && (
        <p class="text-[0.82rem] text-ink-soft mt-3">Teaches in: {mentor.languages.map((l) => l.toUpperCase()).join(', ')}</p>
      )}
      {mentor.availability && (
        <p class="text-[0.88rem] text-ink-2 mt-3 leading-relaxed"><span class="font-semibold">Usually available:</span> {mentor.availability}</p>
      )}
    </div>

    {(mentor.isActive && mentor.verified) ? (
      <form method="POST" class="bg-white border border-ink/10 rounded-2xl p-7 mb-6">
        <input type="hidden" name="action" value="book" />
        <input type="hidden" name="mentor_id" value={mentor.id} />
        <h2 class="font-display text-[1.35rem] font-semibold text-ink mb-1">Request a session</h2>
        <p class="text-[0.88rem] text-ink-soft leading-relaxed mb-5">
          This sends a request. Nothing is charged now and no time is held — the mentor confirms a slot and
          adds a meeting link, and only then does the session count as booked.
        </p>

        <label class="block mb-4">
          <span class="block font-mono text-[0.62rem] uppercase tracking-[0.14em] text-ink-soft mb-1.5">Date and time</span>
          <input type="datetime-local" name="scheduled_at" min={minSlot} required
            class="w-full bg-cream-2/50 border border-ink/15 rounded-xl px-4 py-2.5 text-[0.92rem]" />
        </label>

        <label class="block mb-4">
          <span class="block font-mono text-[0.62rem] uppercase tracking-[0.14em] text-ink-soft mb-1.5">Length</span>
          <select name="duration" class="w-full bg-cream-2/50 border border-ink/15 rounded-xl px-4 py-2.5 text-[0.92rem]">
            {DURATIONS.map((d) => (
              <option value={d} selected={d === 60}>{d} minutes — CHF {(mentor.rate * (d / 60)).toFixed(2)}</option>
            ))}
          </select>
        </label>

        <label class="block mb-5">
          <span class="block font-mono text-[0.62rem] uppercase tracking-[0.14em] text-ink-soft mb-1.5">What do you want to work on?</span>
          <textarea name="topic" rows="4" required minlength="10"
            placeholder="Be specific — the mentor decides whether to accept from this."
            class="w-full bg-cream-2/50 border border-ink/15 rounded-xl px-4 py-2.5 text-[0.92rem] leading-relaxed"></textarea>
        </label>

        <button type="submit" class="btn-primary">Send the request</button>
      </form>
    ) : (
      <div class="bg-cream-2/60 border border-ink/10 rounded-2xl p-7 mb-6">
        <p class="font-display text-[1.2rem] font-semibold text-ink mb-2">Not taking bookings at the moment.</p>
        <p class="text-[0.92rem] text-ink-2 leading-relaxed">
          {mentor.verified
            ? 'This mentor has paused new sessions. Their profile stays here so any session you already have with them still resolves.'
            : 'This mentor has not completed verification yet, so they cannot accept sessions through the marketplace.'}
        </p>
      </div>
    )}

    <div class="bg-white border border-ink/10 rounded-2xl p-7">
      <h2 class="font-display text-[1.35rem] font-semibold text-ink mb-4">Your sessions with {mentor.fullName}</h2>

      {sessionsFailed ? (
        <p class="text-[0.92rem] text-ink-2 leading-relaxed">
          Your booking history could not be read, so this list is not a statement that you have none.
          <span class="font-mono text-[0.75rem] text-ink-soft block mt-1">Reason recorded: {sessionsRes.ok ? '' : sessionsRes.reason}</span>
        </p>
      ) : mySessions.length === 0 ? (
        <p class="text-[0.92rem] text-ink-soft">You have not requested a session with this mentor yet.</p>
      ) : (
        <div class="flex flex-col gap-3">
          {mySessions.map((s) => (
            <div class="border border-ink/10 rounded-xl p-4">
              <div class="flex justify-between items-start gap-3 flex-wrap">
                <div>
                  <p class="font-display text-[1.05rem] text-ink font-semibold">{fmt(s.scheduledAt)}</p>
                  <p class="text-[0.82rem] text-ink-soft">{s.durationMinutes} minutes · {STATUS_WORDS[s.status] || s.status}</p>
                </div>
                <p class="font-mono text-[0.8rem] text-ink-2">{s.currency} {(s.amountMinor / 100).toFixed(2)}</p>
              </div>
              {s.topic && <p class="text-[0.88rem] text-ink-2 mt-2 leading-relaxed">{s.topic}</p>}
              {s.status === 'scheduled' && s.meetLink && (
                <a href={s.meetLink} class="inline-block mt-3 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-burn">Join the session</a>
              )}
              {s.status === 'scheduled' && !s.meetLink && (
                <p class="text-[0.82rem] text-ink-soft mt-2">Confirmed, but no meeting link has been recorded yet.</p>
              )}
              {s.status === 'completed' && s.learnerRating == null && (
                <form method="POST" class="mt-3 pt-3 border-t border-ink/8">
                  <input type="hidden" name="action" value="rate" />
                  <input type="hidden" name="session_id" value={s.id} />
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Rate this session</p>
                  <div class="flex gap-2 flex-wrap items-center">
                    <select name="rating" class="bg-cream-2/50 border border-ink/15 rounded-lg px-3 py-2 text-[0.88rem]">
                      <option value="5">5 — outstanding</option>
                      <option value="4">4 — good</option>
                      <option value="3">3 — fair</option>
                      <option value="2">2 — poor</option>
                      <option value="1">1 — bad</option>
                    </select>
                    <input type="text" name="review" maxlength="2000" placeholder="Optional note"
                      class="flex-1 min-w-[180px] bg-cream-2/50 border border-ink/15 rounded-lg px-3 py-2 text-[0.88rem]" />
                    <button type="submit" class="bg-ink text-cream px-4 py-2 rounded-lg text-[0.82rem] font-semibold">Submit</button>
                  </div>
                </form>
              )}
              {s.learnerRating != null && (
                <p class="text-[0.82rem] text-ink-soft mt-2">You rated this session {s.learnerRating} out of 5.</p>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
)}
</BaseLayout>
