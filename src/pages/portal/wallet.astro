---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { getCreditBalance, getCreditLedger } from '@/lib/account-credit';
import { walletAmounts, currencyFor } from '@/lib/local-currency';
import { isConfigured } from '@/lib/razorpay';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/wallet'));
if (user.role !== 'applicant') return Astro.redirect('/admin');

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// Recovery of "paid but unapplied" orders now runs in the BACKGROUND after load
// (see script below) so the Razorpay API never blocks this page's render.

let country = 'India';
try { country = (rows(await db.execute(sql`SELECT country FROM users WHERE id = ${user.id} LIMIT 1`))[0]?.country) || 'India'; } catch (_) {}

const balancePaise = await getCreditBalance(user.id).catch(() => 0);
const w = await walletAmounts(balancePaise, country);
const cur = currencyFor(country);
const ledger = await getCreditLedger(user.id, 50).catch(() => []);
const paymentsReady = isConfigured();
const QUICK = [100, 500, 1000, 2000];

function fmt(d: any) { try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch { return '-'; } }
function signed(paise: any) {
  const n = (Number(paise) || 0) / 100;
  const s = n < 0 ? '-' : '+';
  return s + '₹' + Math.abs(n).toLocaleString('en-IN', { maximumFractionDigits: 2 });
}
---
<BaseLayout title="Your wallet - EduRankAI" description="Your EduRankAI account credit." noindex={true}>
  <section class="px-[5vw] py-10 md:py-14 max-w-2xl mx-auto">
    <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-3">Account credit</p>
    <h1 class="font-display text-[clamp(1.7rem,4vw,2.4rem)] font-semibold text-ink leading-tight tracking-tight mb-2">Your wallet.</h1>
    <p class="text-[0.9rem] text-ink-soft leading-relaxed mb-7">Credit on your account - including any payment that went through but didn't finish - usable for <strong>any</strong> EduRankAI fee or product. Balance is held in our base currency and shown in yours at today's live rate.</p>

    <!-- Balance card -->
    <div class="rounded-2xl p-6 mb-6 text-white" style="background:linear-gradient(135deg,#100b08,#2a1a12);">
      <p class="text-[0.66rem] font-mono uppercase tracking-[0.16em] text-white/55 mb-2">Available balance</p>
      <p class="font-display text-[2.6rem] font-semibold leading-none">{w.baseLabel}</p>
      <div class="flex items-center gap-3 mt-3 flex-wrap text-[0.86rem] text-white/75">
        {cur.code !== w.baseCode && <span>= <strong class="text-white">{w.localLabel}</strong> <span class="text-white/50">({cur.name})</span></span>}
        {cur.code !== 'INR' && <span class="text-white/45">· ₹{w.inr.toLocaleString('en-IN', { maximumFractionDigits: 2 })} held</span>}
      </div>
      <p class="text-[0.72rem] text-white/45 mt-4">{w.baseCode} is our base currency. {cur.code === 'INR' ? 'Held and settled in INR.' : 'Converted from INR at the live ECB rate; the actual charge is always in INR via Razorpay.'}</p>
    </div>

    <!-- Add money -->
    {paymentsReady && (
      <div class="bg-white border border-ink/10 rounded-2xl p-5 mb-6">
        <p class="text-[0.66rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-2">Add money</p>
        <p class="text-[0.84rem] text-ink-soft mb-3">Top up your wallet. Credit is usable for <strong>any</strong> EduRankAI fee or product, and is refundable.</p>
        <div class="flex gap-2 flex-wrap mb-3">
          {QUICK.map((a) => (
            <button type="button" class="wal-chip" data-amt={a}>&#8377;{a.toLocaleString('en-IN')}</button>
          ))}
        </div>
        <div class="flex gap-2 items-stretch">
          <div class="flex items-center border border-ink/15 rounded-lg px-3 flex-1 bg-white focus-within:border-burn">
            <span class="text-ink-soft">&#8377;</span>
            <input id="walAmt" type="number" min="10" inputmode="numeric" placeholder="Amount" class="flex-1 px-2 py-2.5 outline-none bg-transparent text-[0.95rem]" />
          </div>
          <button id="walAddBtn" type="button" class="bg-burn hover:bg-burn/90 text-white font-semibold px-5 rounded-lg text-[0.9rem] whitespace-nowrap">Add money</button>
        </div>
        <p id="walMsg" class="text-[0.8rem] mt-2 min-h-[1.1em] text-ink-soft"></p>
      </div>
    )}

    {balancePaise <= 0 && (
      <div class="bg-cream-2 border border-ink/10 rounded-xl p-5 mb-6 text-[0.86rem] text-ink-soft leading-relaxed">
        If you paid a fee but your application didn't go through, it appears here automatically once we reconcile the payment - this page checks every time you open it. Questions? <a href="mailto:hr@edurankai.in" class="text-burn font-semibold">hr@edurankai.in</a>
      </div>
    )}

    <!-- Ledger -->
    <h2 class="font-display text-[1.1rem] font-semibold text-ink mb-3">Activity</h2>
    {ledger.length === 0 ? (
      <p class="text-[0.86rem] text-ink-soft">No wallet activity yet.</p>
    ) : (
      <div class="bg-white border border-ink/10 rounded-2xl overflow-hidden">
        {ledger.map((l: any, i: number) => (
          <div class={'flex items-center justify-between gap-4 px-5 py-3.5' + (i > 0 ? ' border-t border-ink/6' : '')}>
            <div class="min-w-0">
              <p class="text-[0.88rem] font-medium text-ink truncate">{l.reason || (Number(l.delta_paise) < 0 ? 'Spent on a fee' : 'Credit added')}</p>
              <p class="text-[0.72rem] text-ink-soft font-mono">{fmt(l.created_at)}</p>
            </div>
            <span class={'text-[0.92rem] font-bold whitespace-nowrap ' + (Number(l.delta_paise) < 0 ? 'text-ink-soft' : 'text-leaf')}>{signed(l.delta_paise)}</span>
          </div>
        ))}
      </div>
    )}

    <div class="flex items-center justify-between flex-wrap gap-3 mt-7">
      <a href="/portal" class="text-[0.84rem] text-ink-soft hover:text-ink underline underline-offset-2">Back to portal</a>
      <a href="/portal/profile" class="text-[0.84rem] text-burn hover:underline">Your profile &rarr;</a>
    </div>
  </section>

  {paymentsReady && (
    <>
      <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
      <script is:inline define:vars={{ uName: user.name || '', uEmail: user.email || '' }}>
        (function () {
          var amt = document.getElementById('walAmt');
          var btn = document.getElementById('walAddBtn');
          var msg = document.getElementById('walMsg');
          if (!btn) return;
          document.querySelectorAll('.wal-chip').forEach(function (c) {
            c.addEventListener('click', function () { amt.value = c.getAttribute('data-amt'); amt.focus(); });
          });
          btn.addEventListener('click', function () {
            var v = Math.round(Number(amt.value) || 0);
            if (v < 10) { msg.textContent = 'Enter at least Rs 10.'; return; }
            btn.disabled = true; msg.textContent = 'Starting...';
            fetch('/api/payments/wallet-recharge', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ amountInr: v }) })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (!d.ok) { btn.disabled = false; msg.textContent = d.error || 'Could not start.'; return; }
                var rzp = new Razorpay({
                  key: d.keyId, amount: d.amountPaise, currency: d.currency, order_id: d.orderId,
                  name: 'EduRankAI', description: 'Wallet top-up', prefill: { name: uName, email: uEmail }, theme: { color: '#FF4F00' },
                  handler: function (resp) {
                    msg.textContent = 'Confirming...';
                    // THE ANSWER IS READ BEFORE ANYTHING IS CLAIMED.
                    //
                    // This used to be `.then(function () { msg.textContent = 'Added to your wallet.' ... })`
                    // — the parsed body was discarded and the sentence printed unconditionally. So a
                    // signature mismatch (verify.ts returns { ok:false } with HTTP 400) and a payment
                    // Razorpay never captured (verify.ts returns { ok:true, status:'attempted' } and
                    // credits NOTHING) both told the person their money had landed. They then reloaded
                    // onto an unchanged balance with no error anywhere and no idea whether to pay again.
                    //
                    // Money added is exactly one of the outcomes: ok AND status 'paid'. Everything else
                    // says what actually happened and leaves the balance on screen alone.
                    fetch('/api/payments/verify', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ razorpay_order_id: resp.razorpay_order_id, razorpay_payment_id: resp.razorpay_payment_id, razorpay_signature: resp.razorpay_signature }) })
                      .then(function (r) { return r.json().catch(function () { return null; }); })
                      .then(function (d) {
                        if (d && d.ok && d.status === 'paid') {
                          msg.textContent = 'Added to your wallet. Updating...';
                          setTimeout(function () { location.reload(); }, 1000);
                          return;
                        }
                        // Captured but not yet credited, or refused outright. Neither is "added", and
                        // neither is silence: the payment reference is the one thing support can act on.
                        btn.disabled = false;
                        msg.textContent = d && d.ok
                          ? 'Payment received but not credited yet. It settles on its own within a few minutes — reload this page. Quote ' + (resp.razorpay_payment_id || 'your payment id') + ' if it does not.'
                          : 'We could not confirm that payment, so nothing has been added. No money is lost. Reload in a moment, and quote ' + (resp.razorpay_payment_id || 'your payment id') + ' to hr@edurankai.in if it stays this way.';
                      })
                      // A network failure after the charge is the one case where the page genuinely does
                      // not know. It used to reload in silence, which reads as "nothing happened".
                      .catch(function () {
                        btn.disabled = false;
                        msg.textContent = 'We could not reach us to confirm that payment. Do not pay again — reload this page in a moment, and the recovery check below will pick it up.';
                      });
                  },
                });
                rzp.open(); btn.disabled = false; msg.textContent = 'Complete the payment in the popup.';
              })
              .catch(function () { btn.disabled = false; msg.textContent = 'Network error - try again.'; });
          });
        })();
      </script>
    </>
  )}

  <style>
    .wal-chip { font-size: 0.84rem; font-weight: 600; color: #2b2620; background: #f2ece4; border: 1px solid rgba(14,11,8,0.1); border-radius: 100px; padding: 6px 14px; cursor: pointer; }
    .wal-chip:hover { border-color: #FF4F00; color: #FF4F00; }
  </style>

  <script is:inline>
    // Background recovery of paid-but-unapplied orders — never blocks render.
    window.addEventListener('load', function () {
      setTimeout(function () {
        fetch('/api/portal/reconcile-self', { method: 'POST', credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) { if (d && d.ok && d.n > 0) location.reload(); })
          .catch(function () {});
      }, 1500);
    });
  </script>
</BaseLayout>
