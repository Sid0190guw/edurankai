---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { users } from '@/lib/db/schema';
import { eq, sql } from 'drizzle-orm';
import { generateSessionToken, createSession } from '@/lib/auth/session';
import { setSessionCookie } from '@/lib/auth/cookie';
import { findUserByLoginIdentifier, verifyPasswordForLogin } from '@/lib/auth/handle';
import {
  isSecondStepRequired, availableSecondFactors, startPendingChallenge,
  resolvePendingChallenge, verifySecondFactor, dropPendingChallenge,
  pendingCookieName, verifyFaceSecondFactor, canCompleteSecondStep,
  countAttempt, clearAttempts,
  PENDING_TTL_SECONDS, PENDING_COOKIE_SECURE,
  type SecondFactorMethod,
} from '@/lib/auth/two-factor';

if (Astro.locals.user) {
  return Astro.redirect('/portal');
}

// Declared before the handler that uses them - `const` is not hoisted.
const SURFACE = 'portal' as const;
const PENDING_COOKIE = pendingCookieName(SURFACE);
const LEGACY_FACE_COOKIE = 'portal_face_pending';
const LEGACY_TFA_COOKIE = 'portal_tfa_pending';
// Shared-state ceilings for the two unauthenticated face-only steps below. Declared
// here, above the handler that reads them — `const` is not hoisted.
const FACE_FIRST_BUCKET = 'face-login:user:';
const FACE_LOOKUP_BUCKET = 'face-login:ip:';
const FACE_WINDOW_SECONDS = 900;
const FACE_MAX_ATTEMPTS = 8;
const FACE_LOOKUP_MAX = 20;

function setPendingCookie(cookies: any, token: string) {
  cookies.set(PENDING_COOKIE, token, {
    path: '/', httpOnly: true, sameSite: 'lax', secure: PENDING_COOKIE_SECURE, maxAge: PENDING_TTL_SECONDS,
  });
}
function clearPendingCookies(cookies: any) {
  cookies.delete(PENDING_COOKIE, { path: '/' });
  cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
  cookies.delete(LEGACY_TFA_COOKIE, { path: '/' });
}
async function startSession(userId: string, req: Request, ip: string | undefined, cookies: any) {
  const token = generateSessionToken();
  const session = await createSession(token, userId, {
    userAgent: req.headers.get('user-agent') || undefined,
    ipAddress: ip,
  });
  setSessionCookie(cookies, token, session.expiresAt);
}
async function destinationFor(userId: string): Promise<string> {
  const r = await db.select({ role: users.role }).from(users).where(eq(users.id, userId)).limit(1);
  return r[0]?.role === 'applicant' ? '/portal' : '/admin';
}

let errorMsg = '';
let noticeMsg = '';
let requireSecondStep = false;
let requireFaceFirstFactor = false;
let pendingUserName = '';
let offerFace = false;
let offerCode = false;

// Face-only sign-in (a FIRST factor under the any-one-method model) still needs
// a named account to scan against. That name lives in its own cookie and grants
// nothing on its own - the match itself still happens server-side.
let faceFirstUserId = Astro.cookies.get(LEGACY_FACE_COOKIE)?.value || '';
// The half-finished sign-in, named by an opaque server-minted token.
let pendingToken = Astro.cookies.get(PENDING_COOKIE)?.value || '';

if (Astro.request.method === 'POST') {
  const fd2 = await Astro.request.formData();
  const action = fd2.get('action') as string;

  if (action === 'second_factor') {
    const method = ((fd2.get('method') as string) || 'totp') as SecondFactorMethod;
    const payload = method === 'face'
      ? ((fd2.get('live_descriptor') as string) || '')
      : ((fd2.get('code') as string) || '').trim();
    try {
      if (method === 'face') {
        const peek = await resolvePendingChallenge(pendingToken, SURFACE);
        if (peek) {
          const r = await verifyFaceSecondFactor(peek.userId, payload);
          await db.execute(sql`
            INSERT INTO identity_verifications (user_id, email, claimed_name, method, face_match_distance, face_match_passed, verdict, ip_address, user_agent)
            VALUES (${peek.userId}, ${''}, ${''}, 'face_login', ${Number.isFinite(r.distance) ? r.distance : null}, ${r.matched}, ${r.matched ? 'verified' : 'rejected'}, ${(Astro.clientAddress || '').toString().slice(0, 64) || null}, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500)})
          `).catch(() => {});
        }
      }
      const result = await verifySecondFactor(pendingToken, SURFACE, method, payload);
      if (!result.ok) {
        errorMsg = result.error;
        if (result.locked) { clearPendingCookies(Astro.cookies); pendingToken = ''; }
      } else {
        if (method === 'face') {
          await db.execute(sql`UPDATE user_face_enrollments SET last_used_at = NOW() WHERE user_id = ${result.userId}`).catch(() => {});
        }
        const dest = await destinationFor(result.userId);
        await startSession(result.userId, Astro.request, Astro.clientAddress, Astro.cookies);
        await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, result.userId)).catch(() => {});
        clearPendingCookies(Astro.cookies);
        return Astro.redirect(dest);
      }
    } catch (e: any) {
      // Never swallowed. A silent catch here once hid a total sign-in outage.
      console.error('[portal/login second_factor]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Verification is temporarily unavailable. Please try again.';
    }
  } else if (action === 'cancel_second_step') {
    await dropPendingChallenge(pendingToken).catch(() => {});
    clearPendingCookies(Astro.cookies);
    return Astro.redirect('/portal/login');
  } else if (action === 'face_verified') {
    // Face used as the FIRST factor (face-only sign-in).
    const liveRaw = (fd2.get('live_descriptor') as string) || '';
    try {
      const found = faceFirstUserId
        ? await db.select().from(users).where(eq(users.id, faceFirstUserId)).limit(1)
        : [];
      const u = found[0];
      if (!u || !u.isActive) {
        errorMsg = 'Session expired. Please start again.';
        clearPendingCookies(Astro.cookies);
        faceFirstUserId = '';
      } else if (await countAttempt(FACE_FIRST_BUCKET + u.id, FACE_WINDOW_SECONDS) > FACE_MAX_ATTEMPTS) {
        // THE ONE FACE PATH THAT COULD BE GUESSED AT WITHOUT LIMIT.
        //
        // This branch signs somebody in on a face alone, and it answers matched /
        // not matched to anyone who can post a 128-number descriptor — no password
        // needed and, until this counter, no ceiling either. That is a machine for
        // walking a descriptor towards somebody's enrolled template one probe at a
        // time, from any number of lambdas, for as long as it takes. The pending
        // second-step path has been counted in shared Postgres state from the
        // start; this one was not.
        //
        // The password form is deliberately left working while this cools off, so
        // a jammed face gate never means a person cannot sign in at all.
        Astro.cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
        faceFirstUserId = '';
        errorMsg = 'Too many face attempts. Please wait 15 minutes, or sign in with your password now.';
      } else {
        const r = await verifyFaceSecondFactor(u.id, liveRaw);
        await db.execute(sql`
          INSERT INTO identity_verifications (user_id, email, claimed_name, method, face_match_distance, face_match_passed, verdict, ip_address, user_agent)
          VALUES (${u.id}, ${u.email || ''}, ${u.name || ''}, 'face_login', ${Number.isFinite(r.distance) ? r.distance : null}, ${r.matched}, ${r.matched ? 'verified' : 'rejected'}, ${(Astro.clientAddress || '').toString().slice(0, 64) || null}, ${(Astro.request.headers.get('user-agent') || '').slice(0, 500)})
        `).catch(() => {});
        if (!r.matched) {
          errorMsg = 'Face not recognised. Try again in better light, or use your password.';
        } else {
          await clearAttempts(FACE_FIRST_BUCKET + u.id);
          await db.execute(sql`UPDATE user_face_enrollments SET last_used_at = NOW() WHERE user_id = ${u.id}`).catch(() => {});
          // Face was only the FIRST factor. If this account opted in to a second
          // step it still owes one, and the remaining factor must not be face.
          const methods = await availableSecondFactors(u.id);
          const optedIn = await isSecondStepRequired(u.id);
          if (optedIn && methods.indexOf('totp') < 0) {
            errorMsg = 'This account requires a second step, but no authenticator is set up. Sign in with your password and a recovery code.';
          } else if (optedIn) {
            const t = await startPendingChallenge(u.id, SURFACE, 'face');
            Astro.cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
            setPendingCookie(Astro.cookies, t);
            return Astro.redirect('/portal/login');
          } else {
            const dest = await destinationFor(u.id);
            await startSession(u.id, Astro.request, Astro.clientAddress, Astro.cookies);
            await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, u.id)).catch(() => {});
            clearPendingCookies(Astro.cookies);
            return Astro.redirect(dest);
          }
        }
      }
    } catch (e: any) {
      console.error('[portal/login face_verified]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
    }
  } else if (action === 'cancel_face') {
    clearPendingCookies(Astro.cookies);
    return Astro.redirect('/portal/login');
  } else if (action === 'face_only_init') {
    const identifier = (fd2.get('email') as string || '').trim();
    try {
      // THIS STEP IS AN EXISTENCE ORACLE AND CANNOT FULLY STOP BEING ONE.
      //
      // Face-only sign-in has to name an account before it can scan against it, so
      // "camera opens" and "one flat refusal" are observably different answers and
      // that difference says whether a handle exists with a face on it. The message
      // is already identical for every failure; what was missing was a ceiling, so
      // the difference could be read off thousands of handles from one script. This
      // counts every attempt from a source address in shared Postgres state, which
      // makes bulk enumeration expensive without ever blocking the password form.
      const ipKey = (Astro.clientAddress || Astro.request.headers.get('x-forwarded-for') || 'unknown')
        .toString().split(',')[0].trim().slice(0, 64);
      const throttled = await countAttempt(FACE_LOOKUP_BUCKET + ipKey, FACE_WINDOW_SECONDS) > FACE_LOOKUP_MAX;
      const u = throttled ? null : await findUserByLoginIdentifier(identifier);
      const hasFace = (u && u.isActive)
        ? (await availableSecondFactors(u.id)).indexOf('face') >= 0
        : false;
      if (throttled) {
        errorMsg = 'Too many attempts from this connection. Please wait 15 minutes, or sign in with your password now.';
      } else if (u && u.isActive && hasFace) {
        Astro.cookies.set(LEGACY_FACE_COOKIE, u.id, {
          path: '/', httpOnly: true, sameSite: 'lax', secure: PENDING_COOKIE_SECURE, maxAge: PENDING_TTL_SECONDS,
        });
        return Astro.redirect('/portal/login');
      } else {
        // One message for every failure. Separate "Account not found" and "no face
        // enrolled" replies told an attacker which handles exist.
        errorMsg = 'Face sign-in is not available for that account. Please use your password.';
      }
    } catch (e: any) {
      console.error('[portal/login face_only_init]', e?.cause?.message || e?.message, e?.stack);
      errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
    }
  } else {
    // Password sign-in. Accepts a personal email OR an internal handle.
    const loginMethod = (fd2.get('login_method') as string || 'email').trim();
    if (loginMethod !== 'email') {
      errorMsg = 'This sign-in method is no longer supported. Please use your email or handle and password.';
    } else {
      const identifier = (fd2.get('email') as string || '').trim();
      const password = fd2.get('password') as string || '';
      if (!identifier || !password) {
        errorMsg = 'Enter your email or internal handle, and your password.';
      } else {
        try {
          const u = await findUserByLoginIdentifier(identifier);
          // scrypt runs either way, so an unknown handle and a wrong password
          // cost the same and answer the same.
          const ok = await verifyPasswordForLogin(u, password);
          if (!ok || !u || !u.isActive) {
            errorMsg = 'Invalid email or password.';
          } else {
            const methods = await availableSecondFactors(u.id);
            const optedIn = await isSecondStepRequired(u.id);
            const isApplicant = u.role === 'applicant';
            // Pre-existing posture: staff with a face on file were challenged.
            const legacyFaceRule = !isApplicant && methods.indexOf('face') >= 0;
            // A remaining recovery code is a completable second step too, so an
            // account whose enrolled factor was cleared is still challenged rather
            // than waved through on the password alone. False only when nothing is
            // left at all — the one case where challenging would be a lockout.
            if ((optedIn || legacyFaceRule) && await canCompleteSecondStep(u.id)) {
              const t = await startPendingChallenge(u.id, SURFACE, 'password');
              setPendingCookie(Astro.cookies, t);
              return Astro.redirect('/portal/login');
            }
            await startSession(u.id, Astro.request, Astro.clientAddress, Astro.cookies);
            await db.update(users).set({ lastLoginAt: new Date(), updatedAt: new Date() }).where(eq(users.id, u.id)).catch(() => {});
            clearPendingCookies(Astro.cookies);
            return Astro.redirect(isApplicant ? '/portal' : '/admin');
          }
        } catch (e: any) {
          console.error('[portal/login password]', e?.cause?.message || e?.message, e?.stack);
          errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
        }
      }
    }
  }
}

// Render whichever step is live.
if (pendingToken) {
  try {
    const pending = await resolvePendingChallenge(pendingToken, SURFACE);
    if (pending) {
      requireSecondStep = true;
      const u = await db.select({ name: users.name }).from(users).where(eq(users.id, pending.userId)).limit(1);
      pendingUserName = u[0]?.name || '';
      const methods = await availableSecondFactors(pending.userId);
      // If face was the first factor it cannot also be the second.
      offerFace = methods.indexOf('face') >= 0 && pending.firstFactor !== 'face';
      offerCode = methods.indexOf('totp') >= 0;
    } else {
      clearPendingCookies(Astro.cookies);
      pendingToken = '';
      if (!errorMsg) noticeMsg = 'That sign-in step expired. Please sign in again.';
    }
  } catch (e: any) {
    console.error('[portal/login pending]', e?.cause?.message || e?.message, e?.stack);
    clearPendingCookies(Astro.cookies);
    pendingToken = '';
    errorMsg = 'Sign-in is temporarily unavailable. Please try again.';
  }
} else if (faceFirstUserId) {
  try {
    const u = await db.select({ name: users.name, isActive: users.isActive })
      .from(users).where(eq(users.id, faceFirstUserId)).limit(1);
    if (u[0]?.isActive) {
      requireFaceFirstFactor = true;
      pendingUserName = u[0]?.name || '';
    } else {
      Astro.cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
      faceFirstUserId = '';
    }
  } catch (e: any) {
    console.error('[portal/login face pending]', e?.cause?.message || e?.message, e?.stack);
    Astro.cookies.delete(LEGACY_FACE_COOKIE, { path: '/' });
    faceFirstUserId = '';
  }
}

// The enrolled descriptor is never sent to the browser; the server compares.
const showCamera = requireFaceFirstFactor || (requireSecondStep && offerFace);
const cameraAction = requireFaceFirstFactor ? 'face_verified' : 'second_factor';
const showPasswordForm = !requireSecondStep && !requireFaceFirstFactor;
---
<BaseLayout title="Sign in - EduRankAI Portal" description="Sign in to your EduRankAI applicant portal.">
<style>
  .face-card { background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; overflow: hidden; max-width: 420px; margin: 0 auto; }
  .cam-wrap { background: #000; aspect-ratio: 3/4; position: relative; max-height: 380px; }
  .cam-wrap video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
  .oval-ring { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .oval-inner { width: 55%; aspect-ratio: 3/4; border: 2.5px solid rgba(220,80,0,0.7); border-radius: 50%; }
  .cam-status { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; }
  .cam-status span { background: rgba(0,0,0,0.75); color: #fff; font-size: 12px; padding: 4px 14px; border-radius: 100px; }
  .prog-bar { height: 3px; background: #f0f0f0; }
  .prog-fill { height: 100%; background: #DC5000; width: 0%; transition: width 0.4s; }
  .face-btn { width: 100%; border: none; font-size: 15px; font-weight: 700; padding: 14px; cursor: pointer; border-radius: 0; }
  .face-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<section style="padding: 48px 20px; max-width: 480px; margin: 0 auto;">
  <div style="text-align:center;margin-bottom:28px;">
    <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#DC5000;margin-bottom:8px;">Applicant Portal</p>
    <h1 style="font-size:28px;font-weight:700;color:#111;margin:0;">{requireFaceFirstFactor ? 'Verify your face' : requireSecondStep ? 'One more step' : 'Sign in'}</h1>
    {requireFaceFirstFactor && <p style="font-size:14px;color:#6b7280;margin:8px 0 0;">Welcome back, <strong>{pendingUserName}</strong></p>}
    {requireSecondStep && <p style="font-size:14px;color:#6b7280;margin:8px 0 0;line-height:1.6;">Welcome back{pendingUserName ? ', ' : ''}<strong>{pendingUserName}</strong>. Confirm it is you to finish signing in.</p>}
  </div>

  {errorMsg && (
    <div style="background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.2);color:#b91c1c;font-size:14px;padding:11px 14px;border-radius:8px;margin-bottom:18px;">
      {errorMsg}
    </div>
  )}

  {noticeMsg && (
    <div style="background:rgba(220,80,0,0.06);border:1px solid rgba(220,80,0,0.2);color:#9a3412;font-size:14px;padding:11px 14px;border-radius:8px;margin-bottom:18px;">
      {noticeMsg}
    </div>
  )}

  {showCamera && (
    <div class="face-card">
      <div class="cam-wrap">
        <video id="videoEl" autoplay playsinline muted></video>
        <div class="oval-ring"><div class="oval-inner" id="ovalRing"></div></div>
        <div class="cam-status"><span id="camStatus">Loading face model...</span></div>
      </div>
      <button id="verifyBtn" class="face-btn" disabled style="background:#DC5000;color:#fff;min-height:48px;">Preparing camera...</button>
    </div>
  )}

  {requireSecondStep && offerFace && offerCode && (
    <div style="display:flex;align-items:center;gap:10px;color:#9ca3af;font-size:12px;margin:16px 0;">
      <span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>OR<span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>
    </div>
  )}

  {requireSecondStep && (
    <div style="background:#fff;border:1px solid rgba(0,0,0,0.1);border-radius:16px;padding:24px;max-width:420px;margin:0 auto;">
      <form method="POST" style="display:flex;flex-direction:column;gap:16px;">
        <input type="hidden" name="action" value="second_factor"/>
        <input type="hidden" name="method" value="totp"/>
        <div>
          <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6b7280;margin-bottom:6px;">{offerCode ? 'Authenticator code, or a recovery code' : 'Recovery code'}</label>
          <input type="text" name="code" inputmode="text" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="one-time-code" maxlength="16" placeholder={offerCode ? '123456' : 'abcde-12345'} required style="width:100%;padding:12px 14px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:18px;letter-spacing:0.18em;text-align:center;outline:none;background:#fafaf9;"/>
        </div>
        <button type="submit" style="background:#DC5000;color:#fff;border:none;font-size:15px;font-weight:700;padding:13px;min-height:48px;border-radius:8px;cursor:pointer;">Verify</button>
      </form>
      <p style="font-size:12px;color:#6b7280;margin:14px 0 0;text-align:center;line-height:1.6;">Lost your phone? Use one of the <strong>recovery codes</strong> you saved when you turned this on. Each one works once.</p>
      <form method="POST" style="text-align:center;margin-top:10px;">
        <input type="hidden" name="action" value="cancel_second_step"/>
        <button type="submit" style="background:transparent;border:none;color:#6b7280;font-size:13px;font-weight:600;cursor:pointer;text-decoration:underline;padding:12px;min-height:44px;">Use a different account</button>
      </form>
    </div>
  )}

  {requireFaceFirstFactor && (
    <div style="text-align:center;margin-top:16px;">
      <form method="POST" style="display:inline;">
        <input type="hidden" name="action" value="cancel_face"/>
        <button type="submit" style="background:transparent;border:none;color:#6b7280;font-size:13px;cursor:pointer;text-decoration:underline;padding:12px;min-height:44px;">Use password instead</button>
      </form>
    </div>
  )}

  {showPasswordForm && (
    <div style="background:#fff;border:1px solid rgba(0,0,0,0.1);border-radius:16px;padding:24px;">
      <form method="POST" style="display:flex;flex-direction:column;gap:18px;">
        <input type="hidden" name="login_method" value="email"/>
        <div>
          <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6b7280;margin-bottom:6px;">Email or internal handle</label>
          <input type="text" name="email" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" placeholder="you@example.com or you@edurankai.in" required style="width:100%;padding:11px 14px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:15px;outline:none;background:#fafaf9;"/>
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6b7280;margin-bottom:6px;">Password</label>
          <div style="position:relative;">
            <input type="password" name="password" id="portal-login-pw" autocomplete="current-password" required style="width:100%;padding:11px 14px;padding-right:56px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:15px;outline:none;background:#fafaf9;"/>
            <button type="button" id="pwToggle" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:transparent;border:none;color:#6b7280;font-size:11px;font-weight:700;cursor:pointer;font-family:monospace;text-transform:uppercase;min-height:44px;min-width:44px;">Show</button>
          </div>
        </div>
        <button type="submit" style="background:#DC5000;color:#fff;border:none;font-size:15px;font-weight:700;padding:13px;min-height:48px;border-radius:8px;cursor:pointer;">Sign In</button>
      </form>
      <div style="margin-top:18px;padding-top:18px;border-top:1px solid rgba(0,0,0,0.08);display:flex;flex-direction:column;gap:8px;text-align:center;">
        <a href="/portal/forgot" style="font-size:13px;color:#DC5000;font-weight:600;text-decoration:none;">Forgot password?</a>
        <p style="font-size:12px;color:#6b7280;margin:4px 0 0;">Staff can sign in with either a personal email or an internal handle.</p>
      </div>
    </div>
  )}

  {showPasswordForm && (
    <div style="max-width:480px;margin:14px auto 0;">
      <div style="display:flex;align-items:center;gap:10px;color:#9ca3af;font-size:12px;margin:6px 0 12px;">
        <span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>OR<span style="flex:1;height:1px;background:rgba(0,0,0,0.1);"></span>
      </div>
      <button type="button" id="pkLoginBtn" style="width:100%;display:flex;align-items:center;justify-content:center;gap:8px;background:#fff;border:1px solid rgba(0,0,0,0.15);color:#111;font-size:14px;font-weight:700;padding:12px;min-height:48px;border-radius:8px;cursor:pointer;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 11c0-1.5-1-3-3-3M5 13a7 7 0 0 1 7-7 7 7 0 0 1 7 7M8 21c-1-2-1.5-4-1.5-6M12 13v3c0 2 .5 4 1.5 6M16 14c.3 2 .8 4 1.5 5"/></svg>
        Sign in with fingerprint / passkey
      </button>
      <p id="pkLoginErr" style="color:#b91c1c;font-size:12px;text-align:center;margin:8px 0 0;min-height:1em;"></p>
      <div style="text-align:center;margin-top:6px;">
        <button type="button" id="totpToggle" style="background:transparent;border:none;color:#DC5000;font-size:13px;font-weight:600;cursor:pointer;text-decoration:underline;padding:12px;min-height:44px;">Sign in with an authenticator code</button>
      </div>
      <div id="totpBox" style="display:none;margin-top:10px;background:#fff;border:1px solid rgba(0,0,0,0.1);border-radius:12px;padding:14px;">
        <input id="totpEmail" type="text" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="Email or internal handle" autocomplete="username" style="width:100%;padding:10px 14px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:14px;outline:none;margin-bottom:8px;"/>
        <input id="totpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="12" placeholder="6-digit code" style="width:100%;padding:10px 14px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:16px;letter-spacing:0.15em;text-align:center;outline:none;margin-bottom:8px;"/>
        <button type="button" id="totpBtn" style="width:100%;background:#0f0f14;color:#fff;border:none;font-size:14px;font-weight:600;padding:11px;min-height:48px;border-radius:8px;cursor:pointer;">Verify code</button>
        <p id="totpErr" style="color:#b91c1c;font-size:12px;text-align:center;margin:8px 0 0;min-height:1em;"></p>
      </div>
    </div>
  )}

  {showPasswordForm && (
    <p style="text-align:center;font-size:14px;color:#6b7280;margin-top:20px;">
      New here? <a href="/portal/signup" style="color:#DC5000;font-weight:600;text-decoration:none;">Create an account</a>
    </p>
  )}

  {showPasswordForm && (
    <div style="text-align:center;margin-top:16px;">
      <button type="button" id="faceOnlyToggle" style="background:transparent;border:none;color:#DC5000;font-size:13px;font-weight:600;cursor:pointer;text-decoration:underline;padding:12px;min-height:44px;">
        Sign in with face (no password)
      </button>
      <div id="faceOnlyForm" style="display:none;margin-top:12px;background:#fff;border:1px solid rgba(0,0,0,0.1);border-radius:12px;padding:16px;">
        <p style="font-size:13px;color:#374151;margin:0 0 12px;line-height:1.6;">Enter your email or internal handle. We verify your face instead of a password.</p>
        <form method="POST" style="display:flex;flex-direction:column;gap:10px;">
          <input type="hidden" name="action" value="face_only_init"/>
          <input type="text" name="email" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" placeholder="you@example.com or you@edurankai.in" required style="width:100%;padding:10px 14px;min-height:48px;border:1px solid rgba(0,0,0,0.15);border-radius:8px;font-size:14px;outline:none;"/>
          <button type="submit" style="background:#0f0f14;color:#fff;border:none;font-size:14px;font-weight:600;padding:11px;min-height:48px;border-radius:8px;cursor:pointer;">Continue with face</button>
        </form>
      </div>
    </div>
  )}
</section>

{showCamera && (
  <form id="faceSuccessForm" method="POST" style="display:none;">
    <input type="hidden" name="action" value={cameraAction}/>
    <input type="hidden" name="method" value="face"/>
    <input type="hidden" name="live_descriptor" id="liveDescriptorField" value=""/>
  </form>
)}

<script src="/webauthn-client.js" is:inline></script>
<script is:inline>
  (function () {
    var pk = document.getElementById('pkLoginBtn'), pkErr = document.getElementById('pkLoginErr');
    if (pk) {
      if (!window.eraPasskeySupported) pk.style.display = 'none';
      pk.addEventListener('click', async function () {
        if (pkErr) pkErr.textContent = ''; pk.disabled = true; var t = pk.innerHTML; pk.textContent = 'Follow your device prompt…';
        try { var r = await window.eraPasskeyLogin(); location.href = r.redirect || '/portal'; }
        catch (e) { if (pkErr) pkErr.textContent = (e && e.message) || 'Could not sign in with passkey.'; pk.disabled = false; pk.innerHTML = t; }
      });
    }
    var tog = document.getElementById('totpToggle'), box = document.getElementById('totpBox');
    if (tog && box) tog.addEventListener('click', function () { box.style.display = (box.style.display === 'none' || !box.style.display) ? 'block' : 'none'; });
    var tb = document.getElementById('totpBtn'), te = document.getElementById('totpErr');
    if (tb) tb.addEventListener('click', async function () {
      if (te) te.textContent = '';
      var email = (document.getElementById('totpEmail').value || '').trim();
      var code = (document.getElementById('totpCode').value || '').trim();
      if (!email || !code) { if (te) te.textContent = 'Enter your email and code.'; return; }
      tb.disabled = true;
      var rr = await fetch('/api/auth/totp-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ email: email, code: code }) });
      var d = {}; try { d = await rr.json(); } catch (_) {}
      tb.disabled = false;
      if (d.ok) location.href = d.redirect || '/portal'; else if (te) te.textContent = d.error || 'Invalid email or code.';
    });
  })();
</script>
<script is:inline>
// Password show/hide
var pwToggle = document.getElementById('pwToggle');
var pwInput = document.getElementById('portal-login-pw');
if (pwToggle && pwInput) {
  pwToggle.addEventListener('click', function() {
    var isPw = pwInput.type === 'password';
    pwInput.type = isPw ? 'text' : 'password';
    pwToggle.textContent = isPw ? 'Hide' : 'Show';
  });
}
</script>

{showCamera && (
  <script is:inline src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.min.js"></script>
  <script is:inline>
  // The enrolled descriptor is NEVER sent to the browser. This only captures a
  // live descriptor and posts it; the comparison, the threshold and the verdict
  // all happen server-side, which is the only place a forged POST cannot reach.
  (function () {
    var video = document.getElementById('videoEl');
    var verifyBtn = document.getElementById('verifyBtn');
    var statusEl = document.getElementById('camStatus');
    var form = document.getElementById('faceSuccessForm');
    var field = document.getElementById('liveDescriptorField');
    if (!video || !verifyBtn || !form || !field) return;
    var submitted = false;
    var stream = null;

    function setStatus(msg) { if (statusEl) statusEl.textContent = msg; }

    // THE CAMERA IS TURNED OFF EXPLICITLY, ON EVERY EXIT — before the descriptor
    // is posted, and whenever this page is left. Relying on the navigation to do
    // it leaves the light on through the POST and the next render, and leaves it
    // on indefinitely for anyone who abandons the face step and types a code
    // instead. Nothing is stored either way; a camera still running after the
    // moment it was granted for is its own trust failure.
    function shutCamera() {
      try {
        if (stream) { stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); }
      } catch (_) {}
      stream = null;
      try { video.pause(); } catch (_) {}
      try { video.srcObject = null; } catch (_) {}
      try { video.removeAttribute('src'); } catch (_) {}
    }
    window.addEventListener('pagehide', shutCamera);

    async function init() {
      setStatus('Loading face model...');
      var MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
      await Promise.all([
        faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
        faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
        faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
      ]);
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
      video.srcObject = stream;
      verifyBtn.disabled = false;
      verifyBtn.textContent = 'Verify my face';
      verifyBtn.onclick = capture;
      setStatus('Position your face in the oval');
    }

    async function capture() {
      if (submitted) return;
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Checking...';
      setStatus('Scanning...');
      try {
        var det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
          .withFaceLandmarks(true).withFaceDescriptor();
        if (!det) {
          setStatus('No face detected. Try again in better light.');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Try again';
          return;
        }
        submitted = true;
        field.value = JSON.stringify(Array.prototype.slice.call(det.descriptor));
        // Camera off BEFORE anything is posted. The frame it came from is never
        // drawn to a canvas, never uploaded, and does not outlive this line.
        shutCamera();
        setStatus('Sending for verification...');
        form.submit();
      } catch (e) {
        setStatus('Camera error. Use your password instead.');
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Try again';
      }
    }

    init().catch(function () {
      setStatus('Camera unavailable. Use your password instead.');
      verifyBtn.textContent = 'Camera unavailable';
    });
  })();
  </script>
)}

<script is:inline>
  (function () {
    var t = document.getElementById('faceOnlyToggle');
    var box = document.getElementById('faceOnlyForm');
    if (t && box) t.addEventListener('click', function () {
      box.style.display = (box.style.display === 'none' || !box.style.display) ? 'block' : 'none';
    });
  })();
</script>

</BaseLayout>
