---
// /portal/study-abroad/[id] — one study-abroad request, read by the person who filed it.
//
// WHY IT DID NOT EXIST, AND WHAT THAT COST. /portal/study-abroad has always rendered every request as
// `<a href={'/portal/study-abroad/' + r.id}>` — a whole card, cursor and all — and this route was
// never written. Every one of those links answered 404. The list itself carries only the countries,
// the programme level and a status pill, so the notes an applicant wrote about their own plans, the
// intake they are aiming at, the budget band they gave and the name of the consultant assigned to
// them were captured on the form, stored, shown to the admin queue, and readable by the applicant
// nowhere. A card that looks openable and is not is worse than no card: it reads as the product
// being broken at the moment the person most wants to check on their case.
//
// SCOPING. getApplicantRequest() puts applicant_user_id in the WHERE clause, so an id belonging to
// somebody else does not come back at all — there is no post-fetch comparison to get wrong, and
// editing the address bar reads nothing. A read that FAILED and a request that is not yours produce
// different pages, because "this is not your request" is an accusation and a pooler timeout is not.
//
// WHAT IS DELIBERATELY NOT HERE. There is no reply box. src/lib/study-abroad.ts describes a thread
// between applicant and consultant over request_messages, and that thread has never been wired: the
// RequestType union in src/lib/request-threads.ts does not include 'study_abroad', nothing writes
// unread_applicant, and /admin/study-abroad has no message form for a consultant to answer in. A
// send button here would post into a table nobody reads and tell the applicant a consultant had been
// written to. The page says how they will actually be contacted instead. Recorded as a gap.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getApplicantRequest } from '@/lib/study-abroad';

const user = Astro.locals.user;
const { id } = Astro.params;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/study-abroad/' + (id || '')));
if (user.role !== 'applicant') return Astro.redirect('/admin');

// Declared before everything that reads them — const is not hoisted.
const STATUS_COPY: Record<string, { label: string; bg: string; fg: string; line: string }> = {
  pending:     { label: 'Pending',     bg: 'rgba(250,204,21,0.14)', fg: '#92400e', line: 'Filed and waiting to be picked up. A consultant is assigned by hand, usually within 2 business days.' },
  assigned:    { label: 'Assigned',    bg: 'rgba(59,130,246,0.12)', fg: '#1e40af', line: 'A consultant now has your case and will be in touch about the next step.' },
  in_progress: { label: 'In progress', bg: 'rgba(99,102,241,0.12)', fg: '#3730a3', line: 'Your consultant is actively working on this.' },
  completed:   { label: 'Completed',   bg: 'rgba(16,185,129,0.12)', fg: '#047857', line: 'This case has been closed as complete. File a new request if anything else comes up.' },
  cancelled:   { label: 'Cancelled',   bg: 'rgba(115,115,115,0.12)', fg: '#6b7280', line: 'This request was cancelled and nobody is working on it.' },
};
const fmt = (d: any): string => {
  if (!d) return '';
  try {
    return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch { return ''; }
};

const read = await getApplicantRequest(String(id || ''), user.id);
const req = read.request;
const status = String(req?.status || 'pending');
const meta = STATUS_COPY[status] || STATUS_COPY.pending;
const countries: string[] = Array.isArray(req?.countries) ? req.countries : [];
const intakeLabel = [req?.intake_term, req?.intake_year].filter(Boolean).join(' ');
const facts: { label: string; value: string }[] = req ? [
  { label: 'Countries', value: countries.length ? countries.join(', ') : 'Not recorded' },
  { label: 'Programme level', value: String(req.programme_level || 'Not recorded') },
  { label: 'Intake', value: intakeLabel || 'Not recorded' },
  { label: 'Budget band', value: String(req.budget_band || 'Not recorded') },
  { label: 'Where you are now', value: String(req.current_stage || 'Not recorded') },
  { label: 'Filed', value: fmt(req.created_at) || 'Not recorded' },
] : [];
const consultantName = req?.consultant_name ? String(req.consultant_name) : '';
---
<BaseLayout title="Your study-abroad request - EduRankAI" description="One study-abroad request and where it has got to." noindex={true}>
  <section class="px-[5vw] py-10 md:py-14 max-w-2xl mx-auto">
    <a href="/portal/study-abroad" class="text-[0.78rem] font-mono uppercase tracking-wider text-burn hover:underline no-underline">&lt; All requests</a>

    {!read.ok && (
      <div style="background:#fff5f0;border:1px solid #f0b49a;border-radius:14px;padding:18px;margin-top:18px;">
        <p style="font-size:15px;color:#9a3412;margin:0;font-weight:600;">This request could not be read just now.</p>
        <p style="font-size:13.5px;color:#5c5349;margin:8px 0 0;line-height:1.7;">
          This is <strong>not</strong> a statement that it was cancelled, or that it is not yours. Nothing has been
          lost or withdrawn - the record simply could not be reached on this load. Please reload in a moment.
        </p>
        <p style="font-size:11.5px;color:#8a7f70;margin:10px 0 0;font-family:'Geist Mono',monospace;word-break:break-word;">{read.reason}</p>
      </div>
    )}

    {read.ok && !req && (
      <div style="background:#faf6ef;border:1px solid #ece4d6;border-radius:14px;padding:18px;margin-top:18px;">
        <p style="font-size:15px;color:#1a1510;margin:0;font-weight:600;">No such request on your account.</p>
        <p style="font-size:13.5px;color:#5c5349;margin:8px 0 0;line-height:1.7;">
          This page only ever shows requests filed from your own account. The link may be old, or it may belong
          to somebody else. Your own requests are all listed on the previous page.
        </p>
        <a href="/portal/study-abroad" style="display:inline-block;margin-top:14px;background:#1a1510;color:#faf6ef;text-decoration:none;font-size:13px;font-weight:600;padding:10px 16px;border-radius:10px;">Back to my requests</a>
      </div>
    )}

    {req && (
      <div>
        <div class="mt-4 mb-6">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.18em] text-burn font-bold mb-2">Study abroad</p>
          <h1 class="font-display text-[clamp(1.6rem,4.2vw,2.2rem)] font-semibold text-ink leading-[1.15] mb-3">
            {countries.length ? countries.join(', ') : 'Your request'}
          </h1>
          <span style={'display:inline-block;font-family:JetBrains Mono,monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;padding:4px 11px;border-radius:100px;background:' + meta.bg + ';color:' + meta.fg + ';'}>{meta.label}</span>
          <p class="text-[0.9rem] text-ink-soft leading-relaxed mt-3">{meta.line}</p>
        </div>

        <div class="bg-white border border-ink/10 rounded-2xl p-5 mb-5">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-3">What you told us</p>
          <dl style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:0;">
            {facts.map((f) => (
              <div>
                <dt style="font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:#8a7f70;font-family:'Geist Mono',monospace;font-weight:700;margin:0 0 3px;">{f.label}</dt>
                <dd style="font-size:14px;color:#1a1510;margin:0;line-height:1.5;">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {req.notes && (
          <div class="bg-white border border-ink/10 rounded-2xl p-5 mb-5">
            <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-2">Your notes</p>
            <p class="text-[0.9rem] text-ink-2 leading-relaxed" style="white-space:pre-wrap;margin:0;">{req.notes}</p>
          </div>
        )}

        <div class="bg-cream-2/60 border border-ink/10 rounded-2xl p-5">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-2">How you will hear back</p>
          <p class="text-[0.88rem] text-ink-soft leading-relaxed" style="margin:0;">
            {consultantName
              ? 'Your case is with ' + consultantName + ', who will contact you directly about the next step.'
              : 'A consultant is assigned to each case by hand. Once yours has one, their name appears on this page.'}
            {' '}There is no message thread on this request yet, so nothing written here would reach anyone. If you
            need to add something in the meantime, file it as a new request or write to <a href="mailto:connect@edurankai.in" class="text-burn font-semibold">connect@edurankai.in</a>.
          </p>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
