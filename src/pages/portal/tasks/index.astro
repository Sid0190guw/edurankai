  .bar__who {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 45%;
    font-size: var(--wf-t-micro);
    color: var(--wf-nav-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
