  /* ------------------------------------------------------------------- page */

  /* display stated, not assumed: a very old Android WebView lays out an element it does not know as
     inline, and this set is built to work on one. */
  .page { display: block; padding: 0 0 var(--wf-s-5); }

  .note {
    margin: var(--wf-s-3) var(--wf-s-4) 0;
    padding: var(--wf-s-2) var(--wf-s-3);
