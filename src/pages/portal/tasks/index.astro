  .note--flash { display: flex; align-items: flex-start; gap: var(--wf-s-2); }
  .note__glyph { width: 18px; height: 18px; flex: 0 0 auto; margin-top: 1px; }
  .note__text { min-width: 0; }

  .panel {
    margin: var(--wf-s-4);
    padding: var(--wf-s-5) var(--wf-s-4);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-md);
    background: var(--wf-surface);
  }
  .panel__title { margin: 0 0 var(--wf-s-2); font-size: var(--wf-t-title); font-weight: 700; }
  .panel__body { margin: 0 0 var(--wf-s-2); font-size: var(--wf-t-meta); color: var(--wf-ink-2); line-height: 1.6; }
  .link { color: var(--wf-info-text); }

  .tally {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--wf-s-2);
    margin: var(--wf-s-4) var(--wf-s-4) 0;
    font-size: var(--wf-t-meta);
    color: var(--wf-ink-3);
  }
  .tally b { font-size: 22px; font-weight: 800; line-height: 1; color: var(--wf-ink); }
  .tally__late { font-weight: 650; color: var(--wf-tone-text); }

  .filters { margin: var(--wf-s-3) var(--wf-s-4) 0; }

  /* --------------------------------------------------------------- prefs bar */

  .prefs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wf-s-4);
    margin: var(--wf-s-3) var(--wf-s-4) 0;
  }
  .prefs__set { min-width: 0; margin: 0; padding: 0; border: 0; }
  .prefs__legend {
    padding: 0;
    margin-bottom: var(--wf-s-1);
    font-size: var(--wf-t-micro);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--wf-chrome-ink);
  }
  .prefs__row { display: flex; flex-wrap: wrap; gap: var(--wf-s-1); }

  .prefs__btn {
    min-height: var(--wf-control-h);
    padding: 0 var(--wf-s-3);
    border: 1px solid var(--wf-line-strong);
    border-radius: var(--wf-r-pill);
    background: var(--wf-surface);
    color: var(--wf-ink-2);
    font-family: inherit;
    font-size: var(--wf-t-meta);
    font-weight: 600;
    cursor: pointer;
  }
  /* The pressed state is a fill AND a weight change, never colour alone. */
  .prefs__btn.is-on {
    background: var(--wf-ink);
    border-color: var(--wf-ink);
    color: var(--wf-on-solid);
    font-weight: 700;
  }
  .prefs__btn:active { opacity: 0.8; }

  /* ------------------------------------------------------------------ chips */

  .chips {
    display: flex;
    gap: var(--wf-s-1);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    padding: var(--wf-s-4) var(--wf-s-4) var(--wf-s-1);
  }

  .chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: var(--wf-s-1);
    min-height: var(--wf-control-h);
    padding: 0 var(--wf-s-3);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-pill);
    background: var(--wf-surface);
    color: var(--wf-ink-2);
    font-size: var(--wf-t-meta);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .chip__n { font-size: var(--wf-t-micro); font-weight: 700; color: var(--wf-ink-3); }
  .chip.is-on { background: var(--wf-ink); border-color: var(--wf-ink); color: var(--wf-on-solid); }
  .chip.is-on .chip__n { color: var(--wf-on-solid); opacity: 0.75; }

  /* ------------------------------------------------------------------ board */

  .board {
    display: flex;
    align-items: flex-start;
    gap: var(--wf-gap);
    /* The columns scroll here. The PAGE never scrolls sideways.
       overscroll-behavior-x stops a swipe past the last column from triggering the browser's
       back gesture, which on a board is a lost place in a list. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: var(--wf-s-3) var(--wf-s-4) var(--wf-s-4);
  }
  .board:focus { outline: none; }

  .col {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(82vw, 300px);
    min-width: 0;
    /* A capped column with an inner scroller is what keeps the header visible. vh first so an
       Android WebView with no dvh support still gets a cap rather than an uncapped column. */
    max-height: calc(100vh - 210px);
    max-height: calc(100dvh - 210px);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-lg);
    background: var(--wf-sunk);
    scroll-snap-align: start;
  }

  .colhead {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wf-s-2);
    flex: 0 0 auto;
    padding: var(--wf-pad) var(--wf-pad) var(--wf-pad-tight);
    /* Opaque, because cards scroll underneath it. */
    background: var(--wf-raised);
    border-bottom: 1px solid var(--wf-line);
    border-radius: var(--wf-r-lg) var(--wf-r-lg) 0 0;
  }
  .colhead__name {
    margin: 0;
    min-width: 0;
    font-size: var(--wf-t-meta);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--wf-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .colhead__n {
    flex: 0 0 auto;
    padding: 2px var(--wf-s-2);
    border-radius: var(--wf-r-pill);
    background: var(--wf-veil);
    color: var(--wf-ink-3);
    font-size: var(--wf-t-micro);
    font-weight: 700;
  }

  .col__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: var(--wf-pad-tight);
    display: flex;
    flex-direction: column;
    gap: var(--wf-gap);
  }

  /* SINGLE COLUMN. No horizontal scroller, no cap, no inner scroller: the page is the scroller and
     position:sticky on the header therefore pins to the VIEWPORT, which is the mode where a column
     is actually long enough for that to matter. */
  .board.is-single { display: block; overflow: visible; padding-top: var(--wf-s-3); }
  .board.is-single .col { width: auto; max-height: none; }
  .board.is-single .col__body { overflow: visible; }

  .tw { min-width: 0; }

  /* --------------------------------------------------------------- move form */

  .mv { margin-top: var(--wf-s-3); }
  .mv__row { display: flex; gap: var(--wf-s-1); align-items: stretch; }

  .mv__select {
    flex: 1 1 auto;
    min-width: 0;
    min-height: var(--wf-control-h);
    padding: 0 var(--wf-s-2);
    border: 1px solid var(--wf-line-strong);
    border-radius: var(--wf-r-sm);
    background: var(--wf-raised);
    color: var(--wf-ink);
    font-family: inherit;
    /* 16px so iOS Safari does not zoom the whole board when this takes focus. */
    font-size: 1rem;
  }
  .mv__select:focus-visible { outline: 2px solid var(--wf-focus); outline-offset: 1px; }

  .mv__go {
    flex: 0 0 auto;
    min-height: var(--wf-control-h);
    padding: 0 var(--wf-s-3);
    border: 1px solid var(--wf-ink);
    border-radius: var(--wf-r-sm);
    background: var(--wf-ink);
    color: var(--wf-on-solid);
    font-family: inherit;
    font-size: var(--wf-t-meta);
    font-weight: 650;
    cursor: pointer;
  }
  .mv__go:active { opacity: 0.8; }

  .mv__reason {
    width: 100%;
    min-height: var(--wf-control-h);
    margin-top: var(--wf-s-1);
    padding: 0 var(--wf-s-2);
    border: 1px solid var(--wf-line-strong);
    border-radius: var(--wf-r-sm);
    background: var(--wf-raised);
    color: var(--wf-ink);
    font-family: inherit;
    font-size: 1rem;
  }
  .mv__reason:focus-visible { outline: 2px solid var(--wf-focus); outline-offset: 1px; }

  .mv__none {
    margin: 0;
    font-size: var(--wf-t-meta);
    color: var(--wf-ink-3);
    line-height: 1.5;
  }

  .boardempty { margin: var(--wf-s-4); }

  .hint {
    margin: var(--wf-s-3) var(--wf-s-4) 0;
    font-size: var(--wf-t-meta);
    color: var(--wf-chrome-ink);
    line-height: 1.6;
  }

  /* ------------------------------------------------------------------- drag */

  /* Added by the script, so a browser that cannot drag never shows a handle it will not honour. */
  body.dnd .tw { cursor: grab; }
  body.dnd .tw:active { cursor: grabbing; }

  /* The card in somebody's hand. Opacity and transform only, as the ruling requires — no colour
     animation, no shadow animation, nothing that costs a repaint. */
  .tw.is-dragging { opacity: 0.45; }

  /* The drop target says yes IN ADVANCE. This only ever appears on a column the engine would
     actually accept, because the script checks the select's own options before allowing the drop.
     The DASHES are the signal, not the hue: a tint change alone is a state told in colour only, and
     this file does not get to make an exception for itself because the state is short-lived. Outline
     rather than a border swap so nothing reflows under the card being carried. */
  .col.is-over {
    border-color: var(--wf-in_progress-accent);
    background: var(--wf-in_progress-wash);
    outline: 2px dashed var(--wf-in_progress-accent);
    outline-offset: -4px;
  }
  .col.is-over .colhead { border-bottom-color: var(--wf-in_progress-accent); }

  @media (prefers-reduced-motion: no-preference) {
    .tw { transition: var(--wf-tr-state); }
    .col { transition: background-color var(--wf-dur-state) var(--wf-ease), border-color var(--wf-dur-state) var(--wf-ease); }
  }

  /* ------------------------------------------------------------------ wide */

  @media (min-width: 900px) {
    .col { width: 300px; max-height: calc(100vh - 240px); max-height: calc(100dvh - 240px); }
    .board.is-single .col { width: min(720px, 100%); max-height: none; }
  }

  @media (forced-colors: active) {
    .chip.is-on, .prefs__btn.is-on { forced-color-adjust: none; background: Highlight; color: HighlightText; }
    .col.is-over { border-color: Highlight; outline-color: Highlight; }
  }
</style>

<script is:inline>
/* DRAG AND DROP: an enhancement, never the mechanism.
   Everything below submits the same form the Move button submits. It adds the `draggable` attribute
   and the grab cursor itself, so a browser without HTML5 drag shows no affordance it cannot honour,
   and a drop onto a column this card may not move to is refused HERE rather than sent to the server
   to be refused there. Motion is entirely in CSS inside a prefers-reduced-motion query. No
   framework, no library, no bundle, no npm install. */
(function () {
  var proto = document.createElement('div');
  if (!('draggable' in proto)) return;

  var cards = document.querySelectorAll('.tw[data-form]');
  var cols = document.querySelectorAll('.col[data-status]');
  if (!cards.length || cols.length < 2) return;

  document.body.className += ' dnd';
  var held = null;

  function formOf(card) {
    var id = card.getAttribute('data-form');
    return id ? document.getElementById(id) : null;
  }
  function pickerOf(card) {
    var f = formOf(card);
    return f ? f.querySelector('select[name="to"]') : null;
  }
  function canDrop(card, status) {
    var s = pickerOf(card);
    if (!s) return false;
    for (var i = 0; i < s.options.length; i++) {
      if (s.options[i].value === status) return true;
    }
    return false;
  }
  function clearOver() {
    for (var i = 0; i < cols.length; i++) {
      cols[i].className = cols[i].className.replace(/\s*is-over\b/, '');
    }
  }
  /* A drag that starts on the select, the reason box, the Move button or the Details summary would
     take those controls away from the person using them — on Firefox a draggable ancestor stops you
     selecting text in a child input at all. The keyboard path must never be collateral damage of
     the mouse path, so a drag beginning inside a control is cancelled and the control just works. */
  function fromControl(el) {
    for (var n = el; n && n !== document.body; n = n.parentNode) {
      var tag = (n.tagName || '').toUpperCase();
      if (tag === 'SELECT' || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'BUTTON'
        || tag === 'OPTION' || tag === 'LABEL' || tag === 'SUMMARY' || tag === 'A') return true;
    }
    return false;
  }

  for (var i = 0; i < cards.length; i++) {
    (function (card) {
      card.draggable = true;
      card.addEventListener('dragstart', function (e) {
        if (fromControl(e.target)) { e.preventDefault(); return; }
        held = card;
        card.className += ' is-dragging';
        try {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', card.getAttribute('data-form') || '');
        } catch (err) { /* Safari refuses setData in some modes; the drag still works. */ }
      });
      card.addEventListener('dragend', function () {
        card.className = card.className.replace(/\s*is-dragging\b/, '');
        held = null;
        clearOver();
      });
    })(cards[i]);
  }

  for (var k = 0; k < cols.length; k++) {
    (function (col) {
      var status = col.getAttribute('data-status');
      col.addEventListener('dragover', function (e) {
        if (!held || !canDrop(held, status)) return;  /* no preventDefault means no drop: an honest refusal */
        e.preventDefault();
        /* A null check rather than a bare catch: dataTransfer is null outside a real drag, and
           that is the only way this line can fail. Nothing is being swallowed. */
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        if (col.className.indexOf('is-over') < 0) col.className += ' is-over';
      });
      col.addEventListener('dragleave', function () {
        col.className = col.className.replace(/\s*is-over\b/, '');
      });
      col.addEventListener('drop', function (e) {
        col.className = col.className.replace(/\s*is-over\b/, '');
        if (!held || !canDrop(held, status)) return;
        e.preventDefault();
        var card = held;
        var form = formOf(card);
        var picker = pickerOf(card);
        if (!form || !picker) return;
        picker.value = status;
        /* Blocked and Cancelled are refused by the engine without a stated cause. Ask for it here
           rather than spending a round trip to be told. */
        var reason = form.querySelector('input[name="reason"]');
        if (reason && (status === 'blocked' || status === 'cancelled') && !reason.value.replace(/^\s+|\s+$/g, '')) {
          card.className = card.className.replace(/\s*is-dragging\b/, '');
          held = null;
          reason.focus();
          return;
        }
        form.submit();
      });
    })(cols[k]);
  }
})();
</script>
</body>
</html>
