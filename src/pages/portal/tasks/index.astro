<script is:inline>
/* DRAG AND DROP: an enhancement, never the mechanism.
   Everything below submits the same form the Move button submits. It adds the `draggable` attribute
   and the grab cursor itself, so a browser without HTML5 drag shows no affordance it cannot honour,
   and a drop onto a column this card may not move to is refused HERE rather than sent to the server
   to be refused there. Motion is entirely in CSS inside a prefers-reduced-motion query. No
   framework, no library, no bundle, no npm install. */
(function () {
  var proto = document.createElement('div');
  if (!('draggable' in proto)) return;

  var cards = document.querySelectorAll('.tw[data-form]');
  var cols = document.querySelectorAll('.col[data-status]');
  if (!cards.length || cols.length < 2) return;

  document.body.className += ' dnd';
  var held = null;

  function formOf(card) {
    var id = card.getAttribute('data-form');
    return id ? document.getElementById(id) : null;
  }
  function pickerOf(card) {
    var f = formOf(card);
    return f ? f.querySelector('select[name="to"]') : null;
  }
  function canDrop(card, status) {
    var s = pickerOf(card);
    if (!s) return false;
    for (var i = 0; i < s.options.length; i++) {
      if (s.options[i].value === status) return true;
    }
    return false;
  }
  function clearOver() {
    for (var i = 0; i < cols.length; i++) {
      cols[i].className = cols[i].className.replace(/\s*is-over\b/, '');
    }
  }
  /* A drag that starts on the select, the reason box, the Move button or the Details summary would
     take those controls away from the person using them — on Firefox a draggable ancestor stops you
     selecting text in a child input at all. The keyboard path must never be collateral damage of
     the mouse path, so a drag beginning inside a control is cancelled and the control just works. */
  function fromControl(el) {
    for (var n = el; n && n !== document.body; n = n.parentNode) {
      var tag = (n.tagName || '').toUpperCase();
      if (tag === 'SELECT' || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'BUTTON'
        || tag === 'OPTION' || tag === 'LABEL' || tag === 'SUMMARY' || tag === 'A') return true;
    }
    return false;
  }

  for (var i = 0; i < cards.length; i++) {
    (function (card) {
      card.draggable = true;
      card.addEventListener('dragstart', function (e) {
        if (fromControl(e.target)) { e.preventDefault(); return; }
        held = card;
        card.className += ' is-dragging';
        try {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', card.getAttribute('data-form') || '');
        } catch (err) { /* Safari refuses setData in some modes; the drag still works. */ }
      });
      card.addEventListener('dragend', function () {
        card.className = card.className.replace(/\s*is-dragging\b/, '');
        held = null;
        clearOver();
      });
    })(cards[i]);
  }

  for (var k = 0; k < cols.length; k++) {
    (function (col) {
      var status = col.getAttribute('data-status');
      col.addEventListener('dragover', function (e) {
        if (!held || !canDrop(held, status)) return;  /* no preventDefault means no drop: an honest refusal */
        e.preventDefault();
        /* A null check rather than a bare catch: dataTransfer is null outside a real drag, and
           that is the only way this line can fail. Nothing is being swallowed. */
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        if (col.className.indexOf('is-over') < 0) col.className += ' is-over';
      });
      col.addEventListener('dragleave', function () {
        col.className = col.className.replace(/\s*is-over\b/, '');
      });
      col.addEventListener('drop', function (e) {
        col.className = col.className.replace(/\s*is-over\b/, '');
        if (!held || !canDrop(held, status)) return;
        e.preventDefault();
        var card = held;
        var form = formOf(card);
        var picker = pickerOf(card);
        if (!form || !picker) return;
        picker.value = status;
        /* Blocked and Cancelled are refused by the engine without a stated cause. Ask for it here
           rather than spending a round trip to be told. */
        var reason = form.querySelector('input[name="reason"]');
        if (reason && (status === 'blocked' || status === 'cancelled') && !reason.value.replace(/^\s+|\s+$/g, '')) {
          card.className = card.className.replace(/\s*is-dragging\b/, '');
          held = null;
          reason.focus();
          return;
        }
        form.submit();
      });
    })(cols[k]);
  }
})();
</script>
</body>
</html>
