---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TwoFactorPanel from '@/components/security/TwoFactorPanel.astro';
import { isTotpEnabled, countUnusedBackupCodes } from '@/lib/auth/twofactor';
import { listPasskeys } from '@/lib/auth/webauthn';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

let enabled = false;
let backupRemaining = 0;
let passkeys: any[] = [];
// DID THE READ RUN? A failed lookup used to leave `enabled` false and `passkeys` empty, so this
// page told somebody who HAS two-factor turned on that it is off, and offered them the set-up
// flow for a factor they already hold. That is the one wrong answer a security screen must not
// give: it invites a person to believe their account is unprotected, or to re-enrol over a
// working second factor.
let securityOk = true;
try {
  enabled = await isTotpEnabled(user.id);
  if (enabled) backupRemaining = await countUnusedBackupCodes(user.id);
  passkeys = await listPasskeys(user.id);
} catch (e: any) {
  securityOk = false;
  // The real Postgres reason is on e.cause; e.message is only the failed SQL.
  console.error('[portal/security]', e?.cause?.message || e?.message);
}
const accountLabel = user.email || (user as any).internalHandle || user.name || '';
---
<BaseLayout title="Security - EduRankAI" description="Protect your account with two-factor authentication.">
  <section style="padding:48px 20px; max-width:640px; margin:0 auto;">
    <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#DC5000;margin:0 0 8px;">Account security</p>
    <h1 style="font-size:28px;font-weight:700;color:#111;margin:0 0 6px;">Two-factor authentication</h1>
    <p style="font-size:14px;color:#6b7280;margin:0 0 24px;line-height:1.6;">A second step at sign-in keeps your account safe even if your password is stolen.</p>

    {!securityOk && (
      <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.28);border-radius:10px;padding:12px 14px;margin:0 0 18px;">
        <p style="font-size:13.5px;color:#991b1b;margin:0 0 4px;font-weight:600;">We could not read your security settings.</p>
        <p style="font-size:13px;color:#7f1d1d;margin:0;line-height:1.55;">What is shown below is NOT your current setup, and nothing here has been changed. Please reload in a moment before turning anything on or off.</p>
      </div>
    )}

    {securityOk && (
      <TwoFactorPanel enabled={enabled} backupRemaining={backupRemaining} accountLabel={accountLabel} passkeys={passkeys} />
    )}

    <!-- FACE DATA. The applicant who asked for this wrote "there is no option in my account
         settings to disable or remove it", and she was right — so the link lives here, on the page
         somebody actually looks at when they want to change how they sign in. -->
    <div style="margin-top:26px;padding:16px 18px;background:#fff;border:1px solid rgba(17,17,17,0.12);border-radius:12px;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:#6b7280;margin:0 0 8px;">Face sign-in and facial data</p>
      <p style="font-size:13.5px;color:#374151;margin:0 0 10px;line-height:1.65;">
        See exactly what facial data your account holds, turn face sign-in off, and delete it. Your
        account, your applications and your other sign-in methods are unaffected.
      </p>
      <a href="/portal/face-data" style="display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border-radius:9px;border:1px solid rgba(17,17,17,0.18);color:#111;text-decoration:none;font-size:14px;font-weight:600;">Manage my facial data</a>
    </div>

    <p style="margin-top:18px;font-size:13px;"><a href="/portal" style="color:#DC5000;font-weight:600;">&larr; Back to portal</a></p>
  </section>
</BaseLayout>
