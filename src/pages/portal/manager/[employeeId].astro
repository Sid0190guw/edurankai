---
// /portal/manager/[employeeId] — ONE TEAM MEMBER, TEN SECTIONS, AND THE CONTROLS TO ACT.
//
// =================================================================================================
// THE URL CARRIES AN ID AND THAT IS NOT A HOLE
// =================================================================================================
//
// It is checked, not trusted. factsFor() runs canSeePerformanceOf() and then authorityBasisFor()
// before it reads a single row, and both come from the organization graph. Changing the id in the
// address bar to a colleague's produces the refusal sentence, not their page — and every WRITE below
// re-runs the same gate inside write.ts rather than relying on the render having passed it.
//
// =================================================================================================
// WHAT THIS PAGE PROMISES THE PERSON IT IS ABOUT
// =================================================================================================
//
// Everything here is drawn from ordinary work records they can already see on their own portal:
// their tasks, their daily reports, their attendance, feedback colleagues wrote for them. There is
// no monitoring, no screen capture, no keystroke log, no location, no health or wellbeing data, and
// no leave type or leave reason. The one conduct line is a COUNT that says HR holds the detail.
//
// AND NOTHING ON IT DECIDES ANYTHING. Every derived line renders lighter than a record, carries its
// confidence and its method, and can be opened to show exactly what was counted. The recommendations
// are addressed to a human who chooses.
//
// =================================================================================================
// POST-REDIRECT-GET, AND EVERY CONST ABOVE THE HANDLER
// =================================================================================================
//
// Every write POSTs and redirects with a message in the query string, so a refresh never resubmits.
// Every `const` is declared ABOVE the POST handler: `const` is not hoisted, and a handler reaching a
// later declaration throws on its first line while the page reports success — that pattern took down
// apply step 5 and the /admin/roles/diagnose Repair button on this project.
//
// NO CLIENT JAVASCRIPT. Disclosure is native <details>; forms are forms.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import { composeWorkspace } from '@/lib/workforce/composer';
import { resolvePerfViewer } from '@/lib/performance-scope';
import { feedbackFor, type FeedbackNote } from '@/lib/performance';
import {
  factsFor,
  actionHistory,
  acknowledgedSignalKeys,
  developmentActions,
  growthTimeline,
  developmentStatusLabel,
  DEFAULT_WINDOW_DAYS,
} from '@/lib/manager-intelligence/read';
import { schemaState } from '@/lib/manager-intelligence/schema';
import { signalsFor, signalsInSection, emptySectionSentence } from '@/lib/manager-intelligence/signals';
import { recommendationsFor, noRecommendationsSentence, NOTHING_DECIDED } from '@/lib/manager-intelligence/recommend';
import {
  recordFeedback,
  acknowledgeSignal,
  recordIntervention,
  requestHrSupport,
  createDevelopmentAction,
  updateDevelopmentAction,
} from '@/lib/manager-intelligence/write';
import {
  SECTION_KEYS,
  sectionLabel,
  evidenceStrengthLabel,
  actionKindLabel,
  urgencyLabel,
  type ManagerSignal,
} from '@/lib/manager-intelligence/types';

const employeeId = String(Astro.params.employeeId || '');
const PATH = '/portal/manager/' + employeeId;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

// ---- Constants and helpers, ALL declared before the POST handler ---------------------------------
const NOW = new Date();

const back = (msg: string) =>
  Astro.redirect(PATH + '?msg=' + encodeURIComponent(msg.slice(0, 400)));

const fmtDay = (iso: string | null): string =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const fmtWhen = (iso: string | null): string =>
  iso ? new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';

const pctText = (v: number): string => String(Math.round(v * 100)) + '%';

const basisSentence = (basis: string): string => {
  const k = String(basis || '');
  if (k === 'direct_report') return 'They are recorded as reporting to you.';
  if (k === 'review_subject') return 'You are recorded as a reviewer of their work.';
  if (k === 'responsible_via_org_graph') return 'The Organization Graph records you as answering for their work.';
  if (k === 'capability:performance.manage') return 'You hold organization-wide performance access. No direct relationship is recorded.';
  return 'A relationship is recorded for you.';
};

const directionWord = (d: string): string => {
  const k = String(d || '');
  if (k === 'positive') return 'Going well';
  if (k === 'attention') return 'Worth a look';
  return 'For context';
};

let composed: any = null;
try {
  composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
} catch (e: any) {
  console.error('[portal/manager/detail] compose', e?.cause?.message || e?.message);
}
const holds = (key: string): boolean => {
  try {
    return composed?.context?.holds ? composed.context.holds(key) === true : false;
  } catch {
    return false;
  }
};

const viewer = await resolvePerfViewer(String(user.id), holds);

// The signal set is needed by the POST handler too — an acknowledgement stores the snapshot of the
// signal it answers, and the snapshot has to be the one the manager was actually looking at.
const factsResult = await factsFor(viewer, employeeId, NOW, DEFAULT_WINDOW_DAYS);
const signals: ManagerSignal[] = factsResult.ok ? signalsFor(factsResult.facts, NOW.toISOString()) : [];
const signalByKey = (key: string): ManagerSignal | null => signals.find((s) => s.key === key) || null;

// =================================================================================================
// WRITES
// =================================================================================================
if (Astro.request.method === 'POST') {
  if (!factsResult.ok) return back(factsResult.sentence);

  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  const signal = signalByKey(String(fd.get('signal_key') || ''));

  if (action === 'feedback') {
    const r = await recordFeedback({
      viewer,
      subjectEmployeeId: employeeId,
      body: String(fd.get('body') || ''),
      theme: String(fd.get('theme') || 'general'),
      signal,
    });
    return back(r.ok
      ? ('Feedback recorded and sent to them.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not record that.'));
  }

  if (action === 'acknowledge') {
    if (!signal) return back('That signal is no longer on this page, so there was nothing to acknowledge.');
    const r = await acknowledgeSignal({
      viewer,
      subjectEmployeeId: employeeId,
      signal,
      note: String(fd.get('note') || ''),
    });
    return back(r.ok
      ? ('Acknowledged. It stays on the page, now with your reading beside it.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not record that.'));
  }

  if (action === 'intervention') {
    const r = await recordIntervention({
      viewer,
      subjectEmployeeId: employeeId,
      note: String(fd.get('note') || ''),
      signal,
      section: String(fd.get('section') || ''),
    });
    return back(r.ok
      ? ('Intervention recorded.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not record that.'));
  }

  if (action === 'hr_support') {
    const r = await requestHrSupport({
      viewer,
      subjectEmployeeId: employeeId,
      subject: String(fd.get('subject') || ''),
      body: String(fd.get('body') || ''),
      priority: String(fd.get('priority') || 'normal'),
      signal,
    });
    return back(r.ok
      ? ('Raised with the HR desk.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not raise that.'));
  }

  if (action === 'dev_create') {
    const r = await createDevelopmentAction({
      viewer,
      subjectEmployeeId: employeeId,
      title: String(fd.get('title') || ''),
      detail: String(fd.get('detail') || ''),
      targetDate: String(fd.get('target_date') || '') || null,
      visibleToEmployee: String(fd.get('visible') || 'yes') === 'yes',
      signal,
    });
    return back(r.ok
      ? ('Development action opened.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not open that.'));
  }

  if (action === 'dev_update') {
    const r = await updateDevelopmentAction({
      viewer,
      subjectEmployeeId: employeeId,
      developmentActionId: String(fd.get('dev_id') || ''),
      status: String(fd.get('status') || ''),
      outcomeNote: String(fd.get('outcome') || ''),
    });
    return back(r.ok
      ? ('Development action updated.' + (r.note ? ' ' + r.note : ''))
      : (r.error || 'Could not update that.'));
  }

  return back('That control is not one this page knows about, so nothing was changed.');
}

// =================================================================================================
// THE RENDER
// =================================================================================================
const msg = String(Astro.url.searchParams.get('msg') || '').slice(0, 400);
const schema = await schemaState();

const person = factsResult.ok ? factsResult.facts : null;
const authorityBasis = factsResult.ok ? factsResult.authorityBasis : '';
const recommendations = factsResult.ok ? recommendationsFor(signals) : [];
const acknowledged = factsResult.ok ? await acknowledgedSignalKeys(employeeId, String(user.id)) : [];
const acts = factsResult.ok ? await actionHistory(employeeId, 30) : [];
const devActions = factsResult.ok ? await developmentActions(employeeId, 30) : [];
const timeline = factsResult.ok ? await growthTimeline(viewer, employeeId, 40) : { ok: false, entries: [], sentence: '' };
const notes: FeedbackNote[] = factsResult.ok ? await feedbackFor(employeeId, { asManager: true, limit: 20 }) : [];

// EVERY COMPARISON HAPPENS HERE, NOT IN JSX. `<` and `<=` inside an Astro expression is one of this
// project's known compiler hazards, so the markup below reads only booleans and strings.
interface SignalView {
  key: string;
  headline: string;
  detail: string;
  direction: string;
  directionWord: string;
  strength: string;
  strengthLabel: string;
  processing: string;
  output: string;
  confidenceText: string;
  confidenceBasis: string;
  window: string;
  inputs: { label: string; value: string; source: string }[];
  evidence: { label: string; count: string }[];
  isAdvisory: boolean;
  isAcknowledged: boolean;
}

const toView = (s: ManagerSignal): SignalView => ({
  key: s.key,
  headline: s.headline,
  detail: s.detail,
  direction: s.direction,
  directionWord: directionWord(s.direction),
  strength: s.evidenceStrength,
  strengthLabel: evidenceStrengthLabel(s.evidenceStrength),
  processing: s.processing,
  output: s.output,
  confidenceText: pctText(s.confidence),
  confidenceBasis: s.confidenceBasis,
  window: fmtDay(s.observedFrom) + ' to ' + fmtDay(s.observedTo),
  inputs: s.inputs.map((i) => ({ label: i.label, value: i.value, source: i.source })),
  evidence: s.evidence.map((e) => ({
    label: e.label,
    count: e.count === null || e.count === undefined ? '' : String(e.count),
  })),
  isAdvisory: s.evidenceStrength === 'derived',
  isAcknowledged: acknowledged.indexOf(s.key) >= 0,
});

interface SectionView {
  key: string;
  label: string;
  signals: SignalView[];
  empty: string;
}

// The seven signal-bearing sections, in the order the brief lists them. recommended_actions,
// feedback and growth_timeline render their own blocks below and are excluded here.
const SIGNAL_SECTIONS = SECTION_KEYS.filter(
  (k) => k !== 'recommended_actions' && k !== 'feedback' && k !== 'growth_timeline',
);

const sections: SectionView[] = person
  ? SIGNAL_SECTIONS.map((key) => {
      const list = signalsInSection(signals, key).map(toView);
      return {
        key,
        label: sectionLabel(key),
        signals: list,
        empty: list.length ? '' : emptySectionSentence(key, person),
      };
    })
  : [];

interface RecView {
  key: string;
  headline: string;
  why: string;
  urgency: string;
  urgencyLabel: string;
  confidenceText: string;
  restsOn: string;
  restsOnLabel: string;
  from: string;
  suggests: string;
  suggestsLabel: string;
}

const recViews: RecView[] = recommendations.map((r) => ({
  key: r.key,
  headline: r.headline,
  why: r.why,
  urgency: r.urgency,
  urgencyLabel: urgencyLabel(r.urgency),
  confidenceText: pctText(r.confidence),
  restsOn: r.restsOn,
  restsOnLabel: evidenceStrengthLabel(r.restsOn),
  from: r.fromSignals.join(', '),
  suggests: r.suggests,
  suggestsLabel: actionKindLabel(r.suggests),
}));

// The signal picker on every form: a manager may attach an act to what prompted it.
const signalOptions = signals.map((s) => ({ key: s.key, label: sectionLabel(s.section) + ' — ' + s.headline.slice(0, 90) }));

const actViews = acts.map((a) => ({
  id: a.id,
  kind: actionKindLabel(a.kind),
  when: fmtWhen(a.createdAt),
  by: a.actorName || 'A manager',
  note: a.note || '',
  signalKey: a.signalKey || '',
  basis: a.authorityBasis,
}));

const devViews = devActions.map((d) => ({
  id: d.id,
  title: d.title,
  detail: d.detail || '',
  status: d.status,
  statusLabel: developmentStatusLabel(d.status),
  target: d.targetDate ? fmtDay(d.targetDate) : '',
  isOpen: d.status === 'open' || d.status === 'in_progress',
  visible: d.visibleToEmployee,
  outcome: d.outcomeNote || '',
  when: fmtWhen(d.createdAt),
}));

const noteViews = notes.map((n) => ({
  id: n.id,
  theme: n.theme,
  body: n.body,
  author: n.authorName || 'A colleague',
  when: fmtWhen(n.createdAt),
}));

const timelineViews = timeline.entries.map((t) => ({
  when: fmtWhen(t.at),
  origin: t.origin,
  originLabel: t.origin === 'hr_event' ? 'Organisation record' : 'Manager action',
  label: t.label,
  detail: t.detail,
  by: t.by || '',
}));

const readFailureLine = person && person.readFailures.length
  ? 'Some of this page could not be read just now (' + person.readFailures.join(', ')
    + '). Those sections show nothing rather than zero.'
  : '';

const title = person ? person.fullName : 'Team member';
const windowLine = person
  ? 'Last ' + String(person.window.days) + ' days, ' + fmtDay(person.window.fromIso) + ' to ' + fmtDay(person.window.toIso)
  : '';
const canWrite = schema.ok;
---
<EmployeeShell title={title} documentTitle={title + ' · My team'} back="/portal/manager" backLabel="My team" person={person && person.designation ? person.designation : ''} width={760} bare>
  <main class="wrap">

    {msg ? <div class="flash"><p>{msg}</p></div> : null}

    {!factsResult.ok ? (
      <div class="empty">
        <p>{factsResult.sentence}</p>
        <p class="quiet"><a href="/portal/manager">Back to my team</a></p>
      </div>
    ) : (
      <>
        <p class="scope">{basisSentence(authorityBasis)} {windowLine}</p>
        {readFailureLine ? <div class="note warn"><p>{readFailureLine}</p></div> : null}
        {canWrite ? null : <div class="note warn"><p>{schema.sentence}</p></div>}

        <div class="promise">
          <p>Everything below is drawn from work records this person can already see on their own
            portal: their tasks, their daily reports, their attendance, and feedback colleagues wrote
            for them. There is no screen capture, no keystroke log, no location, no health or wellbeing
            data, and neither the type nor the reason of any leave.</p>
        </div>

        {/* ---- 1 to 7: THE SIGNAL SECTIONS -------------------------------------------------- */}
        {sections.map((sec) => (
          <section class="sec">
            <h2>{sectionLabel(sec.key)}</h2>
            {sec.signals.length === 0 ? (
              <p class="quiet">{sec.empty}</p>
            ) : (
              <ul class="signals">
                {sec.signals.map((s) => (
                  <li class={s.isAdvisory ? 'signal advisory' : 'signal'}>
                    <div class="sighead">
                      <span class={'tag ' + s.direction}>{s.directionWord}</span>
                      <span class="tag quiet-tag">{s.strengthLabel}</span>
                      {s.isAcknowledged ? <span class="tag ack">You acknowledged this</span> : null}
                    </div>
                    <p class="sigline">{s.headline}</p>
                    <p class="sigdetail">{s.detail}</p>

                    <details class="why">
                      <summary>How this was worked out</summary>
                      <dl class="method">
                        <dt>Counted from</dt>
                        <dd>
                          <ul class="inputs">
                            {s.inputs.map((i) => (
                              <li><b>{i.label}:</b> {i.value} <span class="src">{i.source}</span></li>
                            ))}
                          </ul>
                        </dd>
                        <dt>Method</dt>
                        <dd>{s.processing}</dd>
                        <dt>Result</dt>
                        <dd>{s.output}</dd>
                        <dt>Evidence</dt>
                        <dd>
                          {s.evidence.length === 0 ? <span>No countable rows behind this one.</span> : (
                            <ul class="inputs">
                              {s.evidence.map((e) => (
                                <li>{e.label}{e.count ? ': ' + e.count : ''}</li>
                              ))}
                            </ul>
                          )}
                        </dd>
                        <dt>Confidence</dt>
                        <dd>{s.confidenceText} — {s.confidenceBasis}</dd>
                        <dt>Observed</dt>
                        <dd>{s.window}</dd>
                      </dl>
                    </details>

                    {canWrite ? (
                      <details class="act">
                        <summary>Acknowledge this</summary>
                        <form method="POST">
                          <input type="hidden" name="action" value="acknowledge" />
                          <input type="hidden" name="signal_key" value={s.key} />
                          <label for={'ack-' + s.key}>What you make of it (optional)</label>
                          <textarea id={'ack-' + s.key} name="note" rows="3" maxlength="4000"
                            placeholder="For example: the dates on those tasks were mine, not theirs."></textarea>
                          <p class="hint">Acknowledging does not hide the signal. It records your reading
                            beside it, at a higher weight than the number itself.</p>
                          <button type="submit">Record acknowledgement</button>
                        </form>
                      </details>
                    ) : null}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {/* ---- 8: RECOMMENDED MANAGEMENT ACTIONS -------------------------------------------- */}
        <section class="sec">
          <h2>{sectionLabel('recommended_actions')}</h2>
          <p class="quiet">{NOTHING_DECIDED}</p>
          {recViews.length === 0 ? (
            <p class="quiet">{noRecommendationsSentence(signals)}</p>
          ) : (
            <ul class="recs">
              {recViews.map((r) => (
                <li class={'rec ' + r.urgency}>
                  <span class="tag urgency">{r.urgencyLabel}</span>
                  <p class="sigline">{r.headline}</p>
                  <p class="sigdetail">{r.why}</p>
                  <p class="hint">Rests on: {r.restsOnLabel}. Confidence {r.confidenceText}. Drawn from {r.from}.</p>
                  {canWrite ? (
                    <details class="act">
                      <summary>Record what you did</summary>
                      <form method="POST">
                        <input type="hidden" name="action" value="intervention" />
                        <input type="hidden" name="signal_key" value={r.from.split(', ')[0]} />
                        <label for={'iv-' + r.key}>What you did about it</label>
                        <textarea id={'iv-' + r.key} name="note" rows="3" maxlength="4000" required
                          placeholder="For example: moved two urgent tasks to another owner and agreed the rest."></textarea>
                        <button type="submit">Record intervention</button>
                      </form>
                    </details>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </section>

        {/* ---- 9: FEEDBACK ------------------------------------------------------------------ */}
        <section class="sec">
          <h2>{sectionLabel('feedback')}</h2>
          {canWrite ? (
            <form method="POST" class="card-form">
              <input type="hidden" name="action" value="feedback" />
              <label for="fb-theme">Kind</label>
              <select id="fb-theme" name="theme">
                <option value="general">General note</option>
                <option value="strength">A strength</option>
                <option value="improvement">Something to improve</option>
              </select>

              <label for="fb-signal">About (optional)</label>
              <select id="fb-signal" name="signal_key">
                <option value="">Not about anything on this page</option>
                {signalOptions.map((o) => <option value={o.key}>{o.label}</option>)}
              </select>

              <label for="fb-body">Feedback</label>
              <textarea id="fb-body" name="body" rows="4" maxlength="4000" required
                placeholder="Write it as you would say it to them."></textarea>
              <p class="hint">They receive this and can read it in full. Feedback on this platform is never
                anonymous — your name is on it.</p>
              <button type="submit">Send feedback</button>
            </form>
          ) : null}

          {noteViews.length === 0 ? (
            <p class="quiet">No feedback has been left for this person that you are permitted to see.</p>
          ) : (
            <ul class="notes">
              {noteViews.map((n) => (
                <li class="note-row">
                  <span class="tag quiet-tag">{n.theme}</span>
                  <p class="sigdetail">{n.body}</p>
                  <p class="hint">{n.author} · {n.when}</p>
                </li>
              ))}
            </ul>
          )}
        </section>

        {/* ---- DEVELOPMENT ACTIONS ----------------------------------------------------------- */}
        <section class="sec">
          <h2>Development actions</h2>
          <p class="quiet">Things you and this person agreed to try. Closing one decides nothing: no
            rating, no probation state and no promotion follows from it.</p>

          {devViews.length === 0 ? (
            <p class="quiet">Nothing is being tracked yet.</p>
          ) : (
            <ul class="devs">
              {devViews.map((d) => (
                <li class={d.isOpen ? 'dev open' : 'dev closed'}>
                  <span class="tag quiet-tag">{d.statusLabel}</span>
                  {d.visible ? null : <span class="tag warn-tag">Not shared with them</span>}
                  <p class="sigline">{d.title}</p>
                  {d.detail ? <p class="sigdetail">{d.detail}</p> : null}
                  <p class="hint">Opened {d.when}{d.target ? ' · target ' + d.target : ''}</p>
                  {d.outcome ? <p class="hint">Outcome: {d.outcome}</p> : null}
                  {canWrite && d.isOpen ? (
                    <details class="act">
                      <summary>Move it on</summary>
                      <form method="POST">
                        <input type="hidden" name="action" value="dev_update" />
                        <input type="hidden" name="dev_id" value={d.id} />
                        <label for={'st-' + d.id}>Status</label>
                        <select id={'st-' + d.id} name="status">
                          <option value="in_progress">In progress</option>
                          <option value="done">Done</option>
                          <option value="dropped">Dropped</option>
                        </select>
                        <label for={'oc-' + d.id}>Outcome or reason</label>
                        <textarea id={'oc-' + d.id} name="outcome" rows="2" maxlength="4000"
                          placeholder="Required when dropping it."></textarea>
                        <button type="submit">Save</button>
                      </form>
                    </details>
                  ) : null}
                </li>
              ))}
            </ul>
          )}

          {canWrite ? (
            <details class="act wide">
              <summary>Open a development action</summary>
              <form method="POST">
                <input type="hidden" name="action" value="dev_create" />
                <label for="dv-title">What is being tried</label>
                <input id="dv-title" name="title" type="text" maxlength="200" required
                  placeholder="Agree the next three due dates together before work starts." />
                <label for="dv-detail">Detail (optional)</label>
                <textarea id="dv-detail" name="detail" rows="3" maxlength="4000"></textarea>
                <label for="dv-date">Target date (optional)</label>
                <input id="dv-date" name="target_date" type="date" />
                <label for="dv-signal">Prompted by (optional)</label>
                <select id="dv-signal" name="signal_key">
                  <option value="">Not from anything on this page</option>
                  {signalOptions.map((o) => <option value={o.key}>{o.label}</option>)}
                </select>
                <label for="dv-visible">Shared with them</label>
                <select id="dv-visible" name="visible">
                  <option value="yes">Yes — they can see it</option>
                  <option value="no">No — my own preparation note</option>
                </select>
                <p class="hint">Shared is the default on purpose. A development action about somebody that
                  they cannot see is a file being kept on them.</p>
                <button type="submit">Open development action</button>
              </form>
            </details>
          ) : null}
        </section>

        {/* ---- HR SUPPORT -------------------------------------------------------------------- */}
        <section class="sec">
          <h2>Ask HR for support</h2>
          <p class="quiet">This raises a real ticket on the HR desk, routed to a named owner. It is the
            right control when something here is beyond what a manager should handle alone.</p>
          {canWrite ? (
            <details class="act wide">
              <summary>Raise it with HR</summary>
              <form method="POST">
                <input type="hidden" name="action" value="hr_support" />
                <label for="hr-subject">Subject</label>
                <input id="hr-subject" name="subject" type="text" maxlength="200" required />
                <label for="hr-signal">About (optional)</label>
                <select id="hr-signal" name="signal_key">
                  <option value="">Not about anything on this page</option>
                  {signalOptions.map((o) => <option value={o.key}>{o.label}</option>)}
                </select>
                <label for="hr-body">What you need</label>
                <textarea id="hr-body" name="body" rows="4" maxlength="4000" required></textarea>
                <label for="hr-priority">Priority</label>
                <select id="hr-priority" name="priority">
                  <option value="normal">Normal</option>
                  <option value="high">High</option>
                  <option value="urgent">Urgent</option>
                </select>
                <p class="hint">Only what you write here goes to HR. The signals on this page are not
                  forwarded with it — a page of derived numbers crossing a desk without its subject
                  knowing is not a referral, it is a profile.</p>
                <button type="submit">Raise with HR</button>
              </form>
            </details>
          ) : null}
        </section>

        {/* ---- 10: GROWTH TIMELINE ----------------------------------------------------------- */}
        <section class="sec">
          <h2>{sectionLabel('growth_timeline')}</h2>
          {timeline.sentence ? <p class="quiet">{timeline.sentence}</p> : null}
          {timelineViews.length === 0 ? null : (
            <ol class="timeline">
              {timelineViews.map((t) => (
                <li class={'tl ' + t.origin}>
                  <span class="tag quiet-tag">{t.originLabel}</span>
                  <p class="sigline">{t.label}</p>
                  {t.detail ? <p class="sigdetail">{t.detail}</p> : null}
                  <p class="hint">{t.when}{t.by ? ' · ' + t.by : ''}</p>
                </li>
              ))}
            </ol>
          )}
        </section>

        {/* ---- THE ACT LOG ------------------------------------------------------------------- */}
        <section class="sec">
          <h2>What has been recorded here</h2>
          <p class="quiet">Every act on this page, append-only. This is what the person can ask to see,
            and what the next manager inherits.</p>
          {actViews.length === 0 ? (
            <p class="quiet">Nothing has been recorded from this screen yet.</p>
          ) : (
            <ul class="acts">
              {actViews.map((a) => (
                <li class="act-row">
                  <span class="tag quiet-tag">{a.kind}</span>
                  {a.note ? <p class="sigdetail">{a.note}</p> : null}
                  <p class="hint">{a.by} · {a.when}{a.signalKey ? ' · about ' + a.signalKey : ''} · authority: {a.basis}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )}
  </main>
</EmployeeShell>

<style is:global>
