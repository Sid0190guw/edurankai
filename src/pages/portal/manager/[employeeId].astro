  .tag.attention { background: var(--emp-warn-bg); border-color: var(--emp-warn-line); color: var(--emp-warn-ink); }
  .tag.ack { background: var(--emp-ok-bg); border-color: var(--emp-ok-line); color: var(--emp-ok-ink); }
  .tag.warn-tag { background: var(--emp-warn-bg); border-color: var(--emp-warn-line); color: var(--emp-warn-ink); }
