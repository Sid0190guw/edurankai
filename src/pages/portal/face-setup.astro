---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const url = new URL(Astro.request.url);
const next = url.searchParams.get('next') || '/portal';

// If already enrolled, skip straight to next (unless ?force=1 to re-enrol)
const force = url.searchParams.get('force') === '1';
let alreadyEnrolled = false;
try {
  const r = await db.execute(sql`SELECT id FROM user_face_enrollments WHERE user_id = ${user.id} AND is_active = true LIMIT 1`);
  const rows = Array.isArray(r) ? r : (r?.rows || []);
  alreadyEnrolled = rows.length > 0;
} catch (_) {}
if (alreadyEnrolled && !force) return Astro.redirect(next);

const firstName = (user.name || '').split(' ')[0] || 'there';
---
<BaseLayout title="Set up Face 2FA" description="Add face verification to secure your EduRankAI account." noindex={true}>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.min.js"></script>

  <section class="px-[5vw] py-10 md:py-14 max-w-xl mx-auto">
    <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-3">Account security</p>
    <h1 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-semibold text-ink leading-[1.1] tracking-tight mb-3">
      Set up <em class="italic text-burn font-medium">face verification.</em>
    </h1>
    <p class="text-[0.95rem] text-ink-soft leading-relaxed mb-6">
      {firstName}, add a face check to your account. On future sign-ins you'll confirm it's really you with a quick look at the camera - a second factor on top of your password. The photo never leaves your browser; only a numeric face signature is stored.
    </p>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 text-[0.85rem] text-amber-900 leading-relaxed">
      <strong>Tip:</strong> Good, even lighting. Face the camera straight on. Remove sunglasses or a mask. You can re-enrol any time from your account settings.
    </div>

    <div class="bg-white border border-ink/10 rounded-2xl overflow-hidden mb-5">
      <div class="bg-black aspect-[3/4] relative max-h-[420px]">
        <video id="videoEl" autoplay playsinline muted class="w-full h-full object-cover" style="transform:scaleX(-1);"></video>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-[55%] aspect-[3/4] border-[2.5px] rounded-full" style="border-color:rgba(255,79,0,0.7);"></div>
        </div>
        <div class="absolute bottom-3 left-0 right-0 text-center">
          <span id="camStatus" class="bg-black/75 text-white font-mono text-[11px] tracking-[0.16em] uppercase px-3.5 py-1.5 rounded-full">Loading face model…</span>
        </div>
      </div>
      <div class="h-[3px] bg-ink/10">
        <div id="progFill" class="h-full bg-burn transition-[width] duration-300" style="width:0%;"></div>
      </div>
      <button id="enrollBtn" type="button" disabled class="w-full border-0 font-display text-[0.95rem] font-semibold tracking-[0.04em] py-4 cursor-pointer bg-ink text-white disabled:opacity-60">Scanning…</button>
      <p id="camHelp" hidden class="text-[0.8rem] text-ink-soft leading-relaxed px-4 py-3 bg-cream-2 border-t border-ink/10"></p>
    </div>

    {/* Identity document as a LINK, not an upload. Consistent with the rest of the platform, where
        documents of any kind are shared as Drive links rather than stored — it avoids holding
        government ID images on our infrastructure at all, and removes the dependency on a blob store
        that was not configured in production (the upload simply failed with "not set up on this
        server"). The applicant keeps control and can revoke access after review. */}
    <div class="bg-white border border-ink/10 rounded-2xl p-5 mb-5">
      <p class="text-[0.7rem] font-mono uppercase tracking-wider text-burn font-bold mb-2">Identity document</p>
      <p class="text-[0.85rem] text-ink-soft mb-3">
        Share a clear photo or PDF of your government photo ID as a <strong>Google Drive link</strong>,
        set to <strong>&ldquo;Anyone with the link&rdquo;</strong>. A reviewer checks it against your
        face. We never store a copy, so you can revoke access once verification is done.
      </p>
      <div class="flex gap-2 flex-wrap">
        <input type="url" id="idDocUrl" inputmode="url" placeholder="https://drive.google.com/..."
          class="flex-1 min-w-[220px] text-[0.85rem] border border-ink/15 rounded-lg px-3 py-2.5" />
        <button type="button" id="idDocSave" class="bg-ink text-white border-0 rounded-lg font-semibold text-[0.85rem] px-4 py-2.5 cursor-pointer">Save link</button>
      </div>
      <p id="idDocStatus" class="text-[0.8rem] text-ink-soft mt-2"></p>
      <p class="text-[0.76rem] text-ink-soft/70 mt-2 leading-relaxed">
        In Drive: right-click the file &rarr; Share &rarr; General access &rarr; Anyone with the link.
        If we cannot open it, verification cannot be completed.
      </p>
    </div>

    <div class="flex items-center justify-between flex-wrap gap-3">
      <a href={next} class="text-[0.82rem] text-ink-soft hover:text-ink underline underline-offset-2">Skip for now</a>
      <p id="resultMsg" class="text-[0.82rem]"></p>
    </div>
  </section>

  <script is:inline define:vars={{ nextUrl: next }}>
    var video = document.getElementById('videoEl');
    var enrollBtn = document.getElementById('enrollBtn');
    var camStatus = document.getElementById('camStatus');
    var progFill = document.getElementById('progFill');
    var resultMsg = document.getElementById('resultMsg');
    var ready = false;

    function setStatus(msg, color) { camStatus.style.color = color || '#fff'; camStatus.textContent = msg; }

    var MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
    var options;

    async function detectBest() {
      // Full-accuracy pipeline: SSD MobileNet detector + 68-pt landmarks + recognition net.
      var all = await faceapi.detectAllFaces(video, options).withFaceLandmarks().withFaceDescriptors();
      if (!all || all.length === 0) return { error: 'No face detected. Center your face in the oval.' };
      if (all.length > 1) return { error: 'Multiple faces in frame. Only you should be visible.' };
      var d = all[0];
      var box = d.detection.box;
      var score = d.detection.score || 0;
      // Reject low-confidence / too-small (far away or spoofed) faces.
      if (score < 0.6) return { error: 'Face not clear enough. Improve lighting, face the camera.' };
      var vw = video.videoWidth || 640;
      if (box.width < vw * 0.22) return { error: 'Move closer - your face is too small in frame.' };
      return { descriptor: d.descriptor };
    }

    async function init() {
      if (!('mediaDevices' in navigator)) { setStatus('Camera not available', '#ef4444'); return; }
      try {
        setStatus('Loading high-accuracy model…');
        progFill.style.width = '20%';
        // Initialise the TF backend BEFORE detection (else detect throws "backend not initialized").
        try {
          if (window.faceapi && faceapi.tf) {
            try { await faceapi.tf.setBackend('webgl'); } catch (_) {}
            if (faceapi.tf.getBackend && !faceapi.tf.getBackend()) { try { await faceapi.tf.setBackend('wasm'); } catch (_) {} }
            if (faceapi.tf.ready) await faceapi.tf.ready();
          }
        } catch (_) {}
        await Promise.all([
          faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
          faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
        ]);
        options = new faceapi.SsdMobilenetv1Options({ minConfidence: 0.5 });
        progFill.style.width = '60%';
        var stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 720 } });
        video.srcObject = stream;
        progFill.style.width = '100%';
        setTimeout(function() {
          progFill.style.width = '0%';
          ready = true;
          enrollBtn.disabled = false;
          enrollBtn.textContent = 'Capture & enable Face 2FA';
          enrollBtn.style.background = '#FF4F00';
          setStatus('Center your face in the oval', '#7dd3a8');
        }, 300);
      } catch (e) {
        // The button previously stayed disabled reading "Scanning…" forever after a camera failure,
        // so a denied permission looked like the page had hung and there was no way back. Name the
        // actual problem, say how to fix it, and leave a working button.
        progFill.style.width = '0%';
        var name = (e && (e.name || '')) + '';
        var denied = name === 'NotAllowedError' || name === 'SecurityError' || /denied|permission/i.test(e && e.message || '');
        var missing = name === 'NotFoundError' || name === 'DevicesNotFoundError';
        var busy = name === 'NotReadableError' || name === 'TrackStartError';

        var msg = denied ? 'Camera blocked. Allow camera access for this site, then tap Retry.'
          : missing ? 'No camera found on this device.'
          : busy ? 'Your camera is in use by another app. Close it, then tap Retry.'
          : 'Camera error: ' + ((e && e.message) || 'unknown');
        setStatus(msg, '#ef4444');

        enrollBtn.disabled = false;
        enrollBtn.textContent = 'Retry camera';
        enrollBtn.style.background = '#FF4F00';
        enrollBtn.dataset.retry = '1';

        var help = document.getElementById('camHelp');
        if (help) {
          help.hidden = false;
          help.textContent = denied
            ? 'Tap the icon at the left of the address bar, set Camera to Allow, then tap Retry. Face 2FA is optional — you can skip it and keep signing in with your password, passkey or authenticator app.'
            : 'Face 2FA is optional — you can skip it and keep signing in with your password, passkey or authenticator app.';
        }
      }
    }

    function avgDescriptors(list) {
      var out = new Array(128).fill(0);
      list.forEach(function(d) { for (var i = 0; i < 128; i++) out[i] += d[i]; });
      for (var j = 0; j < 128; j++) out[j] /= list.length;
      return out;
    }

    // Liveness: require a real blink before enrolling, so a photo can't enrol.
    function eyeAspect(eye) {
      function d(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }
      return (d(eye[1], eye[5]) + d(eye[2], eye[4])) / (2 * d(eye[0], eye[3]));
    }
    // Adaptive blink: every face/camera has a different open-eye aspect ratio, so
    // fixed thresholds fail for many people. Instead we learn each person's OPEN
    // baseline (running max) and detect a clear relative dip (eyes closing well
    // below their own open value) followed by re-opening — works across faces,
    // glasses and lighting. Absolute thresholds kept as a secondary trigger.
    async function requireBlink(timeoutMs) {
      var start = Date.now();
      var openMax = 0;     // running estimate of this person's open-eye EAR
      var sawLow = false;  // eyes clearly more closed than their open baseline
      var prev = 0;
      while (Date.now() - start < timeoutMs) {
        try {
          var all = await faceapi.detectAllFaces(video, options).withFaceLandmarks();
          if (all && all.length > 1) return { multi: true };
          if (all && all.length === 1) {
            var lm = all[0].landmarks;
            var raw = (eyeAspect(lm.getLeftEye()) + eyeAspect(lm.getRightEye())) / 2;
            var e = prev ? (prev * 0.4 + raw * 0.6) : raw; // light smoothing
            prev = e;
            if (e > openMax) openMax = e; // baseline only grows toward the true open value
            // relative blink: dropped >28% below the open baseline, then recovered
            if (openMax > 0.12 && e < openMax * 0.72) sawLow = true;
            else if (sawLow && e > openMax * 0.85) return true;
            // absolute fallback for clear closes
            if (e < 0.17) sawLow = true;
            else if (sawLow && e > 0.26) return true;
          }
        } catch (_) {}
        await new Promise(function(res){ setTimeout(res, 70); });
      }
      return false;
    }

    enrollBtn.addEventListener('click', async function() {
      // Retry path after a camera failure — re-run init() rather than falling through to capture,
      // which would immediately fail again on a null stream.
      if (enrollBtn.dataset.retry === '1') {
        enrollBtn.dataset.retry = '';
        enrollBtn.disabled = true;
        enrollBtn.textContent = 'Scanning…';
        enrollBtn.style.background = '';
        var help = document.getElementById('camHelp');
        if (help) help.hidden = true;
        setStatus('Requesting camera…', '#7dd3a8');
        init();
        return;
      }
      if (!ready) return;
      enrollBtn.disabled = true;
      enrollBtn.textContent = 'Capturing…';
      setStatus('Hold still — capturing your face', '#fbbf24');
      // NOTE: the blink liveness gate was removed — it was unreliable across
      // cameras/lighting and locked people out of 2FA. We capture the face
      // directly; a human reviewer still verifies the ID document separately.
      // Multi-sample: collect several consistent descriptors and average them so
      // the stored signature is stable and matching can be strict.
      var samples = [];
      var attempts = 0;
      var lastErr = '';
      try {
        while (samples.length < 3 && attempts < 10) {
          attempts++;
          setStatus('Hold still… ' + (samples.length + 1) + ' / 3', '#fbbf24');
          var r = await detectBest();
          if (r.descriptor) {
            if (samples.length > 0) {
              var dist = faceapi.euclideanDistance(new Float32Array(r.descriptor), new Float32Array(samples[0]));
              if (dist > 0.65) { lastErr = 'Keep still - readings varied too much.'; continue; }
            }
            samples.push(Array.from(r.descriptor));
          } else {
            lastErr = r.error || 'No face detected - center your face in the oval.';
          }
          await new Promise(function(res){ setTimeout(res, 60); });
        }
        if (samples.length < 1) {
          setStatus(lastErr || 'Could not capture a clear face. Try again.', '#ef4444');
          enrollBtn.disabled = false; enrollBtn.textContent = 'Try again';
          return;
        }
        var descriptor = avgDescriptors(samples);
        // Capture the enrolment frame itself. For employees this becomes their profile photo,
        // so the picture on record is the one taken at face verification.
        var selfie = '';
        try {
          var shot = document.createElement('canvas');
          var sw = video.videoWidth || 480, sh = video.videoHeight || 480;
          var side = Math.min(sw, sh);                   // square crop, centred on the face
          shot.width = 320; shot.height = 320;
          var sctx = shot.getContext('2d');
          sctx.translate(shot.width, 0); sctx.scale(-1, 1);   // un-mirror the preview
          sctx.drawImage(video, (sw - side) / 2, (sh - side) / 2, side, side, 0, 0, 320, 320);
          selfie = shot.toDataURL('image/jpeg', 0.82);
        } catch (_) { selfie = ''; }
        var res = await fetch('/api/auth/enroll-face-selfie', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ faceDescriptor: descriptor, selfie: selfie })
        });
        var data = await res.json();
        if (data && data.ok) {
          progFill.style.background = '#10b981';
          progFill.style.width = '100%';
          setStatus('Face 2FA enabled. Redirecting…', '#10b981');
          enrollBtn.textContent = 'Done';
          enrollBtn.style.background = '#10b981';
          if (resultMsg) { resultMsg.textContent = 'Saved'; resultMsg.style.color = '#10b981'; }
          try { (video.srcObject && video.srcObject.getTracks().forEach(function(t){t.stop();})); } catch(_) {}
          setTimeout(function() { window.location.href = nextUrl; }, 900);
        } else {
          setStatus((data && data.error) || 'Could not save. Try again.', '#ef4444');
          enrollBtn.disabled = false; enrollBtn.textContent = 'Try again';
        }
      } catch (e) {
        setStatus('Error: ' + e.message, '#ef4444');
        enrollBtn.disabled = false; enrollBtn.textContent = 'Try again';
      }
    });

    // Optional ID document, stored as a LINK for human review. Does not block 2FA.
    // Previously this uploaded the file to a blob store, which was never configured in production —
    // so every attempt failed with "Image upload is not set up on this server". Storing a link
    // instead matches how documents are handled everywhere else on the platform and means no
    // government ID image is ever held on our infrastructure.
    var idDocUrl = document.getElementById('idDocUrl');
    var idDocSave = document.getElementById('idDocSave');
    var idDocStatus = document.getElementById('idDocStatus');
    if (idDocUrl && idDocSave) {
      var setDoc = function (msg, colour) { idDocStatus.textContent = msg; idDocStatus.style.color = colour; };
      idDocSave.addEventListener('click', function () {
        var url = (idDocUrl.value || '').trim();
        if (!url) { setDoc('Paste the link to your ID first.', '#b91c1c'); return; }
        // Only accept a real http(s) URL — a pasted file path or Drive "open in app" text cannot be
        // opened by a reviewer, and failing loudly here saves a rejected verification later.
        var parsed;
        try { parsed = new URL(url); } catch (_) { setDoc('That does not look like a link. It should start with https://', '#b91c1c'); return; }
        if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') { setDoc('The link must start with https://', '#b91c1c'); return; }

        idDocSave.disabled = true;
        setDoc('Saving…', '#92400e');
        fetch('/api/auth/save-id-doc', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: url }),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            idDocSave.disabled = false;
            if (d && d.ok) setDoc('Link saved - our team will verify it. Make sure sharing is set to "Anyone with the link".', '#166534');
            else setDoc((d && d.error) || 'Could not save that link.', '#b91c1c');
          })
          .catch(function () { idDocSave.disabled = false; setDoc('Network error - try again.', '#b91c1c'); });
      });
    }

    init();
  </script>
</BaseLayout>
