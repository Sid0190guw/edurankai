---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { getThread, markApplicantRead } from '@/lib/request-threads';

const user = Astro.locals.user;
const { id } = Astro.params;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/requests/visvambhara/' + (id || '')));
if (user.role !== 'applicant') return Astro.redirect('/admin');

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// A MALFORMED SEGMENT IS NOT AN OUTAGE. Postgres rejects a non-UUID cast, which landed in the catch
// below and answered a mistyped or stale link with 503 "a fault at our end, nothing has changed" —
// and wrote an error log for a typo. Validated up front so the catch keeps meaning what it says.
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(id || ''))) {
  return Astro.redirect('/portal/requests');
}

let req: any = null;
// Declared BEFORE the try that sets it — `let` is not hoisted in a way a later reader can rely on.
let readFailed = false;
try {
  const r = await db.execute(sql`
    SELECT id, status, note, cv_url, reject_reason, created_at, reviewed_at,
      COALESCE(last_message_at, created_at) AS last_message_at
    FROM visvambhara_access_requests
    WHERE id = ${id} AND user_id = ${user.id} LIMIT 1
  `);
  req = rows(r)[0] || null;
} catch (e: any) {
  // "THIS DOES NOT EXIST" AND "I COULD NOT LOOK" ARE DIFFERENT ANSWERS, AND ONLY ONE OF THEM IS
  // THE APPLICANT'S PROBLEM. This was `catch (_) {}`, and the very next line redirects on a null
  // `req` — so a pooler timeout bounced somebody straight off their own access request to the list,
  // with nothing said and nothing logged. It is indistinguishable from following a link to a
  // request that was deleted, and the reasonable response to that is to raise a second one.
  readFailed = true;
  console.error('[portal/requests/visvambhara_access] request read failed for', id, '-', e?.cause?.message || e?.message);
}
if (readFailed) {
  return new Response(
    'We could not open that request just now — this is a fault at our end, not a sign that it is gone. '
    + 'Nothing has changed. Please try again in a moment; your requests are always listed at /portal/requests.',
    { status: 503, headers: { 'content-type': 'text/plain; charset=utf-8' } },
  );
}
if (!req) return Astro.redirect('/portal/requests');

// THE CONVERSATION IS THE POINT OF THIS PAGE. Both calls were bare top-level awaits, so a failure
// was a 500 with no explanation. The read is reported instead: an empty thread and an unreadable
// one must not draw the same "No messages yet" panel, because the second one hides a reply the
// admissions team has already sent.
let threadFailed = false;
try {
  await markApplicantRead('visvambhara_access', String(id));
} catch (e: any) {
  // Losing the read-marker only leaves an unread dot showing; it must not stop the thread rendering.
  console.error('[portal/requests/visvambhara_access] read marker failed for', id, '-', e?.cause?.message || e?.message);
}
let messages: any[] = [];
try {
  messages = await getThread('visvambhara_access', String(id));
} catch (e: any) {
  threadFailed = true;
  console.error('[portal/requests/visvambhara_access] thread read failed for', id, '-', e?.cause?.message || e?.message);
}

function fmt(d: any): string {
  try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch { return ''; }
}
function statusBadge(s: string) {
  const map: any = {
    pending: { bg: 'rgba(250,204,21,0.12)', fg: '#92400e', border: 'rgba(250,204,21,0.35)' },
    approved: { bg: 'rgba(16,185,129,0.10)', fg: '#047857', border: 'rgba(16,185,129,0.35)' },
    rejected: { bg: 'rgba(239,68,68,0.10)', fg: '#991b1b', border: 'rgba(239,68,68,0.35)' },
  };
  return map[s] || map.pending;
}
const badge = statusBadge(req.status);
---
<BaseLayout title="Restricted research access request" description="Your request thread with the research team.">
  <section class="px-[5vw] py-8 md:py-12 max-w-3xl mx-auto">
    <a href="/portal/requests" class="text-[0.78rem] font-mono uppercase tracking-wider text-burn hover:underline">← All requests</a>
    <div class="mt-4 mb-6">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn font-bold mb-1">Restricted research access</p>
      <h1 class="font-display text-[clamp(1.6rem,4vw,2.2rem)] font-semibold text-ink leading-[1.15] mb-3">Your request thread</h1>
      <span style={'display:inline-block;font-family:JetBrains Mono,monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;padding:4px 12px;border-radius:100px;background:' + badge.bg + ';color:' + badge.fg + ';border:1px solid ' + badge.border + ';'}>{req.status}</span>
    </div>

    <div class="bg-cream-2 border border-ink/10 rounded-2xl p-5 mb-5">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-2">Your original note</p>
      <p class="text-[0.92rem] text-ink leading-[1.7] whitespace-pre-wrap">{req.note}</p>
      {req.cv_url && <p class="text-[0.78rem] mt-3"><a href={req.cv_url} target="_blank" rel="noopener" class="text-burn font-semibold hover:underline">Your CV link →</a></p>}
      {req.reject_reason && (
        <div class="mt-4 pt-4 border-t border-ink/8">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-red-700 font-bold mb-2">Reviewer note</p>
          <p class="text-[0.88rem] text-ink leading-relaxed">{req.reject_reason}</p>
        </div>
      )}
    </div>

    <div class="mb-3">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold">Conversation</p>
    </div>

    {threadFailed && (
      <div class="bg-white border border-amber-300 rounded-xl p-5 mb-4 text-[0.85rem] text-amber-900">
        The conversation on this request could not be loaded just now, so this is not a record of what
        has been said. Nothing has been lost — please reload in a moment.
      </div>
    )}
    {!threadFailed && messages.length === 0 ? (
      <div class="bg-white border border-ink/10 rounded-xl p-5 mb-4 text-[0.85rem] text-ink-soft text-center">
        No replies yet. The research team will respond here when your request is reviewed.
      </div>
    ) : (
      <div class="space-y-3 mb-4">
        {messages.map((m: any) => (
          <div class={'rounded-xl p-4 ' + (m.sender_role === 'admin' ? 'bg-burn-pale border border-burn-dim' : 'bg-white border border-ink/10 ml-8')}>
            <div class="flex items-baseline justify-between gap-3 mb-1">
              <p class="text-[0.62rem] font-mono uppercase tracking-[0.12em] font-bold" style={m.sender_role === 'admin' ? 'color:#b85e3f;' : 'color:#5b5b5b;'}>{m.sender_role === 'admin' ? 'Research team · ' + (m.sender_name || 'EduRankAI') : 'You'}</p>
              <p class="text-[0.72rem] font-mono text-ink-soft">{fmt(m.created_at)}</p>
            </div>
            <p class="text-[0.92rem] text-ink leading-[1.65] whitespace-pre-wrap">{m.body}</p>
          </div>
        ))}
      </div>
    )}

    <form id="replyForm" class="bg-white border border-ink/10 rounded-xl p-4 mb-6">
      <label class="block text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-2">Reply to the research team</label>
      <textarea id="replyBody" rows="4" maxlength="5000" placeholder="Add detail, share an updated CV link, or answer a question above..." class="w-full px-3 py-2.5 border border-ink/15 rounded-lg text-[0.9rem] outline-none focus:border-burn bg-white resize-y leading-relaxed"></textarea>
      <div class="flex items-center gap-3 mt-3">
        <button type="submit" class="bg-burn hover:bg-burn/90 text-white font-semibold py-2.5 px-5 rounded-lg text-[0.88rem] transition-all">Send reply</button>
        <p id="replyMsg" class="text-[0.78rem] text-ink-soft"></p>
      </div>
    </form>
  </section>

  <script is:inline define:vars={{ requestId: id }}>
    (function () {
      var form = document.getElementById('replyForm');
      var ta = document.getElementById('replyBody');
      var msg = document.getElementById('replyMsg');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var body = (ta.value || '').trim();
        if (!body) { msg.textContent = 'Type a message first.'; return; }
        msg.textContent = 'Sending...';
        fetch('/api/portal/requests/visvambhara/reply', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ requestId: requestId, body: body }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.ok) { msg.textContent = 'Sent. Reloading…'; setTimeout(function () { location.reload(); }, 600); }
            else { msg.textContent = d.error || 'Failed'; }
          })
          .catch(function () { msg.textContent = 'Network error.'; });
      });
    })();
  </script>
</BaseLayout>
