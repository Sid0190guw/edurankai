---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import {
  ensureAppealsSchema, APPEAL_KINDS,
  appendAppealMessage, listAppealMessagesFor, groupMessagesByAppeal,
} from '@/lib/application-appeals';
import { notifyAllAdmins } from '@/lib/notify';
import { safeRows, dbReason } from '@/lib/page-safety';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/appeals'));
await ensureAppealsSchema();

let okMsg = '';
let errMsg = '';

// THE APPELLANT CAN NOW REPLY.
//
// application_appeal_messages has existed (with an index) since this feature shipped, and nothing
// in the repository ever wrote to it or read it. So a person contesting a rejection stated their
// grounds once and then had no way to answer a reviewer's question or add a fact — the schema
// described a conversation that neither side could hold.
//
// Ownership is enforced inside appendAppealMessage() by making the INSERT conditional on the appeal
// belonging to this user, so editing the hidden field posts nothing.
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const res = await appendAppealMessage({
    appealId: String(fd.get('appeal_id') || ''),
    senderRole: 'appellant',
    senderUserId: user.id,
    senderName: user.name || user.email || 'Appellant',
    body: String(fd.get('body') || ''),
    requireUserId: user.id,
  });
  if (res.ok) {
    okMsg = 'Your message was added to the appeal. The reviewer can see it.';
    // The reviewers are told. Without this the message lands in a table nobody is watching, which
    // is the same silence the appeal itself used to arrive in.
    await notifyAllAdmins({
      title: 'Appeal reply from ' + (user.name || user.email || 'an appellant'),
      body: String(fd.get('body') || '').trim().slice(0, 160),
      type: 'message',
      actionUrl: '/admin/appeals',
      entityType: 'application_appeal',
      entityId: res.message.appeal_id,
    });
  } else {
    errMsg = 'Your message was NOT saved. ' + res.reason;
  }
}

// The list read used to be a bare top-level await: a database hiccup took the whole page to a 500
// with no explanation. It now reports, and "we could not read your appeals" is never drawn as
// "you have no appeals on file".
const mineRead = await safeRows<any>('[portal/appeals] my appeals', () => db.execute(sql`
  SELECT aa.*, a.role_title_snapshot FROM application_appeals aa
  LEFT JOIN applications a ON aa.application_id = a.id
  WHERE aa.user_id = ${user.id} ORDER BY aa.created_at DESC LIMIT 100
`));
const mine = mineRead.rows;
const listError = mineRead.ok ? null : mineRead.error;

// One statement for every thread on the page, not one per appeal.
const threadRead = await listAppealMessagesFor(mine.map((a: any) => String(a.id)));
const threads = threadRead.ok ? groupMessagesByAppeal(threadRead.rows) : {};
const threadError = threadRead.ok ? null : threadRead.reason;

function fmt(d: any) { try { return new Date(d).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' }); } catch { return ''; } }
function fmtTime(d: any) { try { return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: 'numeric', minute: '2-digit' }); } catch { return ''; } }
---
<BaseLayout title="My appeals · EduRankAI">
<section class="px-[5vw] pt-10 md:pt-14 pb-6 max-w-3xl mx-auto">
  <a href="/portal" class="text-[0.78rem] font-mono uppercase tracking-wider text-burn hover:underline no-underline">Portal home</a>
  <div class="mt-5 mb-6 flex justify-between items-end flex-wrap gap-3">
    <div>
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.18em] text-burn font-bold mb-2">Recruitment</p>
      <h1 class="font-display text-[clamp(1.8rem,4.5vw,2.5rem)] font-semibold text-ink leading-[1.1] mb-1">My appeals</h1>
      <p class="text-[0.9rem] text-ink-soft m-0">
        {listError ? 'Your appeals could not be loaded' : mine.length + ' on record · responses within 10 business days'}
      </p>
    </div>
    <a href="/portal/appeals/new" class="btn-primary">New appeal</a>
  </div>
</section>
<section class="px-[5vw] pb-20 max-w-3xl mx-auto">

  {okMsg && <div class="mb-4 bg-leaf-bg border border-leaf-border rounded-2xl p-4"><p class="text-[0.9rem] text-ink-2 m-0">{okMsg}</p></div>}
  {errMsg && <div class="mb-4 bg-burn-pale border border-burn-dim rounded-2xl p-4"><p class="text-[0.9rem] text-ink-2 m-0">{errMsg}</p></div>}

  {listError ? (
    <div class="bg-burn-pale border border-burn-dim rounded-2xl p-6">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-burn font-bold mb-2">Your appeals could not be read</p>
      <p class="text-[0.95rem] text-ink-2 leading-[1.6] m-0">
        This page is NOT telling you that you have no appeals on file. The record could not be reached just now.
        Nothing you filed has been lost. Please reload in a moment.
      </p>
      <p class="mt-2 text-[0.72rem] font-mono text-ink-soft break-words">{listError}</p>
    </div>
  ) : mine.length === 0 ? (
    <div class="bg-cream-2/60 border border-ink/10 rounded-2xl p-8 text-center">
      <p class="text-[0.95rem] text-ink-soft m-0">No appeals on file. If you believe a decision should be reviewed, submit one.</p>
    </div>
  ) : (
    <div class="space-y-3">
      {mine.map((a: any) => {
        const k = (APPEAL_KINDS as any)[a.appeal_kind] || APPEAL_KINDS.other;
        const tone = a.status === 'upheld' ? 'bg-leaf-bg text-leaf border-leaf-border'
          : a.status === 'denied' ? 'bg-burn-pale text-burn border-burn-dim'
          : a.status === 'reviewing' ? 'bg-gold-bg text-gold-deep border-gold-border'
          : 'bg-sky-bg text-sky border-sky-border';
        const msgs = threads[String(a.id)] || [];
        return (
          <article class="bg-white border border-ink/10 rounded-2xl p-5">
            <div class="flex justify-between flex-wrap gap-2 mb-2">
              <div>
                <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-burn font-bold mb-1">{k.label}</p>
                <p class="font-display text-[1.05rem] font-semibold text-ink m-0">{a.role_title_snapshot || 'Application'}</p>
                <p class="text-[0.75rem] text-ink-soft m-0 mt-1 font-mono">Filed {fmt(a.created_at)}</p>
              </div>
              <span class={`font-mono text-[0.62rem] uppercase tracking-[0.14em] font-bold px-2.5 py-1 rounded-full border ${tone} h-fit`}>{a.status}</span>
            </div>
            <p class="text-[0.85rem] text-ink-2 leading-relaxed m-0 mt-2 whitespace-pre-wrap">{a.grounds}</p>
            {a.decision_note && (
              <div class="mt-3 bg-cream-2/60 border-l-2 border-burn rounded-r-lg px-3 py-2">
                <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-burn font-bold m-0 mb-1">Reviewer's decision note</p>
                <p class="text-[0.84rem] text-ink-2 m-0 whitespace-pre-wrap">{a.decision_note}</p>
              </div>
            )}

            <!-- The thread -->
            <div class="mt-4 pt-4 border-t border-ink/10">
              <p class="text-[0.62rem] font-mono uppercase tracking-[0.14em] text-ink-soft font-bold mb-2">Correspondence</p>

              {threadError ? (
                <div class="bg-burn-pale border border-burn-dim rounded-xl px-3 py-2 mb-3">
                  <p class="text-[0.82rem] text-ink-2 m-0">The messages on this appeal could not be read — this is not an empty thread.</p>
                  <p class="text-[0.7rem] font-mono text-ink-soft m-0 mt-1 break-words">{threadError}</p>
                </div>
              ) : msgs.length === 0 ? (
                <p class="text-[0.84rem] text-ink-soft m-0 mb-3">No messages yet. Use the box below to add a fact or answer a reviewer.</p>
              ) : (
                <ul class="space-y-2 mb-3 list-none p-0 m-0">
                  {msgs.map((m: any) => {
                    const fromMe = m.sender_role === 'appellant';
                    return (
                      <li class={(fromMe ? 'bg-cream-2/60 border-ink/10' : 'bg-burn-pale border-burn-dim') + ' border rounded-xl px-3 py-2'}>
                        <p class="text-[0.62rem] font-mono uppercase tracking-[0.12em] font-bold m-0 mb-1 text-ink-soft">
                          {fromMe ? 'You' : 'Reviewer'}{m.sender_name && !fromMe ? ' · ' + m.sender_name : ''} · {fmtTime(m.created_at)}
                        </p>
                        <p class="text-[0.86rem] text-ink-2 m-0 whitespace-pre-wrap">{m.body}</p>
                      </li>
                    );
                  })}
                </ul>
              )}

              <form method="POST" class="mt-2">
                <input type="hidden" name="appeal_id" value={a.id} />
                <label class="sr-only" for={'reply-' + a.id}>Message about this appeal</label>
                <textarea id={'reply-' + a.id} name="body" rows="3" required maxlength="6000"
                  placeholder="Add a fact, answer a question, or ask about the process."
                  class="w-full bg-cream border border-ink/15 rounded-xl px-3 py-2 text-[0.9rem] text-ink focus:border-burn focus:outline-none resize-y"></textarea>
                <button type="submit" class="mt-2 btn-primary text-[0.82rem]">Post message</button>
              </form>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>
</BaseLayout>
