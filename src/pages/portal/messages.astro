<!-- Fingerprint modal -->
<div class="modal-backdrop" id="fpModal">
  <div class="modal">
    <h3>Encryption fingerprint</h3>
    <p style="font-family:'Geist Mono',monospace; font-size:11px; color:#8a8a99; margin:0 0 12px">
      Compare these 8 segments out-of-band with your contact. If they match exactly, your channel is verified end-to-end.
    </p>
    <div class="fp-grid" id="fpGrid"></div>
    {/* WHOSE key this is. The button falls back to your own public key when nobody else in the
        conversation has published one, and without this line those eight segments looked exactly
        like a verified peer. */}
    <div class="panel-note" id="fpWhose"></div>
    <p style="font-family:'Geist Mono',monospace; font-size:10px; color:#6b6b7a; margin:14px 0 0">
      Protocol: ECDH P-256 key agreement, AES-GCM 256-bit symmetric, SHA-256 fingerprint. Private keys never leave your device.
    </p>
    <div class="modal-actions">
      <button class="btn-primary" id="fpClose">Close</button>
    </div>
  </div>
</div>

{/* The call overlay that used to sit here is gone with the two buttons that opened it. It never
    placed a call: there was no RTCPeerConnection and no signalling: it switched on the caller's
    own microphone and printed "Connected". Leaving the markup behind was not harmless either —
    the script still bound `btnAudio`/`btnVideo`, which no longer existed, so the FIRST thing the
    browser did on this page was throw a TypeError at that line. Everything after it, including
    boot(), never ran: no key was published, no conversation was ever loaded, and the composer
    never appeared. The server half of this page was hardened while the client half did not start. */}

<script id="seedData" type="application/json" set:html={JSON.stringify(seed)}></script>

<script is:inline>
(function () {
  // ===========================================================================
  // WHAT WENT WRONG HERE, SO IT IS NOT REINTRODUCED.
  //
  // The server half of this page was rewritten to tell the truth: every write returns RETURNING,
  // every refusal carries a sentence, nothing is swallowed. The client half was not, and it did
  // four separate things that made a working messenger out of a broken one:
  //
  //   1. It THREW ON LOAD. `$('btnAudio').addEventListener(...)` referenced a button that had been
  //      removed from the markup, so this whole function died on that line — before boot(), before
  //      the public key was published, before a single conversation was fetched.
  //   2. It FAKED THREE FEATURES. A presence dot chosen with Math.random(). A typing indicator that
  //      told you that YOU were typing. A read receipt that drew the blue double tick on every
  //      message you had ever sent, whether or not anybody had opened it.
  //   3. It DISCARDED ANSWERS. Mute, disappearing messages and mark-read fired and ignored the
  //      reply; the attach button base64'd an image into a request field the server had stopped
  //      storing, and then reported the message as sent.
  //   4. It COULD NOT READ A GROUP. deriveThreadKey() did ECDH against "the first other member",
  //      which gives three people three different keys. Groups never decrypted, and said nothing.
  //
  // The rule this file is now written to: no state is drawn on screen that was not returned by the
  // server, and no action reports success that was not confirmed by the response to it.
  // ===========================================================================

  var seedEl = document.getElementById('seedData');
  var seed = {};
  try { seed = JSON.parse((seedEl && seedEl.textContent) || '{}'); } catch (e) { seed = {}; }

  var ME = seed.me || { id: '', name: 'You', email: '' };
  var THREADS = seed.threads || [];
  var activeId = seed.initialThreadId || '';

  var messages = [];          // the open thread, newest last, each with _plain / _locked
  var replyTo = null;         // message being replied to
  var editing = null;         // message being edited
  var sending = false;        // guards double-send
  var pollTimer = null;
  var lastSignature = '';     // server's cheap "has this thread changed" string
  var hasMore = false;        // history continues past what is loaded
  var oldest = null;          // created_at of the oldest loaded message, for paging
  var keyProblem = '';        // why this thread cannot be written to, in words
  var canSend = true;
  var searchTimer = null;
  var contentSearchRunning = false;

  var LS_PRIV = 'eraChat.priv.v1';
  var LS_PUB = 'eraChat.pub.v1';
  var MAX_SEARCH_PAGES = 5;   // pages of 60 per conversation, and the screen says so

  function $(id) { return document.getElementById(id); }

  // ---------------------------------------------------------------------------
  // base64. The old encoder was btoa(String.fromCharCode(...new Uint8Array(buf))) — a spread of one
  // argument per byte. A ciphertext here may be 64 KB, which is 65536 arguments, and that is over
  // the argument limit in more than one engine: it throws RangeError and the message silently fails
  // to encrypt. Chunked, it has no size ceiling.
  // ---------------------------------------------------------------------------
  var b64 = {
    encode: function (buf) {
      var bytes = new Uint8Array(buf);
      var out = '';
      for (var i = 0; i < bytes.length; i += 0x8000) {
        out += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
      }
      return btoa(out);
    },
    decode: function (str) {
      var bin = atob(str);
      var a = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);
      return a.buffer;
    }
  };

  // ---------------------------------------------------------------------------
  // Transport. ONE function, and it never returns a success its caller did not get.
  // ---------------------------------------------------------------------------
  async function api(body) {
    var r, j = null;
    try {
      r = await fetch('/portal/messages', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body)
      });
    } catch (e) {
      return { ok: false, error: (e && e.message) || 'the network request did not complete' };
    }
    try { j = await r.json(); } catch (e) { j = null; }
    if (!r.ok || !j || j.ok !== true) {
      return { ok: false, error: (j && j.error) || ('the server answered ' + r.status + ' with nothing this page could read') };
    }
    return j;
  }

  // ---------------------------------------------------------------------------
  // Identity
  // ---------------------------------------------------------------------------
  async function generateKeypair() {
    var kp = await window.crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, true, ['deriveKey', 'deriveBits']);
    var privJwk = await window.crypto.subtle.exportKey('jwk', kp.privateKey);
    var pubSpki = await window.crypto.subtle.exportKey('spki', kp.publicKey);
    var pem = '-----BEGIN PUBLIC KEY-----\n' + b64.encode(pubSpki).match(/.{1,64}/g).join('\n') + '\n-----END PUBLIC KEY-----';
    return { privJwk: privJwk, pem: pem };
  }

  async function loadOrCreateIdentity() {
    var privJwkStr = localStorage.getItem(LS_PRIV);
    var pem = localStorage.getItem(LS_PUB);
    if (!privJwkStr || !pem) {
      var kp = await generateKeypair();
      privJwkStr = JSON.stringify(kp.privJwk);
      pem = kp.pem;
      localStorage.setItem(LS_PRIV, privJwkStr);
      localStorage.setItem(LS_PUB, pem);
    }
    // PUBLISHED ON EVERY LOAD, NOT ONLY THE LOAD THAT CREATED THE KEY. publish_key UPDATEs the
    // membership rows that already exist, so a key made before a thread existed never reached that
    // thread — and a member with no published key is a member nobody can encrypt to. The statement
    // is an idempotent UPDATE, so running it per load is safe and self-healing. It is also not
    // swallowed: a failure here is why somebody cannot be messaged, and it is said out loud.
    var res = await api({ action: 'publish_key', public_key_pem: pem });
    if (!res.ok) {
      setStatus('Your encryption key was not published (' + res.error + '). Until it is, other people cannot encrypt to you. It is retried each time this page loads.', true);
    }
    return pem;
  }

  function importPriv() {
    var privJwk = {};
    try { privJwk = JSON.parse(localStorage.getItem(LS_PRIV) || '{}'); } catch (e) { privJwk = {}; }
    return window.crypto.subtle.importKey('jwk', privJwk, { name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveKey', 'deriveBits']);
  }

  function importPub(pem) {
    if (!pem) return Promise.resolve(null);
    var body = pem.replace(/-----[^-]+-----/g, '').replace(/\s/g, '');
    return window.crypto.subtle.importKey('spki', b64.decode(body), { name: 'ECDH', namedCurve: 'P-256' }, true, []);
  }

  // ---------------------------------------------------------------------------
  // Keys.
  //
  // DIRECT: both ends derive the same AES-GCM key from ECDH between their two published public
  // keys. Nothing is stored.
  //
  // GROUP: ECDH does not extend to three people — A derives ECDH(A,B) and C derives ECDH(C,A),
  // which are different keys, which is why every group here has been undecryptable. A group has ONE
  // random AES-GCM key, made in a browser, and each member holds a copy of it WRAPPED to them. The
  // server stores the wrapped copies and cannot open any of them.
  //
  // Cached in memory only, and keyed by the MATERIAL it was derived from. The old cache was
  // sessionStorage['tk:' + threadId], which survived the peer publishing a key: once a thread had
  // been opened before the other person had a key, this browser encrypted to ITSELF for the rest of
  // the session and the recipient could never read a word of it.
  // ---------------------------------------------------------------------------
  var KEYS = {};

  // The OUTCOME of the last group-key hand-over, so the screen can say what happened instead of what
  // was intended. The hand-over below used to report a failure to console.error and nowhere else,
  // while "Added, and this browser sealed a copy of the group key to them." was printed regardless —
  // a person who could not read one word of the group was described as fully set up.
  // null = no hand-over was attempted; { ok, count, error } = one was.
  var keyHandover = null;

  async function deriveEcdh(peerPem) {
    var pub = await importPub(peerPem);
    var priv = await importPriv();
    return window.crypto.subtle.deriveKey({ name: 'ECDH', public: pub }, priv, { name: 'AES-GCM', length: 256 }, true, ['encrypt', 'decrypt']);
  }

  async function wrapFor(memberPem, rawKey) {
    var kek = await deriveEcdh(memberPem);
    var iv = window.crypto.getRandomValues(new Uint8Array(12));
    var ct = await window.crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv }, kek, rawKey);
    return { wrapped_key: b64.encode(ct), wrapped_key_iv: b64.encode(iv.buffer) };
  }

  async function unwrapWith(wrapperPem, wrappedB64, ivB64) {
    var kek = await deriveEcdh(wrapperPem);
    var raw = await window.crypto.subtle.decrypt(
      { name: 'AES-GCM', iv: new Uint8Array(b64.decode(ivB64)) }, kek, b64.decode(wrappedB64));
    return window.crypto.subtle.importKey('raw', raw, { name: 'AES-GCM' }, true, ['encrypt', 'decrypt']);
  }

  /**
   * The key for a thread, plus a PLAIN SENTENCE when there is not one.
   * Returns { key, problem, readOnly }. `problem` is shown to the reader verbatim.
   *
   * `passive` is set by the cross-conversation search, which walks every thread this reader has.
   * Opening a group provisions it — it makes the group key if none exists and seals copies to
   * members who hold none — and doing that as a side effect of typing in a search box would fire
   * a burst of writes across dozens of conversations nobody asked to open. Passive decrypts with
   * a key already held and otherwise gives up quietly.
   */
  async function threadKey(thread, passive) {
    if (!thread) return { key: null, problem: 'No conversation is open.' };
    var cached = KEYS[thread.id];
    var members = thread.members || [];
    var others = members.filter(function (m) { return m.user_id !== ME.id; });

    if (thread.kind !== 'group') {
      if (!others.length) {
        // Private notes: the only legitimate case for encrypting to yourself.
        var tag = 'self';
        if (cached && cached.tag === tag) return { key: cached.key, problem: '' };
        var mine = await deriveEcdh(localStorage.getItem(LS_PUB));
        KEYS[thread.id] = { tag: tag, key: mine };
        return { key: mine, problem: '' };
      }
      var peer = others[0];
      if (!peer.public_key_pem) {
        // THE SILENT FAILURE THIS REPLACES: the old code fell through to the self-key branch here,
        // encrypted the message to itself, stored it, and showed it as sent. The recipient could
        // never read any of it and neither side was ever told.
        return {
          key: null, readOnly: true,
          // THE SENTENCE NAMED THE OBSTACLE AND NOT THE WAY ROUND IT. On a platform where most
          // people have not signed in yet, this is the first thing a new joiner meets when they try
          // to message anybody, and "until they do" leaves them holding a conversation they can open
          // and cannot use, with no idea whether the fault is theirs. It is nobody's fault, it is
          // fixed in about ten seconds by the other person, and there is an obvious thing to do
          // meanwhile - so all three are said.
          problem: (peer.name || 'This person') + ' has not opened Messages in a browser yet, so this app has no key of theirs to encrypt to. That is how end-to-end encryption works here and it is not a fault at either end: a key is made on the device the first time somebody opens Messages. Ask them to open Messages once, on a browser, and this conversation starts working - your draft is not lost in the meantime. If it is urgent, e-mail them instead.'
        };
      }
      var ptag = 'p:' + peer.public_key_pem.slice(-32);
      if (cached && cached.tag === ptag) return { key: cached.key, problem: '' };
      var k = await deriveEcdh(peer.public_key_pem);
      KEYS[thread.id] = { tag: ptag, key: k };
      return { key: k, problem: '' };
    }

    // ---- group
    var gtag = 'g:' + (thread.key_epoch || 1);
    if (cached && cached.tag === gtag) return { key: cached.key, problem: '' };
    keyHandover = null;

    var info = await api({ action: 'thread_keys', thread_id: thread.id });
    if (!info.ok) return { key: null, readOnly: true, problem: 'The keys for this group could not be read: ' + info.error };

    var infoMembers = info.members || [];
    var key = null;

    if (info.mine && info.mine.wrapped_key && info.mine.wrapped_by_public_key_pem) {
      try {
        key = await unwrapWith(info.mine.wrapped_by_public_key_pem, info.mine.wrapped_key, info.mine.wrapped_key_iv);
      } catch (e) {
        return {
          key: null, readOnly: true,
          problem: 'This group\'s key was sealed to a different browser. Keys never leave the device that made them, so this browser cannot open the group until a member re-shares it from a device that can read it.'
        };
      }
    } else if (passive) {
      return { key: null, readOnly: true, problem: 'This browser holds no key for this group.' };
    } else if (!infoMembers.some(function (m) { return m.has_wrapped_key; })) {
      // Nobody holds a key yet, so this group has never been written to. Whoever opens it first
      // makes the key and seals a copy to every member who has published one. If two people do this
      // at the same moment the server keeps the first set (wrap_keys only fills EMPTY slots), and
      // the re-read below means both browsers end up on the same key rather than on two.
      var rawKey = window.crypto.getRandomValues(new Uint8Array(32));
      var entries = [];
      for (var i = 0; i < infoMembers.length; i++) {
        if (!infoMembers[i].public_key_pem) continue;
        var w = await wrapFor(infoMembers[i].public_key_pem, rawKey.buffer);
        entries.push({ user_id: infoMembers[i].user_id, wrapped_key: w.wrapped_key, wrapped_key_iv: w.wrapped_key_iv });
      }
      if (!entries.length) {
        return { key: null, readOnly: true, problem: 'No member of this group has published an encryption key yet, so there is nobody to seal a group key to.' };
      }
      var stored = await api({
        action: 'wrap_keys', thread_id: thread.id, epoch: info.epoch || 1,
        wrapped_by_public_key_pem: localStorage.getItem(LS_PUB), entries: entries
      });
      if (!stored.ok) return { key: null, readOnly: true, problem: 'The group key could not be stored: ' + stored.error };
      var reread = await api({ action: 'thread_keys', thread_id: thread.id });
      if (!reread.ok || !reread.mine) return { key: null, readOnly: true, problem: 'The group key was stored but could not be read back.' };
      try {
        key = await unwrapWith(reread.mine.wrapped_by_public_key_pem, reread.mine.wrapped_key, reread.mine.wrapped_key_iv);
      } catch (e) {
        return { key: null, readOnly: true, problem: 'The group key was stored but this browser could not open its own copy.' };
      }
      infoMembers = reread.members || infoMembers;
    } else {
      return {
        key: null, readOnly: true,
        problem: 'You do not hold this group\'s key yet. It is handed over by a member who can already read the group, the next time they open it. Nothing you sent now could be read by anyone.'
      };
    }

    // Cached against the epoch the SERVER just reported, not the one the thread row happened to
    // carry. If those disagreed, the tag never matched and every reload re-ran the whole key
    // exchange over the network.
    thread.key_epoch = info.epoch || thread.key_epoch || 1;
    KEYS[thread.id] = { tag: 'g:' + thread.key_epoch, key: key };

    // SELF-HEALING MEMBERSHIP. Anyone who can read the group seals a copy for every member who has
    // published a public key and holds none. Without this, `add_member` puts a person in a group
    // whose entire contents are noise to them, permanently, with nothing on screen to explain it.
    var need = passive ? [] : infoMembers.filter(function (m) { return !m.has_wrapped_key && m.public_key_pem && m.user_id !== ME.id; });
    if (need.length) {
      try {
        var raw = await window.crypto.subtle.exportKey('raw', key);
        var give = [];
        for (var n = 0; n < need.length; n++) {
          var ww = await wrapFor(need[n].public_key_pem, raw);
          give.push({ user_id: need[n].user_id, wrapped_key: ww.wrapped_key, wrapped_key_iv: ww.wrapped_key_iv });
        }
        var handed = await api({
          action: 'wrap_keys', thread_id: thread.id, epoch: info.epoch || 1,
          wrapped_by_public_key_pem: localStorage.getItem(LS_PUB), entries: give
        });
        if (!handed.ok) {
          keyHandover = { ok: false, count: need.length, error: handed.error };
          console.error('[messages] group key not handed to new members:', handed.error);
        } else {
          keyHandover = { ok: true, count: need.length };
        }
      } catch (e) {
        keyHandover = { ok: false, count: need.length, error: (e && e.message) || 'this browser could not seal the key' };
        console.error('[messages] group key not handed to new members:', (e && e.message) || e);
      }
    }
    return { key: key, problem: '' };
  }

  async function encryptText(key, plaintext) {
    var iv = window.crypto.getRandomValues(new Uint8Array(12));
    var ct = await window.crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv }, key, new TextEncoder().encode(plaintext));
    return { ciphertext: b64.encode(ct), iv: b64.encode(iv.buffer) };
  }

  async function decryptText(key, ciphertextB64, ivB64) {
    if (!key) return null;
    try {
      var pt = await window.crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: new Uint8Array(b64.decode(ivB64)) }, key, b64.decode(ciphertextB64));
      return new TextDecoder().decode(pt);
    } catch (e) {
      return null;
    }
  }

  async function fingerprintOf(pem) {
    if (!pem) return '';
    var buf = b64.decode(pem.replace(/-----[^-]+-----/g, '').replace(/\s/g, ''));
    var hash = await window.crypto.subtle.digest('SHA-256', buf);
    return Array.prototype.map.call(new Uint8Array(hash), function (b) { return b.toString(16).padStart(2, '0'); }).join('').toUpperCase();
  }

  // ---------------------------------------------------------------------------
  // DOM helpers. Astro scopes this page's <style> with a data-astro-cid-* attribute; elements built
  // here at runtime do not get it, so without this stamp the entire conversation renders unstyled,
  // including every rule in the phone layout.
  // ---------------------------------------------------------------------------
  var CID = null;
  function cid() {
    if (CID === null) {
      CID = '';
      var host = document.getElementById('shell');
      var names = host ? host.getAttributeNames() : [];
      for (var i = 0; i < names.length; i++) {
        if (names[i].indexOf('data-astro-cid-') === 0) { CID = names[i]; break; }
      }
    }
    return CID;
  }
  function stamp(node) {
    var a = cid();
    if (!a || !node || node.nodeType !== 1) return node;
    node.setAttribute(a, '');
    var kids = node.querySelectorAll('*');
    for (var i = 0; i < kids.length; i++) kids[i].setAttribute(a, '');
    return node;
  }
  function el(tag, opts) {
    var e = document.createElement(tag);
    if (opts) {
      if (opts.class) e.className = opts.class;
      if (opts.text) e.textContent = opts.text;
      if (opts.html) e.innerHTML = opts.html;   // SVG literals from this file only, never user text
      if (opts.attrs) for (var k in opts.attrs) e.setAttribute(k, opts.attrs[k]);
      if (opts.style) e.style.cssText = opts.style;
    }
    return stamp(e);
  }

  function fmtTime(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    var now = new Date();
    if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    var dayDiff = Math.floor((now - d) / 86400000);
    if (dayDiff === 1) return 'Yesterday';
    if (dayDiff < 7) return d.toLocaleDateString([], { weekday: 'short' });
    return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
  }
  function letterAvatar(name) { return (String(name || '?').trim().charAt(0) || '?').toUpperCase(); }

  // The line under the stream. It used to claim YOU were typing, to you, from a "stub" with no
  // transport behind it. It now carries only things that actually happened.
  // `typing` is kept in the class list: it carries the row's height and padding, and dropping it
  // made the whole stream jump every time a status appeared or cleared.
  var connectionBad = false;
  function setStatus(text, bad) {
    var n = $('typing');
    n.className = 'typing status-line' + (bad ? ' bad' : '');
    stamp(n);
    n.textContent = text || '';
  }
  function showSendError(msg) { var b = $('sendError'); b.textContent = msg; b.style.display = ''; }
  function clearSendError() { $('sendError').style.display = 'none'; }

  function activeThread() {
    for (var i = 0; i < THREADS.length; i++) if (THREADS[i].id === activeId) return THREADS[i];
    return null;
  }
  function totalUnread() {
    var n = 0;
    for (var i = 0; i < THREADS.length; i++) n += Number(THREADS[i].unread) || 0;
    return n;
  }
  function syncTitle() {
    var n = totalUnread();
    document.title = (n > 0 ? '(' + n + ') ' : '') + 'Messages';
  }

  // ---------------------------------------------------------------------------
  // Thread list. Unread counts and mute state come from the SERVER row, per thread, and are drawn
  // here — the previous client render dropped both, so the accurate badges the server had already
  // put in the HTML were wiped the moment the script rendered over them.
  // ---------------------------------------------------------------------------
  // ONE place that turns server thread rows into this page's THREADS — the poll, the new-chat
  // handler and openThread all read the same shape, and three hand-written copies of this mapping is
  // how one of them ends up dropping a field nobody notices for a month.
  //
  // Members are carried over from what the last fetch_messages established: a thread ROW does not
  // include membership, and overwriting members with an empty list is what sent key derivation down
  // the encrypt-to-yourself path.
  function mergeThreadRows(incoming) {
    var prev = {};
    for (var p = 0; p < THREADS.length; p++) prev[THREADS[p].id] = THREADS[p].members;
    var merged = [];
    for (var i = 0; i < (incoming || []).length; i++) {
      var row = incoming[i];
      merged.push({
        id: row.id, kind: row.kind, title: row.title || 'Untitled',
        last_message_at: row.last_message_at,
        unread: Number(row.unread) || 0,
        muted: !!row.notifications_muted,
        disappearing_seconds: row.disappearing_seconds,
        role: row.role,
        key_epoch: Number(row.key_epoch) || 1,
        members: prev[row.id] || []
      });
    }
    return merged;
  }

  function renderThreadList(filter) {
    var list = $('threadList');
    list.innerHTML = '';
    var q = String(filter || '').toLowerCase();
    var shown = THREADS.filter(function (t) { return !q || String(t.title || '').toLowerCase().indexOf(q) >= 0; });
    if (!shown.length) {
      list.appendChild(el('div', { class: 'media-empty', text: q ? 'No conversation title matches that.' : 'No conversations yet.', style: 'margin:14px' }));
      return;
    }
    for (var i = 0; i < shown.length; i++) {
      (function (t) {
        var row = el('a', {
          class: 'thread-row' + (t.id === activeId ? ' active' : ''),
          attrs: { href: '/portal/messages?thread=' + encodeURIComponent(t.id) }
        });
        row.appendChild(el('div', { class: 'avatar', text: letterAvatar(t.title) }));
        var meta = el('div', { class: 'thread-meta' });
        meta.appendChild(el('div', { class: 'thread-title', text: t.title || 'Untitled' }));
        var sub = t.kind === 'group' ? 'group' : 'direct message';
        if (Number(t.unread) > 0) sub = Number(t.unread) + (Number(t.unread) === 1 ? ' unread message' : ' unread messages');
        else if (t.muted) sub = sub + ' - muted';
        meta.appendChild(el('div', { class: 'thread-preview', text: sub }));
        row.appendChild(meta);
        row.appendChild(el('div', { class: 'thread-time', text: fmtTime(t.last_message_at) }));
        if (Number(t.unread) > 0) {
          row.appendChild(el('div', { class: 'thread-badge' + (t.muted ? ' muted-badge' : ''), text: String(t.unread) }));
        }
        row.addEventListener('click', function (ev) { ev.preventDefault(); openThread(t.id); });
        list.appendChild(row);
      })(shown[i]);
    }
  }

  var isPhone = function () { return window.matchMedia('(max-width: 767.98px)').matches; };
  function showConversation() {
    $('shell').classList.add('show-conversation');
    if (isPhone()) $('shell').scrollIntoView({ block: 'start' });
  }
  function showThreadList() {
    var shell = $('shell');
    shell.classList.remove('show-conversation');
    shell.classList.remove('info-open');
    $('btnInfoMobile').setAttribute('aria-expanded', 'false');
    if (isPhone()) window.scrollTo(0, 0);
  }
  // Whether the open conversation is actually on screen. On a phone the thread list and the
  // conversation are never both visible, and marking a thread read while its messages are not in
  // front of anybody is exactly how an unread count stops meaning anything.
  function conversationVisible() {
    if (document.visibilityState !== 'visible') return false;
    if (isPhone()) return $('shell').classList.contains('show-conversation');
    return true;
  }

  // ---------------------------------------------------------------------------
  // Open a thread
  // ---------------------------------------------------------------------------
  async function openThread(tid, opts) {
    var navigate = !opts || opts.navigate !== false;
    activeId = tid;
    replyTo = null; editing = null;
    $('replyBar').style.display = 'none';
    clearSendError();
    lastSignature = '';
    renderThreadList($('threadSearch').value);

    var t = activeThread();
    if (!t) {
      // A HIT THAT OPENED NOTHING, IN SILENCE. This page loads the hundred most recent conversations,
      // but the metadata search runs against every conversation this reader is in — so a result from
      // further back was not in THREADS, `activeThread()` returned null, and the click cleared the
      // search box and did absolutely nothing else. The list is re-read once, and if the thread is
      // still not there it is said out loud rather than shrugged off.
      var listed = await api({ action: 'threads' });
      if (listed.ok) {
        var merged = mergeThreadRows(listed.threads || []);
        if (merged.length) THREADS = merged;
        renderThreadList($('threadSearch').value);
      }
      t = activeThread();
    }
    if (!t) {
      setStatus('That conversation could not be opened: it is not among the conversations this account is a member of, or the list could not be re-read.', true);
      return;
    }

    if (navigate) {
      var url = '/portal/messages?thread=' + encodeURIComponent(tid);
      if (location.pathname + location.search !== url) {
        try { history.pushState({ thread: tid }, '', url); } catch (e) { /* history unavailable */ }
      }
      showConversation();
    }

    $('chatTitle').textContent = t.title || 'Untitled';
    $('chatAvatar').textContent = letterAvatar(t.title);
    $('rightAvatar').textContent = letterAvatar(t.title);
    $('rightTitle').textContent = t.title || 'Untitled';
    $('muteSwitch').classList.toggle('on', !!t.muted);
    $('disappearSwitch').classList.toggle('on', Number(t.disappearing_seconds) === 86400);
    $('addMemberRow').style.display = t.kind === 'group' ? '' : 'none';
    $('addMemberNote').textContent = '';
    $('composerWrap').style.display = '';
    await loadMessages();
  }

  function renderMembers(t) {
    var ml = $('memberList');
    ml.innerHTML = '';
    var members = t.members || [];
    for (var i = 0; i < members.length; i++) {
      var m = members[i];
      var row = el('div', { class: 'member-row' });
      row.appendChild(el('div', { class: 'avatar', style: 'width:30px;height:30px;font-size:12px', text: letterAvatar(m.name) }));
      row.appendChild(el('div', { class: 'member-name', text: (m.name || m.email || 'Unknown') + (m.user_id === ME.id ? ' (you)' : '') }));
      // "no key yet" is the real, checkable reason a person cannot be written to. The old panel
      // showed a green presence dot chosen at random instead.
      row.appendChild(el('div', { class: 'member-role', text: m.public_key_pem ? m.role : 'no key yet' }));
      ml.appendChild(row);
    }
    $('rightSub').textContent = t.kind === 'group'
      ? members.length + (members.length === 1 ? ' member' : ' members') + (t.disappearing_seconds ? ' - disappearing' : '')
      : 'direct message' + (t.disappearing_seconds ? ' - disappearing' : '');
  }

  function renderKeyState(t, problem) {
    var n = $('keyState');
    n.className = 'panel-note' + (problem ? ' warn' : '');
    stamp(n);
    if (problem) { n.textContent = problem; return; }
    var others = (t.members || []).filter(function (m) { return m.user_id !== ME.id; });
    if (t.kind === 'group') {
      var without = others.filter(function (m) { return !m.public_key_pem; }).length;
      n.textContent = 'You hold this group\'s key in this browser. It is stored sealed to each member and the server cannot open any copy.'
        + (without ? ' ' + without + ' member(s) have not published a key yet and cannot read the group until they open Messages.' : '');
      // A hand-over that failed is a member who reads nothing, permanently, and it belongs on screen
      // rather than in the console where it used to go alone.
      if (keyHandover && keyHandover.ok === false) {
        n.className = 'panel-note warn';
        stamp(n);
        n.textContent = n.textContent + ' A copy of the key was NOT sealed to ' + keyHandover.count
          + ' member(s) just now: ' + keyHandover.error
          + ' Until that succeeds they see this group as unreadable.';
      }
    } else if (!others.length) {
      n.textContent = 'These are your private notes. They are encrypted with your own key, in this browser.';
    } else {
      n.textContent = 'Encrypted with a key derived between you and ' + (others[0].name || 'the other person') + '. The private halves never leave your devices, so this history cannot be read on a browser that does not hold your key.';
    }
  }

  // ---------------------------------------------------------------------------
  // Messages
  // ---------------------------------------------------------------------------
  async function loadMessages(opts) {
    opts = opts || {};
    var t = activeThread();
    if (!t) return;

    var res = await api({ action: 'fetch_messages', thread_id: t.id });
    if (!res.ok) {
      // A failed load used to `return` in silence, leaving whatever was last on screen looking
      // current. It is now said, and the poll keeps trying.
      setStatus('This conversation could not be loaded: ' + res.error, true);
      return;
    }
    setStatus('');

    // Members come from THIS response, not from the page seed. The seed only carries members for
    // the first 25 threads, so every thread past that had an empty member list — and an empty
    // member list is what sent the key derivation down the encrypt-to-yourself path.
    t.members = (res.members || []).map(function (m) {
      return { user_id: m.user_id, name: m.full_name || m.email || 'Unknown', email: m.email || '', role: m.role, public_key_pem: m.public_key_pem || null, has_wrapped_key: !!m.has_wrapped_key };
    });
    t.kind = res.kind || t.kind;
    t.disappearing_seconds = res.disappearing_seconds || null;
    renderMembers(t);

    var k = await threadKey(t);
    keyProblem = k.problem || '';
    canSend = !!k.key;
    renderKeyState(t, keyProblem);

    var list = res.messages || [];
    for (var i = 0; i < list.length; i++) {
      var m = list[i];
      if (m.deleted_at) { m._plain = null; m._locked = false; continue; }
      m._plain = await decryptText(k.key, m.ciphertext, m.iv);
      m._locked = m._plain === null;
    }
    messages = list;
    hasMore = !!res.has_more;
    oldest = res.oldest || null;

    renderStream(opts.keepScroll);
    if (conversationVisible()) markRead();
  }

  async function loadEarlier() {
    var t = activeThread();
    if (!t || !oldest) return;
    var btn = $('loadEarlier');
    if (btn) { btn.disabled = true; btn.textContent = 'Loading...'; }
    var res = await api({ action: 'fetch_messages', thread_id: t.id, before: oldest });
    if (!res.ok) {
      if (btn) { btn.disabled = false; btn.textContent = 'Load earlier messages'; }
      setStatus('Earlier messages could not be loaded: ' + res.error, true);
      return;
    }
    var k = await threadKey(t);
    var older = res.messages || [];
    for (var i = 0; i < older.length; i++) {
      var m = older[i];
      if (m.deleted_at) { m._plain = null; m._locked = false; continue; }
      m._plain = await decryptText(k.key, m.ciphertext, m.iv);
      m._locked = m._plain === null;
    }
    messages = older.concat(messages);
    hasMore = !!res.has_more;
    oldest = res.oldest || oldest;
    renderStream(true);
  }

  // Split plaintext so an @name is a visible thing rather than characters. Built from text nodes
  // and spans: user text NEVER goes near innerHTML.
  function appendWithMentions(target, text, members) {
    var names = (members || []).map(function (m) { return m.name; }).filter(Boolean)
      .sort(function (a, b) { return b.length - a.length; });
    var i = 0;
    var guard = 0;
    while (i < text.length && guard++ < 5000) {
      var at = text.indexOf('@', i);
      if (at < 0) break;
      var matched = null;
      for (var n = 0; n < names.length; n++) {
        if (text.substr(at + 1, names[n].length).toLowerCase() === names[n].toLowerCase()) { matched = names[n]; break; }
      }
      if (!matched) { i = at + 1; continue; }
      if (at > i) target.appendChild(document.createTextNode(text.slice(i, at)));
      var isMe = matched.toLowerCase() === String(ME.name || '').toLowerCase();
      target.appendChild(el('span', { class: 'msg-mention' + (isMe ? ' me' : ''), text: '@' + matched }));
      i = at + 1 + matched.length;
    }
    if (i < text.length) target.appendChild(document.createTextNode(text.slice(i)));
  }

  var TICK_READ = '<svg class="tick read" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 12 8 18 14 8M10 12 16 18 22 8"/></svg>';
  var TICK_SENT = '<svg class="tick sent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12 10 18 20 6"/></svg>';

  function renderStream(keepScroll) {
    var stream = $('stream');
    var prevHeight = stream.scrollHeight;
    var prevTop = stream.scrollTop;
    var t = activeThread();
    stream.innerHTML = '';

    if (keyProblem) {
      stream.appendChild(el('div', { class: 'stream-note warn', text: keyProblem }));
    }
    var lockedCount = messages.filter(function (m) { return m._locked; }).length;
    if (lockedCount) {
      stream.appendChild(el('div', {
        class: 'stream-note',
        text: lockedCount + (lockedCount === 1 ? ' message in this conversation cannot' : ' messages in this conversation cannot')
          + ' be opened in this browser. Private keys are generated on a device and never leave it, so history encrypted to another browser stays unreadable here. This is the guarantee working, not a fault.'
      }));
    }

    if (hasMore) {
      var earlier = el('button', { class: 'load-earlier', text: 'Load earlier messages', attrs: { id: 'loadEarlier', type: 'button' } });
      earlier.addEventListener('click', loadEarlier);
      stream.appendChild(earlier);
    }

    if (!messages.length) {
      stream.appendChild(el('div', {
        class: 'empty-state', html:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:64px;height:64px;opacity:0.4"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>'
          + '<div>This conversation is end-to-end encrypted.<br/>Say hello.</div>'
      }));
      renderSearchInThread();
      return;
    }

    var lastDay = '';
    for (var i = 0; i < messages.length; i++) {
      (function (m) {
        var dayLabel = new Date(m.created_at).toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });
        if (dayLabel !== lastDay) { stream.appendChild(el('div', { class: 'day-sep', text: dayLabel })); lastDay = dayLabel; }

        var mine = m.sender_user_id === ME.id;
        var row = el('div', { class: 'msg-row' + (mine ? ' me' : '') });
        row.dataset.mid = m.id;
        row.appendChild(el('div', { class: 'avatar', style: 'width:28px;height:28px;font-size:11px', text: letterAvatar(senderName(m.sender_user_id)) }));
        var bubble = el('div', { class: 'msg-bubble' });

        if (m.reply_to_message_id) {
          var quoted = null;
          for (var q = 0; q < messages.length; q++) if (messages[q].id === m.reply_to_message_id) quoted = messages[q];
          var qText = quoted
            ? (quoted.deleted_at ? 'a deleted message' : (quoted._locked ? 'a message this browser cannot open' : String(quoted._plain || '').slice(0, 80)))
            : 'a message further back in this conversation';
          bubble.appendChild(el('div', { class: 'msg-quote', text: 'reply to ' + senderName(quoted ? quoted.sender_user_id : '') + ': ' + qText }));
        }

        // Images from before attachments were removed. They were stored in a plaintext column, so
        // they are shown for what they are rather than quietly under the encrypted badge.
        if (m.attachment_url && !m.deleted_at) {
          bubble.appendChild(el('div', { class: 'attach-legacy', text: 'sent before attachments were withdrawn - this image was stored unencrypted' }));
          bubble.appendChild(el('img', { class: 'msg-attach', attrs: { src: m.attachment_url, alt: 'attachment sent before attachments were withdrawn' } }));
        }

        var txt = el('div', { class: 'msg-text' + (m.deleted_at ? ' deleted' : (m._locked ? ' locked' : '')) });
        if (m.deleted_at) txt.textContent = 'this message was deleted';
        else if (m._locked) txt.textContent = 'encrypted with a key this browser does not hold';
        else appendWithMentions(txt, String(m._plain || ''), (t && t.members) || []);
        bubble.appendChild(txt);

        var footer = el('div', { class: 'msg-footer' });
        footer.appendChild(el('span', {
          class: 'msg-time',
          text: new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + (m.edited_at ? ' - edited' : '')
        }));
        if (mine && !m.deleted_at) {
          // READ BY WHOM, FROM THE RECEIPTS TABLE. Every message you sent used to draw the read
          // tick unconditionally, so the screen said "they have seen this" about messages nobody
          // had opened.
          var readBy = Number(m.read_by) || 0;
          footer.appendChild(el('span', {
            html: readBy > 0 ? TICK_READ : TICK_SENT,
            attrs: { title: readBy > 0 ? ('read by ' + readBy + (readBy === 1 ? ' person' : ' people')) : 'stored on the server; not opened by anyone yet' }
          }));
        }
        bubble.appendChild(footer);

        if (!m.deleted_at) {
          var actions = el('div', { class: 'msg-actions' });
          if (!m._locked) {
            var replyBtn = el('button', { attrs: { title: 'Reply', type: 'button', 'aria-label': 'Reply' }, html: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>' });
            replyBtn.addEventListener('click', function () { startReply(m); });
            actions.appendChild(replyBtn);
          }
          if (mine && !m._locked) {
            var editBtn = el('button', { attrs: { title: 'Edit', type: 'button', 'aria-label': 'Edit' }, html: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>' });
            editBtn.addEventListener('click', function () { startEdit(m); });
            actions.appendChild(editBtn);
          }
          if (mine) {
            var delBtn = el('button', { attrs: { title: 'Delete', type: 'button', 'aria-label': 'Delete' }, html: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' });
            delBtn.addEventListener('click', function () { deleteMessage(m); });
            actions.appendChild(delBtn);
          }
          if (actions.childNodes.length) bubble.appendChild(actions);
        }

        row.appendChild(bubble);
        stream.appendChild(row);
      })(messages[i]);
    }

    renderSearchInThread();
    if (keepScroll) stream.scrollTop = stream.scrollHeight - prevHeight + prevTop;
    else stream.scrollTop = stream.scrollHeight;
  }

  function senderName(uid) {
    if (!uid) return 'someone';
    if (uid === ME.id) return ME.name;
    var t = activeThread();
    var members = (t && t.members) || [];
    for (var i = 0; i < members.length; i++) if (members[i].user_id === uid) return members[i].name;
    return 'Unknown';
  }

  function jumpTo(mid) {
    var row = document.querySelector('[data-mid="' + mid + '"]');
    if (!row) return;
    row.scrollIntoView({ block: 'center' });
    row.style.outline = '2px solid #67e8f9';
    setTimeout(function () { row.style.outline = ''; }, 1600);
  }

  // ---------------------------------------------------------------------------
  // Writes. Every one of them reads the answer.
  // ---------------------------------------------------------------------------
  function startReply(m) {
    editing = null;
    replyTo = m;
    $('replyBar').style.display = '';
    $('replyBarText').textContent = 'Replying to ' + senderName(m.sender_user_id) + ': ' + String(m._plain || '').slice(0, 60);
    $('composer').focus();
  }
  function startEdit(m) {
    replyTo = null;
    editing = m;
    $('replyBar').style.display = '';
    $('replyBarText').textContent = 'Editing your message. Send to save, Escape to cancel.';
    $('composer').value = m._plain || '';
    $('composer').focus();
  }
  function cancelComposeState() {
    replyTo = null;
    if (editing) { editing = null; $('composer').value = ''; }
    $('replyBar').style.display = 'none';
  }

  async function deleteMessage(m) {
    if (!window.confirm('Delete this message? Everyone in the conversation will see that it was deleted.')) return;
    var res = await api({ action: 'delete', message_id: m.id });
    if (!res.ok) { showSendError('Not deleted - ' + res.error); return; }
    clearSendError();
    lastSignature = '';
    await loadMessages({ keepScroll: true });
  }

  // Which members were named, resolved from the text against this thread's member list. The server
  // is told the ids ONLY: it never learns what was written, and it drops any id that is not a
  // member rather than notifying a stranger.
  function mentionIdsIn(text, members) {
    var lower = String(text || '').toLowerCase();
    var ids = [];
    for (var i = 0; i < members.length; i++) {
      var m = members[i];
      if (!m.name || m.user_id === ME.id) continue;
      if (lower.indexOf('@' + m.name.toLowerCase()) >= 0) ids.push(m.user_id);
    }
    return ids;
  }

  async function send() {
    if (sending) return;
    var t = activeThread();
    if (!t) return;
    var txt = $('composer').value.trim();
    if (!txt) return;

    if (!canSend) {
      showSendError('Not sent - ' + (keyProblem || 'this conversation has no key to encrypt with') + ' Your text is still here.');
      return;
    }

    sending = true;
    $('btnSend').disabled = true;
    setStatus('Encrypting and sending...');
    try {
      var k = await threadKey(t);
      if (!k.key) {
        showSendError('Not sent - ' + (k.problem || 'no encryption key for this conversation') + ' Your text is still here.');
        return;
      }
      var enc = await encryptText(k.key, txt);

      if (editing) {
        var edited = await api({ action: 'edit', message_id: editing.id, ciphertext: enc.ciphertext, iv: enc.iv });
        if (!edited.ok) { showSendError('Not saved - ' + edited.error + ' Your text is still here.'); return; }
        editing = null;
        $('composer').value = '';
        $('replyBar').style.display = 'none';
        clearSendError();
        lastSignature = '';
        await loadMessages({ keepScroll: true });
        return;
      }

      var res = await api({
        action: 'send',
        thread_id: t.id,
        ciphertext: enc.ciphertext,
        iv: enc.iv,
        reply_to_message_id: replyTo ? replyTo.id : null,
        mention_user_ids: mentionIdsIn(txt, t.members || [])
      });
      // NOTHING IS CLEARED ON A REFUSAL. The composer still holds what was written and the reply
      // target is still attached to it — the previous version cleared the box and re-rendered
      // whichever way the request went, which is how four months of failed sends looked like a
      // working conversation.
      if (!res.ok) { showSendError('Not sent - ' + res.error + ' Your text is still here; try again.'); return; }

      $('composer').value = '';
      $('composer').style.height = '40px';
      replyTo = null;
      $('replyBar').style.display = 'none';
      clearSendError();
      lastSignature = '';
      await loadMessages();
      // Counts straight from the response. `notified` is how many bell rows the server actually
      // wrote, so this does not guess at a reason it cannot see — a muted thread and a failed
      // notification both come back as zero, and neither is described as the other.
      var note = '';
      if (res.mentioned) note = 'Sent, and ' + res.mentioned + (res.mentioned === 1 ? ' person was' : ' people were') + ' notified by name.';
      else if (res.notified === 0 && (t.members || []).length > 1) note = 'Sent. No notification went out for it.';
      else if (res.notified > 0) note = 'Sent, and ' + res.notified + (res.notified === 1 ? ' person was' : ' people were') + ' notified.';
      setStatus(note);
    } catch (e) {
      // A throw in a send path is never swallowed: the person is told, and the text stays.
      console.error('[messages] send', (e && e.message) || e);
      showSendError('Not sent - ' + ((e && e.message) || 'the message could not be encrypted') + '. Your text is still here.');
    } finally {
      sending = false;
      $('btnSend').disabled = false;
    }
  }

  async function markRead() {
    var t = activeThread();
    if (!t) return;
    if (!Number(t.unread) && !messages.some(function (m) { return m.sender_user_id !== ME.id; })) return;
    var res = await api({ action: 'mark_read', thread_id: t.id });
    if (!res.ok) {
      // Silently failing here is what makes an unread count untrustworthy: the badge clears on
      // screen and comes back on the next load with no explanation.
      setStatus('These messages could not be marked as read: ' + res.error, true);
      return;
    }
    t.unread = 0;
    renderThreadList($('threadSearch').value);
    syncTitle();
  }

  // ---------------------------------------------------------------------------
  // Poll. The old loop refetched and re-decrypted the ENTIRE open thread every four seconds and
  // never looked at any other conversation, so a message arriving anywhere else was invisible
  // until a manual reload. This asks the cheap question instead — unread counts for every thread,
  // and one signature for the open one — and only re-reads messages when that signature moves.
  // ---------------------------------------------------------------------------
  async function pollOnce() {
    if (document.visibilityState !== 'visible') return;
    var res = await api({ action: 'poll', thread_id: activeId || '' });
    if (!res.ok) { connectionBad = true; setStatus('Not connected, so new messages are not arriving: ' + res.error, true); return; }
    // Cleared only if THIS is what put it there, so a "Sent" or a key warning is not wiped by the
    // next heartbeat five seconds later.
    if (connectionBad) { connectionBad = false; setStatus(''); }

    // The poll returns thread rows, not membership — mergeThreadRows() keeps the members the last
    // fetch_messages established, because an empty member list is what sends key derivation down
    // the encrypt-to-yourself path.
    var merged = mergeThreadRows(res.threads || []);
    if (merged.length) THREADS = merged;
    renderThreadList($('threadSearch').value);
    syncTitle();

    if (activeId && res.signature && res.signature !== lastSignature) {
      var first = lastSignature === '';
      lastSignature = res.signature;
      if (!first) await loadMessages({ keepScroll: false });
    }
  }
  function startPoll() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = setInterval(pollOnce, 5000);
  }

  // ---------------------------------------------------------------------------
  // Search.
  //
  // THE SPLIT IS THE POINT. src/lib/legal-hold.ts states in writing that portal direct messages
  // cannot be produced because the server has never held the keys. A server-side index over message
  // text would make that statement false, so the server searches only what it legitimately knows —
  // people, addresses, conversation titles — and message TEXT is searched here, in this browser,
  // over what this reader can already decrypt. The screen says which is which, both before and
  // after, rather than presenting one set of results as if it were everything.
  // ---------------------------------------------------------------------------
  function showResults(on) {
    $('searchResults').style.display = on ? '' : 'none';
    $('threadList').style.display = on ? 'none' : '';
  }

  function addHit(container, threadId, title, snippet, mid) {
    var b = el('button', { class: 'search-hit', attrs: { type: 'button' } });
    b.appendChild(el('div', { class: 'hit-thread', text: title }));
    if (snippet) b.appendChild(el('div', { class: 'hit-snip', text: snippet }));
    b.addEventListener('click', function () {
      $('threadSearch').value = '';
      showResults(false);
      openThread(threadId).then(function () { if (mid) setTimeout(function () { jumpTo(mid); }, 120); });
    });
    container.appendChild(b);
  }

  async function metadataSearch(q) {
    var out = $('searchResults');
    var res = await api({ action: 'search', q: q });
    out.innerHTML = '';
    if (!res.ok) {
      out.appendChild(el('div', { class: 'media-empty', text: 'Search failed: ' + res.error, style: 'margin:14px' }));
      return;
    }
    var found = res.threads || [];
    if (!found.length) {
      out.appendChild(el('div', { class: 'media-empty', text: 'No person, address or conversation title matches that.', style: 'margin:14px' }));
    }
    for (var i = 0; i < found.length; i++) {
      addHit(out, found[i].id, found[i].title || 'Untitled', found[i].kind === 'group' ? 'group' : 'direct message', null);
    }
  }

  async function contentSearch() {
    var q = String($('threadSearch').value || '').trim();
    if (contentSearchRunning) return;
    if (!q) {
      var p0 = $('searchProgress');
      p0.style.display = '';
      p0.textContent = 'Type what you are looking for in the box above first.';
      return;
    }
    contentSearchRunning = true;
    var btn = $('btnSearchText');
    btn.disabled = true;
    var prog = $('searchProgress');
    prog.style.display = '';
    showResults(true);

    var out = $('searchResults');
    // CLEARED FIRST. The metadata search that runs while you type draws its hits into this same
    // panel, and appending to them produced a header counting one set of results above a list
    // showing two — a count that does not describe what is on screen.
    out.innerHTML = '';
    var header = el('div', { class: 'panel-note', style: 'padding:10px 14px' });
    var lower = q.toLowerCase();
    var scanned = 0, hits = 0, locked = 0, unreadable = 0;
    var targets = THREADS.slice(0, 60);

    try {
    for (var i = 0; i < targets.length; i++) {
      var t = targets[i];
      prog.textContent = 'Decrypting and searching in this browser: conversation ' + (i + 1) + ' of ' + targets.length + '.';
      var before = null, pages = 0, threadHits = 0, threadLocked = 0, threadFailed = false;
      var kres = null;
      while (pages < MAX_SEARCH_PAGES) {
        var body = { action: 'fetch_messages', thread_id: t.id };
        if (before) body.before = before;
        var res = await api(body);
        // A conversation the server would not return is NOT a conversation with no match in it.
        if (!res.ok) { threadFailed = true; break; }
        if (!kres) {
          t.members = (res.members || []).map(function (m) {
            return { user_id: m.user_id, name: m.full_name || m.email || 'Unknown', email: m.email || '', role: m.role, public_key_pem: m.public_key_pem || null, has_wrapped_key: !!m.has_wrapped_key };
          });
          t.kind = res.kind || t.kind;
          kres = await threadKey(t, true);   // passive: a search must not provision keys
        }
        var list = res.messages || [];
        for (var mi = 0; mi < list.length; mi++) {
          var m = list[mi];
          if (m.deleted_at) continue;
          var plain = await decryptText(kres.key, m.ciphertext, m.iv);
          if (plain === null) { threadLocked++; continue; }
          var at = plain.toLowerCase().indexOf(lower);
          if (at < 0) continue;
          threadHits++;
          hits++;
          if (threadHits <= 3) {
            var start = Math.max(0, at - 30);
            addHit(out, t.id, t.title || 'Untitled',
              (start > 0 ? '...' : '') + plain.slice(start, at + q.length + 40).replace(/\s+/g, ' '),
              m.id);
          }
        }
        if (!res.has_more || !res.oldest) break;
        before = res.oldest;
        pages++;
      }
      if (threadLocked) locked++;
      if (threadFailed) unreadable++; else scanned++;
    }

    prog.style.display = 'none';
    header.textContent = 'Searched ' + scanned + ' conversation(s) in this browser, up to the most recent '
      + (MAX_SEARCH_PAGES * 60) + ' messages in each. ' + hits + ' match(es).'
      + (locked ? ' ' + locked + ' conversation(s) contained messages this browser holds no key for and could not be searched.' : '')
      + (unreadable ? ' ' + unreadable + ' conversation(s) could not be read from the server at all and were not searched.' : '');
    out.insertBefore(header, out.firstChild);
    if (!hits) out.appendChild(el('div', { class: 'media-empty', text: 'No message text this browser can read contains that.', style: 'margin:14px' }));
    } catch (e) {
      // A search that stopped early must SAY it stopped early. Left as it was, this threw out of an
      // event handler, the button stayed disabled for the life of the page, the progress line sat
      // frozen mid-count, and whatever had been found so far read as the complete answer.
      console.error('[messages] content search', (e && e.message) || e);
      prog.style.display = 'none';
      out.insertBefore(el('div', {
        class: 'panel-note warn', style: 'padding:10px 14px',
        text: 'This search stopped after ' + scanned + ' conversation(s): ' + ((e && e.message) || 'unknown error')
          + ' Anything listed below is only what had been searched by then, not the whole answer.'
      }), out.firstChild);
    } finally {
      // Runs whichever way the search went, so the button is never left dead.
      btn.disabled = false;
      contentSearchRunning = false;
    }
  }

  function renderSearchInThread() {
    var q = String($('threadSearchIn').value || '').toLowerCase();
    var out = $('searchInResults');
    out.innerHTML = '';
    if (!q) return;
    var hits = messages.filter(function (m) { return !m.deleted_at && !m._locked && String(m._plain || '').toLowerCase().indexOf(q) >= 0; }).slice(0, 20);
    if (!hits.length) {
      out.appendChild(el('div', { class: 'panel-note', text: 'Nothing loaded in this conversation matches. Use "Load earlier messages" to bring more history into the browser first.' }));
      return;
    }
    for (var i = 0; i < hits.length; i++) {
      (function (m) {
        var r = el('div', { class: 'msg-quote', style: 'margin:4px 0; cursor:pointer', text: senderName(m.sender_user_id) + ': ' + String(m._plain || '').slice(0, 80) });
        r.addEventListener('click', function () { jumpTo(m.id); });
        out.appendChild(r);
      })(hits[i]);
    }
  }

  // ---------------------------------------------------------------------------
  // Mentions in the composer
  // ---------------------------------------------------------------------------
  var mentionIndex = -1;
  function mentionCandidates() {
    var t = activeThread();
    var ta = $('composer');
    var upto = ta.value.slice(0, ta.selectionStart);
    var mAt = upto.match(/@([\w.\- ]{0,30})$/);
    if (!mAt) return null;
    var frag = mAt[1].toLowerCase();
    var members = ((t && t.members) || []).filter(function (m) {
      return m.user_id !== ME.id && m.name && (!frag || m.name.toLowerCase().indexOf(frag) === 0);
    });
    return members.length ? { frag: mAt[1], members: members.slice(0, 8) } : null;
  }
  function renderMentionPop() {
    var pop = $('mentionPop');
    var c = mentionCandidates();
    pop.innerHTML = '';
    if (!c) { pop.classList.remove('open'); mentionIndex = -1; return; }
    if (mentionIndex >= c.members.length) mentionIndex = 0;
    for (var i = 0; i < c.members.length; i++) {
      (function (m, idx) {
        var b = el('button', { text: m.name, attrs: { type: 'button', role: 'option', 'aria-selected': idx === mentionIndex ? 'true' : 'false' } });
        b.addEventListener('click', function () { pickMention(m); });
        pop.appendChild(b);
      })(c.members[i], i);
    }
    pop.classList.add('open');
  }
  function pickMention(m) {
    var ta = $('composer');
    var upto = ta.value.slice(0, ta.selectionStart);
    var rest = ta.value.slice(ta.selectionStart);
    // Function replacement, not a string: a name containing `$` would otherwise be read as a
    // replacement pattern and the wrong text would land in the box.
    var replaced = upto.replace(/@([\w.\- ]{0,30})$/, function () { return '@' + m.name + ' '; });
    ta.value = replaced + rest;
    ta.selectionStart = ta.selectionEnd = replaced.length;
    $('mentionPop').classList.remove('open');
    mentionIndex = -1;
    ta.focus();
  }

  // ---------------------------------------------------------------------------
  // Wiring
  // ---------------------------------------------------------------------------
  $('composer').addEventListener('keydown', function (ev) {
    var pop = $('mentionPop');
    if (pop.classList.contains('open')) {
      var c = mentionCandidates();
      if (c && (ev.key === 'ArrowDown' || ev.key === 'ArrowUp')) {
        ev.preventDefault();
        mentionIndex = (mentionIndex + (ev.key === 'ArrowDown' ? 1 : c.members.length - 1) + c.members.length) % c.members.length;
        renderMentionPop();
        return;
      }
      if (c && ev.key === 'Enter' && mentionIndex >= 0) { ev.preventDefault(); pickMention(c.members[mentionIndex]); return; }
      if (ev.key === 'Escape') { ev.preventDefault(); pop.classList.remove('open'); mentionIndex = -1; return; }
    }
    if (ev.key === 'Enter' && !ev.shiftKey) { ev.preventDefault(); send(); return; }
    if (ev.key === 'Escape') { cancelComposeState(); }
  });
  $('composer').addEventListener('input', function () {
    var ta = $('composer');
    ta.style.height = '40px';
    ta.style.height = Math.min(140, ta.scrollHeight) + 'px';
    renderMentionPop();
  });
  $('btnSend').addEventListener('click', send);
  $('replyCancel').addEventListener('click', cancelComposeState);

  $('muteSwitch').addEventListener('click', async function () {
    var t = activeThread();
    if (!t) return;
    // The switch is drawn FROM THE ANSWER. It used to flip optimistically and never reconcile, so a
    // failed write left a thread showing "muted" that went on notifying.
    var res = await api({ action: 'toggle_mute', thread_id: t.id });
    if (!res.ok) { setStatus('Mute was not changed: ' + res.error, true); return; }
    t.muted = !!res.muted;
    $('muteSwitch').classList.toggle('on', t.muted);
    setStatus(t.muted ? 'Muted. You will still be notified when someone names you with an @ mention.' : 'Unmuted. New messages here will notify you.');
    renderThreadList($('threadSearch').value);
  });

  $('disappearSwitch').addEventListener('click', async function () {
    var t = activeThread();
    if (!t) return;
    var on = !$('disappearSwitch').classList.contains('on');
    if (on && !window.confirm('Turn on disappearing messages? Everything in this conversation older than 24 hours stops being shown to everyone in it.')) return;
    var res = await api({ action: 'set_disappearing', thread_id: t.id, seconds: on ? 86400 : null });
    if (!res.ok) { setStatus('That setting was not changed: ' + res.error, true); return; }
    t.disappearing_seconds = res.disappearing_seconds;
    $('disappearSwitch').classList.toggle('on', Number(t.disappearing_seconds) === 86400);
    renderMembers(t);
    lastSignature = '';
    await loadMessages();
  });

  $('btnAddMember').addEventListener('click', async function () {
    var t = activeThread();
    if (!t) return;
    var email = String($('addMemberEmail').value || '').trim();
    if (!email) { $('addMemberNote').textContent = 'Enter the email address of the person to add.'; return; }
    var note = $('addMemberNote');
    note.textContent = 'Adding...';
    var res = await api({ action: 'add_member', thread_id: t.id, email: email });
    if (!res.ok) { note.textContent = res.error; return; }
    $('addMemberEmail').value = '';
    note.textContent = 'Added. Sealing a copy of the group key to them...';
    delete KEYS[t.id];               // force a re-read so the hand-over below actually runs
    keyHandover = null;              // and so this line reports THIS hand-over, not an earlier one
    lastSignature = '';
    await loadMessages();
    // WHAT HAPPENED, NOT WHAT WAS INTENDED. This used to print "Added, and this browser sealed a
    // copy of the group key to them." unconditionally — including when the wrap_keys call had been
    // refused, which was logged to the console and nowhere a person would ever see it.
    if (keyHandover && keyHandover.ok) {
      note.textContent = 'Added, and this browser sealed a copy of the group key to them.';
    } else if (keyHandover) {
      note.textContent = 'Added, but their copy of the group key was NOT sealed: ' + keyHandover.error
        + ' They cannot read this group until a member who holds the key opens it again.';
    } else {
      note.textContent = 'Added, but no key was sealed to them just now - either they have not '
        + 'published an encryption key yet (they must open Messages in a browser once), or this '
        + 'browser does not hold the group key itself. The Keys panel above says which.';
    }
  });

  // --- New conversation
  function showNewChat() { $('newChatModal').classList.add('open'); $('newChatNote').textContent = ''; $('newPeer').focus(); }
  function hideNewChat() { $('newChatModal').classList.remove('open'); }
  $('btnNewChat').addEventListener('click', showNewChat);
  $('btnNewChatAlt').addEventListener('click', showNewChat);
  $('newChatCancel').addEventListener('click', hideNewChat);
  $('newChatSave').addEventListener('click', async function () {
    var kind = $('newKind').value;
    var peer = String($('newPeer').value || '').trim();
    var note = $('newChatNote');
    if (!peer) { note.textContent = kind === 'group' ? 'Give the group a name.' : 'Enter an email address.'; return; }
    note.textContent = 'Creating...';
    var body = kind === 'group'
      ? { action: 'new_thread', kind: 'group', title: peer }
      : { action: 'new_thread', kind: 'direct', peer_email: peer };
    var res = await api(body);
    // The refusal is shown IN the modal. It used to be an alert() carrying whatever the server
    // said, and before that the server would happily create a conversation addressed to an account
    // that did not exist.
    if (!res.ok) { note.textContent = res.error; return; }

    // The thread list is re-read from the server rather than invented locally: the previous version
    // pushed a made-up row even when the server had answered "you already have this conversation",
    // which put the same conversation in the list twice.
    var listed = await api({ action: 'threads' });
    // If this re-read fails the conversation still exists, and openThread() below re-reads the list
    // itself and says so if the thread still cannot be found. Nothing is invented locally either
    // way: the previous version pushed a made-up row even when the server had answered "you already
    // have this conversation", which put the same conversation in the list twice.
    if (listed.ok) THREADS = mergeThreadRows(listed.threads || []);
    hideNewChat();
    $('newPeer').value = '';
    renderThreadList('');
    await openThread(res.thread_id);
    if (res.existing) setStatus(res.message || 'You already had this conversation. It is open.');
  });

  // --- Fingerprint
  $('btnFingerprint').addEventListener('click', async function () {
    var t = activeThread();
    if (!t) return;
    var other = null;
    var members = t.members || [];
    for (var i = 0; i < members.length; i++) if (members[i].user_id !== ME.id && members[i].public_key_pem) { other = members[i]; break; }
    var pem = other ? other.public_key_pem : localStorage.getItem(LS_PUB);
    var hex = await fingerprintOf(pem);
    var segs = (hex.match(/.{1,8}/g) || []).slice(0, 8);
    var grid = $('fpGrid');
    grid.innerHTML = '';
    for (var s = 0; s < segs.length; s++) grid.appendChild(el('div', { class: 'fp-cell', text: segs[s] }));
    $('fpWhose').textContent = other
      ? 'This is ' + (other.name || 'the other person') + '\'s key as this server holds it.'
      : 'Nobody else in this conversation has published a key, so this is your own.';
    $('fpModal').classList.add('open');
  });
  $('fpClose').addEventListener('click', function () { $('fpModal').classList.remove('open'); });
  $('e2ePill').addEventListener('click', function () { $('btnFingerprint').click(); });

  // --- Glyph picker (no emoji anywhere on this platform: monochrome SVG only)
  var glyphs = [
    { name: 'heart', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10z"/></svg>' },
    { name: 'star', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 9 22 9 17 14 19 21 12 17 5 21 7 14 2 9 9 9"/></svg>' },
    { name: 'check', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>' },
    { name: 'flame', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c0 4-4 5-4 9a4 4 0 0 0 8 0c0-2-2-3-2-5 2 1 4 3 4 7a6 6 0 0 1-12 0c0-6 6-7 6-11z"/></svg>' },
    { name: 'leaf', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M11 20A7 7 0 0 1 4 13c0-6 7-11 16-11-1 9-3 18-9 18z"/></svg>' },
    { name: 'bolt', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>' },
    { name: 'sun', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>' },
    { name: 'moon', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>' },
    { name: 'cloud', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 18H7A5 5 0 0 1 7 8h.7A6 6 0 0 1 19 10a4 4 0 0 1-2 8z"/></svg>' },
    { name: 'music', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>' },
    { name: 'gift', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 12h18M12 8v13M16 8a3 3 0 1 0-4-4 3 3 0 1 0-4 4"/></svg>' },
    { name: 'crown', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 6l4 8 6-10 6 10 4-8v14H2z"/></svg>' },
    { name: 'coffee', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8h1a4 4 0 0 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>' },
    { name: 'bell', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2zm6-6V11a6 6 0 1 0-12 0v5l-2 2v1h16v-1z"/></svg>' },
    { name: 'rocket', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 13c0-5 3-9 9-11 2 6-1 12-6 14l-3-3zm0 0l-3 3 3 3 3-3M14 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>' },
    { name: 'globe', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>' }
  ];
  (function renderGlyphs() {
    var pop = $('emojiPop');
    for (var i = 0; i < glyphs.length; i++) {
      (function (g) {
        var b = el('button', { html: g.svg, attrs: { title: g.name, type: 'button', 'aria-label': g.name } });
        b.addEventListener('click', function () {
          var c = $('composer');
          c.value = c.value + ' [' + g.name + '] ';
          c.focus();
          pop.classList.remove('open');
        });
        pop.appendChild(b);
      })(glyphs[i]);
    }
  })();
  $('btnEmoji').addEventListener('click', function () { $('emojiPop').classList.toggle('open'); });

  // --- Panels and navigation
  $('btnInfo').addEventListener('click', function () { $('shell').classList.toggle('info-hidden'); });
  function setInfoOpen(on) {
    $('shell').classList.toggle('info-open', on);
    $('btnInfoMobile').setAttribute('aria-expanded', on ? 'true' : 'false');
  }
  $('btnInfoMobile').addEventListener('click', function () { setInfoOpen(!$('shell').classList.contains('info-open')); });
  $('btnInfoClose').addEventListener('click', function () { setInfoOpen(false); });

  $('btnBack').addEventListener('click', function (ev) {
    ev.preventDefault();
    showThreadList();
    if (location.search) { try { history.pushState(null, '', '/portal/messages'); } catch (e) { /* history unavailable */ } }
  });
  window.addEventListener('popstate', function () {
    var tid = new URLSearchParams(location.search).get('thread');
    var known = false;
    for (var i = 0; i < THREADS.length; i++) if (THREADS[i].id === tid) known = true;
    if (tid && known) { openThread(tid, { navigate: false }); $('shell').classList.add('show-conversation'); }
    else showThreadList();
  });

  // --- Search wiring
  $('threadSearch').addEventListener('input', function (ev) {
    var q = String(ev.target.value || '').trim();
    renderThreadList(q);
    if (searchTimer) clearTimeout(searchTimer);
    if (!q) { showResults(false); $('searchProgress').style.display = 'none'; return; }
    searchTimer = setTimeout(function () { showResults(true); metadataSearch(q); }, 250);
  });
  $('btnSearchText').addEventListener('click', contentSearch);
  $('threadSearchIn').addEventListener('input', renderSearchInThread);

  // A conversation is only marked read once its messages are actually in front of somebody.
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') { pollOnce(); if (conversationVisible()) markRead(); }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    $('newChatModal').classList.remove('open');
    $('fpModal').classList.remove('open');
    $('emojiPop').classList.remove('open');
    setInfoOpen(false);
  });

  // --- Boot
  (async function boot() {
    try {
      await loadOrCreateIdentity();
      renderThreadList('');
      syncTitle();
      // navigate:false — the server already decided the composition from ?thread=, and on a phone
      // with no ?thread= the thread list must stay on screen.
      if (activeId) await openThread(activeId, { navigate: false });
      if (isPhone() && $('shell').classList.contains('show-conversation')) $('shell').scrollIntoView({ block: 'start' });
      startPoll();
    } catch (e) {
      // Boot is the one place a throw used to take the entire messenger down without a word. It
      // now says so on the screen it broke.
      console.error('[messages] boot', (e && e.message) || e);
      setStatus('Messages did not start: ' + ((e && e.message) || 'unknown error') + '. Reload the page; if it keeps happening the conversation list above still opens each conversation by link.', true);
    }
  })();
})();
</script>
</BaseLayout>
