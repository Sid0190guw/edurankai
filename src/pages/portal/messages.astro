---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ensureChatSchema, CHAT_CANONICAL_HREF } from '@/lib/chat-schema';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/messages');

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// The real Postgres reason lives on e.cause; e.message is only the failed SQL. Every catch in this
// file logs through here, and nothing in a write path is swallowed.
function reason(e: any): string { return String(e?.cause?.message || e?.message || 'unknown error'); }

// A write that matched no row is NOT a success. Every UPDATE below carries RETURNING id and is
// counted through this, because `UPDATE ... WHERE id = x AND sender_user_id = me` matching nothing
// is exactly what "reported success while nothing happened" looks like in SQL. Driver-independent
// on purpose: postgres-js returns plain arrays and there is no portable rowCount to read.
function changed(r: any): number { return rows(r).length; }

// Upper bounds. A ciphertext is base64 of what someone typed; 64 KB of it is a very long message
// and anything larger is either a bug or an attempt to store a file in a message column.
const MAX_CIPHERTEXT = 64 * 1024;
const PAGE_SIZE = 60;

// Server-render helpers for the thread list. Function declarations (hoisted) so they are
// safe regardless of where they are used below.
function initialOf(s: any): string {
  const c = String(s || '').trim().charAt(0).toUpperCase();
  return c || '?';
}
function shortDate(v: any): string {
  if (!v) return '';
  const d = new Date(v);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
}

// --- Schema -------------------------------------------------------------------
// The DDL that used to sit here CREATEd chat_messages with the thread/ciphertext shape, while
// scripts/setup-team-chat.mjs CREATEs the same table name with a channel/body shape. CREATE TABLE
// IF NOT EXISTS is a NO-OP on an existing table, so the statement that ran second did nothing at
// all and its system's every INSERT threw from that moment on — invisibly, because the only
// statement here that errors against the other shape (the thread index) was the one wrapped in
// `.catch(()=>{})`.
//
// ONE module now owns these tables and reconciles both shapes additively: src/lib/chat-schema.ts.
// Nothing else may CREATE a chat table; a second one recreates the split.
await ensureChatSchema();

// --- Shared query helpers -----------------------------------------------------
// Declared BEFORE the POST block that calls them. `const` is not hoisted and a handler that reaches
// a later declaration has taken pages down on this project; these are function declarations, which
// are hoisted, but they are placed first anyway so the rule is visible rather than remembered.

// The reader's own id, captured ONCE after the guard above. The helpers below are function
// declarations, so they are hoisted past `if (!user) return` and TypeScript cannot narrow `user`
// inside them — it reported `'user' is possibly 'null'` on every one of these queries. Reading the
// id here, where the guard has demonstrably run, is the honest fix: an unauthenticated request has
// already been redirected and can never reach these.
const meId: string = String(user.id);

/** The membership row, or null. Every thread-scoped action starts here — authorization first. */
async function membership(threadId: string): Promise<any | null> {
  const r = rows(await db.execute(sql`
    SELECT thread_id, user_id, role, last_read_at, notifications_muted, wrapped_key, wrapped_key_iv,
           wrapped_by_user_id, wrapped_by_public_key_pem, wrapped_key_epoch
      FROM chat_thread_members WHERE thread_id = ${threadId} AND user_id = ${meId} LIMIT 1`));
  return r[0] || null;
}

/**
 * Copy each member's already-published public key onto a membership row that has none.
 *
 * WHY THIS EXISTS. `publish_key` can only stamp memberships that ALREADY EXIST, so a row created
 * afterwards starts with public_key_pem NULL. The client then finds no peer key, falls through to
 * the self-key branch of deriveThreadKey(), and encrypts to ITSELF — the recipient can never read a
 * word of it and neither side is told. That was silent, permanent, and looked exactly like a working
 * conversation. A new membership now inherits the key that user has published elsewhere.
 */
async function stampKnownKeys(threadId: string): Promise<void> {
  await db.execute(sql`
    UPDATE chat_thread_members m
       SET public_key_pem = k.pem
      FROM (SELECT DISTINCT ON (user_id) user_id, public_key_pem AS pem
              FROM chat_thread_members
             WHERE public_key_pem IS NOT NULL
             ORDER BY user_id, joined_at DESC) k
     WHERE m.thread_id = ${threadId} AND m.user_id = k.user_id AND m.public_key_pem IS NULL`);
}

/** Thread rows for this reader, with a REAL unread count per thread. */
async function threadRowsFor(): Promise<any[]> {
  return rows(await db.execute(sql`
    SELECT t.id, t.kind, t.title, t.last_message_preview, t.last_message_at, t.cover_url,
           t.disappearing_seconds, t.key_epoch,
           m.notifications_muted, m.last_read_at, m.role,
           m.wrapped_key, m.wrapped_key_iv, m.wrapped_by_public_key_pem, m.wrapped_key_epoch,
           (SELECT COUNT(*)::int FROM chat_messages c
             WHERE c.thread_id = t.id
               AND c.sender_user_id <> ${meId}
               AND c.deleted_at IS NULL
               AND (m.last_read_at IS NULL OR c.created_at > m.last_read_at)) AS unread,
           (SELECT COUNT(*)::int FROM chat_thread_members x WHERE x.thread_id = t.id) AS member_count
      FROM chat_threads t
      JOIN chat_thread_members m ON m.thread_id = t.id
     WHERE m.user_id = ${meId}
     ORDER BY COALESCE(t.last_message_at, t.created_at) DESC
     LIMIT 100`));
}

/** Members of one thread, including whether each can be encrypted to and whether they hold a key. */
async function membersOf(threadId: string): Promise<any[]> {
  return rows(await db.execute(sql`
    SELECT m.user_id, m.role, m.public_key_pem, m.joined_at,
           (m.wrapped_key IS NOT NULL) AS has_wrapped_key,
           u.name AS full_name, u.email
      FROM chat_thread_members m
      LEFT JOIN users u ON u.id = m.user_id
     WHERE m.thread_id = ${threadId}
     ORDER BY m.joined_at ASC
     LIMIT 50`));
}

function jsonOut(payload: any, status = 200): Response {
  return new Response(JSON.stringify(payload), {
    status,
    headers: { 'content-type': 'application/json', 'cache-control': 'no-store' },
  });
}

/**
 * A refusal the person on the other end can act on.
 *
 * The old handler answered every failure with `e.message` — 'bad message', 'not a member' — at HTTP
 * 400, and the client discarded even that. A refusal now says what was refused and what to do, and
 * the client prints it verbatim above the composer.
 */
function refuse(message: string, status = 400): Response {
  return jsonOut({ ok: false, error: message }, status);
}

// --- POST handlers ------------------------------------------------------------
const ct = Astro.request.headers.get('content-type') || '';

if (Astro.request.method === 'POST' && ct.includes('application/json')) {
  let action = '';
  try {
    const body = await Astro.request.json();
    action = String(body.action || '');

    if (action === 'publish_key') {
      // Idempotently store this user's public key on all their thread memberships.
      const pem = String(body.public_key_pem || '');
      if (!pem.startsWith('-----BEGIN PUBLIC KEY-----')) return refuse('That is not a public key.');
      const r = rows(await db.execute(sql`
        UPDATE chat_thread_members SET public_key_pem = ${pem}
         WHERE user_id = ${user.id}
           AND (public_key_pem IS NULL OR public_key_pem <> ${pem})
         RETURNING thread_id`));
      return jsonOut({ ok: true, stamped: r.length });
    }

    if (action === 'new_thread') {
      const peerEmail = String(body.peer_email || '').trim().toLowerCase();
      const title = String(body.title || '').slice(0, 200).trim();
      const kind = body.kind === 'group' ? 'group' : 'direct';

      if (kind === 'direct') {
        // A DIRECT THREAD WITH NOBODY IN IT IS THE WORST OUTCOME AVAILABLE HERE. The old handler
        // looked the address up, found nothing, and created the thread anyway — titled with the
        // address that does not exist. You then typed into it for as long as it took to notice that
        // nobody had ever replied. A conversation that cannot have a second participant is refused.
        if (!peerEmail) return refuse('Enter the email address of the person you want to message.');
        const u = rows(await db.execute(sql`
          SELECT id, name, email FROM users WHERE LOWER(email) = ${peerEmail} LIMIT 1`));
        if (!u.length) {
          return refuse('No account here uses ' + peerEmail + '. Nothing was created — check the address and try again.', 404);
        }
        const peerId = String(u[0].id);
        if (peerId === String(user.id)) {
          return refuse('That is your own address. Your private notes thread is already in the list.');
        }
        // One direct thread per pair. Two rows for the same two people is how a reply lands in a
        // conversation the other person is not looking at.
        const existing = rows(await db.execute(sql`
          SELECT t.id FROM chat_threads t
           WHERE t.kind = 'direct'
             AND EXISTS (SELECT 1 FROM chat_thread_members a WHERE a.thread_id = t.id AND a.user_id = ${user.id})
             AND EXISTS (SELECT 1 FROM chat_thread_members b WHERE b.thread_id = t.id AND b.user_id = ${peerId})
             AND (SELECT COUNT(*) FROM chat_thread_members c WHERE c.thread_id = t.id) = 2
           LIMIT 1`));
        if (existing.length) {
          return jsonOut({ ok: true, thread_id: existing[0].id, existing: true,
            message: 'You already have a conversation with ' + (u[0].name || peerEmail) + '. Opening it.' });
        }
        const t = rows(await db.execute(sql`
          INSERT INTO chat_threads (kind, title, created_by_user_id)
          VALUES ('direct', ${u[0].name || peerEmail}, ${user.id})
          RETURNING id`));
        const tid = String(t[0].id);
        await db.execute(sql`
          INSERT INTO chat_thread_members (thread_id, user_id, role) VALUES (${tid}, ${user.id}, 'owner')
          ON CONFLICT DO NOTHING`);
        await db.execute(sql`
          INSERT INTO chat_thread_members (thread_id, user_id, role) VALUES (${tid}, ${peerId}, 'member')
          ON CONFLICT DO NOTHING`);
        await stampKnownKeys(tid);
        return jsonOut({ ok: true, thread_id: tid, members: await membersOf(tid) });
      }

      if (!title) return refuse('Give the group a name.');
      const t = rows(await db.execute(sql`
        INSERT INTO chat_threads (kind, title, created_by_user_id) VALUES ('group', ${title}, ${user.id})
        RETURNING id`));
      const tid = String(t[0].id);
      await db.execute(sql`
        INSERT INTO chat_thread_members (thread_id, user_id, role) VALUES (${tid}, ${user.id}, 'owner')
        ON CONFLICT DO NOTHING`);
      await stampKnownKeys(tid);
      return jsonOut({ ok: true, thread_id: tid, members: await membersOf(tid) });
    }

    if (action === 'add_member') {
      const tid = String(body.thread_id || '');
      const email = String(body.email || '').trim().toLowerCase();
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const th = rows(await db.execute(sql`SELECT kind FROM chat_threads WHERE id = ${tid} LIMIT 1`));
      if (!th.length) return refuse('That conversation no longer exists.', 404);
      if (th[0].kind !== 'group') {
        // Adding a third person to a two-person thread would silently change what the key means for
        // everybody already in it. A group is created as a group.
        return refuse('This is a direct message between two people. Start a group to include more.');
      }
      const u = rows(await db.execute(sql`SELECT id, name, email FROM users WHERE LOWER(email) = ${email} LIMIT 1`));
      if (!u.length) return refuse('No account here uses ' + email + '. Nobody was added.', 404);
      const added = rows(await db.execute(sql`
        INSERT INTO chat_thread_members (thread_id, user_id, role) VALUES (${tid}, ${u[0].id}, 'member')
        ON CONFLICT DO NOTHING RETURNING user_id`));
      if (!added.length) return refuse((u[0].name || email) + ' is already in this group.');
      await stampKnownKeys(tid);
      return jsonOut({ ok: true, members: await membersOf(tid) });
    }

    if (action === 'thread_keys') {
      const tid = String(body.thread_id || '');
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const th = rows(await db.execute(sql`SELECT kind, key_epoch FROM chat_threads WHERE id = ${tid} LIMIT 1`));
      if (!th.length) return refuse('That conversation no longer exists.', 404);
      return jsonOut({
        ok: true,
        kind: th[0].kind,
        epoch: Number(th[0].key_epoch) || 1,
        role: me.role,
        mine: me.wrapped_key
          ? { wrapped_key: me.wrapped_key, wrapped_key_iv: me.wrapped_key_iv,
              wrapped_by_public_key_pem: me.wrapped_by_public_key_pem,
              epoch: Number(me.wrapped_key_epoch) || 1 }
          : null,
        members: await membersOf(tid),
      });
    }

    if (action === 'wrap_keys') {
      // STORES CIPHERTEXT AND PUBLIC KEYS ONLY. Each entry is the group key sealed to one member
      // under a key nobody but that member can derive; the private half never leaves the browser
      // and has no column anywhere in chat-schema.ts. This is what keeps src/lib/legal-hold.ts
      // truthful for groups: the server holds copies it cannot open.
      const tid = String(body.thread_id || '');
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const wrapperPem = String(body.wrapped_by_public_key_pem || '');
      if (!wrapperPem.startsWith('-----BEGIN PUBLIC KEY-----')) return refuse('Missing the key these copies were sealed with.');
      const epoch = Number(body.epoch) || 1;
      const entries: any[] = Array.isArray(body.entries) ? body.entries.slice(0, 50) : [];
      if (!entries.length) return refuse('Nothing to store.');
      // Only EMPTY slots are filled, unless the caller owns the thread. Any member can hand a key to
      // somebody who has none; overwriting a copy that already works would lock that person out of
      // their own history, and that must take deliberate ownership.
      const isOwner = String(me.role) === 'owner';
      let stored = 0;
      for (const en of entries) {
        const uid = String(en.user_id || '');
        const wk = String(en.wrapped_key || '');
        const wiv = String(en.wrapped_key_iv || '');
        if (!uid || !wk || !wiv) continue;
        const r = rows(await db.execute(sql`
          UPDATE chat_thread_members
             SET wrapped_key = ${wk}, wrapped_key_iv = ${wiv},
                 wrapped_by_user_id = ${user.id}, wrapped_by_public_key_pem = ${wrapperPem},
                 wrapped_key_epoch = ${epoch}
           WHERE thread_id = ${tid} AND user_id = ${uid}
             AND (${isOwner} OR wrapped_key IS NULL)
           RETURNING user_id`));
        stored += changed(r);
      }
      if (!stored) return refuse('Those members already hold a key for this group, so nothing was changed.');
      return jsonOut({ ok: true, stored, members: await membersOf(tid) });
    }

    if (action === 'send') {
      const tid = String(body.thread_id || '');
      const ciphertext = String(body.ciphertext || '');
      const iv = String(body.iv || '');
      const replyTo = body.reply_to_message_id ? String(body.reply_to_message_id) : null;
      const mentions: string[] = Array.isArray(body.mention_user_ids) ? body.mention_user_ids.slice(0, 25).map(String) : [];

      if (!tid) return refuse('No conversation was selected.');
      if (!ciphertext || !iv) return refuse('Nothing was encrypted to send. Your text is still in the box.');
      if (ciphertext.length > MAX_CIPHERTEXT) return refuse('That message is too long to store. Shorten it and send again.');

      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation, so it was not sent.', 403);

      // A reply must point INSIDE this thread. Otherwise the quote line renders someone else's
      // conversation, or nothing at all, and the reader cannot tell which.
      if (replyTo) {
        const q = rows(await db.execute(sql`
          SELECT id FROM chat_messages WHERE id = ${replyTo} AND thread_id = ${tid} LIMIT 1`));
        if (!q.length) return refuse('The message you replied to is not in this conversation.');
      }

      // Mentions are the ONE thing the server learns about the text, and only because a ping cannot
      // be delivered to a name the server cannot read. It learns WHO was named, never what was
      // written. Ids that are not members are dropped rather than notified.
      let mentionIds: string[] = [];
      if (mentions.length) {
        mentionIds = rows(await db.execute(sql`
          SELECT user_id FROM chat_thread_members
           WHERE thread_id = ${tid}
             AND user_id <> ${user.id}
             AND user_id::text IN (SELECT jsonb_array_elements_text(${JSON.stringify(mentions)}::jsonb))`))
          .map((x: any) => String(x.user_id));
      }
      const envelopeJson = JSON.stringify({ v: 2, mentions: mentionIds });

      // attachment_url is NOT written any more. It was a plaintext column on an end-to-end encrypted
      // messenger — the page promises the server cannot read the conversation, and every attachment
      // was a base64 image sitting beside the ciphertext in the clear, stamped `encrypted: true` in
      // its own metadata. Documents on this platform are links, and a link typed into the message
      // goes through the same encryption as the rest of the sentence. Rows written before this stay
      // readable and are labelled for what they are.
      const ins = rows(await db.execute(sql`
        INSERT INTO chat_messages (thread_id, sender_user_id, ciphertext, iv, envelope, reply_to_message_id)
        VALUES (${tid}, ${user.id}, ${ciphertext}, ${iv}, ${envelopeJson}::jsonb, ${replyTo})
        RETURNING id, created_at`));
      if (!ins.length) return refuse('The database accepted no row. Nothing was sent.', 500);

      await db.execute(sql`
        UPDATE chat_threads SET last_message_preview = '[encrypted]', last_message_at = NOW() WHERE id = ${tid}`);

      // Notifications. Muted members get nothing — mute used to change a switch on screen and
      // nothing else, so every "muted" thread went on pinging. A member NAMED in the message is
      // notified anyway, and the toggle says so in as many words.
      let notified = 0;
      try {
        const others = rows(await db.execute(sql`
          SELECT user_id, notifications_muted FROM chat_thread_members
           WHERE thread_id = ${tid} AND user_id <> ${user.id}`));
        const { sendPushToUser } = await import('@/lib/push');
        const url = CHAT_CANONICAL_HREF + '?thread=' + tid;
        const who = user.name || user.email || 'someone';
        for (const o of others) {
          const uid = String((o as any).user_id);
          const mentioned = mentionIds.includes(uid);
          if ((o as any).notifications_muted && !mentioned) continue;
          // sendPushToUser ALREADY writes the in-app bell row (persistNotifications) before it
          // touches web push. The old handler called notifyUser() straight afterwards with the same
          // title and a different entity_id, which slipped past both de-dupe windows, so every
          // direct message produced TWO identical notifications. One call, one notification.
          await sendPushToUser(uid, {
            type: 'dm',
            title: mentioned ? who + ' mentioned you' : 'New message from ' + who,
            body: mentioned ? 'You were named in an encrypted message.' : 'You have a new encrypted message.',
            url,
            tag: 'dm-' + tid,
          });
          notified++;
        }
      } catch (e: any) {
        // The message IS stored, so this must not fail the send — but it is not swallowed either.
        // A ping that silently stops arriving is indistinguishable from nobody having written.
        console.error('[portal/messages] notify', reason(e));
      }
      return jsonOut({ ok: true, id: ins[0].id, created_at: ins[0].created_at, notified, mentioned: mentionIds.length });
    }

    if (action === 'edit') {
      const mid = String(body.message_id || '');
      const ciphertext = String(body.ciphertext || '');
      const iv = String(body.iv || '');
      if (!mid || !ciphertext || !iv) return refuse('Nothing was encrypted to save.');
      if (ciphertext.length > MAX_CIPHERTEXT) return refuse('That message is too long to store.');
      // RETURNING, and the count is READ. Without it this UPDATE matched zero rows for anybody
      // else's message, for a deleted message, and for an id that never existed — and answered
      // ok:true to all three.
      const r = rows(await db.execute(sql`
        UPDATE chat_messages SET ciphertext = ${ciphertext}, iv = ${iv}, edited_at = NOW()
         WHERE id = ${mid} AND sender_user_id = ${user.id} AND deleted_at IS NULL
         RETURNING id, edited_at`));
      if (!changed(r)) return refuse('That message was not changed. It is either not yours or already deleted.', 404);
      return jsonOut({ ok: true, id: r[0].id, edited_at: r[0].edited_at });
    }

    if (action === 'delete') {
      const mid = String(body.message_id || '');
      if (!mid) return refuse('No message was selected.');
      const r = rows(await db.execute(sql`
        UPDATE chat_messages SET deleted_at = NOW()
         WHERE id = ${mid} AND sender_user_id = ${user.id} AND deleted_at IS NULL
         RETURNING id`));
      if (!changed(r)) return refuse('That message was not deleted. It is either not yours or already gone.', 404);
      return jsonOut({ ok: true, id: r[0].id });
    }

    if (action === 'mark_read') {
      const tid = String(body.thread_id || '');
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const r = rows(await db.execute(sql`
        UPDATE chat_thread_members SET last_read_at = NOW()
         WHERE thread_id = ${tid} AND user_id = ${user.id}
         RETURNING last_read_at`));
      // ONE statement, not a hundred. The old handler looped up to 100 separate INSERTs per call and
      // the poller called it every four seconds per open tab, which is a write storm against a
      // pooled connection for a feature nobody could see the result of.
      const receipts = rows(await db.execute(sql`
        INSERT INTO chat_message_receipts (message_id, user_id, delivered_at, read_at)
        SELECT c.id, ${user.id}, NOW(), NOW()
          FROM chat_messages c
         WHERE c.thread_id = ${tid}
           AND c.sender_user_id <> ${user.id}
           AND c.deleted_at IS NULL
           AND NOT EXISTS (SELECT 1 FROM chat_message_receipts x
                            WHERE x.message_id = c.id AND x.user_id = ${user.id})
        ON CONFLICT (message_id, user_id) DO NOTHING
        RETURNING message_id`));
      return jsonOut({ ok: true, last_read_at: r[0]?.last_read_at || null, receipts: receipts.length });
    }

    if (action === 'toggle_mute') {
      const tid = String(body.thread_id || '');
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      // The NEW VALUE comes back, and the switch on screen is drawn from it. It used to be flipped
      // optimistically and never reconciled, so a failed write left a thread showing "muted" that
      // went on notifying.
      const r = rows(await db.execute(sql`
        UPDATE chat_thread_members SET notifications_muted = NOT notifications_muted
         WHERE thread_id = ${tid} AND user_id = ${user.id}
         RETURNING notifications_muted`));
      if (!changed(r)) return refuse('The mute setting was not changed.', 500);
      return jsonOut({ ok: true, muted: !!r[0].notifications_muted });
    }

    if (action === 'set_disappearing') {
      const tid = String(body.thread_id || '');
      // THIS HAD NO MEMBERSHIP CHECK AT ALL. Any signed-in account could post a thread id it had
      // never been part of and start hiding that conversation's history from the people in it.
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const raw = Number(body.seconds || 0);
      const secs = raw > 0 ? Math.min(Math.floor(raw), 60 * 60 * 24 * 30) : null;
      const r = rows(await db.execute(sql`
        UPDATE chat_threads SET disappearing_seconds = ${secs} WHERE id = ${tid}
        RETURNING disappearing_seconds`));
      if (!changed(r)) return refuse('That setting was not changed.', 500);
      return jsonOut({ ok: true, disappearing_seconds: r[0].disappearing_seconds });
    }

    if (action === 'fetch_messages') {
      const tid = String(body.thread_id || '');
      const me = await membership(tid);
      if (!me) return refuse('You are not in that conversation.', 403);
      const th = rows(await db.execute(sql`
        SELECT kind, title, disappearing_seconds FROM chat_threads WHERE id = ${tid} LIMIT 1`));
      if (!th.length) return refuse('That conversation no longer exists.', 404);

      const ds = Number(th[0].disappearing_seconds) || 0;
      const cutoff = ds > 0 ? new Date(Date.now() - ds * 1000).toISOString() : null;
      const before = body.before ? String(body.before) : null;

      // NEWEST FIRST, THEN REVERSED. The old query was `ORDER BY created_at ASC LIMIT 200`, which
      // returns the OLDEST two hundred messages: past that mark a thread froze, every new message
      // was stored and never displayed, and the send looked like it had done nothing. Paging runs
      // backwards from the newest instead, with `before` to walk further back.
      const msgs = rows(await db.execute(sql`
        SELECT * FROM (
          SELECT m.id, m.sender_user_id, m.ciphertext, m.iv, m.envelope, m.attachment_url,
                 m.attachment_meta, m.reply_to_message_id, m.edited_at, m.deleted_at, m.created_at,
                 (SELECT COUNT(*)::int FROM chat_message_receipts r
                   WHERE r.message_id = m.id AND r.user_id <> ${user.id} AND r.read_at IS NOT NULL) AS read_by
            FROM chat_messages m
           WHERE m.thread_id = ${tid}
             AND (${cutoff}::timestamptz IS NULL OR m.created_at >= ${cutoff}::timestamptz)
             AND (${before}::timestamptz IS NULL OR m.created_at < ${before}::timestamptz)
           ORDER BY m.created_at DESC
           LIMIT ${PAGE_SIZE}
        ) x ORDER BY x.created_at ASC`));

      const members = await membersOf(tid);
      return jsonOut({
        ok: true,
        messages: msgs,
        members,
        kind: th[0].kind,
        member_count: members.length,
        // True when this page is not the whole history, so the client can offer "earlier messages"
        // instead of letting the reader assume the conversation starts here.
        has_more: msgs.length === PAGE_SIZE,
        oldest: msgs.length ? msgs[0].created_at : null,
        disappearing_seconds: ds || null,
      });
    }

    if (action === 'threads') {
      return jsonOut({ ok: true, threads: await threadRowsFor() });
    }

    if (action === 'poll') {
      // The cheap heartbeat. Returns the unread counts and one SIGNATURE for the open thread —
      // number of messages plus the latest of created/edited/deleted. The client only refetches and
      // re-decrypts when that string changes, so an idle conversation costs one small query rather
      // than a full page of ciphertext and a DOM rebuild every four seconds.
      const tid = String(body.thread_id || '');
      const threads = await threadRowsFor();
      let signature = '';
      if (tid && threads.some((t: any) => String(t.id) === tid)) {
        const s = rows(await db.execute(sql`
          SELECT COUNT(*)::int AS n,
                 MAX(GREATEST(created_at, COALESCE(edited_at, created_at), COALESCE(deleted_at, created_at))) AS newest
            FROM chat_messages WHERE thread_id = ${tid}`));
        signature = String(s[0]?.n || 0) + ':' + String(s[0]?.newest || '');
      }
      return jsonOut({ ok: true, threads, signature });
    }

    if (action === 'search') {
      // ------------------------------------------------------------------------------------------
      // METADATA ONLY, AND THAT IS NOT A LIMITATION TO BE ENGINEERED AROUND.
      //
      // src/lib/legal-hold.ts states in writing that portal direct messages cannot be produced:
      // "there is no key escrow, so the server has never held the keys and CANNOT decrypt them",
      // and every held thread it returns carries contentRecoverable: false. A server-side index over
      // message text would require the server to hold plaintext, which would make that statement
      // false — for a legal record, in a system whose whole claim is that nobody can read your
      // messages. Adding a search box is not a reason to quietly retire a privacy guarantee.
      //
      // So this searches what the server legitimately knows: who you are talking to, what the
      // conversation is called, and when it last moved. Message TEXT is searched in the browser,
      // over what this reader can already decrypt (see searchAllThreads() in the client), and the
      // screen says which of the two is happening.
      // ------------------------------------------------------------------------------------------
      const q = String(body.q || '').trim().slice(0, 120);
      if (!q) return jsonOut({ ok: true, threads: [], contentSearched: false });
      const like = '%' + q.replace(/[%_]/g, (c) => '\\' + c) + '%';
      const found = rows(await db.execute(sql`
        SELECT DISTINCT t.id, t.kind, t.title, t.last_message_at
          FROM chat_threads t
          JOIN chat_thread_members me ON me.thread_id = t.id AND me.user_id = ${user.id}
          LEFT JOIN chat_thread_members o ON o.thread_id = t.id
          LEFT JOIN users u ON u.id = o.user_id
         WHERE t.title ILIKE ${like} OR u.name ILIKE ${like} OR u.email ILIKE ${like}
         ORDER BY t.last_message_at DESC NULLS LAST
         LIMIT 30`));
      return jsonOut({ ok: true, threads: found, contentSearched: false });
    }

    return refuse('Unknown action: ' + (action || '(none)'), 400);
  } catch (e: any) {
    // NEVER SWALLOWED. The reason reaches the log with e.cause first (e.message is only the failed
    // SQL) and a truthful sentence reaches the person, who still has their text in the box.
    console.error('[portal/messages] action=' + action, reason(e));
    return jsonOut({ ok: false, error: 'The server could not complete that: ' + reason(e) }, 500);
  }
}

// --- Initial server render data ----------------------------------------------
// Ensure there's a private notes thread on first visit so the UI isn't empty.
let myThreads = await threadRowsFor();

if (!myThreads.length) {
  const w = rows(await db.execute(sql`
    INSERT INTO chat_threads (kind, title, created_by_user_id)
    VALUES ('direct', 'Private notes', ${user.id})
    RETURNING id
  `));
  await db.execute(sql`
    INSERT INTO chat_thread_members (thread_id, user_id, role)
    VALUES (${w[0].id}, ${user.id}, 'owner')
  `);
  myThreads = await threadRowsFor();
}

// Member lookup per thread (limited)
const threadMembers: { [k: string]: any[] } = {};
for (const t of myThreads.slice(0, 25)) {
  threadMembers[t.id] = await membersOf(t.id);
}

// The unread total for the whole mailbox, rendered into the document title so a background tab
// still says how many conversations are waiting.
const totalUnread = myThreads.reduce((n: number, t: any) => n + (Number(t.unread) || 0), 0);

// A thread is addressable server-side: /portal/messages?thread=<id>. This is what the
// phone layout navigates with (a real link, no JS required) and it is also the URL the
// DM push notification above already sends people to. Validated against this user's own
// threads, so an unknown or foreign id simply falls back to the first thread.
const requestedThreadId = (Astro.url.searchParams.get('thread') || '').trim();
const threadRequested = !!requestedThreadId && myThreads.some((t: any) => String(t.id) === requestedThreadId);
const initialThreadId = threadRequested ? requestedThreadId : (myThreads[0]?.id || '');
const myName = (user as any).name || (user as any).email || 'You';
const myEmail = (user as any).email || '';

// Seed JSON for the client — kept compact
const seed = {
  me: { id: user.id, name: myName, email: myEmail },
  threads: myThreads.map((t: any) => ({
    id: t.id, kind: t.kind, title: t.title || 'Untitled',
    last_message_at: t.last_message_at,
    unread: Number(t.unread) || 0,
    muted: !!t.notifications_muted, disappearing_seconds: t.disappearing_seconds,
    role: t.role,
    // Group key material for THIS reader only: a copy of the group key sealed to them, plus the
    // public key it was sealed with. Both are useless without a private key that exists only in
    // this browser. Nothing here lets the server read a message.
    key_epoch: Number(t.key_epoch) || 1,
    my_wrapped_key: t.wrapped_key || null,
    my_wrapped_key_iv: t.wrapped_key_iv || null,
    my_wrapped_by_pem: t.wrapped_by_public_key_pem || null,
    my_wrapped_key_epoch: Number(t.wrapped_key_epoch) || 1,
    members: (threadMembers[t.id] || []).map((m: any) => ({
      user_id: m.user_id, name: m.full_name || m.email || 'Unknown',
      email: m.email || '', role: m.role, public_key_pem: m.public_key_pem || null,
      has_wrapped_key: !!m.has_wrapped_key
    }))
  })),
  initialThreadId
};
const pageTitle = totalUnread > 0 ? '(' + totalUnread + ') Messages' : 'Messages';
---
<BaseLayout title={pageTitle} description="In-house end-to-end encrypted messenger.">
<style>
:root { color-scheme: dark; }
body { background: #0a0a0c; color: #e8e8ee; margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; }
body.era-has-fab { padding-bottom: 0; }
.msg-shell { display: grid; grid-template-columns: 260px 1fr 280px; height: 100vh; max-height: 100vh; overflow: hidden; }
.msg-col { background: #11131a; border-right: 1px solid #2a2a35; display: flex; flex-direction: column; min-height: 0; }
.msg-col.right { border-right: 0; border-left: 1px solid #2a2a35; }
.msg-col.center { background: #0a0a0c; border-right: 0; }

.col-head { padding: 14px 16px; border-bottom: 1px solid #2a2a35; display: flex; align-items: center; gap: 10px; }
.col-head h2 { margin: 0; font-size: 20px; font-weight: 500; letter-spacing: 0.3px; }
.icon-btn { background: transparent; border: 1px solid #2a2a35; color: #e8e8ee; width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: all .15s; }
.icon-btn:hover { background: #1a1c25; border-color: #67e8f9; }
.icon-btn svg { width: 16px; height: 16px; }

.search-row { padding: 10px 12px; border-bottom: 1px solid #2a2a35; }
.search-row input { width: 100%; background: #0a0a0c; border: 1px solid #2a2a35; color: #e8e8ee; border-radius: 8px; padding: 9px 12px; font-family: 'Geist Mono', monospace; font-size: 12px; }
.search-row input:focus { outline: none; border-color: #67e8f9; }
/* The sentence under the search box is not decoration. It is the only place the reader is told
   that the server searches names and titles and CANNOT search message text, which is the whole
   reason the second, in-browser search exists. */
.search-scope { font-family: 'Geist Mono', monospace; font-size: 10px; line-height: 1.6; color: #8a8a99; margin-top: 8px; }
.link-btn { display: inline; background: transparent; border: 0; padding: 0; margin: 0; color: #67e8f9; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.link-btn:disabled { color: #6b6b7a; cursor: default; text-decoration: none; }
.search-progress { font-family: 'Geist Mono', monospace; font-size: 10px; color: #67e8f9; margin-top: 8px; line-height: 1.6; }
.search-results { border-top: 1px solid #2a2a35; }
/* box-sizing is load-bearing on this page: there is no global border-box reset, so width:100%
   plus horizontal padding pushes an element wider than the column that holds it, and at 360px
   that is a sideways scroll on the whole page. Same trap as the fingerprint button below. */
.search-hit { display: block; width: 100%; box-sizing: border-box; text-align: left; background: transparent; border: 0; border-bottom: 1px solid #1a1c25; padding: 10px 14px; cursor: pointer; color: inherit; }
.search-hit:hover { background: #161823; }
.search-hit .hit-thread { font-family: 'Cormorant Garamond', serif; font-size: 15px; }
.search-hit .hit-snip { font-family: 'Geist Mono', monospace; font-size: 10px; color: #8a8a99; margin-top: 3px; overflow-wrap: anywhere; }
.search-hit mark { background: rgba(103, 232, 249, 0.25); color: #e8e8ee; }

.mention-pop { display: none; background: #11131a; border: 1px solid #2a2a35; border-radius: 10px; margin-bottom: 8px; max-height: 180px; overflow-y: auto; }
.mention-pop.open { display: block; }
.mention-pop button { display: block; width: 100%; box-sizing: border-box; text-align: left; background: transparent; border: 0; color: #e8e8ee; padding: 10px 12px; cursor: pointer; font-family: 'Cormorant Garamond', serif; font-size: 15px; min-height: 44px; }
.mention-pop button:hover, .mention-pop button[aria-selected='true'] { background: #1c2030; color: #67e8f9; }
.msg-mention { color: #67e8f9; font-weight: 600; }
.msg-mention.me { background: rgba(103, 232, 249, 0.18); border-radius: 4px; padding: 0 3px; }

.panel-btn { width: 100%; box-sizing: border-box; background: transparent; border: 1px solid #2a2a35; color: #e8e8ee; border-radius: 8px; padding: 10px; cursor: pointer; font-family: 'Geist Mono', monospace; font-size: 11px; min-height: 44px; }
.panel-btn:hover { border-color: #67e8f9; }
.panel-note { font-family: 'Geist Mono', monospace; font-size: 10px; line-height: 1.6; color: #8a8a99; margin-top: 8px; overflow-wrap: anywhere; }
.panel-note.warn { color: #fca5a5; }

/* Truthful states in the stream: why a message will not open, and where history stops. */
.stream-note { font-family: 'Geist Mono', monospace; font-size: 10px; line-height: 1.6; color: #8a8a99; background: #11131a; border: 1px solid #2a2a35; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; }
.stream-note.warn { border-color: #ef4444; color: #fca5a5; }
.load-earlier { align-self: center; background: transparent; border: 1px solid #2a2a35; color: #e8e8ee; border-radius: 999px; padding: 8px 16px; min-height: 44px; cursor: pointer; font-family: 'Geist Mono', monospace; font-size: 11px; margin-bottom: 6px; }
.load-earlier:hover { border-color: #67e8f9; }
.msg-text.locked { font-style: italic; color: #fca5a5; }
.attach-legacy { font-family: 'Geist Mono', monospace; font-size: 9px; color: #facc15; margin-bottom: 4px; }
.thread-badge.muted-badge { background: #2a2a35; color: #8a8a99; }
.status-line { color: #8a8a99; }
.status-line.bad { color: #fca5a5; }

.thread-list { flex: 1; overflow-y: auto; }
.thread-row { display: flex; gap: 10px; padding: 12px 14px; cursor: pointer; border-bottom: 1px solid #1a1c25; align-items: center; color: inherit; text-decoration: none; }
.thread-row:hover { background: #161823; }
.thread-row.active { background: #1c2030; border-left: 3px solid #67e8f9; padding-left: 11px; }
.avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #67e8f9, #a78bfa); display: flex; align-items: center; justify-content: center; color: #0a0a0c; font-weight: 600; font-family: 'Geist Mono', monospace; font-size: 14px; flex-shrink: 0; position: relative; }
.avatar.lg { width: 44px; height: 44px; font-size: 16px; }
.avatar.xl { width: 56px; height: 56px; font-size: 20px; }
.presence-dot { position: absolute; right: -1px; bottom: -1px; width: 11px; height: 11px; background: #4ade80; border-radius: 50%; border: 2px solid #11131a; }
.presence-dot.away { background: #facc15; }
.presence-dot.off { background: #52525b; }

.thread-meta { flex: 1; min-width: 0; }
.thread-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; line-height: 1.1; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.thread-preview { font-family: 'Geist Mono', monospace; font-size: 11px; color: #8a8a99; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.thread-time { font-family: 'Geist Mono', monospace; font-size: 10px; color: #6b6b7a; }
.thread-badge { background: #67e8f9; color: #0a0a0c; border-radius: 10px; padding: 1px 7px; font-family: 'Geist Mono', monospace; font-size: 10px; font-weight: 600; }

.new-chat-btn { margin: 10px 12px; padding: 9px 12px; background: linear-gradient(135deg, #67e8f9, #a78bfa); color: #0a0a0c; border: 0; border-radius: 8px; font-weight: 600; cursor: pointer; font-family: 'Geist Mono', monospace; font-size: 12px; }

.chat-head { padding: 12px 18px; border-bottom: 1px solid #2a2a35; display: flex; align-items: center; gap: 12px; background: #11131a; }
.chat-head .thread-title { font-size: 19px; margin-bottom: 1px; }
.chat-head-meta { flex: 1; min-width: 0; }
.chat-head-actions { display: flex; gap: 6px; }
.e2e-pill { display: inline-flex; align-items: center; gap: 5px; background: rgba(34, 197, 94, 0.12); color: #4ade80; padding: 3px 9px; border-radius: 999px; font-family: 'Geist Mono', monospace; font-size: 10px; cursor: pointer; }
.e2e-pill svg { width: 10px; height: 10px; }

.stream { flex: 1; overflow-y: auto; padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
.day-sep { text-align: center; font-family: 'Geist Mono', monospace; font-size: 10px; color: #6b6b7a; margin: 14px 0 6px; letter-spacing: 1px; text-transform: uppercase; }
.msg-row { display: flex; gap: 8px; max-width: 70%; align-items: flex-end; }
.msg-row.me { align-self: flex-end; flex-direction: row-reverse; }
.msg-bubble { background: #1a1c25; padding: 8px 12px 6px; border-radius: 14px; border-bottom-left-radius: 4px; position: relative; max-width: 100%; word-wrap: break-word; }
.msg-row.me .msg-bubble { background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff; border-bottom-left-radius: 14px; border-bottom-right-radius: 4px; }
.msg-text { font-family: 'Cormorant Garamond', serif; font-size: 16px; line-height: 1.35; white-space: pre-wrap; }
.msg-text.deleted { font-style: italic; color: #6b6b7a; }
.msg-footer { display: flex; align-items: center; gap: 6px; justify-content: flex-end; margin-top: 2px; }
.msg-time { font-family: 'Geist Mono', monospace; font-size: 9px; color: rgba(232,232,238,0.5); }
.msg-row.me .msg-time { color: rgba(255,255,255,0.7); }
.tick { width: 14px; height: 10px; }
.tick.read { color: #67e8f9; }
.tick.sent { color: rgba(255,255,255,0.55); }
.msg-quote { background: rgba(0,0,0,0.25); border-left: 2px solid #67e8f9; padding: 4px 8px; margin-bottom: 4px; border-radius: 4px; font-family: 'Geist Mono', monospace; font-size: 11px; color: #b0b0bb; }
.msg-attach { margin: 4px 0; border-radius: 8px; max-width: 280px; max-height: 200px; }
.msg-actions { position: absolute; top: -10px; right: 10px; display: none; gap: 3px; background: #1a1c25; border: 1px solid #2a2a35; padding: 3px; border-radius: 8px; }
.msg-row:hover .msg-actions { display: flex; }
.msg-actions button { background: transparent; border: 0; color: #b0b0bb; cursor: pointer; padding: 3px; border-radius: 4px; }
.msg-actions button:hover { background: #2a2a35; color: #fff; }
.msg-actions svg { width: 12px; height: 12px; }

.typing { font-family: 'Geist Mono', monospace; font-size: 10px; color: #67e8f9; padding: 4px 20px; height: 18px; }

.composer-wrap { border-top: 1px solid #2a2a35; background: #11131a; padding: 10px 14px 14px; }
.composer { display: flex; align-items: flex-end; gap: 8px; }
.composer textarea { flex: 1; background: #0a0a0c; border: 1px solid #2a2a35; color: #e8e8ee; border-radius: 12px; padding: 10px 12px; font-family: 'Cormorant Garamond', serif; font-size: 16px; resize: none; min-height: 40px; max-height: 140px; }
.composer textarea:focus { outline: none; border-color: #67e8f9; }
.composer .icon-btn { width: 38px; height: 38px; }
.send-btn { background: linear-gradient(135deg, #67e8f9, #a78bfa); border: 0; color: #0a0a0c; }
.send-btn:hover { filter: brightness(1.1); }
.reply-bar { background: #1a1c25; border-left: 3px solid #67e8f9; padding: 6px 10px; margin-bottom: 8px; font-family: 'Geist Mono', monospace; font-size: 11px; color: #b0b0bb; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; }
.send-error { background: rgba(239, 68, 68, 0.12); border-left: 3px solid #ef4444; color: #fca5a5; padding: 8px 10px; margin-bottom: 8px; border-radius: 4px; font-family: 'Geist Mono', monospace; font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }

.emoji-pop { position: absolute; bottom: 60px; right: 80px; background: #11131a; border: 1px solid #2a2a35; border-radius: 10px; padding: 8px; display: none; grid-template-columns: repeat(8, 1fr); gap: 4px; z-index: 50; }
.emoji-pop.open { display: grid; }
.emoji-pop button { background: transparent; border: 0; color: #e8e8ee; cursor: pointer; padding: 4px; border-radius: 4px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; }
.emoji-pop button:hover { background: #1a1c25; }
.emoji-pop svg { width: 18px; height: 18px; }

.right-section { padding: 16px; border-bottom: 1px solid #2a2a35; }
.panel-input { width: 100%; background: #0a0a0c; border: 1px solid #2a2a35; color: #e8e8ee; border-radius: 8px; padding: 9px 12px; font-family: 'Geist Mono', monospace; font-size: 12px; box-sizing: border-box; }
.panel-input:focus { outline: none; border-color: #67e8f9; }
.right-section h3 { font-family: 'Geist Mono', monospace; font-size: 11px; color: #8a8a99; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 10px; font-weight: 500; }
.member-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; cursor: pointer; }
.member-row:hover { color: #67e8f9; }
.member-name { font-family: 'Cormorant Garamond', serif; font-size: 15px; flex: 1; }
.member-role { font-family: 'Geist Mono', monospace; font-size: 10px; color: #8a8a99; }

.media-empty { font-family: 'Geist Mono', monospace; font-size: 11px; color: #6b6b7a; padding: 12px 0; text-align: center; border: 1px dashed #2a2a35; border-radius: 6px; }

.toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; font-family: 'Cormorant Garamond', serif; font-size: 15px; }
.switch { width: 36px; height: 20px; background: #2a2a35; border-radius: 999px; position: relative; cursor: pointer; transition: all .15s; }
.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; background: #e8e8ee; border-radius: 50%; transition: all .15s; }
.switch.on { background: #67e8f9; }
.switch.on::after { left: 18px; background: #0a0a0c; }

.fp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.fp-cell { font-family: 'Geist Mono', monospace; font-size: 13px; background: #0a0a0c; border: 1px solid #2a2a35; padding: 4px 6px; border-radius: 4px; text-align: center; color: #67e8f9; }

.modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: none; z-index: 100; align-items: center; justify-content: center; }
.modal-backdrop.open { display: flex; }
.modal { background: #11131a; border: 1px solid #2a2a35; border-radius: 14px; padding: 24px; min-width: 360px; max-width: 480px; }
.modal h3 { margin: 0 0 14px; font-family: 'Cormorant Garamond', serif; font-size: 22px; }
.modal label { display: block; font-family: 'Geist Mono', monospace; font-size: 11px; color: #8a8a99; margin: 10px 0 4px; text-transform: uppercase; letter-spacing: 1px; }
.modal input, .modal select { width: 100%; background: #0a0a0c; border: 1px solid #2a2a35; color: #e8e8ee; padding: 9px 12px; border-radius: 8px; font-family: 'Geist Mono', monospace; font-size: 12px; box-sizing: border-box; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }
.modal-actions button { padding: 9px 14px; border-radius: 8px; cursor: pointer; border: 0; font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 600; }
.btn-primary { background: linear-gradient(135deg, #67e8f9, #a78bfa); color: #0a0a0c; }
.btn-ghost { background: transparent; color: #e8e8ee; border: 1px solid #2a2a35 !important; }

.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #6b6b7a; font-family: 'Geist Mono', monospace; font-size: 12px; gap: 10px; }
.empty-state svg { width: 64px; height: 64px; opacity: 0.4; }

/* Controls that exist only in the phone composition. Hidden by default so the desktop
   three-column layout renders exactly as before. */
.mobile-only { display: none; }
.back-link { align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid #2a2a35; border-radius: 8px; color: #e8e8ee; text-decoration: none; flex-shrink: 0; }
.back-link svg { width: 18px; height: 18px; }

/* Tablet: drop the info column, keep two. Unchanged from before, now bounded below so it
   does not fight the phone composition. */
@media (min-width: 768px) and (max-width: 900px) {
  .msg-shell { grid-template-columns: 240px 1fr; }
  .msg-col.right { display: none; }
}

/* The desktop info toggle used to write an inline display style, which then leaked into
   the phone layout and made the info panel unopenable there. Same effect, as a class. */
@media (min-width: 768px) {
  .msg-shell.info-hidden .msg-col.right { display: none; }
}

/* ---------------------------------------------------------------------------
   Phone: one column at a time. The thread list IS the page; picking a thread is a
   real navigation to ?thread=<id> which swaps in the conversation; thread info is a
   panel behind a button rather than a docked column.
   --------------------------------------------------------------------------- */
/* 767.98 and not 767: a viewport width is not always a whole number. Windows and Linux
   fractional display scaling, browser page zoom and device emulation all produce widths
   like 767.5px, and between `max-width: 767px` and `min-width: 768px` sat a sliver where
   NEITHER block applied and the shell fell back to the three-column desktop grid inside a
   767px window. isPhone() below carries the same bound so script and stylesheet agree. */
@media (max-width: 767.98px) {
  .msg-shell { grid-template-columns: 1fr; height: 100dvh; max-height: 100dvh; }
  .msg-col { border-right: 0; }
  .msg-col.left { display: flex; }
  .msg-col.center { display: none; }
  .msg-col.right { display: none; }
  .msg-shell.show-conversation .msg-col.left { display: none; }
  .msg-shell.show-conversation .msg-col.center { display: flex; }

  /* Info opens over the conversation, then closes. It is never docked. */
  .msg-shell.info-open .msg-col.right {
    display: flex; position: fixed; inset: 0; z-index: 150;
    border-left: 0; overflow-y: auto; -webkit-overflow-scrolling: touch;
  }

  .mobile-only { display: inline-flex; }
  .desk-only { display: none; }

  /* Tap targets: 44x44 minimum. */
  .icon-btn, .composer .icon-btn, .back-link { width: 44px; height: 44px; }
  .icon-btn svg, .back-link svg { width: 20px; height: 20px; }
  .new-chat-btn { padding: 14px 12px; font-size: 13px; }
  .thread-row { padding: 14px; min-height: 64px; }
  .thread-row.active { padding-left: 11px; }
  .member-row { min-height: 44px; }
  .switch { width: 52px; height: 30px; }
  .switch::after { width: 24px; height: 24px; }
  .switch.on::after { left: 24px; }

  /* 16px inputs so the phone does not zoom the viewport on focus. */
  .search-row input, .panel-input, .modal input, .modal select, .composer textarea { font-size: 16px; }

  /* Nothing may scroll the page sideways at 360px. Both of these are flex items that
     cannot otherwise shrink below their intrinsic width (a textarea defaults to 20
     columns), and a 100%-wide input with padding needs a border-box. */
  .composer textarea { min-width: 0; box-sizing: border-box; }
  .search-row input { box-sizing: border-box; }

  .chat-head { padding: 10px 12px; gap: 8px; }
  .chat-head .avatar.lg { display: none; }
  .chat-head-actions { gap: 4px; }
  .stream { padding: 14px 12px; }
  .msg-row { max-width: 88%; }
  .msg-text, .msg-quote { overflow-wrap: anywhere; }
  .right-section .icon-btn { min-height: 44px; }
  .msg-attach { max-width: 100%; height: auto; }
  .right-section { padding: 14px; }
  .modal-backdrop { padding: 14px; box-sizing: border-box; }
  .modal { min-width: 0; width: 100%; max-width: 100%; box-sizing: border-box; padding: 18px; }
  .search-hit { padding: 12px 14px; min-height: 44px; }
  .link-btn { min-height: 44px; display: inline-block; }

  /* Bottom padding clears the fixed action button parked in the lower-left corner. */
  .composer-wrap { position: relative; padding: 10px 12px 76px; }
  .emoji-pop { left: 12px; right: 12px; bottom: 88px; grid-template-columns: repeat(6, 1fr); }
  .emoji-pop button { width: 100%; height: 44px; }

  /* Hover never happens on a phone, so per-message actions sit in the bubble instead. */
  .msg-actions { position: static; display: flex; justify-content: flex-end; gap: 2px; margin-top: 6px; background: transparent; border: 0; padding: 0; }
  .msg-actions button { width: 44px; height: 44px; }
  .msg-actions svg { width: 16px; height: 16px; }
}
</style>

<div class={'msg-shell' + (threadRequested ? ' show-conversation' : '')} id="shell">

  <!-- LEFT: thread list -->
  <aside class="msg-col left">
    <div class="col-head">
      <h2>Messages</h2>
      <span style="flex:1"></span>
      <button class="icon-btn" id="btnNewChat" title="New chat" aria-label="New chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>
    <div class="search-row">
      <input id="threadSearch" placeholder="search people and conversations" aria-describedby="searchScope" />
      <div class="search-scope" id="searchScope">
        Names, addresses and conversation titles are searched on the server. Message text is
        end-to-end encrypted and the server cannot read it.
        <button type="button" class="link-btn" id="btnSearchText">Search message text in this browser</button>
      </div>
      <div class="search-progress" id="searchProgress" role="status" style="display:none"></div>
    </div>
    <div class="search-results" id="searchResults" style="display:none"></div>
    <button class="new-chat-btn" id="btnNewChatAlt">+ Start new conversation</button>
    <div class="thread-list" id="threadList">
      {myThreads.map((t: any) => (
        <a class={'thread-row' + (String(t.id) === String(initialThreadId) ? ' active' : '')}
           href={'/portal/messages?thread=' + t.id}>
          <div class="avatar">{initialOf(t.title)}</div>
          <div class="thread-meta">
            <div class="thread-title">{t.title || 'Untitled'}</div>
            <div class="thread-preview">{Number(t.unread) > 0 ? Number(t.unread) + ' unread' : (t.kind === 'group' ? 'group' : 'direct message')}</div>
          </div>
          <div class="thread-time">{shortDate(t.last_message_at)}</div>
          {Number(t.unread) > 0 && <div class="thread-badge">{Number(t.unread)}</div>}
        </a>
      ))}
    </div>
  </aside>

  <!-- CENTER: active conversation -->
  <section class="msg-col center">
    <div class="chat-head" id="chatHead">
      <a class="back-link mobile-only" id="btnBack" href="/portal/messages" aria-label="Back to conversations">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div class="avatar lg" id="chatAvatar">?</div>
      <div class="chat-head-meta">
        <div class="thread-title" id="chatTitle">Select a chat</div>
        <div class="e2e-pill" id="e2ePill" title="Click for encryption details">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          end-to-end encrypted
        </div>
      </div>
      <div class="chat-head-actions">
        {/* The voice and video buttons that used to sit here opened an overlay, asked for the
            microphone, and printed "Connected - awaiting peer (signalling channel via E2E DM)".
            There was no RTCPeerConnection, no offer, no answer and no signalling channel of any
            kind: the only thing that ever happened was the caller's own microphone switching on,
            while the person being "called" was never contacted and never knew. Somebody could have
            believed an urgent call had gone through. A button that lies about reaching a colleague
            is worse than no button, so it is gone rather than restyled. */}
        <button class="icon-btn desk-only" id="btnInfo" title="Thread info" aria-label="Thread info">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        </button>
        <button class="icon-btn mobile-only" id="btnInfoMobile" title="Thread info" aria-label="Thread info" aria-expanded="false" aria-controls="rightPanel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        </button>
      </div>
    </div>

    <div class="stream" id="stream">
      <noscript>
        <div class="empty-state">
          <div>Messages are decrypted in your browser, so JavaScript has to be on to read this conversation.</div>
        </div>
      </noscript>
      <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <div>Select a conversation to begin</div>
      </div>
    </div>

    <div class="typing" id="typing"></div>

    <div class="composer-wrap" id="composerWrap" style="display:none">
      <!-- The send used to ignore the server's answer entirely: it cleared the box and reloaded the
           thread whichever way the POST went, so while every INSERT was failing on the schema
           collision the screen looked like a working messenger that people were being ignored in.
           This line is how a refused send now says so, and the text stays in the box. -->
      <div class="send-error" id="sendError" role="alert" style="display:none"></div>
      <div class="reply-bar" id="replyBar" style="display:none">
        <span id="replyBarText"></span>
        <button class="icon-btn" id="replyCancel" style="width:22px;height:22px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      {/* THE ATTACH BUTTON IS GONE, AND NOT BECAUSE IT WAS UGLY. It read the file to a base64
          data URL and posted it as `attachment_url` — a PLAINTEXT column on an end-to-end
          encrypted messenger, stamped `encrypted: true` in its own metadata, which was false.
          The send handler above stopped writing that column, so from that moment the button
          accepted a file, showed it attached, and stored nothing: the exact "reported success
          while nothing happened" this page was repaired for. Documents on this platform are
          Google Drive links (the only stored upload anywhere is the small profile photo), and a
          link typed into the box is encrypted with the rest of the sentence. So the composer
          says that instead of pretending to carry a file. */}
      <div class="mention-pop" id="mentionPop" role="listbox" aria-label="Mention someone"></div>
      <div class="composer">
        <button class="icon-btn" id="btnEmoji" title="Glyph picker" aria-label="Glyph picker">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>
        </button>
        <textarea id="composer" placeholder="Message. Enter sends, Shift+Enter is a newline, @ names someone. Paste a Drive link to share a document." rows="1"></textarea>
        <button class="icon-btn send-btn" id="btnSend" title="Send" aria-label="Send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </div>
      <div class="emoji-pop" id="emojiPop" aria-hidden="true"></div>
    </div>
  </section>

  <!-- RIGHT: thread info -->
  <aside class="msg-col right" id="rightPanel">
    <div class="col-head">
      <h2>Thread info</h2>
      <button class="icon-btn mobile-only" id="btnInfoClose" title="Close thread info" aria-label="Close thread info" style="margin-left:auto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="right-section" id="aboutSection">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px">
        <div class="avatar xl" id="rightAvatar">?</div>
        <div>
          <div style="font-family:'Cormorant Garamond',serif; font-size:18px" id="rightTitle">—</div>
          <div style="font-family:'Geist Mono',monospace; font-size:10px; color:#8a8a99" id="rightSub">—</div>
        </div>
      </div>
    </div>

    <div class="right-section">
      <h3>Members</h3>
      <div id="memberList"></div>
      {/* Group membership is a real server action (add_member) that had no control anywhere on
          screen, so a group could only ever contain the person who made it. */}
      <div id="addMemberRow" style="display:none; margin-top:10px">
        <input id="addMemberEmail" class="panel-input" placeholder="email address to add" />
        <button class="panel-btn" id="btnAddMember" style="margin-top:6px">Add to this group</button>
        <div class="panel-note" id="addMemberNote" role="status"></div>
      </div>
    </div>

    <div class="right-section">
      <h3>Keys</h3>
      {/* What this reader can and cannot open, in words. It used to be silent, and a member who
          held no group key simply saw a screen of undecryptable messages with no reason given. */}
      <div class="panel-note" id="keyState">—</div>
    </div>

    <div class="right-section">
      <h3>Documents</h3>
      <div class="panel-note">
        Attachments are not uploaded here. Share a document as a Google Drive link with
        &quot;Anyone with the link&quot; access — the link is encrypted along with the rest of your
        message. Images sent before this rule was applied are still shown in the conversation and
        are marked, because they were stored unencrypted.
      </div>
    </div>

    <div class="right-section">
      <h3>Search in this conversation</h3>
      <input id="threadSearchIn" class="panel-input" placeholder="search the messages you can read" />
      <div id="searchInResults" style="margin-top:8px; max-height:200px; overflow-y:auto"></div>
    </div>

    <div class="right-section">
      <h3>Privacy</h3>
      <div class="toggle-row">
        Notifications muted
        <div class="switch" id="muteSwitch" role="switch" tabindex="0"></div>
      </div>
      <div class="toggle-row">
        Disappearing (24h)
        <div class="switch" id="disappearSwitch" role="switch" tabindex="0"></div>
      </div>
      {/* box-sizing is load-bearing: this page has no global border-box reset, so width:100%
          plus 10px padding and a 1px border made this button 22px wider than the section that
          holds it. On a phone the info panel is a fixed, overflow-y:auto column, which makes
          overflow-x compute to auto — so those 22px were a sideways scroll inside the panel. */}
      <button class="icon-btn" id="btnFingerprint" style="box-sizing:border-box; width:100%; padding:10px; height:auto; margin-top:8px; font-family:'Geist Mono',monospace; font-size:11px; gap:6px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M9 12h6m-6 4h6m-7 4h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.5a3.5 3.5 0 0 0-7 0H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/></svg>
        view key fingerprint
      </button>
    </div>
  </aside>
</div>

<!-- New chat modal -->
