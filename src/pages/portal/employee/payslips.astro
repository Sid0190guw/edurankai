---
// /portal/employee/payslips — an employee's own pay record.
//
// WHAT WAS MISSING. /portal/payslip/[id] has existed for a while and correctly serves ONE payslip to
// the person it belongs to — but nothing anywhere listed them, so the only way to reach your own
// payslip was to already know its id. This is the list. It links straight at that existing route; it
// does not re-render the document and it does not re-implement the ownership check.
//
// AUTHORISATION IS OWNERSHIP, NOT A ROLE. Every read on this page is narrowed by employee_id in the
// WHERE clause (payslipsForEmployee), resolved from the signed-in account. There is no id in the URL
// and no capability involved: an employee's own pay is theirs, and nobody else's is reachable from
// here at all.
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { payslipsForEmployee, MONTH_NAMES } from '@/lib/payroll';
import { getBalance } from '@/lib/hr-wallet';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/employee/payslips');

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

// The same resolution /portal/employee/wallet uses: the linked account first, then the three email
// columns, because the users-to-employees link is not guaranteed to have been filled in.
let employee: any = null;
let lookupFailed = false;
try {
  employee = rowsOf(await db.execute(sql`
    SELECT id, full_name, employee_code, designation, currency
      FROM hr_employees WHERE user_id = ${user.id} AND is_active = true LIMIT 1`))[0]
    || rowsOf(await db.execute(sql`
    SELECT id, full_name, employee_code, designation, currency
      FROM hr_employees
     WHERE (work_email = ${user.email} OR personal_email = ${user.email} OR email = ${user.email})
       AND is_active = true LIMIT 1`))[0]
    || null;
} catch (e: any) {
  // A failed read and an empty result are different sentences, and this page must not print the
  // second when the first happened.
  console.error('[portal/payslips] employee lookup', e?.cause?.message || e?.message);
  lookupFailed = true;
}

const slips = employee ? await payslipsForEmployee(String(employee.id), 36) : [];
const balance = employee ? await getBalance(String(employee.id)) : null;

const money = (n: any, cur: string) =>
  (cur || 'INR') + ' ' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const statusColour: Record<string, string> = {
  paid: '#059669', approved: '#2563eb', pending: '#d97706',
};

// Year-to-date across whatever is on file. Stated as "on file" rather than "this year" because a
// payslip that was never generated is not a zero.
const thisYear = new Date().getFullYear();
const ytd = slips.filter((s) => s.year === thisYear);
const ytdGross = ytd.reduce((t, s) => t + s.gross, 0);
const ytdNet = ytd.reduce((t, s) => t + s.net, 0);
const ytdDeductions = ytd.reduce((t, s) => t + s.totalDeductions, 0);
const currency = String(employee?.currency || slips[0]?.currency || 'INR');
---
<!doctype html>
<html lang="en" style="background:#f6f4ef;">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <title>My payslips</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#f6f4ef;font-family:'Inter Tight',system-ui,sans-serif;min-height:100vh;padding-bottom:48px;color:#1a1510;overflow-x:hidden;}
    .top{background:#12100c;min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 14px;position:sticky;top:0;z-index:40;}
    .top a{color:#9a8f7d;text-decoration:none;display:flex;align-items:center;gap:6px;font-size:14px;min-height:44px;}
    .wrap{max-width:600px;margin:0 auto;padding:16px 14px;}
    .card{background:#fff;border:1px solid #ece4d6;border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#9a8f7d;font-weight:700;margin:0 0 12px;}
    .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;}
    .tile{background:#faf7f1;border:1px solid #f0e9dc;border-radius:10px;padding:10px 12px;}
    .tile .k{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#9a8f7d;font-weight:700;}
    .tile .v{font-size:15px;font-weight:700;margin-top:3px;overflow-wrap:anywhere;}
    .slip{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #f2ece0;}
    .slip:last-of-type{border-bottom:none;}
    .slip .period{font-size:15px;font-weight:700;}
    .slip .sub{font-size:11.5px;color:#8b8172;margin-top:2px;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;}
    .open{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;padding:0 14px;border-radius:10px;background:#12100c;color:#fff;text-decoration:none;font-size:13px;font-weight:600;white-space:nowrap;}
    .empty{text-align:center;padding:30px 12px;color:#6b6255;font-size:13.5px;line-height:1.6;}
    .note{background:#faf7f1;border:1px solid #f0e9dc;border-radius:10px;padding:11px 13px;font-size:12px;color:#6b6255;line-height:1.6;margin-top:12px;}
    .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.28);color:#92400e;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.6;margin-bottom:14px;}
    a.inline{color:#c2410c;}
  </style>
</head>
<body>
<nav class="top">
  <a href="/portal/employee">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>My HR</a>
  <span style="font-size:15px;font-weight:700;color:#fff;font-family:'Fraunces',serif;">Payslips</span>
  <span style="font-size:11px;color:#9a8f7d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:34vw;">{employee?.full_name || user.name}</span>
</nav>

<div class="wrap">
  {lookupFailed && (
    <div class="warn">
      We could not read your employee record just now, so this page cannot tell you whether you have
      payslips or not. Nothing is lost. Try again in a moment, and tell HR if it keeps happening.
    </div>
  )}

  {!lookupFailed && !employee && (
    <div class="card">
      <div class="empty">
        <p style="font-weight:700;color:#1a1510;font-size:15px;">No employee record is linked to this account</p>
        <p style="margin-top:8px;">Payslips are issued against an employee record, and this account is not
        linked to one. Ask HR to link it — nothing here is missing or delayed, it simply has nowhere to
        attach to yet.</p>
      </div>
    </div>
  )}

  {employee && (
    <div>
      <div class="card">
        <h3>{thisYear} so far, from the payslips on file</h3>
        <div class="tiles">
          <div class="tile"><div class="k">Gross</div><div class="v">{money(ytdGross, currency)}</div></div>
          <div class="tile"><div class="k">Deductions</div><div class="v" style="color:#b91c1c;">{money(ytdDeductions, currency)}</div></div>
          <div class="tile"><div class="k">Net</div><div class="v" style="color:#047857;">{money(ytdNet, currency)}</div></div>
        </div>
        {balance && (
          <div class="note">
            Net pay is credited to your wallet when a payroll run is marked paid. Your wallet holds
            <strong> {money(balance.balance, balance.currency)}</strong>, of which
            <strong> {money(balance.available, balance.currency)}</strong> is available to withdraw.
            <a class="inline" href="/portal/employee/wallet"> Open your wallet</a>.
          </div>
        )}
      </div>

      <div class="card">
        <h3>Every payslip issued to you</h3>

        {slips.length === 0 && (
          <div class="empty">
            <p style="font-weight:700;color:#1a1510;font-size:15px;">No payslip has been issued yet</p>
            <p style="margin-top:8px;">Payslips appear here the moment a payroll run that includes you is
            generated. If you have been paid and see nothing here, tell HR — the run may not have been
            generated for that month.</p>
          </div>
        )}

        {slips.map((s) => (
          <div class="slip">
            <div style="min-width:0;">
              <div class="period">{MONTH_NAMES[s.month - 1]} {s.year}</div>
              <div class="sub">
                Net {money(s.net, s.currency)} &middot; gross {money(s.gross, s.currency)}
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex:0 0 auto;">
              <span class="pill" style={`color:${statusColour[s.status] || '#6b6255'};background:${(statusColour[s.status] || '#6b6255')}18;`}>{s.status}</span>
              <a class="open" href={`/portal/payslip/${s.id}`}>Open</a>
            </div>
          </div>
        ))}

        <div class="note">
          Opening a payslip shows the full breakdown and a print button, so you can save it as a PDF.
          Every component on it, statutory deductions included, is calculated from rates this
          organisation has configured; the document is a record of what was paid and not advice on
          what any tax or contribution rule requires of you.
        </div>
      </div>

      <div class="card">
        <h3>Claims and reimbursements</h3>
        <p style="font-size:13.5px;line-height:1.65;color:#4a4238;">
          Money you have spent on the company's behalf, travel you have taken and advances you need are
          all raised separately from payroll.
        </p>
        <a class="open" style="margin-top:12px;background:#c2410c;" href="/portal/employee/expenses">Open expenses and claims</a>
      </div>
    </div>
  )}
</div>
</body>
</html>
