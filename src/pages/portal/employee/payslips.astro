---
// /portal/employee/payslips — an employee's own pay record.
//
// WHAT WAS MISSING. /portal/payslip/[id] has existed for a while and correctly serves ONE payslip to
// the person it belongs to — but nothing anywhere listed them, so the only way to reach your own
// payslip was to already know its id. This is the list. It links straight at that existing route; it
// does not re-render the document and it does not re-implement the ownership check.
//
// AUTHORISATION IS OWNERSHIP, NOT A ROLE. Every read on this page is narrowed by employee_id in the
// WHERE clause (payslipsForEmployee), resolved from the signed-in account. There is no id in the URL
// and no capability involved: an employee's own pay is theirs, and nobody else's is reachable from
// here at all.
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { payslipsForEmployeeResult, MONTH_NAMES } from '@/lib/payroll';
import { getBalance } from '@/lib/hr-wallet';
// The employee-facing bonus read. It existed in src/lib/payroll-bonuses.ts and was called by
// NOTHING: the admin side used the module and an employee had no screen anywhere in the product
// showing a bonus planned for them or paid to them.
import { bonusesForEmployee } from '@/lib/payroll-bonuses';

// The single employee-record resolver: the canonical gate plus the couple of extra columns this
// page renders. Never a hand-written SELECT against hr_employees — see the block below.
import { resolveEmployeeIdentity } from '@/lib/workforce/identity';
// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/employee/payslips');

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

// THE LOOKUP IS NOT WRITTEN HERE ANY MORE.
//
// It was two raw SELECTs against hr_employees — user_id first, then the three email columns — and
// src/lib/workforce/identity.ts records the three ways every hand-written copy of that block was
// wrong: a CASE-SENSITIVE email comparison where the canonical gate compares lower() to lower(), a
// `LIMIT 1` that PICKED a row where the gate REFUSES two records sharing one address, and two
// unindexed reads of hr_employees on every single page load. resolveEmployeeIdentity() is that gate
// plus the couple of extra columns this page renders.
//
// `lookupFailed` keeps its exact meaning — the read did not happen, so nothing on screen may claim
// anything about this person's pay. Every other denial now arrives with the gate's own sentence
// instead of one invented here, which matters most on THIS page: "no payslip has been issued yet"
// and "two employee records share your email address" are different facts about someone's money.
const identity = await resolveEmployeeIdentity(user, '/portal/employee/payslips');
const employee: { id: string; full_name: string; employee_code: string | null; designation: string | null; currency: string | null } | null =
  identity.ok
    ? {
        id: identity.identity.employeeId,
        full_name: identity.identity.fullName,
        employee_code: identity.identity.employeeCode,
        designation: identity.identity.designation,
        currency: identity.identity.currency,
      }
    : null;
const lookupFailed = !identity.ok && identity.failed;
const denial = identity.ok ? null : identity.denial;
if (denial?.redirect) return Astro.redirect(denial.redirect);

// A LIST OF PAY IS NOT A PLACE TO GUESS. payslipsForEmployee() catches its own failure and returns
// an empty array, and an empty array on THIS page prints "No payslip has been issued yet" - a
// statement about somebody's money, made by a read that may never have run. The discriminated form
// keeps the two apart: slipsFailed means we could not look, not that there is nothing.
const slipRes = employee ? await payslipsForEmployeeResult(String(employee.id), 36) : null;
const slips = slipRes && slipRes.ok ? slipRes.rows : [];
const slipsFailed = !!slipRes && !slipRes.ok;

// =================================================================================================
// THE MONTHS PAYROLL COULD NOT INCLUDE YOU IN
// =================================================================================================
//
// A payroll run now REFUSES to build a payslip out of a salary nobody recorded, rather than issuing
// one that reads zero and marking it paid. That refusal is on the HR console — and the person it is
// about is the one sitting here, watching a month go by with nothing appearing on this page and no
// way to tell "the run has not happened yet" from "the run happened and left me out".
//
// So the same fact is said here, in the second person. Only the month is taken from the notice; the
// sentence beside it is written for the person, not the administrator, and it points at the one
// action that is theirs to take — ask.
//
// A FAILED READ ADDS NOTHING AND CLAIMS NOTHING. It never prints "you were included in every run".
let missingMonths: string[] = [];
if (employee) {
  try {
    const missRes = await db.execute(sql`
      SELECT pr.month, pr.year
        FROM hr_payroll_run_notices n
        JOIN hr_payroll_runs pr ON pr.id = n.payroll_run_id
       WHERE n.employee_id = ${String(employee.id)}::uuid AND n.severity = 'skipped'
       ORDER BY pr.year DESC, pr.month DESC
       LIMIT 6`);
    missingMonths = rowsOf(missRes).map(
      (x: any) => (MONTH_NAMES[(Number(x.month) || 1) - 1] || '') + ' ' + (x.year ?? ''),
    );
  } catch (e: any) {
    console.error('[portal/payslips] skipped-run notices', e?.cause?.message || e?.message);
  }
}
const balance = employee ? await getBalance(String(employee.id)) : null;

// Bonuses awarded to this person. Discriminated, so "you have no bonuses" is never printed because
// a query failed — that sentence, said wrongly, is how somebody concludes they were not paid.
const bonusRes = employee ? await bonusesForEmployee(String(employee.id)) : null;
const bonuses = bonusRes && bonusRes.ok ? bonusRes.rows : [];
const bonusFailed = !!bonusRes && !bonusRes.ok;

const money = (n: any, cur: string) =>
  (cur || 'INR') + ' ' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const statusColour: Record<string, string> = {
  paid: '#059669', approved: '#2563eb', pending: '#d97706',
};

// Year-to-date across whatever is on file. Stated as "on file" rather than "this year" because a
// payslip that was never generated is not a zero.
const thisYear = new Date().getFullYear();
const ytd = slips.filter((s) => s.year === thisYear);
const ytdGross = ytd.reduce((t, s) => t + s.gross, 0);
const ytdNet = ytd.reduce((t, s) => t + s.net, 0);
const ytdDeductions = ytd.reduce((t, s) => t + s.totalDeductions, 0);
const currency = String(employee?.currency || slips[0]?.currency || 'INR');
// AND A TOTAL OF NOTHING IS NOT A TOTAL. The three figures below used to render unconditionally, so
// a person with no payslips at all - every intern in their first week, everybody on an unpaid
// engagement, everybody who joined before payroll was ever run - opened this page and read a
// zero-earnings statement in their own currency, above the sentence saying no payslip exists. Zero
// gross is a claim about a period that was never processed. The tiles now render only when there is
// at least one payslip inside them to count, and they say how many and over what months.
const monthNow = MONTH_NAMES[new Date().getMonth()] || '';
---
<EmployeeShell title="Payslips" documentTitle="My payslips" person={employee?.full_name || user.name} width={600} bottomPad={48} bare>

<div class="wrap">
  {lookupFailed && (
    <div class="warn">
      We could not read your employee record just now, so this page cannot tell you whether you have
      payslips or not. Nothing is lost. Try again in a moment, and tell HR if it keeps happening.
    </div>
  )}

  {!lookupFailed && !employee && (
    <div class="card">
      <div class="empty">
        {/* The gate's own sentence, and on a page about somebody's pay it matters most: "no record
            is linked" and "two employee records share your email address" are different facts, and
            only one of them is fixed by asking for a link. */}
        <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">{denial ? denial.title : 'No employee record is linked to this account'}</p>
        <p style="margin-top:8px;">{denial
          ? denial.reason
          : 'Payslips are issued against an employee record, and this account is not linked to one. Ask HR to link it — nothing here is missing or delayed, it simply has nowhere to attach to yet.'}</p>
      </div>
    </div>
  )}

  {employee && (
    <div>
      <div class="card">
        <h3>{thisYear} so far, from the payslips on file</h3>

        {slipsFailed && (
          <div class="empty" style="padding:18px 8px;">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">Your pay record could not be read</p>
            <p style="margin-top:8px;">No total is shown, because none could be worked out. This page is
            <strong> not</strong> saying you have earned nothing this year: it could not look. Try again
            shortly, and tell HR if it keeps happening.</p>
            <p style="margin-top:8px;font-size:11.5px;color:#8b8172;">Reason recorded: {slipRes && !slipRes.ok ? slipRes.reason : ''}</p>
          </div>
        )}

        {!slipsFailed && ytd.length === 0 && (
          <div class="empty" style="padding:18px 8px;">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">Nothing to total for {thisYear} yet</p>
            <p style="margin-top:8px;">No payslip has been issued to you for any month of {thisYear}, so
            there is no gross, no deduction and no net figure to add up. This is not an earnings total of
            zero. It is a period with no payroll on record. As soon as a run that includes you is
            generated, January to {monthNow} appears here as a running total.</p>
          </div>
        )}

        {!slipsFailed && ytd.length > 0 && (
          <div>
            <div class="tiles">
              <div class="tile"><div class="k">Gross</div><div class="v">{money(ytdGross, currency)}</div></div>
              <div class="tile"><div class="k">Deductions</div><div class="v" style="color:#b91c1c;">{money(ytdDeductions, currency)}</div></div>
              <div class="tile"><div class="k">Net</div><div class="v" style="color:#047857;">{money(ytdNet, currency)}</div></div>
            </div>
            <p style="font-size:11.5px;color:var(--emp-muted);line-height:1.6;margin-top:9px;">
              Added up from the {ytd.length} {ytd.length === 1 ? 'payslip' : 'payslips'} issued to you for
              {thisYear}, covering every month from January to {monthNow} that has one. A month with no
              payslip is not counted as zero. It is not counted at all.
            </p>
          </div>
        )}
        {balance && balance.balance === 0 && (
          <div class="note">
            Your wallet is empty, and that follows from the line above rather than being a separate
            problem: a wallet is credited only when a payroll run that includes you is marked paid, and
            no such run has happened. There is nothing waiting there to withdraw.
            <a class="inline" href="/portal/employee/wallet"> Open your wallet</a>.
          </div>
        )}

        {balance && balance.balance !== 0 && (
          <div class="note">
            Net pay is credited to your wallet when a payroll run is marked paid. Your wallet holds
            <strong> {money(balance.balance, balance.currency)}</strong>, of which
            <strong> {money(balance.available, balance.currency)}</strong> is available to withdraw.
            <a class="inline" href="/portal/employee/wallet"> Open your wallet</a>.
          </div>
        )}
      </div>

      <div class="card">
        <h3>Every payslip issued to you</h3>

        {missingMonths.length > 0 && (
          <div class="empty" style="border-color:#d9a441;background:#fdf6e7;">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">
              Payroll could not include you in {missingMonths.join(', ')}
            </p>
            <p style="margin-top:8px;">There is no payslip for {missingMonths.length === 1 ? 'that month' : 'those months'}
            and no pay was credited for {missingMonths.length === 1 ? 'it' : 'them'}. The run could not work out what you
            are paid — usually because your salary has not been recorded on your employee record yet. HR
            can see this on the run itself, with the reason. Ask them to complete it; you are not
            waiting for something that is on its way.</p>
          </div>
        )}

        {slipsFailed && (
          <div class="empty">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">This list could not be read</p>
            <p style="margin-top:8px;">You may well have payslips. This page could not fetch them, which is
            not the same thing as there being none, and it will not print the second when the first
            happened. Try again in a few minutes; if it keeps happening, tell HR.</p>
          </div>
        )}

        {!slipsFailed && slips.length === 0 && (
          <div class="empty">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">No payslip has been issued yet</p>
            <p style="margin-top:8px;">This list was read successfully and is genuinely empty. Payslips
            appear here the moment a payroll run that includes you is generated. Nobody has to send you
            anything and there is nothing here for you to do.</p>
            <p style="margin-top:8px;">If your engagement is unpaid, as many internships are, no payslip
            will ever be issued and this page stays empty for the whole of it. That is not a delay and
            nothing has gone missing. What you do is recorded elsewhere: your hours on your attendance
            sheet, and your weeks in your credits.</p>
            <p style="margin-top:8px;">If you are on a paid engagement, have been paid, and still see
            nothing here, tell HR: the run may not have been generated for that month.</p>
          </div>
        )}

        {slips.map((s) => (
          <div class="slip">
            <div style="min-width:0;">
              <div class="period">{MONTH_NAMES[s.month - 1]} {s.year}</div>
              <div class="sub">
                Net {money(s.net, s.currency)} &middot; gross {money(s.gross, s.currency)}
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex:0 0 auto;">
              <span class="pill" style={`color:${statusColour[s.status] || 'var(--emp-muted)'};background:${(statusColour[s.status] || 'var(--emp-muted)')}18;`}>{s.status}</span>
              <a class="open" href={`/portal/payslip/${s.id}`}>Open</a>
            </div>
          </div>
        ))}

        <div class="note">
          Opening a payslip shows the full breakdown and a print button, so you can save it as a PDF.
          Every component on it, statutory deductions included, is calculated from rates this
          organisation has configured; the document is a record of what was paid and not advice on
          what any tax or contribution rule requires of you.
        </div>
      </div>

      {/* BONUSES. hr_bonus_awards has been written by the admin console since it shipped, and no
          employee-facing surface read it back: the person the money was for had no way to see that a
          bonus existed, what state it was in, or whether it had been paid. */}
      <div class="card">
        <h3>Bonuses awarded to you</h3>

        {bonusFailed && (
          <div class="empty">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">Your bonus record could not be read</p>
            <p style="margin-top:8px;">This page is <strong>not</strong> telling you that you have no bonuses.
            It could not look. If you are expecting one, it may well be there — try again shortly, and tell
            HR if this keeps happening.</p>
            <p style="margin-top:8px;font-size:11.5px;color:#8b8172;">Reason recorded: {bonusRes && !bonusRes.ok ? bonusRes.reason : ''}</p>
          </div>
        )}

        {!bonusFailed && bonuses.length === 0 && (
          <div class="empty">
            <p style="font-weight:700;color:var(--emp-ink);font-size:15px;">No bonus has been awarded to you</p>
            <p style="margin-top:8px;">Nothing is pending and nothing is hidden — there is genuinely no bonus
            on your record.</p>
          </div>
        )}

        {bonuses.map((b) => (
          <div class="slip">
            <div style="min-width:0;">
              <div class="period">{b.title}</div>
              <div class="sub">
                {money(b.amount, b.currency)} &middot; {MONTH_NAMES[Math.max(0, Math.min(11, b.effectiveMonth - 1))]} {b.effectiveYear}
                {b.occurrences > 1 ? ' · paid ' + b.timesPaid + ' of ' + b.occurrences : ''}
              </div>
              {b.state === 'halted' && b.haltReason && (
                <div class="sub" style="color:#92400e;">On hold: {b.haltReason}</div>
              )}
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex:0 0 auto;">
              <span class="pill" style={`color:${statusColour[b.state] || 'var(--emp-muted)'};background:${(statusColour[b.state] || 'var(--emp-muted)')}18;`}>{b.state}</span>
            </div>
          </div>
        ))}

        {!bonusFailed && bonuses.length > 0 && (
          <div class="note">
            A bonus marked <strong>paid</strong> has been released against the payouts recorded for it;
            <strong> pending</strong> means it is awarded and not yet paid. The totals here are counted from
            the payout ledger, not from a stored counter, so they cannot drift away from what was actually
            paid out.
          </div>
        )}
      </div>

      <div class="card">
        <h3>Claims and reimbursements</h3>
        <p style="font-size:13.5px;line-height:1.65;color:#4a4238;">
          Money you have spent on the company's behalf, travel you have taken and advances you need are
          all raised separately from payroll.
        </p>
        <a class="open" style="margin-top:12px;background:var(--emp-accent);" href="/portal/employee/expenses">Open expenses and claims</a>
        {/* SIDEWAYS, NOT VIA HOME. A repayment line on a payslip is the single most common reason
            somebody opens this page and then needs the loan behind it, and until now the only route
            from here to there was back out to My HR and in again. /portal/employee/loans applies the
            same gate this page does — a session, then its own hr_employees lookup — so anybody who
            can read this can open that. */}
        <div class="note" style="margin-top:12px;">
          A deduction you do not recognise may be a repayment.
          <a class="inline" href="/portal/employee/loans"> Loans and advances</a>
          <span> &middot; </span>
          <a class="inline" href="/portal/employee/wallet">Your wallet</a>
        </div>
      </div>
    </div>
  )}
</div>
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-dim);font-weight:700;margin:0 0 12px;}
    .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;}
    .tile{background:var(--emp-surface-2);border:1px solid #f0e9dc;border-radius:10px;padding:10px 12px;}
    .tile .k{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-dim);font-weight:700;}
    .tile .v{font-size:15px;font-weight:700;margin-top:3px;overflow-wrap:anywhere;}
    .slip{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #f2ece0;}
    .slip:last-of-type{border-bottom:none;}
    .slip .period{font-size:15px;font-weight:700;}
    .slip .sub{font-size:11.5px;color:#8b8172;margin-top:2px;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;}
    .open{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;padding:0 14px;border-radius:10px;background:var(--emp-bar);color:#fff;text-decoration:none;font-size:13px;font-weight:600;white-space:nowrap;}
    .empty{text-align:center;padding:30px 12px;color:var(--emp-muted);font-size:13.5px;line-height:1.6;}
    .note{background:var(--emp-surface-2);border:1px solid #f0e9dc;border-radius:10px;padding:11px 13px;font-size:12px;color:var(--emp-muted);line-height:1.6;margin-top:12px;}
    .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.28);color:#92400e;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.6;margin-bottom:14px;}
    a.inline{color:var(--emp-accent);}
</style>
