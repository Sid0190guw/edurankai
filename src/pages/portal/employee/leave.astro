---
// /portal/employee/leave — ASK FOR TIME OFF, AND SEE WHAT IS LEFT.
//
// =================================================================================================
// WHAT CHANGED HERE, AND WHY THE FORM LOOKS LIKE THAT
// =================================================================================================
//
// This screen used to offer four leave types and whole days only. A person who needed two hours for
// a hospital appointment had to file a whole day, and somebody working from home for a week had
// nowhere to say so - so they said it in a chat message, and the attendance record showed them
// absent for five days they worked.
//
// So the form now carries a UNIT: a whole span of days, half a day, or a number of hours. The unit
// changes which fields matter, and a small inline script hides the ones that do not - but EVERY
// FIELD WORKS WITHOUT THAT SCRIPT, and the server re-validates every combination in applyLeave().
// A hidden field is a convenience; the refusal is the rule.
//
// WORK FROM HOME IS A TYPE IN THIS LIST AND IS NOT LEAVE. It costs no allowance and it reaches
// attendance as 'wfh', never as absence. It is here because this is the form people already open
// when they want to tell somebody where they will be.
//
// HOLIDAYS COME OUT BEFORE THE BALANCE DOES. applyLeave() charges only the days that are not
// already holidays, and this page says which ones those were, by name, after the request is filed -
// so "9 days, 8 charged" is a sentence somebody can check rather than a number they have to trust.
//
// =================================================================================================
// const BEFORE THE HANDLER. MOBILE FIRST.
// =================================================================================================
//
// Every const the POST handler reads is declared above it - `const` is not hoisted and that has
// taken pages down on this project. 360px is the design width, every control clears 44px, and the
// page never scrolls sideways.
import { requireEmployee } from '@/lib/auth/workspace-access';
import {
  getBalances,
  applyLeave,
  listLeave,
  cancelLeave,
  compOffBalance,
  listCompOff,
  describeUnits,
  leaveTypeName,
  LEAVE_TYPES,
  DAY_PARTS,
} from '@/lib/hr-leave';
import { upcomingHolidays } from '@/lib/holidays';
import { today as attendanceToday } from '@/lib/attendance';

const PATH = '/portal/employee/leave';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);
const workspace = gate.ok ? gate.workspace : null;
const employeeId = workspace ? workspace.employeeId : '';

const fmt = (d: any) => {
  const dt = new Date(String(d).slice(0, 10) + 'T00:00:00Z');
  if (isNaN(dt.getTime())) return String(d || '');
  return dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};

// Darkened: #059669 and #d97706 were 3.8:1 and 3.2:1 on the pale pill, under the 4.5:1
// floor, on 10px uppercase text that is the whole answer to "was it approved".
function statusColour(status: string): string {
  if (status === 'approved') return '#046c4e';
  if (status === 'rejected') return '#b91c1c';
  if (status === 'pending') return '#b45309';
  return '#6b6255';
}

function unitWords(row: any): string {
  return describeUnits(
    String(row?.unit || 'full'),
    Number(row?.day_units ?? row?.days) || 0,
    row?.hours === null || row?.hours === undefined ? null : Number(row.hours),
  );
}

// ------------------------------------------------------------------------------------------------
// THE WRITE
// ------------------------------------------------------------------------------------------------
if (Astro.request.method === 'POST' && employeeId) {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';

  if (action === 'apply') {
    const unit = String(fd.get('unit') || 'full');
    const start = String(fd.get('start_date') || '');
    // A part day is one day: the end date follows the start rather than asking somebody to type it
    // twice, and applyLeave() refuses the combination anyway if they disagree.
    const end = unit === 'full' ? String(fd.get('end_date') || '') : start;
    const res = await applyLeave(
      employeeId,
      String(fd.get('leave_type') || ''),
      start,
      end,
      String(fd.get('reason') || ''),
      {
        unit: unit as any,
        dayPart: String(fd.get('day_part') || 'first_half') as any,
        hours: Number(fd.get('hours') || 0),
      },
    );
    if (res.ok) {
      const skipped = (res.excluded || []).filter((x) => x && x.reason);
      flash = 'Requested: ' + describeUnits(unit, Number(res.dayUnits) || 0, Number(fd.get('hours')) || null)
        + '. Waiting for approval.'
        + (skipped.length ? ' ' + skipped.length + ' day(s) were not charged (' + [...new Set(skipped.map((x) => x.reason))].join(', ') + ').' : '');
    } else {
      flash = res.error || 'Could not file that request.';
    }
  } else if (action === 'cancel') {
    await cancelLeave(String(fd.get('id') || ''), employeeId);
    flash = 'Request cancelled. Any comp off it used has been returned.';
  } else {
    flash = 'That is not something this page does.';
  }

  return Astro.redirect(PATH + '?msg=' + encodeURIComponent(flash));
}

// ------------------------------------------------------------------------------------------------
// READS
// ------------------------------------------------------------------------------------------------
const now = (await attendanceToday()) || '';
const year = now ? Number(now.slice(0, 4)) : new Date().getFullYear();

const balances = employeeId ? await getBalances(employeeId, year) : [];
const history = employeeId ? await listLeave({ employeeId }) : [];
const compOff = employeeId ? await compOffBalance(employeeId) : null;
const compOffCredits = employeeId ? await listCompOff(employeeId, 12) : [];
const holidays = employeeId && now
  ? await upcomingHolidays(now, { departmentId: workspace?.department?.id || null }, 90)
  : [];

const countedBalances = balances.filter((b) => b.source === 'allowance' && b.allowance > 0);
const ledgerBalance = balances.find((b) => b.source === 'ledger') || null;
const halfDayTypes = LEAVE_TYPES.filter((t) => t.halfDay).map((t) => t.id).join(',');
const hourlyTypes = LEAVE_TYPES.filter((t) => t.hourly).map((t) => t.id).join(',');
const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
---
<!doctype html>
<html lang="en" style="background:#f6f4ef;">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>My leave</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    html,body{overflow-x:hidden;}
    body{background:#f6f4ef;font-family:'Inter Tight',system-ui,sans-serif;min-height:100vh;padding-bottom:40px;color:#1a1510;}
    .top{background:#12100c;min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 16px;position:sticky;top:0;z-index:40;}
    .wrap{max-width:560px;margin:0 auto;padding:16px 14px;}
    .tabs{display:flex;gap:6px;overflow-x:auto;padding:0 0 12px;}
    .tabs a{flex:none;min-height:38px;display:inline-flex;align-items:center;padding:8px 12px;border:1px solid #e6ddcd;border-radius:99px;background:#fff;color:#6b6255;font-size:12.5px;font-weight:600;text-decoration:none;white-space:nowrap;}
    .card{background:#fff;border:1px solid #ece4d6;border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    /* #9a8f7d was 3.2:1 on white — under the 4.5:1 floor, and it named every field. */
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#6b6255;font-weight:700;margin:0 0 12px;}
    label,legend{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#6b6255;font-weight:700;display:block;margin:8px 0 4px;padding:0;}
    input,select,textarea{width:100%;min-height:44px;background:#faf7f1;border:1px solid #e6ddcd;border-radius:9px;padding:10px 12px;font-size:16px;font-family:inherit;color:#1a1510;}
    textarea{min-height:60px;}
    input:focus,select:focus,textarea:focus{border-color:#c2410c;}
    /* `outline:none` was set with nothing put in its place. */
    input:focus-visible,select:focus-visible,textarea:focus-visible,.btn:focus-visible,.kill:focus-visible,a:focus-visible{outline:3px solid #7c2d12;outline-offset:2px;}
    .btn{background:#c2410c;color:#fff;border:none;border-radius:10px;min-height:46px;padding:11px 18px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;width:100%;}
    .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .balgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .bal{background:#faf7f1;border:1px solid #f0e9db;border-radius:12px;padding:12px 14px;min-width:0;}
    .bal b{font-family:'Fraunces',serif;font-size:26px;font-weight:600;color:#1a1510;display:block;}
    .bal span{font-size:11.5px;color:#6b6255;overflow-wrap:anywhere;}
    .ledger{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f2ece0;}
    .ledger:last-child{border-bottom:none;}
    .ledger .who{flex:1 1 auto;min-width:0;overflow-wrap:anywhere;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:3px 9px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;}
    .note{font-size:11.5px;color:#6b6255;margin-top:8px;line-height:1.55;overflow-wrap:anywhere;}
    .flash{background:rgba(5,150,105,.1);border:1px solid rgba(5,150,105,.3);color:#065f46;border-radius:10px;padding:11px 14px;font-size:13px;margin-bottom:14px;line-height:1.55;overflow-wrap:anywhere;}
    .warn{background:#fdf6ec;border:1px solid #f0dcc0;color:#6d470d;border-radius:10px;padding:11px 14px;font-size:12.5px;margin-bottom:14px;line-height:1.55;}
    .kill{background:none;border:none;color:#dc2626;cursor:pointer;font-size:12px;font-weight:700;min-height:44px;padding:0 6px;}
    fieldset{border:none;}
    .units{display:flex;gap:6px;flex-wrap:wrap;}
    .units legend{flex:1 1 100%;float:left;width:100%;}
    .units label{flex:1 1 30%;min-width:96px;display:flex;align-items:center;gap:6px;margin:0;padding:10px;border:1px solid #e6ddcd;border-radius:9px;background:#faf7f1;text-transform:none;letter-spacing:0;font-size:13px;color:#1a1510;font-family:inherit;font-weight:600;min-height:44px;}
    .units input{width:auto;min-height:0;}
  </style>
</head>
<body>
<nav class="top">
  <a href="/portal/employee" style="color:#9a8f7d;text-decoration:none;display:flex;align-items:center;gap:8px;font-size:14px;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>My HR</a>
  <span style="font-size:15px;font-weight:700;color:#fff;font-family:'Fraunces',serif;">Leave</span>
  <span style="font-size:11px;color:#9a8f7d;">{workspace ? workspace.fullName : ''}</span>
</nav>

<div class="wrap">
  <nav class="tabs" aria-label="Time">
    <a href={PATH} aria-current="page">Leave</a>
    <a href="/portal/employee/attendance">Attendance</a>
    <a href="/portal/employee/timesheet">Timesheet</a>
    <a href="/portal/employee/attendance/overtime">Overtime</a>
  </nav>

  {msg && <div class="flash">{msg}</div>}

  {!gate.ok && (
    <div class="card">
      <h3>{gate.title || 'This screen is not available'}</h3>
      <p style="font-size:13px;line-height:1.6;color:#6b6255;">{gate.reason || 'Your employee record is what this screen is built from.'}</p>
    </div>
  )}

  {gate.ok && (
    <div>
      <div class="card">
        <h3>Leave balance · {year}</h3>
        <div class="balgrid">
          {countedBalances.map((b) => (
            <div class="bal">
              <b>{b.remaining}</b>
              <span>{b.name} left · {b.used} used{b.pending ? ', ' + b.pending + ' pending' : ''}</span>
            </div>
          ))}
          {ledgerBalance && (
            <div class="bal">
              <b>{compOff ? compOff.available : 0}</b>
              <span>Comp off available{compOff && compOff.nextExpiry ? ' · next expires ' + fmt(compOff.nextExpiry) : ''}</span>
            </div>
          )}
        </div>
        {compOff && compOff.expiringSoon > 0 && (
          <p class="note">{compOff.expiringSoon} day(s) of comp off expire within a month. Comp off is earned from approved overtime and it does not carry on forever.</p>
        )}
        {compOff && compOff.expired > 0 && (
          <p class="note">{compOff.expired} day(s) of comp off have expired unused. They are kept on the record rather than deleted.</p>
        )}
      </div>

      <div class="card">
        <h3>Ask for time off</h3>
        <form method="POST" action={PATH}>
          <input type="hidden" name="action" value="apply"/>

          <label for="leave_type">Type</label>
          <select id="leave_type" name="leave_type" required>
            {LEAVE_TYPES.map((t) => (
              <option value={t.id} data-half={t.halfDay ? '1' : '0'} data-hourly={t.hourly ? '1' : '0'}>
                {t.name}{t.allowance ? ' · ' + t.allowance + ' a year' : (t.source === 'ledger' ? ' · from your comp-off balance' : ' · no allowance used')}
              </option>
            ))}
          </select>

          {/* Was a bare <label> pointing at nothing, sitting outside the fieldset. A
              <legend> is what names a group of radios, and it is what a screen reader
              repeats before each option. */}
          <fieldset class="units">
            <legend>How much</legend>
            <label for="u_full"><input id="u_full" type="radio" name="unit" value="full" checked/> Whole days</label>
            <label for="u_half"><input id="u_half" type="radio" name="unit" value="half"/> Half a day</label>
            <label for="u_hours"><input id="u_hours" type="radio" name="unit" value="hours"/> A few hours</label>
          </fieldset>

          <div class="row2">
            <div>
              <label for="start_date">From</label>
              <input id="start_date" name="start_date" type="date" required/>
            </div>
            <div id="endwrap">
              <label for="end_date">To</label>
              <input id="end_date" name="end_date" type="date"/>
            </div>
          </div>

          <div id="halfwrap">
            <label for="day_part">Which half</label>
            <select id="day_part" name="day_part">
              {DAY_PARTS.map((p) => (<option value={p}>{p === 'first_half' ? 'First half of the day' : 'Second half of the day'}</option>))}
            </select>
          </div>

          <div id="hourwrap">
            <label for="hours">How many hours</label>
            <input id="hours" name="hours" type="number" min="0.5" max="12" step="0.5" placeholder="2"/>
          </div>

          <label for="reason">Reason</label>
          <textarea id="reason" name="reason" rows="2" placeholder="A line for whoever approves it"></textarea>

          <button class="btn" style="margin-top:12px;" type="submit">Send for approval</button>
          <p class="note">
            Decided by your reporting manager or by HR. Public holidays inside the dates are taken out
            before anything is charged, so a week across a holiday costs you a day less. Work from home
            costs no leave at all and is recorded as working, not as absence.
          </p>
        </form>
      </div>

      <div class="card">
        <h3>Your requests</h3>
        {history.length === 0 && <p style="font-size:13px;color:#6b6255;">Nothing requested yet.</p>}
        {history.map((l: any) => (
          <div class="ledger">
            <div class="who">
              <div style="font-weight:600;">{leaveTypeName(l.leave_type)} · {unitWords(l)}</div>
              <div style="font-size:11px;color:#6b6255;">
                {fmt(l.start_date)}{String(l.start_date).slice(0, 10) === String(l.end_date).slice(0, 10) ? '' : ' to ' + fmt(l.end_date)}
                {l.day_part ? ' · ' + (l.day_part === 'first_half' ? 'first half' : 'second half') : ''}
                {l.reason ? ' · ' + l.reason : ''}
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex:0 0 auto;">
              <span class="pill" style={'color:' + statusColour(String(l.status)) + ';background:' + statusColour(String(l.status)) + '18;'}>{l.status}</span>
              {l.status === 'pending' && (
                <form method="POST" action={PATH} style="margin:0;">
                  <input type="hidden" name="action" value="cancel"/>
                  <input type="hidden" name="id" value={l.id}/>
                  <button class="kill" type="submit" aria-label="Cancel this request">Cancel</button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>

      {compOffCredits.length > 0 && (
        <div class="card">
          <h3>Comp off you have earned</h3>
          {compOffCredits.map((c) => (
            <div class="ledger">
              <div class="who">
                <div style="font-weight:600;">{c.remaining} of {c.units} day(s) left</div>
                <div style="font-size:11px;color:#6b6255;">
                  Earned {fmt(c.earnedOn)} from {c.source === 'holiday_work' ? 'a worked holiday' : 'approved overtime'} · expires {fmt(c.expiresOn)}
                </div>
              </div>
              <span class="pill" style={c.expired ? 'color:#6b6255;background:#6b625518;' : 'color:#059669;background:#05966918;'}>{c.expired ? 'expired' : 'live'}</span>
            </div>
          ))}
          <p class="note">Comp off is only ever credited when an overtime claim or a worked holiday is approved. It is never added automatically from hours.</p>
        </div>
      )}

      <div class="card">
        <h3>Holidays coming up</h3>
        {holidays.length === 0 && (
          <p style="font-size:13px;color:#6b6255;line-height:1.6;">
            No holidays are recorded for the next three months. Until HR records them, every day in a
            leave request is charged as an ordinary day.
          </p>
        )}
        {holidays.map((h) => (
          <div class="ledger">
            <div class="who">
              <div style="font-weight:600;">{h.name}</div>
              <div style="font-size:11px;color:#6b6255;">
                {fmt(h.dateIso)}
                {h.location ? ' · at ' + h.location : ''}
                {h.departmentName ? ' · ' + h.departmentName : ''}
                {h.isOptional ? ' · optional' : ''}
              </div>
            </div>
          </div>
        ))}
        {holidays.some((h) => !!h.location) && (
          <p class="note">
            A holiday marked with a place applies there. This product does not record which office you
            sit in, so a holiday with a place on it is shown to you but is not taken off your leave
            automatically. Ask HR if it should apply to you.
          </p>
        )}
      </div>
    </div>
  )}
</div>

<script is:inline data-half-types={halfDayTypes} data-hourly-types={hourlyTypes}>
  // Shows only the fields the chosen unit needs. THE PAGE IS FULLY USABLE WITHOUT THIS: every field
  // is visible and valid by default, and the server re-checks every combination. Nothing here
  // decides anything - applyLeave() refuses an hourly maternity request whether or not this ran.
  (function () {
    var script = document.currentScript;
    var half = String(script.getAttribute('data-half-types') || '').split(',');
    var hourly = String(script.getAttribute('data-hourly-types') || '').split(',');
    var type = document.getElementById('leave_type');
    var endwrap = document.getElementById('endwrap');
    var halfwrap = document.getElementById('halfwrap');
    var hourwrap = document.getElementById('hourwrap');
    var radios = document.querySelectorAll('input[name="unit"]');
    if (!type || !endwrap || !halfwrap || !hourwrap) return;

    function unit() {
      for (var i = 0; i < radios.length; i++) if (radios[i].checked) return radios[i].value;
      return 'full';
    }
    function sync() {
      var u = unit();
      var t = type.value;
      endwrap.style.display = u === 'full' ? '' : 'none';
      halfwrap.style.display = u === 'half' ? '' : 'none';
      hourwrap.style.display = u === 'hours' ? '' : 'none';
      for (var i = 0; i < radios.length; i++) {
        var v = radios[i].value;
        var allowed = v === 'full'
          || (v === 'half' && half.indexOf(t) >= 0)
          || (v === 'hours' && hourly.indexOf(t) >= 0);
        radios[i].disabled = !allowed;
        if (!allowed && radios[i].checked) { radios[0].checked = true; }
      }
    }
    type.addEventListener('change', sync);
    for (var i = 0; i < radios.length; i++) radios[i].addEventListener('change', sync);
    sync();
  })();
</script>
</body>
</html>
