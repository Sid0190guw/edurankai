---
// /portal/employee/leave — ASK FOR TIME OFF, AND SEE WHAT IS LEFT.
//
// =================================================================================================
// WHAT CHANGED HERE, AND WHY THE FORM LOOKS LIKE THAT
// =================================================================================================
//
// This screen used to offer four leave types and whole days only. A person who needed two hours for
// a hospital appointment had to file a whole day, and somebody working from home for a week had
// nowhere to say so - so they said it in a chat message, and the attendance record showed them
// absent for five days they worked.
//
// So the form now carries a UNIT: a whole span of days, half a day, or a number of hours. The unit
// changes which fields matter, and a small inline script hides the ones that do not - but EVERY
// FIELD WORKS WITHOUT THAT SCRIPT, and the server re-validates every combination in applyLeave().
// A hidden field is a convenience; the refusal is the rule.
//
// WORK FROM HOME IS A TYPE IN THIS LIST AND IS NOT LEAVE. It costs no allowance and it reaches
// attendance as 'wfh', never as absence. It is here because this is the form people already open
// when they want to tell somebody where they will be.
//
// HOLIDAYS COME OUT BEFORE THE BALANCE DOES. applyLeave() charges only the days that are not
// already holidays, and this page says which ones those were, by name, after the request is filed -
// so "9 days, 8 charged" is a sentence somebody can check rather than a number they have to trust.
//
// =================================================================================================
// const BEFORE THE HANDLER. MOBILE FIRST.
// =================================================================================================
//
// Every const the POST handler reads is declared above it - `const` is not hoisted and that has
// taken pages down on this project. 360px is the design width, every control clears 44px, and the
// page never scrolls sideways.
import { requireEmployee } from '@/lib/auth/workspace-access';
import {
  getBalances,
  applyLeave,
  listLeave,
  cancelLeave,
  compOffBalance,
  listCompOff,
  describeUnits,
  leaveTypeName,
  LEAVE_TYPES,
  DAY_PARTS,
} from '@/lib/hr-leave';
import { upcomingHolidays } from '@/lib/holidays';
import { today as attendanceToday, applyApprovedOvertimeClaims } from '@/lib/attendance';

// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
const PATH = '/portal/employee/leave';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);
const workspace = gate.ok ? gate.workspace : null;
const employeeId = workspace ? workspace.employeeId : '';

// =================================================================================================
// AN APPROVED OVERTIME CLAIM HAS TO REACH THE BALANCE THIS PAGE SPENDS
// =================================================================================================
//
// THE BREAK THIS CLOSES. Comp off is not earned by working late — it is earned when an overtime or
// worked-holiday claim is APPROVED through the engine, and the credit is written by a SECOND step,
// applyApprovedOvertimeClaims(), which re-reads the workflow instance and refuses anything that is
// not 'approved'. That step ran on exactly two screens: /portal/employee/attendance/overtime and
// .../attendance/approvals. It did NOT run here — on the one page whose comp-off balance depends
// entirely on it, and which is where somebody actually spends the day.
//
// So: the manager approves the overtime on Monday. On Tuesday the person opens this page, reads
// "Comp off available: 0", asks for a comp-off day and is refused with "There is only 0 day(s) of
// comp off left". The credit was sitting unapplied behind a page they had no reason to open, and
// nothing on this screen hinted at it. An approval that reaches nothing is the same fault as an
// approval nobody was ever asked for.
//
// IT RUNS BEFORE THE POST HANDLER, NOT ONLY BEFORE THE READS. Sweeping on render alone would correct
// the number on the screen and still refuse the request: applyLeave() calls consumeCompOff(), which
// asks the ledger at the moment of filing. The credit has to land before the spend, or the person
// reads an accurate balance and is told they do not have it anyway.
//
// THIS PAGE DECIDES NOTHING. applyApprovedOvertimeClaims() re-reads each claim's workflow instance
// and credits only what the engine has genuinely approved, so this is a reconciliation and not a
// second approval path — the same reasoning the two attendance screens already carry.
//
// FAILURE IS TOLERATED, AND IT IS NOT SILENT: the function logs the real cause and returns 0 rather
// than throwing, because a ledger that cannot be swept must not take the leave screen down. The
// balance below is then the balance as it stands, which is exactly what this page showed before.
if (employeeId) await applyApprovedOvertimeClaims(employeeId, 20);

const fmt = (d: any) => {
  const dt = new Date(String(d).slice(0, 10) + 'T00:00:00Z');
  if (isNaN(dt.getTime())) return String(d || '');
  return dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};

/**
 * The sentence the Cancel button asks before it withdraws a request, BUILT HERE rather than inside
 * the JSX attribute.
 *
 * Two reasons, and the second is a hard constraint of this file type. It is easier to read a
 * sentence assembled on its own lines than one assembled inside an attribute value. And a regex
 * literal next to a ternary inside an `.astro` attribute expression does not survive the template
 * parser — it desynchronises brace matching and the compiler starts reporting missing closing tags
 * hundreds of lines further down, which is the least helpful error this toolchain produces. This is
 * the same family as the "no Record<string,string> typed maps inside JSX" rule in CLAUDE.md.
 *
 * `scrub` strips anything that could close the JavaScript string or the HTML attribute around it.
 * Leave reasons are typed by people and go through here untrusted.
 *
 * NAMES WHAT IS LOST: the type of leave and the dates. The list repeats, each row carries the same
 * Cancel control 8px from a status pill, and on a phone the row above and the row below are within
 * a thumb of it. Cancelling is not a pause — the request leaves the approver's queue and has to be
 * raised again from the start, which restarts the approval clock.
 */
function cancelLeaveConfirm(l: any): string {
  const scrub = (s: any) => String(s === null || s === undefined ? '' : s).replace(/[^\w \-.,]/g, '');
  const oneDay = String(l.start_date).slice(0, 10) === String(l.end_date).slice(0, 10);
  const span = oneDay ? scrub(fmt(l.start_date)) : scrub(fmt(l.start_date)) + ' to ' + scrub(fmt(l.end_date));
  return 'return confirm("Cancel your ' + scrub(leaveTypeName(l.leave_type)) + ' request for ' + span +
    '?\\n\\nIt is withdrawn from your approver and has to be raised again from the start.")';
}

// Darkened: #059669 and #d97706 were 3.8:1 and 3.2:1 on the pale pill, under the 4.5:1
// floor, on 10px uppercase text that is the whole answer to "was it approved".
function statusColour(status: string): string {
  if (status === 'approved') return '#046c4e';
  if (status === 'rejected') return '#b91c1c';
  if (status === 'pending') return '#b45309';
  return 'var(--emp-muted)';
}

function unitWords(row: any): string {
  return describeUnits(
    String(row?.unit || 'full'),
    Number(row?.day_units ?? row?.days) || 0,
    row?.hours === null || row?.hours === undefined ? null : Number(row.hours),
  );
}

// ------------------------------------------------------------------------------------------------
// THE WRITE
// ------------------------------------------------------------------------------------------------
if (Astro.request.method === 'POST' && employeeId) {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';

  if (action === 'apply') {
    const unit = String(fd.get('unit') || 'full');
    const start = String(fd.get('start_date') || '');
    // A part day is one day: the end date follows the start rather than asking somebody to type it
    // twice, and applyLeave() refuses the combination anyway if they disagree.
    const end = unit === 'full' ? String(fd.get('end_date') || '') : start;
    const res = await applyLeave(
      employeeId,
      String(fd.get('leave_type') || ''),
      start,
      end,
      String(fd.get('reason') || ''),
      {
        unit: unit as any,
        dayPart: String(fd.get('day_part') || 'first_half') as any,
        hours: Number(fd.get('hours') || 0),
        // WHO FILED IT. Carried into the approval instance so the engine can tell this person when it
        // settles — workflow.notifyRequester() returns on its first line without it.
        requestedByUserId: String(user.id || ''),
      },
    );
    if (res.ok) {
      const skipped = (res.excluded || []).filter((x) => x && x.reason);
      flash = 'Requested: ' + describeUnits(unit, Number(res.dayUnits) || 0, Number(fd.get('hours')) || null)
        + '.'
        + (skipped.length ? ' ' + skipped.length + ' day(s) were not charged (' + [...new Set(skipped.map((x) => x.reason))].join(', ') + ').' : '');
      // "WAITING FOR APPROVAL" IS ONLY TRUE IF SOMEBODY WAS ASKED.
      //
      // This screen said it unconditionally, and until now nothing on the employee path ever started
      // an approval: the row was written 'pending' with no approver, nobody was notified, and it sat
      // there until an HR account happened to open a list. Now the request enters the engine, and
      // when the Organization Graph cannot name an approver the engine HALTS with a readable sentence
      // instead of vanishing — so this says which of the two happened, in the person's own words.
      if (res.routing && res.routing.halted) {
        flash += ' It is NOT yet with an approver: ' + (res.routing.haltReason || 'no approver could be resolved.')
          + ' Your request is recorded and is visible to HR, who can route it once that is fixed.';
      } else {
        flash += ' Sent to your approver.';
      }
    } else {
      flash = res.error || 'Could not file that request.';
    }
  } else if (action === 'cancel') {
    // ITS ANSWER IS READ. cancelLeave() used to return void and swallow everything while this line
    // printed success whatever happened — so somebody whose cancellation matched no rows believed
    // they were working that day, while the approver still saw a live request.
    const cancelled = await cancelLeave(String(fd.get('id') || ''), employeeId);
    flash = cancelled.ok
      ? 'Request cancelled. Any comp off it used has been returned, and it has been withdrawn from your approver.'
      : (cancelled.error || 'That request could not be cancelled. Nothing was changed.');
  } else {
    flash = 'That is not something this page does.';
  }

  return Astro.redirect(PATH + '?msg=' + encodeURIComponent(flash));
}

// ------------------------------------------------------------------------------------------------
// READS
// ------------------------------------------------------------------------------------------------
const now = (await attendanceToday()) || '';
const year = now ? Number(now.slice(0, 4)) : new Date().getFullYear();

const balances = employeeId ? await getBalances(employeeId, year) : [];
const history = employeeId ? await listLeave({ employeeId }) : [];
const compOff = employeeId ? await compOffBalance(employeeId) : null;
const compOffCredits = employeeId ? await listCompOff(employeeId, 12) : [];
const holidays = employeeId && now
  ? await upcomingHolidays(now, { departmentId: workspace?.department?.id || null }, 90)
  : [];

const countedBalances = balances.filter((b) => b.source === 'allowance' && b.allowance > 0);
// =================================================================================================
// A FULL YEAR'S ALLOWANCE, SHOWN TO SOMEBODY WHO JOINED ON TUESDAY
// =================================================================================================
//
// getBalances() subtracts what has been used from the flat annual figure in LEAVE_TYPES. It does
// not prorate by joining date, and nothing here proposes that it should - what leave somebody has
// actually accrued is a policy this screen does not get to decide. What this screen does get to
// decide is whether it presents "15 Earned left" to a person in their first week as though it were
// money in their hand. It said nothing at all, so it did.
//
// So: the figures are labelled as the year's allowance, the joining date is named when it falls
// inside this leave year, and the person is pointed at the one place that can answer what they have
// actually accrued and whether an internship carries these allowances at all.
const joinedIso = workspace && workspace.joiningDate ? String(workspace.joiningDate).slice(0, 10) : '';
const joinedThisYear = !!joinedIso && Number(joinedIso.slice(0, 4)) === year;
const joinedLabel = joinedIso ? fmt(joinedIso) : '';
const ledgerBalance = balances.find((b) => b.source === 'ledger') || null;
const halfDayTypes = LEAVE_TYPES.filter((t) => t.halfDay).map((t) => t.id).join(',');
const hourlyTypes = LEAVE_TYPES.filter((t) => t.hourly).map((t) => t.id).join(',');
const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
---
<EmployeeShell title="Leave" documentTitle="My leave" person={workspace ? workspace.fullName : ''} width={560} bottomPad={40} bare>

<div class="wrap">
  {/* class="tab" on every anchor, because the tab control is EmployeeShell's now. This page styled
      bare `<a>` children through a `.tabs a` selector of its own — one of five different
      implementations of the same pill in this portal, with heights of 36, 38 and 44px and three
      different selected colours between them. */}
  <nav class="tabs" aria-label="Time">
    <a class="tab" href={PATH} aria-current="page">Leave</a>
    <a class="tab" href="/portal/employee/attendance">Attendance</a>
    <a class="tab" href="/portal/employee/timesheet">Timesheet</a>
    <a class="tab" href="/portal/employee/attendance/overtime">Overtime</a>
  </nav>

  {msg && <div class="flash">{msg}</div>}

  {!gate.ok && (
    <div class="card">
      <h3>{gate.title || 'This screen is not available'}</h3>
      <p style="font-size:13px;line-height:1.6;color:var(--emp-muted);">{gate.reason || 'Your employee record is what this screen is built from.'}</p>
    </div>
  )}

  {gate.ok && (
    <div>
      <div class="card">
        <h3>Leave balance · {year}</h3>
        <p style="font-size:12.5px;color:var(--emp-muted);line-height:1.6;margin:-4px 0 12px;">
          Each figure is the whole of the {year} allowance for that type, less what you have already
          taken and anything still awaiting a decision. It is an allowance for the calendar year, not
          an amount you have earned so far{joinedThisYear && joinedLabel ? ', and it is not reduced for joining on ' + joinedLabel : ''}.
          {workspace && workspace.isIntern
            ? ' An internship does not necessarily carry these allowances at all. Before you plan around a number here, ask HR what applies to your engagement.'
            : ' If you joined part way through the year, ask HR what you have actually accrued before you plan around it.'}
        </p>
        <div class="balgrid">
          {countedBalances.map((b) => (
            <div class="bal">
              <b>{b.remaining}</b>
              <span>{b.name} left · {b.used} used{b.pending ? ', ' + b.pending + ' pending' : ''}</span>
            </div>
          ))}
          {ledgerBalance && (
            <div class="bal">
              <b>{compOff ? compOff.available : 0}</b>
              <span>Comp off available{compOff && compOff.nextExpiry ? ' · next expires ' + fmt(compOff.nextExpiry) : ''}</span>
            </div>
          )}
        </div>
        {compOff && compOff.expiringSoon > 0 && (
          <p class="note">{compOff.expiringSoon} day(s) of comp off expire within a month. Comp off is earned from approved overtime and it does not carry on forever.</p>
        )}
        {compOff && compOff.expired > 0 && (
          <p class="note">{compOff.expired} day(s) of comp off have expired unused. They are kept on the record rather than deleted.</p>
        )}
      </div>

      <div class="card">
        <h3>Ask for time off</h3>
        <form method="POST" action={PATH}>
          <input type="hidden" name="action" value="apply"/>

          <label for="leave_type">Type</label>
          <select id="leave_type" name="leave_type" required>
            {LEAVE_TYPES.map((t) => (
              <option value={t.id} data-half={t.halfDay ? '1' : '0'} data-hourly={t.hourly ? '1' : '0'}>
                {t.name}{t.allowance ? ' · ' + t.allowance + ' a year' : (t.source === 'ledger' ? ' · from your comp-off balance' : ' · no allowance used')}
              </option>
            ))}
          </select>

          {/* Was a bare <label> pointing at nothing, sitting outside the fieldset. A
              <legend> is what names a group of radios, and it is what a screen reader
              repeats before each option. */}
          <fieldset class="units">
            <legend>How much</legend>
            <label for="u_full"><input id="u_full" type="radio" name="unit" value="full" checked/> Whole days</label>
            <label for="u_half"><input id="u_half" type="radio" name="unit" value="half"/> Half a day</label>
            <label for="u_hours"><input id="u_hours" type="radio" name="unit" value="hours"/> A few hours</label>
          </fieldset>

          <div class="row2">
            <div>
              <label for="start_date">From</label>
              <input id="start_date" name="start_date" type="date" required/>
            </div>
            <div id="endwrap">
              <label for="end_date">To</label>
              <input id="end_date" name="end_date" type="date"/>
            </div>
          </div>

          <div id="halfwrap">
            <label for="day_part">Which half</label>
            <select id="day_part" name="day_part">
              {DAY_PARTS.map((p) => (<option value={p}>{p === 'first_half' ? 'First half of the day' : 'Second half of the day'}</option>))}
            </select>
          </div>

          <div id="hourwrap">
            <label for="hours">How many hours</label>
            <input id="hours" name="hours" type="number" min="0.5" max="12" step="0.5" placeholder="2"/>
          </div>

          <label for="reason">Reason</label>
          <textarea id="reason" name="reason" rows="2" placeholder="A line for whoever approves it"></textarea>

          <button class="btn" style="margin-top:12px;" type="submit">Send for approval</button>
          <p class="note">
            Decided by your reporting manager or by HR. Public holidays inside the dates are taken out
            before anything is charged, so a week across a holiday costs you a day less. Work from home
            costs no leave at all and is recorded as working, not as absence.
          </p>
        </form>
      </div>

      <div class="card">
        <h3>Your requests</h3>
        {history.length === 0 && <p style="font-size:13px;color:var(--emp-muted);">Nothing requested yet.</p>}
        {history.map((l: any) => (
          <div class="ledger">
            <div class="who">
              <div style="font-weight:600;">{leaveTypeName(l.leave_type)} · {unitWords(l)}</div>
              <div style="font-size:11px;color:var(--emp-muted);">
                {fmt(l.start_date)}{String(l.start_date).slice(0, 10) === String(l.end_date).slice(0, 10) ? '' : ' to ' + fmt(l.end_date)}
                {l.day_part ? ' · ' + (l.day_part === 'first_half' ? 'first half' : 'second half') : ''}
                {l.reason ? ' · ' + l.reason : ''}
              </div>
              {/* THE HALT, SAID TO THE PERSON IT IS ABOUT.
                  The engine writes a readable sentence when the Organization Graph cannot name an
                  approver, and it was rendered only on an admin console — so the employee saw
                  "pending" and waited, while the record actually said nobody had been asked. The
                  request is never auto-approved and never discarded; it waits, visibly, with a cause
                  somebody can act on. */}
              {l.status === 'pending' && l.halt_reason && (
                <div style="margin-top:6px;font-size:11.5px;line-height:1.5;color:#8a4b06;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:7px 9px;">
                  Not with an approver yet: {l.halt_reason}
                </div>
              )}
              {l.status === 'rejected' && l.decision_note && (
                <div style="margin-top:6px;font-size:11.5px;line-height:1.5;color:#7f1d1d;">
                  {l.decision_note}
                </div>
              )}
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex:0 0 auto;">
              <span class="pill" style={'color:' + statusColour(String(l.status)) + ';background:' + statusColour(String(l.status)) + '18;'}>{l.status}</span>
              {/* NAMES THE REQUEST BEING WITHDRAWN, not "this request" — see cancelLeaveConfirm in
                  the frontmatter for the sentence and why it is built there.

                  OUTSIDE THE `&&` ON PURPOSE. As the first child inside the parentheses,
                  `{/* ... *​/}` is not a comment: it parses as an object literal beside an adjacent
                  element, and the compiler reports missing closing tags a hundred lines lower. The
                  ".astro specifics" trap in CLAUDE.md. */}
              {l.status === 'pending' && (
                <form method="POST" action={PATH} style="margin:0;" onsubmit={cancelLeaveConfirm(l)}>
                  <input type="hidden" name="action" value="cancel"/>
                  <input type="hidden" name="id" value={l.id}/>
                  <button class="kill" type="submit" aria-label="Cancel this request">Cancel</button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>

      {compOffCredits.length > 0 && (
        <div class="card">
          <h3>Comp off you have earned</h3>
          {compOffCredits.map((c) => (
            <div class="ledger">
              <div class="who">
                <div style="font-weight:600;">{c.remaining} of {c.units} day(s) left</div>
                <div style="font-size:11px;color:var(--emp-muted);">
                  Earned {fmt(c.earnedOn)} from {c.source === 'holiday_work' ? 'a worked holiday' : 'approved overtime'} · expires {fmt(c.expiresOn)}
                </div>
              </div>
              <span class="pill" style={c.expired ? 'color:var(--emp-muted);background:var(--emp-muted)18;' : 'color:#059669;background:#05966918;'}>{c.expired ? 'expired' : 'live'}</span>
            </div>
          ))}
          <p class="note">Comp off is only ever credited when an overtime claim or a worked holiday is approved. It is never added automatically from hours.</p>
        </div>
      )}

      <div class="card">
        <h3>Holidays coming up</h3>
        {holidays.length === 0 && (
          <p style="font-size:13px;color:var(--emp-muted);line-height:1.6;">
            No holidays are recorded for the next three months. That is almost certainly because the
            calendar has not been filled in yet rather than because there are none, and it has a cost
            you should know about before you apply: until HR records them, every day inside a leave
            request is charged to your allowance as an ordinary day, including a public holiday that
            falls in the middle of your week off. If you are about to take leave across a known
            holiday, say so in the reason and ask HR to record the calendar first.
          </p>
        )}
        {holidays.map((h) => (
          <div class="ledger">
            <div class="who">
              <div style="font-weight:600;">{h.name}</div>
              <div style="font-size:11px;color:var(--emp-muted);">
                {fmt(h.dateIso)}
                {h.location ? ' · at ' + h.location : ''}
                {h.departmentName ? ' · ' + h.departmentName : ''}
                {h.isOptional ? ' · optional' : ''}
              </div>
            </div>
          </div>
        ))}
        {holidays.some((h) => !!h.location) && (
          <p class="note">
            A holiday marked with a place applies there. This product does not record which office you
            sit in, so a holiday with a place on it is shown to you but is not taken off your leave
            automatically. Ask HR if it should apply to you.
          </p>
        )}
      </div>
    </div>
  )}
</div>

<script is:inline data-half-types={halfDayTypes} data-hourly-types={hourlyTypes}>
  // Shows only the fields the chosen unit needs. THE PAGE IS FULLY USABLE WITHOUT THIS: every field
  // is visible and valid by default, and the server re-checks every combination. Nothing here
  // decides anything - applyLeave() refuses an hourly maternity request whether or not this ran.
  (function () {
    var script = document.currentScript;
    var half = String(script.getAttribute('data-half-types') || '').split(',');
    var hourly = String(script.getAttribute('data-hourly-types') || '').split(',');
    var type = document.getElementById('leave_type');
    var endwrap = document.getElementById('endwrap');
    var halfwrap = document.getElementById('halfwrap');
    var hourwrap = document.getElementById('hourwrap');
    var radios = document.querySelectorAll('input[name="unit"]');
    if (!type || !endwrap || !halfwrap || !hourwrap) return;

    function unit() {
      for (var i = 0; i < radios.length; i++) if (radios[i].checked) return radios[i].value;
      return 'full';
    }
    function sync() {
      var u = unit();
      var t = type.value;
      endwrap.style.display = u === 'full' ? '' : 'none';
      halfwrap.style.display = u === 'half' ? '' : 'none';
      hourwrap.style.display = u === 'hours' ? '' : 'none';
      for (var i = 0; i < radios.length; i++) {
        var v = radios[i].value;
        var allowed = v === 'full'
          || (v === 'half' && half.indexOf(t) >= 0)
          || (v === 'hours' && hourly.indexOf(t) >= 0);
        radios[i].disabled = !allowed;
        if (!allowed && radios[i].checked) { radios[0].checked = true; }
      }
    }
    type.addEventListener('change', sync);
    for (var i = 0; i < radios.length; i++) radios[i].addEventListener('change', sync);
    sync();
  })();
</script>
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    /* var(--emp-dim) was 3.2:1 on white — under the 4.5:1 floor, and it named every field. */
