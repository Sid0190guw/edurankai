---
// /portal/employee/benefits — WHAT THIS COMPANY OFFERS YOU, AND WHETHER IT APPLIES TO YOU.
//
// AUTHORISATION IS OWNERSHIP, NOT A ROLE. Every read here is narrowed to the signed-in person's own
// employee record. There is no id in the URL, so there is nothing to change in the address bar, and
// no capability is involved: what you are entitled to is yours to read. Gating this on a permission
// would hide a person's own benefits from them, because an employee's account very often carries the
// `applicant` role, which holds nothing at all.
//
// ELIGIBILITY IS EVALUATED, NOT HARDCODED. Every line saying whether something applies comes from
// evaluateEligibility() in src/lib/benefits.ts, reading the conditions HR recorded against the
// benefit and the facts on this person's own employee record. There is not one `if` in this file
// testing employment type, and there must never be — a rule written into a page is a second policy
// that nobody can change without a deploy.
//
// BENEFITS SOMEBODY DOES NOT QUALIFY FOR ARE STILL SHOWN, greyed, with the reason. Hiding them would
// mean a person three weeks short of qualifying never learns the benefit exists and never asks.
//
// ELECTING ONE IS A REQUEST. The button sends it to whoever this organisation recorded as the
// benefits approval owner. It enrols nobody by itself, and the page says so in those words rather
// than leaving somebody to wonder why nothing changed.
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
// The single employee-record resolver: the canonical gate plus the couple of extra columns this
// page renders. Never a hand-written SELECT against hr_employees — see the block below.
import { resolveEmployeeIdentity } from '@/lib/workforce/identity';
// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import {
  catalogueFor, requestEnrolment, cancelEnrolment, describeRules, benefitCategoryLabel,
  enrolmentStateLabel, type CatalogueEntry,
} from '@/lib/benefits';

const user = Astro.locals.user;

if (!user) return Astro.redirect('/portal/login?next=/portal/employee/benefits');

// EVERY const BEFORE the POST handler that reads it. `const` is not hoisted.
const PAGE = '/portal/employee/benefits';

// The signed-in account, captured after the guard. TypeScript's narrowing of `user` does not survive
// into the closure below, and a non-null assertion there would be the same claim with the checking
// switched off.
const account = user;

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

const fmtDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

const stateColour: Record<string, string> = {
  active: '#047857', pending: '#d97706', halted: '#b45309',
  rejected: '#b91c1c', cancelled: 'var(--emp-muted)', ended: 'var(--emp-muted)',
};

// THE LOOKUP IS NOT WRITTEN HERE ANY MORE.
//
// It was two raw SELECTs against hr_employees — user_id first, then the three email columns — and
// src/lib/workforce/identity.ts records the three ways every hand-written copy of that block was
// wrong: a CASE-SENSITIVE email comparison where the canonical gate compares lower() to lower(), a
// `LIMIT 1` that PICKED a row where the gate REFUSES two records sharing one address, and two
// unindexed reads of hr_employees on every single page load. resolveEmployeeIdentity() is that gate
// plus the couple of extra columns this page renders.
//
// The shape of the return value is unchanged, so every caller below is untouched: `employee` is null
// on any denial, and `failed` still distinguishes "the read did not happen" from "there is no
// record" — which is the distinction this page's own comment insisted on and the only one that
// decides which sentence a person is shown.
async function resolveEmployee(): Promise<{ employee: any | null; failed: boolean; denial: { title: string; reason: string } | null }> {
  const res = await resolveEmployeeIdentity(account as any, '/portal/employee/benefits');
  if (!res.ok) return { employee: null, failed: res.failed, denial: res.denial };
  return {
    employee: { id: res.identity.employeeId, full_name: res.identity.fullName, employee_code: res.identity.employeeCode },
    failed: false,
    denial: null,
  };
}

if (Astro.request.method === 'POST') {
  let flash = '';
  try {
    const resolved = await resolveEmployee();
    if (!resolved.employee) {
      // The same sentence the GET path shows, for the same reason: a person who was refused
      // because TWO records share their address must not be told to ask for a link that
      // already exists twice over.
      flash = resolved.denial
        ? resolved.denial.reason
        : 'This account is not linked to an employee record, so nothing could be requested.';
    } else {
      const fd = await Astro.request.formData();
      const action = String(fd.get('action') || '');
      // THE EMPLOYEE ID COMES FROM THE SESSION, NEVER FROM THE FORM. A hidden field here would let
      // somebody elect a benefit on a colleague's behalf by editing the page.
      const myEmployeeId = String(resolved.employee.id);

      if (action === 'elect') {
        const r = await requestEnrolment({
          benefitId: String(fd.get('benefit_id') || ''),
          employeeId: myEmployeeId,
          option: String(fd.get('option') || ''),
          reason: String(fd.get('reason') || ''),
          requestedByUserId: account.id,
        });
        if (r.ok && r.haltReason) {
          flash = 'Recorded, but it could not be sent to anybody yet: ' + r.haltReason
            + ' HR can see it and nothing is lost.';
        } else if (r.ok) {
          flash = 'Sent for approval. You are not enrolled until somebody approves it.';
        } else {
          flash = r.error || 'The election was not saved.';
        }
      } else if (action === 'withdraw') {
        // Scoped to this person's own rows: the id was rendered from a catalogue already narrowed by
        // employee_id, and it is re-checked here before anything is written.
        const enrolmentId = String(fd.get('enrolment_id') || '');
        const mine = (await catalogueFor(myEmployeeId)).entries
          .some((e) => e.enrolment && e.enrolment.id === enrolmentId);
        if (!mine) {
          flash = 'That election is not yours, so nothing was changed.';
        } else {
          const r = await cancelEnrolment(enrolmentId, account.id);
          flash = r.ok ? 'Election withdrawn.' : (r.error || 'The election was not withdrawn.');
        }
      } else {
        flash = 'That is not something this page does.';
      }
    }
  } catch (e: any) {
    console.error('[portal/benefits] POST', e?.cause?.message || e?.message);
    flash = 'Nothing was saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
  }
  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash.slice(0, 300)));
}

const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
// `denial` carries the gate's own sentence. Three different facts reach this branch — no record
// linked, two records sharing this address, a closed record — and one hard-coded line for all
// three sends two people out of three to ask HR about something that is not the problem.
const { employee, failed: lookupFailed, denial } = await resolveEmployee();
const { entries, subject } = await catalogueFor(employee ? String(employee.id) : null);

const yours = entries.filter((e) => e.eligibility.eligible);
const notYet = entries.filter((e) => !e.eligibility.eligible);
const enrolled = entries.filter((e) => e.enrolment && e.enrolment.state === 'active');
const waiting = entries.filter((e) => e.enrolment && (e.enrolment.state === 'pending' || e.enrolment.state === 'halted'));
---
<EmployeeShell title="Benefits" documentTitle="My benefits" person={employee?.full_name || user.name} width={600} bottomPad={48} bare>

<div class="wrap">
  {msg && <div class="flash">{msg}</div>}

  {lookupFailed && (
    <div class="warn">
      Your employee record could not be read just now, so nothing below has been checked against it.
      This is a fault on our side, not a statement about what you are entitled to. Try again shortly.
    </div>
  )}

  {!lookupFailed && !employee && (
    <div class="card">
      <div class="empty">
        <strong>{denial ? denial.title : 'This account is not linked to an employee record'}</strong>
        {denial
          ? denial.reason
          : 'Benefits are worked out from your employee record, and this sign-in is not connected to one yet. Ask HR to link it; nothing about your entitlement changes in the meantime.'}
      </div>
    </div>
  )}

  {employee && entries.length === 0 && (
    <div class="card">
      <div class="empty">
        <strong>No benefits have been published yet</strong>
        HR has not recorded any benefits in this system. That is exactly what this page says rather
        than showing a list of things nobody has agreed to. When something is added it will appear
        here, with what it is, whether it applies to you, and how to claim it.
      </div>
    </div>
  )}

  {employee && entries.length > 0 && (
    <div>
      {waiting.length > 0 && (
        <div class="card">
          <h3>Waiting on a decision</h3>
          {waiting.map((e: CatalogueEntry) => (
            <div class="block">
              <div class="head">
                <span class="btitle" style="font-size:14px;">{e.benefit.name}</span>
                <span class="pill" style={`color:${stateColour[e.enrolment?.state || 'pending'] || 'var(--emp-muted)'};background:${(stateColour[e.enrolment?.state || 'pending'] || 'var(--emp-muted)')}18;`}>
                  {enrolmentStateLabel(e.enrolment?.state || 'pending')}
                </span>
              </div>
              <p class="bmeta">
                Asked {fmtDate(e.enrolment?.createdAt)}
                {e.enrolment?.optionChosen ? ' · ' + e.enrolment.optionChosen : ''}
              </p>
              {e.enrolment?.state === 'halted' && (
                <p class="bt" style="margin-top:8px;color:#7c4a12;">
                  This has not reached anybody yet: {e.enrolment?.haltReason || 'no approver could be resolved.'}
                  {' '}HR can see it on their queue. Nothing is lost and you do not need to ask again.
                </p>
              )}
              {/* "Withdraw" on its own does not say which benefit, and this is a stack of blocks
                  with the same one-word button at the bottom of each. The confirmation names the
                  benefit and the option chosen, because those are the two things a person picked
                  and would have to pick again — an enrolment cannot be resumed, only re-requested,
                  and some of these have enrolment windows that do not reopen. */}
              <form method="POST" onsubmit={'return confirm("Withdraw your request to join ' + String(e.benefit.name || 'this benefit').replace(/[^\w \-.,]/g, '').slice(0, 60) + (e.enrolment?.optionChosen ? ' on ' + String(e.enrolment.optionChosen).replace(/[^\w \-.,]/g, '') : '') + '?\\n\\nThe request ends and you would have to ask to join again from the start.")'}>
                <input type="hidden" name="action" value="withdraw" />
                <input type="hidden" name="enrolment_id" value={e.enrolment?.id || ''} />
                <button type="submit" class="ghost">Withdraw</button>
              </form>
            </div>
          ))}
        </div>
      )}

      {enrolled.length > 0 && (
        <div class="card">
          <h3>You are enrolled in</h3>
          {enrolled.map((e: CatalogueEntry) => (
            <div class="block good">
              <p class="bl">Enrolled</p>
              <p class="bt">
                {e.benefit.name}
                {e.enrolment?.optionChosen ? ' - ' + e.enrolment.optionChosen : ''}
                {e.enrolment?.decidedAt ? ' · approved ' + fmtDate(e.enrolment.decidedAt) : ''}
              </p>
            </div>
          ))}
        </div>
      )}

      <div class="card">
        <h3>Available to you</h3>
        {yours.length === 0 ? (
          <p class="hint">
            Nothing on the catalogue applies to you yet. Everything that exists is listed further down
            with the reason, so you can see what changes it.
          </p>
        ) : (
          <p class="hint">
            {yours.length} of {entries.length} benefit{entries.length === 1 ? '' : 's'} apply to you,
            worked out from your own employee record.
          </p>
        )}
      </div>

      {yours.map((e: CatalogueEntry) => (
        <div class="card">
          <div class="head">
            <span class="btitle">{e.benefit.name}</span>
            {e.benefit.enrolmentRequired && !e.enrolment && (
              <span class="pill" style="color:var(--emp-accent);background:rgba(194,65,12,.1);">Choose to join</span>
            )}
          </div>
          <p class="bmeta">
            {benefitCategoryLabel(e.benefit.category)}
            {e.benefit.provider ? ' · ' + e.benefit.provider : ''}
          </p>
          <p class="bsum">{e.benefit.summary}</p>
          {e.benefit.details && <p class="bdet">{e.benefit.details}</p>}

          <div class="block good">
            <p class="bl">Why this applies to you</p>
            {e.eligibility.met.map((line) => <p class="bt">{line}</p>)}
          </div>

          <div class="block">
            <p class="bl">How to claim it</p>
            <p class="bt">{e.benefit.claimHow}</p>
            {e.benefit.claimContact && <p class="bt" style="margin-top:6px;">Ask: {e.benefit.claimContact}</p>}
          </div>

          {e.benefit.policyDriveUrl && (
            <p class="bmeta" style="margin-top:12px;">
              <a class="inline" href={e.benefit.policyDriveUrl} target="_blank" rel="noopener noreferrer">Read the policy document</a>
            </p>
          )}

          {e.benefit.enrolmentRequired && !e.enrolment && (
            <form method="POST" class="ask">
              <input type="hidden" name="action" value="elect" />
              <input type="hidden" name="benefit_id" value={e.benefit.id} />
              {e.benefit.enrolmentOptions.length > 0 && (
                <label>Choose
                  <select name="option" required>
                    <option value="">Choose one</option>
                    {e.benefit.enrolmentOptions.map((o) => <option value={o}>{o}</option>)}
                  </select>
                </label>
              )}
              <label>Anything to add
                <textarea name="reason" rows="2" maxlength="1000" placeholder="Optional. Whoever decides this reads it."></textarea>
              </label>
              {e.benefit.enrolmentNote && <p class="hint">{e.benefit.enrolmentNote}</p>}
              <button type="submit" class="go">Ask to join this</button>
              <p class="hint">
                This enrols you in nothing on its own. It asks whoever this company has put in charge
                of benefits to decide, and you will see the answer here.
              </p>
            </form>
          )}

          {e.benefit.enrolmentRequired && e.enrolment && e.enrolment.state !== 'active'
            && e.enrolment.state !== 'pending' && e.enrolment.state !== 'halted' && (
            <div class="block">
              <p class="bl">Your last election</p>
              <p class="bt">
                {enrolmentStateLabel(e.enrolment.state)} &middot; {fmtDate(e.enrolment.createdAt)}
              </p>
            </div>
          )}
        </div>
      ))}

      {notYet.length > 0 && (
        <div class="card dim">
          <h3>Not available to you yet</h3>
          <p class="hint" style="margin-bottom:12px;">
            These exist, and this is exactly why each one does not apply to you today. They are shown
            rather than hidden so you know what changes it.
          </p>
          {notYet.map((e: CatalogueEntry) => (
            <details>
              <summary>{e.benefit.name}</summary>
              <p class="bsum" style="font-size:13px;">{e.benefit.summary}</p>
              <div class="block bad">
                <p class="bl">Why not yet</p>
                {e.eligibility.unmet.map((line) => <p class="bt">{line}</p>)}
              </div>
              <div class="block">
                <p class="bl">Who it is for</p>
                {describeRules(e.benefit.rules).map((line) => <p class="bt">{line}</p>)}
              </div>
            </details>
          ))}
        </div>
      )}

      <div class="card">
        <h3>How this is worked out</h3>
        <p class="bsum" style="font-size:13.5px;">
          Eligibility comes from your own employee record
          {subject ? ' - ' : ''}
          {subject && [
            subject.employmentType ? subject.employmentType : '',
            subject.workMode ? subject.workMode : '',
            subject.departmentName ? subject.departmentName : '',
            subject.tenureDays !== null ? subject.tenureDays + ' days of service' : '',
          ].filter((x) => x).join(', ')}
          {subject ? '.' : '.'}
          {' '}If something above looks wrong, the record is what to correct, not the benefit.
        </p>
        <div class="note">
          <a class="inline" href="/portal/employee/onboarding">Your onboarding checklist</a>
          <span> &middot; </span>
          <a class="inline" href="/portal/employee/profile">Your employee record</a>
        </div>
      </div>
    </div>
  )}
</div>
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card.dim{background:#fbf9f5;box-shadow:none;}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin:0 0 12px;}
    .btitle{font-size:16px;font-weight:700;line-height:1.35;overflow-wrap:anywhere;}
    .bmeta{font-size:11.5px;color:#8b8172;margin-top:4px;line-height:1.5;}
    .bsum{font-size:14px;line-height:1.65;color:#3a332a;margin-top:10px;}
    .bdet{font-size:13px;line-height:1.65;color:#4a4238;margin-top:8px;white-space:pre-wrap;}
    .head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:700;padding:3px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;}
    .block{background:var(--emp-surface-2);border:1px solid #f0e9dc;border-radius:10px;padding:11px 13px;margin-top:12px;}
    .bl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin-bottom:5px;}
    .bt{font-size:13px;color:#4a4238;line-height:1.6;white-space:pre-wrap;}
    .good{background:rgba(4,120,87,.06);border-color:rgba(4,120,87,.2);}
    .good .bl{color:#047857;}
    .bad{background:rgba(180,83,9,.06);border-color:rgba(180,83,9,.2);}
    .bad .bl{color:#b45309;}
    .bad .bt{color:#7c4a12;}
    .empty{text-align:center;padding:34px 12px;color:var(--emp-muted);font-size:13.5px;line-height:1.7;}
    .empty strong{display:block;font-size:15px;color:var(--emp-ink);margin-bottom:8px;}
    .note{background:var(--emp-surface-2);border:1px solid #f0e9dc;border-radius:10px;padding:11px 13px;font-size:12px;color:var(--emp-muted);line-height:1.6;margin-top:12px;}
    .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.28);color:#92400e;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.6;margin-bottom:14px;}
    .flash{background:rgba(4,120,87,.08);border:1px solid rgba(4,120,87,.25);color:#065f46;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.6;margin-bottom:14px;}
    form.ask{display:grid;gap:12px;margin-top:12px;}
    label{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;display:grid;gap:5px;}
    input,select,textarea{width:100%;background:var(--emp-surface-2);border:1px solid #e6ddcc;color:var(--emp-ink);padding:11px 12px;border-radius:10px;font-size:15px;font-family:inherit;min-height:44px;letter-spacing:normal;text-transform:none;}
    textarea{min-height:64px;resize:vertical;}
    .hint{font-family:'Inter Tight',system-ui,sans-serif;font-size:11.5px;color:#8b8172;text-transform:none;letter-spacing:normal;font-weight:400;line-height:1.55;}
    button.go{min-height:44px;padding:0 18px;border:none;border-radius:10px;background:var(--emp-bar);color:#fff;font-size:14px;font-weight:700;cursor:pointer;justify-self:start;}
    button.ghost{min-height:44px;padding:0 14px;border:1px solid #e6ddcc;border-radius:10px;background:transparent;color:var(--emp-muted);font-size:13px;font-weight:600;cursor:pointer;margin-top:10px;}
    a.inline{color:var(--emp-accent);}
    details > summary{cursor:pointer;font-size:12.5px;color:#8b8172;min-height:44px;display:flex;align-items:center;}
</style>
