---
// /portal/employee/intelligence — PATCH 15. THE EMPLOYEE'S OWN VIEW OF THEIR INTELLIGENCE RECORD.
//
// =================================================================================================
// WHAT THIS SCREEN IS, AND WHO IT IS FOR
// =================================================================================================
//
// One person reads this page: the person it is about. Every query behind it is narrowed to their own
// employee id, there is no id in the URL, and there is no variant of this route that takes one. A
// manager's view of somebody is a different screen with a different gate, and it is not this file.
//
// Three tabs, because they are three different acts:
//
//   Your record   the ten sections — strengths, role alignment, growth areas, skills, patterns,
//                 development plan, achievements, change over time, feedback themes, reflections —
//                 each statement carrying what it was read from, the rule that produced it, the
//                 evidence, how far the record supports it, and when.
//   Reflection    their own words. Nothing reads them.
//   Privacy       what they have agreed to, what has been recorded against their record, and how
//                 they say something is wrong.
//
// =================================================================================================
// NOTHING HERE DECIDES ANYTHING
// =================================================================================================
//
// No score, no rank, no percentile, no comparison with a colleague, no prediction. A correction
// request goes to a person and is answered by a person; nothing on this page can close one. The
// sentences are checked against the deterministic-language patterns in the contract by the test
// suite, so "supportive and non-deterministic" is a property the build enforces rather than a note
// in a document.
//
// =================================================================================================
// THE ASTRO RULES THIS PROJECT HAS PAID FOR
// =================================================================================================
//
// Every const is declared ABOVE the POST handler: const is not hoisted, and a handler reaching a
// later declaration throws on its first line while the page reports success. Every label is resolved
// to a plain string in a view model here rather than indexed out of a typed map inside the markup.
// No comparison operators inside JSX expressions. No emoji anywhere — inline monochrome SVG only.
//
// POST-REDIRECT-GET on every write, so a refresh never resubmits. CLIENT JAVASCRIPT: NONE — tabs are
// links, forms are forms, disclosure is native details.
//
// MOBILE FIRST: 360px is the design width, every control clears 44px, nothing scrolls sideways.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import { composeWorkspace } from '@/lib/workforce/composer';
import { resolveEmployeeIdentity } from '@/lib/workforce/identity';
import { resolvePerfViewer } from '@/lib/performance-scope';
import { buildSelfIntelligence } from '@/lib/intelligence/sources';
import {
  CONFIDENCE_LABELS, CONFIDENCE_MEANING, NEVER_SHOWN, SELF_SECTIONS, SURFACE_PREAMBLE,
} from '@/lib/intelligence/contract';
import {
  consentState, recordConsentDecision, dataUsage,
  listCorrections, requestCorrection, withdrawCorrection,
} from '@/lib/intelligence/consent';
import {
  REFLECTION_PROMPTS, PERIOD_WORDS, myReflections, writeReflection, editReflection,
  deleteReflection, setReflectionShared, unshareAllReflections,
} from '@/lib/intelligence/reflection';

// ------------------------------------------------------------------------------------------------
// CONSTANTS. ALL OF THEM, BEFORE THE HANDLER.
// ------------------------------------------------------------------------------------------------
const PATH = '/portal/employee/intelligence';
const TAB_RECORD = 'record';
const TAB_REFLECTION = 'reflection';
const TAB_PRIVACY = 'privacy';
const VALID_TABS = [TAB_RECORD, TAB_REFLECTION, TAB_PRIVACY];

const askedTab = String(Astro.url.searchParams.get('tab') || TAB_RECORD);
const tab = VALID_TABS.indexOf(askedTab) >= 0 ? askedTab : TAB_RECORD;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

const identity = await resolveEmployeeIdentity(user as any, PATH);
if (!identity.ok && identity.denial.redirect) return Astro.redirect(identity.denial.redirect);

const employeeId = identity.ok ? identity.identity.employeeId : '';
const fullName = identity.ok ? identity.identity.fullName : '';
const userId = String((user as any).id || '');

let flash = '';
let flashError = '';

// ------------------------------------------------------------------------------------------------
// THE WRITES. Every one narrowed to this employee's own id, inside the query, not around it.
// ------------------------------------------------------------------------------------------------
if (Astro.request.method === 'POST' && employeeId) {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get('action') || '');

    if (action === 'consent') {
      const purposeKey = String(form.get('purpose_key') || '');
      const granted = String(form.get('granted') || '') === 'yes';
      const res = await recordConsentDecision({
        employeeId,
        actorUserId: userId,
        purposeKey,
        granted,
        decidedBySelf: true,
      });
      if (res.ok) {
        // A WITHDRAWAL THAT WITHDRAWS NOTHING IS NOT A WITHDRAWAL. Turning sharing off has to reach
        // the entries that were already shared, or the switch is decorative.
        if (!granted && purposeKey === 'reflection_visible_to_manager') {
          const un = await unshareAllReflections(employeeId);
          flash = un.changed > 0
            ? 'Saved. ' + un.changed + ' shared entr' + (un.changed === 1 ? 'y is' : 'ies are') + ' now private again.'
            : 'Saved. Nothing was shared, so nothing changed.';
        } else {
          flash = 'Saved. This applies from now on.';
        }
      } else {
        flashError = res.error || 'That could not be saved.';
      }
    } else if (action === 'reflect') {
      const res = await writeReflection({
        employeeId,
        userId,
        promptKey: String(form.get('prompt_key') || 'free'),
        body: String(form.get('body') || ''),
        periodWord: String(form.get('period_word') || ''),
      });
      flash = res.ok ? 'Saved. This is yours alone.' : '';
      flashError = res.ok ? '' : (res.error || 'That could not be saved.');
    } else if (action === 'reflect_edit') {
      const res = await editReflection({
        id: String(form.get('id') || ''),
        employeeId,
        body: String(form.get('body') || ''),
        periodWord: String(form.get('period_word') || ''),
      });
      flash = res.ok ? 'Updated.' : '';
      flashError = res.ok ? '' : (res.error || 'That could not be saved.');
    } else if (action === 'reflect_delete') {
      const res = await deleteReflection({ id: String(form.get('id') || ''), employeeId });
      flash = res.ok ? 'Deleted.' : '';
      flashError = res.ok ? '' : (res.error || 'That could not be deleted.');
    } else if (action === 'reflect_share') {
      const res = await setReflectionShared({
        id: String(form.get('id') || ''),
        employeeId,
        userId,
        shared: String(form.get('shared') || '') === 'yes',
      });
      flash = res.ok ? 'Saved.' : '';
      flashError = res.ok ? '' : (res.error || 'That could not be changed.');
    } else if (action === 'correct') {
      const res = await requestCorrection({
        employeeId,
        userId,
        targetSection: String(form.get('target_section') || 'general'),
        targetKey: String(form.get('target_key') || ''),
        recordSays: String(form.get('record_says') || ''),
        employeeSays: String(form.get('employee_says') || ''),
        evidenceUrl: String(form.get('evidence_url') || ''),
      });
      flash = res.ok
        ? 'Filed. A person picks this up, and you will see their answer and their reason here.'
        : '';
      flashError = res.ok ? '' : (res.error || 'That could not be filed.');
    } else if (action === 'correct_withdraw') {
      const res = await withdrawCorrection({ id: String(form.get('id') || ''), employeeId, userId });
      flash = res.ok ? 'Withdrawn.' : '';
      flashError = res.ok ? '' : (res.error || 'That could not be withdrawn.');
    }
  } catch (e: any) {
    // NEVER SWALLOWED. The real Postgres reason is on e.cause; e.message is just the failed SQL.
    flashError = 'That could not be saved: ' + (e?.cause?.message || e?.message || 'unknown reason');
    console.error('[portal/intelligence] post', e?.cause?.message || e?.message);
  }

  const back = PATH + '?tab=' + tab
    + (flash ? '&msg=' + encodeURIComponent(flash) : '')
    + (flashError ? '&err=' + encodeURIComponent(flashError) : '');
  return Astro.redirect(back, 303);
}

const msgParam = String(Astro.url.searchParams.get('msg') || '');
const errParam = String(Astro.url.searchParams.get('err') || '');
if (msgParam) flash = msgParam;
if (errParam) flashError = errParam;

// ------------------------------------------------------------------------------------------------
// THE READS. Only what the open tab needs.
// ------------------------------------------------------------------------------------------------
let sections: any[] = [];
let sourceHealth: { source: string; ok: boolean }[] = [];
let generatedAt = '';
let consent: any = null;
let usage: any = null;
let corrections: any = null;
let reflections: any = null;

if (employeeId) {
  // (user, opts) — NOT (locals, user). `locals` rides in the options bag, which is also what carries
  // the per-request memo, so composing here reuses whatever the middleware already resolved instead
  // of issuing the permission reads a second time.
  const composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
  const holds = (key: string) => {
    try { return composed.context.holds(key) === true; } catch { return false; }
  };
  const viewer = await resolvePerfViewer(userId, holds);

  if (tab === TAB_RECORD) {
    const view = await buildSelfIntelligence({ employeeId, userId, viewer, holds });
    sections = view.sections;
    sourceHealth = view.sourceHealth;
    generatedAt = view.generatedAt;
  } else if (tab === TAB_REFLECTION) {
    reflections = await myReflections(employeeId, 60);
  } else {
    consent = await consentState(employeeId);
    usage = await dataUsage(employeeId, userId, 60);
    corrections = await listCorrections(employeeId, 40);
  }
}

// ------------------------------------------------------------------------------------------------
// VIEW MODELS. Every label resolved to a plain string HERE, and every comparison done HERE, because
// a typed map indexed from inside the markup and a `<` inside a JSX expression are the two things
// that reliably break the compiler on this project — and it blames a line nowhere near the real one.
// ------------------------------------------------------------------------------------------------
const tabs = [
  { key: TAB_RECORD, label: 'Your record', href: PATH + '?tab=' + TAB_RECORD, current: tab === TAB_RECORD },
  { key: TAB_REFLECTION, label: 'Reflection', href: PATH + '?tab=' + TAB_REFLECTION, current: tab === TAB_REFLECTION },
  { key: TAB_PRIVACY, label: 'Privacy', href: PATH + '?tab=' + TAB_PRIVACY, current: tab === TAB_PRIVACY },
];

const sectionViews = sections.map((s: any) => ({
  key: String(s.section),
  label: String(s.label),
  purpose: String(s.purpose),
  emptyReason: s.emptyReason ? String(s.emptyReason) : '',
  unreadable: s.unreadable === true,
  hasInsights: Array.isArray(s.insights) && s.insights.length > 0,
  insights: (s.insights || []).map((i: any) => ({
    key: String(i.key),
    output: String(i.output),
    processing: String(i.processing),
    inputsLine: (i.inputs || []).join(' · '),
    confidenceLabel: String((CONFIDENCE_LABELS as any)[i.confidence] || i.confidence),
    confidenceMeaning: String((CONFIDENCE_MEANING as any)[i.confidence] || ''),
    observedAt: i.observedAt ? String(i.observedAt).slice(0, 10) : '',
    hasEvidence: Array.isArray(i.evidence) && i.evidence.length > 0,
    evidence: (i.evidence || []).map((e: any) => ({
      label: String(e.label),
      owner: String(e.owner),
      href: e.href ? String(e.href) : '',
      hasHref: !!e.href,
      occurredAt: e.occurredAt ? String(e.occurredAt).slice(0, 10) : '',
    })),
  })),
}));

const brokenSources = sourceHealth.filter((h) => !h.ok).map((h) => h.source);
const hasBrokenSources = brokenSources.length > 0;
const brokenLine = brokenSources.join(', ');
const generatedLine = generatedAt ? generatedAt.slice(0, 16).replace('T', ' ') + ' UTC' : '';

const neverShown = NEVER_SHOWN.map((n) => ({ what: String(n.what), because: String(n.because) }));

const consentRows = consent
  ? consent.states.map((s: any) => ({
      key: String(s.purpose.key),
      label: String(s.purpose.label),
      what: String(s.purpose.what),
      whoSees: String(s.purpose.whoSees),
      onWithdrawal: String(s.purpose.onWithdrawal),
      on: s.effective === true,
      stateWord: s.effective === true ? 'On' : 'Off',
      decided: s.decided === true,
      decidedLine: s.decided
        ? 'You answered this on ' + String(s.decidedAt || '').slice(0, 10) + (s.bySelf ? '.' : ', and it was recorded on your behalf.')
        : 'You have not answered this yet, so the default applies.',
      nextValue: s.effective === true ? 'no' : 'yes',
      nextLabel: s.effective === true ? 'Turn off' : 'Turn on',
    }))
  : [];
const consentSentence = consent ? String(consent.sentence) : '';
const consentOk = consent ? consent.ok !== false : true;

const usageRows = usage
  ? usage.entries.map((e: any) => ({
      at: e.at ? String(e.at).slice(0, 16).replace('T', ' ') : '',
      label: String(e.label),
      byYouWord: e.byYou ? 'By you' : 'Recorded by the platform',
    }))
  : [];
const usageSentence = usage ? String(usage.sentence) : '';
const usageCoverage = usage ? String(usage.coverage) : '';
const hasUsageRows = usageRows.length > 0;

const correctionRows = corrections
  ? corrections.rows.map((c: any) => ({
      id: String(c.id),
      // Resolved to words HERE. A .replace() inside a JSX expression puts a regex literal in front
      // of the .astro compiler, and this project has already lost time to it blaming a line nowhere
      // near the real one.
      section: String(c.targetSection).replace(/_/g, ' '),
      recordSays: String(c.recordSays),
      employeeSays: String(c.employeeSays),
      evidenceUrl: c.evidenceUrl ? String(c.evidenceUrl) : '',
      hasEvidence: !!c.evidenceUrl,
      statusLabel: String(c.statusLabel),
      decisionNote: c.decisionNote ? String(c.decisionNote) : '',
      hasDecision: !!c.decisionNote,
      createdAt: c.createdAt ? String(c.createdAt).slice(0, 10) : '',
      canWithdraw: c.status === 'open' || c.status === 'acknowledged',
    }))
  : [];
const correctionSentence = corrections ? String(corrections.sentence) : '';
const hasCorrections = correctionRows.length > 0;

const sectionOptions = SELF_SECTIONS.map((k) => ({ value: String(k), label: String(k).replace(/_/g, ' ') }));

const promptOptions = REFLECTION_PROMPTS.map((p) => ({
  value: String(p.key),
  label: String(p.question),
  why: String(p.why),
}));
const periodOptions = PERIOD_WORDS.map((w) => ({ value: String(w), label: String(w) }));

const reflectionRows = reflections
  ? reflections.rows.map((r: any) => ({
      id: String(r.id),
      question: String(r.question),
      body: String(r.body),
      periodWord: r.periodWord ? String(r.periodWord) : '',
      hasPeriodWord: !!r.periodWord,
      shared: r.sharedWithManager === true,
      shareNext: r.sharedWithManager === true ? 'no' : 'yes',
      shareLabel: r.sharedWithManager === true ? 'Stop sharing with my manager' : 'Share this one with my manager',
      writtenAt: r.createdAt ? String(r.createdAt).slice(0, 10) : '',
    }))
  : [];
const reflectionSentence = reflections ? String(reflections.sentence) : '';
const sharingEnabled = reflections ? reflections.sharingEnabled === true : false;
const hasReflections = reflectionRows.length > 0;

const noRecord = !employeeId;
const denialTitle = identity.ok ? '' : String(identity.denial.title);
const denialReason = identity.ok ? '' : String(identity.denial.reason);
---
<EmployeeShell title="Your record" person={fullName || 'Your record'} width={760} bottomPad={96} bare>

  <main class="wrap">
    <nav class="tabs" aria-label="Your personal record">
      {tabs.map((t) => (
        <a class="tab" href={t.href} aria-current={t.current ? 'page' : undefined}>{t.label}</a>
      ))}
    </nav>

    {flash ? <div class="ok">{flash}</div> : null}
    {flashError ? <div class="bad">{flashError}</div> : null}

    {noRecord ? (
      <section class="card">
        <h3>{denialTitle || 'Your record is not available'}</h3>
        <p>{denialReason || 'Ask HR to check the record linked to the address you signed in with.'}</p>
      </section>
    ) : (
      <section class="preamble">
        <p>{SURFACE_PREAMBLE}</p>
      </section>
    )}

    {/* ------------------------------------------------------------------ YOUR RECORD */}
    {!noRecord && tab === TAB_RECORD ? (
      <div>
        {hasBrokenSources ? (
          <div class="notice">
            <p>Some of what this page reads did not come back: {brokenLine}. Those sections say so
              rather than showing you an empty list. Nothing has been removed from your record.</p>
          </div>
        ) : null}

        {sectionViews.map((s) => (
          <section class="block">
            <h2 class="sec">{s.label}</h2>
            <p class="purpose">{s.purpose}</p>

            {!s.hasInsights ? (
              <div class={s.unreadable ? 'notice' : 'card'}>
                <p>{s.emptyReason}</p>
              </div>
            ) : null}

            {s.insights.map((i) => (
              <article class="card">
                <p class="say">{i.output}</p>
                <p class="conf">
                  <span class="chip">{i.confidenceLabel}</span>
                  {i.observedAt ? <span class="when">most recent record {i.observedAt}</span> : null}
                </p>
                <details class="why">
                  <summary>Where this came from</summary>
                  <dl class="kv">
                    <dt>Read from</dt>
                    <dd>{i.inputsLine}</dd>
                    <dt>The rule</dt>
                    <dd>{i.processing}</dd>
                    <dt>What that confidence means</dt>
                    <dd>{i.confidenceMeaning}</dd>
                  </dl>
                  {i.hasEvidence ? (
                    <ul class="ev">
                      {i.evidence.map((e) => (
                        <li>
                          {e.hasHref
                            ? <a href={e.href}>{e.label}</a>
                            : <span>{e.label}</span>}
                          <span class="owner">{e.owner}{e.occurredAt ? ' · ' + e.occurredAt : ''}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="owner">Nothing on record stands behind this yet, which is what the
                      confidence above is reporting.</p>
                  )}
                  <p class="owner">If this is wrong, the Privacy tab has a correction form. It goes
                    to a person.</p>
                </details>
              </article>
            ))}
          </section>
        ))}

        {generatedLine ? <p class="foot">Composed {generatedLine} from the records named above.</p> : null}
      </div>
    ) : null}

    {/* ------------------------------------------------------------------ REFLECTION */}
    {!noRecord && tab === TAB_REFLECTION ? (
      <div>
        <section class="card">
          <h3>Yours alone</h3>
          <p>Nothing in this system reads what you write here. It is not scored, not summarised, and
            not counted towards anything. Nobody else sees an entry unless you share that one entry
            yourself.</p>
        </section>

        <h2 class="sec">Write something</h2>
        <section class="card">
          <form method="POST">
            <input type="hidden" name="action" value="reflect"/>
            <label class="fld">
              What are you writing about
              <select name="prompt_key">
                {promptOptions.map((p) => (
                  <option value={p.value}>{p.label}</option>
                ))}
              </select>
            </label>
            <ul class="hints">
              {promptOptions.map((p) => (
                <li><b>{p.label}</b> {p.why}</li>
              ))}
            </ul>
            <label class="fld">
              Your words
              <textarea name="body" rows="6" maxlength="20000" required></textarea>
            </label>
            <label class="fld">
              A word for this period (optional)
              <span>Only so you can find this entry again later. Nothing reads it.</span>
              <select name="period_word">
                <option value="">No word</option>
                {periodOptions.map((w) => (
                  <option value={w.value}>{w.label}</option>
                ))}
              </select>
            </label>
            <button class="go" type="submit">Save</button>
          </form>
        </section>

        <h2 class="sec">What you have written</h2>
        <p class="purpose">{reflectionSentence}</p>

        {!sharingEnabled ? (
          <div class="notice">
            <p>Sharing an entry with your manager is switched off for your account. You can turn it
              on from the Privacy tab. Even with it on, no entry is shared until you mark that one.</p>
          </div>
        ) : null}

        {reflectionRows.map((r) => (
          <article class="item">
            <h3>{r.question}</h3>
            <p class="meta">{r.writtenAt}{r.hasPeriodWord ? ' · ' + r.periodWord : ''}{r.shared ? ' · shared with your manager' : ''}</p>
            <p class="say">{r.body}</p>

            <details class="why">
              <summary>Edit, share or delete</summary>
              <form method="POST">
                <input type="hidden" name="action" value="reflect_edit"/>
                <input type="hidden" name="id" value={r.id}/>
                <label class="fld">
                  Your words
                  <textarea name="body" rows="5" maxlength="20000" required>{r.body}</textarea>
                </label>
                <label class="fld">
                  A word for this period
                  <select name="period_word">
                    <option value="">No word</option>
                    {periodOptions.map((w) => (
                      <option value={w.value} selected={w.value === r.periodWord}>{w.label}</option>
                    ))}
                  </select>
                </label>
                <button class="go" type="submit">Save changes</button>
              </form>

              {sharingEnabled || r.shared ? (
                <form method="POST">
                  <input type="hidden" name="action" value="reflect_share"/>
                  <input type="hidden" name="id" value={r.id}/>
                  <input type="hidden" name="shared" value={r.shareNext}/>
                  <button class="plain" type="submit">{r.shareLabel}</button>
                </form>
              ) : null}

              <form method="POST">
                <input type="hidden" name="action" value="reflect_delete"/>
                <input type="hidden" name="id" value={r.id}/>
                <button class="danger" type="submit">Delete this entry</button>
              </form>
            </details>
          </article>
        ))}

        {!hasReflections ? (
          <section class="card">
            <p>Nothing written yet.</p>
          </section>
        ) : null}
      </div>
    ) : null}

    {/* ------------------------------------------------------------------ PRIVACY */}
    {!noRecord && tab === TAB_PRIVACY ? (
      <div>
        <h2 class="sec">What you have agreed to</h2>
        <p class="purpose">{consentSentence}</p>
        {!consentOk ? (
          <div class="notice">
            <p>Your decisions could not be read just now, so what is shown below is the default
              rather than your answer. Nothing was changed.</p>
          </div>
        ) : null}

        {consentRows.map((c) => (
          <section class="card">
            <h3>{c.label}</h3>
            <p><span class="chip">{c.stateWord}</span></p>
            <p>{c.what}</p>
            <p><b>Who sees anything as a result.</b> {c.whoSees}</p>
            <p><b>If you turn it off.</b> {c.onWithdrawal}</p>
            <p class="meta">{c.decidedLine}</p>
            <form method="POST">
              <input type="hidden" name="action" value="consent"/>
              <input type="hidden" name="purpose_key" value={c.key}/>
              <input type="hidden" name="granted" value={c.nextValue}/>
              <button class="plain" type="submit">{c.nextLabel}</button>
            </form>
          </section>
        ))}

        <h2 class="sec">What this page never shows you</h2>
        {neverShown.map((n) => (
          <section class="card">
            <h3>{n.what}</h3>
            <p>{n.because}</p>
          </section>
        ))}

        <h2 class="sec">What has been recorded against your record</h2>
        <p class="purpose">{usageCoverage}</p>
        <p class="purpose">{usageSentence}</p>
        {hasUsageRows ? (
          <section class="card">
            <ul class="log">
              {usageRows.map((u) => (
                <li>
                  <span class="when">{u.at}</span>
                  <span>{u.label}</span>
                  <span class="owner">{u.byYouWord}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <h2 class="sec">Say something on your record is wrong</h2>
        <section class="card">
          <p>This goes to a person. Nothing here changes a record on its own, and you will see who
            answered and why.</p>
          <form method="POST">
            <input type="hidden" name="action" value="correct"/>
            <label class="fld">
              Which part of your record
              <select name="target_section">
                {sectionOptions.map((o) => (
                  <option value={o.value}>{o.label}</option>
                ))}
              </select>
            </label>
            <label class="fld">
              What the record says
              <span>Copy the sentence you are disputing, so whoever picks this up reads what you read.</span>
              <textarea name="record_says" rows="3" maxlength="2000" required></textarea>
            </label>
            <label class="fld">
              What it should say
              <textarea name="employee_says" rows="4" maxlength="4000" required></textarea>
            </label>
            <label class="fld">
              A supporting link (optional)
              <span>A link, never an upload. Share it so that anyone with the link can open it — your own link always opens for you, so you cannot tell from your side.</span>
              <input type="url" name="evidence_url" inputmode="url" placeholder="https://"/>
            </label>
            <button class="go" type="submit">Send this to a person</button>
          </form>
        </section>

        <h2 class="sec">What you have asked to be corrected</h2>
        <p class="purpose">{correctionSentence}</p>
        {correctionRows.map((c) => (
          <article class="item">
            <h3>{c.section}</h3>
            <p class="meta">{c.createdAt} · {c.statusLabel}</p>
            <p class="say"><b>The record said.</b> {c.recordSays}</p>
            <p class="say"><b>You said.</b> {c.employeeSays}</p>
            {c.hasEvidence ? <p class="meta"><a href={c.evidenceUrl}>Your supporting link</a></p> : null}
            {c.hasDecision ? <p class="say"><b>The answer.</b> {c.decisionNote}</p> : null}
            {c.canWithdraw ? (
              <form method="POST">
                <input type="hidden" name="action" value="correct_withdraw"/>
                <input type="hidden" name="id" value={c.id}/>
                <button class="plain" type="submit">Withdraw this request</button>
              </form>
            ) : null}
          </article>
        ))}
        {!hasCorrections ? (
          <section class="card"><p>You have not asked for anything to be corrected.</p></section>
        ) : null}
      </div>
    ) : null}

  </main>
</EmployeeShell>

