---
// /portal/employee/referrals — AN EMPLOYEE REFERS SOMEBODY, AND THEN SEES WHAT HAPPENED.
//
// =================================================================================================
// THE GATE IS A FACT, NOT A CAPABILITY
// =================================================================================================
//
// This page is gated on HAVING AN EMPLOYEE RECORD, resolved once by composeWorkspace(). It is
// deliberately NOT gated on `referrals.view` or any other key: an employee's account frequently
// carries the `applicant` role, which holds no permission at all, and gating the programme on a
// capability would lock out precisely the people it exists for. Every query below is narrowed to
// THIS person's own referrals in the WHERE clause — listReferrals({ referrerUserId }) — so there is
// nothing here to widen.
//
// =================================================================================================
// WHAT THE REFERRER IS ALLOWED TO SEE, AND THE LINE THAT IS NOT CROSSED
// =================================================================================================
//
// A referrer is not the hiring team. They see WHERE their candidate has got to, in six plain words,
// through referrerVisibleStatus() — the single translation from an application status to something a
// referrer reads. They do not see reviewer comments, interview scorecards, internal notes, rejection
// reasons, scores or approval history, and none of those columns is selected on this page.
//
// The same restraint applies to the reward: a referrer sees whether one is recorded and whether it is
// waiting on approval. They do not see who is deciding it, because that is a routing fact about
// somebody else's working relationships.
//
// =================================================================================================
// THE CV IS A LINK
// =================================================================================================
//
// Documents of any kind on this project are Drive links shared so that anyone with the link can open
// them. Nothing is uploaded here, and the form says so rather than leaving somebody to discover it.
import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
import '@/styles/workforce.css';
import { composeWorkspace } from '@/lib/workforce/composer';
// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import {
  submitReferral,
  withdrawReferral,
  listReferrals,
  referralCounts,
  linkReferralsToApplications,
  openRolesForReferral,
  referrerVisibleStatus,
  relationshipLabel,
  rewardStateLabel,
  REFERRAL_RELATIONSHIPS,
} from '@/lib/referrals';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/employee/referrals');

// One composition per request, memoised on Astro.locals — the nav and this page cannot disagree.
const composed = await composeWorkspace(user, { locals: Astro.locals, next: '/portal/employee/referrals' });
const worksHere = composed?.context?.hasEmployeeRecord === true;
// WHY hasEmployeeRecord IS NOT ENOUGH ON ITS OWN. The composer sets it false for 'lookup-failed' as
// well as for 'no-employee-record', so a database that did not answer arrives here looking exactly
// like an account HR has not linked yet - and the screen below then states, as a fact, that there is
// no record. That is the same confusion the nine self-service pages were just fixed for. The gate
// already wrote the right sentence for whichever it was; this renders that instead of guessing.
const gateDenial = composed?.denial || null;

let okMsg = '';
let errMsg = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  if (!worksHere) {
    errMsg = 'The referral programme is for people on the employee register. Your account is not linked to one yet.';
  } else if (action === 'refer') {
    const result = await submitReferral({
      referrerUserId: String(user.id),
      referrerName: String((user as any)?.name || '') || null,
      candidateName: String(fd.get('candidate_name') || ''),
      candidateEmail: String(fd.get('candidate_email') || ''),
      candidatePhone: String(fd.get('candidate_phone') || ''),
      roleId: String(fd.get('role_id') || '') || null,
      roleTitle: String(fd.get('role_title') || '') || null,
      relationship: String(fd.get('relationship') || 'other'),
      note: String(fd.get('note') || ''),
      cvDriveUrl: String(fd.get('cv_drive_url') || ''),
    });
    if (result.ok) okMsg = result.message || 'Referral recorded.'; else errMsg = result.error;
  } else if (action === 'withdraw') {
    const result = await withdrawReferral(String(fd.get('referral_id') || ''), String(user.id));
    if (result.ok) okMsg = result.message || 'Withdrawn.'; else errMsg = result.error;
  } else {
    errMsg = 'That is not an action this page performs.';
  }
}

// ---- Reads. Every const declared before the template. -------------------------------------------
if (worksHere) await linkReferralsToApplications();
const mine = worksHere ? await listReferrals({ referrerUserId: String(user.id) }) : [];
const counts = worksHere ? await referralCounts(String(user.id)) : null;
const roles = worksHere ? await openRolesForReferral() : [];

const fmtDate = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
const displayName = String((user as any)?.name || 'You');

/**
 * The sentence the Withdraw button asks, BUILT HERE rather than inside the JSX attribute — a regex
 * literal next to a ternary inside an `.astro` attribute expression desynchronises the template
 * parser and the compiler then reports missing closing tags a hundred lines away.
 *
 * NAMES THE PERSON, because that is what is actually at stake: a named human being pulled out of a
 * hiring process by somebody who vouched for them. The button sits one line under a status pill in
 * a repeating list. The reward clause is included only when there is a reward, because withdrawing
 * ends it and the word "withdraw" does not say so.
 */
function withdrawReferralConfirm(r: any): string {
  const scrub = (s: any) => String(s === null || s === undefined ? '' : s).replace(/[^\w \-.,]/g, '');
  const who = scrub(r.candidateName).slice(0, 60) || 'this candidate';
  const reward = r.rewardState !== 'none' ? ', any referral reward attached to it ends' : '';
  return 'return confirm("Withdraw your referral of ' + who +
    '?\\n\\nThey stop being counted as your referral' + reward + ', and it cannot be reinstated by you.")';
}
---
<EmployeeShell title="Refer someone" person={displayName} width={620} bottomPad={96} bare>

<div class="wrap">
  {okMsg && <div class="flash-ok">{okMsg}</div>}
  {errMsg && <div class="flash-err">{errMsg}</div>}

  {!worksHere ? (
    <div class="card" style="text-align:center;padding:34px 20px;">
      <p style="font-weight:600;margin-bottom:8px;">{gateDenial ? gateDenial.title : 'The referral programme is for people on the employee register'}</p>
      <p class="hint">{gateDenial
        ? gateDenial.reason
        : 'Your account is not linked to an employee record, so there is nobody to record a referral against. The people team can link it; nothing has been assumed on your behalf.'}</p>
    </div>
  ) : (
    <div>
      <div class="card">
        <h3>Your referrals</h3>
        <div class="stats">
          <div class="stat"><b>{counts?.total ?? 0}</b><span>Referred</span></div>
          <div class="stat"><b>{counts?.linked ?? 0}</b><span>Applied</span></div>
          <div class="stat"><b>{counts?.hired ?? 0}</b><span>Joined</span></div>
        </div>
        <p class="hint" style="margin-top:12px;">
          You see where each person has got to, and nothing more. Interview notes, scores and the reasons
          behind a decision belong to the hiring team and are never shown here.
        </p>
      </div>

      <form method="POST" class="card">
        <input type="hidden" name="action" value="refer" />
        <h3>Refer someone</h3>
        <div class="row2">
          <div>
            <label for="candidate_name">Their name</label>
            <input id="candidate_name" name="candidate_name" required maxlength="200" placeholder="Full name" />
          </div>
          <div>
            <label for="candidate_email">Their email</label>
            <input id="candidate_email" name="candidate_email" type="email" required maxlength="255" placeholder="name@example.com" />
          </div>
        </div>
        <div class="row2">
          <div>
            <label for="candidate_phone">Their phone (optional)</label>
            <input id="candidate_phone" name="candidate_phone" maxlength="50" placeholder="Optional" />
          </div>
          <div>
            <label for="relationship">How do you know them</label>
            <select id="relationship" name="relationship" required>
              {REFERRAL_RELATIONSHIPS.map((r) => <option value={r.key}>{r.label}</option>)}
            </select>
          </div>
        </div>

        <label for="role_id">Which opening</label>
        <select id="role_id" name="role_id">
          <option value="">Not sure yet</option>
          {roles.map((r) => <option value={r.id}>{r.title}</option>)}
        </select>
        {roles.length === 0 && <p class="hint" style="margin-top:6px;">No openings are listed right now, so leave this and tell us about them below.</p>}

        <label for="cv_drive_url">Link to their CV</label>
        <input id="cv_drive_url" name="cv_drive_url" type="url" placeholder="https://drive.google.com/..." />
        <p class="hint" style="margin-top:6px;">
          A link, never a file. Share it so that anyone with the link can open it, otherwise the hiring team
          will not be able to read it.
        </p>

        <label for="note">Why them</label>
        <textarea id="note" name="note" rows="4" maxlength="2000" placeholder="What they are good at, and what you have seen them do."></textarea>

        <button type="submit" class="btn" style="margin-top:14px;">Submit this referral</button>
        <p class="hint" style="margin-top:10px;">
          A referral does not create an application. They still apply themselves, and we match the two on their
          email address. Any reward is decided by an approval, never paid automatically.
        </p>
      </form>

      <div class="card">
        <h3>What happened to them</h3>
        {mine.length === 0 ? (
          <p class="hint">You have not referred anybody yet.</p>
        ) : (
          <div>
            {mine.map((r) => (
              <div class="item">
                <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;">
                  <div style="flex:1 1 180px;min-width:0;">
                    <p style="font-size:14.5px;font-weight:600;color:var(--emp-ink);margin:0;">{r.candidateName}</p>
                    <p style="font-size:12px;color:var(--emp-muted);margin:2px 0 0;">{r.roleTitle || 'No opening named'} · {relationshipLabel(r.relationship)}</p>
                  </div>
                  <span class="pill">{referrerVisibleStatus(r.applicationStatus, r.state)}</span>
                </div>
                <p class="hint" style="margin-top:6px;">Referred {fmtDate(r.createdAt)}{r.rewardState !== 'none' ? ' · Reward: ' + rewardStateLabel(r.rewardState) : ''}</p>
                {/* NAMES THE PERSON — see withdrawReferralConfirm in the frontmatter for the
                    sentence and why it is built there.

                    THE COMMENT SITS OUTSIDE THE `&&`, and it has to. As the first child INSIDE the
                    parentheses, `{/* ... *​/}` is not a comment at all: it parses as an object
                    literal followed by an adjacent element, and the compiler then reports missing
                    closing tags a hundred lines below where the mistake is. That is the ".astro
                    specifics" trap in CLAUDE.md, and it costs an hour every time. */}
                {(r.state === 'submitted' || r.state === 'linked') && (
                  <form method="POST" style="margin-top:8px;" onsubmit={withdrawReferralConfirm(r)}>
                    <input type="hidden" name="action" value="withdraw" />
                    <input type="hidden" name="referral_id" value={r.id} />
                    <button type="submit" class="btn-quiet">Withdraw this referral</button>
                  </form>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )}
</div>

<WorkspaceNav composed={composed} active="referrals" />
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin:0 0 12px;}
    label{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;display:block;margin:10px 0 4px;}
    input,select,textarea{width:100%;background:var(--emp-surface-2);border:1px solid var(--emp-line-2);border-radius:9px;padding:11px 12px;font-size:14px;font-family:inherit;color:var(--emp-ink);outline:none;min-height:44px;}
    input:focus,select:focus,textarea:focus{border-color:var(--emp-accent);}
    /* `outline:none` was set with nothing put in its place, so a keyboard or switch user could not tell which control they were on. */
    input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--emp-accent-deep);outline-offset:2px;}
    .btn{background:var(--emp-accent);color:#fff;border:none;border-radius:10px;padding:12px 18px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;width:100%;min-height:44px;}
    .btn-quiet{background:var(--emp-surface-2);color:var(--emp-muted);border:1px solid var(--emp-line-2);border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;min-height:44px;}
    .row2{display:grid;grid-template-columns:1fr;gap:10px;}
    @media (min-width:480px){ .row2{grid-template-columns:1fr 1fr;} }
    .pill{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:4px 10px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;background:#f2ece0;color:var(--emp-muted);}
    .item{border-bottom:1px solid #f2ece0;padding:14px 0;}
    .item:last-child{border-bottom:none;}
    .hint{font-size:12px;color:var(--emp-muted);line-height:1.6;}
    .flash-ok{background:rgba(5,150,105,.1);border:1px solid rgba(5,150,105,.3);color:#065f46;border-radius:10px;padding:11px 14px;font-size:13px;margin-bottom:14px;line-height:1.55;}
    .flash-err{background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.28);color:#991b1b;border-radius:10px;padding:11px 14px;font-size:13px;margin-bottom:14px;line-height:1.55;}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;}
    .stat{background:var(--emp-surface-2);border:1px solid #f0e9db;border-radius:12px;padding:12px 14px;}
    .stat b{font-family:'Fraunces',serif;font-size:24px;font-weight:600;color:var(--emp-ink);display:block;}
    .stat span{font-size:11.5px;color:var(--emp-muted);}
</style>
