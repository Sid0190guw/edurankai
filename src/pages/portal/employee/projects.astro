---
// /portal/employee/projects — THE PROJECTS THIS PERSON IS ACTUALLY ON.
//
// WHAT THIS PAGE IS. Until now there was no answer anywhere in this product to "what am I working
// on": src/lib/search-global.ts returned an honest note saying no projects table existed, and
// src/lib/workforce/navigation.ts carried the same finding in NAV_BACKLOG. This is that answer, on a
// phone, for the person themselves.
//
// THE SCOPE IS IN THE QUERY, NOT ON THE SCREEN. listProjects() resolves this viewer's employee id
// from the SESSION, asks the Organization Graph which projects they run and which departments they
// head, and puts all three into the WHERE clause. A project this person may not see is never read.
// Nothing is hidden with CSS and nothing is filtered after the fact.
//
// AN EMPTY GRAPH IS NOT AN EMPTY PORTFOLIO. Until the founder runs the backfill, org_relationships
// has no rows: nobody runs anything and no department has a head. That is said out loud at the top of
// the page rather than being rendered as "you have no projects", which would tell somebody their work
// does not exist. Membership is this module's own table and keeps working either way, so a project
// somebody has been added to still appears on day one.
//
// THE TIMELINE IS INLINE SVG AND NOTHING ELSE. No charting library, and no separate mobile chart: the
// bar sits UNDER its own label on a full-width track, so the same markup is a Gantt on a laptop and a
// readable dated list on a 360px phone. The page never scrolls sideways.
import { requireEmployee } from '@/lib/auth/workspace-access';
import {
  listProjects,
  allocationFor,
  buildTimeline,
  projectStatusLabel,
  memberCapacityLabel,
  GRAPH_NOT_READY,
  type Project,
} from '@/lib/projects';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/employee/projects');

// -------------------------------------------------------------------------------------------------
// CONSTANTS FIRST. `const` is not hoisted, and a const declared under the handler that reads it
// throws on that handler's first line while the page still reports success — the failure that took
// down apply step 5 and the /admin/roles/diagnose Repair button on this project.
// -------------------------------------------------------------------------------------------------
const PAGE = '/portal/employee/projects';

const fmtDate = (d: string | null) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

/** Plain words from a function, never a typed map read inside JSX — a known .astro parse hazard. */
function chipClass(status: string): string {
  if (status === 'active') return 'chip chip-ok';
  if (status === 'on_hold') return 'chip chip-wait';
  if (status === 'cancelled') return 'chip chip-no';
  if (status === 'completed') return 'chip chip-done';
  return 'chip';
}

function barFill(p: Project): string {
  if (p.isOverdue) return '#b91c1c';
  if (p.status === 'completed') return '#0f766e';
  if (p.status === 'on_hold') return '#a16207';
  if (p.status === 'cancelled' || p.status === 'archived') return '#9a8f7d';
  return '#c2410c';
}

function milestoneLine(p: Project): string {
  if (p.milestoneCount === 0) return 'No milestones set yet';
  return p.milestonesMet + ' of ' + p.milestoneCount + ' milestones met';
}

const gate = await requireEmployee(user, PAGE);
const employeeId = gate.ok ? gate.workspace.employeeId : null;

const view = gate.ok
  // includeClosed, because "what did I work on" is a question somebody asks about a finished project
  // at least as often as a running one. The two are rendered in separate cards, never mixed.
  ? await listProjects(user as any, { includeClosed: true, limit: 200 })
  : { ok: false, graphReady: false, projects: [] as Project[], scope: null as any };

// This person's own commitments, today, across every project they are on — including any this page
// does not list, because a total that excluded them would understate what they have promised.
const allocation = employeeId ? await allocationFor([employeeId]) : null;
const mine = allocation?.people.find((p) => p.employeeId === employeeId) || null;

const timeline = buildTimeline(view.projects.map((p) => ({
  id: p.id,
  label: p.code + ' ' + p.name,
  sublabel: p.statusLabel,
  startOn: p.startOn,
  endOn: p.targetOn,
  status: p.status,
  overdue: p.isOverdue,
})));

const active = view.projects.filter((p) => p.status !== 'completed' && p.status !== 'cancelled' && p.status !== 'archived');
const closed = view.projects.filter((p) => p.status === 'completed' || p.status === 'cancelled' || p.status === 'archived');
---
<!doctype html>
<html lang="en" style="background:#f6f4ef;">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <title>My projects</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:#f6f4ef;font-family:'Inter Tight',system-ui,sans-serif;min-height:100vh;padding-bottom:48px;color:#1a1510;}
    .top{background:#12100c;min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 14px;position:sticky;top:0;z-index:40;}
    .top a{color:#9a8f7d;text-decoration:none;display:flex;align-items:center;gap:6px;font-size:14px;min-height:44px;}
    /* MOBILE FIRST. The base rules are the 360px rules. Nothing may make the PAGE scroll sideways:
       every flex child carries min-width:0, because a flex item defaults to min-width:auto and one
       long unbroken word (a project code, a pasted link) would push the card wider than the phone. */
    .wrap{max-width:720px;margin:0 auto;padding:14px 12px;}
    .card{background:#fff;border:1px solid #ece4d6;border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#9a8f7d;font-weight:700;margin:0 0 10px;}
    .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.32);color:#7c4a03;border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:12px;line-height:1.55;overflow-wrap:anywhere;}
    .bad{background:rgba(220,38,38,.07);border:1px solid rgba(220,38,38,.3);color:#8a1c1c;border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:12px;line-height:1.55;overflow-wrap:anywhere;}
    .item{border-bottom:1px solid #f2ece0;padding:12px 0;}
    .item:last-child{border-bottom:none;}
    .item-top{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;}
    .item-title{font-weight:700;font-size:15px;flex:1 1 160px;min-width:0;overflow-wrap:anywhere;}
    .item-title a{color:#1a1510;text-decoration:none;}
    .item-title a:hover{color:#c2410c;}
    .code{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:#9a8f7d;letter-spacing:.08em;display:block;}
    .meta{font-size:12px;color:#9a8f7d;margin-top:3px;overflow-wrap:anywhere;line-height:1.5;}
    .chip{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:4px 9px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;background:#f1ece1;color:#6b6255;white-space:nowrap;}
    .chip-ok{background:rgba(5,150,105,.12);color:#065f46;}
    .chip-no{background:rgba(220,38,38,.1);color:#9a2c2c;}
    .chip-wait{background:rgba(217,119,6,.12);color:#8a5206;}
    .chip-done{background:rgba(15,118,110,.12);color:#0f766e;}
    .chip-late{background:rgba(220,38,38,.12);color:#9a2c2c;}
    .empty{font-size:13.5px;color:#6b6255;line-height:1.55;}
    .note{font-size:12px;color:#9a8f7d;line-height:1.55;margin-top:8px;overflow-wrap:anywhere;}
    /* THE TIMELINE. One rendering for every width: the label sits ABOVE a full-width track, so a
       narrow screen reads it as a dated list with a bar under each line and never scrolls sideways. */
    .tl{position:relative;margin-top:4px;}
    .tl-axis{position:relative;height:16px;margin-bottom:6px;}
    .tl-axis span{position:absolute;top:0;transform:translateX(-50%);font-family:'JetBrains Mono',monospace;font-size:9px;color:#b3a894;white-space:nowrap;}
    .tl-body{position:relative;}
    .tl-today{position:absolute;top:0;bottom:0;width:1px;background:rgba(194,65,12,.45);z-index:1;}
    .tl-row{position:relative;padding:7px 0;border-bottom:1px solid #f6f1e7;z-index:2;}
    .tl-row:last-child{border-bottom:none;}
    .tl-name{font-size:13px;font-weight:600;overflow-wrap:anywhere;line-height:1.4;}
    .tl-name a{color:#1a1510;text-decoration:none;}
    .tl-dates{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:#9a8f7d;margin:2px 0 4px;}
    .tl-track{display:block;width:100%;height:12px;background:#faf7f1;border-radius:6px;}
    .alloc{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;}
    .alloc-n{font-family:'Fraunces',serif;font-size:30px;font-weight:700;line-height:1;}
    .alloc-over{color:#9a2c2c;}
    .bars{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:8px;}
    .bars li{font-size:13px;color:#3c352c;line-height:1.5;overflow-wrap:anywhere;}
    .pctbar{height:8px;background:#f1ece1;border-radius:4px;overflow:hidden;margin-top:4px;}
    .pctbar i{display:block;height:100%;background:#c2410c;}
    a.link{color:#c2410c;overflow-wrap:anywhere;}
  </style>
</head>
<body>
<nav class="top">
  <a href="/portal/employee">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    My HR
  </a>
  <span style="font-size:15px;font-weight:700;color:#fff;font-family:'Fraunces',serif;">Projects</span>
  <a href="/portal/employee/profile" style="font-size:12px;">Profile</a>
</nav>

<div class="wrap">
  {!gate.ok && (
    <div class="card">
      <h3>{gate.title || 'Not available'}</h3>
      <p class="empty">{gate.reason || 'Your employee record is not available.'}</p>
    </div>
  )}

  {gate.ok && !view.ok && (
    <div class="bad">
      <strong>We could not read your projects just now.</strong>
      <p style="margin-top:6px;">Nothing is lost and nothing has changed. This is a failure to read, not
      a statement that you are on no projects. Try again in a moment.</p>
    </div>
  )}

  {gate.ok && view.ok && !view.graphReady && (
    <div class="warn">
      <strong>Organization Graph not yet initialized.</strong>
      <p style="margin-top:6px;">{GRAPH_NOT_READY}</p>
    </div>
  )}

  {gate.ok && view.ok && mine && mine.overAllocated && (
    <div class="bad">
      <strong>You are committed beyond 100% today.</strong>
      <p style="margin-top:6px;">
        Your project allocations add up to {mine.totalPct}%. Nothing has been changed for you and
        nothing will be: this is a number for you and whoever runs these projects to talk about.
      </p>
    </div>
  )}

  {gate.ok && view.ok && (
    <div class="card">
      <h3>My allocation today</h3>
      <div class="alloc">
        <span class={mine && mine.overAllocated ? 'alloc-n alloc-over' : 'alloc-n'}>{mine ? mine.totalPct : 0}%</span>
        <span class="empty">committed across {mine ? mine.entries.length : 0} project{mine && mine.entries.length === 1 ? '' : 's'}</span>
      </div>
      {mine && mine.entries.length > 0 && (
        <ul class="bars">
          {mine.entries.map((e) => (
            <li>
              <span style="font-weight:600;">{e.projectCode}</span> {e.projectName}
              <span class="meta"> {e.allocationPct}% as {memberCapacityLabel(e.capacity)}{e.toOn ? ' until ' + fmtDate(e.toOn) : ''}</span>
              <span class="pctbar"><i style={'width:' + Math.min(e.allocationPct, 100) + '%;'}></i></span>
            </li>
          ))}
        </ul>
      )}
      {(!mine || mine.entries.length === 0) && (
        <p class="empty" style="margin-top:8px;">
          {allocation && allocation.ok
            ? 'No percentage of your time is recorded against any project. That is a gap in the record, not a claim that you are not busy.'
            : 'Your allocation could not be read just now, so no figure is shown.'}
        </p>
      )}
    </div>
  )}

  {gate.ok && view.ok && view.projects.length > 0 && (
    <div class="card">
      <h3>Timeline</h3>
      <div class="tl">
        <div class="tl-axis">
          {timeline.ticks.map((t) => (<span style={'left:' + t.leftPct + '%;'}>{t.label}</span>))}
        </div>
        <div class="tl-body">
          {timeline.todayPct !== null && (<div class="tl-today" style={'left:' + timeline.todayPct + '%;'}></div>)}
          {timeline.bars.map((b) => {
            const project = view.projects.find((p) => p.id === b.id);
            return (
              <div class="tl-row">
                <div class="tl-name"><a href={'/portal/employee/projects/' + b.id}>{b.label}</a></div>
                <div class="tl-dates">
                  {b.undated
                    ? 'No dates recorded'
                    : (fmtDate(b.startOn) || 'no start') + ' to ' + (fmtDate(b.endOn) || 'no target')}
                </div>
                <svg class="tl-track" width="100%" height="12" role="img"
                     aria-label={b.label + ': ' + (b.undated ? 'no dates recorded' : (b.startOn || 'no start') + ' to ' + (b.endOn || 'no target'))}>
                  <rect x={b.leftPct + '%'} y="1" width={b.widthPct + '%'} height="10" rx="5"
                        fill={b.undated ? '#e0d6c4' : (project ? barFill(project) : '#c2410c')}
                        opacity={b.undated ? '0.7' : '1'}></rect>
                </svg>
              </div>
            );
          })}
        </div>
      </div>
      <p class="note">
        Today is the vertical line. A bar drawn in grey has no dates recorded against it and is shown
        across the whole window rather than left off, because work nobody has scheduled is exactly what
        a timeline is read to find.
      </p>
    </div>
  )}

  {gate.ok && view.ok && (
    <div class="card">
      <h3>In flight</h3>
      {active.length === 0 && (
        <p class="empty">
          {view.graphReady
            ? 'You are not on any project that is currently running. If you should be, ask whoever runs it to add you.'
            : 'Nothing to show here yet. The Organization Graph has not been initialized, so only projects you have been added to as a member can appear.'}
        </p>
      )}
      {active.map((p) => (
        <div class="item">
          <div class="item-top">
            <div class="item-title">
              <span class="code">{p.code}</span>
              <a href={'/portal/employee/projects/' + p.id}>{p.name}</a>
            </div>
            <span class={chipClass(p.status)}>{projectStatusLabel(p.status)}</span>
            {p.isOverdue && <span class="chip chip-late">Past target</span>}
          </div>
          <div class="meta">
            {p.departmentName || 'Department not recorded'}
            {p.targetOn ? ' | target ' + fmtDate(p.targetOn) : ' | no target date'}
            {' | ' + milestoneLine(p)}
            {p.openRiskCount > 0 ? ' | ' + p.openRiskCount + ' open risk' + (p.openRiskCount === 1 ? '' : 's') : ''}
          </div>
        </div>
      ))}
    </div>
  )}

  {gate.ok && view.ok && closed.length > 0 && (
    <div class="card">
      <h3>Finished and closed</h3>
      {closed.map((p) => (
        <div class="item">
          <div class="item-top">
            <div class="item-title">
              <span class="code">{p.code}</span>
              <a href={'/portal/employee/projects/' + p.id}>{p.name}</a>
            </div>
            <span class={chipClass(p.status)}>{projectStatusLabel(p.status)}</span>
          </div>
          <div class="meta">
            {p.actualEndOn ? 'Ended ' + fmtDate(p.actualEndOn) : 'No end date recorded'}
            {p.statusReason ? ' | ' + p.statusReason : ''}
          </div>
        </div>
      ))}
    </div>
  )}
</div>
</body>
</html>
