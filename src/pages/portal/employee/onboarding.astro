---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
// ADDITIVE — the tracked onboarding checklist (src/lib/onboarding-journey.ts). The form below is
// unchanged; this adds the sequence around it, so a joiner can see what is still outstanding, who
// each step is waiting on, and acknowledge the policies they are required to read.
import {
  journeyStatusForEmployee, engagementForEmployee, packDocumentsFor, joiningDocumentsProgress,
  setItemState, acknowledgeItem, stepCategoryLabel, itemStateLabel,
  type JourneyItem,
} from '@/lib/onboarding-journey';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/employee/onboarding'));

function rows(r: any): any[] { return Array.isArray(r) ? r : (r?.rows || []); }

// WHO THIS PAGE IS ALLOWED TO BE ABOUT.
//
// This resolved the employee with
//   WHERE user_id = <session id> OR lower(personal_email) = <session email> OR lower(email) = <session email>
//   LIMIT 1
// and then let the POST handler below write bank_account_number, bank_ifsc, pan_number and
// govt_id_number into whichever row came back. Three facts turn that into salary diversion:
//
//   1. /portal/signup issues a session immediately on insert (signup.astro:128-133) — there is no
//      verification step, so the address on a session proves nothing about who controls it.
//   2. personal_email and email carry no UNIQUE constraint (db/hr-schema.sql:49-50).
//   3. LIMIT 1 with no ORDER BY silently picks one row out of several matches.
//
// Registering with a colleague's personal address therefore returned THEIR employee record, and one
// POST rewrote the bank account that the next payroll run pays into.
//
// The session's user_id is the only identifier a session actually proves, so ownership is resolved
// from that alone. The email fallback stays — a hand-added joiner has no user_id until the people
// desk links them, and removing it would leave them unable to submit anything — but it now matches
// only an UNCLAIMED row, and it refuses rather than guesses when more than one row comes back.
const uid = String(user.id);
const sessionEmail = (user.email || '').toLowerCase().trim();
const claimedByMe = rows(await db.execute(sql`
  SELECT * FROM hr_employees WHERE user_id = ${uid} LIMIT 2`));

// Two records claiming one account is a data fault, and choosing between them would be a coin toss
// over somebody's payroll. Say so and stop.
if (claimedByMe.length > 1) {
  return Astro.redirect('/portal?e=' + encodeURIComponent(
    'More than one employee record is linked to your account. The people desk needs to resolve that before joining details can be submitted.'));
}

let emp: any = claimedByMe[0];
if (!emp && sessionEmail) {
  const unclaimed = rows(await db.execute(sql`
    SELECT * FROM hr_employees
     WHERE user_id IS NULL
       AND (lower(personal_email) = ${sessionEmail} OR lower(email) = ${sessionEmail})
     LIMIT 2`));
  // Exactly one, or none. An ambiguous email match is the same coin toss as above.
  if (unclaimed.length === 1) emp = unclaimed[0];
}
if (!emp) return Astro.redirect('/portal');

// ADDITIVE. Declared BEFORE the POST handler that reads them — `const` is not hoisted, and a
// declaration below its first use throws on the handler's first line while the page reports success.
const ONB_PAGE = '/portal/employee/onboarding';
const itemDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

let msg = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();

  // ADDITIVE BRANCH, AND IT RUNS FIRST. The original form carries no `action` field, so nothing below
  // this point changes behaviour for it: a submission of that form falls straight through. Only the
  // checklist buttons added by this section reach here, and each returns before the credential
  // handler is touched.
  const journeyAction = String(fd.get('action') || '');
  if (journeyAction === 'journey_item' || journeyAction === 'journey_ack') {
    let jflash = '';
    try {
      if (journeyAction === 'journey_ack') {
        const r = await acknowledgeItem(String(fd.get('item_id') || ''), user.id);
        jflash = r.ok
          ? 'Acknowledged. That is recorded against your record with today, and only you could do it.'
          : (r.error || 'The acknowledgement was not recorded.');
      } else {
        const r = await setItemState({
          itemId: String(fd.get('item_id') || ''),
          state: String(fd.get('state') || 'done') as any,
          note: String(fd.get('note') || ''),
          actorUserId: user.id,
          // NOT the people desk. This is the joiner's own page, and setItemState() decides on
          // ownership: they may move their own steps and nobody else's.
          isHrDesk: false,
        });
        jflash = r.ok ? 'Saved.' : (r.error || 'That step was not updated.');
      }
    } catch (e: any) {
      // NEVER SWALLOWED. The real Postgres reason is on e.cause; e.message is only the failed SQL.
      console.error('[portal/employee/onboarding] journey POST', e?.cause?.message || e?.message);
      jflash = 'Nothing was saved: ' + String(e?.cause?.message || e?.message || 'unknown error');
    }
    return Astro.redirect(ONB_PAGE + '?jmsg=' + encodeURIComponent(jflash.slice(0, 300)));
  }

  const bankName = (fd.get('bank_name') as string || '').trim() || null;
  const bankAcc = (fd.get('bank_account_number') as string || '').trim() || null;
  const bankIfsc = (fd.get('bank_ifsc') as string || '').trim().toUpperCase() || null;
  const bankBranch = (fd.get('bank_branch') as string || '').trim() || null;
  const govtIdType = (fd.get('govt_id_type') as string || '').trim() || null;
  const govtIdNumber = (fd.get('govt_id_number') as string || '').trim().toUpperCase() || null;
  const govtIdDoc = (fd.get('govt_id_doc_url') as string || '').trim() || null;
  const nocDoc = (fd.get('noc_doc_url') as string || '').trim() || null;
  const pan = (fd.get('pan_number') as string || '').trim().toUpperCase() || null;
  const emergencyName = (fd.get('emergency_contact_name') as string || '').trim() || null;
  const emergencyPhone = (fd.get('emergency_contact_phone') as string || '').trim() || null;

  // Every onboarding field is OPTIONAL now. The employee can submit what they
  // have; HR fills in or follows up on the rest. This avoids bouncing a new
  // hire on day one because their ID upload didn't pass or the bank app was
  // glitchy. Identity verification is treated like the 2FA scan elsewhere —
  // we never block on missing documents.
  await db.execute(sql`
    UPDATE hr_employees SET
      bank_name = COALESCE(${bankName}, bank_name),
      bank_account_number = COALESCE(${bankAcc}, bank_account_number),
      bank_ifsc = COALESCE(${bankIfsc}, bank_ifsc),
      bank_branch = COALESCE(${bankBranch}, bank_branch),
      govt_id_type = COALESCE(${govtIdType}, govt_id_type),
      govt_id_number = COALESCE(${govtIdNumber}, govt_id_number),
      govt_id_doc_url = COALESCE(${govtIdDoc}, govt_id_doc_url),
      noc_doc_url = COALESCE(${nocDoc}, noc_doc_url),
      pan_number = COALESCE(${pan}, pan_number),
      emergency_contact_name = COALESCE(${emergencyName}, emergency_contact_name),
      emergency_contact_phone = COALESCE(${emergencyPhone}, emergency_contact_phone),
      -- A LATER UPDATE MUST NOT UNDO A DECISION HR HAS ALREADY MADE.
      --
      -- This wrote 'submitted' unconditionally. Once the people desk marked somebody Checked or
      -- Complete on /admin/hr/reconciliation, any further save from this page — a corrected IFSC, a
      -- new emergency number — silently reset them to Submitted, put them back on the "still
      -- onboarding" counts on two analytics screens, and left HR to notice on their own that a
      -- finished onboarding had reopened. The CASE keeps a settled state settled; only a record that
      -- has not been checked yet moves to 'submitted'.
      onboarding_status = CASE
        WHEN onboarding_status IN ('verified', 'complete') THEN onboarding_status
        ELSE 'submitted' END,
      -- COALESCE for the same reason: this column means "when they first sent their joining
      -- details", and a later correction should not rewrite that date.
      onboarding_submitted_at = COALESCE(onboarding_submitted_at, NOW()), updated_at = NOW()
    -- THE OWNERSHIP TEST IS REPEATED AT THE WRITE, not just at the read above.
    -- emp is resolved once when the page renders; this clause is what guarantees that a row
    -- belonging to somebody else cannot be written no matter how it came to be selected. Financial
    -- and government-identity columns are the payload, so the check belongs on the statement that
    -- sets them rather than only on the query that found them.
    WHERE id = ${emp.id} AND (user_id = ${uid} OR user_id IS NULL)
  `);
  if (emp.onboarding_status !== 'verified' && emp.onboarding_status !== 'complete') {
    emp.onboarding_status = 'submitted';
  }
  msg = 'submitted';

  // A WRITE OF BANK AND IDENTITY DETAILS LEAVES A RECORD, AND SOMEBODY IS TOLD IT ARRIVED.
  //
  // This wrote an account number, an IFSC, a PAN and an emergency contact into hr_employees with no
  // audit entry and no notification of any kind. Financial and identity data landed and nobody was
  // told, so nothing prompted anyone to check it before the first payroll run — while reviewDoc(),
  // three files away, explicitly protects the same class of record. The VALUES are never written into
  // the audit diff: what is recorded is which kinds of detail arrived, not the numbers themselves.
  try {
    const { logAudit } = await import('@/lib/audit');
    await logAudit({
      userId: String(user.id), action: 'hr.joining_details_submitted', entity: 'hr_employee',
      entityId: String(emp.id),
      diff: {
        fieldsProvided: [
          bankAcc ? 'bank account' : null, bankIfsc ? 'IFSC' : null, pan ? 'PAN' : null,
          govtIdNumber ? 'government ID' : null,
          (emergencyName || emergencyPhone) ? 'emergency contact' : null,
        ].filter(Boolean),
        onboardingStatus: 'submitted',
      },
    });
  } catch (e: any) {
    console.error('[portal/employee/onboarding] the audit record for joining details was NOT written -', e?.cause?.message || e?.message);
  }

  try {
    const { notifyAllAdmins } = await import('@/lib/notify');
    // IT POINTS AT THE SCREEN WHERE THE ACTION IS.
    //
    // This sent the people desk to /admin/hr/employees/[id], which displays the bank and identity
    // details and offers NO way to record that they have been checked — the only control that writes
    // onboarding_status lives on /admin/hr/reconciliation. So the notification asked somebody to do
    // something on a page where it could not be done, and the joiner stayed on 'submitted'.
    await notifyAllAdmins({
      title: 'Joining details submitted: ' + String(emp.full_name || 'a new joiner'),
      body: 'Bank, identity and emergency contact details are waiting to be checked before their first '
        + 'payroll run. Mark their onboarding Checked or Complete on the reconciliation screen; the '
        + 'full record is at /admin/hr/employees/' + String(emp.id) + '.',
      type: 'hire',
      actionUrl: '/admin/hr/reconciliation',
      entityType: 'hr_employee',
      entityId: String(emp.id),
    });
  } catch (e: any) {
    console.error('[portal/employee/onboarding] the people desk was NOT told the joining details arrived -', e?.cause?.message || e?.message);
  }
}

// THE END STATE COUNTS AS DONE, AND THE PANEL SAYS WHICH STATE IT IS.
//
// This read `'submitted' || 'verified'` and stopped there. 'complete' — the state HR sets on
// /admin/hr/reconciliation, the one that finally stops a person counting as "currently onboarding"
// everywhere — was missing from the list, so the moment the people desk finished somebody's
// onboarding this page threw the blank joining form back at them as though they had never filled it
// in. That is the same complaint the exit was built to answer, reappearing at the far end of it.
//
// The three settled states also read differently to the person in them: waiting to be checked,
// checked, and finished are not one sentence.
const onbState = String(emp.onboarding_status || 'pending');
const done = onbState === 'submitted' || onbState === 'verified' || onbState === 'complete';
const doneHeading = onbState === 'complete' ? 'Onboarding complete'
  : onbState === 'verified' ? 'Your details have been checked'
  : 'Onboarding submitted';
const doneBody = onbState === 'complete'
  ? 'The people desk has signed off your joining details. Nothing further is outstanding. If anything changes, write to '
  : onbState === 'verified'
  ? 'The people desk has read your bank, identity and emergency details and they are right. Anything still outstanding is on the checklist below. To change a detail, write to '
  : 'Thank you. HR will verify your details. You can update them by contacting ';

// THE CHECKLIST, AND THE THREE DIFFERENT REASONS THERE MIGHT NOT BE ONE.
//
// This read journeyForEmployee(), which answers null for a missing row, for a provisioning failure
// and for a SELECT that threw — and the page printed one confident sentence for all three: "No
// onboarding checklist has been started for you yet. That is a genuine not-yet, not an empty screen."
// For two of those three that sentence was false, and it was being told to the one person with no
// other way of finding out. journeyStatusForEmployee() separates them and each is rendered as itself.
const jmsg = new URL(Astro.request.url).searchParams.get('jmsg') || '';
const jstatus = await journeyStatusForEmployee(String(emp.id));
const journey = jstatus.journey;

// WHICH PACK THIS PERSON'S CHECKLIST WOULD BE BUILT FROM, so a joiner and the people desk can both
// see that the right one is about to be used BEFORE anything is started — and so that "not started
// yet" is not the only thing this screen can say. Where nobody has recorded the engagement it says
// exactly that, and names who records it, rather than implying the checklist is merely late.
const engagement = await engagementForEmployee(String(emp.id));
const myItems: JourneyItem[] = journey
  ? journey.items.filter((i) => i.ownerVia === 'the_joiner' || (i.ownerUserId && i.ownerUserId === user.id))
  : [];
const otherItems: JourneyItem[] = journey
  ? journey.items.filter((i) => myItems.indexOf(i) < 0)
  : [];

// A CREDENTIAL THAT WAS SENT BACK IS WHY THE STEP IS STILL OPEN, AND THIS IS WHERE IT SAYS SO.
//
// joiningDocumentsProgress() was written for exactly this — its own comment says it exists "so a
// `documents` step on the checklist and the credentials screen can never disagree" — and it had no
// caller anywhere in src/. So the checklist showed "Submit joining documents" as an open step with
// no numbers and no link, while the real state of those credentials lived on a different screen the
// joiner had no reason to revisit. hr-onboarding's progress() only counts a documents step complete
// when EVERY document is verified and none is rejected, so one bounced credential holds it open
// indefinitely; the joiner is now told that, here, with the way out.
// THE COUNT COMES FROM THE PACK, NOT FROM WHATEVER HAPPENED TO BE UPLOADED.
//
// This printed "0 of 3 verified" — verified against however many links the person had added. The 3
// was not a requirement, it was a coincidence, so it could not tell anybody whether they were
// finished. Worse, the generic list is an employee's list: a contractor reading it would be measured
// against a degree certificate and a relieving letter from a previous employer, which their
// engagement does not ask for and which we would be wrong to hold. The denominator is now the set of
// documents THIS engagement requires, and nothing outside that set is ever named as missing.
const packDocs = engagement.engagementKey
  ? await packDocumentsFor(String(user.id), engagement.engagementKey)
  : null;

// WHERE THE ENGAGEMENT IS NOT RECORDED, THIS SCREEN STILL OWES THE JOINER AN ANSWER ABOUT WHAT THEY
// ALREADY SENT. It cannot say what is still REQUIRED of them, because which documents apply is
// exactly the thing that depends on the engagement, and listing an employee's set at somebody who
// may be a contractor is the mistake in miniature. But "we have three of your links and none is
// verified yet" is true whoever they turn out to be, and leaving it out would replace a misleading
// number with silence about their own submissions. joiningDocumentsProgress() reads hr-onboarding's
// own progress(), so this can never disagree with the credentials screen.
const rawDocs = packDocs ? null : await joiningDocumentsProgress(String(user.id));

const docsBlocked = (!!packDocs && packDocs.rejected > 0) || (!!rawDocs && rawDocs.rejected > 0);
---
<BaseLayout title="Employee onboarding - EduRankAI" description="Complete your employee onboarding.">
  <section class="px-[5vw] py-10 md:py-14 max-w-2xl mx-auto">
    <p class="text-[0.62rem] font-mono uppercase tracking-[0.18em] text-burn font-bold mb-2">Welcome aboard</p>
    <h1 class="font-display text-[clamp(1.7rem,4.5vw,2.4rem)] font-semibold text-ink leading-tight mb-2">Employee onboarding</h1>
    {done ? (
      <p class="text-[0.92rem] text-ink-soft mb-6">Hi <strong class="text-ink">{emp.full_name}</strong> — your joining details are with the people desk. Where you are with them is below, along with anything still outstanding on your checklist.</p>
    ) : (
      <p class="text-[0.92rem] text-ink-soft mb-6">Hi <strong class="text-ink">{emp.full_name}</strong> — your offer is accepted. Fill in what you have right now. Every field below is <strong>optional</strong>; you can come back and update anything later, and HR will follow up directly for anything missing. We never block your start on a document.</p>
    )}

    {done ? (
      <div class="bg-leaf-bg/40 border border-leaf-border rounded-2xl p-6">
        <p class="font-semibold text-leaf mb-1">{doneHeading}</p>
        <p class="text-[0.9rem] text-ink-2">{doneBody}<a href="mailto:hr@edurankai.in" class="text-burn hover:underline">hr@edurankai.in</a>.</p>
        <a href="/portal/employee" class="inline-block mt-4 bg-ink text-white font-semibold py-2.5 px-5 rounded-lg text-[0.88rem] no-underline">Go to employee portal</a>
      </div>
    ) : (
      <form method="POST" id="onbForm" class="flex flex-col gap-5 bg-white border border-ink/10 rounded-2xl p-5 md:p-6">
        {msg && msg !== 'submitted' && <div class="bg-red-500/10 border border-red-500/30 text-red-700 rounded-lg p-3 text-[0.85rem]">{msg}</div>}

        <div>
          <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-2">Banking (for payroll)</p>
          <p class="text-[0.78rem] text-ink-soft mb-2">Optional. Leave blank if you have not opened an account yet and add it later from your profile.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input name="bank_name" placeholder="Bank name" class="onbi" />
            <input name="bank_branch" placeholder="Branch" class="onbi" />
            {/* NOT required. These were the only two required inputs on the form, and they blocked
                onboarding entirely for anyone without an account yet — for an unpaid intern that may
                be everyone, and for a new joiner it is normal in the first week.
                The POST handler above already treats every banking field as optional: each is
                COALESCEd against its existing value, so a blank keeps whatever was stored rather
                than wiping it. The server could always accept a partial submission; only the browser
                was refusing to send one. A missing account is chased at payroll, not at the door. */}
            <input name="bank_account_number" placeholder="Account number" class="onbi" />
            <input name="bank_ifsc" placeholder="IFSC / SWIFT" class="onbi" />
          </div>
        </div>

        <div>
          <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-2">Government identity</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <select name="govt_id_type" class="onbi">
              <option value="aadhaar">Aadhaar</option><option value="pan">PAN</option><option value="passport">Passport</option><option value="voter">Voter ID</option><option value="driving">Driving Licence</option><option value="other">Other</option>
            </select>
            <input name="govt_id_number" placeholder="ID number" class="onbi" />
            <input name="pan_number" placeholder="PAN (for tax)" class="onbi" />
          </div>
          {/* A LINK, NOT AN UPLOAD, AND THE PAGE NOW SAYS ONE THING RATHER THAN THREE.
              This asked for a file. Two hundred lines below it, the credentials panel said "They are
              Google Drive links, not uploads", and the fortnight block said the same again. A new
              joiner read all three on the first screen they ever opened and could not tell which was
              true. Documents of every kind on this platform are Drive links; the only file this
              product stores is the small profile photo captured once for two-factor sign-in.

              THE SHARING SENTENCE IS THE FIELD, not decoration around it. A Drive link that has not
              been shared opens perfectly for the person who pasted it and for nobody else, so it is
              the one failure they cannot detect themselves. It is said here, where the ask is made,
              and not in a policy document nobody has sent them. */}
          <div class="mt-3">
            <label class="block text-[0.72rem] text-ink-soft mb-1" for="govtUrl">Government ID &mdash; Google Drive link</label>
            <input type="url" name="govt_id_doc_url" id="govtUrl" placeholder="https://drive.google.com/file/d/..." class="onbi" />
            <p class="text-[0.72rem] text-ink-soft mt-1 leading-relaxed">
              Put the file in your own Drive, open <strong>Share</strong>, change General access to
              <strong> Anyone with the link</strong>, copy the link and paste it here. The document
              stays in your Drive and you can revoke it at any time. If you skip the sharing step the
              link opens for you and shows HR an access-denied page, and neither of you finds out.
            </p>
          </div>
        </div>

        <div>
          <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-2">NOC / relieving (if applicable)</p>
          <p class="text-[0.78rem] text-ink-soft mb-2 leading-relaxed">
            Only if you are leaving another employer. A first internship has none, and leaving this
            blank holds nothing up.
          </p>
          <label class="block text-[0.72rem] text-ink-soft mb-1" for="nocUrl">Google Drive link</label>
          <input type="url" name="noc_doc_url" id="nocUrl" placeholder="https://drive.google.com/file/d/..." class="onbi" />
          <p class="text-[0.72rem] text-ink-soft mt-1 leading-relaxed">
            Same again: share it as <strong>Anyone with the link</strong> before you paste it.
          </p>
        </div>

        <div>
          <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-2">Emergency contact</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input name="emergency_contact_name" placeholder="Name" class="onbi" />
            <input name="emergency_contact_phone" placeholder="Phone" class="onbi" />
          </div>
        </div>

        <button type="submit" id="onbSubmit" class="bg-burn hover:bg-burn/90 text-white font-semibold py-3 rounded-lg text-[0.92rem]">Submit onboarding</button>
      </form>
    )}

    {/* ================================================================================
        YOUR JOINING CREDENTIALS — the state of them, on the page you are already on.
        ================================================================================ */}
    <div class={docsBlocked
      ? 'mt-8 bg-red-500/5 border border-red-500/30 rounded-2xl p-5'
      : 'mt-8 bg-white border border-ink/10 rounded-2xl p-5'}>
      <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-2">Joining documents</p>
      {packDocs === null ? (
        <div>
          <p class="text-[0.88rem] text-ink-2 leading-relaxed">
            {rawDocs && rawDocs.submitted > 0
              ? 'You have shared ' + rawDocs.submitted + ' document' + (rawDocs.submitted === 1 ? '' : 's')
                + ' so far, of which ' + rawDocs.verified + ' ' + (rawDocs.verified === 1 ? 'has' : 'have')
                + ' been verified'
                + (rawDocs.rejected > 0 ? ' and ' + rawDocs.rejected + ' came back to you' : '') + '.'
              : 'You have not shared any documents yet. They are Google Drive links, not uploads.'}
          </p>
          <p class="text-[0.85rem] text-ink-2 mt-2 leading-relaxed">
            What is still <strong class="text-ink">required</strong> of you cannot be listed yet,
            because the people desk has not recorded what your engagement here is &mdash; and which
            documents apply is exactly the thing that depends on it. Rather than show you an
            employee's list that might not be yours to send, this waits until it can say something
            true. Nothing you have already shared is lost.
          </p>
        </div>
      ) : (
        <div>
          <p class="text-[0.88rem] text-ink-2 leading-relaxed">
            <strong class="text-ink">{packDocs.requiredVerified} of {packDocs.requiredCount}</strong> verified
            {packDocs.rejected > 0 ? ' · ' + packDocs.rejected + ' sent back to you' : ''}
            {packDocs.complete ? ' · nothing outstanding' : ''}
          </p>
          <p class="text-[0.78rem] text-ink-soft mt-1 leading-relaxed">
            Counted against what a {String(packDocs.engagementLabel).toLowerCase()} is actually asked
            for, so you are never told you are short of something your engagement does not need.
          </p>
          <ul class="mt-3 flex flex-col gap-2">
            {packDocs.expected.map((d) => (
              <li class="text-[0.85rem] text-ink-2 leading-relaxed">
                <strong class="text-ink">{d.label}</strong>
                {d.required ? '' : ' (only if it applies to you)'}
                {' — '}
                {d.verified > 0 ? 'verified' : d.rejected > 0 ? 'sent back to you' : d.shared > 0 ? 'with the people desk' : 'not shared yet'}
                <span class="block text-[0.78rem] text-ink-soft">{d.why}</span>
              </li>
            ))}
          </ul>
          {packDocs.missing.length > 0 && (
            <p class="text-[0.85rem] text-ink-2 mt-3 leading-relaxed">
              Still to share: {packDocs.missing.join(', ')}.
            </p>
          )}
          {packDocs.extra > 0 && (
            <p class="text-[0.78rem] text-ink-soft mt-2 leading-relaxed">
              You have also shared {packDocs.extra} document{packDocs.extra === 1 ? '' : 's'} beyond
              what your engagement asks for. They are kept, and they are not counted against you.
            </p>
          )}
        </div>
      )}
      {docsBlocked && (
        <p class="text-[0.85rem] text-ink-2 mt-2 leading-relaxed">
          This step stays open until every credential is verified, so a document that was sent back
          holds it there. The reason is on each one. Share a fresh link and it moves again.
        </p>
      )}
      <a href="/portal/onboarding" class="inline-block mt-3 bg-ink text-white font-semibold py-2.5 px-4 rounded-lg text-[0.85rem] no-underline min-h-[44px]">Open my joining documents</a>
    </div>

    {/* ================================================================================
        ADDITIVE — YOUR FIRST FORTNIGHT.
        The form above collects your details. This is everything else that has to happen,
        who each part is waiting on, and when it is due. Steps owned by somebody else are
        shown read-only so you can see what is coming rather than wondering.
        ================================================================================ */}
    <div class="mt-10">
      <h2 class="font-display text-[1.15rem] font-semibold text-ink mb-1">Your first fortnight</h2>

      {jmsg && (
        <div class="bg-leaf-bg/40 border border-leaf-border rounded-lg p-3 text-[0.85rem] text-ink-2 mb-4">{jmsg}</div>
      )}

      {!journey ? (
        <div class="bg-white border border-ink/10 rounded-2xl p-5">
          {jstatus.state === 'unavailable' ? (
            <p class="text-[0.9rem] text-ink-2 leading-relaxed">{jstatus.reason}</p>
          ) : (
            <p class="text-[0.9rem] text-ink-2 leading-relaxed">
              No onboarding checklist has been started for you yet. That is a genuine "not yet", not an
              empty screen: the people desk starts one and it appears here with every step, who owns it
              and when it is due. Nothing is waiting on you in the meantime beyond the form above.
            </p>
          )}

          {/* WHICH CHECKLIST IT WOULD BE. What is asked of a permanent employee and what is asked of
              an independent contractor are different lists, because a checklist is a record of the
              relationship — so the engagement is named here BEFORE anything is started, and both the
              joiner and the people desk can see the right pack is about to be used. */}
          {engagement.engagementLabel ? (
            <div class="mt-4 pt-4 border-t border-ink/10">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-1">Which checklist</p>
              <p class="text-[0.88rem] text-ink-2 leading-relaxed">
                It would be built as the checklist for
                <strong class="text-ink"> {String(engagement.engagementLabel).toLowerCase()}</strong>.
                {engagement.packSummary ? ' ' + engagement.packSummary : ''}
              </p>
            </div>
          ) : (
            <div class="mt-4 pt-4 border-t border-ink/10">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-1">Which checklist</p>
              <p class="text-[0.88rem] text-ink-2 leading-relaxed">
                It cannot be built yet, because nobody has recorded what your engagement here is. That
                is not a delay on your side and there is nothing for you to send: the people desk
                records it, and until they do, no checklist is assembled from a guess. What is asked of
                a permanent employee and what is asked of a contractor are genuinely different lists,
                and giving everybody the same one would put things on your record that were never true
                of you.
              </p>
            </div>
          )}
        </div>
      ) : (
        <div class="flex flex-col gap-4">
          <div class="bg-white border border-ink/10 rounded-2xl p-5">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <p class="text-[0.9rem] text-ink-2">
                <strong class="text-ink">{journey.progress.done} of {journey.progress.total}</strong> done
                {journey.progress.overdue > 0 ? ' · ' + journey.progress.overdue + ' past its date' : ''}
              </p>
              <p class="text-[0.8rem] text-ink-soft">{journey.progress.percent}%</p>
            </div>
            <div class="mt-3 h-1.5 rounded-full bg-ink/10 overflow-hidden">
              <div class="h-full bg-leaf" style={'width:' + journey.progress.percent + '%;'}></div>
            </div>
            {journey.engagementLabel && (
              <p class="text-[0.8rem] text-ink-soft mt-3 leading-relaxed">
                Built as the checklist for {String(journey.engagementLabel).toLowerCase()}. Steps that
                do not belong to that engagement are not on it, which is why this list may be shorter
                than a colleague's.
              </p>
            )}
            {journey.progress.unowned > 0 && (
              <p class="text-[0.8rem] text-ink-soft mt-3 leading-relaxed">
                {journey.progress.unowned} step{journey.progress.unowned === 1 ? ' has' : 's have'} no
                owner recorded yet. Each one says why below. HR can see the same thing, so it is not
                something you need to chase.
              </p>
            )}
          </div>

          {myItems.length > 0 && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-3">Yours to do</p>
              <div class="flex flex-col gap-4">
                {myItems.map((i: JourneyItem) => (
                  <div class="border-b border-ink/8 pb-4 last:border-0 last:pb-0">
                    <p class="text-[0.95rem] font-semibold text-ink leading-snug">{i.title}</p>
                    <p class="text-[0.75rem] text-ink-soft mt-1">
                      {stepCategoryLabel(i.category)}
                      {i.dueOn ? ' · due ' + itemDate(i.dueOn) : ''}
                      {i.overdue ? ' · past its date' : ''}
                      {' · '}{itemStateLabel(i.state)}
                    </p>
                    {i.description && <p class="text-[0.85rem] text-ink-2 mt-2 leading-relaxed">{i.description}</p>}
                    {i.readingUrl && (
                      <p class="text-[0.85rem] mt-2">
                        <a href={i.readingUrl} target="_blank" rel="noopener noreferrer" class="text-burn hover:underline">Open the document</a>
                      </p>
                    )}
                    {i.note && <p class="text-[0.8rem] text-ink-soft mt-2">{i.note}</p>}
                    {/* A step the pack withheld and somebody created anyway carries the reason, and
                        it is shown to the person it was created for. They are the one it is about. */}
                    {i.addedDespiteReason && (
                      <p class="text-[0.78rem] text-ink-soft mt-2 leading-relaxed">{i.addedDespiteReason}</p>
                    )}

                    {i.state !== 'done' && i.requiresAcknowledgement && (
                      <form method="POST" class="mt-3">
                        <input type="hidden" name="action" value="journey_ack" />
                        <input type="hidden" name="item_id" value={i.id} />
                        <button type="submit" class="bg-ink text-white font-semibold py-2.5 px-4 rounded-lg text-[0.85rem] min-h-[44px]">
                          I have read and I acknowledge this
                        </button>
                        <p class="text-[0.75rem] text-ink-soft mt-2 leading-relaxed">
                          Only you can press this. It records that you, on today's date, read that
                          document, so nobody can record it on your behalf.
                        </p>
                      </form>
                    )}

                    {i.state !== 'done' && !i.requiresAcknowledgement && (
                      <form method="POST" class="mt-3 flex flex-wrap gap-2 items-center">
                        <input type="hidden" name="action" value="journey_item" />
                        <input type="hidden" name="item_id" value={i.id} />
                        <button type="submit" name="state" value="done" class="bg-ink text-white font-semibold py-2.5 px-4 rounded-lg text-[0.85rem] min-h-[44px]">
                          Mark done
                        </button>
                      </form>
                    )}

                    {i.acknowledgedAt && (
                      <p class="text-[0.78rem] text-leaf mt-2">Acknowledged {itemDate(i.acknowledgedAt)}.</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {otherItems.length > 0 && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <p class="text-[0.7rem] font-bold uppercase tracking-wider text-burn mb-1">Waiting on somebody else</p>
              <p class="text-[0.8rem] text-ink-soft mb-3 leading-relaxed">
                Nothing here is yours to do. It is listed so you know what is coming and who has it.
              </p>
              <div class="flex flex-col gap-3">
                {otherItems.map((i: JourneyItem) => (
                  <div class="flex items-start justify-between gap-3 flex-wrap">
                    <div class="min-w-0">
                      <p class="text-[0.9rem] text-ink font-medium leading-snug">{i.title}</p>
                      <p class="text-[0.75rem] text-ink-soft mt-1">
                        {i.ownerName ? i.ownerName : 'No owner recorded yet'}
                        {i.dueOn ? ' · due ' + itemDate(i.dueOn) : ''}
                      </p>
                      {i.ownerUnresolvedReason && (
                        <p class="text-[0.75rem] text-ink-soft mt-1 leading-relaxed">{i.ownerUnresolvedReason}</p>
                      )}
                    </div>
                    <span class="text-[0.7rem] font-semibold uppercase tracking-wide text-ink-soft whitespace-nowrap">
                      {itemStateLabel(i.state)}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="bg-white border border-ink/10 rounded-2xl p-5">
            {/* THE LINK CALLED "Joining documents" WENT TO THE COMPANY DOCUMENT LIBRARY.
                Two labels forty lines apart on this one page - "Open my joining documents" and
                "Joining documents" - pointed at two different screens, and the second one landed a
                new joiner on the shared policy shelf, which on day one reads "Nothing here yet".
                They conclude their documents were lost. Each link now says where it goes. */}
            <p class="text-[0.85rem] text-ink-2 leading-relaxed">
              Your joining documents are submitted separately, as Google Drive links that stay in your
              own Drive. Nothing is uploaded and nothing is stored here.
            </p>
            <p class="text-[0.85rem] mt-2">
              <a href="/portal/onboarding" class="text-burn hover:underline">Share and track your joining documents</a>
              <span class="text-ink-soft"> &middot; </span>
              <a href="/portal/employee/documents" class="text-burn hover:underline">Company document library</a>
              <span class="text-ink-soft"> &middot; </span>
              <a href="/portal/employee/benefits" class="text-burn hover:underline">Your benefits</a>
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <style>.onbi { width:100%;padding:9px 12px;background:var(--cream-2,#f6f3ec);border:1px solid rgba(0,0,0,0.12);border-radius:8px;font-size:0.9rem;outline:none; } .onbi:focus { border-color:#FF4F00; }</style>
  {/* THE UPLOAD PATH IS GONE, and with it about sixty lines of client-side image compression whose
      only purpose was squeezing a phone photo of somebody's Aadhaar under a 4.5 MB request cap.
      That was paid storage of another person's identity document, held for as long as the platform
      runs. Documents are Drive links now: nothing to compress, nothing to store.

      What remains does the one thing a plain input cannot - tell somebody, as they paste, that an
      unshared Drive link will open for THEM and for nobody else. It is a courtesy check only. The
      field submits whatever is typed, every field here is optional, and the server does not trust
      the input either way. */}
  <script is:inline>
    (function () {
      function hint(input) {
        if (!input) return;
        var note = document.createElement('p');
        note.className = 'text-[0.72rem] mt-1 leading-relaxed';
        note.style.display = 'none';
        input.parentNode.appendChild(note);

        function check() {
          var v = (input.value || '').trim();
          if (!v) { note.style.display = 'none'; return; }
          if (/^https:\/\/(drive|docs)\.google\.com\//i.test(v)) {
            note.textContent = 'That looks like a Drive link. Check that sharing is set to "Anyone with the link" - it opens for you either way, which is the one thing you cannot test yourself.';
            note.style.color = '#6b6255';
          } else if (/^https?:\/\//i.test(v)) {
            note.textContent = 'That is a link, but not a Google Drive one. Paste the Drive link so the people desk can open it.';
            note.style.color = '#b45309';
          } else {
            note.textContent = 'That does not look like a link yet. Paste the full https:// address from Drive.';
            note.style.color = '#b45309';
          }
          note.style.display = '';
        }
        input.addEventListener('input', check);
        input.addEventListener('blur', check);
        check();
      }
      hint(document.getElementById('govtUrl'));
      hint(document.getElementById('nocUrl'));
      // No blocking submit handler. Every field is optional - the form submits whatever the joiner
      // has filled in, and the people desk follows up on the rest.
    })();
  </script>
</BaseLayout>
