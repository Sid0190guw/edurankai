---
// /portal/employee/credits — THE PERSON'S OWN WEEKS, AND WHY EACH ONE COUNTS OR DOES NOT.
//
// =================================================================================================
// WHAT THIS SCREEN IS FOR
// =================================================================================================
//
// One credit is one completed week. This page shows every elapsed week: the hours MEASURED against
// the hours REQUIRED, whether the daily reports were filed and the work due that week was done, and
// whether the week is credited, waiting on somebody, or could not be measured at all.
//
// IT MUST BE RECONCILABLE AGAINST THE PERSON'S OWN WEEK. A figure somebody cannot check is the
// complaint that started all of this. So every week opens onto the evidence the verdict was recorded
// with, the required figure says where it came from, and a week that fell short says which of the
// tests it fell short on.
//
// =================================================================================================
// THREE DIFFERENT FACTS, NEVER ONE NUMBER
// =================================================================================================
//
//   EARNED           the hours were there and the week was complete. Granted automatically. Nobody
//                    clicked anything and the record carries what it was granted on.
//   WAITING          the measurement did not fully support the week. Not granted and NOT refused.
//                    A reporting manager, HR or somebody above them decides it with a reason.
//   NOT MEASURABLE   a day was clocked in and never clocked out. That is not zero hours and not a
//                    full day. It is named, and it is why a person decides that week.
//
// THIS PAGE HAS NO APPROVE BUTTON AND NO WAY TO REACH ONE. Nobody decides their own week. The
// approver's queue is a different screen and the engine re-checks authority at the write.
//
// RECONCILING ON READ IS DELIBERATE. reconcileCreditWeeks() measures the elapsed weeks and records
// what it finds; syncCreditDecisions() picks up decisions taken on the generic /portal/approvals
// queue; routePendingCreditWeeks() puts shortfall weeks in front of the person the org graph names.
// All three are idempotent, and a credit that only appeared when somebody remembered to run a job is
// a credit an intern would be told they do not have.
//
// MOBILE FIRST: every week is its own block, 44px targets, nothing scrolls sideways at 360px.
import { requireEmployee } from '@/lib/auth/workspace-access';
import {
  reconcileCreditWeeks,
  syncCreditDecisions,
  routePendingCreditWeeks,
  type ReconcileResult,
} from '@/lib/credit-week-ledger';
import { describeEvidence, positionFrom, weekLabel } from '@/lib/credit-week';
import {
  creditsLabel, hoursLabel, stateLabel, stateTone,
  CREDIT_UNIT_SENTENCE, INTERN_WEEK_SENTENCE, CREDIT_AUTOMATIC_SENTENCE,
  CREDIT_THREE_FACTS_SENTENCE, CREDIT_SCOPE_SENTENCE,
} from '@/lib/credit-week-copy';

const PATH = '/portal/employee/credits';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);
const workspace = gate.ok ? gate.workspace : null;
const employeeId = workspace ? workspace.employeeId : '';

let result: ReconcileResult | null = null;
let routeNote = '';
if (employeeId) {
  // Decisions first: a week settled on the generic approvals queue must not be re-measured as if it
  // were still open. Then measure, then route what still needs a person.
  await syncCreditDecisions(employeeId);
  result = await reconcileCreditWeeks(employeeId, { maxWeeks: 52 });
  if (result.ok && result.applicable && result.pending > 0) {
    const routed = await routePendingCreditWeeks(employeeId, String(user.id));
    if (routed.halted.length) {
      routeNote = routed.halted[0].reason;
    } else if (!routed.ok && routed.error) {
      routeNote = routed.error;
    }
  }
}

const weeks = result ? result.weeks : [];
const position = positionFrom(weeks);
const notMeasurable = weeks.filter(
  (w) => !!w.evidence && Array.isArray(w.evidence.incompleteDates) && w.evidence.incompleteDates.length > 0,
).length;
---
<!doctype html>
<html lang="en" style="background:#F8F8F6;">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>Weekly credits - EduRankAI</title>
  <style>
    *{box-sizing:border-box}
    html,body{overflow-x:hidden;}
    body{margin:0;background:#F8F8F6;color:#1B1813;padding-bottom:96px;
      font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
      -webkit-text-size-adjust:100%;}
    .topbar{position:sticky;top:0;z-index:20;background:#FDFDFC;border-bottom:1px solid #DFDCD8;padding:14px 16px 10px;}
    .topbar h1{margin:0;font-size:1rem;font-weight:700;letter-spacing:-0.01em;}
    .topbar p{margin:4px 0 0;font-size:0.75rem;line-height:1.5;color:#564E43;}
    .tabs{display:flex;gap:6px;overflow-x:auto;padding:10px 16px 2px;margin:0;}
    .tab{flex:none;display:inline-flex;align-items:center;min-height:36px;padding:7px 12px;border:1px solid #DFDCD8;
      border-radius:999px;background:#FDFDFC;color:#564E43;font-size:0.8125rem;font-weight:600;text-decoration:none;white-space:nowrap;}
    .tab[aria-current="page"]{background:#1B1813;border-color:#1B1813;color:#FFFFFF;}
    .wrap{max-width:760px;margin:0 auto;padding:12px 12px 0;}
    .card{margin:12px 0 0;padding:13px;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;}
    .card h2{margin:0 0 6px;font-size:0.9375rem;font-weight:680;line-height:1.35;}
    .card p{margin:0;font-size:0.8125rem;line-height:1.55;color:#564E43;overflow-wrap:anywhere;}
    .card p + p{margin-top:8px;}
    .bad{margin:12px 0 0;padding:10px 12px;border:1px solid #EFCFCB;border-radius:10px;background:#FDF3F2;font-size:0.8125rem;line-height:1.55;color:#8A2C21;}
    .notice{margin:12px 0 0;padding:10px 12px;border:1px solid #EADECD;border-radius:10px;background:#FBF7F1;font-size:0.8125rem;line-height:1.55;color:#6D470D;}
    .tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:12px 0 0;}
    .tile{padding:11px 12px;border:1px solid #DFDCD8;border-radius:10px;background:#FDFDFC;}
    .tile b{display:block;font-size:1.25rem;font-weight:700;line-height:1.2;font-variant-numeric:tabular-nums;}
    .tile span{display:block;margin-top:3px;font-size:0.6875rem;line-height:1.4;color:#70685C;text-transform:uppercase;letter-spacing:0.04em;}
    .week{margin:10px 0 0;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;overflow:hidden;}
    .week > summary{list-style:none;cursor:pointer;padding:12px;min-height:44px;}
    .week > summary::-webkit-details-marker{display:none;}
    .whead{display:flex;flex-wrap:wrap;align-items:center;gap:8px;}
    .whead b{font-size:0.875rem;font-weight:680;}
    .chip{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;border:1px solid;font-size:0.6875rem;font-weight:700;white-space:nowrap;}
    .wline{margin:6px 0 0;font-size:0.8125rem;line-height:1.55;color:#564E43;overflow-wrap:anywhere;}
    .wbody{padding:0 12px 12px;border-top:1px solid #EFEDEA;}
    .kv{display:grid;grid-template-columns:1fr auto;gap:4px 10px;margin:10px 0 0;font-size:0.8125rem;}
    .kv dt{color:#70685C;}
    .kv dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;font-weight:650;}
    .list{list-style:none;margin:10px 0 0;padding:0;}
    .list li{padding:8px 10px;border:1px solid #EFEDEA;border-radius:8px;background:#FCFBFA;margin-bottom:6px;font-size:0.8125rem;line-height:1.5;overflow-wrap:anywhere;}
    .foot{margin:16px 0 0;padding:12px 2px;border-top:1px solid #DFDCD8;font-size:0.75rem;line-height:1.6;color:#70685C;}
  </style>
</head>
<body>
  <header class="topbar">
    <h1>Weekly credits</h1>
    <p>{workspace ? workspace.fullName : 'Your weeks'}</p>
  </header>

  <nav class="tabs" aria-label="Time">
    <a class="tab" href="/portal/employee/attendance">Attendance</a>
    <a class="tab" href="/portal/employee/timesheet">Timesheet</a>
    <a class="tab" href={PATH} aria-current="page">Credits</a>
    <a class="tab" href="/portal/employee/credits/approvals">Waiting on me</a>
    <a class="tab" href="/portal/employee/leave">Leave</a>
  </nav>

  <main class="wrap">
    {!gate.ok && (
      <section class="card">
        <h2>{gate.title || 'This screen is not available'}</h2>
        <p>{gate.reason || 'Your employee record is what this screen is built from.'}</p>
      </section>
    )}

    {gate.ok && result && !result.ok && (
      <div class="bad">
        <strong>These are not measurements.</strong>
        <span> {result.error || 'Your weekly credit record could not be read just now.'} Every figure
        on this page reads as zero when that happens, which looks exactly like a person who did
        nothing. Nothing has been credited or refused on the strength of it, and nothing you have
        logged is lost.</span>
      </div>
    )}

    {gate.ok && result && result.ok && result.unread.length > 0 && (
      <div class="notice">
        <strong>Part of the week could not be read: {result.unread.join(', ')}.</strong>
        <span> A verdict is never built on a silent gap, so any week affected is left waiting for a
        person rather than counted or discounted.</span>
      </div>
    )}

    {gate.ok && result && result.ok && !result.applicable && (
      <section class="card">
        <h2>Weekly credits are not measured for this engagement</h2>
        <p>{result.notApplicableReason || 'Hours are not the certified deliverable on this engagement.'}</p>
        <p>{CREDIT_SCOPE_SENTENCE}</p>
      </section>
    )}

    {gate.ok && result && result.ok && result.applicable && (
      <>
        <section class="card">
          <h2>{creditsLabel(position.credits)} so far</h2>
          <p>{CREDIT_UNIT_SENTENCE} {INTERN_WEEK_SENTENCE}</p>
          <p>{CREDIT_AUTOMATIC_SENTENCE}</p>
        </section>

        <div class="tiles">
          <div class="tile">
            <b>{position.earnedAutomatically}</b>
            <span>Earned automatically</span>
          </div>
          <div class="tile">
            <b>{position.approvedByPerson}</b>
            <span>Credited by decision</span>
          </div>
          <div class="tile">
            <b>{position.pending}</b>
            <span>Waiting on a decision</span>
          </div>
          <div class="tile">
            <b>{notMeasurable}</b>
            <span>Weeks not measurable</span>
          </div>
        </div>

        {routeNote && (
          <div class="notice">
            <strong>A week is waiting on nobody.</strong>
            <span> {routeNote} Until that relationship is recorded in the organization graph, that
            week cannot be decided by anyone. It is not lost and it has not been refused - tell HR,
            and it resumes from where it stopped.</span>
          </div>
        )}

        {notMeasurable > 0 && (
          <div class="notice">
            <strong>Some weeks could not be measured in full.</strong>
            <span> {CREDIT_THREE_FACTS_SENTENCE} The days concerned are named inside each week below.
            Fixing one is an attendance correction on /portal/employee/attendance, not a re-entry here.</span>
          </div>
        )}

        {weeks.length === 0 && (
          <section class="card">
            <h2>No finished week yet</h2>
            <p>{result.notApplicableReason || 'Weeks appear here once one has run its course and there is attendance to measure.'}</p>
          </section>
        )}

        {weeks.map((w) => (
          <details class="week">
            <summary>
              <div class="whead">
                <b>{w.label || weekLabel(w.weekStart)}</b>
                <span class="chip" style={'background:' + stateTone(w.state).bg + ';color:' + stateTone(w.state).fg + ';border-color:' + stateTone(w.state).bd + ';'}>
                  {stateLabel(w.state)}
                </span>
              </div>
              <p class="wline">
                {hoursLabel(w.hoursMeasured)} measured of {hoursLabel(w.hoursRequired)} required
                {' · reports ' + w.reportsFiled + '/' + w.reportsExpected}
                {' · tasks ' + w.tasksCompleted + '/' + w.tasksAssigned}
              </p>
            </summary>

            <div class="wbody">
              {w.decisionReason && (
                <div class="notice" style="margin-top:10px;">
                  <strong>
                    {w.decidedByName ? 'Decided by ' + w.decidedByName : 'Decision recorded'}
                    {w.decidedAt ? ' on ' + String(w.decidedAt).slice(0, 10) : ''}.
                  </strong>
                  <span> {w.decisionReason}</span>
                </div>
              )}

              {w.haltReason && w.state === 'pending' && (
                <div class="bad" style="margin-top:10px;">
                  <strong>This week is waiting on nobody.</strong>
                  <span> {w.haltReason}</span>
                </div>
              )}

              <dl class="kv">
                <dt>Hours measured</dt><dd>{hoursLabel(w.hoursMeasured)}</dd>
                <dt>From check-in and check-out</dt><dd>{hoursLabel(w.evidence ? w.evidence.hoursFromClock : null)}</dd>
                <dt>From recorded entries</dt><dd>{hoursLabel(w.evidence ? w.evidence.hoursFromRecorded : null)}</dd>
                <dt>Hours required this week</dt><dd>{hoursLabel(w.hoursRequired)}</dd>
                <dt>Leave and holidays excused</dt><dd>{w.evidence ? w.evidence.excusedDays : 0} day(s)</dd>
                <dt>Daily reports filed</dt><dd>{w.reportsFiled} of {w.reportsExpected}</dd>
                <dt>Work due that week done</dt><dd>{w.tasksCompleted} of {w.tasksAssigned}</dd>
              </dl>

              <p class="wline" style="margin-top:12px;font-weight:650;color:#1B1813;">What this rests on</p>
              <ul class="list">
                {describeEvidence(w.evidence).map((line: string) => <li>{line}</li>)}
              </ul>

              {w.evidence && w.evidence.incompleteDates.length > 0 && (
                <p class="wline" style="color:#8A2C21;">
                  Clocked in and never clocked out on {w.evidence.incompleteDates.join(', ')}. Those
                  hours are unknown, not zero, which is why this week cannot credit itself.
                </p>
              )}
            </div>
          </details>
        ))}

        <p class="foot">
          {CREDIT_SCOPE_SENTENCE} A week you believe you worked but which reads short here is exactly
          what the decision path is for: it goes to your reporting manager, who credits it with a
          written reason that is stored beside the week and can still be read months later.
        </p>
      </>
    )}
  </main>
</body>
</html>
