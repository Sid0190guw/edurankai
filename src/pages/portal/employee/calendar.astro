---
// /portal/employee/calendar — ONE CALENDAR, SIX VIEWS, SEVEN SOURCES.
//
// =================================================================================================
// WHAT THIS PAGE IS
// =================================================================================================
//
// Personal, team, department, meeting, holiday and training, on one surface. Every row is read live
// from the system that already owns it — hr_attendance, hr_leave_request, hr_roster_assignments,
// hr_holidays, employee_tasks, meet_rooms, live_classes — and nothing is copied into a calendar
// table of its own. src/lib/workforce/navigation.ts recorded "ABSENT FOR STAFF" against a calendar
// because no shift, roster or holiday table existed; those now exist, and this is the surface.
//
// =================================================================================================
// SCOPING HAPPENS IN THE QUERY
// =================================================================================================
//
// The team and department views are scoped from the ORGANIZATION GRAPH — direct reports, and the
// departments the graph records this person as heading — resolved by the same function
// /portal/organization scopes itself with, so the two surfaces cannot disagree about who you may
// see. Never users.role, never a job title, and no fallback when the graph is empty: the honest
// render is "Organization Graph not yet initialized", which is the ordinary first screen until the
// founder runs db/org-graph-backfill.sql.
//
// A team row carries a name, that the person is away, and the leave type. Not the reason, not a
// medical detail, and not another person's hours minute by minute. A manager needs to know who is
// in on Thursday.
//
// =================================================================================================
// NO POST HANDLER, DELIBERATELY
// =================================================================================================
//
// This page reads. The view and the month live in the URL, so the state is shareable and survives a
// back button, and there is no handler above the declarations to reach a const early — the
// const-hoisting trap that has taken pages down on this project.
//
// CLIENT JAVASCRIPT: NONE. Not a byte. Month navigation is two links and the day list is markup.
// MOBILE FIRST: 360px, 44px targets, the day list is a single column and nothing scrolls sideways.
import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
import EmptyState from '@/components/workforce/EmptyState.astro';
import { composeWorkspace } from '@/lib/workforce/composer';
// The month this calendar opens on is a civil date in IST, not a UTC slice. See `anchor` below.
import { civilToday } from '@/lib/page-safety';
import {
  CALENDAR_VIEWS,
  parseCalendarView,
  buildCalendar,
  monthWindow,
  shiftMonth,
  monthLabel,
  SOURCE_LABELS,
  type CalendarViewKey,
} from '@/lib/calendar-hub';

const PATH = '/portal/employee/calendar';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

// ------------------------------------------------------------------------------------------------
// EVERY CONST BEFORE ITS FIRST USE. There is no handler here, and the discipline holds anyway.
// ------------------------------------------------------------------------------------------------

/** Plain words, from a function: a Record<string,string> read inside JSX is an .astro parse hazard. */
function sourceLabel(key: string): string {
  if (key === 'attendance') return SOURCE_LABELS.attendance;
  if (key === 'leave') return SOURCE_LABELS.leave;
  if (key === 'roster') return SOURCE_LABELS.roster;
  if (key === 'holiday') return SOURCE_LABELS.holiday;
  if (key === 'task') return SOURCE_LABELS.task;
  if (key === 'meeting') return SOURCE_LABELS.meeting;
  if (key === 'training') return SOURCE_LABELS.training;
  return '';
}

const dayNumber = (iso: string) => (iso ? String(Number(iso.slice(8, 10))) : '');

// One composition per request; composeWorkspace memoises on Astro.locals, so the nav, the widgets
// and this calendar were all decided from the same answer.
let composed: any = null;
try {
  composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
} catch (e: any) {
  console.error('[portal/calendar] compose', e?.cause?.message || e?.message);
}

const holds = (key: string): boolean => {
  try {
    return composed?.context?.holds ? composed.context.holds(key) === true : false;
  } catch {
    return false;
  }
};

const ctx = composed?.context || null;

const params = Astro.url.searchParams;
const view: CalendarViewKey = parseCalendarView(params.get('view'));
const monthParam = String(params.get('m') || '').trim();
// WHICH MONTH THE CALENDAR OPENS ON IS A DAY BOUNDARY, AND THIS PROCESS IS UTC.
// On the 1st of any month, between 00:00 and 05:29 IST, `new Date().toISOString().slice(0,10)` still
// names the last day of the PREVIOUS month — so the leave and attendance calendar opened on the
// wrong month for the people whose month had already started.
const anchor = /^\d{4}-\d{2}-\d{2}$/.test(monthParam) ? monthParam : civilToday();
// Named `range` rather than `window`, which would shadow a global and read as a browser object on
// a page that renders on the server.
const range = monthWindow(anchor);

const model = await buildCalendar(
  view,
  {
    userId: String(user.id),
    employeeId: ctx?.employeeId ?? null,
    departmentId: ctx?.departmentId ?? null,
    holds,
  },
  range,
);

const hrefFor = (v: string) => PATH + '?view=' + encodeURIComponent(v) + '&m=' + encodeURIComponent(anchor);
const prevHref = PATH + '?view=' + encodeURIComponent(view) + '&m=' + encodeURIComponent(shiftMonth(anchor, -1));
const nextHref = PATH + '?view=' + encodeURIComponent(view) + '&m=' + encodeURIComponent(shiftMonth(anchor, 1));

const daysWithEvents = model.days.filter((d) => d.events.length > 0);
const unavailableSources = model.sources.filter((s) => !s.available);
const emptySourceNotes = model.sources.filter((s) => s.available && s.note);
---

<!doctype html>
<html lang="en" style="background:#F8F8F6;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Calendar - EduRankAI</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;background:#F8F8F6;color:#1B1813;padding-bottom:96px;
      font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
      -webkit-text-size-adjust:100%;}
    html,body{overflow-x:hidden;}
    .topbar{position:sticky;top:0;z-index:20;background:#FDFDFC;border-bottom:1px solid #DFDCD8;
      padding:14px 16px 10px;}
    .topbar h1{margin:0;font-size:1rem;font-weight:700;letter-spacing:-0.01em;}
    .topbar p{margin:4px 0 0;font-size:0.75rem;line-height:1.5;color:#564E43;}
    .tabs{display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;
      padding:10px 16px 2px;margin:0;scrollbar-width:thin;}
    .tab{flex:none;display:inline-flex;align-items:center;min-height:36px;padding:7px 12px;
      border:1px solid #DFDCD8;border-radius:999px;background:#FDFDFC;color:#564E43;
      font-size:0.8125rem;font-weight:600;text-decoration:none;white-space:nowrap;}
    .tab[aria-current="page"]{background:#1B1813;border-color:#1B1813;color:#FFFFFF;}
    .tab:focus-visible{outline:2px solid #6F52E5;outline-offset:2px;}
    .wrap{max-width:760px;margin:0 auto;padding:12px 12px 0;}
    .monthnav{display:flex;align-items:center;gap:8px;margin:12px 0 0;}
    .monthnav a{flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;
      min-height:44px;padding:10px 12px;border:1px solid #DFDCD8;border-radius:8px;background:#FDFDFC;
      color:#564E43;font-size:0.8125rem;font-weight:600;text-decoration:none;}
    .monthnav b{flex:2 1 auto;text-align:center;font-size:0.9375rem;}
    .blurb{margin:10px 0 0;font-size:0.8125rem;line-height:1.55;color:#564E43;}
    .notice{margin:12px 0 0;padding:10px 12px;border:1px solid #EADECD;border-radius:10px;
      background:#FBF7F1;font-size:0.8125rem;line-height:1.55;color:#6D470D;}
    .day{margin:10px 0 0;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;overflow:hidden;}
    .day--today{border-color:#1B1813;}
    .day__head{display:flex;align-items:baseline;gap:8px;padding:9px 13px;border-bottom:1px solid #EFEDE9;}
    .day__num{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:1.0625rem;
      font-weight:700;line-height:1.2;}
    .day__name{font-size:0.75rem;color:#70685C;}
    .day__today{margin-left:auto;font-size:0.6875rem;font-weight:700;letter-spacing:0.06em;
      text-transform:uppercase;color:#1B1813;}
    .ev{display:block;padding:10px 13px;border-bottom:1px solid #EFEDE9;color:inherit;
      text-decoration:none;}
    .ev:last-child{border-bottom:none;}
    .ev p{margin:0;font-size:0.875rem;line-height:1.45;overflow-wrap:anywhere;}
    .ev small{display:block;margin-top:3px;font-size:0.75rem;color:#70685C;overflow-wrap:anywhere;}
    .kind{display:inline-block;margin-right:6px;padding:2px 8px;border-radius:999px;
      border:1px solid #DFDCD8;background:#F8F8F6;font-size:0.6875rem;font-weight:700;color:#564E43;
      letter-spacing:0.02em;}
    .srcs{margin:16px 0 0;padding:12px 13px;border:1px solid #DFDCD8;border-radius:12px;
      background:#FDFDFC;}
    .srcs h2{margin:0 0 6px;font-size:0.8125rem;font-weight:700;}
    .srcs p{margin:6px 0 0;font-size:0.75rem;line-height:1.55;color:#70685C;overflow-wrap:anywhere;}
    .foot{margin:16px 0 0;padding:12px 2px;border-top:1px solid #DFDCD8;font-size:0.75rem;
      line-height:1.6;color:#70685C;}
  </style>
</head>
<body>
  <header class="topbar">
    <h1>Calendar</h1>
    <p>{model.explanation}</p>
  </header>

  <nav class="tabs" aria-label="Calendar views">
    {CALENDAR_VIEWS.map((v) => (
      <a class="tab" href={hrefFor(v.key)} aria-current={v.key === view ? 'page' : null}>{v.label}</a>
    ))}
  </nav>

  <main class="wrap">
    <div class="monthnav">
      <a href={prevHref}>Earlier</a>
      <b>{monthLabel(anchor)}</b>
      <a href={nextHref}>Later</a>
    </div>

    <p class="blurb">{model.blurb}</p>

    {model.notice && <p class="notice">{model.notice}</p>}

    {model.degraded && (
      <p class="notice">
        Part of this calendar could not be read, so it may be incomplete. Nothing shown here is
        guessed, and what is missing is named at the bottom of the page.
      </p>
    )}

    {daysWithEvents.length === 0 && (
      <EmptyState
        title={model.emptyTitle}
        body={model.emptyBody}
        illustration={model.eventCount === 0 && model.sources.length === 0 ? 'note' : 'check'}
        tone="approved"
        actionLabel="Your attendance"
        actionHref="/portal/employee/attendance"
      />
    )}

    {daysWithEvents.map((d) => (
      <section class={d.isToday ? 'day day--today' : 'day'}>
        <div class="day__head">
          <span class="day__num">{dayNumber(d.dateIso)}</span>
          <span class="day__name">{d.weekday}</span>
          {d.isToday && <span class="day__today">Today</span>}
        </div>
        {d.events.map((ev) => (
          ev.href ? (
            <a class="ev" href={ev.href}>
              <p><span class="kind">{sourceLabel(ev.source)}</span>{ev.title}</p>
              {(ev.detail || ev.timeLabel) && (
                <small>{ev.timeLabel ? ev.timeLabel + ' - ' : ''}{ev.detail || ''}</small>
              )}
            </a>
          ) : (
            <div class="ev">
              <p><span class="kind">{sourceLabel(ev.source)}</span>{ev.title}</p>
              {(ev.detail || ev.timeLabel) && (
                <small>{ev.timeLabel ? ev.timeLabel + ' - ' : ''}{ev.detail || ''}</small>
              )}
            </div>
          )
        ))}
      </section>
    ))}

    {(unavailableSources.length > 0 || emptySourceNotes.length > 0) && (
      <section class="srcs">
        <h2>Where this calendar reads from</h2>
        {emptySourceNotes.map((s) => (<p>{sourceLabel(s.key)}: {s.note}</p>))}
        {unavailableSources.map((s) => (<p>{sourceLabel(s.key)}: {s.note}</p>))}
      </section>
    )}

    <p class="foot">
      This calendar owns no events of its own. Every row is read live from the system that already
      holds it, so nothing here can be a stale copy of something that has since changed. Who you may
      see on the team and department views is decided by the organization graph, in the query, and a
      person you are not entitled to see is not fetched rather than hidden.
    </p>
  </main>

  {/* THE COMPOSED BAR. This was `<BottomNav variant="hr" active="" />` — a hardcoded
      Home | Tasks | Community | My HR with no capability test behind it, whose Home
      pointed at /portal rather than at this reader's actual home, and which lit no tab
      at all. The bar therefore rearranged itself as a person moved through their own
      workspace: WCAG 2.2 SC 3.2.3 Consistent Navigation, and the muscle memory a bottom
      bar exists to build. This page ALREADY composes, so the swap costs nothing — the
      same composition that scoped the content now draws the bar, and the two cannot
      disagree about what this person may reach. */}
  {composed && <WorkspaceNav composed={composed} />}
</body>
</html>
