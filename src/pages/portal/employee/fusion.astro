---
// /portal/employee/fusion — YOUR OWN INTELLIGENCE PROFILE (PATCH 06).
//
// =================================================================================================
// WHY THE PERSON SEES THIS AT ALL
// =================================================================================================
//
// A record about you that you cannot read is a record you cannot answer. This engine exists to be
// disagreed with — the whole design rests on a named human looking at a reading and saying "that is
// wrong, and here is why" — and somebody who cannot see the reading cannot do that. So this page
// needs no capability: it is your own record, and reading it is not an exercise of authority over
// anybody.
//
// WHAT IS AND IS NOT SHOWN HERE. Every reading, every source, what agreed and what contradicted,
// what could not be read, and what the system is not allowed to do with any of it. NOT shown: the
// per-source weighting, which is a policy about everybody rather than a fact about you, and the
// itemised inferred foundation, which is the interpretation layer's to show. WHETHER the foundation
// counted, and whether it was set aside, IS shown — because that is the finding.
//
// NOTHING ON THIS PAGE DECIDES ANYTHING ABOUT YOU, and the page says so at the top rather than in a
// footnote.
//
// MOBILE FIRST — around nine in ten of these people are on a phone. 360px is the design width,
// every control clears 44px, nothing scrolls sideways.
//
// CLIENT JAVASCRIPT: NONE. Disclosure is native <details>, the form is a form.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import { requireEmployee } from '@/lib/auth/workspace-access';
import { flashFailed } from '@/lib/flash-tone';
import {
  buildProfile,
  viewFor,
  addNote,
  headline,
  confidenceLine,
  sourceSentence,
  statusTone,
  bandTone,
  agreementGlyph,
  directionGlyph,
  notConnectedSentence,
  foundationNotice,
  READING_STATUS_LABELS,
  NOTE_STANCES,
  NOTE_STANCE_LABELS,
  MIN_NOTE_CHARS,
  FUSION_CSS,
  GLYPH_ADVISORY,
  GLYPH_LINK,
  type DimensionReading,
  type FusionProfile,
  type IntelligenceViewer,
} from '@/lib/fusion';

const PATH = '/portal/employee/fusion';

const user = Astro.locals.user;
const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);

// Declared ABOVE the POST handler that reads it. `const` is not hoisted.
const back = (msg: string) =>
  Astro.redirect(PATH + '?msg=' + encodeURIComponent(msg.slice(0, 300)));

const employeeId = gate.ok ? gate.workspace.employeeId : null;

if (Astro.request.method === 'POST') {
  if (!gate.ok || !employeeId || !user?.id) return back('Nothing was saved.');
  const fd = await Astro.request.formData();
  if (String(fd.get('action') || '') === 'add_note') {
    const r = await addNote({
      employeeId,
      dimension: String(fd.get('dimension') || '') || null,
      authorUserId: String(user.id),
      authorRelationship: 'the person themselves',
      stance: String(fd.get('stance') || ''),
      body: String(fd.get('body') || ''),
    });
    return back(r.ok
      ? 'Recorded. It sits beside that reading with your name on it, it does not get deleted, and whoever reads your profile sees it.'
      : (r.error || 'That could not be saved.'));
  }
  return back('That action is not one this page performs.');
}

const params = Astro.url.searchParams;
const msg = String(params.get('msg') || '').slice(0, 300);

// -------------------------------------------------------------------------------------------------
// BUILD — self only. There is no employee id parameter on this page and nowhere for one to arrive.
// -------------------------------------------------------------------------------------------------

let profile: FusionProfile | null = null;
let buildError: string | null = null;

if (gate.ok && employeeId && user?.id) {
  const built = await buildProfile({ employeeId });
  if ('error' in built) {
    buildError = built.error;
  } else {
    // The self view is a SUBTRACTION from the one master record, not a second computation.
    const selfViewer: IntelligenceViewer = {
      userId: String(user.id),
      employeeId,
      fullName: gate.workspace.fullName,
      orgWide: false,
      mayWeight: false,
      scope: null,
    };
    profile = viewFor(built, selfViewer, 'self').profile;
  }
}

const readCount = profile ? profile.dimensions.filter((d) => d.reading !== null).length : 0;
const totalDims = profile ? profile.dimensions.length : 0;
const dimensionOptions = profile ? profile.dimensions.map((d) => ({ key: d.dimension, label: d.label })) : [];
const personName = gate.ok ? gate.workspace.fullName : null;
---

<EmployeeShell title="Your profile" person={personName} width={640} bottomPad={48}>
  <style is:global set:html={FUSION_CSS}></style>

  <div class="fu">
    {!gate.ok && (
      <div class="deny">
        <p><b>{gate.title}</b></p>
        <p style="margin-top:8px">{gate.reason}</p>
      </div>
    )}

    {gate.ok && (
      <>
        <h1>What the system says about your work</h1>
        <p class="lede">
          Ten readings, built only from records this organisation already holds about work you did.
          {' '}{readCount} of {totalDims} could be read at all.
        </p>

        {msg && <p class={flashFailed(msg) ? 'flash warn' : 'flash'} role={flashFailed(msg) ? 'alert' : 'status'}>{msg}</p>}

        <div class="card">
          <h2>What this cannot do</h2>
          <p class="muted">
            Nothing here decides anything about you. It does not hire, reject, promote, end anybody’s
            employment, set pay, or start a disciplinary process — those are decided by a named human
            who can be asked why, in a system that does not read this one.
          </p>
          <p class="muted" style="margin-top:8px">
            There is no overall score for you on this page, and there is nowhere in the system for one
            to be stored. Ten readings stay ten readings.
          </p>
          <p class="muted" style="margin-top:8px">
            Nothing here reads your keystrokes, your screen, your messages or your location. No
            protected or personal characteristic was used, and there is no field one could arrive
            through. If you think something below is wrong, write it down at the bottom — it goes on
            the record beside the reading and it is not deleted.
          </p>
        </div>

        {buildError && (
          <div class="deny"><p><b>Your profile could not be built.</b></p><p style="margin-top:8px">{buildError}</p></div>
        )}

        {profile && (profile.notConnected.length > 0 || profile.unreadable.length > 0 || profile.withheld.length > 0) && (
          <div class="card">
            <h2>What is missing from every reading below</h2>
            <ul class="chain">
              {profile.notConnected.map((m) => (<li>{notConnectedSentence(m)}</li>))}
              {profile.unreadable.map((u) => (<li><b>{u.what}.</b> {u.because}</li>))}
              {profile.withheld.map((w) => (<li><b>{w.what}.</b> {w.because}</li>))}
            </ul>
            <p class="muted" style="margin-top:8px">
              Every one of these is something the system could not see. None of them is a lower
              reading about you.
            </p>
          </div>
        )}

        {profile && profile.dimensions.map((d: DimensionReading) => (
          <div class="dim" style="margin-bottom:12px">
            <h3>{d.label}</h3>
            <p class="q">{d.question}</p>

            <div class={d.reading === null ? 'num absent' : 'num'}>{headline(d)}</div>
            {d.reading !== null && (
              <span class={d.inverted ? 'meter inv' : 'meter'} aria-hidden="true">
                <i style={'width:' + d.reading + '%'}></i>
              </span>
            )}
            <span class={'tag ' + statusTone(d.status)}>{READING_STATUS_LABELS[d.status]}</span>
            {' '}
            <span class={'tag ' + bandTone(d.explanation.confidence.band)}>
              <span set:html={directionGlyph(d.explanation.confidence.direction)} />
              {' '}{confidenceLine(d)}
            </span>

            <p class="say">{d.sentence}</p>
            <p class="muted" style="margin-top:6px">{d.change.sentence}</p>

            {d.inverted && (
              <p class="muted" style="margin-top:6px">
                <b>Read this one the other way round.</b> A higher number here means more is
                outstanding, not that you are worse at something.
              </p>
            )}

            <details>
              <summary>Where this came from</summary>
              {d.sources.map((v) => (
                <div class={v.effectiveWeight > 0 ? 'src' : 'src off'}>
                  <span set:html={v.signalCount ? agreementGlyph(v.agreement) : agreementGlyph('silent')} />
                  <span>{sourceSentence(v, false)}</span>
                </div>
              ))}
              {d.explanation.evidence.length > 0 && (
                <ul class="chain">
                  {d.explanation.evidence.map((e) => (
                    <li>
                      {e.url && <span set:html={GLYPH_LINK} />}
                      {' '}{e.what}{e.at ? ' — ' + e.at.slice(0, 10) : ''}
                      {e.url && <> — <a href={e.url} rel="noreferrer noopener" target="_blank">open</a></>}
                    </li>
                  ))}
                </ul>
              )}
            </details>

            {(d.agreement.length > 0 || d.contradiction.length > 0) && (
              <details>
                <summary>What agreed, and what did not</summary>
                {d.agreement.length > 0 && <ul class="chain">{d.agreement.map((a) => (<li>{a}</li>))}</ul>}
                {d.contradiction.length > 0 && (
                  <>
                    <p class="muted" style="margin-top:8px"><b>These records do not agree</b></p>
                    <ul class="chain">{d.contradiction.map((c) => (<li>{c}</li>))}</ul>
                    <p class="muted" style="margin-top:6px">
                      A disagreement is a question worth asking, not a finding about you. Nothing was
                      quietly averaged away to make it go away.
                    </p>
                  </>
                )}
              </details>
            )}

            <details>
              <summary>How this was worked out</summary>
              <ul class="chain">{d.explanation.processing.map((p) => (<li>{p}</li>))}</ul>
              <p class="muted" style="margin-top:8px">{d.explanation.confidence.sentence}</p>
              <p class="muted" style="margin-top:6px">{d.explanation.output}</p>
            </details>

            {d.developmentNeeds.length > 0 && (
              <details>
                <summary>Named as needing work ({d.developmentNeeds.length})</summary>
                <ul class="chain">{d.developmentNeeds.map((n) => (<li>{n}</li>))}</ul>
              </details>
            )}
          </div>
        ))}

        <div class="card">
          <h2><span set:html={GLYPH_ADVISORY} /> About anything inferred</h2>
          <p class="muted">{foundationNotice()}</p>
        </div>

        {profile && (
          <div class="card">
            <h2>Say something about this</h2>
            <p class="muted">
              If a reading is wrong, or right for a reason nobody recorded, put it on the record. Your
              note sits beside the reading with your name on it. It does not change the number, it is
              not deleted, and anybody who opens your profile sees it.
            </p>
            <form method="post">
              <input type="hidden" name="action" value="add_note" />
              <div class="row2">
                <div>
                  <label for="n-dim">Which reading</label>
                  <select id="n-dim" name="dimension">
                    <option value="">All of it</option>
                    {dimensionOptions.map((o) => (<option value={o.key}>{o.label}</option>))}
                  </select>
                </div>
                <div>
                  <label for="n-stance">Your position</label>
                  <select id="n-stance" name="stance">
                    {NOTE_STANCES.map((s) => (<option value={s}>{NOTE_STANCE_LABELS[s]}</option>))}
                  </select>
                </div>
              </div>
              <label for="n-body">What you want on the record</label>
              <textarea id="n-body" name="body" maxlength="4000" required
                placeholder={'At least ' + MIN_NOTE_CHARS + ' characters.'}></textarea>
              <button class="btn" type="submit">Record this</button>
            </form>

            {profile.humanNotes.length > 0 && (
              <>
                <p class="muted" style="margin-top:14px"><b>Already on the record</b></p>
                <ul class="chain">
                  {profile.humanNotes.map((n) => (
                    <li>
                      <b>{n.authorName || 'A named user'}</b>
                      {n.authorRelationship ? ' (' + n.authorRelationship + ')' : ''}
                      {' — '}{NOTE_STANCE_LABELS[n.stance]}, {n.writtenAt.slice(0, 10)}
                      <br />{n.body}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}
      </>
    )}
  </div>
</EmployeeShell>
