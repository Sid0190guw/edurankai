---
/**
 * /portal/employee/directory — WHO WORKS HERE, PAGED.
 *
 * =================================================================================================
 * WHAT THIS PAGE IS FOR
 * =================================================================================================
 *
 * "Who is Priya Sharma and which department is she in" is the most-asked question in any workforce
 * of size, and until now this product had two answers, neither of which was this one:
 *
 *   /portal/search      — one box across seven sources, eight hits each, no paging. Right for "I
 *                         half-remember a name", useless for "let me look through my department".
 *   /portal/organization — the reporting graph, drawn as a tree. Right for "where does she sit",
 *                         useless as a list.
 *
 * This is the list. Alphabetical, paged, searchable by name, job title or employee code.
 *
 * =================================================================================================
 * IT ADDS NO SCOPE AND NO COLUMNS — READ THIS BEFORE CHANGING ANYTHING BELOW
 * =================================================================================================
 *
 * A directory is the single most tempting place in a workforce product to quietly widen a scope,
 * because "a directory should obviously show everyone" is a sentence that sounds like a requirement
 * and is actually a policy decision. This page does NOT make it. src/lib/workforce/directory.ts asks
 * resolveOrgViewerScope() — the same function /portal/organization and /portal/search both use — and
 * renders exactly what that returns. Whoever you can see on the org chart is whom you can see here,
 * to the row.
 *
 * The columns are name, job title, employee code and department. No email, no phone, no salary, no
 * government id, no date of birth. That is the same set the people search returns and the same
 * sentence its own comment carries.
 *
 * A row links to /portal/organization?view=reporting&focus=<id>, which scopes itself in its own
 * query — so a link from here cannot become a way around that scoping.
 *
 * =================================================================================================
 * WHY THE COUNT SAYS "500+"
 * =================================================================================================
 *
 * Because counting further reads rows nobody looks at. On a large roll an exact total means a full
 * scan of the scope on every page load to render a number that changes before it is read. The page
 * says what it counted and stops.
 *
 * NO POST HANDLER. The query and the cursor live in the URL, so a page of the directory is
 * shareable, bookmarkable and survives the back button — and there is no handler above the
 * declarations to reach a `const` early, which is the hoisting trap that has taken pages down here.
 *
 * NO AUTOCOMPLETE ENDPOINT, deliberately, for the reason /portal/search states: an as-you-type
 * endpoint over people is a probe oracle with a nicer interface, and every keystroke would be a
 * database round trip on a phone connection.
 *
 * MOBILE FIRST — 360px, 44px targets, one column, no sideways scroll.
 */
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import { composeWorkspace } from '@/lib/workforce/composer';
import { directoryPage, PAGE_SIZE, MAX_QUERY_CHARS } from '@/lib/workforce/directory';
import { countLabel, MIN_SEARCH_CHARS } from '@/lib/workforce/scale';

const PATH = '/portal/employee/directory';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

// EVERY CONST BEFORE ITS FIRST USE. `const` is not hoisted, and a declaration reached early throws
// on its own line.
const url = new URL(Astro.request.url);
const q = String(url.searchParams.get('q') || '').trim().slice(0, MAX_QUERY_CHARS);
const cursor = url.searchParams.get('after');

// The composition, for the capability test the scope resolver needs. It is the same one every other
// workspace surface is drawn from, so this page cannot answer "who are you" differently from the nav.
const composed = await composeWorkspace(user, { locals: Astro.locals, next: PATH });
const page = await directoryPage({
  userId: String(user.id),
  holds: composed.context.holds,
  selfEmployeeId: composed.context.employeeId,
  q,
  cursor,
});

const link = (params: Record<string, string>) => {
  const u = new URL(PATH, url.origin);
  if (q) u.searchParams.set('q', q);
  for (const [k, v] of Object.entries(params)) {
    if (v) u.searchParams.set(k, v); else u.searchParams.delete(k);
  }
  return u.pathname + (u.search || '');
};

const totalLabel = countLabel(page.total);
const showingFirstPage = !cursor;
// Never a bare number over a failed read: countLabel() already returns '' when the count did not
// happen, so the badge is simply absent rather than showing a zero nobody measured.
const scopeLine = page.scope.explanation || '';
const person = composed.context.hasEmployeeRecord ? (composed.workspace?.fullName || '') : '';
---
<EmployeeShell title="Directory" documentTitle="People directory" person={person} width={720} bottomPad={64} bare>
  <div class="wrap">

    {/* WHO YOU ARE LOOKING AT, IN A SENTENCE, ABOVE THE RESULTS. Taken verbatim from the scope
        resolver rather than written again here — a page that describes its own scope in its own
        words is a page whose description drifts from what the query does. */}
    {scopeLine && <p class="scope">{scopeLine}</p>}

    {page.scope.degraded && (
      <p class="warn" role="status">
        Part of this could not be read, so the list below may be incomplete: {page.scope.gaps.join(', ')}.
        Nothing is hidden on purpose.
      </p>
    )}

    <form class="find" method="get" action={PATH} role="search">
      {/* A LABEL, NOT A PLACEHOLDER. A placeholder disappears the moment somebody types, which is
          precisely when a person who has been interrupted needs to know what the box was for. */}
      <label for="q">Search by name, job title or employee code</label>
      <div class="findrow">
        <input id="q" name="q" type="search" value={q} maxlength={MAX_QUERY_CHARS}
               autocomplete="off" enterkeyhint="search" />
        <button class="btn" type="submit">Search</button>
      </div>
      {q && <p class="hint"><a class="link" href={PATH}>Clear the search</a></p>}
    </form>

    {page.tooShort && (
      <div class="card empty">
        <p><strong>That search is too short.</strong></p>
        <p>Type at least {MIN_SEARCH_CHARS} characters. A single letter matches most of the
        organisation, which is not an answer to anything.</p>
      </div>
    )}

    {!page.ok && (
      <div class="card empty" role="alert">
        <p><strong>The directory could not be read just now.</strong></p>
        <p>This is not a statement that there is nobody to show — the read itself did not complete.
        Try again in a moment, and tell the desk if it keeps happening.</p>
      </div>
    )}

    {page.ok && !page.tooShort && page.people.length === 0 && (
      <div class="card empty">
        <p><strong>{q ? 'Nobody in view matches that.' : 'There is nobody to list.'}</strong></p>
        <p>
          {q
            ? 'Try part of a surname, or the employee code. This searches only the people you are able to see, which the line above describes.'
            : 'Your view of the directory is empty. If that is not right, ask HR to check that your employee record and your reporting line are recorded.'}
        </p>
      </div>
    )}

    {page.ok && page.people.length > 0 && (
      <div class="card">
        <h3>
          {q ? 'Matches' : 'People'}
          {totalLabel && <span class="count">{totalLabel}</span>}
        </h3>

        <ul class="people">
          {page.people.map((p) => (
            <li>
              <a class="row" href={'/portal/organization?view=reporting&focus=' + encodeURIComponent(p.id)}>
                <span class="nm">
                  {p.name}
                  {p.isSelf && <span class="you">you</span>}
                </span>
                <span class="sub">
                  {[p.designation, p.departmentName, p.employeeCode].filter(Boolean).join(' · ')}
                </span>
              </a>
            </li>
          ))}
        </ul>

        {/* PAGING IS A CURSOR, NOT A PAGE NUMBER, and the control says so by only ever offering
            "next". A numbered pager implies random access, and random access into a directory of
            this size is the OFFSET query this page exists to avoid. */}
        <div class="pager">
          {!showingFirstPage && <a class="btn quiet" href={link({ after: '' })}>Back to the start</a>}
          {page.next && <a class="btn" href={link({ after: page.next })}>Next {PAGE_SIZE}</a>}
        </div>

        {page.total.atLeast && (
          <p class="hint">
            The count stops at {page.total.count}. Counting every match on a workforce this size
            would read the whole list to print a number, so it says "{totalLabel}" and means it.
          </p>
        )}
      </div>
    )}

    {!page.indexed && (
      <p class="hint tech">
        Substring search over this many records has no index behind it on this database, so it is
        slower than it should be. Whoever runs the database can fix it with
        <code>db/hr-scale-indexes.sql</code>.
      </p>
    )}

    <p class="hint">
      This lists names, job titles and departments only. Contact details, pay and identity documents
      are never shown here. Somebody missing from the list is somebody outside what you are able to
      see, not somebody who has left.
    </p>
  </div>
</EmployeeShell>

<style is:global>
  .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
  .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin:0 0 12px;display:flex;align-items:center;gap:8px;}
  .card h3 .count{background:#f2ece0;color:var(--emp-muted);border-radius:99px;padding:3px 9px;letter-spacing:.05em;}

  .scope{font-size:12.5px;line-height:1.6;color:var(--emp-muted);margin:0 0 12px;}
  .warn{background:rgba(217,119,6,.08);border:1px solid rgba(217,119,6,.28);color:#92400e;border-radius:10px;padding:11px 13px;font-size:12.5px;line-height:1.6;margin:0 0 12px;}

  .find{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:14px 16px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
  .find label{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;display:block;margin:0 0 6px;}
  .findrow{display:flex;gap:8px;}
  .findrow input{flex:1 1 auto;min-width:0;background:var(--emp-surface-2);border:1px solid var(--emp-line-2);border-radius:9px;padding:11px 12px;font-size:16px;font-family:inherit;color:var(--emp-ink);min-height:44px;}
  /* 16px, not 14px: iOS zooms the whole page when a focused input is smaller than that, and the
     zoom does not come back when the field is blurred. */
  .findrow input:focus{border-color:var(--emp-accent);outline:none;}

  .btn{display:inline-flex;align-items:center;justify-content:center;background:var(--emp-accent);color:#fff;border:none;border-radius:10px;padding:0 18px;min-height:44px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;text-decoration:none;}
  .btn.quiet{background:var(--emp-surface-2);color:var(--emp-ink);border:1px solid var(--emp-line-2);}

  .people{list-style:none;margin:0;padding:0;}
  .people li{border-bottom:1px solid #f2ece0;}
  .people li:last-child{border-bottom:none;}
  .row{display:flex;flex-direction:column;gap:3px;padding:11px 0;min-height:44px;justify-content:center;text-decoration:none;color:inherit;}
  .row:hover .nm,.row:focus-visible .nm{color:var(--emp-accent);}
  .nm{font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px;}
  .you{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;background:var(--emp-bar);color:#fff;border-radius:99px;padding:3px 7px;font-weight:700;}
  .sub{font-size:12px;color:var(--emp-muted);line-height:1.5;overflow-wrap:anywhere;}

  .pager{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}
  .pager .btn{flex:1 1 140px;}

  .empty{text-align:center;color:var(--emp-muted);font-size:13.5px;line-height:1.65;}
  .empty p{margin:0 0 6px;}
  .empty p:last-child{margin:0;}

  .hint{font-size:12px;color:var(--emp-muted);line-height:1.6;margin:10px 0 0;}
  .hint.tech{background:var(--emp-warn-bg);border:1px solid var(--emp-warn-line);border-radius:10px;padding:10px 12px;color:var(--emp-warn-ink);}
  .hint code{font-family:'JetBrains Mono',monospace;font-size:11px;background:rgba(0,0,0,.05);border-radius:5px;padding:1px 5px;}
  .link{color:var(--emp-accent);}
</style>
