---
/**
 * /portal/employee/mail — THE EMPLOYEE MOUNT OF THE REAL MAIL SYSTEM.
 *
 * WHAT THIS IS NOT. It is not a mail system. There is exactly one, and it already existed:
 * src/lib/mail.ts (mailboxes, folders, threads, delivery, read receipts) + mail-transport.ts
 * (SMTP send / IMAP poll) + mail-groups.ts (@group:slug distribution lists) + mail-advanced.ts
 * (signatures, scheduling, link tracking). Its whole UI is src/components/MailClient.astro, which
 * already takes a `basePath` prop and already carried the comment "Used by /admin/mail and
 * /portal/mail" — a sentence that was only ever half true. This page is the missing half.
 *
 * WHY IT WAS UNREACHABLE. MailClient had one mount, /admin/mail, behind AdminLayout; and its three
 * write endpoints gated on denyAdminApi() -> canOpenAdmin(). Both are the CONSOLE question. An
 * employee who will never open /admin still has a work address, still receives inbound mail through
 * the IMAP poller, and could not read a line of it. The product's answer to that was a SECOND
 * mailbox at /portal/mail on portal_mail_* tables with no SMTP path at all — mail sent there never
 * left the building and external mail never arrived. Mounting the real client here is what lets
 * that second mailbox stop being written to; see the header of src/pages/portal/mail.astro.
 *
 * THE GATE. canUseMailbox() (src/lib/auth/mail-access.ts) — the same function
 * /api/mail/{send,draft,action} now call, so the door and the endpoints behind it cannot disagree.
 * It fails closed and it DENIES IN PLACE: no redirect to /admin, ever. Four portal pages redirect
 * non-applicants to /admin and middleware bounces them straight back, which is the loop that took
 * /portal down before. A person who has no mailbox is told so, on this page, in a sentence naming
 * who fixes it.
 *
 * MOBILE FIRST. MailClient's own layout collapses to a single column under 720px and swaps the list
 * for the reading pane once a thread is open, so the phone case is the component's, not a variant
 * bolted on here. What this page adds is the 44px back control and the safe-area padding, and it
 * suppresses the floating action button because a full-screen app surface has no room for one
 * (era-no-fab, the house convention for the test runner and the old mail page).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import MailClient from '@/components/MailClient.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { transportStatus } from '@/lib/mail-transport';

// Declared before anything that uses them: `const` is not hoisted, and a handler reaching a later
// declaration has taken pages down on this project.
const HERE = '/portal/employee/mail';
const logFail = (tag: string, e: any) => console.error('[portal/employee/mail] ' + tag, e?.cause?.message || e?.message);

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(HERE));

const access = await canUseMailbox(user);

// Only asked once the person is admitted: it reads the mail configuration, and a denied caller has
// no business learning whether an SMTP host is set. Failure here is NOT a denial — the mailbox
// works internally with no transport at all — so it degrades to 'none' and says so.
let transport: { mode: 'smtp' | 'resend' | 'none'; detail: string } = { mode: 'none', detail: '' };
let transportKnown = false;
if (access.allowed) {
  try {
    transport = await transportStatus();
    transportKnown = true;
  } catch (e: any) {
    logFail('transportStatus', e);
  }
}
---
<BaseLayout title="Mail" description="Your work mailbox." showNav={false} showFooter={false} noindex={true}>
  {!access.allowed && (
    <section class="empm-deny">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
      <h1>{access.denial ? access.denial.title : 'This mailbox is not open to this account'}</h1>
      <p>{access.denial ? access.denial.reason : 'Ask HR to check the record linked to the address you signed in with.'}</p>
      <a class="empm-btn" href="/portal/employee">Back to your workspace</a>
    </section>
  )}

  {access.allowed && (
    <div class="empm">
      <div class="empm-bar">
        <a class="empm-back" href="/portal/employee" aria-label="Back to your workspace">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          <span>Workspace</span>
        </a>
        <a class="empm-alt" href="/portal/notifications">Notifications</a>
      </div>

      {/* Honest, and only about what THIS person can observe. The admin banner offers a "connect
          your mail server" link; that setting is not theirs and naming it here would send them at a
          door they cannot open. Internal delivery works with no transport at all, which is the part
          that matters to them. */}
      {transportKnown && transport.mode === 'none' && (
        <p class="empm-note">
          Messages to colleagues here work now. Sending to and receiving from addresses outside the
          organisation is not switched on yet, so a message to an outside address will not leave.
        </p>
      )}
      {!transportKnown && (
        <p class="empm-note">
          We could not check whether outside mail is switched on. Messages to colleagues are
          unaffected.
        </p>
      )}

      <MailClient user={user} basePath={HERE} />
    </div>
  )}
</BaseLayout>

<style is:global>
  /* The mail client reads --o-* tokens with dark fallbacks (see MailClient.astro). Pinning them
     here means this surface looks like the one at /admin/mail rather than half-inheriting the
     portal's paper palette and landing somewhere neither. */
  html:has(.empm), html:has(.empm-deny) {
    --o-bg0:#07090d; --o-bg1:#0b0e14; --o-bg2:#10141d;
    --o-panel:rgba(255,255,255,0.04); --o-stroke:rgba(255,255,255,0.09);
    --o-brand:#f2731c; --o-brand-bright:#ff8a3d; --o-brand-soft:rgba(242,115,28,0.14); --o-brand-glow:rgba(242,115,28,0.30);
    --o-hi:#f3f5f9; --o-mid:#9aa6b6;
    background:#07090d;
  }
  body:has(.empm), body:has(.empm-deny) { background:#07090d; color:#f3f5f9; }
  /* A full-screen app surface has no room for the floating action button. Same convention the test
     runner and the old mail page use. */
  body:has(.empm) #eraFab, body:has(.empm-deny) #eraFab { display:none !important; }

  .empm { display:flex; flex-direction:column; min-height:100dvh; }
  .empm-bar {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:max(6px, env(safe-area-inset-top)) 12px 6px;
    border-bottom:1px solid var(--o-stroke);
  }
  .empm-back, .empm-alt {
    display:inline-flex; align-items:center; gap:6px;
    min-height:44px; padding:0 12px; border-radius:10px;
    color:var(--o-mid); text-decoration:none; font-size:13px; font-weight:700;
  }
  .empm-back:hover, .empm-alt:hover, .empm-back:focus-visible, .empm-alt:focus-visible { color:var(--o-hi); background:var(--o-panel); }
  .empm-note {
    margin:0; padding:9px 14px; font-size:12.5px; line-height:1.5;
    background:rgba(251,191,36,0.10); border-bottom:1px solid rgba(251,191,36,0.24); color:#fbbf24;
  }
  /* The client sizes itself to the viewport; inside this shell it has a bar and possibly a notice
     above it, so it takes the remaining space instead. */
  .empm .mailc { flex:1; height:auto; min-height:0; }

  .empm-deny {
    max-width:34rem; margin:0 auto; padding:18vh 20px 40px;
    display:flex; flex-direction:column; align-items:center; text-align:center; gap:14px;
    color:var(--o-mid);
  }
  .empm-deny h1 { margin:0; font-size:1.25rem; line-height:1.3; font-weight:800; color:var(--o-hi); }
  .empm-deny p { margin:0; font-size:0.95rem; line-height:1.6; }
  .empm-btn {
    display:inline-flex; align-items:center; min-height:44px; padding:0 20px; border-radius:10px;
    background:var(--o-brand); color:#fff; text-decoration:none; font-weight:700; font-size:0.9rem;
  }
</style>
