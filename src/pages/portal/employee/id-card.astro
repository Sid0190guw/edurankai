---
// /portal/employee/id-card - YOUR EMPLOYEE ID: ON YOUR PHONE, AND ON PAPER.
//
// THE PHONE CARD shows a verification code that changes every 30 seconds and stops working after 90
// (src/pages/api/id-card/live.ts). Unlocking it with your face signs the time of that match into the
// code, so the person scanning it is told "unlocked with a face match N minutes ago". The camera
// frame never leaves the phone: only 128 numbers are sent, the comparison happens on the server
// against the enrolment it already holds, and the answer is yes or no.
//
// THE PRINTED CARD carries a long-lived signed code on its back. It is the same credential format,
// marked "printed", so a scanner knows it may be looking at a copy and says so.
//
// WHO CAN SEE WHAT. Everything is scoped to the employee resolved from the signed-in session by
// requireEmployee(). No id comes from a form field or the URL.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import IdCard from '@/components/hr/IdCard.astro';
import { requireEmployee } from '@/lib/auth/workspace-access';
import { activeCardFor, holderFor, printedToken } from '@/lib/hr/id-card';
import { hasActiveFaceEnrolment } from '@/lib/auth/face';
import { qrSvg } from '@/lib/qr';
import { publicUrl } from '@/lib/public-origin';

// Declared before anything reads them: `const` is not hoisted.
const PAGE = '/portal/employee/id-card';
const logFail = (tag: string, e: any) => console.error('[portal/employee/id-card] ' + tag, e?.cause?.message || e?.message);

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PAGE));

const gate = await requireEmployee(user, PAGE);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);
const employeeId = gate.ok ? gate.workspace.employeeId : null;

let notReady = '';
let card: any = null;
let holder: any = null;
let printedQr: string | null = null;
let signError = '';
let enrolled = false;

if (employeeId) {
  const read = await activeCardFor(employeeId);
  if (!read.ready) notReady = read.error;
  else card = read.value;
  try { holder = await holderFor(employeeId); } catch (e: any) { logFail('holder', e); }
  try { enrolled = await hasActiveFaceEnrolment(String(user.id)); } catch (e: any) { logFail('enrolment', e); }
  if (card) {
    try {
      printedQr = await qrSvg(publicUrl('/verify/id/' + printedToken(card)), { size: 220, level: 'M', margin: 1 });
    } catch (e: any) {
      signError = 'Your card could not be signed just now, so the printable copy has no code on it. Tell HR.';
      logFail('printed token', e);
    }
  }
}
const name = holder?.fullName || (gate.ok ? gate.workspace.fullName : user.name) || '';
---
<EmployeeShell title="My ID card" person={name} width={560} bottomPad={64} bare>
<div class="wrap idp">
  {!gate.ok && (
    <div class="card">
      <h3>{gate.title}</h3>
      <p>{gate.reason}</p>
    </div>
  )}

  {gate.ok && notReady && (
    <div class="card warn"><h3>ID cards are not switched on yet</h3><p>{notReady}</p></div>
  )}

  {gate.ok && !notReady && !card && (
    <div class="card">
      <h3>No ID card has been issued to you yet</h3>
      <p>HR issues cards from the ID card desk. Once yours is issued it appears here, ready to show on
      your phone or to print. Ask the People desk if you were expecting one.</p>
      {!holder?.photoUrl && <p class="meta">Your record has no photo yet, and the card needs one. Your face enrolment photo is used when HR has it.</p>}
    </div>
  )}

  {card && holder && (
    <section class="live" id="idLive" data-api="/api/id-card/live" data-enrolled={enrolled ? '1' : '0'}>
      <div class="cardwrap">
        <IdCard side="front" fullName={holder.fullName} designation={holder.designation} employeeCode={holder.employeeCode}
          employmentType={holder.employmentType} photoUrl={holder.photoUrl} serial={card.serial} validUntil={card.validUntil} />
        <div class="sheen" aria-hidden="true"></div>
      </div>

      <div class="codebox">
        <div class="codehead">
          <p class="eyebrow">Live verification code</p>
          <p class="clock" id="idClock" aria-label="Current time">--:--:--</p>
        </div>
        <div class="qr" id="idQr">
          <p class="qrhint">Unlock your card to show a code. It changes every 30 seconds, so a screenshot stops working within a minute and a half.</p>
        </div>
        <div class="ring" aria-hidden="true"><div class="ringbar" id="idRing"></div></div>
        <p class="state" id="idState" role="status" aria-live="polite"></p>
        <p class="face" id="idFace" hidden></p>

        <div class="viewer" id="idViewer" hidden>
          <video id="idVideo" playsinline muted autoplay></video>
          <p class="meta">Look at the camera. Nothing is recorded or uploaded: only a set of numbers describing your face is sent, and it is compared and discarded.</p>
        </div>

        <div class="btns">
          {enrolled && <button type="button" class="btn" id="idUnlock">Unlock with my face</button>}
          <button type="button" class={enrolled ? 'btn ghost' : 'btn'} id="idPlain">{enrolled ? 'Show without a face check' : 'Show my code'}</button>
        </div>
        {!enrolled && (
          <p class="meta">Enrol your face at <a href="/portal/face-setup">face setup</a> to show a face-checked card. It is optional; your card works without it.</p>
        )}
      </div>
    </section>
  )}

  {card && holder && (
    <section class="card printcard">
      <h3>Printed card</h3>
      <p>Front and back at the exact bank-card size (54 by 85.6 mm). Print at 100% scale, cut along the
      edges and laminate, or send to a card printer. The code on the back is signed and can be checked
      by anyone, but a printed card can be copied, so the phone card above is the stronger one.</p>
      {signError && <p class="meta bad">{signError}</p>}
      <div class="sheet" id="idSheet">
        <IdCard side="front" fullName={holder.fullName} designation={holder.designation} employeeCode={holder.employeeCode}
          employmentType={holder.employmentType} photoUrl={holder.photoUrl} serial={card.serial} validUntil={card.validUntil} />
        <IdCard side="back" fullName={holder.fullName} designation={holder.designation} employeeCode={holder.employeeCode}
          employmentType={holder.employmentType} photoUrl={holder.photoUrl} serial={card.serial} validUntil={card.validUntil}
          validFrom={card.validFrom} qrHtml={printedQr} />
      </div>
      <button type="button" class="btn" onclick="window.print()">Print my card</button>
      <p class="meta">Card {card.serial}. If it is lost, tell HR at once: they revoke it and every copy, printed or on screen, stops verifying immediately.</p>
    </section>
  )}
</div>

<style is:global>
  .idp { padding-top: 12px; }
  .idp .card { background: #fff; border: 1px solid rgba(14,11,8,0.1); border-radius: 16px; padding: 18px; margin-bottom: 16px; }
  .idp .card h3 { margin: 0 0 8px; font-size: 16px; }
  .idp .card p { margin: 0 0 8px; font-size: 14px; line-height: 1.6; color: #3a332d; }
  .idp .card.warn { background: #FFF8E6; border-color: #f2d27a; }
  .idp .meta { font-size: 12.5px !important; color: #7a7066 !important; line-height: 1.55; }
  .idp .meta.bad { color: #b91c1c !important; }
  .idp .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 12px; border: 0; background: #FF4F00; color: #fff; font-weight: 700; font-size: 14.5px; cursor: pointer; }
  .idp .btn.ghost { background: transparent; color: #0E0B08; border: 1px solid rgba(14,11,8,0.2); }
  .idp .btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .idp .btns .btn { flex: 1 1 200px; }

  .idp .live { display: grid; gap: 16px; justify-items: center; margin-bottom: 18px; }
  .idp .cardwrap { position: relative; --idc-w: min(78vw, 300px); border-radius: 14px; overflow: hidden; }
  .idp .cardwrap .idc { --idc-w: min(78vw, 300px); }
  /* A MOVING SHEEN over the live card. A screenshot freezes it; a live screen does not. */
  .idp .sheen { position: absolute; inset: 0; pointer-events: none; border-radius: 14px;
    background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.35) 45%, rgba(255,214,170,0.25) 50%, transparent 65%);
    background-size: 250% 100%; animation: idp-sheen 4.5s linear infinite; mix-blend-mode: soft-light; }
  @keyframes idp-sheen { from { background-position: 150% 0; } to { background-position: -100% 0; } }
  @media (prefers-reduced-motion: reduce) { .idp .sheen { animation: none; } }

  .idp .codebox { width: 100%; background: #0E0B08; color: #fff; border-radius: 18px; padding: 18px; box-sizing: border-box; }
  .idp .codehead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .idp .eyebrow { margin: 0; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #FF7040; font-weight: 800; }
  .idp .clock { margin: 0; font-family: Consolas, Menlo, monospace; font-size: 15px; color: #fbbf24; font-weight: 700; }
  .idp .qr { margin: 14px auto 0; width: min(70vw, 240px); aspect-ratio: 1; background: #fff; border-radius: 14px; padding: 10px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
  .idp .qr svg { width: 100%; height: 100%; display: block; }
  .idp .qrhint { color: #3a332d; font-size: 13px; line-height: 1.5; text-align: center; margin: 0; }
  .idp .ring { margin: 12px auto 0; width: min(70vw, 240px); height: 4px; background: rgba(255,255,255,0.12); border-radius: 4px; overflow: hidden; }
  .idp .ringbar { height: 100%; width: 0; background: linear-gradient(90deg, #FF4F00, #fbbf24); transition: width 1s linear; }
  .idp .state { margin: 12px 0 0; font-size: 13.5px; line-height: 1.55; color: rgba(255,255,255,0.8); text-align: center; }
  .idp .face { margin: 8px auto 0; font-size: 12.5px; padding: 6px 12px; border-radius: 100px; text-align: center; width: fit-content; }
  .idp .face.ok { background: rgba(74,222,128,0.16); color: #86efac; }
  .idp .face.none { background: rgba(251,191,36,0.14); color: #fde68a; }
  .idp .viewer { margin-top: 12px; text-align: center; }
  .idp .viewer video { width: min(70vw, 240px); aspect-ratio: 3 / 4; object-fit: cover; border-radius: 14px; background: #222; transform: scaleX(-1); }
  .idp .viewer .meta { color: rgba(255,255,255,0.6) !important; }
  .idp .codebox .btn.ghost { color: #fff; border-color: rgba(255,255,255,0.25); }
  .idp .codebox .meta { color: rgba(255,255,255,0.6) !important; text-align: center; }
  .idp .codebox a { color: #FF9A66; }

  .idp .sheet { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin: 12px 0 14px; }
  .idp .sheet .idc { --idc-w: min(42vw, 230px); }

  @media print {
    body * { visibility: hidden !important; }
    #idSheet, #idSheet * { visibility: visible !important; }
    #idSheet { position: absolute; left: 10mm; top: 10mm; gap: 8mm; justify-content: flex-start; }
    #idSheet .idc { --idc-w: 54mm !important; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('idLive');
    if (!root) return;
    var api = root.getAttribute('data-api');
    var enrolled = root.getAttribute('data-enrolled') === '1';
    var qr = document.getElementById('idQr');
    var ring = document.getElementById('idRing');
    var stateEl = document.getElementById('idState');
    var faceEl = document.getElementById('idFace');
    var clock = document.getElementById('idClock');
    var viewer = document.getElementById('idViewer');
    var video = document.getElementById('idVideo');
    var unlockBtn = document.getElementById('idUnlock');
    var plainBtn = document.getElementById('idPlain');

    // Same face pipeline, same URLs, as enrolment and attendance. A descriptor is only comparable to
    // one made by the same model build; see src/pages/portal/employee/attendance/index.astro.
    var LIB = '/vendor/face-api/face-api.min.js';
    var MODELS = '/vendor/face-api/models';

    var grant = null, timer = null, tick = null, stream = null, libP = null, running = false, nextAt = 0, refreshEvery = 30;

    function say(t) { stateEl.textContent = t || ''; }
    function pad(n) { return (n < 10 ? '0' : '') + n; }

    // A LIVE CLOCK beside the code. A screenshot shows the time it was taken.
    setInterval(function () {
      var d = new Date();
      clock.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      if (running && nextAt) {
        var left = Math.max(0, nextAt - Date.now());
        ring.style.width = (100 * left / (refreshEvery * 1000)) + '%';
      }
    }, 1000);

    function shutCamera() {
      try { if (stream) stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); } catch (_) {}
      stream = null;
      try { video.pause(); video.srcObject = null; } catch (_) {}
      viewer.hidden = true;
    }
    window.addEventListener('pagehide', shutCamera);

    function showFace(faceAt) {
      if (faceAt) {
        var t = new Date(faceAt * 1000);
        faceEl.textContent = 'Face-checked at ' + pad(t.getHours()) + ':' + pad(t.getMinutes());
        faceEl.className = 'face ok';
      } else {
        faceEl.textContent = 'Shown without a face check';
        faceEl.className = 'face none';
      }
      faceEl.hidden = false;
    }

    function fetchCode(body) {
      return fetch(api, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {})
      }).then(function (r) { return r.json().catch(function () { return { ok: false, error: 'The server answer could not be read.' }; }); });
    }

    function render(res) {
      if (!res || !res.ok) {
        say((res && res.error) || 'Your code could not be produced. Check your connection and try again.');
        running = false;
        return false;
      }
      qr.innerHTML = res.qrSvg || '<p class="qrhint">The code could not be drawn. Your card is still valid.</p>';
      grant = res.grant || null;
      refreshEvery = res.refreshIn || 30;
      nextAt = Date.now() + refreshEvery * 1000;
      showFace(res.faceAt || 0);
      if (res.faceMessage) say(res.faceMessage);
      else say('Hold this up to be scanned. A new code appears every ' + refreshEvery + ' seconds.');
      return true;
    }

    function loop() {
      clearTimeout(timer);
      timer = setTimeout(function () {
        if (document.hidden) { loop(); return; }
        fetchCode(grant ? { grant: grant } : {}).then(function (res) { if (render(res)) loop(); })
          .catch(function () { say('Lost the connection. The last code works for up to 90 seconds; reconnecting.'); loop(); });
      }, refreshEvery * 1000);
    }

    function start(body) {
      running = true;
      say('Producing your code...');
      return fetchCode(body).then(function (res) { if (render(res)) loop(); })
        .catch(function () { running = false; say('Your code could not be produced. Check your connection and try again.'); });
    }

    function loadLib() {
      if (libP) return libP;
      libP = new Promise(function (res, rej) {
        if (window.faceapi) { res(); return; }
        var s = document.createElement('script');
        s.src = LIB; s.async = true;
        s.onload = function () { res(); };
        s.onerror = function () { rej(new Error('face-model-script')); };
        document.head.appendChild(s);
      }).then(function () {
        var f = window.faceapi;
        if (!f) throw new Error('face-model-script');
        var back = Promise.resolve();
        if (f.tf) {
          back = Promise.resolve()
            .then(function () { return f.tf.setBackend('webgl'); })
            .catch(function () { return f.tf.setBackend('wasm'); })
            .catch(function () {})
            .then(function () { return f.tf.ready ? f.tf.ready() : null; })
            .catch(function () {});
        }
        return back.then(function () {
          return Promise.all([
            f.nets.tinyFaceDetector.loadFromUri(MODELS),
            f.nets.faceLandmark68TinyNet.loadFromUri(MODELS),
            f.nets.faceRecognitionNet.loadFromUri(MODELS)
          ]);
        });
      }).catch(function (e) { libP = null; throw e; });
      return libP;
    }

    function grab() {
      var f = window.faceapi;
      var opts = new f.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 });
      var deadline = Date.now() + 12000;
      function step() {
        return f.detectSingleFace(video, opts).withFaceLandmarks(true).withFaceDescriptor().then(function (d) {
          if (d && d.descriptor) return Array.prototype.slice.call(d.descriptor);
          if (Date.now() > deadline) return null;
          return new Promise(function (r) { setTimeout(r, 250); }).then(step);
        });
      }
      return step();
    }

    if (unlockBtn) unlockBtn.addEventListener('click', function () {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        say('This browser cannot open a camera, so the card is shown without a face check.');
        start({});
        return;
      }
      unlockBtn.disabled = true;
      say('Opening the camera...');
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false }).then(function (s) {
        stream = s;
        video.srcObject = s;
        viewer.hidden = false;
        say('Loading the face model...');
        return loadLib();
      }).then(function () {
        say('Looking for your face...');
        return grab();
      }).then(function (desc) {
        shutCamera();
        unlockBtn.disabled = false;
        if (!desc) { say('No face was found. Your card is shown without a face check; try again in better light.'); return start({}); }
        say('Checking...');
        return start({ descriptor: desc });
      }).catch(function (e) {
        shutCamera();
        unlockBtn.disabled = false;
        var n = (e && (e.name || e.message)) + '';
        say((/NotAllowed|denied|permission/i.test(n) ? 'The camera was not allowed.' : /face-model-script/.test(n) ? 'The face model could not load.' : 'The face check could not run.')
          + ' Your card is shown without a face check; that is fine.');
        start({});
      });
    });

    plainBtn.addEventListener('click', function () { grant = null; start({}); });

    // Coming back to the tab refreshes at once rather than showing a code that may have expired.
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && running) { clearTimeout(timer); fetchCode(grant ? { grant: grant } : {}).then(function (res) { if (render(res)) loop(); }); }
    });
  })();
</script>
</EmployeeShell>
