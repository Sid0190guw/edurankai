---
// /portal/employee/attendance — CHECK IN, CHECK OUT, BREAKS, AND THE WEEK'S TIMESHEET.
//
// =================================================================================================
// WHAT THIS PAGE IS
// =================================================================================================
//
// The surface the attendance engine was built for. hr_attendance and hr_clock_events have existed
// since the HR module was written and an employee has never had a screen to write to either: the
// only writer was the HR grid at /admin/hr/attendance, which an employee cannot open. So attendance
// was something done TO people. This is where a person records their own day.
//
// =================================================================================================
// THE BUTTONS ARE NEVER A LIE
// =================================================================================================
//
// The punch buttons are rendered from allowedPunches(), and the POST handler re-checks the same rule
// with punchRefusal() on the value that was actually posted. A rendered button is not an
// authorisation — it is a suggestion, and the write is where the rule binds. So "End break" is never
// offered when no break is running, and a stale tab that posts one anyway is told why, in a sentence.
//
// =================================================================================================
// GEO AND QR ARE EVIDENCE. THEY DECIDE NOTHING.
// =================================================================================================
//
// A location reading is attached to a punch when the browser offers one and the person agrees; a QR
// station code is attached when one is scanned or typed. NEITHER CAN REFUSE A PUNCH. The engine has
// no verdict column to write and this page has no branch that could use one. What the reader sees is
// a sentence — "recorded about 340 m from Head Office" — and a human decides what that means, if
// anything. Phone GPS indoors is routinely wrong by hundreds of metres, and a rule built on it would
// cost somebody a day's pay for standing next to a lift shaft.
//
// SCANNING WORKS WITH NO CAMERA LIBRARY. A station's QR encodes this URL with ?qr=<code> on it, so
// an ordinary phone camera opens the page with the field already filled. Typing the code printed
// under the QR does the same thing. No scanner bundle ships to anybody.
//
// =================================================================================================
// const BEFORE THE HANDLER
// =================================================================================================
//
// Every const this file's POST handler reads is declared ABOVE it. `const` is not hoisted, and a
// const declared under the handler throws on the handler's first line — the failure that took down
// apply step 5 and the /admin/roles/diagnose Repair button on this project, both of which reported
// success while failing every time.
//
// CLIENT JAVASCRIPT: one is:inline script, about 700 bytes, and the page is fully usable without it.
// It does one thing — asks the browser for a location and fills two hidden inputs — and it un-hides
// its own button, so a browser that blocks scripts never shows a control that does nothing.
//
// MOBILE FIRST. 360px is the design width, every control clears 44px, the timesheet scrolls inside
// its own container, and the page itself never scrolls sideways.
// THE BAR IS COMPOSED, NOT DECLARED. See the note beside <WorkspaceNav> at the foot of this file
// for what the hardcoded bar it replaces cost the person standing on this screen.
import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
import EmptyState from '@/components/workforce/EmptyState.astro';
import { requireEmployee } from '@/lib/auth/workspace-access';
import { composeWorkspace } from '@/lib/workforce/composer';
import {
  punch,
  punchesOn,
  punchLog,
  computeDay,
  allowedPunches,
  weeklyTimesheet,
  listHolidays,
  shiftOn,
  breakSegments,
  punctuality,
  dayAgainstShift,
  today as attendanceToday,
  weekStartIso,
  shiftDateIso,
  formatMinutes,
  minutesToHours,
  shiftSummary,
  PUNCH_LABELS,
  STATUS_LABELS,
  type PunchKind,
  type DayTotals,
  type Timesheet,
} from '@/lib/attendance';
import {
  hasFaceEnrolment,
  declinedVerification,
  verificationLine,
  verificationBadge,
  needsHumanLook,
} from '@/lib/attendance-verify';

const PATH = '/portal/employee/attendance';
const PUNCH_API = '/api/portal/attendance/punch';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

// ------------------------------------------------------------------------------------------------
// CONSTANTS AND HELPERS — ALL OF THEM ABOVE THE POST HANDLER.
// ------------------------------------------------------------------------------------------------

/** Plain words for a punch, from a function rather than a JSX-read map: a Record<string,string>
 *  indexed inside JSX is one of this project's known .astro parse hazards. */
function punchLabel(kind: string): string {
  if (kind === 'clock_in') return PUNCH_LABELS.clock_in;
  if (kind === 'clock_out') return PUNCH_LABELS.clock_out;
  if (kind === 'break_start') return PUNCH_LABELS.break_start;
  if (kind === 'break_end') return PUNCH_LABELS.break_end;
  return 'Record';
}

function statusLabel(status: string | null): string {
  if (status === 'present') return STATUS_LABELS.present;
  if (status === 'wfh') return STATUS_LABELS.wfh;
  if (status === 'on_leave') return STATUS_LABELS.on_leave;
  if (status === 'absent') return STATUS_LABELS.absent;
  if (status === 'holiday') return STATUS_LABELS.holiday;
  return '';
}

function sourceWord(source: string | null): string {
  if (source === 'self') return 'you recorded it';
  if (source === 'admin') return 'HR recorded it';
  if (source === 'leave') return 'from approved leave';
  if (source === 'correction') return 'from an approved correction';
  if (source === 'qr') return 'scanned at a station';
  return '';
}

/** Which tone the verification badge takes. A function, not a JSX-indexed map. */
function badgeClass(outcome: string | null): string {
  if (outcome === 'match') return 'vbadge good';
  // 'look' is amber, and it means SOMEBODY SHOULD GLANCE AT THIS - never red, because red on an
  // employee's own attendance reads as an accusation, and a mismatch decides nothing.
  if (needsHumanLook(outcome)) return 'vbadge look';
  return 'vbadge';
}

const clockTime = (iso: string | null) => {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  return String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0');
};

const dayLabel = (iso: string) => {
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};

// The gate. requireEmployee, because every hr_* table is keyed by employee_id and a screen about
// your own hours has nothing to scope to without one.
const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);

const workspace = gate.ok ? gate.workspace : null;
const employeeId = workspace ? workspace.employeeId : '';

let flash = '';
let flashError = '';
let advisory = '';
let verifyNote = '';

// ------------------------------------------------------------------------------------------------
// THE WRITE. One action, and it is re-checked inside the engine on the posted value.
// ------------------------------------------------------------------------------------------------
if (Astro.request.method === 'POST' && employeeId) {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get('action') || '');

    if (action === 'punch') {
      const kind = String(form.get('kind') || '');
      const latRaw = String(form.get('lat') || '');
      const lonRaw = String(form.get('lon') || '');
      const accRaw = String(form.get('acc') || '');
      // THIS IS THE NO-JAVASCRIPT PATH, AND IT IS A REAL PATH, NOT A DEGRADED ONE.
      //
      // A plain form POST cannot run a camera, so it records an HONEST 'no_capture' — a punch that
      // was not face-checked, labelled as one. It is deliberately NOT refused and deliberately not
      // left blank: refusing would lock out anybody without JavaScript, a working camera or the
      // patience for either, and leaving it blank would let an unverified punch pass for a verified
      // one on the screens that read the column.
      //
      // declinedVerification() is the only shape this path can produce. There is no request field
      // that could turn it into a pass, here or in /api/portal/attendance/punch.
      const res = await punch(employeeId, kind, {
        lat: latRaw ? Number(latRaw) : null,
        lon: lonRaw ? Number(lonRaw) : null,
        accuracy: accRaw ? Number(accRaw) : null,
        qrCode: String(form.get('qr') || '').trim() || null,
        workMode: String(form.get('mode') || 'remote'),
        ipAddress: Astro.request.headers.get('x-forwarded-for'),
        deviceInfo: Astro.request.headers.get('user-agent'),
        verification: declinedVerification('no_capture'),
      });
      if (res.ok) {
        flash = punchLabel(kind) + ' recorded.';
        advisory = res.advisory || '';
        verifyNote = verificationLine(res.verification ? res.verification.outcome : null);
      } else {
        // NEVER SWALLOWED. The engine's sentence is shown as it is, including the database's own
        // reason when the write itself failed. A punch that silently did nothing is how somebody
        // finds out at the end of the month that they have no attendance.
        flashError = res.error || 'That could not be recorded.';
      }
    } else {
      flashError = 'That is not something this page does.';
    }
  } catch (e: any) {
    flashError = 'We could not record that: ' + (e?.cause?.message || e?.message || 'unknown reason');
    console.error('[portal/attendance] post', e?.cause?.message || e?.message);
  }
}

// ------------------------------------------------------------------------------------------------
// READS
// ------------------------------------------------------------------------------------------------
const now = await attendanceToday();
const params = Astro.url.searchParams;
const qrPrefill = String(params.get('qr') || '').trim().slice(0, 120);
const weekParam = String(params.get('week') || '').trim();
const anchor = /^\d{4}-\d{2}-\d{2}$/.test(weekParam) ? weekParam : (now || '');

let totals: DayTotals | null = null;
let options: PunchKind[] = [];
let log: any[] = [];
let sheet: Timesheet | null = null;
let todayShift: any = null;
let upcomingHolidays: any[] = [];
// Breaks, punctuality and overtime are all DERIVED when somebody looks, and stored nowhere. See the
// punctuality() docblock in src/lib/attendance.ts for why a late_minutes column does not exist.
let breaks: any[] = [];
let punctualityNote = '';
let overtimeMinutes = 0;
// Whether to OFFER the camera, and whether to invite an enrolment. A boolean and nothing else — this
// page never needs the enrolled descriptor to draw a viewfinder, and shipping one to the browser is
// the exact defect src/lib/auth/face.ts was written to close (read it out of the page source, replay
// it, distance zero). Someone with no enrolment is never locked out; they are invited.
let faceEnrolled = false;

if (employeeId && now) {
  const events = await punchesOn(employeeId, now);
  totals = computeDay(events);
  options = allowedPunches(totals);
  log = await punchLog(employeeId, now);
  todayShift = await shiftOn(employeeId, now);
  sheet = await weeklyTimesheet(employeeId, anchor || now);
  upcomingHolidays = await listHolidays(now, shiftDateIso(now, 45), workspace?.department?.id || null);
  breaks = breakSegments(events);
  const punct = punctuality(todayShift, totals);
  punctualityNote = punct.sentence || '';
  const against = await dayAgainstShift(employeeId, now);
  overtimeMinutes = against ? against.overtimeMinutes : 0;
  faceEnrolled = await hasFaceEnrolment(String(user.id));
}

const prevWeek = sheet ? shiftDateIso(sheet.weekStart, -7) : '';
const nextWeek = sheet ? shiftDateIso(sheet.weekStart, 7) : '';
const thisWeek = now ? weekStartIso(now) : '';
const showsWeek = !!sheet;
const balanceMinutes = sheet ? sheet.totalMinutes - sheet.expectedMinutes : 0;

// ------------------------------------------------------------------------------------------------
// THE COMPOSITION, FOR THE NAVIGATION ONLY.
//
// Below the POST handler on purpose and safely: nothing in the handler reads it, and every write on
// this page ends in a redirect, so a punch costs no composition at all. It is the LAST await of the
// frontmatter for the same reason — the bar is the last thing rendered, and a failure here must not
// be able to stop the clock.
//
// composeWorkspace memoises on Astro.locals, so a page that already composed pays nothing; this one
// did not, so it is one composition. What it buys is described at the render site.
//
// NEVER THROWS OUT OF HERE. A nav that cannot be built renders no nav — the page still shows the
// clock, the week and the back link. A punch screen taken down by its own menu is the worse failure.
let composed: any = null;
try {
  composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
} catch (e: any) {
  console.error('[portal/attendance] compose', e?.cause?.message || e?.message);
}
---

<!doctype html>
<html lang="en" style="background:#F8F8F6;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Attendance - EduRankAI</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;background:#F8F8F6;color:#1B1813;padding-bottom:96px;
      font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
      -webkit-text-size-adjust:100%;}
    html,body{overflow-x:hidden;}
    .topbar{position:sticky;top:0;z-index:20;background:#FDFDFC;border-bottom:1px solid #DFDCD8;
      padding:14px 16px 10px;}
    .topbar h1{margin:0;font-size:1rem;font-weight:700;letter-spacing:-0.01em;}
    .topbar p{margin:4px 0 0;font-size:0.75rem;line-height:1.5;color:#564E43;}
    .tabs{display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;
      padding:10px 16px 2px;margin:0;scrollbar-width:thin;}
    .tab{flex:none;display:inline-flex;align-items:center;min-height:36px;padding:7px 12px;
      border:1px solid #DFDCD8;border-radius:999px;background:#FDFDFC;color:#564E43;
      font-size:0.8125rem;font-weight:600;text-decoration:none;white-space:nowrap;}
    .tab[aria-current="page"]{background:#1B1813;border-color:#1B1813;color:#FFFFFF;}
    .tab:focus-visible{outline:2px solid #6F52E5;outline-offset:2px;}
    .wrap{max-width:760px;margin:0 auto;padding:12px 12px 0;}
    .card{margin:12px 0 0;padding:13px;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;}
    .card h2{margin:0 0 6px;font-size:0.9375rem;font-weight:680;line-height:1.35;}
    .card p{margin:0;font-size:0.8125rem;line-height:1.55;color:#564E43;overflow-wrap:anywhere;}
    .ok{margin:12px 0 0;padding:10px 12px;border:1px solid #CBE3D2;border-radius:10px;
      background:#F1F8F3;font-size:0.8125rem;line-height:1.55;color:#1F5132;}
    .bad{margin:12px 0 0;padding:10px 12px;border:1px solid #EFCFCB;border-radius:10px;
      background:#FDF3F2;font-size:0.8125rem;line-height:1.55;color:#8A2C21;}
    .notice{margin:12px 0 0;padding:10px 12px;border:1px solid #EADECD;border-radius:10px;
      background:#FBF7F1;font-size:0.8125rem;line-height:1.55;color:#6D470D;}
    .stats{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 0;}
    .stat{flex:1 1 140px;padding:10px 12px;border:1px solid #DFDCD8;border-radius:10px;background:#FDFDFC;}
    .stat b{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
      font-size:1.125rem;line-height:1.2;}
    .stat span{display:block;margin-top:2px;font-size:0.6875rem;letter-spacing:0.06em;
      text-transform:uppercase;color:#70685C;}
    .punches{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0;}
    .punch{flex:1 1 140px;min-height:48px;padding:12px 14px;border:1px solid #1B1813;border-radius:10px;
      background:#1B1813;color:#FFFFFF;font:inherit;font-size:0.9375rem;font-weight:650;cursor:pointer;}
    .punch--soft{border-color:#DFDCD8;background:#FDFDFC;color:#1B1813;}
    .punch:focus-visible{outline:2px solid #6F52E5;outline-offset:2px;}
    .fields{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0;}
    .field{flex:1 1 100%;min-width:0;min-height:44px;padding:10px 12px;border:1px solid #DFDCD8;
      border-radius:8px;background:#FDFDFC;color:#1B1813;font:inherit;font-size:0.875rem;}
    .lab{display:block;margin:10px 0 4px;font-size:0.75rem;font-weight:650;color:#564E43;}
    .hint{margin:6px 0 0;font-size:0.75rem;line-height:1.55;color:#70685C;}
    .geo{min-height:44px;padding:10px 14px;border:1px solid #DFDCD8;border-radius:8px;background:#FDFDFC;
      color:#564E43;font:inherit;font-size:0.8125rem;font-weight:600;cursor:pointer;}
    .weeknav{display:flex;align-items:center;gap:8px;margin:12px 0 0;}
    .weeknav a{flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;min-height:44px;
      padding:10px 12px;border:1px solid #DFDCD8;border-radius:8px;background:#FDFDFC;color:#564E43;
      font-size:0.8125rem;font-weight:600;text-decoration:none;}
    .weeknav b{flex:2 1 auto;text-align:center;font-size:0.8125rem;}
    /* The timesheet is wide. It gets its own scroller; the PAGE never gets one. */
    .sheetbox{margin:10px 0 0;overflow-x:auto;-webkit-overflow-scrolling:touch;
      border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;}
    table{border-collapse:collapse;width:100%;min-width:560px;font-size:0.8125rem;}
    th,td{padding:9px 10px;text-align:left;border-bottom:1px solid #EFEDE9;white-space:nowrap;}
    th{font-size:0.6875rem;letter-spacing:0.06em;text-transform:uppercase;color:#70685C;font-weight:650;}
    tr:last-child td{border-bottom:none;}
    td.today{font-weight:700;}
    .rows{list-style:none;margin:10px 0 0;padding:0;}
    .row{padding:10px 12px;border:1px solid #DFDCD8;border-radius:10px;background:#FDFDFC;margin-bottom:8px;}
    .row p{margin:0;font-size:0.875rem;line-height:1.5;overflow-wrap:anywhere;}
    .row small{display:block;margin-top:3px;font-size:0.75rem;color:#70685C;overflow-wrap:anywhere;}
    .links{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 0;}
    .links a{flex:1 1 160px;display:inline-flex;align-items:center;justify-content:center;min-height:44px;
      padding:10px 12px;border:1px solid #DFDCD8;border-radius:8px;background:#FDFDFC;color:#1B1813;
      font-size:0.8125rem;font-weight:600;text-decoration:none;}
    .foot{margin:16px 0 0;padding:12px 2px;border-top:1px solid #DFDCD8;font-size:0.75rem;
      line-height:1.6;color:#70685C;}
    /* THE FACE PANEL. Hidden until the script un-hides it, so a browser with no camera and no
       JavaScript never sees a control that does nothing. 360px first: the viewfinder is fluid and
       every control clears 44px. */
    .facebox{margin:12px 0 0;padding:13px;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;}
    .facebox h3{margin:0 0 6px;font-size:0.875rem;font-weight:680;}
    .facebox p{margin:0 0 8px;font-size:0.8125rem;line-height:1.55;color:#564E43;}
    .privacy{margin:0 0 10px;padding:10px 12px;border:1px solid #D6D2EC;border-radius:10px;
      background:#F5F3FD;font-size:0.8125rem;line-height:1.55;color:#312A5B;}
    .privacy b{font-weight:680;}
    .viewer{position:relative;width:100%;max-width:320px;margin:0 auto 10px;aspect-ratio:3/4;
      border-radius:12px;overflow:hidden;background:#1B1813;}
    .viewer video{width:100%;height:100%;object-fit:cover;transform:scaleX(-1);display:block;}
    .facebtns{display:flex;flex-wrap:wrap;gap:8px;}
    .facebtns button{flex:1 1 100%;min-height:48px;padding:12px 14px;border-radius:10px;font:inherit;
      font-size:0.9375rem;font-weight:650;cursor:pointer;border:1px solid #1B1813;
      background:#1B1813;color:#FFFFFF;}
    .facebtns button.soft{border-color:#DFDCD8;background:#FDFDFC;color:#1B1813;}
    .facebtns button:focus-visible{outline:2px solid #6F52E5;outline-offset:2px;}
    .facestate{margin:8px 0 0;font-size:0.8125rem;line-height:1.55;color:#564E43;}
    .vbadge{display:inline-flex;align-items:center;gap:5px;margin-top:4px;padding:3px 8px;
      border:1px solid #DFDCD8;border-radius:999px;background:#F4F3F0;
      font-size:0.6875rem;font-weight:650;color:#564E43;}
    .vbadge svg{width:12px;height:12px;flex:none;}
    .vbadge.good{border-color:#CBE3D2;background:#F1F8F3;color:#1F5132;}
    .vbadge.look{border-color:#EADECD;background:#FBF7F1;color:#6D470D;}
    @media (min-width:480px){ .facebtns button{flex:1 1 45%;} }
    @media (min-width:640px){ .field{flex:1 1 240px;} }
  </style>
</head>
<body>
  <header class="topbar">
    <h1>Attendance</h1>
    <p>{workspace ? workspace.fullName : 'Your working day'}</p>
  </header>

  <nav class="tabs" aria-label="Attendance">
    <a class="tab" href={PATH} aria-current="page">Today and this week</a>
    <a class="tab" href={PATH + '/overtime'}>Overtime</a>
    <a class="tab" href="/portal/employee/timesheet">Timesheet</a>
    <a class="tab" href={PATH + '/corrections'}>Corrections</a>
    <a class="tab" href={PATH + '/approvals'}>Waiting on me</a>
    <a class="tab" href={PATH + '/roster'}>Shifts and roster</a>
    <a class="tab" href="/portal/employee/calendar">Calendar</a>
  </nav>

  <main class="wrap">
    {!gate.ok && (
      <EmptyState
        title={gate.title || 'This screen is not available'}
        body={gate.reason || 'Your employee record is what this screen is built from.'}
        illustration="note"
        actionLabel="Back to your workspace"
        actionHref="/portal/employee"
      />
    )}

    {gate.ok && !now && (
      <p class="bad">
        We could not read today's date from the database, so nothing on this page is partitioned by
        day and no punch can be recorded right now. Nothing you have logged is lost. Try again in a
        moment, and tell HR if it keeps happening.
      </p>
    )}

    {flash && <p class="ok">{flash}</p>}
    {verifyNote && <p class="notice">{verifyNote}</p>}
    {advisory && <p class="notice">{advisory} This is a note kept with your punch. It changes nothing about your day and nobody is penalised by it.</p>}
    {flashError && <p class="bad">{flashError}</p>}

    {gate.ok && now && totals && (
      <section class="card">
        <h2>Today</h2>
        <p>
          {totals.clockIn ? 'Checked in at ' + clockTime(totals.clockIn) : 'Not checked in yet'}
          {totals.clockOut ? ', checked out at ' + clockTime(totals.clockOut) : ''}
          {totals.onBreak ? '. On a break now.' : ''}
        </p>
        <div class="stats">
          <div class="stat"><b>{formatMinutes(totals.workedMinutes) || '0m'}</b><span>worked today</span></div>
          <div class="stat"><b>{formatMinutes(totals.breakMinutes) || '0m'}</b><span>on break</span></div>
          <div class="stat"><b>{todayShift ? shiftSummary(todayShift) : 'None'}</b><span>rostered shift</span></div>
        </div>

        <form method="POST" action={PATH} id="punch-form">
          <input type="hidden" name="action" value="punch" />
          <input type="hidden" name="lat" id="geo-lat" value="" />
          <input type="hidden" name="lon" id="geo-lon" value="" />
          <input type="hidden" name="acc" id="geo-acc" value="" />
          {/* Carries the punch kind on the one path that has no submit button: the native fallback
              the script uses when the API itself cannot be reached. DISABLED, so it is not
              submitted on any ordinary press and the button's own name/value wins. */}
          <input type="hidden" name="kind" id="fallback-kind" value="" disabled />

          <label class="lab" for="mode">Where are you working from</label>
          <select class="field" id="mode" name="mode">
            <option value="remote">Remote</option>
            <option value="onsite">On site</option>
            <option value="hybrid">Hybrid</option>
          </select>

          <label class="lab" for="qr">Station code, if you scanned one</label>
          <input class="field" id="qr" name="qr" type="text" maxlength="120" value={qrPrefill}
            autocomplete="off" placeholder="Leave empty if you did not scan" />
          <p class="hint">
            Scanning a station QR with your phone camera opens this page with the code already filled
            in. A code that is not recognised is still kept with your punch, exactly as it was read.
          </p>

          <button class="geo" type="button" id="geo-btn" hidden>Attach my location to this punch</button>
          <p class="hint" id="geo-state"></p>

          <div class="punches">
            {options.map((k) => (
              <button class={k === 'clock_out' || k === 'break_start' ? 'punch punch--soft' : 'punch'}
                type="submit" name="kind" value={k}>{punchLabel(k)}</button>
            ))}
          </div>
        </form>

        {/* THE CAPTURE PANEL.
            data-* attributes rather than define:vars, which cannot be combined with is:inline on
            this project. Hidden until the script un-hides it: a browser with no camera API keeps the
            plain buttons above and never sees a control that would do nothing. */}
        <div class="facebox" id="face-panel" hidden data-api={PUNCH_API} data-enrolled={faceEnrolled ? '1' : '0'}>
          <h3>Face check</h3>

          {/* SAID AT THE MOMENT OF CAPTURE, NOT BURIED IN A POLICY. A person is entitled to know
              what a camera pointed at their face is doing, while it is pointed at their face. */}
          <p class="privacy">
            <b>No photo is taken and none is kept.</b> The camera preview stays on this phone. What is
            checked is a mathematical signature of your face - 128 numbers - which is compared on our
            server against the one you enrolled, and then discarded. Nothing is uploaded, saved to
            your record or shown to anybody, and there is no image of you stored anywhere from this.
          </p>

          <div class="viewer" id="face-viewer" hidden>
            {/* playsinline AND muted: iOS Safari refuses to play an inline camera stream without
                both, and takes the video full screen instead. autoplay for everyone else. */}
            <video id="face-video" playsinline autoplay muted></video>
          </div>

          <p class="facestate" id="face-state"></p>

          <div class="facebtns">
            <button type="button" id="face-skip" class="soft" hidden>Record without the face check</button>
            <button type="button" id="face-cancel" class="soft" hidden>Cancel and turn the camera off</button>
          </div>

          {!faceEnrolled && (
            <p class="hint">
              No face is enrolled on your account yet, so there is nothing to check against and your
              punches are recorded without one. That is entirely fine and nothing is marked against
              you. If you would like to use it, <a href="/portal/face-setup">enrol your face</a> -
              it takes about a minute, and it is one of several ways to sign in, never an extra
              hurdle on top of your password.
            </p>
          )}
        </div>
      </section>
    )}

    {gate.ok && (breaks.length > 0 || punctualityNote || overtimeMinutes > 0) && (
      <section class="card">
        <h2>Breaks and the shift</h2>
        {breaks.length > 0 && (
          <ul class="rows">
            {breaks.map((b) => (
              <li class="row">
                <p>Break · {formatMinutes(b.minutes) || 'just started'}</p>
                <small>{clockTime(b.start)}{b.end ? ' to ' + clockTime(b.end) : ' · still running, so it is not counted as worked time'}</small>
              </li>
            ))}
          </ul>
        )}
        {breaks.length > 0 && (
          <div class="stats">
            <div class="stat"><b>{breaks.length}</b><span>breaks today</span></div>
            <div class="stat"><b>{totals ? (formatMinutes(totals.workedMinutes) || '0m') : '0m'}</b><span>net worked, breaks out</span></div>
          </div>
        )}
        {/* ADVISORY ONLY, and stored nowhere - see the punctuality() docblock in
            src/lib/attendance.ts. Nothing counts these, nothing sorts by them, and nobody is
            penalised by one. A human reads it and decides what it means, if anything. */}
        {punctualityNote && <p class="notice">{punctualityNote}</p>}
        {overtimeMinutes > 0 && (
          <p class="hint">
            Your punches show {formatMinutes(overtimeMinutes)} over the rostered shift today. Extra
            hours are never credited automatically. <a href={PATH + '/overtime'}>Claim them</a> and
            your manager decides.
          </p>
        )}
      </section>
    )}

    {gate.ok && log.length > 0 && (
      <section class="card">
        <h2>Today's punches</h2>
        <ul class="rows">
          {log.map((e) => (
            <li class="row">
              <p>{punchLabel(e.kind)} at {clockTime(e.at)}</p>
              <small>
                {e.stationLabel ? 'Scanned at ' + e.stationLabel + '. ' : ''}
                {!e.stationLabel && e.qrCodeRaw ? 'Code read: ' + e.qrCodeRaw + ' (not a recorded station). ' : ''}
                {e.lat !== null && e.lon !== null ? 'A location reading was kept with this punch. ' : 'No location reading.'}
                {e.accuracy !== null && e.accuracy > 200 ? 'The phone called it accurate to about ' + Math.round(e.accuracy) + ' m.' : ''}
              </small>
              {/* AN UNVERIFIED PUNCH IS VISIBLY UNVERIFIED. Without this the feature means nothing:
                  a check nobody can see the result of is a check nobody ran. Monochrome inline SVG,
                  never an emoji. */}
              <span class={badgeClass(e.faceOutcome)}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>
                  {e.faceVerified === true && <path d="M9 12l2 2 4-4"></path>}
                  {e.faceVerified !== true && <path d="M12 9v3.5"></path>}
                  {e.faceVerified !== true && <path d="M12 16h.01"></path>}
                </svg>
                {verificationBadge(e.faceOutcome)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {showsWeek && sheet && (
      <section class="card">
        <h2>This week</h2>
        <div class="weeknav">
          <a href={PATH + '?week=' + prevWeek}>Earlier</a>
          <b>{dayLabel(sheet.weekStart)} to {dayLabel(sheet.weekEnd)}</b>
          <a href={PATH + '?week=' + nextWeek}>Later</a>
        </div>

        <div class="stats">
          <div class="stat"><b>{minutesToHours(sheet.totalMinutes)}</b><span>hours recorded</span></div>
          <div class="stat"><b>{sheet.noRoster ? 'None' : minutesToHours(sheet.expectedMinutes)}</b><span>hours expected</span></div>
          <div class="stat"><b>{sheet.noRoster ? '-' : (balanceMinutes >= 0 ? '+' : '') + minutesToHours(balanceMinutes)}</b><span>difference</span></div>
        </div>

        {sheet.noRoster && (
          <p class="notice">
            No shift is rostered for you, so there is nothing to compare your hours against. That is a
            missing roster entry rather than a problem with your hours. HR sets this on the Shifts and
            roster screen.
          </p>
        )}

        <div class="sheetbox">
          <table>
            <thead>
              <tr><th>Day</th><th>Status</th><th>In</th><th>Out</th><th>Worked</th><th>Expected</th><th>Where it came from</th></tr>
            </thead>
            <tbody>
              {sheet.days.map((d) => (
                <tr>
                  <td class={d.isToday ? 'today' : ''}>{d.weekday.slice(0, 3)} {dayLabel(d.dateIso)}</td>
                  <td>{d.holiday ? d.holiday.name : statusLabel(d.status) || (d.isWorkingDay ? 'Nothing recorded' : 'Not a working day')}</td>
                  <td>{clockTime(d.clockIn)}</td>
                  <td>{clockTime(d.clockOut)}</td>
                  <td>{d.workedMinutes ? formatMinutes(d.workedMinutes) : ''}</td>
                  <td>{d.expectedMinutes ? formatMinutes(d.expectedMinutes) : ''}</td>
                  <td>{sourceWord(d.source)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="links">
          <a href={PATH + '?week=' + thisWeek}>This week</a>
          <a href={PATH + '/corrections'}>Ask for a day to be corrected</a>
        </div>
      </section>
    )}

    {gate.ok && upcomingHolidays.length > 0 && (
      <section class="card">
        <h2>Holidays coming up</h2>
        <ul class="rows">
          {upcomingHolidays.map((h) => (
            <li class="row">
              <p>{h.name}</p>
              <small>{dayLabel(h.dateIso)}{h.departmentName ? ', ' + h.departmentName + ' only' : ', whole organization'}{h.isOptional ? ', optional' : ''}</small>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="foot">
      The face check never stores a photograph. Your camera stays on your own device, the frame is
      discarded the moment a signature is read from it, and only that signature - 128 numbers - is
      sent to be compared against the one you enrolled. It is compared and then dropped. What is kept
      beside your punch is the answer: checked, or not checked. A check that does not match never
      refuses your punch, never reduces your hours and never decides anything on its own; it is
      marked for a person to look at, because cameras and lighting fail far more often than people
      do. You can record every punch without a face check and nothing is held against you for it.
    </p>

    <p class="foot">
      Your punches are recorded against your own employee record and nobody else's. A location
      reading or a scanned station code is kept as evidence beside a punch and is never used to
      refuse one, mark one as suspicious or reduce anybody's hours: a person decides what a reading
      means, and phone location is often wrong indoors. To change a day that is already recorded, ask
      for a correction; it goes to your reporting manager, who is resolved from the organization
      graph rather than from anybody's job title.
    </p>
  </main>

  {/* THE COMPOSED BAR. This was `<BottomNav variant="hr" active="" label="Primary" />` — a static
      four-tab list (Home, Tasks, Community, My HR) with no capability test of any kind, and it cost
      the person standing on this screen four separate things:

        1. NO WAY OUT. The bar is a row of links and cannot hold a form, so the sign-out lives in the
           WorkspaceNav drawer. This page had no drawer, therefore no sign-out — on the one portal
           screen most likely to be opened on a shared phone at a punch station, by somebody who then
           hands it to the next person.
        2. NO APPROVALS. `approvals` is a ranked destination for anybody the composition authorises
           it for, and it was simply absent here. A manager who clocks in and then wants to clear the
           queue routed to them had to type the URL.
        3. active="" ON EVERY RENDER. Nothing carried aria-current, so a screen-reader user standing
           on Attendance was read four identical links and told nothing about where they were. WCAG
           2.2 SC 3.2.3 wants this bar to match the one on Home; it did not, in content or in state.
        4. Home pointed at /portal for everyone. buildWorkspaceNav resolves it per person, so an
           employee's Home is /portal/employee rather than a redirect through a router.

      The bar now physically matches Home, Approvals and Calendar, and the lit tab is resolved from
      the path — so it is Attendance, and Corrections and the roster below light it too. No badges
      are passed: this page has not counted anything, and a count it did not resolve is a number it
      would be inventing. */}
  {composed && <WorkspaceNav composed={composed} />}

  <script is:inline>
    // PROGRESSIVE ENHANCEMENT ONLY. The punch buttons work without this. It asks the browser for a
    // location and fills three hidden inputs, and it un-hides its own button so a browser with no
    // JavaScript or no geolocation never shows a control that does nothing. Nothing here can refuse
    // a punch: it only fills fields the server treats as evidence.
    (function () {
      var btn = document.getElementById('geo-btn');
      var state = document.getElementById('geo-state');
      if (!btn || !state || !navigator.geolocation) return;
      btn.hidden = false;
      btn.addEventListener('click', function () {
        state.textContent = 'Asking your browser for a location...';
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            document.getElementById('geo-lat').value = String(pos.coords.latitude);
            document.getElementById('geo-lon').value = String(pos.coords.longitude);
            document.getElementById('geo-acc').value = String(pos.coords.accuracy || '');
            state.textContent = 'A location will be attached to your next punch. It is a note, not a check.';
          },
          function () {
            state.textContent = 'Your browser did not share a location. Your punch still works exactly the same.';
          },
          { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 }
        );
      });
    })();
  </script>

  <script is:inline>
    // =============================================================================================
    // FACE CHECK AT THE MOMENT OF PUNCHING. NO IMAGE LEAVES THIS DEVICE, AND NONE IS KEPT ON IT.
    // =============================================================================================
    //
    // WHAT THIS SENDS: 128 numbers. That is the whole payload. The camera frame is never drawn to a
    // canvas by this page, never turned into a data URI, never put in a FormData, never uploaded.
    // The model reads the live <video> element directly and returns a descriptor; shutCamera() then
    // stops every MediaStream track (so the camera light goes out), pauses the element, drops
    // srcObject and hides the viewer. That happens BEFORE the descriptor is posted, on every exit
    // path including cancel, failure and leaving the page.
    //
    // WHAT THIS DOES NOT SEND: a distance, a score, a verdict. The comparison is done on the server
    // against a descriptor the server never hands out. Nothing this file could lie about would
    // change the answer.
    //
    // PROGRESSIVE ENHANCEMENT, AND THE FALLBACKS ARE REAL PATHS.
    //   - No JavaScript: the punch buttons above are an ordinary form POST. Recorded, unverified.
    //   - No camera API, camera refused, camera broken, no face found, model would not download:
    //     the punch is still recorded, unverified, and the screen says which of those happened.
    //   - No face enrolled: no camera is opened at all - there would be nothing to compare against -
    //     and the panel invites an enrolment instead of blocking a punch.
    //   - The API itself unreachable: nativeFallback() submits the plain form, so the worst case is
    //     still a recorded punch.
    // NOTHING HERE CAN REFUSE A PUNCH. There is no branch in this file that ends without one.
    //
    // LAZY: the model script and its weights are requested on the FIRST TAP of a punch button and
    // never before, so anybody who opens this page to read their timesheet downloads none of it.
    // iOS: getUserMedia is called synchronously inside the click gesture (an await before it breaks
    // the gesture chain and Safari refuses), and the element carries playsinline + muted or Safari
    // takes it full screen.
    (function () {
      var panel = document.getElementById('face-panel');
      var form = document.getElementById('punch-form');
      if (!panel || !form) return;

      var video = document.getElementById('face-video');
      var viewer = document.getElementById('face-viewer');
      var state = document.getElementById('face-state');
      var skipBtn = document.getElementById('face-skip');
      var cancelBtn = document.getElementById('face-cancel');
      var fallbackKind = document.getElementById('fallback-kind');
      var api = panel.getAttribute('data-api') || '';
      var enrolled = panel.getAttribute('data-enrolled') === '1';
      var hasCam = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.fetch);

      // DELIBERATELY THE SAME TWO URLS AS /portal/enroll-face, CHARACTER FOR CHARACTER.
      //
      // A descriptor is only comparable to one produced by the same pipeline: the same recognition
      // weights, aligned by the same landmark net. Verification that loaded a different build than
      // enrolment would drift the distance for reasons that have nothing to do with whose face it
      // is, and the person would be told their own face did not match. Matching the URLs also means
      // anybody who has already enrolled has all of this in their HTTP cache.
      //
      // FOLLOW-UP, AND IT BELONGS TO ENROLMENT AS MUCH AS TO THIS PAGE: the model URL floats on
      // @latest while the library is pinned. If the CDN's @latest ever moves, descriptors enrolled
      // before the move stop matching descriptors captured after it - for everybody at once, with no
      // error anywhere, looking exactly like every employee's face suddenly changed. Pinning it is a
      // one-word change; it needs doing in the same commit in all three places (this page,
      // /portal/enroll-face, /portal/face-setup) or it causes the very drift it prevents.
      var LIB = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.min.js';
      var MODELS = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';

      var stream = null;
      var busy = false;
      var lastBtn = null;
      var libP = null;

      panel.hidden = false;

      function say(t) { if (state) state.textContent = t; }

      // EVERY TRACE OF THE CAMERA, GONE. Called on success, failure, cancel and page hide.
      function shutCamera() {
        try { if (stream) { stream.getTracks().forEach(function (t) { try { t.stop(); } catch (_) {} }); } } catch (_) {}
        stream = null;
        try { video.pause(); } catch (_) {}
        try { video.srcObject = null; } catch (_) {}
        try { video.removeAttribute('src'); } catch (_) {}
        viewer.hidden = true;
        cancelBtn.hidden = true;
      }

      function val(id) {
        var el = document.getElementById(id);
        return el && el.value ? el.value : null;
      }

      function reload() { window.location.href = window.location.pathname + window.location.search; }

      // LAST RESORT: the API could not be reached at all. Submit the plain form so the person still
      // gets their punch. form.submit() does not fire the submit listener, so this cannot loop.
      function nativeFallback(kind) {
        try {
          fallbackKind.value = kind;
          fallbackKind.disabled = false;
          form.submit();
        } catch (_) {
          say('We could not reach the server to record that. Check your connection and try again - nothing has been recorded yet, and nothing is lost.');
          busy = false;
        }
      }

      function post(kind, descriptor, skip) {
        var body = {
          kind: kind,
          lat: val('geo-lat'), lon: val('geo-lon'), acc: val('geo-acc'),
          qr: val('qr'), mode: val('mode') || 'remote'
        };
        // Either a descriptor or an explicit skip. There is no third field, and no field that
        // asserts a result - the server would not read one.
        if (skip) { body.skipFace = true; } else { body.descriptor = descriptor; }
        return fetch(api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body)
        }).then(function (r) {
          return r.json().catch(function () {
            return { ok: false, error: 'The server answered in a way we could not read. Reload the page to see whether your punch was recorded.' };
          });
        });
      }

      // Load the model only when somebody actually punches. Failure clears the cache so a second
      // tap retries rather than the whole feature staying broken for the life of the page.
      function loadLib() {
        if (libP) return libP;
        libP = new Promise(function (res, rej) {
          if (window.faceapi) { res(); return; }
          var s = document.createElement('script');
          s.src = LIB;
          s.async = true;
          s.onload = function () { res(); };
          s.onerror = function () { rej(new Error('face-model-script')); };
          document.head.appendChild(s);
        }).then(function () {
          var f = window.faceapi;
          if (!f) throw new Error('face-model-script');
          var back = Promise.resolve();
          if (f.tf) {
            // The backend must be initialised before detection or detect() throws "backend not
            // initialized". WebGL where it exists, wasm where it does not.
            back = Promise.resolve()
              .then(function () { return f.tf.setBackend('webgl'); })
              .catch(function () { return f.tf.setBackend('wasm'); })
              .catch(function () {})
              .then(function () { return f.tf.ready ? f.tf.ready() : null; })
              .catch(function () {});
          }
          return back.then(function () {
            return Promise.all([
              f.nets.tinyFaceDetector.loadFromUri(MODELS),
              f.nets.faceLandmark68TinyNet.loadFromUri(MODELS),
              f.nets.faceRecognitionNet.loadFromUri(MODELS)
            ]);
          });
        }).catch(function (e) { libP = null; throw e; });
        return libP;
      }

      // Read the LIVE ELEMENT. No canvas is created here and no frame object outlives this call.
      function grab() {
        var f = window.faceapi;
        var opts = new f.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 });
        var deadline = Date.now() + 12000;
        function tick() {
          return f.detectSingleFace(video, opts).withFaceLandmarks(true).withFaceDescriptor()
            .then(function (d) {
              if (d && d.descriptor) return Array.prototype.slice.call(d.descriptor);
              if (Date.now() > deadline) return null;
              return new Promise(function (r) { setTimeout(r, 250); }).then(tick);
            });
        }
        return tick();
      }

      function finish(res, kind) {
        busy = false;
        skipBtn.hidden = true;
        if (!res || !res.ok) {
          say((res && res.error) || 'That could not be recorded. Nothing is lost - try again.');
          return;
        }
        // The outcome sentence comes from the server, so the screen cannot claim a pass the server
        // did not measure. The badge on the punch below is the permanent record of it.
        say(res.verificationLine || 'Recorded.');
        setTimeout(reload, 4500);
      }

      function camFail(e, kind) {
        shutCamera();
        busy = false;
        var name = (e && (e.name || e.message)) + '';
        var why = /NotAllowed|Security|denied|permission/i.test(name)
          ? 'The camera was not allowed, so there is no face check on this punch.'
          : /NotFound|DevicesNotFound/i.test(name)
          ? 'No camera was found on this device, so there is no face check on this punch.'
          : /NotReadable|TrackStart/i.test(name)
          ? 'The camera is being used by another app, so there is no face check on this punch.'
          : /face-model-script/i.test(name)
          ? 'The face model could not be downloaded, so there is no face check on this punch.'
          : 'The face check could not run, so there is none on this punch.';
        say(why + ' Your attendance is not affected: tap the button below and it is recorded without one. Nothing is marked against you for this.');
        skipBtn.hidden = false;
        skipBtn.setAttribute('data-kind', kind);
      }

      // Remember which button was pressed, for browsers without event.submitter.
      var btns = form.querySelectorAll('button[type="submit"]');
      for (var i = 0; i < btns.length; i++) {
        btns[i].addEventListener('click', function () { lastBtn = this; });
      }

      skipBtn.addEventListener('click', function () {
        var kind = skipBtn.getAttribute('data-kind') || (lastBtn && lastBtn.value) || '';
        if (!kind || busy) return;
        busy = true;
        shutCamera();
        say('Recording without a face check.');
        post(kind, null, true)
          .then(function (r) { finish(r, kind); })
          .catch(function () { nativeFallback(kind); });
      });

      cancelBtn.addEventListener('click', function () {
        shutCamera();
        busy = false;
        say('Camera off. Nothing was captured or sent. You can punch again whenever you are ready.');
        skipBtn.hidden = false;
      });

      // Leaving the page must never leave a camera running.
      window.addEventListener('pagehide', shutCamera);

      if (!hasCam) {
        say('This browser cannot open a camera for us, so your punches are recorded without a face check. That is fine and nothing is marked against you.');
        return;
      }
      if (!enrolled) {
        // Nothing to compare against. Opening a camera would be intrusive and pointless, so the
        // plain form POST is left to do its job and the panel above invites an enrolment.
        return;
      }

      form.addEventListener('submit', function (ev) {
        var btn = ev.submitter || lastBtn;
        var kind = btn && btn.value ? btn.value : '';
        if (!kind) return;              // nothing identifiable was pressed: let the form do its job
        if (busy) { ev.preventDefault(); return; }

        ev.preventDefault();
        busy = true;
        skipBtn.hidden = false;
        skipBtn.setAttribute('data-kind', kind);
        cancelBtn.hidden = false;
        say('Starting the camera. No photo is taken and nothing is uploaded.');

        // FIRST, INSIDE THE GESTURE. iOS Safari refuses a camera started after an await.
        var camP;
        try {
          camP = navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user', width: { ideal: 480 } },
            audio: false
          });
        } catch (e) { camP = Promise.reject(e); }

        camP.then(function (s) {
          stream = s;
          video.setAttribute('playsinline', '');
          video.muted = true;
          video.srcObject = s;
          viewer.hidden = false;
          var p = video.play();
          if (p && p.catch) { p.catch(function () {}); }
          say('Look at the camera. The picture stays on this phone and only a signature is checked.');
          return loadLib();
        }).then(function () {
          say('Checking your face. No photo is being taken.');
          return grab();
        }).then(function (descriptor) {
          // CAMERA OFF AND FRAME DROPPED BEFORE ANYTHING IS SENT.
          shutCamera();
          if (!descriptor) {
            say('We could not find a face clearly enough in the time we allowed. Recording your punch without a face check - nothing is marked against you.');
            return post(kind, null, true);
          }
          say('Checking with the server. Your punch is being recorded either way.');
          return post(kind, descriptor, false);
        }).then(function (res) {
          finish(res, kind);
        }).catch(function (e) {
          // A fetch failure is the one case where the punch has not been recorded at all, so it
          // falls back to the plain form rather than being reported as a face problem.
          if (e && /fetch|network|Failed to fetch/i.test((e.message || '') + '')) {
            shutCamera();
            nativeFallback(kind);
            return;
          }
          camFail(e, kind);
        });
      });
    })();
  </script>
</body>
</html>
