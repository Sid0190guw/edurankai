---
// /portal/employee/contract — YOUR OWN CONTRACT. Read-only, and scoped to one person: you.
//
// SCOPE. Every query below is filtered by `ws.employeeId`, which requireEmployee() resolved from the
// SESSION. There is no employee id in the URL and no query string this page reads, so there is no
// id to change in the address bar and no way to arrive at somebody else's terms.
//
// READ-ONLY, DELIBERATELY. A person cannot amend their own contract here, and a renewal is not
// something they can grant themselves — those are requests raised on /admin/hr/contracts and routed
// for approval. What this page owes them is the truth about what they are engaged under, including
// the parts that are unflattering: an unpaid internship says "Unpaid", never a blank that reads as
// "not filled in yet".
import { requireEmployee } from '@/lib/auth/workspace-access';
// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and header,
// in a second page design that thirteen other pages also carried a copy of. EmployeeShell owns
// all of it now, for every page in the portal — one bar, one tab style, one palette. The page
// keeps its own <style> for the components only it renders, marked is:global so those rules
// still reach <body> and the chrome the shell draws.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import {
  ensureContractSchema,
  contractsForEmployee,
  listContractChanges,
  contractPayLabel,
  contractTypeLabel,
} from '@/lib/contracts';

const PAGE = '/portal/employee/contract';

// THE GATE FIRST, before any query — so nothing is read that this caller is not entitled to.
const gate = await requireEmployee(Astro.locals.user, PAGE);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);

const ws = gate.ok ? gate.workspace : null;
const denial = gate.ok ? null : gate;

// Constants before anything that reads them. `const` is not hoisted.
const fmtDate = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

function changeStateLabel(s: string): string {
  const k = String(s || '');
  if (k === 'pending') return 'Waiting for approval';
  if (k === 'approved') return 'Approved';
  if (k === 'applied') return 'Applied';
  if (k === 'rejected') return 'Not approved';
  if (k === 'cancelled') return 'Withdrawn';
  if (k === 'halted') return 'Waiting on HR';
  return k;
}

let contracts: any[] = [];
let changes: any[] = [];
if (ws) {
  await ensureContractSchema();
  contracts = await contractsForEmployee(ws.employeeId);
  changes = await listContractChanges({ employeeId: ws.employeeId, limit: 30 });
}

const current = contracts.find((c) => c.status === 'active') || null;
const past = contracts.filter((c) => c.status !== 'active');
const openChanges = changes.filter((c) => c.state === 'pending' || c.state === 'halted' || c.state === 'approved');
const title = 'My contract';
---
<EmployeeShell title="My contract" width={620} bottomPad={48} bare>

  <div class="wrap">
    {denial ? (
      <div class="deny">
        <h2>{denial.title}</h2>
        <p class="lede">{denial.reason}</p>
      </div>
    ) : (
      <>
        {/* An h2: the page's h1 is the one EmployeeShell renders in the bar. */}
        <h2 class="pagehead">My contract</h2>
        <p class="lede">
          What you are engaged as, from when, and until when. If anything here is wrong, tell HR — this
          page shows the record rather than editing it, and a change to a contract is approved before it
          takes effect.
        </p>

        {current ? (
          <div class="card">
            <h3>In force</h3>
            <p class="headline">{contractTypeLabel(current.contractType)}</p>
            <p class="sub">
              {fmtDate(current.startDate)}{current.endDate ? ' to ' + fmtDate(current.endDate) : ' — open-ended, with no end date'}
            </p>
            <dl>
              <div><dt>Remuneration</dt><dd>{contractPayLabel(current)}</dd></div>
              <div><dt>Notice period</dt><dd>{current.noticeDays === null ? 'Not recorded' : current.noticeDays + ' days'}</dd></div>
              <div><dt>Renewal review</dt><dd>{current.renewalDueDate ? fmtDate(current.renewalDueDate) : 'Not set'}</dd></div>
              <div>
                <dt>Signed terms</dt>
                <dd>{current.termsUrl ? <a href={current.termsUrl} target="_blank" rel="noopener">Open the document</a> : 'No link recorded'}</dd>
              </div>
            </dl>
            {current.note && <p class="note">{current.note}</p>}
          </div>
        ) : (
          <div class="empty">
            No contract has been recorded against your employee record yet. That does not change what you
            were told when you joined — it means the register has not caught up. Ask HR to record it.
          </div>
        )}

        {openChanges.length > 0 && (
          <div class="card">
            <h3>Change in progress</h3>
            {openChanges.map((c: any) => (
              <div class="histrow">
                <p class="headline" style="font-size:15px;">
                  {c.changeKind === 'renewal' ? 'Renewal' : 'Amendment'}
                  {' '}
                  <span class={c.state === 'approved' ? 'chip live' : 'chip wait'}>{changeStateLabel(c.state)}</span>
                </p>
                <p class="sub">{c.reason}</p>
                {c.proposedEndDate && <p class="note">Proposed new end date: {fmtDate(c.proposedEndDate)}</p>}
                {c.state === 'halted' && (
                  <p class="note">
                    This is waiting on HR to record who approves it. Nothing has been decided and nothing has changed.
                  </p>
                )}
              </div>
            ))}
          </div>
        )}

        {past.length > 0 && (
          <div class="card">
            <h3>Earlier contracts</h3>
            {past.map((c: any) => (
              <div class="histrow">
                <p class="hist">
                  <strong>{contractTypeLabel(c.contractType)}</strong> — {fmtDate(c.startDate)}
                  {c.endDate ? ' to ' + fmtDate(c.endDate) : ''}
                </p>
                <p class="sub">{contractPayLabel(c)}</p>
              </div>
            ))}
            <p class="note">
              Earlier contracts are kept rather than overwritten, so what you were engaged under at any past
              date is still readable.
            </p>
          </div>
        )}
      </>
    )}
  </div>
</EmployeeShell>

<style is:global>
  /* This page's own components, lifted out of the <head> it used to write for itself. The
     reset, <body>, the top bar, the tab strip and the column now come from EmployeeShell; the
     colours are its --emp-* tokens rather than hexes, so the palette is one edit and not
     thirty-four. Anything here loads after the shell and still wins. */
    .pagehead { font-size: 22px; font-weight: 700; margin: 0 0 4px; }
    .lede { font-size: 13.5px; color: var(--emp-muted); line-height: 1.6; margin: 0 0 16px; }
    .card { background:var(--emp-surface); border: 1px solid var(--emp-line); border-radius: 16px; padding: 18px; margin-bottom: 14px; box-shadow: 0 10px 30px rgba(26,21,16,.05); }
    .card h3 { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--emp-dim); font-weight: 700; margin: 0 0 12px; }
    .headline { font-size: 19px; font-weight: 700; margin: 0 0 2px; }
    .sub { font-size: 13px; color: var(--emp-muted); margin: 0; line-height: 1.55; }
    dl { display: grid; gap: 9px; margin: 14px 0 0; }
    dl > div { display: flex; justify-content: space-between; gap: 14px; align-items: baseline; border-bottom: 1px dashed var(--emp-line); padding-bottom: 8px; }
    dt { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--emp-dim); font-weight: 700; }
    dd { font-size: 14px; text-align: right; color: var(--emp-ink); }
    dd a { color: var(--emp-accent); min-height: 44px; display: inline-flex; align-items: center; }
    .chip { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; padding: 4px 9px; border-radius: 100px; border: 1px solid var(--emp-line-2); color: var(--emp-muted); }
    .chip.live { color: #15803d; border-color: #bbf7d0; background: #f0fdf4; }
    .chip.wait { color: #b45309; border-color: #fde68a; background: #fffbeb; }
    .note { font-size: 12.5px; color: var(--emp-muted); line-height: 1.6; margin: 10px 0 0; }
    .empty { background:var(--emp-surface); border: 1px dashed #e0d5c0; border-radius: 16px; padding: 30px 18px; text-align: center; color: #8a7f6d; font-size: 13.5px; line-height: 1.6; }
    .deny { background:var(--emp-surface); border: 1px solid var(--emp-line); border-radius: 16px; padding: 24px 20px; }
    .deny h2 { font-size: 17px; margin: 0 0 8px; }
    .hist { font-size: 13px; color: var(--emp-muted); margin: 0; }
    .histrow { border-bottom: 1px dashed var(--emp-line); padding: 10px 0; }
    .histrow:last-child { border-bottom: none; }
  
</style>
