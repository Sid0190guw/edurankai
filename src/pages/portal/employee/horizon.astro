---
// /portal/employee/horizon — YOUR OWN TIME RECORD, AND WHAT THIS SYSTEM SAYS ABOUT IT.
//
// =================================================================================================
// WHY THE PERSON SEES THIS FIRST
// =================================================================================================
//
// A system that composes statements about somebody's development and shows them only to their
// manager is a system that person cannot correct. Every sentence here names the rows it came from,
// so a reading built on a table nobody has been filling in is visibly that, and can be said so.
//
// NOTHING ON THIS PAGE IS A DECISION AND NOTHING ON IT IS A SCORE. The long horizons carry a
// confidence that is capped by the length of the question rather than the size of the record: a
// twenty-year panel cannot show more than 0.10 however complete the file is, because the limit there
// is the claim, not the data.
//
// MOBILE FIRST: 360px, every control at least 44px, nothing scrolls sideways.
import { requireEmployee } from '@/lib/auth/workspace-access';
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
import {
  readHorizonsFor,
  HORIZONS,
  HORIZON_SPECS,
  LAYER_LABELS,
  LAYER_MEANING,
  CONFIDENCE_BAND_LABELS,
  confidenceBand,
  PROJECTION_DISCLAIMER,
  type Horizon,
} from '@/lib/horizon/temporal';

const PATH = '/portal/employee/horizon';

// Every const declared BEFORE anything that reads it. `const` is not hoisted, and a template
// reaching a later declaration has taken pages down on this project.
const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

const gate = await requireEmployee(user as any, PATH);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);
const workspace = gate.ok ? gate.workspace : null;
const employeeId = workspace ? workspace.employeeId : '';

const requested = String(Astro.url.searchParams.get('h') || 'month');
const active: Horizon = (HORIZONS as readonly string[]).indexOf(requested) >= 0
  ? (requested as Horizon)
  : 'month';

let view: Awaited<ReturnType<typeof readHorizonsFor>> | null = null;
let loadError = '';
if (employeeId) {
  try {
    // holds() answers false for everything: on your own record you are here because it is yours,
    // never because you hold a capability. Passing a real capability test would make this screen a
    // second door into other people's records the day somebody reuses it.
    view = await readHorizonsFor({ viewerUserId: String(user.id), employeeId, holds: () => false });
  } catch (e: any) {
    loadError = e?.cause?.message || e?.message || 'unknown';
  }
}

// A REFUSAL IS AN ANSWER AND HAS TO BE PRINTED.
//
// readHorizonsFor() returns { access, set: null } when horizonAccess() refuses — deliberately, so a
// caller cannot render a reading it was not granted. But every panel below is conditional on
// `reading` or `cycles`, both of which come off `set`, so a refusal rendered the lede, the seven
// tabs, and then nothing at all: no error, no reason, no hint that anything had been withheld. The
// engine already composes the sentence; this is only a matter of putting it on the screen.
const accessRefused = !!view && view.access && view.access.granted === false;
const accessBecause = accessRefused ? String(view!.access.because || '') : '';

const reading = view?.set?.readings?.[active] || null;
const blind = view?.set?.blind === true;
const blindSentence = view?.set?.blindSentence || '';
const cycles = view?.set?.cycles || null;
const notVersioned = view?.notYetVersioned || [];
const isNotVersioned = notVersioned.indexOf(active) >= 0;
const storedFor = view?.stored?.[active] || null;

// Comparisons hoisted out of the template: `<` and `<=` inside a JSX expression break .astro parsing.
const confValue = reading ? reading.confidence.value : 0;
const confBand = confidenceBand(confValue);
const confLabel = CONFIDENCE_BAND_LABELS[confBand];
const confPct = Math.round(confValue * 100);
const ceilingPct = reading ? Math.round(reading.confidence.ceiling * 100) : 0;
const underspanned = reading ? reading.confidence.underspanned : false;
const hasSignals = reading ? reading.sections.some((s) => s.signals.length > 0) : false;

const tabs = HORIZONS.map((h) => ({
  key: h,
  label: HORIZON_SPECS[h].label,
  href: PATH + '?h=' + h,
  current: h === active,
}));

const readableSources = reading ? reading.evidenceSources.filter((s) => !s.unreadable) : [];
const unreadableSources = reading ? reading.evidenceSources.filter((s) => s.unreadable) : [];
---

<EmployeeShell title="Time record" documentTitle="Time record" width={720}>
  <section class="hz">
    <p class="hz-lede">
      What this platform can say about your work over different stretches of time, and the records
      each statement came from. Nothing here is a decision, a rating or a score.
    </p>

    {loadError && (
      <p class="hz-err">
        We could not build your time record just now. This is a fault on our side, not a finding
        about your work. ({loadError})
      </p>
    )}

    {/* THE GATE'S OWN SENTENCE, NOT A GUESS AT WHICH DENIAL IT WAS.
        requireEmployee() sets `redirect` for exactly one code, not-signed-in, which the frontmatter
        already handled. The other four — no-employee-record, ambiguous-record, inactive and
        lookup-failed — arrive here with a title and a reason and were being collapsed into the one
        hardcoded sentence below, so somebody whose record simply could not be READ was told the
        people desk had not linked them, and went and asked for something they already had. This is
        the same defect that put a joiner on the applicant shell with nowhere to mark attendance. */}
    {!employeeId && !loadError && !gate.ok && (
      <div class="hz-err">
        <p><b>{gate.title}</b></p>
        <p>{gate.reason}</p>
      </div>
    )}

    {accessRefused && !loadError && (
      <p class="hz-err">{accessBecause}</p>
    )}

    <nav class="hz-tabs" aria-label="Time horizons">
      {tabs.map((t) => (
        <a href={t.href} class={t.current ? 'hz-tab is-on' : 'hz-tab'} aria-current={t.current ? 'page' : undefined}>
          {t.label}
        </a>
      ))}
    </nav>

    {blind && (
      <p class="hz-err">{blindSentence}</p>
    )}

    {reading && !blind && (
      <article class="hz-panel">
        <header class="hz-head">
          <h2>{reading.label}</h2>
          <p class="hz-hint">{reading.hint}</p>
          <p class="hz-window">
            Reading records from {reading.lookback.fromDay} to {reading.lookback.toDay}
            {' '}({reading.lookback.days} days).
          </p>
        </header>

        <div class="hz-conf">
          <div class="hz-conf-bar" role="img" aria-label={'Confidence ' + confPct + ' per cent'}>
            <span class="hz-conf-fill" style={'width:' + confPct + '%'}></span>
            <span class="hz-conf-cap" style={'left:' + ceilingPct + '%'}></span>
          </div>
          <p class="hz-conf-txt">
            <strong>{confLabel}</strong> &middot; {confPct} of a possible {ceilingPct} for this horizon.
          </p>
          <p class="hz-conf-why">{reading.confidence.sentence}</p>
          <details>
            <summary>How that number was worked out</summary>
            <ul class="hz-terms">
              {reading.confidence.terms.map((t) => (
                <li><b>{t.name}</b> &middot; {t.value} <span>{t.because}</span></li>
              ))}
            </ul>
          </details>
        </div>

        {underspanned && (
          <p class="hz-warn">
            The record behind this horizon is shorter than the horizon itself. Read anything about
            the future as a direction to talk about, not as a finding.
          </p>
        )}

        {isNotVersioned && (
          <p class="hz-note">
            This horizon has not been saved as a version yet, so what you are reading was worked out
            just now. Once it is saved, this page and the audit trail show the same words.
          </p>
        )}

        {storedFor && (
          <p class="hz-note">
            Saved version computed {storedFor.computedAt.slice(0, 10)} by engine {storedFor.engineVersion}.
            It stays on file when a newer one replaces it.
          </p>
        )}

        {!hasSignals && (
          <p class="hz-note">
            There is nothing to report for this stretch of time. That is a statement about the
            records, not about your work.
          </p>
        )}

        {reading.sections.map((sec) => (
          <section class="hz-sec">
            <h3>{sec.label}</h3>
            {sec.note && <p class="hz-secnote">{sec.note}</p>}
            {sec.silence && <p class="hz-silence">{sec.silence}</p>}
            <ul class="hz-signals">
              {sec.signals.map((s) => (
                <li class={'hz-sig lay-' + s.layer}>
                  <p class="hz-sig-stmt">{s.statement}</p>
                  <p class="hz-sig-meta">
                    <span class="hz-chip">{LAYER_LABELS[s.layer]}</span>
                    <span class="hz-chip-w">{s.decisionWeight === 'none' ? 'Decides nothing' : 'May support a decision'}</span>
                  </p>
                  <details>
                    <summary>Where this came from</summary>
                    <p class="hz-lay">{LAYER_MEANING[s.layer]}</p>
                    <p><b>Records used</b> &middot; {s.inputs.join('; ')}</p>
                    <p><b>How</b> &middot; {s.processing}</p>
                    {s.evidence.length > 0 && (
                      <ul class="hz-ev">
                        {s.evidence.map((e) => (
                          <li>{e.table} &middot; {e.rowCount} rows &middot; {e.window}{e.unreadable ? ' (could not be read)' : ''}</li>
                        ))}
                      </ul>
                    )}
                    <p class="hz-ts">Worked out {s.computedAt.slice(0, 10)}.</p>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <p class="hz-disc">{PROJECTION_DISCLAIMER}</p>
      </article>
    )}

    {cycles && (
      <article class="hz-panel hz-cycles">
        <h2>Where you are in the cycles</h2>
        <p class="hz-hint">Timing and cadence, worked out from dates on your employment record.</p>
        {cycles.readings.map((c) => (
          <div class="hz-cycle">
            <h4>{c.cycleName}</h4>
            <p class="hz-phase">{c.phase}</p>
            <div class="hz-conf-bar sm"><span class="hz-conf-fill" style={'width:' + c.positionPct + '%'}></span></div>
            <p class="hz-cycle-mean">{c.meaning}</p>
            <details>
              <summary>Dates this used</summary>
              <ul class="hz-ev">{c.inputs.map((i) => (<li>{i}</li>))}</ul>
            </details>
          </div>
        ))}
        {cycles.refusals.map((r) => (
          <p class="hz-silence">{r.because}</p>
        ))}
        <p class="hz-disc">{cycles.disclaimer}</p>
      </article>
    )}

    {reading && (readableSources.length > 0 || unreadableSources.length > 0) && (
      <article class="hz-panel">
        <h2>Every record this read</h2>
        <ul class="hz-src">
          {readableSources.map((s) => (
            <li>
              <b>{s.label}</b> &middot; {s.rowCount} rows
              <span class="hz-src-why">{s.evidences} {s.because}</span>
            </li>
          ))}
          {unreadableSources.map((s) => (
            <li class="bad">
              <b>{s.label}</b> &middot; could not be read
              <span class="hz-src-why">{s.because}</span>
            </li>
          ))}
        </ul>
      </article>
    )}
  </section>
</EmployeeShell>

<style is:global>
  .hz { display: block; }
  .hz-lede { margin: 0 0 14px; color: var(--emp-muted, #5b5b55); line-height: 1.5; }
  .hz-err {
    margin: 0 0 14px; padding: 12px 14px; border-radius: 10px; line-height: 1.5;
    background: #fdf2f2; border: 1px solid #e6c9c9; color: #7a2e2e;
  }
  .hz-tabs {
    display: flex; gap: 6px; overflow-x: auto; padding: 2px 0 10px; margin: 0 0 14px;
    scrollbar-width: none;
  }
  .hz-tabs::-webkit-scrollbar { display: none; }
  .hz-tab {
    flex: 0 0 auto; min-height: 44px; display: inline-flex; align-items: center; padding: 0 14px;
    border-radius: 999px; border: 1px solid var(--emp-line, #e2e0da); text-decoration: none;
    color: var(--emp-ink, #24241f); background: #fff; font-size: 14px; white-space: nowrap;
  }
  .hz-tab.is-on { background: var(--emp-ink, #24241f); color: #fff; border-color: var(--emp-ink, #24241f); }
  .hz-panel {
    border: 1px solid var(--emp-line, #e2e0da); border-radius: 14px; padding: 16px;
    margin: 0 0 16px; background: #fff;
  }
  .hz-head h2, .hz-panel h2 { margin: 0 0 4px; font-size: 20px; }
  .hz-hint { margin: 0 0 6px; color: var(--emp-muted, #5b5b55); font-size: 14px; line-height: 1.5; }
  .hz-window { margin: 0 0 14px; color: var(--emp-muted, #5b5b55); font-size: 13px; }
  .hz-conf { margin: 0 0 14px; }
  .hz-conf-bar {
    position: relative; height: 10px; border-radius: 999px; background: #f0efea; overflow: hidden;
  }
  .hz-conf-bar.sm { height: 6px; margin: 6px 0; }
  .hz-conf-fill { position: absolute; inset: 0 auto 0 0; background: var(--emp-ink, #24241f); }
  .hz-conf-cap { position: absolute; top: -3px; bottom: -3px; width: 2px; background: #c0392b; }
  .hz-conf-txt { margin: 8px 0 2px; font-size: 14px; }
  .hz-conf-why { margin: 0 0 6px; color: var(--emp-muted, #5b5b55); font-size: 13px; line-height: 1.5; }
  .hz-terms { margin: 6px 0 0; padding-left: 18px; font-size: 13px; line-height: 1.6; }
  .hz-terms span { color: var(--emp-muted, #5b5b55); display: block; }
  .hz-warn, .hz-note, .hz-silence {
    margin: 0 0 12px; padding: 10px 12px; border-radius: 10px; font-size: 13px; line-height: 1.55;
  }
  .hz-warn { background: #fff8e6; border: 1px solid #e8d9a8; color: #6b5410; }
  .hz-note { background: #f4f6f8; border: 1px solid #dde3e8; color: #3a4a57; }
  .hz-silence { background: #f7f7f5; border: 1px solid #e6e4dd; color: #55554e; }
  .hz-sec { border-top: 1px solid var(--emp-line, #e2e0da); padding-top: 14px; margin-top: 14px; }
  .hz-sec h3 { margin: 0 0 6px; font-size: 16px; }
  .hz-secnote { margin: 0 0 8px; font-size: 13px; color: #6b5410; background: #fff8e6;
    border: 1px solid #e8d9a8; border-radius: 8px; padding: 8px 10px; line-height: 1.5; }
  .hz-signals { list-style: none; margin: 0; padding: 0; }
  .hz-sig { border-left: 3px solid #d9d7d0; padding: 0 0 0 12px; margin: 0 0 14px; }
  .hz-sig.lay-observed { border-left-color: #2f6f4f; }
  .hz-sig.lay-current { border-left-color: #24241f; }
  .hz-sig.lay-projected { border-left-color: #8a6d1f; }
  .hz-sig.lay-foundational { border-left-color: #6b5b8a; }
  .hz-sig-stmt { margin: 0 0 6px; line-height: 1.55; }
  .hz-sig-meta { margin: 0 0 6px; display: flex; gap: 6px; flex-wrap: wrap; }
  .hz-chip, .hz-chip-w {
    font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--emp-line, #e2e0da);
    color: var(--emp-muted, #5b5b55);
  }
  .hz-chip-w { background: #f7f7f5; }
  .hz-sig details, .hz-cycle details { font-size: 13px; }
  .hz-sig summary, .hz-cycle summary, .hz-conf summary {
    cursor: pointer; min-height: 44px; display: flex; align-items: center;
    color: var(--emp-muted, #5b5b55);
  }
  .hz-sig details p, .hz-cycle details p { margin: 4px 0; line-height: 1.5; }
  .hz-lay { color: var(--emp-muted, #5b5b55); font-style: italic; }
  .hz-ev { margin: 4px 0; padding-left: 18px; color: var(--emp-muted, #5b5b55); line-height: 1.6; }
  .hz-ts { color: var(--emp-muted, #5b5b55); font-size: 12px; }
  .hz-disc {
    margin: 14px 0 0; padding: 12px 14px; border-radius: 10px; background: #f7f7f5;
    border: 1px solid #e6e4dd; font-size: 13px; line-height: 1.55; color: #55554e;
  }
  .hz-cycle { border-top: 1px solid var(--emp-line, #e2e0da); padding-top: 12px; margin-top: 12px; }
  .hz-cycle h4 { margin: 0 0 2px; font-size: 15px; }
  .hz-phase { margin: 0; font-size: 14px; }
  .hz-cycle-mean { margin: 4px 0 6px; font-size: 13px; color: var(--emp-muted, #5b5b55); line-height: 1.55; }
  .hz-src { list-style: none; margin: 8px 0 0; padding: 0; }
  .hz-src li { padding: 8px 0; border-bottom: 1px solid #f0efea; font-size: 14px; }
  .hz-src li.bad b { color: #7a2e2e; }
  .hz-src-why { display: block; color: var(--emp-muted, #5b5b55); font-size: 13px; line-height: 1.5; }
  @media (max-width: 400px) {
    .hz-panel { padding: 13px; }
  }
</style>
