---
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { getBalance, listTxns, listBankAccounts, addBankAccount, requestWithdrawal, listWithdrawals } from '@/lib/hr-wallet';
// THE ONE RESOLVER. See the block below for what this page used to do instead.
import { resolveEmployeeIdentity } from '@/lib/workforce/identity';

// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');
// =================================================================================================
// "NO EMPLOYEE PROFILE LINKED" IS A CLAIM, AND THIS PAGE COULD NOT MAKE IT
// =================================================================================================
//
// The lookup below sat inside `catch (_) {}`. Any failure of either SELECT — an unreachable pooler, a
// table not yet provisioned, a permission error — left `employee` null, and the render then told the
// person "No employee profile linked. Ask HR to link your account." That is a definite statement of
// fact about somebody's own pay, produced by a read that never completed. They go and ask HR about a
// link that already exists, HR sees it, and neither of them can see the actual reason.
//
// The two states are now distinct: null WITH lookupError is UNKNOWN and says so; null WITHOUT one is
// genuinely not linked. Nothing else about the page changes — a failed read still shows no balance,
// because there is no balance to show, but it no longer blames the employee's record for it.
//
// =================================================================================================
// THE LOOKUP IS NO LONGER WRITTEN HERE, AND IT WAS THE MOST DANGEROUS COPY OF IT IN THE PORTAL
// =================================================================================================
//
// This block was:
//
//     SELECT * FROM hr_employees WHERE user_id = $1 AND is_active = true LIMIT 1
//     SELECT * FROM hr_employees
//      WHERE (work_email = $2 OR personal_email = $2 OR email = $2) AND is_active = true LIMIT 1
//
// Three things were wrong with it, and this is the page where they cost the most.
//
// `SELECT *` on hr_employees pulls pan_number, aadhaar_number, bank_account_number, bank_ifsc and
// base_salary into the render process. This page reads exactly two fields off the row — `id` and
// `full_name` — so every one of those was fetched for nothing. Nothing renders them, but a page
// that has them in scope is one careless interpolation away from printing them, and there is no
// reason for them to be here at all.
//
// The email comparison was CASE-SENSITIVE, where the canonical resolver compares lower() to lower().
// A record typed `Priya.S@…` and an account spelled `priya.s@…` are the same person everywhere else
// in the product and were "no employee profile linked" here.
//
// And `LIMIT 1` PICKED where it should have REFUSED. None of the three email columns has a unique
// constraint. Two records under one address — a shared inbox typed into `email`, an address entered
// on the wrong row — and this page would open one person's wallet, bank accounts and withdrawal
// history to the other, silently, forever. requireEmployee() takes LIMIT 2 for exactly that reason
// and refuses; resolveEmployeeIdentity() carries that refusal here as a denial the page renders.
//
// The self-heal write (stamping user_id onto a record matched by address) is not lost: it lives in
// workspace-access.ts, runs there, and logs its own failure.
//
// Declared ABOVE the POST handler that reads them; `const`/`let` are not hoisted.
const identity = await resolveEmployeeIdentity(user, '/portal/employee/wallet');
const employee: { id: string; full_name: string } | null = identity.ok
  ? { id: identity.identity.employeeId, full_name: identity.identity.fullName }
  : null;
// Only 'lookup-failed' means "we do not know". Every other denial is a fact about this account, and
// the sentence for it comes from the gate rather than being invented again on this page.
const lookupError: string | null = identity.ok ? null : (identity.failed ? identity.denial.reason : null);
const denial = identity.ok ? null : identity.denial;
if (denial?.redirect) return Astro.redirect(denial.redirect);

let flash = '';
if (Astro.request.method === 'POST' && employee) {
  const fd = await Astro.request.formData();
  const action = fd.get('action');
  if (action === 'add_bank') {
    const holder = (fd.get('holder') as string || '').trim();
    const acc = (fd.get('account_number') as string || '').trim();
    const ifsc = (fd.get('ifsc') as string || '').trim();
    if (holder && acc && (ifsc || fd.get('upi_id'))) { await addBankAccount(employee.id, { holder, account_number: acc, ifsc, bank_name: (fd.get('bank_name') as string || ''), upi_id: (fd.get('upi_id') as string || '') }); flash = 'Bank account saved.'; }
    else flash = 'Account holder, number and IFSC (or a UPI id) are required.';
  } else if (action === 'request_withdrawal') {
    const amount = parseFloat(fd.get('amount') as string || '0');
    const bankId = (fd.get('bank_account_id') as string || '') || null;
    const r = await requestWithdrawal(employee.id, amount, bankId, (fd.get('note') as string || ''));
    // "PENDING APPROVAL" IS ONLY TRUE IF SOMEBODY WAS ASKED.
    //
    // This line said it unconditionally, and requestWithdrawal() used to write the row and return —
    // the function that creates the approval instance and notifies the approver ran only when
    // somebody later happened to load a DIFFERENT page. So the screen asserted a chain that did not
    // exist. The request now enters the chain here, and when the Organization Graph cannot name an
    // approver it HALTS with a readable sentence rather than vanishing; this says which happened.
    flash = r.ok
      ? (r.halted
          ? 'Withdrawal requested. It is NOT yet with an approver: ' + (r.haltReason || 'no approver could be resolved.')
            + ' The amount is held against your balance until it is decided.'
          : 'Withdrawal requested and sent to your approver.')
      : (r.error || 'Could not request.');
  }
  return Astro.redirect('/portal/employee/wallet?msg=' + encodeURIComponent(flash));
}

// =================================================================================================
// A ZERO BALANCE IS THREE DIFFERENT FACTS AND THIS PAGE PRINTED ONE NUMBER FOR ALL THREE
// =================================================================================================
//
// getBalance() reads through hr-wallet's safe() helper, which logs a failed read and returns no
// rows. The SUM over no rows is 0. So an unreachable pooler, a wallet ledger that has never had a
// row written to it, and a genuinely spent-down wallet all rendered the same 44px currency zero at
// the top of the page, with nothing underneath saying which. "You have no money" is not a sentence
// a screen may produce from a read that did not complete.
//
// This probe asks one question the SUM cannot: can the ledger be read at all. It selects a single
// row and throws it away - no ordering, no aggregate, nothing that can fail for a reason other than
// the table being unreachable. The comparison is written the same way listTxns() writes it, with no
// ::uuid cast, so it cannot fail on a type mismatch the real read would not have hit.
const bal = employee
  ? await getBalance(employee.id)
  : { balance: 0, currency: 'INR', pending: 0, available: 0, otherCurrencies: [] };
let ledgerReadable = true;
if (employee) {
  try {
    await db.execute(sql`SELECT 1 FROM hr_wallet_txn WHERE employee_id = ${employee.id} LIMIT 1`);
  } catch (e: any) {
    ledgerReadable = false;
    console.error('[portal/employee/wallet] wallet ledger unreadable -', e?.cause?.message || e?.message);
  }
}
const txns = employee ? await listTxns(employee.id, 20) : [];
const banks = employee ? await listBankAccounts(employee.id) : [];
const withdrawals = employee ? await listWithdrawals({ employeeId: employee.id }) : [];
const msg = new URL(Astro.request.url).searchParams.get('msg') || '';
// The wallet's OWN currency, not an assumed rupee sign. getBalance() resolves it from the salary
// structure and sums only rows denominated in it; printing every figure with a hard-coded ₹ is how a
// USD salary credit came to be read as rupees on this very screen.
const sym = (cur: string) => (cur === 'INR' ? '₹' : cur + ' ');
const amt = (n: any, cur: string = bal.currency) =>
  sym(cur) + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const inr = (n: any) => amt(n);
// Darkened: #d97706 and #059669 were 3.2:1 and 3.8:1 on the near-white pill, under the
// 4.5:1 floor, on 10px uppercase text that is the only thing saying whether the money
// is on its way.
const statusColor: Record<string, string> = { pending: '#b45309', approved: '#2563eb', paid: '#046c4e', rejected: '#b91c1c', failed: '#b91c1c' };
---
<EmployeeShell title="Wallet" documentTitle="My wallet" person={employee?.full_name || user.name} width={560} bottomPad={40} bare>
<div class="wrap">
  {/* role="status": this sentence is the only confirmation that a withdrawal was asked
      for, and it arrived silently for anyone not looking at the top of the page. */}
  {msg && <div role="status" style="background:rgba(5,150,105,.1);border:1px solid rgba(5,150,105,.3);color:#065f46;border-radius:10px;padding:11px 14px;font-size:13px;margin-bottom:14px;">{msg}</div>}

  {!employee && lookupError && (<div class="card" role="alert" style="text-align:center;padding:34px;"><p style="font-weight:600;">Your wallet could not be loaded</p><p style="font-size:13px;color:var(--emp-muted);margin-top:6px;">Your employee record could not be read just now, so this page cannot say whether you have a wallet or what is in it. Nothing has changed and nothing has been lost. Try again in a few minutes; if it keeps happening, tell HR that the wallet page reported: {lookupError}</p></div>)}

  {/* The sentence comes from the gate, so "no record is linked", "more than one record uses your
      address" and "your record is closed" each say their own thing. This used to print one line —
      "Ask HR to link your account" — at all three, which sends two of those three people to ask for
      something that is not the problem. */}
  {!employee && !lookupError && denial && (<div class="card" style="text-align:center;padding:34px;"><p style="font-weight:600;">{denial.title}</p><p style="font-size:13px;color:var(--emp-muted);margin-top:6px;">{denial.reason}</p></div>)}

  {employee && (<div>
    <div class="card" style="background:linear-gradient(160deg,var(--emp-ink),#2b241b);color:#faf6ef;border:none;">
      <h3 style="color:rgba(250,246,239,.6);">Available balance</h3>

      {!ledgerReadable && (
        <div role="alert">
          <div style="font-family:'Fraunces',serif;font-size:30px;font-weight:600;line-height:1.15;">Not known right now</div>
          <p style="font-size:12.5px;line-height:1.6;color:rgba(250,246,239,.8);margin-top:10px;">
            Your wallet ledger could not be read, so no balance is shown. This is deliberately not a
            zero: money may well be in there. Nothing has been lost and nothing has been paid out.
            Try again in a few minutes, and tell HR if it keeps happening.
          </p>
        </div>
      )}

      {ledgerReadable && (
        <div>
          <div style="font-family:'Fraunces',serif;font-size:44px;font-weight:600;line-height:1;">{inr(bal.available)}</div>
          <div style="display:flex;gap:22px;margin-top:14px;font-size:12px;">
            <div><div style="color:rgba(250,246,239,.55);font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;">In wallet</div><div style="font-weight:700;margin-top:2px;">{inr(bal.balance)}</div></div>
            <div><div style="color:rgba(250,246,239,.55);font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;">Pending withdrawal</div><div style="font-weight:700;margin-top:2px;color:#fbbf24;">{inr(bal.pending)}</div></div>
          </div>

          {/* WHAT THE NUMBER COUNTS, BESIDE THE NUMBER. Three figures in a currency, with no period
              and no source, are unreadable to somebody seeing them for the first time. */}
          <p style="font-size:11.5px;line-height:1.6;color:rgba(250,246,239,.72);margin-top:12px;">
            In wallet is everything credited to you since you joined, less everything already paid out.
            Pending withdrawal is what you have asked for and is not yet decided; it is held back, which
            is why available balance is the smaller figure and the only one you can withdraw against.
          </p>

          {bal.balance === 0 && bal.pending === 0 && (
            <p style="font-size:12.5px;line-height:1.65;color:rgba(250,246,239,.85);margin-top:10px;border-top:1px solid rgba(250,246,239,.15);padding-top:10px;">
              Your wallet was read and is genuinely empty. Nothing has been credited to it yet, and on
              day one that is expected rather than wrong. Money reaches it in two ways: net pay, when a
              payroll run that includes you is marked paid, and an expense claim or reimbursement, once
              it is approved. If your engagement is unpaid, no payroll credit will ever arrive here and
              a reimbursed expense is the only thing that will.
            </p>
          )}
        </div>
      )}
      {/* Money held in another currency is never added into the balance above — there is no exchange
          rate in this system — but it must not be invisible either, or an employee is simply not
          shown money that is theirs. */}
      {bal.otherCurrencies.length > 0 && (
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid rgba(250,246,239,.15);font-size:12px;color:rgba(250,246,239,.75);">
          You also hold {bal.otherCurrencies.map((o) => amt(o.balance, o.currency)).join(', ')}. That is a
          different currency, so it is not part of the balance above and cannot be withdrawn from this
          form. Ask HR to settle it.
        </div>
      )}
    </div>

    <div class="card">
      <h3>Withdraw to bank</h3>
      {banks.length === 0
        ? <p style="font-size:13px;color:var(--emp-muted);">Connect a bank account below before you can withdraw.</p>
        : (<form method="POST">
            <input type="hidden" name="action" value="request_withdrawal"/>
            {/* Every label here was floating free of its field: no `for`, and not wrapping
                the input either, so a screen reader read each one as "edit text, blank". */}
            <label for="wAmount">Amount (max {inr(bal.available)})</label>
            <input id="wAmount" name="amount" type="number" step="0.01" min="1" max={bal.available} required placeholder="0.00"/>
            <label for="wBank">To account</label>
            <select id="wBank" name="bank_account_id" required>{banks.map((b: any) => (<option value={b.id}>{b.holder} · {b.account_masked || b.upi_id} {b.is_primary ? '(primary)' : ''}</option>))}</select>
            <label for="wNote">Note (optional)</label>
            <input id="wNote" name="note" placeholder="For example, advance against June salary"/>
            <button class="btn btn-full" style="margin-top:12px;">Request withdrawal</button>
            <p style="font-size:11.5px;color:var(--emp-muted);margin-top:8px;line-height:1.5;">Withdrawals are approved by your reporting manager, HR or an administrator, then paid to your bank via the payment gateway.</p>
          </form>)}
    </div>

    {withdrawals.length > 0 && (<div class="card"><h3>Your withdrawals</h3>
      {withdrawals.map((w: any) => (
        <div class="ledger">
          <div><div style="font-weight:600;">{inr(w.amount)}</div><div style="font-size:11px;color:var(--emp-muted);">{new Date(w.requested_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'})}{w.note ? ' · ' + w.note : ''}</div></div>
          <span class="pill" style={`color:${statusColor[w.status]||'var(--emp-muted)'};background:${(statusColor[w.status]||'var(--emp-muted)')}18;`}>{w.status}</span>
        </div>
      ))}
    </div>)}

    <div class="card"><h3>Bank accounts</h3>
      {/* A HEADING OVER NOTHING. With no account on file this card rendered its title and then an
          empty body with a disclosure toggle under it, which reads as a list that failed to load. */}
      {banks.length === 0 && (
        <p style="font-size:13px;color:var(--emp-muted);line-height:1.6;">
          No bank account is on file for you yet. Nothing is wrong and nobody is waiting on you: an
          account is needed only when there is money in your wallet to withdraw, and it is used for
          nothing else. Add one now or when the first credit appears, using the form below.
        </p>
      )}
      {banks.map((b: any) => (
        <div class="ledger"><div><div style="font-weight:600;">{b.bank_name || 'Bank'} · {b.account_masked || b.upi_id}</div><div style="font-size:11px;color:var(--emp-muted);">{b.holder}{b.ifsc ? ' · ' + b.ifsc : ''}</div></div>{b.is_primary && <span class="pill" style="color:#059669;background:#05966918;">primary</span>}</div>
      ))}
      <details style="margin-top:12px;"><summary style="font-size:13px;color:var(--emp-accent);cursor:pointer;font-weight:600;">+ Add / change bank account</summary>
        <form method="POST" style="margin-top:10px;">
          <input type="hidden" name="action" value="add_bank"/>
          <label for="bHolder">Account holder name</label><input id="bHolder" name="holder" required value={employee.full_name || ''}/>
          <div class="row2"><div><label for="bAcc">Account number</label><input id="bAcc" name="account_number" required inputmode="numeric"/></div><div><label for="bIfsc">IFSC</label><input id="bIfsc" name="ifsc" style="text-transform:uppercase;"/></div></div>
          <div class="row2"><div><label for="bBank">Bank name</label><input id="bBank" name="bank_name"/></div><div><label for="bUpi">UPI id (optional)</label><input id="bUpi" name="upi_id" placeholder="name@bank"/></div></div>
          <p style="font-size:12px;color:var(--emp-muted);margin-top:8px;line-height:1.5;">Give an IFSC or a UPI id. One of the two is enough.</p>
          <button class="btn btn-dark btn-full" style="margin-top:12px;">Save bank account</button>
        </form>
      </details>
    </div>

    <div class="card"><h3>Transactions</h3>
      {!ledgerReadable && (
        <p role="alert" style="font-size:13px;color:#92400e;line-height:1.6;">
          Your transactions could not be read, so none are listed. This is not a statement that there
          are none. Try again shortly.
        </p>
      )}
      {ledgerReadable && txns.length === 0 && (
        <p style="font-size:13px;color:var(--emp-muted);line-height:1.6;">
          This ledger was read and has no entries. Every credit and every payout appears here in the
          order it happened, from the day you joined onwards, so an empty list means no money has moved
          either way yet.
        </p>
      )}
      {txns.map((t: any) => (
        <div class="ledger">
          <div><div style="font-weight:600;text-transform:capitalize;">{t.kind}{t.note ? ' · ' + t.note : ''}</div><div style="font-size:11px;color:var(--emp-muted);">{new Date(t.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</div></div>
          <div style={`font-weight:700;font-family:'JetBrains Mono',monospace;color:${t.direction==='credit'?'#059669':'#dc2626'};`}>{t.direction === 'credit' ? '+' : '−'}{amt(t.amount, String(t.currency || bal.currency))}</div>
        </div>
      ))}
    </div>
  </div>)}
</div>
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin:0 0 12px;}
    /* Was var(--emp-dim) on white — 3.2:1, under the 4.5:1 floor, on 9.5px uppercase text
       that is the only thing naming each field. */
    label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;display:block;margin:10px 0 4px;}
    /* min-height 44px: these were about 40px, under the tap-target floor, and 14px text
       is small enough that some phones zoom the page on focus. */
    input,select{width:100%;min-height:44px;background:var(--emp-surface-2);border:1px solid var(--emp-line-2);border-radius:9px;padding:11px 12px;font-size:16px;font-family:inherit;color:var(--emp-ink);}
    input:focus,select:focus{border-color:var(--emp-accent);}
    input:focus-visible,select:focus-visible,.btn:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--emp-accent-deep);outline-offset:2px;}
    .btn{background:var(--emp-accent);color:#fff;border:none;border-radius:10px;min-height:44px;padding:12px 18px;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;}
    .btn-dark{background:var(--emp-bar);} .btn-full{width:100%;}
    /* A disclosure that opens the only way to add a bank account should not be a
       19px-tall line of text. */
    summary{min-height:44px;display:flex;align-items:center;}
    .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .ledger{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f2ece0;}
    .ledger:last-child{border-bottom:none;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:3px 9px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;}
    a{color:var(--emp-accent);}
</style>
