---
// /portal/employee/assets — WHAT THE COMPANY HAS ISSUED TO YOU, and nothing else.
//
// THE NARROWING IS IN THE QUERY. employeeAssets() and employeeAssetHistory() take an employee id and
// put it in the WHERE clause; there is no "all assets" read behind this page that a filter could be
// dropped from. An employee sees what they are holding and what they have handed back, and that is
// the whole of it — who else has what is a register, and the register is an admin surface with its
// own capability.
//
// THE ONE WRITE HERE IS A DAMAGE REPORT, and it is a REPORT: reportDamage() records what the person
// says, marks the condition so nobody issues it onward believing it is fine, and tells the desk. It
// does not retire the asset, charge anybody or close the assignment. What happens next is a human
// decision on the register — the same rule this codebase applies to every automated signal.
//
// ASKING FOR SOMETHING IS A HELPDESK TICKET, not a button here. An asset request needs an approval
// routed along the person's own reporting line, which is what /portal/employee/support does; a
// second request path on this page would be a second approval path, and the two would disagree.
import {
  employeeAssets, employeeAssetHistory, reportDamage,
  kindLabel, conditionLabel, assetStatusLabel,
  type AssetAssignment,
} from '@/lib/assets';
// The single employee-record resolver. This page no longer opens its own connection to hr_employees
// at all: the two raw SELECTs it used to run were the last thing on it that touched the table.
import { resolveEmployeeIdentity } from '@/lib/workforce/identity';

// THE DOCUMENT, ONCE. This page used to write its own doctype, head, favicon, title and top
// bar; seventeen pages under /portal/employee each wrote a slightly different copy of the same
// five things. EmployeeShell owns them now. The page keeps its own <style>, marked is:global so
// it still reaches <body>, the reset and the chrome the shell renders.
import EmployeeShell from '@/components/workforce/EmployeeShell.astro';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

// CONSTANTS FIRST — `const` is not hoisted, and a const under the POST handler that reads it throws
// on that handler's first line.
const PAGE = '/portal/employee/assets';

const fmt = (d: any) => {
  if (!d) return '';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

// THE LOOKUP IS NOT WRITTEN HERE ANY MORE — see src/lib/workforce/identity.ts for the three ways
// the hand-written copy that used to sit here was wrong: a case-SENSITIVE email comparison (so a
// record typed with a capital letter read as "no record"), a `LIMIT 1` that PICKED a row where the
// canonical gate refuses two matching records rather than risk showing one person another person's
// issued equipment, and two unindexed reads of hr_employees on every page load.
const identity = await resolveEmployeeIdentity(user, PAGE);
const employee: { id: string; full_name: string } | null = identity.ok
  ? { id: identity.identity.employeeId, full_name: identity.identity.fullName }
  : null;
const denial = identity.ok ? null : identity.denial;
if (denial?.redirect) return Astro.redirect(denial.redirect);

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  let flash = '';
  let ok = true;
  if (String(fd.get('action') || '') === 'damage') {
    // The library re-checks that this person is actually holding the asset. The form only decides
    // what is offered.
    const r = await reportDamage(String(fd.get('asset_id') || ''), user as any, String(fd.get('note') || ''));
    ok = r.ok;
    flash = r.ok
      ? 'Reported. The desk can see it, and the asset is marked damaged so nobody issues it on as if it were fine.'
      : (r.error || 'Could not record that.');
  }
  return Astro.redirect(PAGE + '?msg=' + encodeURIComponent(flash) + '&ok=' + (ok ? '1' : '0'));
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg') || '';
const msgOk = url.searchParams.get('ok') !== '0';

const holding: AssetAssignment[] = employee ? await employeeAssets(employee.id) : [];
const history: AssetAssignment[] = employee ? await employeeAssetHistory(employee.id, 60) : [];
const returned = history.filter((h) => h.status !== 'active');
---
<EmployeeShell title="My assets" person={employee?.full_name || user.name} width={640} bottomPad={48} bare>

<div class="wrap">
  {msg && (
    <div class="msg" style={msgOk
      ? 'background:rgba(5,150,105,.1);border:1px solid rgba(5,150,105,.3);color:#065f46;'
      : 'background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.3);color:#991b1b;'}>{msg}</div>
  )}

  {!employee && (
    <div class="card">
      {/* The heading and the sentence come from the gate. There are four reasons this page can have
          no record — not linked, two records under one address, a closed record, or a read that did
          not complete — and they need four different sentences. One line for all four sends three
          people out of four to ask HR for the wrong thing. */}
      <h3>{denial ? denial.title : 'No employee record'}</h3>
      <p style="font-size:14px;line-height:1.6;">{denial ? denial.reason : 'Assets are issued against an employee record, and this account is not linked to one yet. Nothing is being hidden — there is nothing to show until the record exists.'}</p>
    </div>
  )}

  {employee && (
    <div>
      <div class="card">
        <h3>Issued to you</h3>
        {holding.length === 0 && (
          <p style="font-size:14px;line-height:1.6;">Nothing is issued to you at the moment. If you are holding something that is not listed here, tell the people desk — the register is what a leaving checklist is settled against.</p>
        )}
        {holding.map((a) => (
          <div class="item">
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
              <div style="min-width:0;">
                <div style="font-weight:600;font-size:14.5px;word-break:break-word;">{a.assetName}</div>
                <div class="meta">{kindLabel(a.assetKind || '')} · tag {a.assetTag} · issued {fmt(a.assignedAt)}</div>
                {a.expectedReturnOn && (<div class="meta">Due back {fmt(a.expectedReturnOn)}</div>)}
                {a.damageReportedAt && (<div class="meta">Damage reported {fmt(a.damageReportedAt)} — the desk has it.</div>)}
              </div>
              <span class="pill">{conditionLabel(a.issuedCondition || 'good')}</span>
            </div>
            <details style="margin-top:8px;">
              <summary>Report damage</summary>
              <form method="POST" style="margin-top:6px;">
                <input type="hidden" name="action" value="damage"/>
                <input type="hidden" name="asset_id" value={a.assetId}/>
                <label for={'note-' + a.id}>What happened</label>
                <textarea id={'note-' + a.id} name="note" rows="3" required placeholder="What is wrong with it, and when it happened."></textarea>
                <button class="btn ghost" style="margin-top:8px;">Send the report</button>
                <p class="meta" style="margin-top:8px;">This records what you have said and tells the desk. It does not decide anything — whether it is repaired, replaced or written off is a person's call, made on the register.</p>
              </form>
            </details>
          </div>
        ))}
      </div>

      <div class="card">
        <h3>Handed back</h3>
        {returned.length === 0 && (<p style="font-size:14px;">Nothing returned yet.</p>)}
        {returned.map((a) => (
          <div class="item">
            <div style="font-weight:600;font-size:14px;">{a.assetName}</div>
            <div class="meta">{kindLabel(a.assetKind || '')} · tag {a.assetTag} · held {fmt(a.assignedAt)} to {fmt(a.returnedAt)} · returned {conditionLabel(a.returnedCondition || '').toLowerCase()}</div>
            {a.returnNote && (<div class="meta">{a.returnNote}</div>)}
          </div>
        ))}
      </div>

      <div class="card">
        <h3>Need something</h3>
        <p style="font-size:14px;line-height:1.6;">Ask on the helpdesk. An asset request goes to your reporting manager for approval before anything can be issued, which is why it is a ticket rather than a button here.</p>
        <a class="btn" href="/portal/employee/support?category=asset_request" style="display:block;text-align:center;text-decoration:none;margin-top:12px;padding-top:12px;">Raise an asset request</a>
      </div>
    </div>
  )}
</div>
</EmployeeShell>

<style is:global>
    .card{background:var(--emp-surface);border:1px solid var(--emp-line);border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 10px 30px rgba(26,21,16,.05);}
    .card h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;margin:0 0 12px;}
    label{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--emp-muted);font-weight:700;display:block;margin:10px 0 4px;}
    textarea{width:100%;background:var(--emp-surface-2);border:1px solid var(--emp-line-2);border-radius:9px;padding:11px 12px;font-size:15px;font-family:inherit;color:var(--emp-ink);outline:none;min-height:66px;}
    textarea:focus{border-color:var(--emp-accent);}
    /* `outline:none` was set with nothing put in its place, so a keyboard or switch user could not tell which control they were on. */
    input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--emp-accent-deep);outline-offset:2px;}
    .btn{background:var(--emp-accent);color:#fff;border:none;border-radius:10px;padding:12px 18px;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;width:100%;min-height:44px;}
    .btn.ghost{background:var(--emp-surface-2);color:var(--emp-ink);border:1px solid var(--emp-line-2);}
    .item{padding:12px 0;border-bottom:1px solid #f2ece0;}
    .item:last-child{border-bottom:none;}
    .meta{font-size:11.5px;color:var(--emp-muted);line-height:1.6;}
    .pill{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:4px 9px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;background:rgba(0,0,0,.05);}
    .msg{border-radius:10px;padding:11px 14px;font-size:13.5px;margin-bottom:14px;line-height:1.5;}
    details summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-size:13.5px;color:var(--emp-accent);}
</style>
