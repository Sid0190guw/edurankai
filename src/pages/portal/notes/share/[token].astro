---
// /portal/notes/share/[token] — the destination of the share link that /portal/notes has been
// handing out since it shipped.
//
// WHY THIS FILE EXISTS. The Share button on /portal/notes mints a token, writes it to
// notes.share_token, and shows the reader a URL built from it:
//     window.location.origin + '/portal/notes/share/' + n.share_token
// No route ever answered that URL. Every share link this feature has produced 404s, so the button
// worked, the link copied, and the person it was sent to saw a not-found page.
//
// WHAT IT DOES NOT DO. It does not accept a token as a substitute for identity. The link is a
// pointer, not a credential: it opens ONE note, read-only, and only while the owner keeps that note
// shared. Revoking is `visibility <> 'shared'` and takes effect on the next load. Nothing here can
// edit, delete or list anything.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { safeNoteHtml } from '@/lib/note-html';

const rows = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

const token = String(Astro.params.token || '');

// Fail closed on a malformed token before touching the database.
const tokenLooksValid = /^nt_[a-z0-9]{8,40}$/.test(token);

let note: any = null;
let lookupFailed = false;

if (tokenLooksValid) {
  try {
    const r = rows(await db.execute(sql`
      SELECT n.title, n.body, n.updated_at, u.name AS owner_name
        FROM notes n
        LEFT JOIN users u ON u.id = n.owner_user_id
       WHERE n.share_token = ${token}
         AND n.visibility = 'shared'
       LIMIT 1
    `));
    note = r[0] || null;
  } catch (e: any) {
    // Do not present a read failure as "this note does not exist" — they are different facts and
    // only one of them is the reader's problem. The reader is told honestly via lookupFailed; the
    // REASON now goes to the log instead of nowhere, because the alternative is a share link that
    // says "unavailable" forever with nothing anywhere saying why. The real Postgres reason is on
    // e.cause — e.message is only the failed SQL.
    lookupFailed = true;
    console.error('[portal/notes/share] shared-note lookup failed -', e?.cause?.message || e?.message);
  }
}

const title = note ? (note.title || 'Untitled note') : 'Shared note';

// The stored body is the raw innerHTML of someone else's editor. It is rendered through an
// allow-list that keeps structure and discards every attribute, so a link shows as its text.
const bodyHtml = note ? safeNoteHtml(note.body) : '';
---
<BaseLayout title={title} description="A note shared from the EduRankAI portal.">
<style>
  .sn-wrap { max-width: 780px; margin: 0 auto; padding: 48px 22px 90px; }
  .sn-eyebrow { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #FF4F00; font-weight: 700; }
  .sn-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(28px, 4vw, 40px); font-weight: 600; letter-spacing: -0.02em; margin: 8px 0 10px; color: #0E0B08; }
  .sn-meta { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; color: #8a847a; margin-bottom: 24px; }
  .sn-body { background: #fff; border: 1px solid rgba(14,11,8,0.10); border-radius: 14px; padding: 26px 28px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px; line-height: 1.65; color: #0E0B08; overflow-wrap: anywhere; }
  .sn-body h1 { font-size: 28px; margin: 16px 0 8px; font-weight: 600; }
  .sn-body h2 { font-size: 22px; margin: 14px 0 6px; font-weight: 600; }
  .sn-body ul, .sn-body ol { padding-left: 26px; margin: 8px 0; }
  .sn-body code { background: #F1F1EE; padding: 1px 5px; border-radius: 3px; font-family: 'Geist Mono', monospace; font-size: 14px; color: #b91c1c; }
  .sn-body pre { background: #F1F1EE; padding: 12px; border-radius: 6px; overflow-x: auto; font-family: 'Geist Mono', monospace; font-size: 13px; }
  .sn-note { background: #FFF4EE; border: 1px solid #FF4F00; color: #7a2c00; padding: 14px 16px; border-radius: 10px; font-size: 13px; line-height: 1.6; }
  .sn-foot { margin-top: 22px; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; color: #8a847a; }
  .sn-foot a { color: #FF4F00; }
</style>

<main class="sn-wrap">
  <div class="sn-eyebrow">portal · shared note</div>

  {note && (
    <>
      <h1 class="sn-title">{note.title || 'Untitled note'}</h1>
      <div class="sn-meta">
        {note.owner_name ? 'Shared by ' + note.owner_name : 'Shared from the portal'}
        {note.updated_at ? ' · updated ' + new Date(note.updated_at).toLocaleString() : ''}
        {' · read only'}
      </div>
      {bodyHtml.trim()
        ? <article class="sn-body" set:html={bodyHtml}></article>
        : <div class="sn-note">This note is shared but still empty. Nothing has been written into it yet.</div>}
      <div class="sn-foot">
        This link opens one note and nothing else. It stops working the moment its owner unshares it.
        Formatting is preserved; links inside a shared note render as plain text, because nothing
        typed by another person is executed on this page.
      </div>
    </>
  )}

  {!note && lookupFailed && (
    <>
      <h1 class="sn-title">This note could not be read</h1>
      <div class="sn-note">
        The link is well formed, but the note store could not be reached just now. This is a fault on
        our side, not a wrong link. Try again shortly.
      </div>
    </>
  )}

  {!note && !lookupFailed && (
    <>
      <h1 class="sn-title">This link is not open</h1>
      <div class="sn-note">
        Either the link is wrong, or the note it pointed to is no longer shared. Only the person who
        wrote the note can share it again, and only they can see who it was shared with.
      </div>
      <div class="sn-foot" style="margin-top:16px;">
        <a href="/portal/notes">Go to your own notes</a>
      </div>
    </>
  )}
</main>
</BaseLayout>
