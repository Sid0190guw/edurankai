---
// /portal/course-waivers — THE ANSWER, WHERE THE PERSON WHO ASKED CAN READ IT.
//
// A decision nobody can read is a decision that did not happen to them. This page exists so that
// "declined" is never a silence: the reason the reviewer wrote is on the row, verbatim, and a
// partial grant says exactly how much is covered and what is left to pay.
//
// IT IS NOT /portal/waivers. That page is applicant-only (`if (user.role !== 'applicant') redirect`)
// and lists APPLICATION fee waivers with their own thread. A course learner is very often not an
// applicant at all, so they would be redirected away from their own decision.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { myCourseWaivers } from '@/lib/course-waiver';
import { formatPrice, netAfterWaiver } from '@/lib/course-pricing';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/course-waivers'));

const waivers = await myCourseWaivers(String(user.id));

function fmt(d: string | null): string {
  if (!d) return '';
  try {
    return new Date(d).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  } catch { return ''; }
}
---

<BaseLayout title="Course fee waivers - EduRankAI" description="Your course fee waiver requests and the decisions on them.">
  <section style="padding:32px 5vw 56px;max-width:720px;margin:0 auto;">

    <a href="/portal/courses" style="font-size:12px;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.14em;color:#FF4F00;text-decoration:none;">Back to courses</a>

    <h1 style="font-size:clamp(1.6rem,5vw,2.2rem);font-weight:600;line-height:1.15;margin:16px 0 10px;">Your fee waiver requests</h1>
    <p style="font-size:0.95rem;line-height:1.7;opacity:0.8;margin:0 0 24px;">
      Every request you have made for help with a course fee, and what was decided. A person reads
      each one and answers it either way.
    </p>

    {waivers.length === 0 && (
      <div style="border:1px solid rgba(0,0,0,0.1);border-radius:16px;padding:24px;">
        <p style="font-size:1rem;font-weight:600;margin:0 0 8px;">You have not asked for a waiver yet.</p>
        <p style="font-size:0.9rem;line-height:1.7;opacity:0.8;margin:0;">
          If the fee on a course is a barrier, open that course and ask there. It takes a sentence.
        </p>
      </div>
    )}

    <div style="display:flex;flex-direction:column;gap:14px;">
      {waivers.map((w) => (
        <article style="border:1px solid rgba(0,0,0,0.1);border-radius:16px;padding:18px;">
          <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start;">
            <div style="min-width:0;">
              <p style="font-size:1.02rem;font-weight:600;margin:0 0 2px;">{w.courseTitle || 'A course'}</p>
              <p style="font-size:0.78rem;font-family:'JetBrains Mono',monospace;opacity:0.6;margin:0;">Asked {fmt(w.createdAt)}</p>
            </div>
            <span style={'font-family:JetBrains Mono,monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;padding:4px 10px;border-radius:100px;border:1px solid;'
              + (w.status === 'approved' ? 'background:rgba(16,185,129,0.12);color:#047857;border-color:rgba(16,185,129,0.32);'
                : w.status === 'rejected' ? 'background:rgba(239,68,68,0.10);color:#991b1b;border-color:rgba(239,68,68,0.32);'
                : 'background:rgba(250,204,21,0.14);color:#92400e;border-color:rgba(250,204,21,0.35);')}>
              {w.status === 'approved' ? 'granted' : w.status === 'rejected' ? 'not granted' : 'under review'}
            </span>
          </div>

          {w.status === 'pending' && (
            <p style="font-size:0.9rem;line-height:1.7;margin:12px 0 0;">
              A person is reading this. You will be told the answer either way, and nothing is charged
              in the meantime.
            </p>
          )}

          {w.status === 'approved' && (
            <div style="margin:12px 0 0;">
              <p style="font-size:0.9rem;line-height:1.7;margin:0 0 6px;">
                {w.grantPct === 100
                  ? 'The whole fee is covered. You can start the course now - there is nothing to pay.'
                  : w.grantPct + ' per cent of the fee is covered. ' + formatPrice(netAfterWaiver(w.listPriceMinor, w.grantPct), w.listPriceCurrency) + ' is left to pay when you enrol.'}
              </p>
              <p style="font-size:0.8rem;font-family:'JetBrains Mono',monospace;opacity:0.65;margin:0;">
                Fee {formatPrice(w.listPriceMinor, w.listPriceCurrency)} - decided {fmt(w.reviewedAt)}
                {w.consumedAt ? ' - used ' + fmt(w.consumedAt) : ''}
              </p>
              {w.courseSlug && !w.consumedAt && (
                <a href={'/portal/courses/' + w.courseSlug} style="display:inline-block;margin-top:12px;min-height:44px;line-height:44px;padding:0 20px;background:#FF4F00;color:#fff;border-radius:8px;font-size:0.9rem;font-weight:600;text-decoration:none;">
                  Open the course
                </a>
              )}
            </div>
          )}

          {w.status === 'rejected' && (
            <div style="margin:12px 0 0;">
              <p style="font-size:0.9rem;line-height:1.7;margin:0 0 6px;white-space:pre-wrap;">
                <strong>Not granted.</strong> {w.rejectReason || 'No reason was recorded with this decision. Please write to connect@edurankai.in and we will explain.'}
              </p>
              <p style="font-size:0.8rem;font-family:'JetBrains Mono',monospace;opacity:0.65;margin:0;">Decided {fmt(w.reviewedAt)}</p>
              {w.courseSlug && (
                <a href={'/portal/courses/' + w.courseSlug} style="display:inline-block;margin-top:12px;font-size:0.9rem;font-weight:600;color:#FF4F00;text-decoration:underline;">Open the course</a>
              )}
            </div>
          )}

          <p style="font-size:0.82rem;line-height:1.7;opacity:0.7;margin:12px 0 0;white-space:pre-wrap;">
            What you told us: {w.reason}
          </p>
        </article>
      ))}
    </div>

  </section>
</BaseLayout>
