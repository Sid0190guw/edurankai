---
/**
 * /portal/sign-out — the account control's own page, in three honest states.
 *
 * WHY THIS PAGE EXISTS AT ALL, rather than the sign-out simply redirecting to /portal/login.
 * The brief asked for the confirmation to appear ON the sign-in page. The sign-in pages are owned by
 * another workstream right now and are explicitly out of bounds for this change, and
 * /portal/login.astro reads no query parameter, so a redirect to /portal/login?signed_out=1 would
 * render the ordinary form with no confirmation on it at all — a silent sign-out, which is the thing
 * being fixed. So the confirmation lives here, one tap from the form, and the follow-up is recorded
 * in the build report: when login.astro is free, it can read `?signed_out=1` and this page's `done`
 * branch becomes a redirect.
 *
 * THE THREE STATES, and why one route carries all of them:
 *
 *   signed in  — reached by a GET to /portal/logout (an old <a href> link, a prefetch, a link
 *                preview). It signs nobody out; it says WHO is signed in and offers the POST button.
 *                A prefetch that lands here has done nothing at all, which is the entire point.
 *   done       — reached by the 303 after a successful POST. Plain confirmation, then the way in.
 *   anonymous  — somebody arrived here with no session and did not just sign out. Says so plainly
 *                rather than pretending an act occurred.
 *
 * WHO, NOT JUST WHETHER. Every state that has a session names it. The failure this control is for is
 * not "I forgot to sign out" — it is "I did not realise I was signed in as somebody else", and a
 * button that says only Sign out cannot tell you that.
 *
 * MOBILE FIRST. One column at 360px, nothing wider than the viewport, every control past the 44px
 * floor, and no JavaScript anywhere on the page — a sign-out that needs a bundle to work is a
 * sign-out that fails on the phone where it matters.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/workforce.css';

// Declared before anything that reads them — `const` is not hoisted.
const user = Astro.locals.user;
const params = Astro.url.searchParams;
const justSignedOut = params.get('done') === '1';
// The endpoint sets this when the `sessions` row could not be deleted. It is NOT decoration: the
// browser is signed out and the server may not be, and the person is the only one who can act on it.
const serverEndFailed = params.get('partial') === '1';

const state = user ? 'signed-in' : (justSignedOut ? 'done' : 'anonymous');

const accountName = (user?.name || '').trim();
const accountEmail = (user?.email || '').trim();
const initial = (accountName || accountEmail || '?').charAt(0).toUpperCase();
// Where "not now" goes. The employee home for anyone who has one is resolved by /portal itself, so
// this points at the one door that never needs to know which kind of account is reading.
const stayHref = '/portal';
---

<BaseLayout title="Sign out" showNav={false} showFooter={false} noindex={true}>
  <main class="so-page">
    <div class="so-card">

      {state === 'signed-in' && (
        <div>
          <p class="so-eyebrow">Signed in on this device</p>

          <div class="so-who">
            <span class="so-who__avatar" aria-hidden="true">{initial}</span>
            <span class="so-who__text">
              <span class="so-who__name">{accountName || 'Your account'}</span>
              {accountEmail && <span class="so-who__mail">{accountEmail}</span>}
            </span>
          </div>

          <p class="so-body">
            If this is not you, or this phone is not yours, sign out now. It ends the session on our
            servers as well as in this browser, so the address bar cannot get anybody back in.
          </p>

          <form method="POST" action="/portal/logout" class="so-form">
            <button type="submit" class="so-btn so-btn--danger wf-focusable">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Sign out</span>
            </button>
          </form>

          <a class="so-btn so-btn--quiet wf-focusable" href={stayHref}>Stay signed in</a>
        </div>
      )}

      {state === 'done' && (
        <div>
          <span class="so-mark" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>

          <h1 class="so-title">You are signed out</h1>

          <p class="so-body">
            This session has ended, on this device and on our servers. Nothing further is open on
            this browser. You will need to sign in again to reach the employee portal.
          </p>

          {serverEndFailed && (
            <p class="so-warn" role="alert">
              One part of this did not finish. This browser has been signed out, but we could not
              confirm that the session was closed on our side. If this device is not yours, sign in
              again from a device you trust and change your password.
            </p>
          )}

          <a class="so-btn so-btn--primary wf-focusable" href="/portal/login">Go to sign in</a>
          <a class="so-btn so-btn--quiet wf-focusable" href="/">Back to the main site</a>
        </div>
      )}

      {state === 'anonymous' && (
        <div>
          <h1 class="so-title">You are not signed in</h1>
          <p class="so-body">
            There is no session open on this browser, so there is nothing to sign out of.
          </p>
          <a class="so-btn so-btn--primary wf-focusable" href="/portal/login">Go to sign in</a>
          <a class="so-btn so-btn--quiet wf-focusable" href="/">Back to the main site</a>
        </div>
      )}

    </div>
  </main>
</BaseLayout>

<style>
  /* One column, phone width first. Nothing here has a fixed width, so nothing can push the page
     sideways at 360px. */
  .so-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px calc(32px + env(safe-area-inset-bottom));
    background: var(--wf-ground);
    font-family: var(--wf-font);
    color: var(--wf-ink);
  }

  .so-card {
    width: 100%;
    max-width: 420px;
    background: var(--wf-surface);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-lg);
    padding: 22px 18px 18px;
  }

  .so-eyebrow {
    margin: 0 0 12px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wf-ink-3);
  }

  .so-title {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--wf-ink);
  }

  /* WHO. The avatar is an initial, never a photograph: this page renders before anyone has decided
     to trust the device. */
  .so-who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-r-md);
    background: var(--wf-veil);
  }

  .so-who__avatar {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--wf-line-strong);
    color: var(--wf-ink);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .so-who__text {
    /* min-width:0 with ellipsis below is what stops a long address widening the card past a 360px
       phone — the one way a card like this causes a horizontal page scroll. */
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .so-who__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--wf-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .so-who__mail {
    font-size: 0.82rem;
    color: var(--wf-ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .so-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--wf-approved-wash);
    border: 1px solid var(--wf-approved-border);
    color: var(--wf-approved-text);
  }

  .so-body {
    margin: 14px 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--wf-ink-2);
  }

  .so-warn {
    margin: 14px 0 0;
    padding: 12px;
    border: 1px solid var(--wf-danger-border);
    border-radius: var(--wf-r-md);
    background: var(--wf-danger-wash);
    color: var(--wf-danger-text);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .so-form {
    margin: 18px 0 0;
  }

  /* Every control clears the 44px floor by a comfortable margin: these are one-handed taps by
     somebody who is often in a hurry to hand the phone back. */
  .so-btn {
    width: 100%;
    min-height: 48px;
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border: 1px solid transparent;
    border-radius: var(--wf-r-md);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .so-form .so-btn {
    margin-top: 0;
  }

  .so-btn--danger {
    background: var(--wf-danger-text);
    border-color: var(--wf-danger-text);
    color: var(--wf-on-solid);
  }

  .so-btn--primary {
    background: var(--wf-ink);
    border-color: var(--wf-ink);
    color: var(--wf-on-solid);
  }

  .so-btn--quiet {
    background: var(--wf-surface);
    border-color: var(--wf-line-strong);
    color: var(--wf-ink-2);
  }

  .so-btn:active {
    opacity: 0.72;
  }

  @media (prefers-reduced-motion: reduce) {
    .so-btn:active {
      opacity: 1;
    }
  }
</style>
