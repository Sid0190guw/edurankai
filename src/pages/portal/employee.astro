---
// THE NAVIGATION IS COMPOSED, NOT DECLARED. WorkspaceNav projects THIS request's composition through
// src/lib/workforce/navigation.ts and hands the result to BottomNav — the same bar component, the
// same 44px floor, the same aria-current. It replaces `<BottomNav variant="hr">`, whose SETS array
// (BottomNav.astro:115) is a static four-tab list with no capability test at all: every tab rendered
// for everyone, whatever the composer resolved, which is precisely the second decider this build
// exists to remove. Home now resolves per person (/portal/employee here) instead of pointing at
// /portal, which redirected straight back for anybody with an employee record.
import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
// The Home shell. WorkspaceCard makes "there is nothing" and "we could not read it" structurally
// different branches, so no card on this page can print the reassuring sentence over a failed read.
// QuickActions renders composeWorkspace().quickActions and holds NO list of its own — the two
// hand-written arrays it replaces (portal/index.astro:416 and BottomNav.astro:115) test nothing at
// all, and a third copy is the defect the composer exists to prevent.
import WorkspaceCard from '@/components/workforce/WorkspaceCard.astro';
import QuickActions from '@/components/workforce/QuickActions.astro';
import WelcomeBanner from '@/components/workforce/WelcomeBanner.astro';
import Timeline from '@/components/workforce/Timeline.astro';
import AvatarStack from '@/components/workforce/AvatarStack.astro';
// The same sentence every department-scoped list in this product carries: hr_employees.department_id
// has exactly one writer, so a hand-created record is invisible and a short list reads as complete.
import { DEPARTMENT_COVERAGE_NOTICE } from '@/lib/auth/workspace-access';
// The command centre at the top of this page is built from the workforce set and its tokens, not
// from a second visual language invented here. StatusBadge and PriorityFlag each carry a distinct
// SHAPE and a text label, so the triage list still reads with every colour deleted — which is the
// point on a screen someone scans in five seconds on a phone in daylight.
import EmptyState from '@/components/workforce/EmptyState.astro';
import PriorityFlag from '@/components/workforce/PriorityFlag.astro';
import StatusBadge from '@/components/workforce/StatusBadge.astro';
// Imported explicitly rather than relying on the three components above dragging it in: two of them
// render only conditionally, and the tokens the new CSS below uses must be present on every render.
import '@/styles/workforce.css';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
// THE DECIDER. src/lib/workforce/composer.ts answers "what should this person see" ONCE, from the
// real gates, and this page renders its answer. Nothing below branches on a role, a permission, a
// department or an engagement type — the moment a second surface answers that question it answers it
// differently within a month, and the one that answers it too generously is the one nobody notices.
import { composeWorkspace, hasWidget } from '@/lib/workforce/composer';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

// Declared at the very top, above everything that uses them: `const` is not hoisted, and a handler
// reaching a later declaration has taken pages down in this repo before.
// postgres-js resolves to a plain array, never a { rows } object.
const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));
// The real Postgres reason is on e.cause; e.message is only the failed SQL.
const logFail = (tag: string, e: any) => console.error('[portal/employee] ' + tag, e?.cause?.message || e?.message);

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
// THE FALLBACK DAY, CUT WHERE THE PEOPLE USING THIS CUT IT.
//
// This was `new Date().toISOString().split('T')[0]` — the date in UTC, in a process that runs in
// UTC, for people who are five and a half hours ahead of it. It is the fallback the writes below
// use when the composer could not resolve `ctx.today` (see line ~399 and ~446), so between 00:00 and
// 05:29 IST a wrap-up note and a block of logged time landed on YESTERDAY's date and vanished from
// the card that reads today. civilDateNow() formats the same instant in the working zone, which is
// the same answer the composer's own day query gives.
const IST = 'Asia/Kolkata';
const civilDateNow = (): string => {
  try {
    // en-CA formats as YYYY-MM-DD, which is the shape every date column here wants.
    return new Intl.DateTimeFormat('en-CA', { timeZone: IST, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  } catch {
    return new Date().toISOString().slice(0, 10);
  }
};
const todayIso = civilDateNow();
// A DATE column comes back from postgres-js as a Date at UTC midnight, so read it in UTC — using
// local getters would shift a due date by a day for anyone east or west of the server.
const isoDay = (v: any) => {
  if (!v) return '';
  if (typeof v === 'string') return v.slice(0, 10);
  const d = new Date(v);
  return isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
};
const dayLabel = (v: any) => {
  const iso = isoDay(v);
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00Z');
  return isNaN(d.getTime()) ? iso : d.getUTCDate() + ' ' + MONTHS[d.getUTCMonth()];
};

// =================================================================================================
// SCHEMA BOOTSTRAP — DDL ONLY, AND IT IS NOT A WIDGET LOADER.
//
// This runs above the authorization boundary on purpose, and it is allowed to: it reads no row
// belonging to anybody, and the identity lookup that RESOLVES the boundary depends on it. The master
// spec (§3.3) is explicit that ensureOnce-style bootstrapping belongs outside a loader, and
// docs/KNOWN_GAPS.md records this block as the thing that created work_email and hr_task_log.
//
// work_email is declared in db/hr-schema.sql but did NOT exist on the production table. The
// email-fallback lookup inside workspace-access.ts names it, so without this the composer's own
// employee lookup throws and every person whose HR record is not linked by user_id is told they have
// no employee profile — with nothing in the logs to say why.
//
// The try/catch has to be INSIDE the ensureOnce callback, not around it. ensureOnce() returns
// `p.catch(() => {})` (src/lib/ensure-once.ts:24) — it swallows, so an outer catch never fires and a
// failed ALTER leaves no trace at all. Log the real reason, then re-throw: the re-throw is what makes
// ensureOnce drop its cache entry and try again on the next request rather than remembering the
// failure forever.
// =================================================================================================
try {
  const { ensureOnce } = await import('@/lib/ensure-once');
  // hr_task_log is declared in db/hr-schema.sql but was only ever CREATEd inside the clock-out
  // handler, so on a database where nobody had clocked out yet the table did not exist — and the
  // read further down threw on every page load. Same shape as the work_email fault: a table that
  // exists in the schema file and not in the database. Created here, before anything reads it.
  await ensureOnce('hr_task_log_v1', async () => {
    await db.execute(sql`CREATE TABLE IF NOT EXISTS hr_task_log (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      employee_id UUID NOT NULL,
      log_date DATE NOT NULL,
      task TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'done',
      percent INT NOT NULL DEFAULT 100,
      details TEXT,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())`);
    await db.execute(sql`CREATE INDEX IF NOT EXISTS hr_task_log_emp_date_idx ON hr_task_log (employee_id, log_date)`);
  });

  await ensureOnce('hr_employees_work_email_v1', async () => {
    try {
      await db.execute(sql`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS work_email TEXT`);
    } catch (e: any) {
      logFail('work_email ALTER', e);
      throw e;
    }
  });
} catch (e: any) {
  logFail('work_email ensure', e);
}

// reporting_manager_id has the same shape of problem. It is declared in db/hr-schema.sql, but the
// only things that ALTER it in are the two admin HR screens, at page load — so on a database where
// neither has ever been opened the column is simply not there. It has to exist BEFORE the composer
// runs, not inside a widget loader: countDirectReports() reads it to decide who manages people and
// who may decide an approval, and a missing column there degrades the whole context rather than one
// card. Its own ensureOnce key rather than folded into the block above, so one failing cannot mask
// the other in the logs.
try {
  const { ensureOnce } = await import('@/lib/ensure-once');
  await ensureOnce('hr_employees_reporting_manager_v1', async () => {
    try {
      await db.execute(sql`ALTER TABLE hr_employees ADD COLUMN IF NOT EXISTS reporting_manager_id UUID`);
    } catch (e: any) {
      logFail('reporting_manager_id ALTER', e);
      throw e;
    }
  });
} catch (e: any) {
  logFail('reporting_manager_id ensure', e);
}

// =================================================================================================
// ================================ THE AUTHORIZATION BOUNDARY =====================================
//
// composeWorkspace() resolves the employee record, the permission set, the department scope and who
// reports to this person, and returns the widgets whose conditions are met. IT RUNS FIRST, and NO
// widget query may run above this line (docs/workforce-os/AUTHORIZATION_FIRST.md).
//
// Why the line sits exactly here: a loader that runs and has its rows discarded during render has
// still read them. They entered the request context, they can leave through an error page or a log
// line, the read either appears in the audit trail as an access that should not have happened or
// does not appear at all, and every person who cannot see the card still pays for it. A widget
// rendering nothing is not evidence that nothing was read.
//
// It is also the FIRST await of the frontmatter and sits above the POST handler, because `const` is
// not hoisted: a handler reaching a later declaration throws on its own first line while the page
// still reports success. That is what broke apply step 5 and the /admin/roles/diagnose Repair button.
// =================================================================================================
const composed = await composeWorkspace(user, { locals: Astro.locals, next: '/portal/employee' });

/** Is this widget eligible for this person? The ONLY question this page is allowed to ask. */
const has = (key: string): boolean => hasWidget(composed, key);

// hr_employees.id, from the composer's own lookup — every hr_* table is keyed by it and never by
// users.id. Null when no employee record resolved, which is the ordinary state for a founder or an
// HR account and NOT an error.
const employeeId: string | null = composed.workspace?.employeeId ?? null;

// Signed in, composition trustworthy, and simply no HR row linked. The person still gets every
// widget that needs nothing but their user id; they are also told, because "ask HR to link your
// record" is a one-sentence fix they cannot make if nobody says it.
const noEmployeeRecord = composed.ok && !composed.workspace;

// Declared HERE, above the POST handler, for the same hoisting reason as everything else.
// TASK_STATUSES USED TO BE DECLARED HERE, as ['open','in_progress','blocked','done'] — the four
// LEGACY names — and the POST handler validated against it. src/lib/employee-tasks.ts has ten
// canonical statuses and a transition graph between them, so this page's copy silently refused every
// canonical value before the library could answer for it. The handler asks canonicalStatus() now and
// the control is drawn from allowedTransitionsFor(); neither list lives on this page any more.

// =================================================================================================
// THE FLASH CHANNEL. TWO OF THEM, AND THE PAGE NEVER ECHOES WHAT IT WAS SENT.
//
// This page used to redirect with `?msg=` + encodeURIComponent(okMsg || errorMsg) — ONE parameter
// for both outcomes — and render whatever arrived in a green success panel. Three defects rode on
// that one line, and all three are the shape this file's own comments say the page has been punished
// for before:
//
//   1. A FAILED PUNCH WAS SHOWN IN GREEN. The failure message went down the success channel and came
//      out in the affirmative colour, on the one screen where "did that land" is the entire question.
//      That is the green flash over a write that never happened.
//
//   2. NEITHER PANEL WAS ANNOUNCED. No role, no live region. A screen-reader user performed the only
//      action on the page and was told nothing at all.
//
//   3. ARBITRARY TEXT WAS REFLECTED INTO A TRUSTED BANNER. Anyone could hand somebody
//      /portal/employee?msg=Your+salary+account+needs+reverification,+call+... and the authenticated
//      HR workspace would render it inside its own success styling. Text only, so not XSS — a
//      ready-made phishing surface all the same.
//
// THE FIX IS THAT THE URL CARRIES A CODE, NEVER A SENTENCE. The wording lives here; an unrecognised
// code renders NOTHING rather than itself. There is no path by which a query string becomes copy.
//
// It also stops putting the failed SQL in the address bar: `catch(e:any){ errorMsg = e.message }`
// leaked the statement into a shareable URL, and it was the wrong string anyway — the real Postgres
// reason is on e.cause, which is what logFail() reads.
const FLASH_OK = {
  clocked_in: 'Clocked in. Your punch is recorded.',
  clocked_out: 'Clocked out. Have a good evening.',
  break_started: 'Break started.',
  break_ended: 'Break ended. Welcome back.',
  time_logged: 'That block of time is logged.',
  time_deleted: 'That time entry has been removed.',
  task_updated: 'Task updated.',
};

const FLASH_ERR = {
  // Said in the negative and said twice, because the one thing somebody must not do here is walk
  // away believing a punch landed when it did not.
  clock_failed: 'Your punch was NOT recorded. Nothing has been saved. Please try again, and if it keeps failing tell your manager today rather than at the end of the month.',
  // A CLOCK-OUT THAT LANDED IN THE PUNCH LOG BUT CLOSED NO DAY. Reachable without anything being
  // broken: an overnight shift clocking out after the date has rolled over, or a clock-out with no
  // clock-in. Both used to render "Clocked out. Have a good evening." over an unclosed day.
  clock_out_no_day: 'Your clock-out was recorded as a punch, but there is no attendance row for today to close — so today still shows no clock-out and no hours. This happens if your shift started on the previous date, or if you never clocked in. Raise an attendance correction so the day is counted.',
  clock_out_no_clock_in: 'Your clock-out was recorded, but today has no clock-in, so the hours worked could not be worked out and have been left as they were rather than set to zero. Raise an attendance correction with your start time.',
  // A punch that is in the raw log but not on the day roster. The roster is what payroll reads.
  clock_in_not_on_roster: 'Your clock-in was recorded as a punch, but today could not be marked present on the attendance roster — which is what payroll and your manager read. Tell HR today; do not assume it will correct itself.',
  // THE FOUR REFUSALS punchRefusal() CAN GIVE, as codes rather than as forwarded text.
  //
  // punch() returns the refusal as a SENTENCE, and this page's whole flash channel exists because a
  // sentence travelling in a query string is a phishing surface. So the sentence is not forwarded:
  // the code is chosen from the posted kind and the day totals punch() hands back with the refusal,
  // using allowedPunches() — the same pure function the buttons are drawn from. The wording below is
  // punchRefusal()'s, restated here, and the two are checked against each other by nothing but a
  // reader; that is the cost of not reflecting arbitrary text and it is worth paying.
  //
  // Reaching one of these at all means the screen and the day disagreed — a second tab, a back
  // button, or two phones. NOTHING WAS WRITTEN in any of them.
  punch_already_in: 'You are already checked in for today, so that clock-in was not recorded. Reload this page to see where your day actually stands.',
  punch_not_checked_in: 'You are not checked in, so there was nothing to check out of and nothing has been recorded. Reload this page — another tab or another device may have closed your day already.',
  punch_already_on_break: 'You are already on a break, so that was not recorded twice. Reload this page and use Resume work.',
  punch_no_break_running: 'No break is running, so there was nothing to end and nothing has been recorded. Reload this page to see where your day stands.',
  // THE PUNCH LANDED AND THE DAY DID NOT. punch() writes hr_clock_events first and then recomputes
  // hr_attendance from the whole day's events; this is the state where the first succeeded and the
  // second did not. hr_attendance is what payroll, the timesheet and the intern hours ledger read,
  // so it is emphatically not a success — and it is not "nothing was saved" either.
  punch_day_not_written: 'Your punch was recorded, but today\'s attendance row could not be updated from it — so your hours for today are not yet counted, and that row is what payroll and your timesheet read. Nothing you did is lost. Reload in a moment; if this line comes back, tell HR today rather than at the end of the month.',
  time_invalid: 'Enter a valid time period — the end time has to be after the start time.',
  time_task_missing: 'Describe what you worked on in that period.',
  time_failed: 'That block of time could not be logged. Nothing has been saved.',
  task_unknown_status: 'That is not a status we track.',
  task_failed: 'That task could not be updated. Nothing has changed.',
};

// Both lookups fail closed to an empty string, which renders no panel at all.
const flashOkText = (code: string) => FLASH_OK[code as keyof typeof FLASH_OK] || '';
const flashErrText = (code: string) => FLASH_ERR[code as keyof typeof FLASH_ERR] || '';

/** Where a write lands. One code, one channel, and nothing from the request in either. */
const backWithOk = (code: keyof typeof FLASH_OK) => '/portal/employee?ok=' + code;
const backWithErr = (code: keyof typeof FLASH_ERR) => '/portal/employee?err=' + code;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action') as string;

  // EVERY WRITE IS GATED ON THE SAME WIDGET THE FORM CAME FROM. A form that was never rendered must
  // not be postable, and the eligibility answer is already resolved above — so the control and the
  // write agree by construction instead of by two people remembering to keep them in step.
  //
  // =================================================================================================
  // THE PUNCH GOES THROUGH punch(). THIS PAGE NO LONGER WRITES ATTENDANCE ITSELF.
  //
  // WHAT WAS HERE, AND WHY IT WAS THE WORST KIND OF BUG. There were TWO writers of hr_attendance, one
  // tap apart on the same navigation bar, and they did different arithmetic:
  //
  //   /portal/employee/attendance  -> punch() (src/lib/attendance.ts:1146). Validates the kind against
  //      the day so far, inserts the raw event, then RECOMPUTES the whole day from the event log:
  //      first clock_in to last clock_out, minus closed breaks, floored at zero and capped at
  //      MAX_DAY_MINUTES. break_minutes lands in its own column and is excluded from worked time.
  //
  //   this page (the Home card)   -> a hand-written INSERT plus an UPDATE that set
  //      work_hours = NOW() - clock_in. WALL CLOCK. break_start and break_end were recorded as events
  //      and subtracted from NOTHING, so an hour of lunch was paid time. It also validated no event
  //      type at all, had no refusal rule, and overwrote clock_in on a second clock_in.
  //
  // hr_attendance.work_hours is what weeklyTimesheet() renders, what computePay() counts and what
  // credit-ledger.ts turns into an intern's recorded hours. So which of two buttons somebody pressed
  // decided whether their lunch break was paid, and nothing on any screen said so.
  //
  // Now there is ONE writer. This handler collects evidence off the form and hands it to the engine;
  // every rule — what may be punched next, what the day adds up to, what the failure was — is
  // answered in one place, by the same function the attendance page calls.
  // =================================================================================================
  if (action === 'clock_event' && employeeId && has('clock.today')) {
    const eventType = String(fd.get('event_type') || '');
    const lat = parseFloat(fd.get('lat') as string || '0') || null;
    const lon = parseFloat(fd.get('lon') as string || '0') || null;
    const accuracy = parseFloat(fd.get('accuracy') as string || '0') || null;
    const workMode = String(fd.get('work_mode') || 'remote');
    const note = (fd.get('note') as string || '').trim() || null;
    // The selfie the capture modal attaches. NOT handed to punch(): PunchEvidence has no field for an
    // image and no column takes one — it carries a face-check OUTCOME the server computed, never a
    // picture. Kept here so the existing behaviour is not silently deleted (the strip on
    // /admin/hr/attendance renders these), and written AFTER the punch as a separate, non-fatal
    // update. The honest follow-up is recorded below.
    const facePhoto = (fd.get('face_photo') as string || '').slice(0, 300000) || null;

    // Which success sentence this punch earns, decided from the event type BEFORE anything is
    // written, so the branch below has one job: record it, or say plainly that it did not.
    let punchOk: keyof typeof FLASH_OK = 'clocked_in';
    if (eventType === 'clock_out') punchOk = 'clocked_out';
    else if (eventType === 'break_start') punchOk = 'break_started';
    else if (eventType === 'break_end') punchOk = 'break_ended';

    let res: any = null;
    try {
      const { punch } = await import('@/lib/attendance');
      res = await punch(employeeId, eventType, {
        lat,
        lon,
        accuracy,
        workMode,
        note,
        ipAddress: Astro.clientAddress,
        deviceInfo: Astro.request.headers.get('user-agent') || null,
      });
    } catch (e: any) {
      // NEVER SWALLOWED, AND NEVER DRESSED AS SUCCESS. The real Postgres reason is on e.cause;
      // e.message is only the failed SQL, which is what used to be handed to the browser in the
      // address bar. The person gets the negative sentence, the log gets the cause.
      logFail('clock_event', e);
      return Astro.redirect(backWithErr('clock_failed'));
    }

    if (!res?.ok) {
      // WHICH FAILURE, ANSWERED FROM THE ENGINE'S OWN PURE FUNCTION rather than from its prose.
      //
      //   totals present, and this kind is not one the day allows  -> a refusal. Nothing was written.
      //   totals present, and it WAS allowed                       -> the event landed, the day did
      //                                                               not. A different sentence.
      //   no totals                                                -> refused before the insert (an
      //                                                               unreadable date, a bad kind).
      //                                                               Nothing was written.
      let code: keyof typeof FLASH_ERR = 'clock_failed';
      if (res?.totals) {
        let allowed: string[] = [];
        try {
          const { allowedPunches } = await import('@/lib/attendance');
          allowed = allowedPunches(res.totals) as string[];
        } catch (e: any) {
          logFail('allowedPunches', e);
        }
        if (allowed.length > 0 && allowed.indexOf(eventType) < 0) {
          if (eventType === 'clock_in') code = 'punch_already_in';
          else if (eventType === 'clock_out') code = 'punch_not_checked_in';
          else if (eventType === 'break_start') {
            code = res.totals.onBreak ? 'punch_already_on_break' : 'punch_not_checked_in';
          } else code = res.totals.open ? 'punch_no_break_running' : 'punch_not_checked_in';
        } else {
          code = 'punch_day_not_written';
        }
      }
      // The engine's sentence goes to the LOG, where a developer reads it, and never into the query
      // string this page renders back.
      console.error('[portal/employee] punch refused', eventType, res?.error || 'no reason given');
      return Astro.redirect(backWithErr(code));
    }

    // THE SELFIE, ATTACHED AFTER THE FACT AND NEVER ALLOWED TO FAIL THE PUNCH.
    //
    // Scoped to this employee's newest event and to a row that has no photo yet, so a retry cannot
    // overwrite an earlier punch's picture. It is a compromise and it is written down as one: the
    // rest of the product has moved to a server-computed face-check OUTCOME (src/lib/attendance-verify.ts,
    // which stores a verdict and never an image, and whose own header calls hr_clock_events.face_photo
    // a pre-existing problem it did not fix), and /api/portal/attendance/punch.ts refuses image
    // fields outright. This form still captures a picture, and deleting that quietly would remove a
    // strip an admin screen renders — so it is preserved exactly, and the follow-up is to replace the
    // capture with a descriptor check like every other surface.
    if (facePhoto) {
      try {
        await db.execute(sql`ALTER TABLE hr_clock_events ADD COLUMN IF NOT EXISTS face_photo TEXT`);
        await db.execute(sql`
          UPDATE hr_clock_events SET face_photo = ${facePhoto}
           WHERE id = (SELECT id FROM hr_clock_events
                        WHERE employee_id = ${employeeId}::uuid AND event_type = ${eventType}
                        ORDER BY event_time DESC LIMIT 1)
             AND face_photo IS NULL`);
      } catch (e: any) {
        // Not fatal and not silent. The punch is recorded and counted; only the picture is missing,
        // and a picture is evidence beside a fact rather than the fact.
        logFail('punch face photo', e);
      }
    }

    // The wrap-up note typed on the clock-out form. Secondary to the punch — it must never fail one —
    // but a bare catch meant a note somebody typed vanished with no trace anywhere.
    if (eventType === 'clock_out') {
      try {
        const task = (fd.get('task') as string || '').trim();
        if (task) {
          const logDay = composed.context.today || todayIso;
          await db.execute(sql`INSERT INTO hr_task_log (employee_id, log_date, task, status, percent, details) VALUES (${employeeId}, ${logDay}, ${task.slice(0, 500)}, ${(fd.get('task_status') as string) || 'done'}, ${Math.max(0, Math.min(100, parseInt(fd.get('task_percent') as string || '100') || 100))}, ${(fd.get('task_details') as string || '').trim() || null})`);
        }
      } catch (e: any) {
        logFail('clock_out task log', e);
      }
    }

    return Astro.redirect(backWithOk(punchOk));
  }

  // =================================================================================================
  // THE DAILY REPORT IS NOT WRITTEN HERE ANY MORE. THIS PAGE HAD THE SECOND WRITER, AND IT WAS SILENT.
  //
  // WHAT WAS HERE: `INSERT INTO hr_daily_reports ... ON CONFLICT DO UPDATE SET work_done, progress,
  // blockers`. Three things were wrong with it, and every one of them is a promise the screen made
  // and did not keep:
  //
  //   1. IT TOLD NOBODY. src/lib/daily-report.ts submitReport() resolves the reviewer from the
  //      Organization Graph and notifies them (daily-report.ts:972). This handler notified no one, so
  //      a report filed from Home reached a reviewer only if they happened to open the team screen.
  //      The person had written up their day and believed it had been sent.
  //
  //   2. IT DESTROYED THE REVISION TRAIL. submitReport() snapshots the live row into
  //      hr_daily_report_revisions inside a transaction, under a row lock, BEFORE overwriting it —
  //      the module's header (daily-report.ts:36) says plainly why: without it, "we shipped the
  //      parser" becomes unfalsifiable, because the text a reviewer read is gone. This upsert
  //      overwrote work_done with no snapshot and without incrementing revision_count, so an edit
  //      made from Home existed in no revision and in no live copy of what came before.
  //
  //   3. IT WROTE A COLUMN NOBODY READS. `progress` is written by this form and by nothing else, and
  //      it is not in REPORT_COLS (daily-report.ts:536) — no reviewer screen, no export and no reader
  //      anywhere in src/ ever selects it. What somebody typed into "Progress and what is next" went
  //      nowhere at all.
  //
  // So the card below is a STATUS AND A DOOR. Filing and revising happen on /portal/employee/reports,
  // which is the one writer, requires the link a reviewer can actually open, records the revision and
  // tells the person who reads it — and which says, correctly, that nobody is named as a reviewer
  // until the Organization Graph is initialized rather than naming somebody plausible.
  // =================================================================================================

  if (action === 'add_time_log' && employeeId && has('timelog.today')) {
    const startTime = (fd.get('start_time') as string || '').trim();
    const endTime = (fd.get('end_time') as string || '').trim();
    const task = (fd.get('task') as string || '').trim();
    // The database's day, for the same reason the report above uses it: a block of time logged before
    // dawn was landing on the previous date and disappearing from a card that reads today.
    const today = composed.context.today || todayIso;
    const toMin = (t: string) => { const m = /^(\d{1,2}):(\d{2})$/.exec(t); return m ? (parseInt(m[1]) * 60 + parseInt(m[2])) : -1; };
    const s = toMin(startTime), e = toMin(endTime);
    if (s < 0 || e < 0 || e <= s) {
      return Astro.redirect(backWithErr('time_invalid'));
    }
    if (!task || task.length < 3) {
      return Astro.redirect(backWithErr('time_task_missing'));
    }
    const hours = Math.round(((e - s) / 60) * 100) / 100;
    try {
      await db.execute(sql`INSERT INTO hr_time_logs (employee_id, log_date, start_time, end_time, hours, task) VALUES (${employeeId}, ${today}, ${startTime}, ${endTime}, ${hours}, ${task})`);
    } catch (er: any) {
      logFail('add_time_log', er);
      return Astro.redirect(backWithErr('time_failed'));
    }
    // The hours used to be interpolated into the URL. The card already prints the running total for
    // the day, so the figure is on screen either way and nothing variable needs to travel in a query
    // string that is rendered back into a banner.
    return Astro.redirect(backWithOk('time_logged'));
  }
  if (action === 'delete_time_log' && employeeId && has('timelog.today')) {
    const logId = (fd.get('log_id') as string || '').trim();
    // A deletion that says nothing at all is indistinguishable from a deletion that did not happen —
    // and the row simply disappearing is not confirmation, because a mis-tap looks exactly the same.
    let deleted = true;
    if (logId) {
      try {
        await db.execute(sql`DELETE FROM hr_time_logs WHERE id = ${logId} AND employee_id = ${employeeId}`);
      } catch (e: any) {
        deleted = false;
        logFail('delete time log', e);
      }
    }
    return Astro.redirect(deleted ? backWithOk('time_deleted') : backWithErr('time_failed'));
  }

  // Move a task along.
  //
  // The actor passed to updateTaskStatus() is `user.id`, a USERS id — NOT the hr_employees id. The
  // library re-derives the right to write inside the UPDATE's own WHERE clause, matching the actor
  // against `assigned_by_user_id` or against `hr_employees.user_id` for the assignee. Handing it an
  // hr_employees id instead would match neither: every update would update zero rows and refuse
  // with "That task is not available." while looking, from here, exactly like a permission problem.
  // Same class of mistake as joining reporting_manager_id to hr_employees.id.
  //
  // The posted task_id is not trusted on its own — nothing here checks ownership, because the
  // statement that writes is the thing that checks it, and there is no path around that.
  if (action === 'task_status' && employeeId && has('tasks.mine')) {
    const taskId = (fd.get('task_id') as string || '').trim();
    const nextStatus = (fd.get('status') as string || '').trim();
    // "Blocked" with no stated cause is a task nobody can unblock, so the library requires a reason.
    // The field is carried through from the form rather than dropped, otherwise choosing Blocked
    // would be a control that always refuses.
    const blockedReason = (fd.get('blocked_reason') as string || '').trim();
    if (!taskId) {
      return Astro.redirect(backWithErr('task_unknown_status'));
    }
    // WHAT WE ACCEPT IS WHAT THE ENGINE RECOGNISES, not a list written out on this page.
    //
    // This used to test the posted value against a four-name array declared at the top of this file
    // — the LEGACY statuses — so 'under_review', 'accepted', 'approved' and every other canonical
    // value the control now offers would have been rejected here as "not a status we track" before
    // the library ever saw them. canonicalStatus() is the library's own reader and accepts both
    // vocabularies; whether the MOVE is permitted is still decided by updateTaskStatus(), which
    // re-derives the right inside its own UPDATE.
    let taskUpdated = false;
    try {
      const { updateTaskStatus, canonicalStatus } = await import('@/lib/employee-tasks');
      const canonical = canonicalStatus(nextStatus);
      if (!canonical) return Astro.redirect(backWithErr('task_unknown_status'));
      const res = await updateTaskStatus(taskId, user.id, canonical as any, {
        blockedReason,
        ipAddress: Astro.clientAddress,
      });
      taskUpdated = res?.ok === true;
      if (!taskUpdated) console.error('[portal/employee] task_status refused', res?.error || 'no reason given');
    } catch (e: any) {
      logFail('task_status', e);
    }
    return Astro.redirect(taskUpdated ? backWithOk('task_updated') : backWithErr('task_failed'));
  }
}

// =================================================================================================
// WIDGET DATA LOADERS. EVERY ONE OF THEM IS BELOW THE BOUNDARY AND EVERY ONE IS GATED ON has(...).
//
// The gate is not decoration and it is not an optimisation. A loader that runs for somebody who
// cannot see its card has read their colleagues' rows on their behalf; the fact that the render then
// discards them changes nothing that already happened. So each read below asks the composer first,
// and asks nothing else — no role, no permission key, no department, no employment type appears in
// this file at all.
//
// AND THE SECOND RULE: an empty bucket and a failed read are different sentences. Every source
// records whether it RAN, so no card can print "you have nothing" over a query that threw. That is
// the same failure shape as a green flash over a write that never landed, and this page has been
// punished for it twice.
// =================================================================================================

// Which sources the "Needs you today" section is entitled to draw on. Each row of that section
// belongs to a widget, so each is gated by ITS widget rather than by one blanket test — which is how
// the leave and withdrawal queues stopped depending on a role name spelled out on this page.
const wantAttention = has('attention.queue');
const wantTaskView = !!employeeId && (has('tasks.mine') || has('tasks.dueToday'));
const wantDueToday = wantAttention && has('tasks.dueToday');
const wantBoard = wantAttention && (has('tasks.signoff') || has('tasks.review'));
const wantLeaveQueue = wantAttention && has('approvals.leave');
const wantWithdrawalQueue = wantAttention && has('approvals.withdrawal');
// Everything the workflow engine routed to this person, in every domain that is not leave or a
// wallet withdrawal. See the loader below for what was wrong before it existed.
const wantRoutedQueue = wantAttention && has('approvals.routed');
const wantMyDocs = wantAttention && has('onboarding.docs');
const wantDocReview = wantAttention && has('onboarding.review');

// MY TASKS. src/lib/employee-tasks.ts owns the table, the scoping and the schema ensure; this page
// only asks it for one person's rows and is handed the hr_employees id, which is what every hr_*
// table is keyed by. (The WRITE above takes user.id instead; the two are different ids for different
// questions, and the library is explicit about which it wants.)
//
// myTasksView() is used rather than listMyTasks()+taskCounts() for one reason: it reports whether the
// read HAPPENED. Both of those return [] and zeroes on failure, so "you have no tasks" and "the query
// threw" arrive identically — and the card would then print "Nothing on your list right now" at
// somebody whose task table could not be read. That is a claim, not an absence.
let myTasks: any[] = [];
let taskTally: any = null;
let tasksReady = false;
let tasksFailed = false;
// THE MOVES THIS PERSON MAY ACTUALLY MAKE, per task, from the engine's own transition graph.
//
// WHAT WAS WRONG. The status control offered a fixed four — Not started, In progress, Blocked, Done
// — which are the LEGACY names, and employee-tasks.ts has ten canonical statuses with a real graph
// between them (TRANSITIONS, :250). So an assignee whose task had reached 'under_review' was shown
// "Done", chose it, and was refused with a flat "That task could not be updated. Nothing has
// changed." — no reason, because the library's sentence is deliberately logged rather than
// forwarded into a query string. The control existed only to be refused, which teaches people the
// system is broken. allowedTransitionsFor() is exported precisely so a screen does not have to
// guess; its docblock says "render the buttons from THIS".
//
// ROLE 'assignee', because this list IS the person's own assigned work — myTasksView() is scoped to
// their employee id. Anything they hold a different role on (approver, lead, reviewer) is on the
// board at /portal/tasks, which resolves viewerRoles per row in SQL. A narrower role here can only
// offer fewer moves, never more, and the write re-derives the right inside its own UPDATE anyway.
let taskMoves: Record<string, { value: string; label: string }[]> = {};
if (wantTaskView) {
  try {
    const {
      myTasksView, allowedTransitionsFor, STATUS_LABELS, canonicalStatus,
    } = await import('@/lib/employee-tasks');
    const view = await myTasksView(employeeId as string);
    myTasks = Array.isArray(view?.tasks) ? view.tasks : [];
    taskTally = view?.counts ?? null;
    tasksReady = true;
    tasksFailed = !view?.ok;
    for (const t of myTasks as any[]) {
      if (!t?.id) continue;
      const from = canonicalStatus(t.state || t.status) || 'assigned';
      taskMoves[String(t.id)] = allowedTransitionsFor(from, 'assignee').map((s: any) => ({
        value: String(s),
        label: (STATUS_LABELS as any)[s] || String(s),
      }));
    }
  } catch (e: any) {
    logFail('tasks', e);
  }
}
// listMyTasks returns everything, finished work sorted last. This page is the phone screen someone
// checks between jobs, so it shows what is still outstanding; the finished count goes in the
// subtitle rather than as rows nobody needs to scroll past.
//
// `isOverdue` is computed by Postgres against CURRENT_DATE inside the query. Preferring it to a
// string comparison here keeps one definition of "late" instead of two that drift apart by a day
// whenever the server clock and UTC disagree.
const openTasks = myTasks
  .filter((t: any) => t.id && t.status !== 'done')
  .map((t: any) => ({
    id: t.id,
    title: t.title || 'Untitled task',
    priority: String(t.priority || 'normal').toLowerCase(),
    status: String(t.status || 'open').toLowerCase(),
    due: isoDay(t.dueOn),
    overdue: !!t.isOverdue,
    detail: t.description || '',
    blockedReason: t.blockedReason || '',
    from: t.selfAssigned ? '' : (t.assignedByName || ''),
    /** The canonical status, which is what the transition graph speaks. `status` above is the
     *  four-value legacy window this page's older markup reads. */
    state: String(t.state || t.status || 'assigned').toLowerCase(),
    /** Only the moves this person may make from where the task actually is. Never a fixed list. */
    moves: taskMoves[String(t.id)] || [],
  }));
const overdueCount = Number(taskTally?.overdue ?? NaN);
const doneCount = Number(taskTally?.done ?? NaN);
const overdueShown = Number.isFinite(overdueCount) ? overdueCount : openTasks.filter((t: any) => t.overdue).length;
const taskMeta = [
  overdueShown > 0 ? overdueShown + (overdueShown === 1 ? ' past its date' : ' past their date') : '',
  Number.isFinite(doneCount) && doneCount > 0 ? doneCount + ' finished' : '',
].filter(Boolean).join(' · ');

// TODAY, AS THE DATABASE COUNTS IT — AND IT IS NO LONGER READ HERE.
//
// `todayIso` above is `new Date()` in the SERVER's timezone; `due_on` is compared against
// CURRENT_DATE inside Postgres, in the DATABASE's timezone. The two disagree by a day whenever the
// process and the session are set differently, and "Due today" is exactly the claim that must not be
// off by one.
//
// This page used to run its own `SELECT CURRENT_DATE` right here. It does not any more: the
// composer resolves the day ONCE, onto ctx.today, and every day-partitioned widget on every surface
// now partitions on the same value. Two surfaces asking two clocks is how the workspace and the task
// board come to disagree about what is due today — and it is one query fewer per request, not one
// more, because the composer folded it into a read it was already making.
//
// Empty string when the composer could not resolve it. The due-today bucket is then not rendered AT
// ALL rather than guessed at from the clock in this process.
const dbToday = composed.context.today || '';

// TODAY'S CLOCK — READ BY THE SAME ENGINE THAT WRITES IT.
//
// hr_clock_events for this person only: it stores GPS, IP, device and a selfie per punch, and no
// surface may read it for anybody else.
//
// THE ARITHMETIC IS NO LONGER DONE HERE, and that is the point. This block used to derive the day
// itself — status from the LAST event, hours as wall clock from the first clock_in — which disagreed
// with punch() in three ways at once: it read the day in the SERVER's timezone rather than the one
// attendance is counted in (DATE(event_time) = CURRENT_DATE against the session zone, which is UTC),
// it treated a stray second clock_in as a fresh start, and it subtracted no break time at all. So
// the figure on this card was not the figure on the timesheet, and neither the person nor their
// manager had any way to see which one payroll would use.
//
// computeDay() is pure and is the ONLY expression of that arithmetic; allowedPunches() draws the
// buttons from the same totals the write path re-checks. Same day boundary (attendance today()),
// same fold, same answer.
let todayEvents: any[] = [];
let currentStatus: 'clocked_out' | 'clocked_in' | 'on_break' = 'clocked_out';
let todayHours = 0;
let todayBreakMinutes = 0;
/** Which punches the day allows next. The buttons are drawn from THIS and from nothing else. */
let punchOptions: string[] = [];
// Whether the PUNCH READ happened. currentStatus and todayHours both default to "clocked out, zero
// hours", which is indistinguishable from a failed read — and the strip at the top of the page
// states today's clock position as a fact.
let clockReadFailed = false;
if (employeeId && has('clock.today')) {
  try {
    const {
      today: attendanceToday, punchesOn, punchLog, computeDay, allowedPunches,
    } = await import('@/lib/attendance');
    // The day the ATTENDANCE module cuts, not the one this process would. Null means the read did
    // not happen, and a day-partitioned claim must not be made on a guess.
    const day = await attendanceToday();
    if (!day) {
      clockReadFailed = true;
    } else {
      // punchLog() for the visible list (it carries the location and the verification badge the rows
      // render), computeDay() over the kinds and times for the totals. One extra read against the
      // same table, and it buys a page that cannot disagree with the timesheet.
      const log = await punchLog(employeeId, day);
      const totals = computeDay(await punchesOn(employeeId, day));
      // A positional id, not the timestamp: the markup builds an element id from it, and an ISO
      // string carries colons. The live-time script selects on [data-ts] rather than by id, so this
      // is about the markup being well formed rather than about anything working.
      todayEvents = log.map((e: any, i: number) => ({
        id: 'p' + i,
        event_type: e.kind,
        event_time: e.at,
        location_name: e.locationName || e.stationLabel || null,
      }));
      currentStatus = totals.onBreak ? 'on_break' : (totals.open ? 'clocked_in' : 'clocked_out');
      todayHours = Math.round((totals.workedMinutes / 60) * 10) / 10;
      todayBreakMinutes = totals.breakMinutes;
      punchOptions = allowedPunches(totals) as string[];
    }
  } catch (e: any) {
    // Logging only — no control flow changed here. This catch is worth a line because of what its
    // silence looks like: if the punch READ fails, currentStatus stays 'clocked_out' and the page
    // offers "Clock In" to somebody who is already clocked in. The WRITE path above is untouched and
    // re-checks the same rule anyway, so a stale button cannot produce a wrong punch.
    clockReadFailed = true;
    logFail('clock events', e);
  }
}

// HOW THIS PERSON LAST CLOCKED IN, so the form does not ask them the same question about themselves
// twice a day forever.
//
// The work_mode select defaulted to 'remote' on every single render. For an office-based employee
// that is the wrong answer, every morning, and the fastest path through the form is to leave the
// default alone — so 'remote' silently over-reports in hr_attendance.work_mode and the attendance
// data is quietly wrong for exactly the people who never touch the control. Adjacent in spirit to
// WCAG 2.2 SC 3.3.7 Redundant Entry: information the system already holds about you should not be
// asked for again.
//
// ONE ROW, AND ONLY WHEN THE CLOCK-IN FORM IS ABOUT TO RENDER. Somebody already clocked in is not
// shown this control, so there is nothing to prefill and no reason to pay for the read. Scoped to
// the caller's own employee id like every other read on this page, and a failure leaves the old
// 'remote' default in place rather than breaking the form.
let lastWorkMode = '';
if (employeeId && has('clock.today') && currentStatus === 'clocked_out') {
  try {
    const r = await db.execute(sql`
      SELECT work_mode FROM hr_clock_events
       WHERE employee_id = ${employeeId} AND event_type = 'clock_in' AND work_mode IS NOT NULL
       ORDER BY event_time DESC
       LIMIT 1
    `);
    lastWorkMode = String(rowsOf(r)[0]?.work_mode || '');
  } catch (e: any) {
    logFail('last work mode', e);
  }
}
// Only a value the select actually offers. Anything else — an old code, a null, a value written by a
// surface that has since changed — falls back to the original default rather than rendering a
// <select> with nothing selected.
const WORK_MODES = ['remote', 'office', 'hybrid', 'field'];
const workModeDefault = WORK_MODES.includes(lastWorkMode) ? lastWorkMode : 'remote';

// Today's time logs (period tracking)
let timeLogs: any[] = [];
let loggedHours = 0;
if (employeeId && has('timelog.today')) {
  try {
    // The same day the write above used. These two must never be resolved from different clocks:
    // the read decides what the card shows, and the write decides what exists.
    const r = await db.execute(sql`SELECT id, log_date, start_time, end_time, hours, task FROM hr_time_logs WHERE employee_id = ${employeeId} AND log_date = ${dbToday || todayIso} ORDER BY start_time ASC`);
    timeLogs = rowsOf(r);
    loggedHours = Math.round(timeLogs.reduce((a: number, l: any) => a + Number(l.hours || 0), 0) * 100) / 100;
  } catch (e: any) {
    logFail('time logs', e);
  }
}

// Today's clock-out task summaries. Sparse by construction: the only writer is the clock_out branch
// above, and only when the text field is non-empty.
let taskLogs: any[] = [];
if (employeeId && has('worklog.today')) {
  try {
    const r = await db.execute(sql`SELECT task, status, percent, details, created_at FROM hr_task_log WHERE employee_id = ${employeeId} AND log_date = CURRENT_DATE ORDER BY created_at DESC`);
    taskLogs = rowsOf(r);
  } catch (e: any) {
    logFail('session summaries', e);
  }
}

// TODAY'S REPORT — READ HERE, WRITTEN NOWHERE ON THIS PAGE ANY MORE. See the long note beside the
// card for what the write used to do and why it had to stop.
//
// A DIRECT READ RATHER THAN getReport(), and the reason is rule 2 of the loaders file: getReport()
// returns null both when there is genuinely no report and when its own query threw, and this card
// states "no report filed yet" as a fact about somebody's day. The column list is the same set the
// module maps, narrowed to what this card renders — no SELECT *, which used to drag every review
// column onto a page that shows none of them.
let todayReport: any = null;
let reportReadFailed = false;
if (employeeId && has('dailyreport.today')) {
  try {
    const r = await db.execute(sql`
      SELECT report_url, work_done, blockers, revision_count, reviewed_at
        FROM hr_daily_reports
       WHERE employee_id = ${employeeId} AND report_date = ${dbToday || todayIso}
       LIMIT 1`);
    todayReport = rowsOf(r)[0] || null;
  } catch (e: any) {
    reportReadFailed = true;
    logFail('daily report', e);
  }
}

// Payslips. Listed straight from hr_payslips and NEVER through hr-payslip.ts's reader, which SELECTs
// e.work_email — a column with no writer at all.
let payslips: any[] = [];
if (employeeId && has('payslips.mine')) {
  try {
    const r = await db.execute(sql`
      SELECT ps.*, pr.month, pr.year
      FROM hr_payslips ps
      JOIN hr_payroll_runs pr ON ps.payroll_run_id = pr.id
      WHERE ps.employee_id = ${employeeId}
      ORDER BY pr.year DESC, pr.month DESC
      LIMIT 12
    `);
    payslips = rowsOf(r);
  } catch (e: any) {
    logFail('payslips', e);
  }
}

// MY TEAM LEADER. reporting_manager_id holds a USERS id, not an hr_employees id — hr-wallet.ts
// compares it straight to the signed-in user.id — so the lookup is on user_id. Joining it to
// hr_employees.id can never match, which is how the same section on /portal/workspace used to read
// "not recorded" for people whose manager was recorded perfectly well.
//
// TWO QUERIES BECAME NONE ON THIS PAGE. The pointer is resolved by the composer onto
// ctx.reportingManagerUserId (folded into a read it already made), and the name comes from
// managerNameFor() in src/lib/workforce/loaders.ts, which owns the ORDER BY that matters: one human
// can hold more than one hr_employees row (a closed internship plus a current contract), so their
// current row is the one to show.
//
// This is the only row belonging to somebody else that this page reads, and it is narrowed to two
// display columns — no email, no identifier, no employment detail — reached solely through a
// pointer stored on the viewer's own record.
//
// ASKED OF THE ORGANIZATION GRAPH FIRST, AND "NOBODY" IS NO LONGER ONE SENTENCE.
//
// The card used to read the column alone and render every empty answer as "Not assigned yet — ask HR
// to set your reporting manager". The Organization Graph ships EMPTY until the founder runs
// db/org-graph-backfill.sql, and until then getManager() answers null for every person in the
// company — so a card built on the graph would have told the entire workforce that they report to
// nobody. That is a claim about a real person, made on the strength of a table nobody has filled in
// yet, and it is a different fact from "the graph is not initialized".
//
// reportingManagerCard() keeps the four answers apart (loaders.ts). This page renders a different
// sentence for each, and only ONE of them is allowed to say that no manager is recorded.
let manager: any = null;
let managerReadFailed = false;
let managerSource: string = 'none';
if (employeeId && has('manager.card')) {
  try {
    const { reportingManagerCard } = await import('@/lib/workforce/loaders');
    const found = await reportingManagerCard(employeeId, composed.context.reportingManagerUserId);
    managerSource = found.source;
    managerReadFailed = !found.ok;
    manager = found.person;
  } catch (e: any) {
    managerReadFailed = true;
    managerSource = 'failed';
    logFail('manager', e);
  }
}

// THE SENTENCES, BUILT HERE RATHER THAN AS NESTED TERNARIES INSIDE JSX.
//
// Exactly one of these says that no reporting manager is recorded, and it is reachable only when the
// Organization Graph is initialized, holds no edge for this person, and their employee record
// carries no pointer either. Everything else names what is actually unknown.
const managerEmptyTitle =
  managerSource === 'failed' || managerReadFailed
    ? 'We could not read this just now'
    : managerSource === 'graph-empty'
      ? 'The Organization Graph is not set up yet'
      : 'Not assigned yet';
const managerEmptyBody =
  managerSource === 'failed' || managerReadFailed
    ? 'This is not a statement that you have no reporting manager — the read itself failed. Reload in a moment.'
    : managerSource === 'graph-empty'
      ? 'Reporting lines are held in the Organization Graph, and it has not been filled in yet — so this is a gap in the company\'s records rather than anything about you. Nobody has a manager on it. Ask HR when it is being loaded.'
      : 'Ask HR to set your reporting manager on your employee record. Until it is set there is no named approver for your leave or wallet requests.';
// When somebody IS shown, where the answer came from — because a name resolved from the graph and a
// name resolved from a column that the graph does not agree with are different facts, and the second
// one is worth somebody knowing about.
const managerProvenance =
  managerSource === 'graph-empty'
    ? 'Taken from your employee record. The Organization Graph is not set up yet, so this has not been confirmed against it.'
    : managerSource === 'column-only'
      ? 'Taken from your employee record. The Organization Graph does not hold a reporting line for you, so the two do not agree — worth mentioning to HR.'
      : '';

// WAITING ON MY SIGN-OFF, AND WAITING ON MY REVIEW.
//
// listBoard() resolves the viewer's roles per row IN SQL (VIEWER_ROLE_COLUMNS), so nothing here can
// claim a role the database did not grant. Its argument is the USERS id — collaborators are keyed
// by users.id, not by the hr_employees id, and handing it the wrong one returns an empty board
// forever rather than an error.
//
// A task where the viewer is approver OR lead is counted as sign-off and NOT again as a review, so
// somebody holding both roles on one task sees it once. Reviewers are only ever added by hand
// (seedCollaborators creates 'assignee' and 'approver' and nothing else), so an empty review bucket
// is the ordinary, correct state and is simply absent rather than rendered as a zero.
let boardOk = false;
let signOffTasks: any[] = [];
let reviewTasks: any[] = [];
if (wantBoard && user?.id) {
  try {
    const { listBoard } = await import('@/lib/employee-tasks');
    const board = await listBoard(user.id, { limit: 400 });
    boardOk = board?.ok === true;
    if (boardOk) {
      const waiting = (board.tasks as any[]).filter((t: any) => t.status === 'under_review');
      signOffTasks = has('tasks.signoff')
        ? waiting.filter((t: any) => t.viewerRoles.indexOf('approver') >= 0 || t.viewerRoles.indexOf('lead') >= 0)
        : [];
      const signOffIds = new Set(signOffTasks.map((t: any) => t.id));
      reviewTasks = has('tasks.review')
        ? waiting.filter((t: any) => !signOffIds.has(t.id) && t.viewerRoles.indexOf('reviewer') >= 0)
        : [];
    }
  } catch (e: any) {
    logFail('board', e);
  }
}

// LEAVE AND WITHDRAWAL REQUESTS WAITING ON A DECISION.
//
// THE ROLE TEST THAT USED TO LIVE HERE IS GONE. This page previously read user.role and compared it
// to three names, which meant a reporting manager — the person a request is actually assigned to —
// was told nothing, and it meant a role rename silently changed who was told. approvals.leave and
// approvals.withdrawal carry `approvesRequests`, which the composer derives from the SAME authority
// pendingLeaveForApprover() and pendingWithdrawalsForApprover() enforce at the read, so a row shown
// here always has a queue behind it.
//
// Counts only — no names, no amounts, no reasons. Own rows are excluded: your own pending request is
// not an approval waiting on YOU, it is on /portal/employee/leave.
let pendingLeave = 0;
let pendingWithdrawals = 0;
let hrQueueFailed = false;
if (wantLeaveQueue || wantWithdrawalQueue) {
  try {
    const [{ pendingLeaveForApprover }, { pendingWithdrawalsForApprover }] = await Promise.all([
      import('@/lib/hr-leave'),
      import('@/lib/hr-wallet'),
    ]);
    const [lv, wd] = await Promise.all([
      wantLeaveQueue ? pendingLeaveForApprover(user) : Promise.resolve([] as any[]),
      wantWithdrawalQueue ? pendingWithdrawalsForApprover(user) : Promise.resolve([] as any[]),
    ]);
    const mine = (r: any) => !!employeeId && String(r.employee_id) === String(employeeId);
    pendingLeave = (lv as any[]).filter((r: any) => !mine(r)).length;
    pendingWithdrawals = (wd as any[]).filter((r: any) => !mine(r)).length;
  } catch (e: any) {
    hrQueueFailed = true;
    logFail('approver queue', e);
  }
}

// EVERYTHING ELSE ROUTED TO THIS PERSON — the queue this page could not see.
//
// THE HOLE THIS CLOSES. The two counts above are leave and wallet withdrawals: two of the nineteen
// domains in src/lib/workflow.ts. Everything else the org graph routes to somebody — a submitted
// weekly timesheet, an overtime claim, an attendance correction, an expense claim, a procurement
// request, a loan, a document, a helpdesk ticket, an appraisal, a benefits election, a separation —
// reaches them through pendingForApprover(), which seven pages call one domain at a time and no
// aggregate surface called at all. So the headline on this card was a count of two domains presented
// as the count of everything waiting, the bar badge was the same two, and a manager who cleared this
// screen to zero had decided nothing about any of the rest. Nobody was told, because
// notifyApprover() sends them to /admin/hr/leave/workflow — a page most managers cannot open and
// which lists only leave.
//
// COUNTS AND DOMAIN NAMES ONLY on this card. The full rows, with the decision buttons, are on
// /portal/approvals; a triage row is a pointer to work, never the work itself.
let routedCount = 0;
let routedRows: any[] = [];
let routedFailed = false;
if (wantRoutedQueue && user?.id) {
  try {
    const { routedApprovals } = await import('@/lib/workforce/loaders');
    const routed = await routedApprovals(String(user.id));
    routedFailed = !routed.ok;
    routedCount = routed.count;
    routedRows = routed.rows;
  } catch (e: any) {
    routedFailed = true;
    logFail('routed approvals', e);
  }
}
// How many DISTINCT kinds of thing are waiting, so one row can say "3 requests — expense claim,
// timesheet" instead of listing three rows that all lead to the same queue.
const routedKinds = Array.from(new Set((routedRows as any[]).map((r: any) => r.domainLabel).filter(Boolean)));

// MEETINGS TODAY — and this page used to deny they could be shown at all.
//
// WHAT WAS WRONG. The "Today" section carried the flat sentence "Scheduled meetings are not shown:
// this workspace has no meeting calendar to read from yet." That stopped being true. meetingSource()
// in src/lib/calendar-hub.ts:515 reads meet_rooms for anything this person HOSTS or is named on the
// invitee list of, and /portal/employee/calendar has been rendering exactly that one route away. So
// the workspace was telling people a capability did not exist while the product had it — the same
// class of fault as a screen promising something it cannot show, pointed the other way, and it sends
// somebody to a colleague to ask what time a meeting is that their own workspace could have told
// them.
//
// THE LIMIT IS CARRIED, NOT HIDDEN. `invitees` is a jsonb list of email strings with no membership
// row and no accepted/declined state, so an invitation appears as an invitation and never as an
// acceptance, and somebody invited at an address they do not sign in with is not matched. The card
// says so rather than implying a complete calendar.
let meetingsToday: any[] = [];
let meetingsOk = false;
if (has('meetings.today') && user?.id && dbToday) {
  try {
    const { buildCalendar } = await import('@/lib/calendar-hub');
    const model = await buildCalendar(
      'meeting',
      {
        userId: String(user.id),
        employeeId,
        departmentId: composed.context.departmentId,
        holds: composed.context.holds,
      },
      { from: dbToday, to: dbToday },
    );
    meetingsOk = !model.degraded;
    meetingsToday = (model.days as any[]).flatMap((d: any) => d.events || []);
  } catch (e: any) {
    logFail('meetings today', e);
  }
}

// JOINING DOCUMENTS, MINE — the ones a reviewer sent back.
//
// listDocs() rather than a COUNT, for two reasons. It is the function that OWNS the table's DDL — its
// ctx() runs the CREATE TABLE IF NOT EXISTS — so this cannot be the query that discovers the table is
// missing. And the cap is MAX_DOCS = 5 rows per person, so reading them costs less than the round
// trip a count would save. It is scoped to user_id inside its own WHERE clause and it THROWS rather
// than returning [] on failure, which is exactly what this needs.
let rejectedDocs = 0;
let docsFailed = false;
if (wantMyDocs && user?.id) {
  try {
    const { listDocs } = await import('@/lib/hr-onboarding');
    const docs = await listDocs(String(user.id));
    rejectedDocs = docs.filter((d: any) => d.status === 'rejected').length;
  } catch (e: any) {
    docsFailed = true;
    logFail('joining documents', e);
  }
}

// JOINING DOCUMENTS WAITING FOR A REVIEW. onboarding.review requires admin.access AND the employees
// section at 'edit' — the same test /api/portal/onboarding/documents uses to authorise the review,
// plus the admin.access that middleware.ts demands at the door, so this count is never put in front
// of somebody whose only route to act on it is a redirect. A COUNT, not pendingForReview(), which
// returns names and email addresses for up to 150 people. Own rows are excluded.
let docsToReview = 0;
let docReviewFailed = false;
if (wantDocReview && user?.id) {
  try {
    const r = await db.execute(sql`
      SELECT COUNT(*)::int AS n FROM hr_onboarding_documents
       WHERE status = 'submitted' AND user_id <> ${String(user.id)}`);
    docsToReview = Number(rowsOf(r)[0]?.n) || 0;
  } catch (e: any) {
    docReviewFailed = true;
    logFail('joining document reviews', e);
  }
}

// THE CREDIT POSITION, AND THE GUARD THAT IS NO LONGER HERE.
//
// This block used to test `classification === 'intern' || employment_type === 'internship'` on this
// page. That test is DELETED. It was an interim guard around one card, and two places deciding the
// same thing is how they drift: the composer answers it now, for every intern widget at once, from
// the engagement it resolved. So a founder, an executive, a professor or a consultant is never
// measured against a target they never agreed to.
//
// The card itself withholds what it cannot stand behind rather than being withheld entirely:
// creditPct stays null when no requirement is recorded, so the progress bar does not render and the
// figure reads "credit-hours" instead of "of N credit-hours". required_credit_hours has one writer
// (/admin/hr/completion/[id].astro) and is unset for most interns, so gating the whole card on it
// would take the credit position away from exactly the people this surface exists for.
//
// One ledgerFor() call serves both credit widgets. Two reads of the same arithmetic can disagree.
let credit: any = null;
let creditTerms: any = null;
let weeksLeft: number | null = null;
if (employeeId && (has('credit.position') || has('credit.weeksLeft'))) {
  try {
    const { ledgerFor, termsFor } = await import('@/lib/credit-ledger');
    creditTerms = await termsFor(employeeId);
    const led = await ledgerFor(employeeId, creditTerms);
    credit = led.summary;
    weeksLeft = has('credit.weeksLeft') ? led.weeksRemaining : null;
  } catch (e: any) {
    // Never blocks the page over a summary — but never silently either. A credit figure that quietly
    // stops appearing is exactly the kind of absence nobody reports and nobody notices.
    logFail('credit', e);
  }
}
const creditPct = credit?.requiredCreditHours
  ? Math.min(100, Math.round((credit.creditHours / credit.requiredCreditHours) * 100))
  : null;

// CHAT. Two numbers, and nothing else is possible. chat_messages stores `ciphertext` and `iv`;
// there is no plaintext column, and the private key is generated in the browser and never leaves
// localStorage, so no server-rendered page can show what was said. chat_threads.last_message_preview
// is not a preview either — the send handler writes the literal string '[encrypted]' into it.
//
// Messages is part of the Universal Workspace, which AUTHORIZATION_FIRST.md grants to EVERY
// authenticated member, so it needs no widget eligibility — but the counts are still read only when
// the composition is trustworthy. On a degraded screen the same card renders as a door with no
// numbers on it, which is the safe direction.
//
// No schema ensure here on purpose: /portal/messages owns these tables, and it also creates a
// starter thread on first visit. This card must never write.
let chatThreads = 0;
let chatUnread = 0;
let chatReady = false;
if (composed.ok && user?.id) {
  try {
    const r = await db.execute(sql`
      SELECT COUNT(*)::int AS threads,
             COUNT(*) FILTER (WHERE EXISTS (
               SELECT 1 FROM chat_messages c
                WHERE c.thread_id = m.thread_id
                  AND c.sender_user_id <> ${user.id}
                  AND c.deleted_at IS NULL
                  AND (m.last_read_at IS NULL OR c.created_at > m.last_read_at)
             ))::int AS unread
        FROM chat_thread_members m
       WHERE m.user_id = ${user.id}`);
    const crows = rowsOf(r);
    chatThreads = Number(crows[0]?.threads) || 0;
    chatUnread = Number(crows[0]?.unread) || 0;
    chatReady = true;
  } catch (e: any) {
    logFail('chat counts', e);
  }
}

// COMMUNITY. visibleGroupsFor() is the only permitted way to list groups, and this page does not go
// near the work_groups table itself. It returns the groups this person belongs to plus the
// sub-groups of those — a group they are not entitled to is ABSENT from the result, not greyed out
// and not "request access", because a list of team names is a map of the organisation.
//
// It deliberately selects `has_link`, never `join_url`: a chat invite link is a bearer credential, so
// the URL is only ever revealed by a POST on /portal/team-groups after membership is re-derived at
// the moment of access. Nothing below renders a link, and there is no total count of anything unseen
// — that would be the same map by another route.
let myGroups: any[] = [];
if (has('groups.mine') && user?.id) {
  try {
    const { visibleGroupsFor } = await import('@/lib/work-groups');
    myGroups = await visibleGroupsFor(user.id);
  } catch (e: any) {
    logFail('groups', e);
  }
}
const memberGroups = myGroups.filter((g: any) => g.isMember);
// Sub-groups of a group they are already in: visible and joinable by definition, so counting them
// discloses nothing they could not already see on /portal/team-groups.
//
// `kind === 'sub'` is not belt-and-braces. joinGroup() in src/lib/work-groups.ts:241 REFUSES anything
// that is not a sub-group — department and global membership follows onboarding, it is not chosen —
// so a non-member row of any other kind would be counted under the words "you can join" and then be
// refused when they tried. Counting only what the join actually accepts keeps the sentence true.
const joinableGroups = myGroups.filter((g: any) => !g.isMember && g.kind === 'sub' && g.parentId);

// =================================================================================================
// THE HOME WIDGETS. Same two rules as everything above: gated on has(...) BEFORE the read, and every
// one of them reports whether the read HAPPENED.
//
// Every loader below lives in src/lib/workforce/loaders.ts rather than in this frontmatter, and that
// is the change that matters. Fifteen loaders were written inline on this page, which was fine while
// there was one workspace surface and fatal the moment there were two: the second surface copies the
// query, the copies drift, and the one that drifts toward showing MORE is the one nobody reports.
// =================================================================================================

// NOTIFICATIONS. Rows are already written for staff accounts — src/lib/push.ts persists first and
// pushes second, so the feed fills even with VAPID unset. What an employee has never had is a
// surface: /portal/notifications.astro:7 redirects every non-applicant to /admin and middleware
// bounces them back, which is the ping-pong that took /portal down before. So the widget carries
// href:null and each ROW is rendered against its own notifications.action_url. This card is that
// missing surface, and it is why the registry's note exists.
let notifs: any = { ok: false, items: [], unread: 0 };
if (has('notifications.unread') && user?.id) {
  try {
    const { myNotifications } = await import('@/lib/workforce/loaders');
    notifs = await myNotifications(String(user.id), 5);
  } catch (e: any) {
    logFail('notifications', e);
  }
}

// DIRECT REPORTS. ctx.managesPeople has been true for reporting managers all along and
// reports.direct has been registered all along, but NOTHING ANYWHERE LOADED IT — a manager with
// direct reports had no way to see who they were. Names and designations only.
//
// ASKED OF THE ORGANIZATION GRAPH FIRST, exactly as the manager card above is, and for the mirror
// image of the same reason. The graph ships EMPTY until db/org-graph-backfill.sql is run, so an
// empty answer from it says nothing whatsoever about whether people report to this person — and
// "nobody is recorded as reporting to you" is a claim about a real team. directReportsView() keeps
// the four answers apart and this page renders a different sentence for each; only ONE of them is
// allowed to say that nobody reports to them.
let reports: any = { ok: true, people: [], more: 0, source: 'none' };
if (has('reports.direct') && user?.id) {
  try {
    const { directReportsView } = await import('@/lib/workforce/loaders');
    reports = await directReportsView(String(user.id), employeeId, 6);
  } catch (e: any) {
    logFail('direct reports', e);
    reports = { ok: false, people: [], more: 0, source: 'failed' };
  }
}
// Exactly one of these says that nobody reports to this person, and it is reachable only when the
// Organization Graph is initialized, holds no edge for them, and no colleague's employee record
// points at them either.
const reportsEmptyMessage =
  reports.source === 'graph-empty'
    ? 'Reporting lines are held in the Organization Graph, and it has not been filled in yet — so this is a gap in the company\'s records rather than a statement about your team. Nobody has reports recorded on it. Ask HR when it is being loaded.'
    : 'Nobody is currently recorded as reporting to you. If that is not right, ask HR to set the reporting manager on their records.';
// Where the names came from, when there are names. A team resolved from the graph and a team
// resolved from a column the graph does not agree with are different facts.
const reportsProvenance =
  reports.source === 'graph-empty'
    ? 'Taken from employee records. The Organization Graph is not set up yet, so this has not been confirmed against it.'
    : reports.source === 'column-only'
      ? 'Taken from employee records. The Organization Graph holds no reporting line for you, so the two do not agree — worth mentioning to HR.'
      : '';

// THE DEPARTMENT A LEAD MAY QUERY. Narrowed by departmentFilter() inside the loader, from
// ctx.scopeDepartmentId — which comes from the session (users.assigned_department_id) and never from
// a query string. ctx.departmentId is NOT passed and must never be: that is the person's OWN
// department, display-only, and handing it to the filter would manufacture a peer list for an
// ordinary employee — a new authorisation decision smuggled in as a rendering one.
let roster: any = { ok: true, people: [], more: 0 };
if (has('team.roster') && composed.context.scopeDepartmentId) {
  try {
    const { departmentRoster } = await import('@/lib/workforce/loaders');
    roster = await departmentRoster({ scopeDepartmentId: composed.context.scopeDepartmentId }, 6);
  } catch (e: any) {
    logFail('department roster', e);
    roster = { ok: false, people: [], more: 0 };
  }
}
// THIS MONTH'S ATTENDANCE. Days RECORDED, never a percentage against a target — the target framing
// belongs to credit.position, which is internship-only, and putting a completion bar here is exactly
// the defect the widget registry exists to fix.
let attMonth: any = { ok: false, present: 0, leave: 0, other: 0, daysRecorded: 0, hours: null };
if (employeeId && has('attendance.month')) {
  try {
    const { attendanceMonth } = await import('@/lib/workforce/loaders');
    attMonth = await attendanceMonth(employeeId);
  } catch (e: any) {
    logFail('attendance month', e);
  }
}

// APPROVED LEAVE COVERING TODAY — one of the three things "Today" can honestly say.
let leaveToday: any = { ok: false, days: [] };
if (employeeId && has('schedule.today')) {
  try {
    const { leaveCovering } = await import('@/lib/workforce/loaders');
    leaveToday = await leaveCovering(employeeId, composed.context.today);
  } catch (e: any) {
    logFail('leave today', e);
  }
}

// RECENT ACTIVITY, CAPPED HARD AND ON PURPOSE. listTaskActivity() is PER TASK and there is no
// cross-task personal activity reader in this codebase; building one means exporting visibleToSql()
// from employee-tasks.ts, which is a change to a security-critical query and not something a
// dashboard card gets to force. So it runs for a handful of tasks this page has ALREADY read and
// this person has ALREADY been authorised for, and says so when there were more.
let activity: any = { ok: true, entries: [], partial: false };
if (has('tasks.activity') && user?.id && openTasks.length > 0) {
  try {
    const { recentTaskActivity } = await import('@/lib/workforce/loaders');
    activity = await recentTaskActivity(
      String(user.id),
      openTasks.map((t: any) => ({ id: t.id, title: t.title })),
      { taskCap: 4, entryCap: 6 },
    );
  } catch (e: any) {
    logFail('task activity', e);
    activity = { ok: false, entries: [], partial: false };
  }
}

// =================================================================================================
// THE COMMAND CENTRE ROWS. Everything below feeds the "Needs you today" section.
//
// THE RULE THIS SECTION IS BUILT ON: every number here is an arithmetic partition of rows that
// already exist, read by code that already writes them. Nothing is claimed that the schema cannot
// answer, and nothing that cannot be answered is rendered as an empty card, a zero, or a
// "coming soon" — the things deliberately ABSENT are listed at the end of this script block.
// =================================================================================================

// TASKS: LATE, AND DUE TODAY. Both partitioned out of the list myTasksView already returned, so this
// costs no extra query and cannot disagree with the "My tasks" card further down the page.
const attentionTasksOk = wantTaskView && tasksReady && !tasksFailed;
const overdueTasks = (wantAttention && attentionTasksOk) ? openTasks.filter((t: any) => t.overdue) : [];
const dueTodayTasks = (wantAttention && attentionTasksOk && wantDueToday && dbToday)
  ? openTasks.filter((t: any) => !t.overdue && t.due === dbToday)
  : [];

// Each glyph is a distinct SHAPE, not a colour: a clock, a calendar, two ticks, an eye, a card,
// a folded page, a tray. The row still triages correctly in greyscale, and no emoji appears anywhere.
const GLYPH_LATE = '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.1 1.9"/>';
const GLYPH_TODAY = '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10.2h17M8.5 3v4M15.5 3v4"/>';
const GLYPH_SIGNOFF = '<path d="m2.8 12.6 3.2 3.2 6.6-7"/><path d="m10.6 15.2 1.4 1.4 6.8-7.2"/>';
const GLYPH_REVIEW = '<path d="M2.6 12S6.2 6.2 12 6.2 21.4 12 21.4 12 17.8 17.8 12 17.8 2.6 12 2.6 12Z"/><circle cx="12" cy="12" r="2.4"/>';
const GLYPH_MONEY = '<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10.4h19"/>';
const GLYPH_DOC = '<path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5Z"/><path d="M14 3.5v5h5"/><path d="M8.8 14.2h6.4"/>';
const GLYPH_INBOX = '<path d="M3.5 13.6 6.4 5.3A2 2 0 0 1 8.3 4h7.4a2 2 0 0 1 1.9 1.3l2.9 8.3v4a2 2 0 0 1-2 2H5.5a2 2 0 0 1-2-2Z"/><path d="M3.5 13.6h4l1.4 2.6h6.2l1.4-2.6h4"/>';

const ROW_CAP = 3;
const attentionRows: any[] = [];

overdueTasks.slice(0, ROW_CAP).forEach((t: any) => attentionRows.push({
  key: 'late-' + t.id,
  href: '/portal/tasks/' + t.id,
  title: t.title,
  // Deliberately not the word "overdue" shouted in red. The row below it says what to do; this
  // says what happened.
  note: t.due ? 'Late · was due ' + dayLabel(t.due) : 'Late',
  tone: 'overdue',
  glyph: GLYPH_LATE,
  priority: t.priority,
}));

dueTodayTasks.slice(0, ROW_CAP).forEach((t: any) => attentionRows.push({
  key: 'today-' + t.id,
  href: '/portal/tasks/' + t.id,
  title: t.title,
  note: 'Due today',
  // 'due_soon', not 'due': the tone name has to be a ramp that exists in workforce.css, or the
  // [data-wf-tone] binding misses and the row silently falls back to the neutral ink.
  tone: 'due_soon',
  glyph: GLYPH_TODAY,
  priority: t.priority,
}));

// One summarising row for the whole bucket rather than one row per document, so no cap arithmetic
// applies to it and the number shown IS the number there is.
if (rejectedDocs > 0) attentionRows.push({
  key: 'docs-back',
  href: '/portal/onboarding',
  title: rejectedDocs === 1 ? 'One joining document was sent back' : rejectedDocs + ' joining documents were sent back',
  note: 'Usually the sharing permission rather than the document. Re-share it so anyone with the link can view, then submit it again',
  tone: 'due_soon',
  glyph: GLYPH_DOC,
  priority: '',
});

signOffTasks.slice(0, ROW_CAP).forEach((t: any) => attentionRows.push({
  key: 'sign-' + t.id,
  href: '/portal/tasks/' + t.id,
  title: t.title,
  note: t.employeeName ? 'Waiting for your sign-off · ' + t.employeeName : 'Waiting for your sign-off',
  tone: 'info',
  glyph: GLYPH_SIGNOFF,
  priority: t.priority,
}));

reviewTasks.slice(0, ROW_CAP).forEach((t: any) => attentionRows.push({
  key: 'rev-' + t.id,
  href: '/portal/tasks/' + t.id,
  title: t.title,
  note: t.employeeName ? 'Waiting for your review · ' + t.employeeName : 'Waiting for your review',
  tone: 'info',
  glyph: GLYPH_REVIEW,
  priority: t.priority,
}));

if (docsToReview > 0) attentionRows.push({
  key: 'docs-review',
  href: '/admin/hr/onboarding',
  title: docsToReview === 1 ? 'One joining document needs a review' : docsToReview + ' joining documents need a review',
  note: 'A new hire has done their part and cannot be cleared to join until someone looks',
  tone: 'info',
  glyph: GLYPH_INBOX,
  priority: '',
});

if (pendingLeave > 0) attentionRows.push({
  key: 'leave-queue',
  href: '/portal/approvals',
  title: pendingLeave === 1 ? 'One leave request needs a decision' : pendingLeave + ' leave requests need a decision',
  note: 'Nobody knows if they can take the days until you answer',
  tone: 'info',
  glyph: GLYPH_TODAY,
  priority: '',
});

if (pendingWithdrawals > 0) attentionRows.push({
  key: 'withdrawal-queue',
  href: '/portal/approvals',
  title: pendingWithdrawals === 1 ? 'One withdrawal needs a decision' : pendingWithdrawals + ' withdrawals need a decision',
  note: 'Money already earned, waiting to be released',
  tone: 'info',
  glyph: GLYPH_MONEY,
  priority: '',
});

// ONE ROW FOR EVERY OTHER DOMAIN, naming the kinds so it is not a mystery number. These were routed
// to this person by the org graph and were invisible on every aggregate surface in the product.
if (routedCount > 0) attentionRows.push({
  key: 'routed-queue',
  href: '/portal/approvals',
  title: routedCount === 1 ? 'One request needs your decision' : routedCount + ' requests need your decision',
  note: routedKinds.length > 0
    ? routedKinds.slice(0, 3).join(', ') + (routedKinds.length > 3 ? ' and more' : '') + ' — routed to you, and waiting'
    : 'Routed to you by the Organization Graph, and waiting',
  tone: 'info',
  glyph: GLYPH_INBOX,
  priority: '',
});

// The headline counts THINGS, not rows: four late tasks are four things even though three are shown.
// The overflow link is computed over tasks only, because the two queue rows are already a count of
// everything in them.
const attentionTaskTotal =
  overdueTasks.length + dueTodayTasks.length + signOffTasks.length + reviewTasks.length;
const attentionTaskShown =
  Math.min(ROW_CAP, overdueTasks.length) + Math.min(ROW_CAP, dueTodayTasks.length)
  + Math.min(ROW_CAP, signOffTasks.length) + Math.min(ROW_CAP, reviewTasks.length);
const attentionMore = attentionTaskTotal - attentionTaskShown;
const attentionCount =
  attentionTaskTotal + pendingLeave + pendingWithdrawals + routedCount + rejectedDocs + docsToReview;

// WHAT THE SECTION IS NOT ALLOWED TO SAY. If a source that WAS asked for did not run, "nothing is
// waiting on you" is not a fact this page is in a position to state, so the all-clear is withheld and
// the gap is named instead. A source that was never asked for is not a gap — it is a widget this
// person does not have, and naming it would describe somebody else's job.
const attentionGaps: string[] = [];
if (wantTaskView && !attentionTasksOk) attentionGaps.push('your own task list');
else if (wantDueToday && !dbToday) attentionGaps.push('what is due today');
if (wantBoard && !boardOk) attentionGaps.push('anything waiting on your sign-off or review');
if (hrQueueFailed) attentionGaps.push('the leave and withdrawal queues');
if (routedFailed) attentionGaps.push('the requests routed to you for a decision');
if (docsFailed) attentionGaps.push('your joining documents');
if (docReviewFailed) attentionGaps.push('the joining-document review queue');
// The composer reports its OWN unanswered sources the same way — "who reports to you" decides whether
// an approvals row belongs here at all, so a gap there belongs in this sentence too.
for (const gap of composed.contextGaps) attentionGaps.push(gap);
const attentionIncomplete = attentionGaps.length > 0;

// TODAY'S STATE. The task currently in flight, off the list already read — `state` is the canonical
// status, so this is genuinely in_progress and not the legacy bucket that also holds under_review.
const currentTask = (myTasks as any[]).find((t: any) => t.state === 'in_progress') || null;

// The sentence that replaces the all-clear when a source did not answer. Built here rather than in
// the markup because joining a list with "and" inside JSX is three nested ternaries nobody can read.
const attentionGapText = attentionGaps.length === 0
  ? ''
  : attentionGaps.length === 1
    ? attentionGaps[0]
    : attentionGaps.slice(0, -1).join(', ') + ' and ' + attentionGaps[attentionGaps.length - 1];

// Show the headline count only when the section is entitled to make a total. If a source did not
// answer, "3" is a number this page cannot stand behind, and a wrong total at the top of a triage
// screen is worse than none.
const attentionCountShown = !attentionIncomplete && attentionCount > 0;

// TODAY'S CLOCK POSITION, IN WORDS.
//
// currentStatus is derived from the LAST punch of the day and defaults to 'clocked_out' — which is
// also exactly what a FAILED read looks like. clockReadFailed is the only thing that separates the
// two, so it is tested FIRST: this strip states somebody's clock position as a fact, and "Not clocked
// in yet" printed over a query that threw is the same lie as a green flash over a write that never
// landed.
//
// The label on the link is the label on the CONTROL it scrolls to, so the jump does not surprise.
const clockLabel = clockReadFailed
  ? "Today's punches could not be read"
  : currentStatus === 'clocked_in'
    ? 'Clocked in'
    : currentStatus === 'on_break'
      ? 'On a break'
      : todayEvents.length > 0
        ? 'Clocked out for today'
        : 'Not clocked in yet';
const clockTone = clockReadFailed
  ? 'danger'
  : currentStatus === 'clocked_in'
    ? 'approved'
    : currentStatus === 'on_break'
      ? 'in_progress'
      : todayEvents.length > 0
        ? 'completed'
        : 'draft';
const clockCta = clockReadFailed
  ? 'Open attendance'
  : currentStatus === 'on_break'
    ? 'Resume work'
    : currentStatus === 'clocked_in'
      ? 'Clock out or take a break'
      : 'Clock in';
// Hours are withheld, not zeroed, when the punch read failed: 0h is a statement about someone's day.
//
// IT IS WORKED TIME NOW, AND THE OLD CAVEAT IS GONE. This used to say "on the clock" rather than
// "worked", because break_start and break_end were recorded in hr_clock_events and subtracted from
// nothing — the figure was wall clock from the first punch and included every break taken. Both the
// write and the read go through src/lib/attendance.ts computeDay() now, which closes each break at
// its break_end (or at clock_out, if somebody went home without ending one) and excludes it. This
// figure and the one on /portal/employee/timesheet are the same number from the same fold.
const showTodayHours = !clockReadFailed && todayHours > 0;

// WHICH PUNCH CONTROLS TO DRAW.
//
// From allowedPunches() — the engine's own pure rule — so the screen can no longer offer "End break"
// when no break is running, and somebody on a break can now clock out (they always could; this page
// simply never drew the button, so a person who forgot to end a break had to end one they were no
// longer on before they could go home).
//
// WHEN THE READ FAILED, EVERY CONTROL IS OFFERED. punchOptions is empty on a failed read, and an
// attendance card with no buttons at all strands somebody who genuinely needs to clock in. The write
// path re-checks the rule and now refuses honestly and in words, so the worst case is a refusal
// sentence rather than a wrong punch — which is the right direction when the alternative is being
// unable to record your day.
const ALL_PUNCHES = ['clock_in', 'clock_out', 'break_start', 'break_end'];
const punchChoices: string[] = clockReadFailed ? ALL_PUNCHES : punchOptions;
const canPunch = (kind: string) => punchChoices.indexOf(kind) >= 0;

// =================================================================================================
// "TODAY" — ASSEMBLED FROM ROWS ALREADY READ, AND HONEST ABOUT WHAT IT IS NOT.
//
// THIS IS NOT A CALENDAR AND IT MUST NEVER BE TITLED AS ONE. There is no shift, roster,
// work_schedule or staff-meeting table anywhere in src/ or db/, and src/lib/calendar.ts is the
// LEARNER deadline feed, not a staff one. So this section shows the day this person already has ON
// RECORD — work due, approved leave, the punch that has happened — and says once, plainly, that
// meetings are not part of it.
//
// THE MEETING HALF OF THAT SENTENCE HAS NARROWED, so do not re-quote the old version: meet_rooms
// .scheduled_at / duration_min / invitees / recurrence used to be written by nothing because the
// scheduler POSTed to /api/meet/rooms and no such route existed. It exists now
// (src/pages/api/meet/rooms/index.ts and ./[id].ts) and writes all four. What still cannot be
// answered HERE is an INVITEE's day: `invitees` is a jsonb list of email strings with no membership
// row and no accepted/declined state, so meet_rooms can tell you what somebody HOSTS and not what
// they were asked to attend. That is why this section still does not consult it.
//
// Rendering an empty "no meetings today" would be the lie: it claims a calendar was consulted.
// widgets.ts UNREGISTERED records meetings.today and announcements.latest with the same evidence.
//
// Not one extra query: every row here was read by a loader further up.
const scheduleReady = has('schedule.today');
const scheduleDueTasks = (scheduleReady && attentionTasksOk && dbToday)
  ? openTasks.filter((t: any) => t.due === dbToday && !t.overdue)
  : [];
const scheduleOverdue = (scheduleReady && attentionTasksOk) ? overdueTasks.length : 0;
const scheduleLeave = scheduleReady && leaveToday.ok ? (leaveToday.days as any[]) : [];
// Named per source, exactly like the attention section: a day view over a read that did not happen
// is not an empty day.
const scheduleGaps: string[] = [];
if (scheduleReady && !dbToday) scheduleGaps.push('what today\'s date is here');
if (scheduleReady && wantTaskView && !attentionTasksOk) scheduleGaps.push('your task list');
if (scheduleReady && !leaveToday.ok && dbToday) scheduleGaps.push('your approved leave');
if (scheduleReady && clockReadFailed) scheduleGaps.push('today\'s punches');
const scheduleGapText = scheduleGaps.length === 0
  ? ''
  : scheduleGaps.length === 1
    ? scheduleGaps[0]
    : scheduleGaps.slice(0, -1).join(', ') + ' and ' + scheduleGaps[scheduleGaps.length - 1];
const scheduleEmpty =
  scheduleDueTasks.length === 0 && scheduleOverdue === 0 && scheduleLeave.length === 0
  && meetingsToday.length === 0
  && !(showTodayHours || todayEvents.length > 0);

// THE SENTENCE UNDER THE DAY, AND IT NO LONGER DENIES A CAPABILITY THE PRODUCT HAS.
//
// It used to read "Scheduled meetings are not shown: this workspace has no meeting calendar to read
// from yet." That was written when meet_rooms.scheduled_at had no writer, and it survived two
// rounds of that becoming false. Meetings are read now — hosted, and invited by the address on the
// account — so what is left to say is the honest LIMIT of that read rather than a denial of it.
const meetingsNote = !has('meetings.today')
  ? 'Live huddles are at Meet.'
  : !meetingsOk
    ? 'Your meetings could not be read just now, so any that are scheduled are missing from this list. The full window is on your calendar. Live huddles are at Meet.'
    : 'Meetings show if you are hosting or were invited at the address you sign in with; an invitation is not an acceptance, because nothing records one. The full window is on your calendar. Live huddles are at Meet.';

// THE ATTENDANCE SUMMARY LINE. Days recorded, never a percentage: there is no holiday table, so an
// absence figure would count every weekend against the person. What is not written down is not
// reported.
const attendanceMeta = attMonth.ok
  ? attMonth.daysRecorded + (attMonth.daysRecorded === 1 ? ' day' : ' days')
  : null;

// PEOPLE. Both lists are names and designations only — the EMPLOYEE_COLUMNS allow-list exists
// because a SELECT * on this table once dragged gender into a page that displayed none of it.
const reportPeople = (reports.people as any[]).map((p: any) => ({ id: p.id, name: p.name, role: p.designation }));
const rosterPeople = (roster.people as any[]).map((p: any) => ({ id: p.id, name: p.name, role: p.designation }));

// THE DEPARTMENT CARD. Display and self-scope only; it is never handed to departmentFilter().
// A recorded id with no name means the key points at no departments row — say the code rather than
// printing "null", because that is a data fault somebody can go and fix.
const deptName = composed.context.departmentName;
const deptId = composed.context.departmentId;
const deptLine = deptName || (deptId ? 'Recorded as ' + deptId : '');

// ONE LINE ABOUT THE DAY, for the welcome banner. Built from what has ALREADY been read and stated
// only when this page is in a position to state it: it says nothing at all when the clock read
// failed, because "not clocked in yet" over a query that threw is the same lie as an all-clear.
const bannerStanding = clockReadFailed
  ? null
  : !has('clock.today')
    ? null
    : currentStatus === 'clocked_in'
      ? (showTodayHours ? 'You are clocked in, ' + todayHours + 'h worked so far today.' : 'You are clocked in.')
      : currentStatus === 'on_break'
        ? 'You are on a break.'
        : todayEvents.length > 0
          ? 'You have clocked out for today.'
          : 'You have not clocked in yet today.';

// Identity, for the profile.me card. Straight off the composed workspace, which selects an explicit
// column list and never `SELECT *` — no gender, no government ids, no bank details, no salary. When
// no employee record resolved it falls back to the session, because "you are signed in as" is still
// the right answer on a screen that could not resolve anything else. users has `name`, NOT full_name.
const identityName = composed.workspace?.fullName || user.name || user.email || 'Your account';
const identitySub = composed.workspace
  ? [composed.workspace.employeeCode, composed.workspace.designation].filter(Boolean).join(' - ')
  : (user.email || '');
const identityPhoto = composed.workspace?.photoUrl || '';

// THE FLASH, READ AS A CODE AND RESOLVED AGAINST A KNOWN SET. An unrecognised value — including
// anything a stranger put in a link — resolves to '' and renders no panel at all. `?msg=` is gone
// entirely and is deliberately NOT still honoured: a compatibility branch that renders arbitrary
// text back to the reader IS the defect, whichever parameter it is spelled with.
const flashParams = new URL(Astro.request.url).searchParams;
const flashOk = flashOkText(flashParams.get('ok') || '');
const flashErr = flashErrText(flashParams.get('err') || '');

// THE ORDER OF THE PAGE.
//
// There is no hardcoded section order here any more. The composer returns its widgets already sorted
// by the registry's priority bands — what needs you, your work, decisions, your day, internship,
// money, people, community, account — and this page walks that list. A widget with no renderer on
// this surface simply contributes nothing; it is not an error, and it is not something for this file
// to have an opinion about.
const slots = composed.widgets.map((w: any) => w.key);

// THE THINGS THIS PAGE DELIBERATELY DOES NOT SHOW, each because the database cannot answer it and a
// placeholder would be a lie rather than a gap. The full list, with the evidence, is UNREGISTERED in
// src/lib/workforce/widgets.ts: meetings today, announcements, performance reviews waiting on me,
// unread comments, offers awaiting my signature, and assigned learning. Their absence IS the answer.
// Do not add an empty card for any of them.
---
<!doctype html>
<!-- data-theme="light" PINS the workforce tokens. workforce.css flips its whole ramp inside
     `@media (prefers-color-scheme: dark) { :root:not([data-theme='light']) }`, and every card on
     this page is a hardcoded white on a hardcoded #f8f6f1 body. Without the pin, a phone set to
     dark would render --wf-ink (#F7F5F3) as the text colour on those white cards — invisible.
     It also fixes a latent split that predates this change: BottomNav already uses these tokens,
     so the bar alone was going dark under a light page. -->
<html lang="en" data-theme="light" style="background:#f8f6f1;">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <title>My HR - EduRankAI</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    /* padding-bottom is load-bearing: BottomNav is position:fixed and takes no space in flow, so
       this is the only thing keeping the last card clear of it. */
    body{background:#f8f6f1;font-family:system-ui,sans-serif;min-height:100vh;padding-bottom:80px;}
    .topbar{background:#0f0f14;padding:0 16px;height:52px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:40;}
    /* THE FLASH. Two tones, and the difference has to be readable without colour —
       hence the glyph and the wording, not the background alone (SC 1.4.1). Both
       clear 4.5:1 on their own wash. */
    .flash{margin:12px 14px 0;border-radius:10px;padding:11px 13px;font-size:13px;
      line-height:1.5;display:flex;align-items:flex-start;gap:9px;}
    .flash svg{flex:0 0 auto;margin-top:1px;}
    .flash--ok{background:#ecfdf5;border:1px solid #a7d9c2;color:#065f46;}
    .flash--err{background:#fef2f2;border:1px solid #f0c0c0;color:#9b1c1c;}
    @media (forced-colors: active){
      .flash{border-color:CanvasText;}
    }
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;margin:0 14px 12px;}
    .card-header{padding:14px 16px;border-bottom:1px solid #f0f0f0;}
    .card-body{padding:14px 16px;}
    .clock-btn{width:100%;border:none;font-size:15px;font-weight:700;padding:16px;border-radius:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;}
    .clock-btn[disabled]{opacity:.7;cursor:progress;}
    /* "Recording…" LIVES HERE, NOT IN THE BUTTON. It used to be written over
       button.textContent, which destroys the button's own SVG icon mid-press and
       leaves a bare word where a labelled control was. A sibling live region says
       the same thing without touching the control, and a screen reader hears it.
       Empty until the script has something to say, so it occupies nothing. */
    /* NOT display:none when empty. A live region has to be in the accessibility
       tree before the text arrives, or the change is not announced — and the whole
       point of this element is that a screen-reader user hears the punch land.
       Collapsing the margin gives it zero height instead. */
    .clock-say{margin:8px 0 0;font-size:12px;color:#4b5563;text-align:center;}
    .clock-say:empty{margin:0;}
    /* A 44x44 box on a control that deletes a row of somebody's own timesheet with no
       confirmation and no undo. It was 11x14 CSS px, then 24x24 — which clears WCAG 2.2
       SC 2.5.8 but is still a mis-tap generator with a thumb, and a mis-tap here is
       destructive. #ef4444 was also 3.8:1 on white, under the 4.5:1 floor. */
    .tl-del{background:none;border:none;color:#b91c1c;font-size:17px;line-height:1;
      cursor:pointer;padding:0;min-width:44px;min-height:44px;border-radius:8px;
      display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;}
    .tl-del:focus-visible{outline:3px solid #b93c00;outline-offset:2px;}
    .status-dot{width:10px;height:10px;border-radius:50%;display:inline-block;}
    .payslip-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f0f0;}
    .event-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

    /* A door: a full-width tile that carries no data at all. Used for the wallet and leave tiles,
       which are two separate widgets and so are no longer glued into one hand-made grid, and for
       every tile of the Universal Workspace fallback. */
    .door{display:flex;align-items:center;gap:12px;margin:0 14px 12px;padding:14px 15px;
      background:#fff;border:1px solid #e5e7eb;border-radius:14px;text-decoration:none;
      min-height:var(--wf-touch);}
    .door--ink{background:linear-gradient(135deg,#1a1510,#2b241b);border-color:#1a1510;color:#faf6ef;}
    .door--rust{background:linear-gradient(135deg,#c2410c,#e05a1c);border-color:#c2410c;color:#fff;}
    .door__mark{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:34px;height:34px;
      border-radius:10px;background:rgba(255,79,0,0.1);color:#b93c00;}
    .door--ink .door__mark,.door--rust .door__mark{background:rgba(255,255,255,0.14);color:currentColor;}
    .door__body{flex:1 1 auto;min-width:0;}
    .door__title{display:block;font-size:14px;font-weight:700;color:#111;}
    .door--ink .door__title,.door--rust .door__title{color:currentColor;}
    .door__note{display:block;margin-top:2px;font-size:11.5px;color:#6b7280;line-height:1.45;}
    .door--ink .door__note,.door--rust .door__note{color:currentColor;opacity:.75;}
    .door__chev{flex:0 0 auto;width:16px;height:16px;color:#6b7280;}
    .door--ink .door__chev,.door--rust .door__chev{color:currentColor;opacity:.6;}

    /* =========================================================================
       THE COMMAND CENTRE — the section at the top of the page.

       NOT A SECOND DESIGN SYSTEM. Every value below is a token from
       src/styles/workforce.css, which is imported in the frontmatter: colour,
       line, radius, spacing, type, touch floor and motion all come from there,
       so this section inherits the contrast work (AAA ink on every surface) and
       the reduced-motion handling without restating either. The only literals
       are layout numbers that carry no meaning.

       The row's left edge is its tone accent and its mark is its tone wash, but
       neither is the SIGNAL: each row states in words what it is and why, and
       each glyph is a distinct shape. Delete every colour here and the triage
       list still reads in order, which is the rule the token file was built on.
       ========================================================================= */
    .cc{margin:0 14px 12px;}
    .cc-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 2px 8px;}
    .cc-title{font-family:var(--wf-font);font-size:var(--wf-t-title);font-weight:700;letter-spacing:-0.01em;color:var(--wf-ink);margin:0;}
    .cc-count{font-family:var(--wf-font);font-size:var(--wf-t-meta);font-weight:700;color:var(--wf-ink-3);white-space:nowrap;}
    .cc-list{display:flex;flex-direction:column;gap:var(--wf-s-2);}

    /* A whole row is the target, not a link buried inside it: this is opened
       with a thumb, and 44px is the floor the token file sets. */
    .cc-row{display:flex;align-items:flex-start;gap:10px;min-height:var(--wf-touch);padding:11px 12px;
      background:var(--wf-surface);border:1px solid var(--wf-line);border-left:3px solid var(--wf-tone-accent);
      border-radius:var(--wf-r-md);box-shadow:var(--wf-shadow-1);text-decoration:none;
      transition:var(--wf-tr-feedback);}
    .cc-row:active{transform:scale(var(--wf-press));}
    .cc-row__mark{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:30px;height:30px;
      border-radius:var(--wf-r-sm);background:var(--wf-tone-wash);border:1px solid var(--wf-tone-border);
      color:var(--wf-tone-text);}
    .cc-row__mark svg{width:16px;height:16px;display:block;}
    .cc-row__body{flex:1 1 auto;min-width:0;}
    .cc-row__title{display:block;font-family:var(--wf-font);font-size:var(--wf-t-body);font-weight:650;
      line-height:1.35;color:var(--wf-ink);overflow-wrap:anywhere;}
    .cc-row__note{display:block;margin-top:2px;font-family:var(--wf-font);font-size:var(--wf-t-meta);
      line-height:1.45;color:var(--wf-tone-text);overflow-wrap:anywhere;}
    .cc-row__side{flex:0 0 auto;display:flex;align-items:center;gap:6px;padding-top:2px;}
    .cc-row__chev{flex:0 0 auto;width:16px;height:16px;color:var(--wf-ink-4);}

    .cc-panel{background:var(--wf-surface);border:1px solid var(--wf-line);border-radius:var(--wf-r-md);
      box-shadow:var(--wf-shadow-1);overflow:hidden;}
    /* The "a source did not answer" notice. due_soon rather than danger: nothing
       is broken for the person reading it, but the list below is incomplete and
       they must not read it as an all-clear. */
    .cc-gap{margin:8px 0 0;padding:10px 12px;background:var(--wf-due_soon-wash);
      border:1px solid var(--wf-due_soon-border);border-radius:var(--wf-r-sm);color:var(--wf-due_soon-text);
      font-family:var(--wf-font);font-size:var(--wf-t-meta);line-height:1.55;}
    .cc-more{display:inline-flex;align-items:center;min-height:var(--wf-touch);margin-top:2px;padding:0 2px;
      font-family:var(--wf-font);font-size:var(--wf-t-meta);font-weight:650;color:var(--wf-info-text);
      text-decoration:none;}

    /* ---- where the day currently stands ---------------------------------- */
    .cc-today{margin:0 14px 14px;padding:12px;display:flex;flex-direction:column;gap:10px;
      background:var(--wf-surface);border:1px solid var(--wf-line);border-radius:var(--wf-r-md);
      box-shadow:var(--wf-shadow-1);}
    .cc-now{display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;}
    .cc-now__dot{flex:0 0 auto;width:10px;height:10px;border-radius:50%;background:var(--wf-tone-accent);}
    .cc-now__label{margin:0;font-family:var(--wf-font);font-size:var(--wf-t-body);font-weight:650;color:var(--wf-ink);}
    .cc-now__hours{margin-left:auto;font-family:var(--wf-font);font-size:var(--wf-t-body);font-weight:700;color:var(--wf-ink);white-space:nowrap;}
    .cc-now__sub{flex-basis:100%;margin:0;font-family:var(--wf-font);font-size:var(--wf-t-micro);line-height:1.5;color:var(--wf-ink-3);}
    .cc-task{display:flex;align-items:center;gap:9px;min-height:var(--wf-touch);padding:9px 10px;
      background:var(--wf-veil);border:1px solid var(--wf-line);border-radius:var(--wf-r-sm);text-decoration:none;}
    .cc-task__body{flex:1 1 auto;min-width:0;}
    .cc-task__eyebrow{display:block;font-family:var(--wf-font);font-size:var(--wf-t-micro);font-weight:700;
      letter-spacing:0.06em;text-transform:uppercase;color:var(--wf-ink-3);}
    .cc-task__title{display:block;margin-top:1px;font-family:var(--wf-font);font-size:var(--wf-t-meta);
      font-weight:650;line-height:1.4;color:var(--wf-ink);overflow-wrap:anywhere;}
    .cc-cta{align-self:flex-start;display:inline-flex;align-items:center;gap:7px;min-height:var(--wf-touch);
      padding:9px 14px;background:var(--wf-ink);border:1px solid var(--wf-ink);border-radius:var(--wf-r-sm);
      color:var(--wf-on-solid);font-family:var(--wf-font);font-size:var(--wf-t-meta);font-weight:650;
      text-decoration:none;transition:var(--wf-tr-feedback);}
    .cc-cta:active{transform:scale(var(--wf-press));}

    /* The topbar is sticky at 52px, so an in-page jump would land the target
       underneath it. */
    #attendance{scroll-margin-top:64px;}

    /* =========================================================================
       THE HOME WIDGETS — shared row, stat and note styles, used by every card
       rendered through WorkspaceCard. One set of rules rather than one set of
       inline styles per card, so a change to how a list row reads happens once.
       Tokens only; nothing here invents a colour or a touch target.
       ========================================================================= */
    .rows{display:flex;flex-direction:column;gap:var(--wf-s-2);margin:0;padding:0;list-style:none;}
    .rows--tight{gap:var(--wf-s-1);margin-top:10px;}
    .row{margin:0;}
    /* The whole row is the target where it links, and 44px is the floor. */
    .row__main{display:flex;flex-direction:column;justify-content:center;gap:2px;
      min-height:var(--wf-touch);padding:8px 10px;background:var(--wf-veil);
      border:1px solid var(--wf-line);border-radius:var(--wf-r-sm);text-decoration:none;}
    a.row__main{transition:var(--wf-tr-feedback);}
    a.row__main:active{transform:scale(var(--wf-press));}
    .row--unread .row__main{border-left:3px solid var(--wf-info-accent);}
    .row__title{font-family:var(--wf-font);font-size:var(--wf-t-meta);font-weight:650;
      line-height:1.4;color:var(--wf-ink);overflow-wrap:anywhere;}
    .row__note{font-family:var(--wf-font);font-size:var(--wf-t-micro);line-height:1.45;
      color:var(--wf-ink-3);overflow-wrap:anywhere;}
    .rows__gap{margin:10px 0 0;padding:9px 11px;background:var(--wf-due_soon-wash);
      border:1px solid var(--wf-due_soon-border);border-radius:var(--wf-r-sm);
      color:var(--wf-due_soon-text);font-family:var(--wf-font);font-size:var(--wf-t-meta);
      line-height:1.55;}

    .plain{margin:0;font-family:var(--wf-font);font-size:var(--wf-t-meta);line-height:1.55;
      color:var(--wf-ink-2);overflow-wrap:anywhere;}
    .plain--quiet{margin-top:6px;font-size:var(--wf-t-micro);color:var(--wf-ink-3);}

    /* auto-fit rather than a fixed count: four figures fit at 360px only if each may fall to 70px,
       and a fifth would wrap on its own instead of breaking the row. */
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(70px,1fr));gap:var(--wf-s-2);}
    .stat{display:flex;flex-direction:column;gap:2px;}
    .stat__label{font-family:var(--wf-font);font-size:var(--wf-t-micro);font-weight:700;
      letter-spacing:0.06em;text-transform:uppercase;color:var(--wf-ink-3);}
    .stat__value{font-family:var(--wf-font);font-size:1.25rem;font-weight:700;line-height:1.1;
      color:var(--wf-ink);}

    .wf-timeline-wrap{display:flex;flex-direction:column;gap:var(--wf-s-2);}

    .absent-note{margin:4px 14px 12px;font-family:var(--wf-font);font-size:var(--wf-t-micro);
      line-height:1.6;color:var(--wf-ink-3);}

    /* =========================================================================
       LAYOUT. MOBILE IS THE PRIMARY TARGET, NOT A BREAKPOINT — around nine in
       ten of these people are on a phone. Everything above is authored for one
       360px column, and the rules below only WIDEN it; deleting them leaves the
       phone layout exactly as it is.

       Two columns at 900px, not three: the cards were written at a reading
       measure of roughly 320-460px and a third column makes each one narrower
       than the phone it was designed for. `align-items:start` stops a short
       card stretching to match a tall neighbour.
       ========================================================================= */
    .ws-flow{max-width:1120px;margin:0 auto;}
    @media (min-width:900px){
      .ws-flow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;}
      /* The triage list, the day view and the banner own their row at every width: they are read
         first and in order, and a triage list in a half-width column is a triage list nobody
         scans. Everything else flows into whichever column has room.
         :global() on the three component roots is required, not stylistic: Astro scopes a
         component's styles with a per-file attribute, and .wb / .qa / .wsc belong to
         WelcomeBanner, QuickActions and WorkspaceCard, so an unscoped selector written here would
         compile to an attribute those elements do not carry and would silently never match. */
      .ws-flow > .cc,
      .ws-flow > .absent-note,
      .ws-flow > :global(.wb),
      .ws-flow > :global(.qa),
      .ws-flow > :global(.wsc--full){grid-column:1 / -1;}
    }

    /* LAZY, WITH NO JAVASCRIPT AT ALL.
       content-visibility:auto tells the browser to skip layout, style and paint
       for a card that is off screen, and to do that work when it scrolls near —
       which is the actual cost of a long workspace on a mid-range phone. The
       contain-intrinsic-size pair reserves a plausible height so the scrollbar
       does not jump as cards resolve.

       It is applied only BELOW the fold: the banner, the quick actions, the
       triage list, the day view and the clock are the screen someone opens for,
       and deferring them would be deferring the point of the page. An
       IntersectionObserver would do the same job for about 1KB of script and a
       frame of blank space; this costs nothing and degrades to normal rendering
       in browsers that do not support it. */
    @supports (content-visibility: auto){
      .card, .door, :global(.wsc){content-visibility:auto;contain-intrinsic-size:auto 220px;}
      /* The screen someone opens the page for. #attendance is a .card and would otherwise be
         deferred, and it holds the clock-in control the strip above it links to. */
      .cc, .cc-today, #attendance, :global(.wb), :global(.qa){content-visibility:visible;}
    }

    @media (forced-colors: active){
      .cc-row,.cc-panel,.cc-today,.cc-task,.door,.row__main,:global(.wsc){border-color:CanvasText;}
    }
  </style>
</head>
<body>
{/* THE BACK CHEVRON IS GONE, and it is a removal rather than a relabelling.
    It was `<a href="/portal">` wrapping a bare polyline: no accessible name (SC 2.4.4 / 4.1.2),
    about 18x18 CSS px with no padding (SC 2.5.8 Target Size), in the most-tapped corner of the
    phone — and for anyone with an employee record /portal resolves through resolveLanding() back to
    /portal/employee, so its only observable effect was a server round trip to the same screen. On
    Home, "back" has no meaning: this page IS the root for an employee. The space is now the app
    name, which is what a topbar's left corner is for. */}
<nav class="topbar">
  <span style="font-size:15px;font-weight:700;color:#fff;">My HR</span>
  {/* --wf-nav-ink, not the #6e6e78 literal that was here. BottomNav.astro measured that exact pair
      against this bar at 3.79:1 and the design system raised it to #7C7C88 (4.64:1) for this reason;
      this was the one place still using the value that was rejected. 12px rather than 11px for the
      same reason — it is the only place a person's own name appears on their home screen. */}
  <span style="font-size:12px;color:var(--wf-nav-ink);">{user.name}</span>
</nav>

{/* TWO CHANNELS, TWO TONES, TWO ROLES.
    One panel used to render both outcomes in green with no role at all, so a failed punch was
    announced as a success and announced to nobody. role="status" is polite (the person just acted
    and is looking at the screen); role="alert" is assertive, because a punch that did not land is
    worth interrupting for. Both texts come from the known set in the frontmatter — never from the
    query string. */}
{flashOk && (
  <div class="flash flash--ok" role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    <span>{flashOk}</span>
  </div>
)}
{flashErr && (
  <div class="flash flash--err" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7.5" x2="12" y2="13"/><line x1="12" y1="16.5" x2="12" y2="16.6"/></svg>
    <span>{flashErr}</span>
  </div>
)}

{/* =====================================================================
    THE FALLBACK, AND WHAT IT IS NOT.

    When the composition could not be trusted — the record is closed, two
    records share this email address, or the lookup itself did not run — this
    page renders the Universal Workspace and NOTHING else: profile, messages,
    community and settings, all doors, no business data. It never falls back
    to the intern dashboard it is replacing, because falling back to the thing
    being replaced is how a migration silently never completes; and it never
    renders a scoped card, because a resolution failure is the moment the
    system knows least about who it is talking to.

    The denial is rendered in full. A blank workspace with no explanation
    reads as "you have done no work".
    ===================================================================== */}
{!composed.ok && (
  <div style="padding-top:14px;">
    {/* HOME IS NEVER BLANK, INCLUDING HERE. welcome.banner is in MINIMAL_WIDGETS precisely so a
        workspace whose context could not be resolved still opens with a name and a sentence — and
        the quick actions on this screen are derived from the MINIMAL set, so they are only the
        doors that need nothing but a session. A screen with an explanation and no way out is how
        somebody ends up stuck on a page they cannot leave. */}
    <WelcomeBanner
      name={identityName}
      photoUrl={identityPhoto}
      today={composed.context.today}
      degraded={true}
    />
    <QuickActions actions={composed.quickActions} max={4} />

    {composed.denial && (
      <div class="card">
        <div class="card-body">
          <p style="font-size:15px;font-weight:700;color:#111;margin:0 0 6px;">{composed.denial.title}</p>
          <p style="font-size:13px;color:#4b5563;line-height:1.6;margin:0;">{composed.denial.reason}</p>
        </div>
      </div>
    )}

    {/* The identity card that used to sit here is gone: the welcome banner above states the same
        name and photo, and two copies of somebody's identity on one screen is noise, not
        reassurance. The email is on /portal/profile, which is one of the doors below. */}

    <a class="door" href="/portal/messages">
      <span class="door__mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </span>
      <span class="door__body">
        <span class="door__title">Messages</span>
        <span class="door__note">End-to-end encrypted. Readable only on a device holding your key.</span>
      </span>
      <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

    <a class="door" href="/portal/team-groups">
      <span class="door__mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="door__body">
        <span class="door__title">Community</span>
        <span class="door__note">Your team groups.</span>
      </span>
      <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

    <a class="door" href="/portal/profile">
      <span class="door__mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </span>
      <span class="door__body">
        <span class="door__title">Your profile</span>
        <span class="door__note">What is recorded about you, and how to correct it.</span>
      </span>
      <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

    <a class="door" href="/portal/employee/security">
      <span class="door__mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </span>
      <span class="door__body">
        <span class="door__title">Sign-in &amp; security</span>
        <span class="door__note">Passkeys, face and authenticator settings.</span>
      </span>
      <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

    {/* Notifications is part of the Universal Workspace and has no door yet: rows ARE written for
        staff accounts, but /portal/notifications redirects every non-applicant to /admin
        (docs/KNOWN_GAPS.md). A tile that bounces is worse than no tile, so it is absent until that
        page opens rather than linked to a redirect. */}
  </div>
)}

{/* ws-flow is one column on a phone and two from 900px. Every child below — including each card the
    slot map emits, because a Fragment contributes its children directly — becomes a grid item at
    that width; the widgets that must own their row carry the rule in the stylesheet rather than an
    inline style, so there is one place to read the layout. */}
{composed.ok && (
  <div class="ws-flow" style="padding-top:14px;">

    {/* THE "NO EMPLOYEE PROFILE" STATE, PRESERVED. Signed in, composition sound, and simply no HR
        row linked to this account. It is NOT a failure — a founder or an HR account may legitimately
        have none — so the widgets that need nothing but a user id still render below it. What must
        not happen is silence: "ask HR to link your account" is a one-sentence fix nobody can make if
        the screen does not say it. */}
    {noEmployeeRecord && (
      <div style="margin:0 14px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:32px;text-align:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" style="margin-bottom:12px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <p style="font-size:15px;font-weight:600;color:#111;margin-bottom:6px;">No employee profile found</p>
        <p style="font-size:13px;color:#6b7280;">Ask HR to link your account to your employee profile.</p>
      </div>
    )}

    {/* EVERY SECTION BELOW IS ONE SLOT IN THE COMPOSED LIST, RENDERED IN THE COMPOSER'S ORDER.
        There is no hand-written sequence here to drift from the registry, and no `if (role === ...)`
        anywhere on this page: a section exists on screen exactly when the composer put its widget in
        the list. A widget this surface has no renderer for contributes nothing and is not an error.
        Intern widgets — credit hours, weeks remaining — appear only when the composer resolved an
        internship engagement AND a recorded credit-hour requirement, so a founder gets zero. */}
    {(slots as any[]).map((slot: string) => (
      <Fragment>

        {/* THE WELCOME BANNER, AND THE QUICK ACTIONS UNDER IT.
            welcome.banner is priority 5 and is in MINIMAL_WIDGETS, so it is always first and it
            survives a degraded composition — which is the whole reason Home is never blank.
            The action row is rendered here, attached to the banner, because it is DERIVED from the
            composition rather than being a slot of its own: composeWorkspace() already filtered
            every action against the widget that grants it, and this page adds nothing to the list.
            The date comes from ctx.today (the database's day), never from this process's clock. */}
        {slot === 'welcome.banner' && (
          <Fragment>
            <WelcomeBanner
              name={identityName}
              designation={composed.workspace?.designation ?? null}
              employeeCode={composed.workspace?.employeeCode ?? null}
              departmentName={composed.context.departmentName}
              photoUrl={identityPhoto}
              today={composed.context.today}
              degraded={composed.degraded}
              standing={bannerStanding}
            />
            <QuickActions actions={composed.quickActions} max={8} />
          </Fragment>
        )}

        {slot === 'attention.queue' && (
          <section class="cc" aria-labelledby="cc-heading">
            <div class="cc-head">
              <h2 class="cc-title" id="cc-heading">Needs you today</h2>
              {attentionCountShown && (
                <span class="cc-count wf-num">{attentionCount} {attentionCount === 1 ? 'item' : 'items'}</span>
              )}
            </div>

            {attentionRows.length > 0 && (
              <div class="cc-list">
                {(attentionRows as any[]).map((r: any) => (
                  <a class="cc-row wf-focusable" href={r.href} data-wf-tone={r.tone}>
                    <span class="cc-row__mark" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={r.glyph} />
                    </span>
                    <span class="cc-row__body">
                      {/* wf-num on the title, not only on the headline: four of these rows state a
                          COUNT inside the sentence ("3 joining documents were sent back"), and a
                          proportional 1 next to a proportional 3 is the one place a triage list can
                          be misread at a glance. It is inert on the titles that carry no digits. */}
                      <span class="cc-row__title wf-num">{r.title}</span>
                      {/* Same reason: the late rows carry a date here ("was due 4 Aug"). */}
                      <span class="cc-row__note wf-num">{r.note}</span>
                    </span>
                    <span class="cc-row__side">
                      {/* Renders nothing at all for a normal-priority task: a flag on three quarters
                          of the rows is a flag on none of them. */}
                      <PriorityFlag priority={r.priority} hideNormal={true} />
                      <svg class="cc-row__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                  </a>
                ))}
              </div>
            )}

            {/* THE ALL-CLEAR. Shown only when every source this person actually has answered — an
                empty attention list is good news and reads like it, but it is a claim about somebody's
                day and this page states it only when it is in a position to know. */}
            {attentionRows.length === 0 && !attentionIncomplete && (
              <div class="cc-panel">
                <EmptyState
                  title="Nothing is waiting on you"
                  body="No task of yours is late or due today, and nobody is waiting on your sign-off. Anything that arrives will show up here first."
                  illustration="check"
                  tone="approved"
                  headingLevel={3}
                  compact
                />
              </div>
            )}

            {/* The other half of that sentence. Named per source, so it says WHICH part is missing
                rather than a generic apology. */}
            {attentionIncomplete && (
              <p class="cc-gap">
                {attentionRows.length > 0
                  ? 'This list is incomplete: we could not read ' + attentionGapText + ' just now, so there may be more than is shown here.'
                  : 'We could not read ' + attentionGapText + ' just now, so this is not an all-clear. Nothing has been lost. Reload in a moment, and tell HR if it keeps happening.'}
              </p>
            )}

            {attentionMore > 0 && (
              <a class="cc-more wf-num wf-focusable" href="/portal/tasks">{attentionMore} more on your task board</a>
            )}
          </section>
        )}

        {/* NOTIFICATIONS. Each row links to its OWN notifications.action_url and the card links
            nowhere, because /portal/notifications redirects every non-applicant to /admin and
            middleware bounces them straight back — a tile that ping-pongs is worse than no tile.
            Rows with no action_url render as plain text rather than a dead link. */}
        {slot === 'notifications.unread' && (notifs.items.length > 0 || !notifs.ok) && (
          <WorkspaceCard
            title="Notifications"
            meta={notifs.unread > 0 ? notifs.unread + ' unread' : null}
            failed={!notifs.ok}
            failedMessage="We could not read your notifications just now, so this is not a statement that you have none. Reload in a moment."
            note={notifs.ok && notifs.unread > notifs.items.length ? 'Showing the ' + notifs.items.length + ' most recent.' : null}
          >
            <ul class="rows">
              {(notifs.items as any[]).map((n: any) => (
                <li class={`row ${n.isRead ? '' : 'row--unread'}`}>
                  {n.actionUrl
                    ? <a class="row__main wf-focusable" href={n.actionUrl}>
                        <span class="row__title">{n.title}</span>
                        {n.body && <span class="row__note">{n.body}</span>}
                      </a>
                    : <span class="row__main">
                        <span class="row__title">{n.title}</span>
                        {n.body && <span class="row__note">{n.body}</span>}
                      </span>}
                </li>
              ))}
            </ul>
          </WorkspaceCard>
        )}

        {/* TODAY. NOT A CALENDAR — see the block that builds it. Every line is a row that already
            exists: work due today, work already late, approved leave covering today, and the punch
            that has happened. The one sentence about meetings is stated once and is the truth. */}
        {slot === 'schedule.today' && (
          <WorkspaceCard
            title="Today"
            full={true}
            href={scheduleDueTasks.length > 0 || scheduleOverdue > 0 ? '/portal/tasks' : null}
            hrefLabel="Task board"
            failed={scheduleGaps.length > 0 && scheduleEmpty}
            failedMessage={'We could not read ' + scheduleGapText + ' just now, so this is not a picture of your day. Reload in a moment.'}
            note={meetingsNote}
          >
            <ul class="rows">
              {bannerStanding && (
                <li class="row"><span class="row__main"><span class="row__title">{bannerStanding}</span></span></li>
              )}
              {scheduleOverdue > 0 && (
                <li class="row">
                  <a class="row__main wf-focusable" href="/portal/tasks">
                    <span class="row__title wf-num">{scheduleOverdue === 1 ? 'One task is past its date' : scheduleOverdue + ' tasks are past their date'}</span>
                    <span class="row__note">Carried into today from an earlier day</span>
                  </a>
                </li>
              )}
              {(scheduleDueTasks as any[]).map((t: any) => (
                <li class="row">
                  <a class="row__main wf-focusable" href={'/portal/tasks/' + t.id}>
                    <span class="row__title">{t.title}</span>
                    <span class="row__note">Due today{t.from ? ' · from ' + t.from : ''}</span>
                  </a>
                </li>
              ))}
              {(scheduleLeave as any[]).map((l: any) => (
                <li class="row">
                  <a class="row__main wf-focusable" href="/portal/employee/leave">
                    <span class="row__title">Approved leave today</span>
                    <span class="row__note wf-num">{l.type}{l.start && l.end && l.start !== l.end ? ' · ' + l.start + ' to ' + l.end : ''}</span>
                  </a>
                </li>
              ))}
              {/* MEETINGS. Read for real now — hosted or invited — rather than denied in a footnote.
                  The link is the calendar, which is the surface that can show the whole window. */}
              {(meetingsToday as any[]).map((m: any) => (
                <li class="row">
                  <a class="row__main wf-focusable" href={m.href || '/portal/employee/calendar'}>
                    <span class="row__title">{m.title}</span>
                    <span class="row__note">{m.timeLabel ? m.timeLabel : 'Today'}{m.detail ? ' · ' + m.detail : ''}</span>
                  </a>
                </li>
              ))}
              {scheduleEmpty && scheduleGaps.length === 0 && (
                <li class="row"><span class="row__main"><span class="row__title">No work is on record for today</span><span class="row__note">No task of yours is due or late, and no approved leave covers today.</span></span></li>
              )}
            </ul>
            {scheduleGaps.length > 0 && !scheduleEmpty && (
              <p class="rows__gap">This is incomplete: we could not read {scheduleGapText} just now, so there may be more to your day than is shown here.</p>
            )}
          </WorkspaceCard>
        )}

        {/* MY TASKS. Rendered only when src/lib/employee-tasks.ts actually loaded — an empty shell
            would read as "you have no tasks", which is a claim, not an absence. */}
        {slot === 'tasks.mine' && tasksReady && (
          <div class="card">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">My tasks</p>
              {/* No count when the read failed: "0 open" is the same false claim as the empty state,
                  just smaller and easier to believe. */}
              {!tasksFailed && <span style="font-size:12px;font-weight:700;color:#b93c00;">{openTasks.length} open</span>}
            </div>
            <div class="card-body">
              {taskMeta && <p style="font-size:11.5px;color:#6b7280;margin:0 0 10px;">{taskMeta}</p>}
              {/* Two different empty states, because they are two different facts. "Nothing on your
                  list" is a statement about your work; it must never be printed when the truth is
                  that the read failed and this page does not know. */}
              {tasksFailed && (
                <p style="font-size:12.5px;color:#9a3412;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:9px 11px;margin:0;line-height:1.5;">Your task list could not be loaded just now, so this is not a list of your work. Nothing has been lost. Reload in a moment, and tell HR if it keeps happening.</p>
              )}
              {!tasksFailed && openTasks.length === 0 && (
                <p style="font-size:12.5px;color:#6b7280;margin:0;line-height:1.55;">Nothing on your list right now. Anything assigned to you will appear here, with whatever date it is wanted by.</p>
              )}
              {openTasks.length > 0 && (
                <div style="display:flex;flex-direction:column;gap:14px;">
                  {(openTasks as any[]).map((t: any) => {
                    // Bare object literals inside the map: a typed map in .astro JSX does not compile.
                    // Nothing here is red — not urgent, not overdue. A date that has passed is
                    // information, and colouring it like an emergency on somebody's own HR page is a
                    // way of shouting at them about work they very likely already know is late.
                    // `normal` is the default priority and gets no chip at all.
                    const prioText = { urgent:'#9a3412', high:'#b45309', low:'#9ca3af' };
                    const prioBg = { urgent:'rgba(154,49,18,0.10)', high:'rgba(180,83,9,0.10)', low:'#f9fafb' };
                    // Resolved HERE rather than indexed inside the JSX. `t.priority` is `any` off a
                    // plain pg row, and indexing a literal with it is an implicit-any the checker
                    // reports — twice per row, in the one attribute a reader is least likely to open.
                    // A typed map is not the fix (it does not compile in .astro JSX, see above); a
                    // resolved value is.
                    const prioFg = (prioText as any)[t.priority] || '#6b7280';
                    const prioBgc = (prioBg as any)[t.priority] || '#f3f4f6';
                    // THE ONE PLACE ON THIS PAGE STILL PARTITIONING A DAY ON `todayIso`, which is
                    // `new Date()` in the SERVER's zone — UTC — while `t.overdue` beside it was
                    // decided inside Postgres and `dbToday` (resolved once by the composer, in the
                    // zone the company works in) sits four hundred lines above. Between 00:00 and
                    // 05:29 IST the UTC date is still YESTERDAY, so every night this badge named the
                    // wrong day: a task due today read as "Due 6 Aug" and yesterday's read "Due
                    // today", on the same card whose overdue flag came from the other clock.
                    //
                    // Empty `dbToday` means the composer could not resolve the day. The bucket is
                    // then not claimed at all — the date is still printed, just without the word
                    // "today" attached to it — rather than guessed from the clock in this process.
                    const dueToday = !!t.due && !!dbToday && t.due === dbToday;
                    const dueColor = t.overdue ? '#b45309' : dueToday ? '#FF4F00' : '#6b7280';
                    const dueText = !t.due ? '' : t.overdue ? 'Was due ' + dayLabel(t.due) : dueToday ? 'Due today' : 'Due ' + dayLabel(t.due);
                    return (
                      <div style="border-bottom:1px solid #f0f0f0;padding-bottom:14px;">
                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;">
                          <span style="font-size:13px;font-weight:600;color:#111;flex:1;min-width:140px;line-height:1.4;">{t.title}</span>
                          {t.priority !== 'normal' && (
                            <span style={`font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 8px;border-radius:99px;color:${prioFg};background:${prioBgc};`}>{t.priority}</span>
                          )}
                        </div>
                        {t.detail && <p style="font-size:12px;color:#6b7280;margin:3px 0 0;line-height:1.5;">{t.detail}</p>}
                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;margin-top:4px;">
                          {dueText && <span style={`font-size:11.5px;font-weight:600;color:${dueColor};`}>{dueText}</span>}
                          {t.from && <span style="font-size:11.5px;color:#4b5563;">from {t.from}</span>}
                        </div>
                        {t.status === 'blocked' && t.blockedReason && (
                          <p style="font-size:11.5px;color:#9a3412;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:7px 9px;margin:6px 0 0;line-height:1.45;">Blocked: {t.blockedReason}</p>
                        )}
                        {/* Plain form POST to this same page, no JS involved: the select and the
                            button are the whole control. The reason field is always present rather
                            than revealed on change, because revealing it would need a script and,
                            without one, choosing Blocked would be a control that refuses every time —
                            the library requires a stated cause before it will accept that status. */}
                        {t.moves.length > 0 && (
                        <form method="POST" style="margin-top:8px;">
                          <input type="hidden" name="action" value="task_status"/>
                          <input type="hidden" name="task_id" value={t.id}/>
                          <div style="display:flex;gap:6px;align-items:center;">
                            {/* Every option here is a move allowedTransitionsFor() says this person
                                can make FROM WHERE THIS TASK ACTUALLY IS. The old fixed four offered
                                "Done" on a task under review and the write refused it with no stated
                                reason, every time. */}
                            <select name="status" aria-label="Move this task to" style="flex:1;min-width:0;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:9px 10px;font-size:12.5px;outline:none;">
                              {(t.moves as any[]).map((m: any) => (
                                <option value={m.value}>{m.label}</option>
                              ))}
                            </select>
                            <button type="submit" style="background:#111;color:#fff;border:none;font-size:12.5px;font-weight:600;padding:10px 14px;border-radius:8px;cursor:pointer;flex-shrink:0;">Update</button>
                          </div>
                          <input name="blocked_reason" aria-label="If blocked, what is blocking it" placeholder="If blocked, what is blocking it?" value={t.blockedReason} maxlength="2000" style="width:100%;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:8px 10px;font-size:12px;outline:none;margin-top:6px;"/>
                        </form>
                        )}
                        {t.moves.length === 0 && tasksReady && !tasksFailed && (
                          /* NOT a broken control and not silence. There is genuinely no move an
                             assignee can make from here — it is with somebody else — and saying so
                             is the difference between a screen that is finished and one that is
                             stuck. The task page carries the full picture of who holds it. */
                          <p style="font-size:11.5px;color:#6b7280;margin:8px 0 0;line-height:1.5;">
                            Nothing for you to move from here. <a href={'/portal/tasks/' + t.id} style="color:#b93c00;">Open the task</a> to see who it is with.
                          </p>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        )}

        {/* RECENT ACTIVITY ON YOUR TASKS. Capped to four tasks this page already read and this
            person was already authorised for — listTaskActivity() is PER TASK and re-derives
            visibility in SQL per row, so there is no cross-task reader to widen this into. It says
            so when the trail is partial rather than presenting a slice as the whole record. */}
        {slot === 'tasks.activity' && (activity.entries.length > 0 || !activity.ok) && (
          <WorkspaceCard
            title="Recent activity on your work"
            failed={!activity.ok}
            failedMessage="We could not read the activity trail just now. Nothing has been lost."
            note={activity.partial ? 'Only the most recent of your open tasks are covered here, so this is part of what happened rather than all of it.' : null}
          >
            <div class="wf-timeline-wrap">
              {(activity.entries as any[]).map((e: any) => (
                <Timeline
                  actor={e.actor}
                  actorRole={e.actorRole}
                  action={e.action + ' on ' + e.taskTitle}
                  from={e.from}
                  to={e.to}
                  kind={e.kind}
                  at={e.at}
                  href={'/portal/tasks/' + e.taskId}
                  note={e.note}
                />
              ))}
            </div>
          </WorkspaceCard>
        )}

        {/* WAITING ON YOUR DECISION. Counts and names of NOTHING — no amounts, no reasons, no bank
            details (the admin withdrawal reader returns account_number, ifsc and upi_id UNMASKED,
            and none of that may enter a workspace card's render context). The viewer's OWN pending
            rows are already excluded upstream: your request is not an approval waiting on you.
            The card is a door; /portal/approvals re-checks authority at the write, every time. */}
        {slot === 'approvals.leave' && (pendingLeave > 0 || hrQueueFailed) && (
          <WorkspaceCard
            title="Leave requests to decide"
            href={hrQueueFailed ? null : '/portal/approvals'}
            hrefLabel="Decide"
            meta={hrQueueFailed ? null : String(pendingLeave)}
            failed={hrQueueFailed}
            failedMessage="We could not read the approval queue just now, so this is not a statement that nothing is waiting on you."
          >
            <p class="plain">{pendingLeave === 1 ? 'One person is waiting to know whether they can take the days.' : pendingLeave + ' people are waiting to know whether they can take the days.'}</p>
          </WorkspaceCard>
        )}

        {/* EVERYTHING ELSE ROUTED TO THIS PERSON. Counts and the KINDS of thing, never the requests
            themselves: an expense claim carries an amount and a reason, a separation carries a
            leaver's name, and none of that belongs on a workspace card that a colleague can read
            over a shoulder. The decisions are on /portal/approvals, which re-checks authority at the
            write through the engine's own mayAct(). Shown when the read FAILED too, because "nothing
            is waiting on you" printed over a query that threw is the lie this page has been punished
            for twice. */}
        {slot === 'approvals.routed' && (routedCount > 0 || routedFailed) && (
          <WorkspaceCard
            title="Requests routed to you"
            href={routedFailed ? null : '/portal/approvals'}
            hrefLabel="Decide"
            meta={routedFailed ? null : String(routedCount)}
            failed={routedFailed}
            failedMessage="We could not read the requests routed to you just now, so this is not a statement that nothing is waiting on you."
          >
            <p class="plain">{routedCount === 1
              ? 'One request has been routed to you and is waiting on your decision.'
              : routedCount + ' requests have been routed to you and are waiting on your decision.'}</p>
            {routedKinds.length > 0 && (
              <p class="plain plain--quiet">{routedKinds.join(', ')}.</p>
            )}
          </WorkspaceCard>
        )}

        {slot === 'approvals.withdrawal' && pendingWithdrawals > 0 && !hrQueueFailed && (
          <WorkspaceCard title="Withdrawals to decide" href="/portal/approvals" hrefLabel="Decide" meta={String(pendingWithdrawals)}>
            <p class="plain">{pendingWithdrawals === 1 ? 'One withdrawal is waiting on you.' : pendingWithdrawals + ' withdrawals are waiting on you.'} This is money already earned, waiting to be released.</p>
          </WorkspaceCard>
        )}

        {/* THE CLOCK. One widget, two pieces of screen: the strip that STATES where the day stands,
            and the card that CHANGES it. They are not duplicated — the forms live in the card only,
            because the progressive-enhancement script is driven by ids (clockForm / outForm /
            breakForm / resumeForm) and a second copy would give two
            elements the same id and break the punch that already works. The strip's link jumps to the
            card, which is now directly beneath it. */}
        {slot === 'clock.today' && (
          <Fragment>
            <section class="cc-today" aria-label="Where your day stands">
              <div class="cc-now" data-wf-tone={clockTone}>
                <span class="cc-now__dot" aria-hidden="true"></span>
                <p class="cc-now__label">{clockLabel}</p>
                {showTodayHours && <span class="cc-now__hours wf-num">{todayHours}h</span>}
                {showTodayHours && (
                  <p class="cc-now__sub">On the clock since your first punch today. Breaks are recorded, but they are not deducted from this figure.</p>
                )}
                {clockReadFailed && (
                  <p class="cc-now__sub">This is not a statement that you are clocked out — the read itself failed. Open attendance to see where you actually stand.</p>
                )}
              </div>

              {currentTask && (
                <a class="cc-task wf-focusable" href={'/portal/tasks/' + currentTask.id}>
                  <StatusBadge status="in_progress" size="sm" glyphOnly />
                  <span class="cc-task__body">
                    <span class="cc-task__eyebrow">In progress right now</span>
                    <span class="cc-task__title">{currentTask.title}</span>
                  </span>
                  <svg class="cc-row__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              )}

              <a class="cc-cta wf-focusable" href="#attendance">
                {clockCta}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
            </section>

            <div class="card" id="attendance">
              <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
                <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Attendance Today</p>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div class="status-dot" style={`background:${currentStatus==='clocked_in'?'#10b981':currentStatus==='on_break'?'#fbbf24':'#d1d5db'};`}></div>
                  <span style="font-size:12px;font-weight:600;color:#374151;text-transform:capitalize;">{currentStatus.replace('_',' ')}</span>
                </div>
              </div>
              <div class="card-body">
                <div style="text-align:center;margin-bottom:12px;">
                  <div id="liveClock" style="font-size:34px;font-weight:800;color:#111;font-family:ui-monospace,monospace;letter-spacing:1px;line-height:1;">--:--:--</div>
                  <div id="liveDate" style="font-size:12px;color:#6b7280;margin-top:3px;"></div>
                </div>
                <div id="locChip" style="display:flex;align-items:center;justify-content:center;gap:7px;background:#f3f4f6;border-radius:99px;padding:8px 14px;font-size:12px;color:#6b7280;margin-bottom:14px;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span id="locText">Locating you…</span>
                </div>
                {showTodayHours && (
                  <div style="text-align:center;margin-bottom:14px;">
                    <p style="font-size:36px;font-weight:800;color:#111;font-family:monospace;margin:0;">{todayHours}h</p>
                    {/* "Worked" is now literally true: computeDay() closes each break and excludes
                        it, so this figure and the one on the timesheet are the same fold of the same
                        events. The break line is stated rather than left to be inferred from a gap
                        between two numbers on different screens. */}
                    <p style="font-size:12px;color:#6b7280;margin:2px 0 0;">worked today</p>
                    {todayBreakMinutes > 0 && (
                      <p style="font-size:11.5px;color:#6b7280;margin:3px 0 0;">
                        {todayBreakMinutes} min of breaks recorded and not counted as worked time
                      </p>
                    )}
                  </div>
                )}

                {todayEvents.length > 0 && (
                  <div style="margin-bottom:14px;display:flex;flex-direction:column;gap:6px;">
                    {(todayEvents as any[]).map((e: any) => {
                      const colors = { clock_in:'#10b981', clock_out:'#ef4444', break_start:'#fbbf24', break_end:'#10b981' };
                      const labels = { clock_in:'Clocked in', clock_out:'Clocked out', break_start:'Break started', break_end:'Break ended' };
                      // Both resolved before the markup. `e.event_type` is `any` off a plain pg row,
                      // so indexing either literal with it is an implicit-any the checker reports —
                      // and one of the two sat inside the JSX, where a type error is hardest to see.
                      const color = (colors as any)[e.event_type] || '#6b7280';
                      const eventLabel = (labels as any)[e.event_type] || String(e.event_type || '');
                      return (
                        <div style="display:flex;align-items:center;gap:8px;">
                          <div class="event-dot" style={`background:${color};`}></div>
                          <span style="font-size:12px;color:#374151;flex:1;">{eventLabel}</span>
                          {e.location_name && <span style="font-size:11px;color:#6b7280;">{e.location_name}</span>}
                          <span id={`ts-${e.id}`} data-ts={new Date(e.event_time).toISOString()} style="font-size:11px;color:#6b7280;font-family:monospace;"></span>
                        </div>
                      );
                    })}
                  </div>
                )}

                <div style="display:flex;flex-direction:column;gap:8px;">
                  {/* EVERY CONTROL IS DRAWN FROM allowedPunches(), never from a status word this page
                      inferred for itself. A button that exists only to be refused teaches people the
                      system is broken; a button that is MISSING when it should be there strands them.
                      When the punch read failed, all four are offered and the engine refuses in
                      words — see punchChoices above. */}
                  {clockReadFailed && (
                    <p style="font-size:12.5px;color:#7c2d12;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 12px;margin:0 0 4px;line-height:1.5;" role="status">
                      Today's punches could not be read, so this card cannot say where your day stands.
                      Every control is shown; whichever one does not apply will be refused and nothing
                      will be recorded for it.
                    </p>
                  )}
                  {canPunch('clock_in') && (
                    <form method="POST" id="clockForm">
                      <input type="hidden" name="action" value="clock_event"/>
                      <input type="hidden" name="event_type" value="clock_in"/>
                      <input type="hidden" name="lat" id="lat_in"/>
                      <input type="hidden" name="lon" id="lon_in"/>
                      <input type="hidden" name="accuracy" id="acc_in"/>
                      <input type="hidden" name="location_name" id="loc_in"/>
                      <div style="display:flex;gap-8px;margin-bottom:8px;">
                        {/* Pre-selected from this person's own last clock-in rather than pinned to
                            'remote' on every render. An unlabelled <select> is also an unnamed
                            control to a screen reader (SC 1.3.1 / 4.1.2), so it has a real label. */}
                        <label for="workMode" style="font-size:11px;font-weight:600;color:#374151;display:block;margin-bottom:5px;">Where are you working today?</label>
                        <select id="workMode" name="work_mode" style="width:100%;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:9px 12px;font-size:13px;outline:none;margin-bottom:8px;">
                          <option value="remote" selected={workModeDefault === 'remote'}>Remote</option>
                          <option value="office" selected={workModeDefault === 'office'}>Office</option>
                          <option value="hybrid" selected={workModeDefault === 'hybrid'}>Hybrid</option>
                          <option value="field" selected={workModeDefault === 'field'}>Field</option>
                        </select>
                      </div>
                      <button type="submit" class="clock-btn" style="background:#10b981;color:#fff;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Clock In
                      </button>
                      <p class="clock-say" data-clock-status="1" role="status"></p>
                    </form>
                  )}
                  {canPunch('clock_out') && (
                    <div style="display:flex;flex-direction:column;gap:10px;">
                      <form method="POST" id="outForm">
                        <input type="hidden" name="action" value="clock_event"/>
                        <input type="hidden" name="event_type" value="clock_out"/>
                        <input type="hidden" name="lat"/><input type="hidden" name="lon"/>
                        <input type="hidden" name="accuracy"/><input type="hidden" name="location_name"/>
                        {/* Every field in the clock-out form was named only by a floating
                            label or by a placeholder that vanishes the moment typing
                            starts. The status select and the percentage slider had no
                            name at all: a screen reader announced "combo box" and
                            "slider, 100". */}
                        <label for="outTask" style="font-size:11px;font-weight:600;color:#374151;display:block;margin-bottom:5px;">Wrapping up — what did you get done?</label>
                        <input id="outTask" name="task" placeholder="For example, finished the signup form; fixed 2 bugs" style="width:100%;min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:11px 12px;font-size:16px;"/>
                        <div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap;">
                          <div style="flex:1 1 140px;min-width:0;">
                            <label for="outTaskStatus" style="font-size:11px;font-weight:600;color:#374151;display:block;margin-bottom:5px;">How did it end?</label>
                            <select id="outTaskStatus" name="task_status" style="width:100%;min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:11px 10px;font-size:16px;">
                              <option value="done">Completed</option><option value="pending">In progress</option><option value="blocked">Blocked</option>
                            </select>
                          </div>
                          <div style="flex:1 1 140px;min-width:0;">
                            <label for="outTaskPercent" style="font-size:11px;font-weight:600;color:#374151;display:block;margin-bottom:5px;">How far along</label>
                            <div style="display:flex;align-items:center;gap:8px;min-height:44px;">
                              <input id="outTaskPercent" type="range" name="task_percent" min="0" max="100" step="5" value="100" oninput="document.getElementById('pctOut').textContent=this.value" style="flex:1;min-width:0;accent-color:#FF4F00;"/>
                              <span style="font-size:12px;font-weight:700;color:#b93c00;font-family:monospace;min-width:38px;text-align:right;"><span id="pctOut">100</span>%</span>
                            </div>
                          </div>
                        </div>
                        <label for="outTaskDetails" style="font-size:11px;font-weight:600;color:#374151;display:block;margin:8px 0 5px;">Details or handover (optional)</label>
                        <input id="outTaskDetails" name="task_details" style="width:100%;min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:11px 12px;font-size:16px;"/>
                        <button type="submit" class="clock-btn" style="background:#ef4444;color:#fff;margin-top:10px;">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                          Clock Out
                        </button>
                        <p class="clock-say" data-clock-status="1" role="status"></p>
                      </form>
                      {canPunch('break_start') && (
                      <form method="POST" id="breakForm">
                        <input type="hidden" name="action" value="clock_event"/>
                        <input type="hidden" name="event_type" value="break_start"/>
                        <input type="hidden" name="lat"/><input type="hidden" name="lon"/>
                        <input type="hidden" name="accuracy"/><input type="hidden" name="location_name"/>
                        <button type="submit" class="clock-btn" style="background:transparent;border:1px solid #e5e7eb;color:#374151;">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                          Take a break
                        </button>
                        <p class="clock-say" data-clock-status="1" role="status"></p>
                      </form>
                      )}
                    </div>
                  )}
                  {canPunch('break_end') && (
                    <form method="POST" id="resumeForm">
                      <input type="hidden" name="action" value="clock_event"/>
                      <input type="hidden" name="event_type" value="break_end"/>
                      <input type="hidden" name="lat"/><input type="hidden" name="lon"/>
                      <input type="hidden" name="accuracy"/><input type="hidden" name="location_name"/>
                      <button type="submit" class="clock-btn" style="background:#10b981;color:#fff;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        Resume Work
                      </button>
                      <p class="clock-say" data-clock-status="1" role="status"></p>
                    </form>
                  )}
                </div>
              </div>
            </div>
          </Fragment>
        )}

        {/* THIS MONTH'S ATTENDANCE. Days RECORDED, and nothing that looks like a target: no
            percentage, no bar, no "absent" figure. There is no holiday table anywhere in this
            codebase, so an absence count would charge every weekend to the person; and the
            against-a-target framing belongs to credit.position, which is internship-only. Never
            overtime: hr_attendance.overtime_hours has zero writers and is structurally always 0. */}
        {slot === 'attendance.month' && (
          <WorkspaceCard
            title="This month"
            meta={attendanceMeta}
            failed={!attMonth.ok}
            failedMessage="We could not read this month's attendance just now, so nothing here is a statement about your record."
            empty={attMonth.ok && attMonth.daysRecorded === 0}
            emptyMessage="No attendance has been recorded for you this month yet. It fills in as you clock in."
            note="Days that have been recorded. Days with no record — weekends, holidays, anything not yet entered — are not counted either way."
          >
            <div class="stats">
              <div class="stat">
                <span class="stat__label">Present</span>
                <span class="stat__value wf-num">{attMonth.present}</span>
              </div>
              <div class="stat">
                <span class="stat__label">On leave</span>
                <span class="stat__value wf-num">{attMonth.leave}</span>
              </div>
              {attMonth.other > 0 && (
                <div class="stat">
                  <span class="stat__label">Other</span>
                  <span class="stat__value wf-num">{attMonth.other}</span>
                </div>
              )}
              {attMonth.hours !== null && (
                <div class="stat">
                  <span class="stat__label">Hours</span>
                  <span class="stat__value wf-num">{attMonth.hours}</span>
                </div>
              )}
            </div>
          </WorkspaceCard>
        )}

        {/* Hourly / time-period tracking */}
        {slot === 'timelog.today' && (
          <div class="card" id="time-log">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Time log (hourly)</p>
              <span style="font-size:12px;font-weight:700;color:#b93c00;">{loggedHours}h logged</span>
            </div>
            <div class="card-body">
              <p style="font-size:12px;color:#6b7280;margin:0 0 10px;line-height:1.5;">Log each block of work through the day — from / to and what you did.</p>
              {(timeLogs as any[]).length > 0 && (
                <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px;">
                  {(timeLogs as any[]).map((l: any) => (
                    <div style="display:flex;align-items:flex-start;gap:8px;background:#f9fafb;border:1px solid #f0f0f0;border-radius:8px;padding:8px 10px;">
                      <span style="font-size:11px;font-weight:700;color:#b93c00;font-family:monospace;white-space:nowrap;">{l.start_time}-{l.end_time}</span>
                      <span style="font-size:12.5px;color:#374151;flex:1;">{l.task}</span>
                      <span style="font-size:11px;color:#4b5563;white-space:nowrap;">{l.hours}h</span>
                      {/* "×" is not an accessible name — a screen reader announces "button" and
                          nothing else. The label names the entry being destroyed.

                          THE CONFIRMATION NAMES WHAT IS LOST. It carries the window, the hours and
                          the task text, because these rows are 8px apart on a 360px screen and a
                          thumb that lands one row high destroys a different block of work than the
                          one the person meant. There is no undo behind this button and no record of
                          the deleted row anywhere.

                          onsubmit rather than a second screen, deliberately: with scripting off the
                          form still posts, which is exactly what happens today. A confirmation can
                          only add a chance to stop; it must never be the thing that removes the
                          ability to act. */}
                      <form method="POST" style="margin:0;" onsubmit={'return confirm("Delete the time entry ' + String(l.start_time) + ' to ' + String(l.end_time) + ', ' + String(l.hours) + ' hours, for: ' + String(l.task || '').replace(/[^\w \-.,]/g, '').slice(0, 60) + '?\\n\\nIt is removed from today and cannot be brought back.")'}>
                        <input type="hidden" name="action" value="delete_time_log"/>
                        <input type="hidden" name="log_id" value={l.id}/>
                        <button type="submit" class="tl-del" aria-label={'Delete the time entry ' + l.start_time + ' to ' + l.end_time}>
                          <span aria-hidden="true">&#215;</span>
                        </button>
                      </form>
                    </div>
                  ))}
                </div>
              )}
              <form method="POST" style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;">
                <input type="hidden" name="action" value="add_time_log"/>
                {/* for/id on all three: these labels sat beside their fields with nothing
                    joining them, so the two time pickers were announced as bare spin
                    buttons with no idea which one was the start. */}
                <div><label for="tlFrom" style="font-size:11px;color:#4b5563;display:block;margin-bottom:4px;">From</label><input id="tlFrom" name="start_time" type="time" required style="min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px;font-size:16px;"/></div>
                <div><label for="tlTo" style="font-size:11px;color:#4b5563;display:block;margin-bottom:4px;">To</label><input id="tlTo" name="end_time" type="time" required style="min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px;font-size:16px;"/></div>
                <div style="flex:1;min-width:140px;"><label for="tlTask" style="font-size:11px;color:#4b5563;display:block;margin-bottom:4px;">What did you do?</label><input id="tlTask" name="task" required placeholder="For example, built the signup form" style="width:100%;min-height:44px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px;font-size:16px;"/></div>
                <button type="submit" style="min-height:44px;background:#111;color:#fff;border:none;font-size:15px;font-weight:600;padding:11px 18px;border-radius:8px;cursor:pointer;">Add</button>
              </form>
            </div>
          </div>
        )}

        {/* Daily work report */}
        {/* TODAY'S REPORT — STATE, AND THE DOOR TO THE ONE PLACE IT IS WRITTEN.
            The form that used to live here is gone; the block above the POST handler says exactly
            what it did and why it could not stay. Three states, and they are three different
            sentences: filed, not filed yet, and "we could not read it" — which is emphatically not
            the same as "you have not filed one", and used to render as it. */}
        {slot === 'dailyreport.today' && (
          <div class="card" id="daily-report">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Today's work report</p>
              {!reportReadFailed && todayReport && (
                <span style="font-size:11px;font-weight:600;color:#0f7a4a;">
                  {todayReport.reviewed_at ? 'reviewed' : 'filed'}
                </span>
              )}
            </div>
            <div class="card-body">
              {reportReadFailed ? (
                <p style="font-size:12.5px;color:#6b7280;margin:0 0 10px;line-height:1.55;">
                  We could not read today's report just now, so this is not a statement that you have
                  not filed one. Open Reports to see where it stands.
                </p>
              ) : todayReport ? (
                <Fragment>
                  <p style="font-size:12.5px;color:#374151;margin:0 0 6px;line-height:1.55;">{todayReport.work_done}</p>
                  {todayReport.blockers && (
                    <p style="font-size:12px;color:#9a3412;margin:0 0 6px;line-height:1.55;">Blocked: {todayReport.blockers}</p>
                  )}
                  <p style="font-size:11.5px;color:#6b7280;margin:0 0 10px;line-height:1.5;">
                    {Number(todayReport.revision_count) > 0
                      ? 'Revision ' + Number(todayReport.revision_count) + '. The earlier versions are kept.'
                      : 'Filed once.'}
                    {todayReport.report_url ? '' : ' No link is attached — a reviewer has only this text to go on.'}
                  </p>
                </Fragment>
              ) : (
                <p style="font-size:12.5px;color:#6b7280;margin:0 0 10px;line-height:1.55;">
                  No report filed for today yet. A report is a link to the work plus a sentence or two,
                  so whoever reads it can tell what to open.
                </p>
              )}
              <a href="/portal/employee/reports" style="display:block;text-align:center;background:#FF4F00;color:#fff;font-size:14px;font-weight:700;padding:12px;border-radius:10px;text-decoration:none;min-height:44px;">
                {todayReport && !reportReadFailed ? 'Open or revise the report' : 'File today\'s report'}
              </a>
            </div>
          </div>
        )}

        {/* What was typed at clock-out. hideWhenEmpty in the registry, and honoured: an empty card
            here would imply somebody read it, and this table has no admin reader at all. */}
        {slot === 'worklog.today' && taskLogs.length > 0 && (
          <div class="card">
            <div class="card-header"><p style="font-size:13px;font-weight:700;color:#111;margin:0;">Today's session summaries</p></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
              {(taskLogs as any[]).map((t: any) => (
                <div style="border-bottom:1px solid #f0f0f0;padding-bottom:8px;">
                  <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;">
                    <span style="font-size:13px;color:#111;font-weight:600;flex:1;">{t.task}</span>
                    <span style={`font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 8px;border-radius:99px;color:${t.status==='done'?'#059669':t.status==='blocked'?'#dc2626':'#d97706'};background:${t.status==='done'?'rgba(5,150,105,.12)':t.status==='blocked'?'rgba(220,38,38,.12)':'rgba(217,119,6,.12)'};`}>{t.status}</span>
                    <span style="font-size:12px;font-family:monospace;color:#b93c00;font-weight:700;min-width:38px;text-align:right;">{t.percent}%</span>
                  </div>
                  {t.details && <div style="font-size:12px;color:#6b7280;margin-top:3px;">{t.details}</div>}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* My leave — a door. Its own widget, so it stands on its own rather than being glued into a
            hand-made two-up grid with the wallet: the composer may hand this person one, both or
            neither, and a grid that assumed both would render a hole. */}
        {slot === 'leave.mine' && (
          <a class="door door--rust" href="/portal/employee/leave">
            <span class="door__mark" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <span class="door__body">
              <span class="door__title">My leave</span>
              <span class="door__note">Balance &amp; requests</span>
            </span>
            <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        )}

        {/* CREDIT POSITION — AN INTERNSHIP WIDGET, AND THE ONE THIS WHOLE EXERCISE IS ABOUT.
            It is on this screen because the composer resolved an internship engagement. Nobody else
            reaches this slot at all: there is no test on this page to get wrong, and no founder is
            measured against a target they never agreed to. Every figure is computed from recorded
            attendance and approved leave by the same engine that produces the completion letter, so
            this and the letter agree. When no requirement is recorded, creditPct is null and the bar
            below simply does not render — zero and unknown are different facts. */}
        {slot === 'credit.position' && credit && (
          <div class="card">
            <div class="card-body">
              <div style="display:flex;align-items:baseline;justify-content:space-between;gap:8px;">
                <p style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:#6b7280;font-weight:700;">Your credit</p>
                {weeksLeft !== null && weeksLeft > 0 && (
                  <p style="font-size:11px;color:#6b7280;">~{weeksLeft} week{weeksLeft === 1 ? '' : 's'} to go</p>
                )}
              </div>

              <div style="display:flex;align-items:baseline;gap:6px;margin-top:6px;">
                <span style="font-size:34px;font-weight:800;color:#0f0f14;line-height:1;">{credit.creditHours}</span>
                <span style="font-size:13px;color:#6b7280;">
                  {credit.requiredCreditHours ? 'of ' + credit.requiredCreditHours + ' credit-hours' : 'credit-hours'}
                </span>
              </div>

              {creditPct !== null && (
                <div style="margin-top:10px;">
                  <div style="height:8px;background:#eef0f3;border-radius:100px;overflow:hidden;">
                    <div style={`height:100%;width:${creditPct}%;background:${creditPct >= 100 ? '#16a34a' : '#FF4F00'};border-radius:100px;`}></div>
                  </div>
                  <p style="font-size:11.5px;color:#6b7280;margin-top:5px;">
                    {creditPct >= 100 ? 'Requirement met.' : creditPct + '% of the requirement'}
                  </p>
                </div>
              )}

              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;">
                <div>
                  <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#4b5563;font-weight:700;">Attendance</p>
                  <p style={`font-size:17px;font-weight:700;margin-top:2px;color:${credit.attendancePct >= 85 ? '#16a34a' : credit.attendancePct >= 70 ? '#b45309' : '#b91c1c'};`}>{credit.attendancePct}%</p>
                </div>
                <div>
                  <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#4b5563;font-weight:700;">Days in</p>
                  <p style="font-size:17px;font-weight:700;margin-top:2px;color:#0f0f14;">{credit.daysPresent}</p>
                </div>
                <div>
                  <p style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#4b5563;font-weight:700;">Leave</p>
                  <p style="font-size:17px;font-weight:700;margin-top:2px;color:#0f0f14;">{credit.authorisedLeaveDays}</p>
                </div>
              </div>

              {/* Surfaced plainly rather than buried: these are the two things that cost someone their
                  certificate, and finding out at the end would be too late to act on. */}
              {(credit.unauthorisedLeaveDays > 0 || credit.noticeBreaches > 0) && (
                <div style="margin-top:12px;padding:10px 12px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;">
                  {credit.unauthorisedLeaveDays > 0 && (
                    <p style="font-size:12px;color:#9a3412;line-height:1.5;">
                      <strong>{credit.unauthorisedLeaveDays} day{credit.unauthorisedLeaveDays === 1 ? '' : 's'}</strong> recorded as absent without approved leave.
                    </p>
                  )}
                  {credit.noticeBreaches > 0 && (
                    <p style="font-size:12px;color:#9a3412;line-height:1.5;margin-top:4px;">
                      <strong>{credit.noticeBreaches}</strong> leave{credit.noticeBreaches === 1 ? '' : 's'} taken without notice beforehand.
                    </p>
                  )}
                  <p style="font-size:11.5px;color:#9a3412;margin-top:6px;">
                    Both appear on your completion report. Apply for leave before you take it.
                  </p>
                </div>
              )}

              {creditTerms?.kind === 'part-time' && !creditTerms?.weeklyHours && (
                <p style="font-size:11.5px;color:#b45309;margin-top:10px;line-height:1.5;">
                  Your agreed part-time hours are not recorded yet, so credit cannot be calculated. Ask HR to set them.
                </p>
              )}
            </div>
          </div>
        )}

        {/* My wallet — a door. */}
        {slot === 'wallet.balance' && (
          <a class="door door--ink" href="/portal/employee/wallet">
            <span class="door__mark" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
            </span>
            <span class="door__body">
              <span class="door__title">My wallet</span>
              <span class="door__note">Salary &amp; withdrawals</span>
            </span>
            <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        )}

        {/* Payslips. hideWhenEmpty, and honoured: a card that says "no payslips yet" on the screen of
            somebody who is not on payroll is a fact about a different job. */}
        {slot === 'payslips.mine' && payslips.length > 0 && (
          <div class="card">
            <div class="card-header">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Payslips</p>
            </div>
            <div class="card-body" style="padding:0;">
              {(payslips as any[]).map((ps: any) => (
                <div class="payslip-row" style="padding:12px 16px;">
                  <div>
                    <p style="font-size:14px;font-weight:600;color:#111;margin:0;">{MONTHS[(ps.month||1)-1]} {ps.year}</p>
                    <p style="font-size:12px;color:#6b7280;margin:2px 0 0;">Net: {ps.currency||'INR'} {Number(ps.net_salary||0).toLocaleString()}</p>
                  </div>
                  <a href={`/portal/payslip/${ps.id}`} target="_blank" style="background:#111;color:#fff;text-decoration:none;font-size:12px;font-weight:600;padding:7px 14px;border-radius:8px;display:flex;align-items:center;gap:5px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* MY TEAM LEADER. This is the person whose name someone needs before they can chase
            anything: the recorded approver for leave and for wallet withdrawals. The registry marks
            it hideWhenEmpty and the empty branch is kept anyway, deliberately — an unrecorded
            reporting manager is not an empty list, it is a MISSING APPROVER, and hiding the card
            would hide the one sentence that gets it fixed. Falling back to "HR" or to an admin would
            be worse still: a plausible approver who is not the recorded one sends people to the
            wrong desk. */}
        {slot === 'manager.card' && (
          <div class="card">
            <div class="card-header">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">My team leader</p>
            </div>
            <div class="card-body">
              {manager ? (
                <div>
                  <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:40px;height:40px;border-radius:50%;background:#f3f4f6;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#6b7280;flex-shrink:0;">{String(manager.name || '?').charAt(0).toUpperCase()}</div>
                    <div style="min-width:0;">
                      <p style="font-size:14px;font-weight:600;color:#111;margin:0;">{manager.name}</p>
                      <p style="font-size:12px;color:#6b7280;margin:2px 0 0;">{manager.designation || 'Reporting manager'}</p>
                    </div>
                  </div>
                  <p style="font-size:11.5px;color:#6b7280;margin:10px 0 0;line-height:1.5;">Your leave and wallet requests go to them for approval.</p>
                  {managerProvenance && (
                    <p style="font-size:11.5px;color:#6b7280;margin:6px 0 0;line-height:1.5;">{managerProvenance}</p>
                  )}
                </div>
              ) : (
                <div>
                  <p style="font-size:13px;font-weight:600;color:#374151;margin:0 0 4px;">{managerEmptyTitle}</p>
                  <p style="font-size:12.5px;color:#6b7280;margin:0;line-height:1.55;">{managerEmptyBody}</p>
                </div>
              )}
            </div>
          </div>
        )}

        {/* YOUR DEPARTMENT. Display and self-scope only — this value is never handed to
            departmentFilter(), because showing an ordinary employee their peers is a new
            authorisation decision and not a rendering one. NOT hidden when unset, deliberately:
            hr_employees.department_id has exactly one writer (the application-to-hire path), so it
            is permanently NULL for anyone HR added by hand — and that is the reason they are
            invisible to every department list in the product. The sentence is what gets it fixed. */}
        {slot === 'department.card' && (
          <WorkspaceCard
            title="Your department"
            empty={!deptLine}
            emptyMessage="No department is recorded on your employee record. Ask HR to set it — until it is, you do not appear in any department list, including your lead's."
          >
            <p class="plain">{deptLine}</p>
            {!deptName && deptId && (
              <p class="plain plain--quiet">That key does not match a department we hold a name for. Worth mentioning to HR.</p>
            )}
          </WorkspaceCard>
        )}

        {/* YOUR DIRECT REPORTS. The first surface in the product to read this relation: the widget
            has been registered and ctx.managesPeople has been true for reporting managers all
            along, and nothing anywhere loaded it. Names and designations ONLY — never gender,
            government ids, bank details or salary. */}
        {slot === 'reports.direct' && (
          <WorkspaceCard
            title="Your direct reports"
            failed={!reports.ok}
            failedMessage="We could not read who reports to you just now, so this is not a statement that nobody does."
            empty={reports.ok && reportPeople.length === 0}
            emptyMessage={reportsEmptyMessage}
            note={[
              reports.more > 0 ? 'And ' + reports.more + ' more.' : '',
              reportPeople.length > 0 ? reportsProvenance : '',
            ].filter(Boolean).join(' ') || null}
          >
            <AvatarStack people={reportPeople} max={4} size="md" label="People who report to you" />
            <ul class="rows rows--tight">
              {(reportPeople as any[]).map((p: any) => (
                <li class="row">
                  <span class="row__main">
                    <span class="row__title">{p.name}</span>
                    {p.role && <span class="row__note">{p.role}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </WorkspaceCard>
        )}

        {/* YOUR DEPARTMENT'S PEOPLE — leads only, narrowed by departmentFilter() inside the loader
            from the session's assigned department. The coverage notice is not optional: a record
            with no department cannot appear here, so a short list reads as a complete one. */}
        {slot === 'team.roster' && (
          <WorkspaceCard
            title="People in your department"
            href="/portal/team"
            failed={!roster.ok}
            failedMessage="We could not read your department just now, so this is not a picture of your team."
            empty={roster.ok && rosterPeople.length === 0}
            emptyMessage="No active records carry your department yet."
            note={DEPARTMENT_COVERAGE_NOTICE + (roster.more > 0 ? ' And ' + roster.more + ' more than shown.' : '')}
          >
            <AvatarStack people={rosterPeople} max={4} size="md" label="People in your department" />
            <ul class="rows rows--tight">
              {(rosterPeople as any[]).map((p: any) => (
                <li class="row">
                  <span class="row__main">
                    <span class="row__title">{p.name}</span>
                    {p.role && <span class="row__note">{p.role}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </WorkspaceCard>
        )}

        {/* Community. Only the groups this person is entitled to, straight from visibleGroupsFor().
            Anything else is absent rather than locked: a list of team names someone cannot join is a
            map of the organisation. No join_url is fetched or rendered anywhere here — the link is a
            bearer credential and is revealed only by the POST on /portal/team-groups. */}
        {slot === 'groups.mine' && (
          <div class="card">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
              <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Community</p>
              <a href="/portal/team-groups" style="font-size:12px;font-weight:700;color:#b93c00;text-decoration:none;">Open</a>
            </div>
            <div class="card-body">
              {memberGroups.length === 0 && (
                <p style="font-size:12.5px;color:#6b7280;margin:0;line-height:1.55;">You are not in a team group yet. Groups are added when your onboarding is completed — ask HR if that has been done and you still see this.</p>
              )}
              {memberGroups.length > 0 && (
                <div style="display:flex;flex-direction:column;gap:8px;">
                  {(memberGroups.slice(0, 5) as any[]).map((g: any) => (
                    <a href="/portal/team-groups" style="display:flex;align-items:center;gap:10px;text-decoration:none;background:#f9fafb;border:1px solid #f0f0f0;border-radius:10px;padding:10px 11px;">
                      <div style="width:28px;height:28px;border-radius:8px;background:rgba(255,79,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF4F00" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      </div>
                      <div style="min-width:0;flex:1;">
                        <div style="font-size:13px;font-weight:600;color:#111;">{g.name}</div>
                        <div style="font-size:11px;color:#6b7280;margin-top:1px;">{g.memberCount} member{g.memberCount === 1 ? '' : 's'}{g.hasLink ? ' · chat link inside' : ''}</div>
                      </div>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" style="flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  ))}
                </div>
              )}
              {joinableGroups.length > 0 && (
                <p style="font-size:11.5px;color:#6b7280;margin:10px 0 0;line-height:1.5;">
                  {joinableGroups.length} group{joinableGroups.length === 1 ? '' : 's'} inside these you can join.
                </p>
              )}
            </div>
          </div>
        )}

        {/* Your record, as it is held. Identity and engagement only — this reads the composed
            workspace, which selects an explicit column list, so no gender, no government ids, no
            bank details and no salary are ever in scope on this page. */}
        {slot === 'profile.me' && (
          <div class="card">
            <div class="card-body" style="display:flex;align-items:center;gap:12px;">
              {/* Profile photo = the picture taken at face-verification (2FA) enrolment. Falls back to the initial. */}
              {identityPhoto
                ? <img src={identityPhoto} alt={identityName} width="48" height="48" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(255,79,0,0.25);" />
                : <div style="width:48px;height:48px;border-radius:50%;background:rgba(255,79,0,0.1);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#b93c00;flex-shrink:0;">{String(identityName).charAt(0).toUpperCase()}</div>}
              <div style="min-width:0;">
                <p style="font-size:15px;font-weight:700;color:#111;margin:0;">{identityName}</p>
                {identitySub && <p style="font-size:12px;color:#6b7280;margin:2px 0 0;overflow-wrap:anywhere;">{identitySub}</p>}
              </div>
            </div>
          </div>
        )}

        {/* WELLNESS — A DOOR, AND NOTHING ELSE. No cycle, no symptom, no date, no count: the
            composer's `wellness-eligible` gate returns a boolean and the composed result carries a
            widget, never a fact about a person.

            It is rendered here because the eligibility check ALREADY RAN to put this slot in the
            list. canAccessWellness() reads hr_employees.gender — the exact column of the 2026-08-02
            breach — so the one thing that must not happen is that read running and its answer being
            thrown away, which is what a missing renderer meant: the cost and the row were real and
            the person got nothing for either. A door is the whole widget. */}
        {/* THE WAY BACK TO THE CONSOLE, and it did not exist in either direction.
            src/lib/admin-nav.ts has no link to this workspace and AdminLayout has none either, so a
            department head, an HR account, a recruiter or an editor who is also on the payroll had a
            console with no door to their own working day — and /portal used to bounce them straight
            back to it. landing.ts answers an explicit /portal request with the workspace now, and
            this is the return leg. A DOOR AND NOTHING ELSE: no count, no queue, no fragment of admin
            data belongs on a personal workspace. The composer only keeps this widget for an account
            holding admin.access whose engagement is not an internship, which is exactly who the
            console admits — so it can never open onto a redirect. */}
        {slot === 'console.admin' && (
          <a class="door door--ink" href="/admin">
            <span class="door__mark" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            </span>
            <span class="door__body">
              <span class="door__title">Admin console</span>
              <span class="door__note">Your administrative work. This workspace stays here at /portal/employee.</span>
            </span>
            <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        )}

        {slot === 'wellness.entry' && (
          <a class="door" href="/portal/wellness">
            <span class="door__mark" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0L12 7l-1.4-1.4a5.2 5.2 0 1 0-7.4 7.4L12 21.4l8.8-8.4a5.2 5.2 0 0 0 0-7.4Z"/></svg>
            </span>
            <span class="door__body">
              <span class="door__title">Wellness</span>
              <span class="door__note">Private to you. Nothing you record here reaches an admin, a manager or a report.</span>
            </span>
            <svg class="door__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        )}

      </Fragment>
    ))}

    {/* MESSAGES — the Universal Workspace tile, which AUTHORIZATION_FIRST.md gives to every
        authenticated member, so it needs no eligibility and carries no business data. Counts only:
        the messages themselves are end-to-end encrypted and the key never leaves the browser, so
        there is nothing here that could show content even if it wanted to. Saying that plainly
        matters — someone who believes a server can read their messages behaves differently in them. */}
    <div class="card">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
        <p style="font-size:13px;font-weight:700;color:#111;margin:0;">Chat</p>
        {chatReady && chatUnread > 0 && (
          <span style="font-size:12px;font-weight:700;color:#b93c00;">{chatUnread} unread</span>
        )}
      </div>
      <div class="card-body">
        {chatReady && (
          <p style="font-size:13px;font-weight:600;color:#111;margin:0 0 4px;">
            {chatThreads === 0
              ? 'No conversations yet'
              : chatThreads + (chatThreads === 1 ? ' conversation' : ' conversations')}
          </p>
        )}
        <p style="font-size:12px;color:#6b7280;margin:0 0 12px;line-height:1.55;">Messages are end-to-end encrypted. They can only be read on a device holding your key, so none of their content is shown here.</p>
        <a href="/portal/messages" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#111;color:#fff;text-decoration:none;font-size:13.5px;font-weight:600;padding:12px;border-radius:10px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Open chat
        </a>
      </div>
    </div>

    {/* WHAT IS NOT ON THIS SCREEN, SAID ONCE, IN ONE PLACE.
        Announcements and a meeting calendar are the two things people look for on a workspace and
        do not find here, and neither exists in this database: there is no announcements table
        anywhere in src, db or scripts (discussions.is_pinned cannot substitute — nothing writes
        it), and there is no staff meeting, shift or roster table (meet_rooms.scheduled_at, invitees
        and recurrence are written by nothing, and the scheduler UI POSTs to a route that does not
        exist). Both are recorded in UNREGISTERED in src/lib/workforce/widgets.ts with the evidence.
        An empty "Announcements" card would be worse than this paragraph: it would claim something
        was checked and found empty. Saying it plainly, once, at the bottom, is the honest version —
        and it tells somebody who is waiting for an announcement that none is coming here. */}
    <p class="absent-note">
      Company announcements and a meeting calendar are not part of this workspace yet — there is
      nothing here that is being hidden from you, the capability does not exist. Live huddles happen
      at Meet, and anything decided in a group is on the discussion board.
    </p>

  </div>
)}

<!-- Bottom nav, derived from the SAME composition this page rendered its widgets from.
     composeWorkspace() memoises on Astro.locals, so this costs no query: the bar and the cards
     cannot disagree about what this person may reach. `active` is left to resolve from the path —
     /portal/employee is Home for anyone with an employee record. On a degraded composition the bar
     collapses on its own to the destinations that need nothing but a session, because eligibility
     here is expressed as "did the composer keep this widget".

     THE COUNTS ARE A PROJECTION, NOT A QUERY. Every number was already resolved above for this
     page's own cards - `pendingLeave` / `pendingWithdrawals` from the approver queue, `routedCount`
     from the workflow engine's own routed queue, and `notifs.unread` from myNotifications() - so
     handing them to the bar costs nothing. The approvals badge counted only leave and withdrawals
     until now, which meant a badge reading 0 over a routed timesheet, expense claim or attendance
     correction that had been sitting for a week. This is the
     mechanism that stops an approvals queue rotting: the entry is rank 4 and only three ranked
     entries reach the bar, so a manager's pending decisions live behind More, and a count nobody
     can see until they open a menu is a count nobody opens the menu for. WorkspaceNav sums whatever
     did not take a bar slot onto the More tab itself.

     buildWorkspaceNav discards any key whose destination this composition did not authorise, so a
     figure passed here can never imply the existence of a surface somebody may not open. -->
<WorkspaceNav
  composed={composed}
  badges={{ approvals: pendingLeave + pendingWithdrawals + routedCount, notifications: Number(notifs?.unread) || 0 }}
/>

<script is:inline>
// Local-time timestamps
document.querySelectorAll('[data-ts]').forEach(function(el) {
  var d = new Date(el.getAttribute('data-ts'));
  el.textContent = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
});

// Live clock
function tick(){ var d=new Date(), c=document.getElementById('liveClock'), dt=document.getElementById('liveDate');
  if(c) c.textContent=d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
  if(dt) dt.textContent=d.toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'long'}); }
tick(); setInterval(tick,1000);

// Prefetch location so clock-in is instant and the chip shows it's working.
var GEO_OPTS={enableHighAccuracy:true, timeout:12000, maximumAge:30000};
var lastPos=null;
function chip(txt,ok){ var t=document.getElementById('locText'), c=document.getElementById('locChip'); if(t) t.textContent=txt;
  if(c){ c.style.color= ok?'#065f46':'#6b7280'; c.style.background= ok?'rgba(16,185,129,0.10)':'#f3f4f6'; } }
function prefetch(){ if(!navigator.geolocation){ chip('Location not available on this device',false); return; }
  navigator.geolocation.getCurrentPosition(function(p){ lastPos=p; chip('Location ready · accurate to ±'+Math.round(p.coords.accuracy)+' m', true); },
    function(){ chip('Location off — you can still clock in',false); }, GEO_OPTS); }
prefetch();

function setF(form,n,v){ var el=form.querySelector('[name="'+n+'"]'); if(el) el.value=v; }
function fill(form,p){ var c=p.coords; setF(form,'lat',c.latitude); setF(form,'lon',c.longitude); setF(form,'accuracy',Math.round(c.accuracy));
  setF(form,'location_name','±'+Math.round(c.accuracy)+'m · '+c.latitude.toFixed(5)+', '+c.longitude.toFixed(5)); }

// Attach the captured selfie to the form (creates the hidden field on demand).
function setFace(form,data){ var el=form.querySelector('[name="face_photo"]');
  if(!el){ el=document.createElement('input'); el.type='hidden'; el.name='face_photo'; form.appendChild(el); } el.value=data; }

// Say what is happening, in the live region BESIDE the button rather than ON it.
// Writing over button.textContent destroyed the button's own SVG icon mid-press and
// left a bare word where a labelled control had been; role="status" also means a
// screen reader hears it, which it never did before.
function say(form, text){ var el=form.querySelector('[data-clock-status]'); if(el) el.textContent=text||''; }

// ------------------------------------------------------------------------------
// FACE CHECK-IN. Advisory only, and DECLINING IT IS A FIRST-CLASS CHOICE.
//
// This modal appears on every single punch and is the only thing standing between an
// employee and marking their attendance, so what it was matters:
//
//   - no role="dialog", no aria-modal, no accessible name. A screen reader was told
//     nothing had happened; focus stayed on the button behind a 0.85 scrim, and a
//     keyboard user could tab straight into the page underneath.
//   - no Escape, no scrim click, no focus restore on close.
//   - "Skip camera" was #9ca3af on white, about 2.6:1 (fails SC 1.4.3), with 4px of
//     padding on 12px text, about 20px tall (fails SC 2.5.8). The one control that
//     lets a person decline the camera - which the capture being advisory-only
//     entitles them to do - was the least visible and least tappable thing on the
//     screen. That combination reads as a nudge whether or not it was meant as one.
//
// Both buttons are now real 44px controls in inks that clear 4.5:1, the panel is a
// labelled dialog, focus moves in and comes back, and Escape and the scrim both mean
// "continue without a photo". If the camera is denied or missing the punch still
// proceeds: declining must never cost somebody their attendance record.
// ------------------------------------------------------------------------------
function captureFace(form, cb){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ cb(); return; }
  var settled=false; function done(){ if(settled) return; settled=true; cb(); }
  navigator.mediaDevices.getUserMedia({ video:{ facingMode:'user', width:{ideal:480}, height:{ideal:480} }, audio:false })
  .then(function(stream){
    // Where focus must return when this closes. Dropping it on <body> leaves a
    // keyboard user at the top of a long page with no idea where they were.
    var opener = document.activeElement;

    var ov=document.createElement('div');
    ov.style.cssText='position:fixed;inset:0;z-index:100000;background:rgba(10,12,20,.85);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;';
    ov.innerHTML=''+
      '<div data-scrim style="position:absolute;inset:0;"></div>'+
      '<div role="dialog" aria-modal="true" aria-labelledby="faceCapTitle" aria-describedby="faceCapNote" style="position:relative;background:#fff;border-radius:18px;max-width:340px;width:100%;overflow:hidden;box-shadow:0 24px 70px rgba(0,0,0,.5);font-family:system-ui,sans-serif;">'+
      '<div style="padding:14px 16px;border-bottom:1px solid #f0f0f0;"><p id="faceCapTitle" style="margin:0;font-size:14px;font-weight:700;color:#111;">Face check-in</p>'+
      '<p id="faceCapNote" style="margin:3px 0 0;font-size:12px;color:#4b5563;line-height:1.5;">Take a photo to go with this punch, or continue without one. A person checks it later; it never decides anything on its own.</p></div>'+
      '<div style="position:relative;background:#000;aspect-ratio:1;overflow:hidden;">'+
      '<video autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1);"></video>'+
      '<div style="position:absolute;inset:14%;border:2px dashed rgba(255,255,255,.55);border-radius:50%;pointer-events:none;"></div></div>'+
      '<div style="padding:12px 16px 16px;display:flex;flex-direction:column;gap:8px;">'+
      '<button type="button" data-cap style="width:100%;min-height:44px;background:#10b981;color:#fff;border:none;font-size:14px;font-weight:700;padding:13px;border-radius:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;">'+
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Capture and continue</button>'+
      '<button type="button" data-skip style="width:100%;min-height:44px;background:#fff;border:1px solid #d1d5db;color:#1f2937;font-size:14px;font-weight:600;padding:12px;border-radius:11px;cursor:pointer;">Continue without a photo</button></div></div>';
    document.body.appendChild(ov);
    var video=ov.querySelector('video'); video.srcObject=stream;

    // TAB IS TRAPPED INSIDE THE PANEL. aria-modal="true" is a promise made to a screen
    // reader, not a barrier: without this, Tab walked straight out of the dialog into
    // the page behind a 0.85 scrim, where a keyboard or switch user could operate
    // controls they could not see and had no way back to the two that matter.
    var onKey=function(ev){
      if(ev.key==='Escape'||ev.key==='Esc'){ ev.preventDefault(); skip(); return; }
      if(ev.key!=='Tab') return;
      var cap=ov.querySelector('[data-cap]'), sk=ov.querySelector('[data-skip]');
      if(!cap||!sk) return;
      var here=document.activeElement;
      if(!ov.contains(here)){ ev.preventDefault(); (ev.shiftKey?sk:cap).focus(); return; }
      if(ev.shiftKey && here===cap){ ev.preventDefault(); sk.focus(); }
      else if(!ev.shiftKey && here===sk){ ev.preventDefault(); cap.focus(); }
    };
    function cleanup(){
      document.removeEventListener('keydown', onKey, true);
      try{ stream.getTracks().forEach(function(t){t.stop();}); }catch(_){}
      if(ov.parentNode) ov.parentNode.removeChild(ov);
      try{ if(opener && opener.focus) opener.focus(); }catch(_){}
    }
    function skip(){ cleanup(); done(); }
    document.addEventListener('keydown', onKey, true);

    ov.querySelector('[data-cap]').onclick=function(){
      var vw=video.videoWidth||480, vh=video.videoHeight||480;
      var w=240, h=Math.max(1, Math.round(vh*(w/vw)));
      var cv=document.createElement('canvas'); cv.width=w; cv.height=h;
      try{ cv.getContext('2d').drawImage(video,0,0,w,h); setFace(form, cv.toDataURL('image/jpeg',0.6)); }catch(_){}
      cleanup(); done();
    };
    ov.querySelector('[data-skip]').onclick=skip;
    // The scrim means the same thing as the secondary button. It must never mean
    // "capture", and on a modal it must never mean "nothing happens".
    var scrim=ov.querySelector('[data-scrim]'); if(scrim) scrim.onclick=skip;

    // Focus INTO the panel. Without this, focus stays on the button behind the scrim
    // and a keyboard user walks a page they cannot see under a dialog they cannot leave.
    try{ ov.querySelector('[data-cap]').focus(); }catch(_){}
  })
  .catch(function(){ done(); }); // no permission / no camera -> punch without a photo
}

// Attach GPS, then let the form submit itself. Never hangs: a hard fallback fires the
// submit if geolocation neither resolves nor rejects, which some Android WebViews do.
function finishClock(form){
  var btn=form.querySelector('button.clock-btn');
  // Disabled, but THE LABEL IS LEFT ALONE. The icon and the word stay put; the
  // sentence goes in the live region beside the button.
  if(btn){ btn.disabled=true; }
  say(form, 'Recording your punch...');
  var done=false;
  function go(){
    if(done) return; done=true;
    // requestSubmit() where it exists, so the browser runs the same path a real press
    // would. The listener below knows this is the re-submit and stands aside.
    if(typeof form.requestSubmit==='function'){ form.requestSubmit(); } else { form.submit(); }
  }
  var fallback=setTimeout(go, 13000);
  if(lastPos){ fill(form,lastPos); }
  if(!navigator.geolocation){ clearTimeout(fallback); go(); return; }
  navigator.geolocation.getCurrentPosition(
    function(p){ fill(form,p); clearTimeout(fallback); go(); },
    function(){ if(!lastPos) setF(form,'location_name','location unavailable'); clearTimeout(fallback); go(); },
    GEO_OPTS
  );
}

// ------------------------------------------------------------------------------
// THE PUNCH IS A REAL FORM SUBMIT. THIS ONLY DECORATES IT.
//
// All four punch controls used to be type="button" with onclick="submitClock(...)",
// and the forms contained NO submit button at all - outForm carries several fields,
// so implicit submission on Enter could not rescue it either. On a mid-range Android
// on a weak connection, which is the actual device profile here, a page renders and
// is tappable before an inline script has executed, and stays tappable after one has
// thrown. The button then did nothing, silently, and the person walked away believing
// they had clocked in. Every other write on this page - daily report, time log,
// delete - posts natively; only the act performed twice a day by every single
// employee was JavaScript-only, and its failure mode was invisible to them AND to HR
// until a missing punch became a payroll dispute.
//
// The buttons are type="submit" now. This listener intercepts the submit to add the
// selfie and the coordinates and then re-submits. If it never runs, the browser posts
// the form on its own: no photo, no coordinates, and a RECORDED PUNCH - which is the
// correct degradation, because both of those are advisory and attendance is not.
// ------------------------------------------------------------------------------
['clockForm','outForm','breakForm','resumeForm'].forEach(function(id){
  var form=document.getElementById(id);
  if(!form) return;
  form.addEventListener('submit', function(ev){
    // Set by finishClock's go(): this is the re-submit, so let the browser have it.
    if(form.getAttribute('data-enhanced')==='1') return;
    ev.preventDefault();
    form.setAttribute('data-enhanced','1');
    try{
      captureFace(form, function(){ finishClock(form); });
    }catch(e){
      // NEVER SWALLOWED INTO A DEAD BUTTON. If the enhancement throws, the punch
      // still goes - without the photo and without the coordinates - because the
      // alternative is the exact silent failure this change exists to remove.
      console.error('[portal/employee] clock enhancement failed', e && e.message);
      say(form, 'Recording your punch...');
      if(typeof form.requestSubmit==='function'){ form.requestSubmit(); } else { form.submit(); }
    }
  });
});
</script>
</body>
</html>
