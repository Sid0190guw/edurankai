---
// The candidate decision experience.
//
// ONE ROUTE SERVES EVERY OUTCOME. A URL that differs by result — /offer/ versus /rejected/ — tells
// someone the answer before the page has loaded, in the address bar, often in front of other people.
// The branch happens here, after the row is read.
//
// THE OUTCOME IS IN THE SERVER HTML. Nothing about the result is revealed by script or gated behind
// an animation: a screen reader announces the heading immediately, and the page is complete with
// JavaScript disabled. The motion is decoration over an already-finished page, never the mechanism
// that delivers it.
//
// OWNERSHIP IS ASSERTED IN THE QUERY. The application is fetched by id AND applicant_user_id, so
// editing the id in the address bar returns nothing rather than someone else's decision. It reports
// "not found" rather than "not yours", because the second phrasing confirms the row exists.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
const { id } = Astro.params;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/decision/' + (id || '')));

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

let app: any = null;
let offerToken: string | null = null;

try {
  const r = await db.execute(sql`
    SELECT id, application_number, role_title_snapshot, department_snapshot,
           status, first_name, created_at, reviewed_at
      FROM applications
     WHERE id = ${id} AND applicant_user_id = ${user.id}
     LIMIT 1`);
  app = rowsOf(r)[0] || null;

  if (app) {
    // The signable letter already exists as its own surface; this page links to it rather than
    // duplicating a legal document that must have exactly one authoritative copy.
    const o = await db.execute(sql`
      SELECT token FROM offer_letters WHERE application_id = ${app.id} ORDER BY created_at DESC LIMIT 1`);
    offerToken = rowsOf(o)[0]?.token || null;
  }
} catch (e: any) {
  console.error('[portal/decision]', e?.cause?.message || e?.message);
}

const status = String(app?.status || '');
const selected = status === 'offer' || status === 'hired';
const notSelected = status === 'rejected';
const withdrawn = status === 'withdrawn';
const pending = !!app && !selected && !notSelected && !withdrawn;

const firstName = String(app?.first_name || '').trim();
const roleTitle = app?.role_title_snapshot || 'the role you applied for';
const dept = app?.department_snapshot || null;

const fmt = (d: any) => (d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Not recorded');

// Where the application has reached. Shown on the pending branch so waiting is legible rather than
// silent — not knowing whether anything is happening is the worst part of waiting.
const STAGES = [
  { key: 'submitted', label: 'Application received' },
  { key: 'reviewing', label: 'Under review' },
  { key: 'task_sent', label: 'Task stage' },
  { key: 'interview', label: 'Interview stage' },
];
const stageIndex = STAGES.findIndex((s) => s.key === status);

const pageTitle = app ? 'Your application' : 'Application not found';
---

<BaseLayout title={pageTitle} description="Your application with EduRankAI.">
  {!app && (
    <section class="wrap">
      <h1 class="h1">We could not find that application</h1>
      <p class="lede">It may have been removed, or the link may be incomplete. Your own applications are always listed in your portal.</p>
      <a class="btn" href="/portal/applications">Go to my applications</a>
    </section>
  )}

  {app && pending && (
    <section class="wrap">
      <p class="eyebrow">Application {app.application_number || ''}</p>
      <h1 class="h1">Your application is with the panel</h1>
      <p class="lede">
        {firstName ? firstName + ', your' : 'Your'} application for <b>{roleTitle}</b>{dept ? ' in ' + dept : ''} is being considered.
        We will write to you as soon as there is a decision, and it will appear here first.
      </p>

      <ol class="track">
        {STAGES.map((s, i) => (
          <li class={i <= stageIndex ? 'done' : ''}>
            <span class="dot"></span>
            <span class="tl">{s.label}</span>
          </li>
        ))}
      </ol>

      <div class="facts">
        <div><span>Role</span><b>{roleTitle}</b></div>
        <div><span>Department</span><b>{dept || 'Not recorded'}</b></div>
        <div><span>Applied</span><b>{fmt(app.created_at)}</b></div>
        <div><span>Reference</span><b>{app.application_number || 'Not recorded'}</b></div>
      </div>

      <a class="btn ghost" href="/portal/applications">Back to my applications</a>
    </section>
  )}

  {app && withdrawn && (
    <section class="wrap">
      <p class="eyebrow">Application {app.application_number || ''}</p>
      <h1 class="h1">This application was withdrawn</h1>
      <p class="lede">No further action is needed. You are welcome to apply again at any time.</p>
      <a class="btn" href="/careers">Browse open roles</a>
    </section>
  )}

  {app && selected && (
    <section class="wrap reveal">
      <p class="eyebrow">Application {app.application_number || ''}</p>
      <h1 class="h1 h1-yes">
        {firstName ? 'Congratulations, ' + firstName + '.' : 'Congratulations.'}
      </h1>
      <p class="lede lede-lg">
        We are delighted to offer you the position of <b>{roleTitle}</b>{dept ? ' in ' + dept : ''}.
      </p>
      <p class="lede">
        This followed a careful reading of your application against a strong field. You were chosen on
        what you showed us, and we are looking forward to working with you.
      </p>

      <div class="card">
        <p class="card-h">Offer summary</p>
        <div class="facts facts-in">
          <div><span>Role</span><b>{roleTitle}</b></div>
          <div><span>Department</span><b>{dept || 'Not recorded'}</b></div>
          {/* Stated plainly. Someone should never discover this at the point of signing. */}
          <div><span>Engagement</span><b>Internship &mdash; unpaid</b></div>
          <div><span>Decision recorded</span><b>{fmt(app.reviewed_at || app.created_at)}</b></div>
          <div><span>Reference</span><b>{app.application_number || 'Not recorded'}</b></div>
          <div><span>Candidate</span><b>{user.email}</b></div>
        </div>
      </div>

      <div class="actions">
        {offerToken ? (
          <a class="btn" href={'/portal/offer/' + offerToken}>Read and sign your offer letter</a>
        ) : (
          <a class="btn" href="/portal/applications">Back to my applications</a>
        )}
        <a class="btn ghost" href="/portal/onboarding">Onboarding steps</a>
      </div>

      {offerToken && (
        <p class="foot">Your letter carries a verification code, so anyone you show it to can confirm it is genuine without contacting you.</p>
      )}
    </section>
  )}

  {app && notSelected && (
    /* No accent colour anywhere in this branch, slower entrance, more space. The visual language of
       celebration must not be repurposed to deliver a refusal. */
    <section class="wrap quiet">
      <p class="eyebrow eyebrow-q">Application {app.application_number || ''}</p>
      <h1 class="h1">Application update</h1>
      <p class="lede lede-lg">
        {firstName ? firstName + ', thank you' : 'Thank you'} for applying for <b>{roleTitle}</b>{dept ? ' in ' + dept : ''}, and for the time you put into it.
      </p>
      <p class="lede">
        We are not able to take your application further for this role. The field was strong and we had
        far more capable applicants than places, which made the decision a genuinely close one.
      </p>
      <p class="lede">
        This decision is about the fit for one role at one moment. It is not a judgement of your ability,
        and it does not count against any future application you make to us.
      </p>
      <p class="lede">
        If you see another role here that interests you, we would be glad to read your application again.
      </p>

      <div class="actions">
        <a class="btn dark" href="/careers">Browse open roles</a>
        <a class="btn ghost" href="/portal/applications">My applications</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .wrap { max-width: 680px; margin: 0 auto; padding: 30px 18px 80px; }
  .eyebrow {
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
    color: #c2410c; margin: 0 0 8px; font-family: 'Geist Mono', ui-monospace, monospace;
  }
  .eyebrow-q { color: #8a7f70; }
  .h1 {
    font-family: Fraunces, Georgia, serif; font-weight: 600; color: #1a1510;
    font-size: clamp(26px, 6vw, 40px); line-height: 1.12; margin: 0 0 14px;
    letter-spacing: -0.015em; text-wrap: balance;
  }
  .lede { font-size: 15.5px; line-height: 1.75; color: #5c5349; margin: 0 0 14px; max-width: 62ch; }
  .lede-lg { font-size: 17px; color: #1a1510; }
  .lede b { color: #1a1510; font-weight: 600; }

  .track { list-style: none; margin: 22px 0 26px; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .track li { display: flex; align-items: center; gap: 12px; padding: 9px 0; color: #8a7f70; font-size: 14px; }
  .track li.done { color: #1a1510; font-weight: 600; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #e4dcd1; flex: none; }
  .track li.done .dot { background: #c2410c; }

  .card { background: #fff; border: 1px solid #ece4d6; border-radius: 16px; padding: 18px; margin: 22px 0; }
  .card-h {
    font-size: 10.5px; letter-spacing: 0.13em; text-transform: uppercase; font-weight: 700;
    color: #8a7f70; margin: 0 0 12px; font-family: 'Geist Mono', ui-monospace, monospace;
  }
  /* One column on a phone, two where there is room. Never a fixed multi-column grid. */
  .facts { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 20px 0 24px; }
  .facts-in { margin: 0; }
  @media (min-width: 560px) { .facts { grid-template-columns: 1fr 1fr; gap: 14px 20px; } }
  .facts div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .facts span {
    font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #8a7f70;
    font-weight: 700; font-family: 'Geist Mono', ui-monospace, monospace;
  }
  .facts b { font-size: 14.5px; color: #1a1510; font-weight: 600; overflow-wrap: anywhere; }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 26px 0 0; }
  .btn {
    display: inline-block; background: #1a1510; color: #fff; text-decoration: none;
    padding: 12px 20px; border-radius: 10px; font-size: 14.5px; font-weight: 600;
    border-bottom: 3px solid #FF4F00;
  }
  .btn.dark { border-bottom-color: #1a1510; }
  .btn.ghost { background: #fff; color: #1a1510; border: 1px solid #ece4d6; border-bottom: 1px solid #ece4d6; }
  .btn:focus-visible { outline: 2px solid #FF4F00; outline-offset: 3px; }
  .foot { font-size: 13px; color: #8a7f70; margin: 18px 0 0; line-height: 1.65; }

  /* Decoration over an already-rendered page: opacity and transform only, so it cannot cause
     layout work, and it never withholds the outcome. */
  .reveal > * { animation: rise .5s cubic-bezier(.2,.7,.2,1) backwards; }
  .reveal > *:nth-child(2) { animation-delay: .06s; }
  .reveal > *:nth-child(3) { animation-delay: .12s; }
  .reveal > *:nth-child(4) { animation-delay: .18s; }
  .reveal > *:nth-child(5) { animation-delay: .24s; }
  .quiet > * { animation: fade .7s ease backwards; }
  .quiet > *:nth-child(3) { animation-delay: .1s; }
  .quiet > *:nth-child(4) { animation-delay: .18s; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .reveal > *, .quiet > * { animation: none; }
  }
</style>
