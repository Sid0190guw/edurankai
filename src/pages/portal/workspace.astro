    .ws-daygroup { margin-top: 14px; }
    .ws-daygroup-head { display: flex; justify-content: space-between; align-items: baseline;
                        gap: 8px; font-family: 'JetBrains Mono', ui-monospace, monospace;
                        font-size: 0.66rem; letter-spacing: .09em; text-transform: uppercase;
                        color: #9a8f7d; font-weight: 700; border-bottom: 1px solid #f2ece0;
                        padding-bottom: 5px; margin-bottom: 2px; }
