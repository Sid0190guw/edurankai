    .ws-row:last-child { border-bottom: none; }
    .ws-row-main { flex: 1 1 150px; min-width: 0; overflow-wrap: anywhere; }
    .ws-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.72rem;
               color: #6b6255; white-space: nowrap; }
    .ws-meta { color: #9a8f7d; font-size: 0.76rem; }
    .ws-meta.block { display: block; margin-top: 2px; }
    .ws-muted { color: #6b6255; }
    .ws-muted.small, .small { font-size: 0.8rem; }
    .ws-cap { text-transform: capitalize; }
