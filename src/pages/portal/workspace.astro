    .ws-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
    .ws-strip { display: flex; gap: 3px; min-width: min-content; }
    .ws-day { width: 12px; height: 26px; border-radius: 3px; flex: 0 0 auto; }
    .ws-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; padding: 0;
                 margin: 10px 0 0; font-size: 0.74rem; color: #6b6255; }
    .ws-legend li { display: flex; align-items: center; gap: 5px; }
