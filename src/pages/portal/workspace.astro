---
// /portal/workspace — the working person's own interface.
//
// WHAT THIS REPLACES, TWICE OVER.
//
// First: /admin was built as one console for the super admin and then handed out by an automatic
// role promotion, so every intern who signed an offer could open the applicant pipeline, employee
// records and candidate names. That promotion is gone and interns are blocked (intern-guard.ts).
// This is the screen they should have had instead — their own record, and nobody else's.
//
// Second: this URL previously served a marketing shell that INSERTED eight invented inbox rows
// ("Study partner", "Mentor", "Fee receipt") into a workspace_recent_items table on first visit,
// alongside hardcoded "Last used 2h ago" strings and links to /portal/tasks and /portal/calendar.
// It showed a person fictional messages from fictional people inside their own portal. Everything
// below is read from the tables that actually record this person's work, and nothing on this page
// is written unless they type it.
//
// THE SCOPING RULE. `ws.employeeId` is resolved from the session by requireEmployee() and from
// nowhere else, and every statement narrows on it IN THE WHERE CLAUSE via employeeFilter(ws). No
// query string, form field or header can change whose rows come back: the only request values
// honoured are a flash message and a time-log id, and that id is deleted with the employee filter
// beside it, so an id belonging to somebody else simply matches nothing.
//
// WHY requireEmployee AND NOT requireIntern. The scope is identical either way — one person, their
// own employee_id. requireIntern would additionally refuse every non-intern their own hours, leave,
// documents and reviews, which costs them a useful screen and protects nobody. The intern framing
// appears in the copy where it is true (ws.isIntern), not in the gate.
//
// NOT READ FROM HERE, deliberately: hr_clock_events (a GPS fix, an IP, a device string and a selfie
// per punch — this person's own attendance comes from hr_attendance's status and hours instead) and
// every wellness_* table.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { requireEmployee, employeeFilter } from '@/lib/auth/workspace-access';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import { ledgerFor, termsFor, reviewsFor } from '@/lib/credit-ledger';
import { remainingWeeks } from '@/lib/credit-hours';
import { getBalances, listLeave } from '@/lib/hr-leave';
import { listDocs, progress as docProgress, docTypeLabel, MAX_DOCS } from '@/lib/hr-onboarding';

const PAGE = '/portal/workspace';

// THE GATE, FIRST — before any query and before the POST handler, so a write can never run
// unscoped and nothing is read that the caller has not been authorised for.
const gate = await requireEmployee(Astro.locals.user, PAGE);
if (!gate.ok && gate.redirect) return Astro.redirect(gate.redirect);

const ws = gate.ok ? gate.workspace : null;
const denial = gate.ok ? null : gate;
const viewerId = String(Astro.locals.user?.id || '');

// ---------------------------------------------------------------------------
// Helpers. Every const is declared ABOVE the POST handler that uses it: `const` is not hoisted,
// and a handler reaching a later declaration has taken two pages down in this repo.
// ---------------------------------------------------------------------------
const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));
const q = async (query: any): Promise<any[]> => {
  try {
    return rowsOf(await db.execute(query));
  } catch (e: any) {
    // The real Postgres reason is on the cause; e.message is only the failed SQL.
    console.error('[portal/workspace]', e?.cause?.message || e?.message);
    return [];
  }
};
const todayIso = new Date().toISOString().slice(0, 10);
const toMinutes = (t: string): number => {
  const m = /^(\d{1,2}):(\d{2})$/.exec(String(t || '').trim());
  if (!m) return -1;
  const h = parseInt(m[1], 10), mi = parseInt(m[2], 10);
  return h >= 0 && h <= 23 && mi >= 0 && mi <= 59 ? h * 60 + mi : -1;
};
/** Whole days between an ISO date and today. Negative means the future. */
const daysAgo = (iso: string): number => {
  const then = Date.parse(String(iso) + 'T00:00:00Z');
  if (Number.isNaN(then)) return NaN;
  return Math.round((Date.parse(todayIso + 'T00:00:00Z') - then) / 86400000);
};
const BACKFILL_DAYS = 7;   // how far back a missed hour block may be entered here
const round1 = (n: any): number => Math.round((Number(n) || 0) * 10) / 10;
const isoOf = (d: any): string => {
  if (!d) return '';
  const s = d instanceof Date ? d.toISOString() : String(d);
  return s.slice(0, 10);
};
const prettyDate = (d: any): string => {
  const s = isoOf(d);
  if (!s) return '';
  const dt = new Date(s + 'T00:00:00Z');
  if (isNaN(dt.getTime())) return s;
  return dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
};
const shortDate = (d: any): string => {
  const s = isoOf(d);
  if (!s) return '';
  const dt = new Date(s + 'T00:00:00Z');
  if (isNaN(dt.getTime())) return s;
  return dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};
// Plain functions rather than typed lookup maps: a Record<string,string> used inside JSX breaks
// parsing in this codebase's .astro files.
function dayTone(status: string): string {
  if (status === 'present') return '#15803d';
  if (status === 'half-day') return '#65a30d';
  if (status === 'authorised-leave') return '#0284c7';
  if (status === 'unauthorised-leave') return '#b91c1c';
  if (status === 'holiday') return '#c9c0b2';
  return '#e4dccd';
}
function dayWord(status: string): string {
  if (status === 'present') return 'Worked';
  if (status === 'half-day') return 'Half day';
  if (status === 'authorised-leave') return 'Approved leave';
  if (status === 'unauthorised-leave') return 'Absent, no approved leave';
  if (status === 'holiday') return 'Holiday';
  return 'Not started';
}
function leaveTone(status: string): string {
  if (status === 'approved') return '#15803d';
  if (status === 'rejected') return '#b91c1c';
  if (status === 'cancelled') return '#6b6255';
  return '#b45309';
}
function taskTone(status: string): string {
  if (status === 'done') return '#15803d';
  if (status === 'blocked') return '#b91c1c';
  return '#b45309';
}
function docTone(status: string): string {
  if (status === 'verified') return '#15803d';
  if (status === 'rejected') return '#b91c1c';
  return '#b45309';
}

// ---------------------------------------------------------------------------
// POST. Two actions, both on this person's own hour log, both narrowed by employeeFilter(ws).
// Ordinary form posts back to this same URL — no JavaScript involved, and none on the page.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  // No resolved workspace, no write. A denial cannot be talked around by posting to the page.
  if (!ws) return Astro.redirect(PAGE);

  const fd = await Astro.request.formData();
  const action = String(fd.get('action') || '');
  let flash = '';

  if (action === 'add_time_log') {
    const logDate = String(fd.get('log_date') || '').trim();
    const start = String(fd.get('start_time') || '').trim();
    const end = String(fd.get('end_time') || '').trim();
    const task = String(fd.get('task') || '').trim();
    const gap = daysAgo(logDate);
    const s = toMinutes(start), e = toMinutes(end);

    if (Number.isNaN(gap) || gap < 0) {
      flash = 'Pick a day that has already happened. Hours cannot be logged ahead of time.';
    } else if (gap > BACKFILL_DAYS - 1) {
      // Bounded on purpose: catching up on a day you worked is fair, rewriting last month is a
      // change to a record other people rely on and should go through HR, who leave a trail.
      flash = 'You can fill in the last ' + BACKFILL_DAYS + ' days here. For anything older, ask HR to add it so there is a record of who changed what.';
    } else if (s < 0 || e < 0 || e <= s) {
      flash = 'Enter a start and an end time, with the end after the start.';
    } else if (task.length < 3) {
      flash = 'Say briefly what you worked on in that block.';
    } else {
      const hours = Math.round(((e - s) / 60) * 100) / 100;
      const ins = await q(sql`
        INSERT INTO hr_time_logs (employee_id, log_date, start_time, end_time, hours, task)
        VALUES (${ws.employeeId}, ${logDate}, ${start}, ${end}, ${hours}, ${task.slice(0, 500)})
        RETURNING id`);
      flash = ins.length
        ? 'Logged ' + hours + 'h on ' + prettyDate(logDate) + '.'
        : 'That did not save. Nothing else was lost - try again in a moment.';
    }
  } else if (action === 'delete_time_log') {
    const logId = String(fd.get('log_id') || '').trim();
    if (logId) {
      // The employee filter beside the id is what makes this safe: somebody else's id matches
      // nothing rather than deleting their row.
      const del = await q(sql`
        DELETE FROM hr_time_logs
         WHERE id::text = ${logId} AND ${employeeFilter(ws)}
        RETURNING id`);
      flash = del.length ? 'Entry removed.' : 'That entry is no longer there.';
    }
  }

  return Astro.redirect(PAGE + (flash ? '?msg=' + encodeURIComponent(flash) : ''));
}

// ---------------------------------------------------------------------------
// Reads. All of them narrowed to this one employee, none of them by anything the browser sent.
// ---------------------------------------------------------------------------

// Who they report to, from THEIR OWN row's pointer.
//
// hr_employees.reporting_manager_id is now written by the Employment tab of
// src/pages/admin/hr/employees/[id].astro, so this stops being NULL for everyone the moment HR sets
// it. It stays a pointer on the viewer's own row rather than a second mentor field on this page,
// because two places for one fact eventually disagree.
//
// The join is on m.user_id, NOT m.id: the column holds a USERS id — that is what approverRole() in
// src/lib/hr-wallet.ts compares against the signed-in user. Joining it to hr_employees.id (as this
// did) can never match, so this section would have read "not recorded" even for a person whose
// manager had just been recorded.
//
// This is the ONLY row belonging to another person that this page reads, and it is narrowed hard:
// two display columns, no email, no identifier, no employment detail. It is reached solely through
// a pointer stored on the viewer's own record — the WHERE clause is on the VIEWER, so the join can
// only ever arrive at whoever HR recorded as their manager, and nothing the browser sends
// participates. On a database older than the column, the two admin HR screens ALTER it in on load;
// until one of them has been opened the statement here throws, q() logs the cause and returns
// nothing, and the section reads as not recorded — the correct outcome in that case too.
const manager = ws ? (await q(sql`
  SELECT m.full_name AS manager_name, m.designation AS manager_role
    FROM hr_employees e
    JOIN hr_employees m ON m.user_id = e.reporting_manager_id
   WHERE ${employeeFilter(ws, sql`e.id`)}
   ORDER BY m.is_active DESC, m.created_at DESC
   LIMIT 1`))[0] : null;

// How far in they are. Elapsed time is not progress on its own — the requirement is a number of
// credit-hours, not a duration (credit-hours.ts) — so this is shown as elapsed time NEXT TO the
// credit figure, never as a substitute for it.
const daysSinceJoining = ws?.joiningDate ? daysAgo(ws.joiningDate) : NaN;
const weeksSinceJoining = Number.isNaN(daysSinceJoining) || daysSinceJoining < 0
  ? null
  : Math.floor(daysSinceJoining / 7);

let credit: any = null;
let terms: any = null;
let weeksLeft: number | null = null;
let ledgerDays: any[] = [];
if (ws) {
  try {
    // The same engine that produces the completion letter, so what is read here is what the letter
    // will say. Not recomputed locally: two implementations of the same figure eventually disagree,
    // and this one goes to a university.
    terms = await termsFor(ws.employeeId);
    const led = await ledgerFor(ws.employeeId, terms);
    credit = led.summary;
    ledgerDays = led.days || [];
    weeksLeft = remainingWeeks(credit, terms);
  } catch (e: any) {
    console.error('[portal/workspace] ledger', e?.cause?.message || e?.message);
  }
}
const creditPct = credit && credit.requiredCreditHours
  ? Math.min(100, Math.round((credit.creditHours / credit.requiredCreditHours) * 100))
  : null;
const recentDays = ledgerDays.slice(-35);
// The last stretch in words and hours, newest first. The colour strip above it reads a whole
// engagement at a glance; this is the part someone actually checks on a phone when they want to
// know what a specific day was recorded as.
const recentDetail = ledgerDays.slice(-10).reverse();

// Attendance totals, from hr_attendance's status and hours.
const attRow = ws ? (await q(sql`
  SELECT
    COALESCE(SUM(work_hours) FILTER (WHERE date >= date_trunc('week', CURRENT_DATE)::date), 0)::float  AS week_hours,
    COALESCE(SUM(work_hours) FILTER (WHERE date >= date_trunc('month', CURRENT_DATE)::date), 0)::float AS month_hours,
    COUNT(*) FILTER (WHERE date >= date_trunc('week', CURRENT_DATE)::date  AND status IN ('present','wfh'))::int AS week_days,
    COUNT(*) FILTER (WHERE date >= date_trunc('month', CURRENT_DATE)::date AND status IN ('present','wfh'))::int AS month_days
  FROM hr_attendance WHERE ${employeeFilter(ws)}`))[0] : null;

const timeLogs = ws ? await q(sql`
  SELECT id, log_date, start_time, end_time, hours, task
    FROM hr_time_logs
   WHERE ${employeeFilter(ws)} AND log_date >= CURRENT_DATE - INTERVAL '13 days'
   ORDER BY log_date DESC, start_time ASC
   LIMIT 200`) : [];
// Grouped by day so a fortnight reads as a diary rather than a list of rows.
const logDays: any[] = [];
for (const l of timeLogs) {
  const key = isoOf(l.log_date);
  let bucket = logDays.find((b: any) => b.date === key);
  if (!bucket) { bucket = { date: key, hours: 0, entries: [] as any[] }; logDays.push(bucket); }
  bucket.hours = Math.round((bucket.hours + (Number(l.hours) || 0)) * 100) / 100;
  bucket.entries.push(l);
}
const loggedFortnight = round1(logDays.reduce((a: number, b: any) => a + b.hours, 0));

const taskLogs = ws ? await q(sql`
  SELECT id, log_date, task, status, percent, details
    FROM hr_task_log
   WHERE ${employeeFilter(ws)}
   ORDER BY log_date DESC, created_at DESC
   LIMIT 20`) : [];

const reports = ws ? await q(sql`
  SELECT report_date, work_done, progress, blockers
    FROM hr_daily_reports
   WHERE ${employeeFilter(ws)}
   ORDER BY report_date DESC
   LIMIT 7`) : [];

let balances: any[] = [];
let leaveHistory: any[] = [];
if (ws) {
  try { balances = await getBalances(ws.employeeId); }
  catch (e: any) { console.error('[portal/workspace] balances', e?.cause?.message || e?.message); }
  // listLeave WITH an employeeId returns only that person's rows. The no-argument form returns
  // everybody joined to their names and must never be called from a portal page.
  try { leaveHistory = await listLeave({ employeeId: ws.employeeId }); }
  catch (e: any) { console.error('[portal/workspace] leave', e?.cause?.message || e?.message); }
}
// Unpaid leave has an allowance of 0, and getBalances() reports its remaining as Infinity
// (hr-leave.ts:56). Rendering that would put the word "Infinity" where a number belongs, so only
// types with a real allowance are shown as balances.
const countedBalances = balances.filter((b: any) => Number(b.allowance) > 0);

// Split rather than merely counted. "3 requests" tells someone nothing they can act on; what they
// came to check is whether the days they booked are safe, and whether anything is still waiting.
// Approved leave that has not finished yet is the answer to the first, sorted soonest first.
const upcomingLeave = leaveHistory
  .filter((l: any) => l.status === 'approved' && isoOf(l.end_date) >= todayIso)
  .sort((a: any, b: any) => isoOf(a.start_date).localeCompare(isoOf(b.start_date)));
const pendingRequests = leaveHistory.filter((l: any) => l.status === 'pending');
const pendingLeave = pendingRequests.length;
// Already decided or already over — the history, kept separate so the two live blocks above are not
// buried under a year of past requests.
const settledLeave = leaveHistory.filter(
  (l: any) => !upcomingLeave.includes(l) && !pendingRequests.includes(l));

let docs: any[] = [];
if (ws && viewerId) {
  // hr_onboarding_documents is keyed by user_id, not employee_id: a hire submits before their
  // employee row necessarily exists.
  try { docs = await listDocs(viewerId); }
  catch (e: any) { console.error('[portal/workspace] docs', e?.cause?.message || e?.message); }
}
const docStats = docProgress(docs as any);

let reviews: any[] = [];
if (ws) {
  try { reviews = await reviewsFor(ws.employeeId); }
  catch (e: any) { console.error('[portal/workspace] reviews', e?.cause?.message || e?.message); }
}
// Formal review cycles, but only once SUBMITTED, and only the parts written to be given to the
// person: the score, what went well, what to improve, what is next. reviewer_comments is left out
// on purpose — it is the reviewer's own working note, and a half-finished draft is not feedback.
const perfReviews = ws ? await q(sql`
  SELECT pr.overall_rating, pr.strengths, pr.improvements, pr.goals_next, pr.submitted_at,
         c.title AS cycle_title, c.period_start, c.period_end
    FROM hr_performance_reviews pr
    LEFT JOIN hr_review_cycles c ON c.id = pr.cycle_id
   WHERE ${employeeFilter(ws, sql`pr.employee_id`)} AND pr.status = 'submitted'
   ORDER BY pr.submitted_at DESC NULLS LAST
   LIMIT 10`) : [];

const msg = Astro.url.searchParams.get('msg') || '';
// Days offered for a backfilled hour block: today and the six before it.
const backfillDates: string[] = [];
for (let i = 0; i < BACKFILL_DAYS; i++) {
  backfillDates.push(new Date(Date.parse(todayIso + 'T00:00:00Z') - i * 86400000).toISOString().slice(0, 10));
}
const onboardingDone = !!ws && (ws.onboardingStatus === 'submitted' || ws.onboardingStatus === 'verified');
---

<BaseLayout
  title="My workspace"
  description="Your own record: hours, credit, leave, tasks, documents and reviews."
  noindex={true}
>
  <section class="ws">

    {denial && (
      <div class="ws-empty">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        <h1>{denial.title}</h1>
        <p>{denial.reason}</p>
        <div class="ws-empty-actions">
          <a class="ws-btn" href="/portal">Back to the portal</a>
          <a class="ws-btn ghost" href="mailto:hr@edurankai.in">Email HR</a>
        </div>
      </div>
    )}

    {ws && (
      <div>

        {msg && <p class="ws-flash">{msg}</p>}

        {/* ---------------------------------------------------------------- Who you are */}
        <header class="ws-head">
          {ws.photoUrl
            ? <img class="ws-avatar" src={ws.photoUrl} alt="" width="56" height="56" />
            : <div class="ws-avatar ws-avatar-fallback">{(ws.fullName || '?').charAt(0).toUpperCase()}</div>}
          <div class="ws-head-text">
            <p class="ws-eyebrow">Your workspace</p>
            <h1>{ws.fullName}</h1>
            <p class="ws-sub">
              {ws.designation || 'Role not recorded'}
              {ws.employeeCode ? ' · ' + ws.employeeCode : ''}
            </p>
            <div class="ws-chips">
              {ws.department && ws.department.name && <span class="ws-chip">{ws.department.name}</span>}
              {ws.employmentType && <span class="ws-chip">{ws.employmentType}</span>}
              {ws.workMode && <span class="ws-chip">{ws.workMode}</span>}
              {ws.joiningDate && <span class="ws-chip">Joined {shortDate(ws.joiningDate)}</span>}
            </div>
          </div>
        </header>

        {!ws.department && (
          <p class="ws-note">
            Your department is not recorded on your employee record, so anything organised by
            department will look empty for you. That is a gap in the record, not in your work. Ask HR
            to set it.
          </p>
        )}
        {ws.department && !ws.department.name && (
          <p class="ws-note">
            Your record points at a department we cannot find a name for. Nothing here depends on it,
            but it is worth telling HR.
          </p>
        )}

        {/* The four facts a person is asked for and cannot always remember. Each one says
            "Not recorded" rather than going blank: an empty row looks like a page that failed,
            and a gap in the record is something they can get fixed. */}
        <div class="ws-card ws-facts">
          <div class="ws-fact">
            <span class="ws-stat-label">Reporting to</span>
            <span>{manager && manager.manager_name
              ? manager.manager_name + (manager.manager_role ? ' · ' + manager.manager_role : '')
              : 'Not recorded'}</span>
          </div>
          <div class="ws-fact">
            <span class="ws-stat-label">Joined</span>
            <span>{ws.joiningDate ? prettyDate(ws.joiningDate) : 'Not recorded'}</span>
          </div>
          <div class="ws-fact">
            <span class="ws-stat-label">{ws.isIntern ? 'Into your internship' : 'Time here'}</span>
            {/* Three different answers, because they are three different situations. A joining
                date in the FUTURE is not a missing record - somebody who has not started yet
                should be told when they do, not shown a blank. */}
            <span>
              {weeksSinceJoining !== null
                ? (weeksSinceJoining < 1
                    ? daysSinceJoining + ' day' + (daysSinceJoining === 1 ? '' : 's') + ' in'
                    : 'Week ' + (weeksSinceJoining + 1))
                : Number.isNaN(daysSinceJoining)
                  ? 'Not recorded'
                  : 'Starts ' + prettyDate(ws.joiningDate)}
            </span>
          </div>
          <div class="ws-fact">
            <span class="ws-stat-label">Engagement</span>
            <span class="ws-cap">{ws.employmentStatus || 'active'}</span>
          </div>
        </div>

        <p class="ws-scope-note">
          This page is your own record and only ever your own. It is built from the same data as your
          completion report, so nothing here is a number somebody else has to read out to you.
        </p>

        {/* ---------------------------------------------------------------- Credit position */}
        <section class="ws-card">
          <div class="ws-card-head">
            <h2>Your credit position</h2>
            {weeksLeft !== null && weeksLeft > 0 && (
              <span class="ws-meta">about {weeksLeft} week{weeksLeft === 1 ? '' : 's'} to go</span>
            )}
          </div>

          {!credit && (
            <p class="ws-muted">
              We could not read your credit position just now. Nothing you have logged is affected.
              Reload in a moment, and tell HR if it keeps happening.
            </p>
          )}

          {credit && (
            <div>
              <p class="ws-big">
                <strong>{credit.creditHours}</strong>
                <span>{credit.requiredCreditHours ? 'of ' + credit.requiredCreditHours + ' credit-hours' : 'credit-hours earned'}</span>
              </p>

              {creditPct !== null && (
                <div class="ws-bar-wrap">
                  <div class="ws-bar"><div class="ws-bar-fill" style={`width:${creditPct}%;background:${creditPct >= 100 ? '#15803d' : '#c2410c'};`}></div></div>
                  <p class="ws-muted small">{creditPct >= 100 ? 'Requirement met.' : creditPct + '% of the requirement'}</p>
                </div>
              )}

              {!credit.requiredCreditHours && (
                <p class="ws-muted small">
                  No credit-hour requirement is set on your engagement, so there is no target to
                  measure against - only the hours you have actually earned.
                </p>
              )}

              {/* Time served is not the measure and saying so prevents a nasty surprise at the end.
                  Only shown when both figures are real, and only as a comparison. */}
              {weeksSinceJoining !== null && weeksLeft !== null && weeksLeft > 0 && creditPct !== null && (
                <p class="ws-muted small spaced-top">
                  You are {weeksSinceJoining < 1 ? 'in your first week' : 'in week ' + (weeksSinceJoining + 1)} and
                  {' '}{creditPct}% of the way to the requirement. What counts is the credit-hours, not the
                  weeks - at your current agreed load that is about {weeksLeft} more week{weeksLeft === 1 ? '' : 's'} of
                  full engagement.
                </p>
              )}

              <div class="ws-stats">
                <div>
                  <span class="ws-stat-label">Attendance</span>
                  <span class="ws-stat" style={`color:${credit.attendancePct >= 85 ? '#15803d' : credit.attendancePct >= 70 ? '#b45309' : '#b91c1c'};`}>{credit.attendancePct}%</span>
                </div>
                <div>
                  <span class="ws-stat-label">Days worked</span>
                  <span class="ws-stat">{credit.daysPresent}</span>
                </div>
                <div>
                  <span class="ws-stat-label">Approved leave</span>
                  <span class="ws-stat">{credit.authorisedLeaveDays}</span>
                </div>
                <div>
                  <span class="ws-stat-label">Still to earn</span>
                  <span class="ws-stat">{credit.shortfallHours === null ? 'n/a' : credit.shortfallHours + 'h'}</span>
                </div>
              </div>

              {(credit.unauthorisedLeaveDays > 0 || credit.noticeBreaches > 0) && (
                <div class="ws-warn">
                  {credit.unauthorisedLeaveDays > 0 && (
                    <p><strong>{credit.unauthorisedLeaveDays} day{credit.unauthorisedLeaveDays === 1 ? '' : 's'}</strong> are recorded as absent with no approved leave covering them.</p>
                  )}
                  {credit.noticeBreaches > 0 && (
                    <p><strong>{credit.noticeBreaches}</strong> leave day{credit.noticeBreaches === 1 ? '' : 's'} had no notice given before the day itself.</p>
                  )}
                  <p class="small">Both appear on your completion report. Applying before you take leave is what keeps a day authorised - shown here now, while there is still time to act on it.</p>
                </div>
              )}

              {terms && terms.kind === 'part-time' && !terms.weeklyHours && (
                <p class="ws-note">
                  Your agreed part-time hours are not recorded, so credit cannot be worked out yet.
                  Ask HR to set them - we would rather show nothing than guess at what you agreed to.
                </p>
              )}
            </div>
          )}
        </section>

        {/* ---------------------------------------------------------------- Hours and attendance */}
        <section class="ws-card">
          <div class="ws-card-head">
            <h2>Hours and attendance</h2>
            <a class="ws-link" href="/portal/employee">Clock in or out</a>
          </div>

          <div class="ws-stats">
            <div>
              <span class="ws-stat-label">This week</span>
              <span class="ws-stat">{round1(attRow?.week_hours)}h</span>
            </div>
            <div>
              <span class="ws-stat-label">Days in, this week</span>
              <span class="ws-stat">{Number(attRow?.week_days || 0)}</span>
            </div>
            <div>
              <span class="ws-stat-label">This month</span>
              <span class="ws-stat">{round1(attRow?.month_hours)}h</span>
            </div>
            <div>
              <span class="ws-stat-label">Days in, this month</span>
              <span class="ws-stat">{Number(attRow?.month_days || 0)}</span>
            </div>
          </div>

          {recentDays.length > 0 ? (
            <div>
              <p class="ws-stat-label spaced">Your last {recentDays.length} recorded days</p>
              <div class="ws-scroll">
                <div class="ws-strip">
                  {recentDays.map((d: any) => (
                    <span class="ws-day" style={`background:${dayTone(d.status)};`} title={shortDate(d.date) + ' - ' + dayWord(d.status)}></span>
                  ))}
                </div>
              </div>
              <ul class="ws-legend">
                <li><i style="background:#15803d;"></i>Worked</li>
                <li><i style="background:#0284c7;"></i>Approved leave</li>
                <li><i style="background:#b91c1c;"></i>Absent</li>
                <li><i style="background:#c9c0b2;"></i>Holiday</li>
              </ul>

              {/* The same days in words. A colour block cannot be read on a phone and cannot be
                  read at all by a screen reader, and "what was the 14th recorded as" is the
                  question people actually open this page with. */}
              <div class="ws-daygroup">
                <p class="ws-daygroup-head">
                  <span>Day by day</span>
                  <span class="ws-meta">most recent first</span>
                </p>
                {recentDetail.map((d: any) => (
                  <div class="ws-row">
                    <span class="ws-mono">{shortDate(d.date)}</span>
                    <span class="ws-row-main" style={`color:${d.status === 'unauthorised-leave' ? '#b91c1c' : 'inherit'};`}>
                      {dayWord(d.status)}
                    </span>
                    {/* Only 'present' ever carries hours: credit-ledger.ts drops a stored 0 so a
                        leave day cannot read as "worked zero hours", and a half day is credited by
                        rule rather than from the clock. Asking the other statuses for hours would
                        print "not recorded" against every one of them, which is not true. */}
                    <span class="ws-meta">
                      {d.status !== 'present'
                        ? ''
                        : (d.hours === undefined || d.hours === null ? 'hours not recorded' : round1(d.hours) + 'h')}
                    </span>
                  </div>
                ))}
              </div>

              {credit && credit.unauthorisedLeaveDays > 0 && (
                <p class="ws-note">
                  A day marked absent becomes approved leave the moment an approved request covers
                  it. If one of these was agreed with someone and never went through the leave form,
                  that is worth sorting out now rather than at the end - it is counted against your
                  completion report either way.
                </p>
              )}
            </div>
          ) : (
            <p class="ws-muted">No attendance has been recorded against you yet. Your first clock-in starts it.</p>
          )}
        </section>

        {/* ---------------------------------------------------------------- Hour log */}
        <section class="ws-card">
          <div class="ws-card-head">
            <h2>Your hour log</h2>
            <span class="ws-meta">{loggedFortnight}h in the last fortnight</span>
          </div>
          <p class="ws-muted small">
            The blocks you booked against a day. The attendance page only shows today, so this is
            where you check a week you have already worked, and fill in a block you forgot.
          </p>

          {logDays.length === 0 && <p class="ws-muted">Nothing logged in the last fortnight.</p>}

          {logDays.map((bucket: any) => (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head">
                <span>{prettyDate(bucket.date)}</span>
                <span class="ws-meta">{round1(bucket.hours)}h</span>
              </p>
              {bucket.entries.map((l: any) => (
                <div class="ws-row">
                  <span class="ws-mono">{l.start_time} to {l.end_time}</span>
                  <span class="ws-row-main">{l.task}</span>
                  <span class="ws-meta">{round1(l.hours)}h</span>
                  <form method="POST">
                    <input type="hidden" name="action" value="delete_time_log" />
                    <input type="hidden" name="log_id" value={l.id} />
                    <button type="submit" class="ws-del">Remove</button>
                  </form>
                </div>
              ))}
            </div>
          ))}

          <form method="POST" class="ws-form">
            <input type="hidden" name="action" value="add_time_log" />
            <div class="ws-field">
              <label for="ws-date">Day</label>
              <select id="ws-date" name="log_date">
                {backfillDates.map((d: string) => (
                  <option value={d}>{d === todayIso ? 'Today' : prettyDate(d)}</option>
                ))}
              </select>
            </div>
            <div class="ws-field">
              <label for="ws-from">From</label>
              <input id="ws-from" type="time" name="start_time" required />
            </div>
            <div class="ws-field">
              <label for="ws-to">To</label>
              <input id="ws-to" type="time" name="end_time" required />
            </div>
            <div class="ws-field grow">
              <label for="ws-task">What you worked on</label>
              <input id="ws-task" name="task" required maxlength="500" placeholder="e.g. Rewrote the intake form validation" />
            </div>
            <button type="submit" class="ws-btn">Add block</button>
          </form>
          <p class="ws-muted small">
            You can fill in the last {BACKFILL_DAYS} days. Anything older goes through HR, so a
            change to your record always has a name against it.
          </p>
        </section>

        {/* ---------------------------------------------------------------- Leave */}
        <section class="ws-card">
          <div class="ws-card-head">
            <h2>Your leave</h2>
            <a class="ws-link" href="/portal/employee/leave">Apply for leave</a>
          </div>

          {countedBalances.length > 0 ? (
            <div class="ws-stats">
              {countedBalances.map((b: any) => (
                <div>
                  <span class="ws-stat-label">{b.name}</span>
                  <span class="ws-stat">{b.remaining}</span>
                  <span class="ws-meta">of {b.allowance} left{b.pending ? ', ' + b.pending + ' pending' : ''}</span>
                </div>
              ))}
            </div>
          ) : (
            <p class="ws-muted">No leave allowance is set up for you yet.</p>
          )}

          {leaveHistory.length === 0 && <p class="ws-muted">You have not requested any leave.</p>}

          {/* Booked and safe. */}
          {upcomingLeave.length > 0 && (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head"><span>Approved and still to come</span></p>
              {upcomingLeave.map((l: any) => (
                <div class="ws-row">
                  <span class="ws-row-main">
                    <strong class="ws-cap">{l.leave_type}</strong>
                    <span class="ws-meta"> {shortDate(l.start_date)} to {shortDate(l.end_date)} · {l.days}d</span>
                  </span>
                  <span class="ws-pill" style={`color:${leaveTone('approved')};border-color:${leaveTone('approved')}40;`}>approved</span>
                </div>
              ))}
            </div>
          )}

          {/* Not yet safe, and the difference matters: an unapproved day taken is an unauthorised
              absence on the completion report, which is the thing that costs people a certificate. */}
          {pendingLeave > 0 && (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head"><span>Waiting on a decision</span></p>
              {pendingRequests.map((l: any) => (
                <div class="ws-row">
                  <span class="ws-row-main">
                    <strong class="ws-cap">{l.leave_type}</strong>
                    <span class="ws-meta"> {shortDate(l.start_date)} to {shortDate(l.end_date)} · {l.days}d</span>
                  </span>
                  <span class="ws-pill" style={`color:${leaveTone('pending')};border-color:${leaveTone('pending')}40;`}>pending</span>
                </div>
              ))}
              <p class="ws-note">
                {pendingLeave === 1 ? 'This request has' : 'These requests have'} not been decided
                yet. Until a request is approved, the days it covers are not authorised leave - if
                you take them and the decision does not come, they are recorded as absence.
              </p>
            </div>
          )}

          {settledLeave.length > 0 && (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head"><span>Earlier requests</span></p>
              {settledLeave.slice(0, 10).map((l: any) => (
                <div class="ws-row">
                  <span class="ws-row-main">
                    <strong class="ws-cap">{l.leave_type}</strong>
                    <span class="ws-meta"> {shortDate(l.start_date)} to {shortDate(l.end_date)} · {l.days}d</span>
                  </span>
                  <span class="ws-pill" style={`color:${leaveTone(l.status)};border-color:${leaveTone(l.status)}40;`}>{l.status}</span>
                </div>
              ))}
            </div>
          )}
          <p class="ws-muted small">
            Leave is decided by HR or an administrator. Notice given before the first day is what
            makes those days authorised on your credit record.
          </p>
        </section>

        {/* ---------------------------------------------------------------- Tasks */}
        <section class="ws-card">
          <div class="ws-card-head"><h2>What you have been working on</h2></div>
          <p class="ws-muted small">
            There is no separate assignments table in this system, so nobody is quietly holding a
            task list for you. This is what you recorded yourself at clock-out and in your daily
            report - which is also what a reviewer reads.
          </p>

          {taskLogs.length === 0 && reports.length === 0 && (
            <p class="ws-muted">Nothing recorded yet. Your clock-out wrap-up and your daily report both land here.</p>
          )}

          {taskLogs.length > 0 && (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head"><span>Session wrap-ups</span></p>
              {taskLogs.map((t: any) => (
                <div class="ws-row">
                  <span class="ws-meta ws-mono">{shortDate(t.log_date)}</span>
                  <span class="ws-row-main">
                    {t.task}
                    {t.details && <span class="ws-meta block">{t.details}</span>}
                  </span>
                  <span class="ws-pill" style={`color:${taskTone(t.status)};border-color:${taskTone(t.status)}40;`}>{t.status}</span>
                  <span class="ws-meta ws-mono">{t.percent}%</span>
                </div>
              ))}
            </div>
          )}

          {reports.length > 0 && (
            <div class="ws-daygroup">
              <p class="ws-daygroup-head"><span>Daily reports</span></p>
              {reports.map((r: any) => (
                <div class="ws-report">
                  <p class="ws-meta ws-mono">{prettyDate(r.report_date)}</p>
                  <p>{r.work_done}</p>
                  {r.progress && <p class="ws-muted small">Next: {r.progress}</p>}
                  {r.blockers && <p class="ws-blocked small">Blocked on: {r.blockers}</p>}
                </div>
              ))}
            </div>
          )}
        </section>

        {/* ---------------------------------------------------------------- Joining documents */}
        <section class="ws-card">
          <div class="ws-card-head">
            <h2>Your joining documents</h2>
            <a class="ws-link" href="/portal/employee/onboarding">Onboarding form</a>
          </div>

          <div class="ws-stats">
            <div>
              <span class="ws-stat-label">Onboarding</span>
              <span class="ws-stat" style={`color:${onboardingDone ? '#15803d' : '#b45309'};`}>
                {ws.onboardingStatus || 'pending'}
              </span>
            </div>
            <div>
              <span class="ws-stat-label">Submitted</span>
              <span class="ws-stat">{docStats.submitted} of {MAX_DOCS}</span>
            </div>
            <div>
              <span class="ws-stat-label">Verified</span>
              <span class="ws-stat" style={`color:${docStats.verified > 0 ? '#15803d' : '#6b6255'};`}>{docStats.verified}</span>
            </div>
            <div>
              <span class="ws-stat-label">Needs redoing</span>
              <span class="ws-stat" style={`color:${docStats.rejected > 0 ? '#b91c1c' : '#6b6255'};`}>{docStats.rejected}</span>
            </div>
          </div>

          {docs.length === 0 && (
            <p class="ws-muted">
              No documents submitted yet. They are shared as view-only links to your own cloud
              storage, so the file itself never leaves your account.
            </p>
          )}
          {/* The link is the document. Nothing was uploaded here and there is no copy on our side to
              open, so "view" means opening the share link in their own storage - which is also the
              fastest way for them to check the sharing permission a reviewer could not get past. */}
          {docs.map((d: any) => (
            <div class="ws-row">
              <span class="ws-row-main">
                <strong>{docTypeLabel(d.docType)}</strong>
                {d.title && <span class="ws-meta"> {d.title}</span>}
                {d.reviewNote && <span class="ws-meta block">Reviewer: {d.reviewNote}</span>}
              </span>
              {d.driveUrl && (
                <a class="ws-link" href={d.driveUrl} target="_blank" rel="noopener noreferrer">Open</a>
              )}
              <span class="ws-pill" style={`color:${docTone(d.status)};border-color:${docTone(d.status)}40;`}>{d.status}</span>
            </div>
          ))}
          {docStats.rejected > 0 && (
            <p class="ws-note">
              A document sent back is usually a sharing-permission problem rather than anything wrong
              with the document itself. Re-share it so that anyone holding the link can view it, then
              submit it again.
            </p>
          )}
        </section>

        {/* ---------------------------------------------------------------- Reviews */}
        <section class="ws-card">
          <div class="ws-card-head"><h2>Your reviews</h2></div>

          {reviews.length === 0 && perfReviews.length === 0 && (
            <p class="ws-muted">
              No review has been written about you yet. When one is, it appears here for you to read
              - the same words that go into your completion report.
            </p>
          )}

          {perfReviews.map((p: any) => (
            <div class="ws-review">
              <p class="ws-review-head">
                <strong>{p.cycle_title || 'Review'}</strong>
                {p.overall_rating !== null && p.overall_rating !== undefined && (
                  <span class="ws-pill">{Number(p.overall_rating)} out of 5</span>
                )}
              </p>
              {(p.period_start || p.period_end) && (
                <p class="ws-meta ws-mono">{shortDate(p.period_start)} to {shortDate(p.period_end)}</p>
              )}
              {p.strengths && <p><span class="ws-stat-label">Went well</span> {p.strengths}</p>}
              {p.improvements && <p><span class="ws-stat-label">To improve</span> {p.improvements}</p>}
              {p.goals_next && <p><span class="ws-stat-label">Next</span> {p.goals_next}</p>}
            </div>
          ))}

          {reviews.map((r: any) => (
            <div class="ws-review">
              <p class="ws-review-head">
                <strong>{r.reviewer}</strong>
                {r.rating ? <span class="ws-pill">{r.rating} out of 5</span> : null}
                <span class="ws-meta ws-mono">{prettyDate(r.date)}</span>
              </p>
              {r.note && <p>{r.note}</p>}
            </div>
          ))}
        </section>

        {/* ---------------------------------------------------------------- Elsewhere */}
        <nav class="ws-tiles" aria-label="Other pages">
          <a href="/portal/employee">
            <strong>Attendance</strong>
            <span>Clock in, clock out, today's log</span>
          </a>
          <a href="/portal/employee/leave">
            <strong>Leave</strong>
            <span>Apply and track requests</span>
          </a>
          <a href="/portal/employee/wallet">
            <strong>Wallet</strong>
            <span>Payments and withdrawals</span>
          </a>
          <a href="/portal/my-record-access">
            <strong>My record</strong>
            <span>Who has read your communications</span>
          </a>
        </nav>

        <p class="ws-foot">
          Something here wrong? It is your record, so it should be corrected rather than worked
          around. Write to <a href="mailto:hr@edurankai.in">hr@edurankai.in</a> and say what does not
          match.
        </p>

      </div>
    )}
  </section>

