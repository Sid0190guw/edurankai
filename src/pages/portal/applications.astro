---
// The candidate's own applications — the entry point to their decision.
//
// THE CHIP DOES NOT REVEAL THE OUTCOME. When a decision exists it reads "Decision ready" whether the
// answer is an offer or not, for both. A list that shows the verdict takes the moment away from the
// page built to deliver it properly, and it means someone learns they were turned down from a
// coloured label glimpsed on a bus. The result lives on the decision page and nowhere else.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent('/portal/applications'));

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

// Scoped to this user at the QUERY, not filtered afterwards — the database never returns another
// person's application in the first place.
let apps: any[] = [];
try {
  const r = await db.execute(sql`
    SELECT id, application_number, role_title_snapshot, department_snapshot, status, created_at
      FROM applications
     WHERE applicant_user_id = ${user.id}
     ORDER BY created_at DESC
     LIMIT 50`);
  apps = rowsOf(r);
} catch (e: any) {
  console.error('[portal/applications]', e?.cause?.message || e?.message);
}

const DECIDED = new Set(['offer', 'hired', 'rejected']);

// What the candidate is told at each stage. Deliberately plain: a status someone cannot interpret
// is the same as no status at all.
const STAGE: Record<string, string> = {
  submitted: 'Received',
  reviewing: 'Under review',
  task_sent: 'Task sent',
  interview: 'Interview stage',
  withdrawn: 'Withdrawn',
};

function chipFor(status: string): { label: string; ready: boolean } {
  if (DECIDED.has(status)) return { label: 'Decision ready', ready: true };
  return { label: STAGE[status] || 'In progress', ready: false };
}

const fmt = (d: any) => (d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
---

<BaseLayout title="My applications" description="Your applications to EduRankAI and where each one stands.">
  <section class="wrap">
    <p class="eyebrow">Applicant portal</p>
    <h1>My applications</h1>

    {apps.length === 0 ? (
      <div class="empty">
        <p class="empty-t">You have not applied to anything yet.</p>
        <p class="empty-b">When you apply, this is where you will follow it — and where your decision appears.</p>
        <a class="btn" href="/careers">Browse open roles</a>
      </div>
    ) : (
      <ul class="list">
        {apps.map((a: any) => {
          const chip = chipFor(String(a.status));
          return (
            <li class="card">
              <a class="card-link" href={'/portal/decision/' + a.id}>
                <div class="card-top">
                  <span class={chip.ready ? 'chip chip-ready' : 'chip'}>{chip.label}</span>
                  <span class="ref">{a.application_number || ''}</span>
                </div>
                <p class="role">{a.role_title_snapshot || 'Role'}</p>
                <p class="dept">{a.department_snapshot || ''}</p>
                <p class="date">Applied {fmt(a.created_at)}</p>
                <span class="go">{chip.ready ? 'View decision' : 'View application'}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 26px 18px 70px; }
  .eyebrow {
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #c2410c; font-weight: 700; margin: 0 0 6px;
    font-family: 'Geist Mono', ui-monospace, monospace;
  }
  h1 {
    font-family: Fraunces, Georgia, serif; font-weight: 600; color: #1a1510;
    font-size: clamp(24px, 5vw, 32px); margin: 0 0 22px; letter-spacing: -0.01em;
  }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  /* Cards, not a table. A five-column table on a 360px screen is the thing that makes an HR
     system feel unusable on the device most people actually open it on. */
  .card { margin: 0; }
  .card-link {
    display: block; text-decoration: none; background: #fff; border: 1px solid #ece4d6;
    border-radius: 14px; padding: 15px 16px; transition: border-color .14s ease, transform .14s ease;
  }
  .card-link:hover { border-color: #c2410c; transform: translateY(-1px); }
  .card-link:focus-visible { outline: 2px solid #FF4F00; outline-offset: 2px; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 9px; }
  .chip {
    font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    color: #5c5349; background: #f4efe7; border: 1px solid #e4dcd1;
    border-radius: 999px; padding: 5px 10px; font-family: 'Geist Mono', ui-monospace, monospace;
  }
  /* The only visual distinction is "there is something to open" — never what it says. */
  .chip-ready { color: #8a4b12; background: #fdf3e7; border-color: #f0d9bd; }
  .ref { font-size: 11px; color: #8a7f70; font-family: 'Geist Mono', ui-monospace, monospace; }
  .role { font-size: 16px; font-weight: 600; color: #1a1510; margin: 0 0 2px; line-height: 1.35; }
  .dept { font-size: 13px; color: #5c5349; margin: 0 0 8px; }
  .date { font-size: 12px; color: #8a7f70; margin: 0 0 10px; }
  .go { font-size: 13px; font-weight: 600; color: #c2410c; }
  .empty { background: #fff; border: 1px solid #ece4d6; border-radius: 16px; padding: 26px 20px; }
  .empty-t { font-size: 16px; font-weight: 600; color: #1a1510; margin: 0 0 6px; }
  .empty-b { font-size: 14px; color: #5c5349; margin: 0 0 16px; line-height: 1.65; }
  .btn {
    display: inline-block; background: #1a1510; color: #fff; text-decoration: none;
    padding: 11px 18px; border-radius: 9px; font-size: 14px; font-weight: 600;
    border-bottom: 3px solid #FF4F00;
  }
  .btn:focus-visible { outline: 2px solid #FF4F00; outline-offset: 3px; }
</style>
