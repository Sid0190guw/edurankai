---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { markOfferOpened } from '@/lib/track';
import { offerLetters, applications, applicationMessages } from '@/lib/db/schema';
import { eq, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const { token } = Astro.params;
if (!token) return Astro.redirect('/portal');

let errorMsg = '';
let successMsg = '';
let acceptedNow = false;   // show the joining-documents call to action right after acceptance

// Fetch the offer
const offerList = await db.select().from(offerLetters)
  .where(eq(offerLetters.token, token))
  .limit(1);

if (offerList.length === 0) return Astro.redirect('/portal');
const offer: any = offerList[0];

// Verify the offer belongs to this user via the application
const appList = await db.select().from(applications)
  .where(and(eq(applications.id, offer.applicationId), eq(applications.applicantUserId, user.id)))
  .limit(1);

// WHO IS LOOKING? Two distinct answers, and the old `user.role !== 'applicant'` conflated them.
//
//  - The RECIPIENT signs or declines. Ownership is the application being theirs, or the offer
//    having created their account. Role is NOT a proxy for this: an offer letter auto-creates a
//    candidate account with role 'editor', so a recipient without a prior application counted as
//    "admin", which made the whole page read-only and left them unable to sign their own offer.
//  - STAFF may read it, and only read it. That must be the same permission that gates the
//    /admin/offers section — under the old test any internal role (editor, marketing, partner,
//    teacher) could open any candidate's offer, salary included, from the token alone.
const isOwner = appList.length > 0
  || (offer.createdUserId && String(offer.createdUserId) === String(user.id));
let isAdmin = false;   // "viewing as staff" — never allowed to sign
if (!isOwner) {
  const { canAccessSection } = await import('@/lib/auth/permissions');
  isAdmin = await canAccessSection(user as any, 'offers', 'view').catch(() => false);
  if (!isAdmin) return Astro.redirect('/portal');
}
const app: any = appList.length > 0 ? appList[0] : null;

// Handle signing — recipient only.
if (Astro.request.method === 'POST' && isOwner) {
  const _fdPeek = await Astro.request.clone().formData();
  const _action = (_fdPeek.get('action') as string || 'sign').trim();

  if (_action === 'decline') {
    if (offer.status === 'signed') {
      errorMsg = 'This offer has already been signed and cannot be declined.';
    } else if (offer.status === 'withdrawn') {
      errorMsg = 'This offer has been withdrawn.';
    } else if (offer.status === 'declined') {
      errorMsg = 'This offer has already been declined.';
    } else {
      const reason = (_fdPeek.get('declineReason') as string || '').trim().substring(0, 500);
      try {
        await db.update(offerLetters).set({
          status: 'declined',
          declinedAt: new Date(),
          declinedReason: reason || null,
          updatedAt: new Date()
        }).where(eq(offerLetters.id, offer.id));

        if (offer.createdUserId) {
          const { users } = await import('@/lib/db/schema');
          await db.update(users).set({ isActive: false, updatedAt: new Date() }).where(eq(users.id, offer.createdUserId));
        }

        if (app) {
          await db.update(applications).set({ status: 'rejected', updatedAt: new Date() }).where(eq(applications.id, app.id));
          await db.insert(applicationMessages).values({
            applicationId: app.id,
            senderUserId: user.id,
            senderRole: 'system',
            senderName: 'System',
            body: 'Offer declined by applicant. Account access revoked. 6-month cooling period applies before re-application for the same role.' + (reason ? ' Reason: ' + reason : ''),
            isSystem: true
          });
        }

        try {
          const { pushNotify } = await import('@/lib/push');
          await pushNotify.offerDeclined(offer.candidateName || 'Candidate', offer.roleTitle || 'a role', app?.id || '');
        } catch (_) {}

        offer.status = 'declined';
        (offer as any).declinedAt = new Date();
        (offer as any).declinedReason = reason || null;
        successMsg = 'You have declined this offer. Per EduRankAI terms, a 6-month cooling period applies before you can reapply for the same role. Your auto-issued account access has been revoked.';
      } catch (err: any) {
        errorMsg = 'Failed to record decline: ' + (err.message || 'Unknown error');
      }
    }
  } else if (offer.status === 'signed') {
    errorMsg = 'This offer has already been signed.';
  } else if (offer.status === 'withdrawn') {
    errorMsg = 'This offer has been withdrawn and cannot be signed.';
  } else {
    const fd = await Astro.request.formData();
    const signatureDataUrl = (fd.get('signatureDataUrl') as string || '').trim();

    // Consent is checked HERE, not only in the browser. The acceptance checkbox previously had no
    // `name`, so it was never submitted and the server had no record that the terms were ever
    // agreed to — for a binding electronic acceptance the only evidence was a client-side alert().
    const consented = (fd.get('consent') as string || '') === 'yes';

    if (!consented) {
      errorMsg = 'Please tick the box confirming you have read and accept the terms before signing.';
    } else if (!signatureDataUrl || !signatureDataUrl.startsWith('data:image/')) {
      errorMsg = 'Please draw your signature before submitting.';
    } else if (signatureDataUrl.length > 500000) {
      errorMsg = 'Signature image too large.';
    } else {
      try {
        const ipHeader = Astro.request.headers.get('x-forwarded-for') || Astro.request.headers.get('cf-connecting-ip') || '';
        const ua = Astro.request.headers.get('user-agent') || '';

        await db.update(offerLetters).set({
          status: 'signed',
          signedAt: new Date(),
          signatureDataUrl,
          signatureIp: ipHeader.substring(0, 64),
          signatureUserAgent: ua,
          updatedAt: new Date()
        }).where(eq(offerLetters.id, offer.id));

        // Update application status to hired
        if (app) {
          await db.update(applications).set({
            status: 'hired',
            updatedAt: new Date()
          }).where(eq(applications.id, app.id));

          // Post system message to thread
          await db.insert(applicationMessages).values({
            applicationId: app.id,
            senderUserId: user.id,
            senderRole: 'system',
            senderName: 'System',
            body: 'Offer accepted and signed by the applicant. Status updated to: Hired.',
            isSystem: true
          });
        }

        // Transfer the applicant into an employee record (pending onboarding).
        try {
          const { transferApplicantToEmployee } = await import('@/lib/hire-transfer');
          await transferApplicantToEmployee(offer);
        } catch (_) {}

        // NOW they are staff. Internal access is granted on acceptance, not on offer send.
        // Never demote an existing admin/HR account that happens to accept an offer.
        try {
          const { sql: sqlRaw } = await import('drizzle-orm');
          await db.execute(sqlRaw`UPDATE users SET role = 'editor', updated_at = NOW()
            WHERE id = ${user.id}::uuid AND role = 'applicant'`);
        } catch (_) {}

        // Durable evidence of acceptance: who, when, from where, and that consent was given.
        try {
          const { logAudit } = await import('@/lib/audit');
          await logAudit({
            userId: String(user.id), action: 'offer.signed', entity: 'offer_letter',
            entityId: String(offer.id), ipAddress: ipHeader.substring(0, 64),
            diff: { refNumber: offer.refNumber, roleTitle: offer.roleTitle,
              consent: true, consentText: 'read the offer, accepts all terms, typed name is legal e-signature',
              userAgent: ua.slice(0, 300) },
          });
        } catch (_) {}

        // The face-2FA selfie was captured before this employee record existed (middleware forces
        // enrolment on the first protected page load), so promote it to the profile photo now.
        try {
          const { promoteEnrolmentPhoto } = await import('@/lib/hr-onboarding');
          await promoteEnrolmentPhoto(String(user.id));
        } catch (_) {}

        // Push notification to admins
        try {
          const { pushNotify } = await import('@/lib/push');
          await pushNotify.offerSigned(offer.candidateName || 'Candidate', offer.roleTitle || 'a role', app?.id || '');
        } catch (_) {}
        successMsg = 'Offer accepted. You are officially part of EduRankAI. Next: share your educational and professional certificates so HR can verify them.';
        acceptedNow = true;
        offer.status = 'signed';
        offer.signedAt = new Date();
        offer.signatureDataUrl = signatureDataUrl;
      } catch (err: any) {
        errorMsg = 'Failed to record signature: ' + (err.message || 'Unknown error');
      }
    }
  }
}

const content = offer.content || {};
const c = content;
const verifyUrl = 'https://edurankai.in/offer/verify/' + offer.token;
// Rendered server-side so it is present in the printed/saved document, not dependent on a script
// having run or a remote image still existing years later.
const { qrSvg } = await import('@/lib/qr');
const verifyQr = await qrSvg(verifyUrl, { size: 128 });
const shortId = offer.id.substring(0, 8).toUpperCase();

function formatDate(d: any): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (isNaN(date.getTime())) return d;
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
}
// India Standard Time stamp - the server runs in UTC, so we must pin the zone
// or signed timestamps render ~5.5h off.
function formatDateTimeIST(d: any): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (isNaN(date.getTime())) return '';
  return date.toLocaleString('en-IN', {
    day: '2-digit', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit', hour12: true,
    timeZone: 'Asia/Kolkata'
  }) + ' IST';
}

// Load internal handle for the user account, if linked
let internalHandle: string | null = null;
if (offer.createdUserId) {
  try {
    const { users } = await import('@/lib/db/schema');
    const u = await db.select({ h: users.internalHandle }).from(users).where(eq(users.id, offer.createdUserId)).limit(1);
    if (u.length > 0) internalHandle = u[0].h;
  } catch (e) {}
}
const isWithdrawn = offer.status === 'withdrawn';
const isSigned = offer.status === 'signed';
const isDeclined = offer.status === 'declined';
const isAvailable = offer.status === 'sent';

// Expiry check
let expiryStatus = 'ok';
let daysLeft = null;
if (offer.expiryDate && !isSigned) {
  const exp = new Date(offer.expiryDate);
  const diff = exp.getTime() - Date.now();
  daysLeft = Math.ceil(diff / 86400000);
  if (diff <= 0) expiryStatus = 'expired';
  else if (daysLeft <= 3) expiryStatus = 'warning';
}

const TEMPLATE_INTROS: Record<string, string> = {
  intern: 'We are pleased to extend this formal offer of an internship for the position of',
  fulltime: 'We are pleased to extend this formal full-time employment offer for the position of',
  contract: 'We are pleased to extend this contract engagement offer for the position of',
  leadership: 'We are honored to extend this leadership offer for the position of'
};

const intro = TEMPLATE_INTROS[offer.templateType] || TEMPLATE_INTROS.intern;

// Data for the one-click, dependency-free PDF generator (era-offer-pdf.js).
const isIntern = (offer.templateType === 'intern') || /intern/i.test(c.employmentType || '');
const joiningTxt = formatDate(c.joiningDate) || 'a mutually agreed date';
const offerPdfData = {
  refNumber: offer.refNumber || '',
  offerDate: formatDate(offer.offerDate),
  candidateName: c.candidateName || offer.candidateName || '',
  candidateEmail: c.candidateEmail || offer.candidateEmail || '',
  candidatePhone: c.candidatePhone || '',
  candidateCity: c.candidateCity || '',
  roleTitle: c.roleTitle || offer.roleTitle || '',
  department: c.department || offer.department || '',
  employmentType: c.employmentType || '',
  workMode: c.workMode || '',
  duration: c.duration || '',
  hoursCommitment: c.hoursCommitment || '',
  compensation: c.compensation || 'To be discussed',
  integrityHash: offer.integrityHash || '',
  internalHandle: internalHandle || '',
  verifyUrl: verifyUrl,
  signed: offer.status === 'signed',
  signedAt: offer.signedAt ? formatDateTimeIST(offer.signedAt) : '',
  signatoryName: (c.signatoryName || 'Siddharth Prasad'),
  signatoryTitle: (c.signatoryTitle || 'Founder & CEO'),
  bodyParas: [
    intro + ' ' + (c.roleTitle || '') + ' within ' + (c.department ? c.department : 'the team') + ' at EduRankAI. Following a thorough evaluation of your application and conversations, we are confident you demonstrate the capability, character, and commitment we look for.',
    isIntern
      ? ('This ' + (c.employmentType || 'internship') + ' is offered on an unpaid basis in accordance with EduRankAI\'s Internship Policy. You will work ' + (c.workMode || 'Remote') + ', committing ' + (c.hoursCommitment || 'the agreed hours') + ' of focused effort. The engagement runs for ' + (c.duration || 'the agreed term') + ', commencing ' + joiningTxt + '. Compensation: ' + (c.compensation || 'To be discussed') + '.')
      : ('This is a ' + (c.employmentType || 'role') + ' engagement, work mode ' + (c.workMode || 'Remote') + ', for ' + (c.duration || 'the agreed term') + ', commencing ' + joiningTxt + '. Compensation: ' + (c.compensation || 'as discussed') + '.'),
    'You will receive a mid-point review and a final review, assessed via EduRankAI\'s rubric-based evaluation. Outstanding performers receive a Letter of Recommendation; all successful completers receive a Certificate of Completion.',
    'By accepting, you confirm you have read and agree to EduRankAI\'s Recruitment and Work Policy and Code of Conduct.'
  ]
};
---
<BaseLayout title={'Offer Letter - ' + c.candidateName} description="Your EduRankAI offer letter">

  {/* Reading progress. Pure CSS scroll-driven animation - no scroll listener, no JS at all.
      Decorative (aria-hidden); where scroll timelines are unsupported it simply does not render,
      and the document is complete without it. */}
  <div class="doc-rail no-print" aria-hidden="true"><span class="doc-rail__fill"></span></div>

  <div class="era-doc">
  <section class="doc-shell">

    <div class="doc-actions no-print">
      <a href="/portal" class="doc-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="M12 19l-7-7 7-7" /></svg>
        Back to portal
      </a>
      <div class="doc-actions__btns">
        <button type="button" id="downloadPdfBtn" class="doc-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M7 10l5 5 5-5" /><path d="M12 15V3" /></svg>
          Download PDF
        </button>
        <button type="button" onclick="window.print()" class="doc-btn doc-btn--ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><path d="M6 14h12v8H6z" /></svg>
          Print exact copy
        </button>
      </div>
    </div>

    {errorMsg && (
      <div class="doc-note doc-note--warn no-print" role="alert">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
        <p>{errorMsg}</p>
      </div>
    )}
    {successMsg && (
      <div class="doc-note doc-note--ok no-print">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        <div>
          <p>{successMsg}</p>
          {acceptedNow && (
            <a href="/portal/onboarding" class="doc-cta">Submit my joining documents &rarr;</a>
          )}
        </div>
      </div>
    )}

    {isDeclined && (
      <div class="doc-note doc-note--warn no-print">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M15 9l-6 6" /><path d="M9 9l6 6" /></svg>
        <div>
          <p class="doc-note__eyebrow">Offer Declined</p>
          <p>You have declined this offer{(offer as any).declinedAt ? ' on ' + new Date((offer as any).declinedAt).toLocaleDateString('en-IN') : ''}.</p>
          <p class="doc-note__sm"><strong>Per EduRankAI terms:</strong> A <strong>6-month cooling period</strong> applies. You cannot reapply for the same role until {(offer as any).declinedAt ? new Date(new Date((offer as any).declinedAt).getTime() + 180 * 86400000).toLocaleDateString('en-IN') : '6 months from the decline date'}. Your auto-issued account access has been revoked.</p>
          {(offer as any).declinedReason && (
            <p class="doc-note__quote">Your reason: "{(offer as any).declinedReason}"</p>
          )}
        </div>
      </div>
    )}

    {isWithdrawn && (
      <div class="doc-note doc-note--warn no-print">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12h8" /></svg>
        <div>
          <p class="doc-note__eyebrow">This offer has been withdrawn</p>
          <p>The hiring team has withdrawn this offer. {offer.withdrawnReason && (<span>Reason: {offer.withdrawnReason}</span>)}</p>
          {!isAdmin && <p class="doc-note__sm">If you have questions, please use the message thread on your application.</p>}
        </div>
      </div>
    )}

    {expiryStatus === 'expired' && !isSigned && (
      <div class="doc-note doc-note--warn no-print">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        <div>
          <p class="doc-note__eyebrow">This offer has expired</p>
          <p class="doc-note__sm">Please contact us via the message thread to discuss.</p>
        </div>
      </div>
    )}

    {expiryStatus === 'warning' && !isSigned && (
      <div class="doc-note doc-note--time no-print">
        <svg class="doc-note__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        <p>This offer expires in {daysLeft} day{daysLeft !== 1 ? 's' : ''} &nbsp;|&nbsp; {formatDate(offer.expiryDate)}</p>
      </div>
    )}

    <article id="offerLetter" class="doc-paper">

      {/* ---------------------------------------------------------------- COVER */}
      <header class="doc-cover" data-reveal>
        <div class="doc-cover__top">
          <div>
            <p class="doc-wordmark">Edu<em>Rank</em>AI</p>
            <p class="doc-org">AI Research and Technology &middot; Guwahati, Assam, India</p>
            <p class="doc-org">Guwahati, Assam, India</p>
            <p class="doc-org">hr@edurankai.in &nbsp;|&nbsp; edurankai.in</p>
          </div>
          <div class="doc-cover__ref">
            <p class="doc-eyebrow">Reference</p>
            <p class="doc-ref">{offer.refNumber}</p>
            {offer.offerDate && (<p class="doc-org">{formatDate(offer.offerDate)}</p>)}
            <p class="doc-pill">Private and Confidential</p>
          </div>
        </div>

        <div class="doc-cover__body">
          <p class="doc-kicker">Offer letter</p>
          {c.candidateName && (
            <div class="doc-recipient">
              <p class="doc-display">{c.candidateName}</p>
              <p class="doc-contact">
                {c.candidateEmail && <span>{c.candidateEmail}</span>}
                {c.candidatePhone && <span> &nbsp;|&nbsp; {c.candidatePhone}</span>}
                {c.candidateCity && <span><br />{c.candidateCity}</span>}
              </p>
            </div>
          )}
          <span class="doc-cover__rule" aria-hidden="true"></span>
          <h1 class="doc-h1"><span class="doc-h1__re">Re: </span>Offer of {c.employmentType} &nbsp;|&nbsp; {c.roleTitle}{c.department && (<span>, {c.department}</span>)}</h1>
          <p class="doc-badge">{c.employmentType} &nbsp;|&nbsp; {c.department || c.roleTitle}</p>
        </div>
      </header>

      {/* ---------------------------------------------------------------- 01 OPENING */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-opening">
        <p class="doc-kicker"><span class="doc-kicker__n">01</span></p>
        <h2 class="doc-h2" id="pnl-opening">Dear {(c.candidateName || '').split(' ')[0] || 'Candidate'},</h2>
        <div class="doc-prose">
          <p>{intro} <strong>{c.roleTitle}</strong>{c.department && (<span> within the <strong>{c.department}</strong></span>)} at <strong>EduRankAI</strong>. Following a thorough evaluation of your application and conversations, we are confident you demonstrate the capability, character, and commitment we look for.</p>
        </div>
      </section>

      {/* ---------------------------------------------------------------- 02 THE OFFER */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-offer">
        <p class="doc-kicker"><span class="doc-kicker__n">02</span></p>
        <h2 class="doc-h2" id="pnl-offer">The offer at a glance</h2>
        <div class="doc-grid">
          <div class="fact">
            <p class="fact__k">Duration</p>
            <p class="fact__v">{c.duration || 'TBD'}</p>
          </div>
          <div class="fact">
            <p class="fact__k">Work Mode</p>
            <p class="fact__v">{c.workMode || 'Remote'}</p>
          </div>
          <div class="fact doc-grid__wide">
            <p class="fact__k">Compensation</p>
            <p class="fact__v">{c.compensation || 'TBD'}</p>
          </div>
        </div>
      </section>

      {/* ---------------------------------------------------------------- 03 ENGAGEMENT TERMS */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-terms">
        <p class="doc-kicker"><span class="doc-kicker__n">03</span></p>
        <h2 class="doc-h2" id="pnl-terms">Engagement terms</h2>
        <div class="doc-prose">
          {(offer.templateType === 'intern') && (
            <p>This {c.employmentType} is offered on an <strong>unpaid basis</strong> in accordance with EduRankAI's Internship Policy. You will work <strong>{c.workMode}</strong>, committing <strong>{c.hoursCommitment}</strong> of focused effort. The engagement runs for <strong>{c.duration}</strong>, commencing <strong>{formatDate(c.joiningDate) || 'a mutually agreed date'}</strong>.</p>
          )}
          {(offer.templateType !== 'intern') && (
            <p>This offer is contingent on completion of pre-employment requirements. Your employment commences on <strong>{formatDate(c.joiningDate) || 'a mutually agreed date'}</strong> as a <strong>{c.employmentType}</strong> employee. Onboarding details will be confirmed within 7 days of acceptance.</p>
          )}
        </div>
      </section>

      {/* ---------------------------------------------------------------- 04 REVIEW */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-review">
        <p class="doc-kicker"><span class="doc-kicker__n">04</span></p>
        <h2 class="doc-h2" id="pnl-review">Review and assessment</h2>
        <div class="doc-prose">
          <p>You will receive a mid-point review and final review, assessed via EduRankAI's rubric-based evaluation.</p>
        </div>
      </section>

      {/* ---------------------------------------------------------------- 05 ON COMPLETION */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-completion">
        <p class="doc-kicker"><span class="doc-kicker__n">05</span></p>
        <h2 class="doc-h2" id="pnl-completion">On completion</h2>
        <div class="doc-prose">
          <p>Outstanding performers receive a Letter of Recommendation; all successful completers receive a Certificate of Completion.</p>
        </div>
      </section>

      {/* ---------------------------------------------------------------- 06 POLICIES */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-policy">
        <p class="doc-kicker"><span class="doc-kicker__n">06</span></p>
        <h2 class="doc-h2" id="pnl-policy">Terms you are agreeing to</h2>
        <div class="doc-prose">
          <p>By accepting, you confirm you have read and agree to EduRankAI's Recruitment and Work Policy and Code of Conduct.</p>
          {c.customNote && (<p class="doc-prose__note">{c.customNote}</p>)}
        </div>
      </section>

      {/* The Founder's wellbeing remark is optional. It shows only when the sender opted in on
          this offer. Offers issued before the checkbox existed have no flag, so they keep
          showing it (undefined is not === false) and nothing an applicant already signed changes. */}
      {(c.includeFounderRemark !== false) && (
      <section class="doc-panel doc-panel--quote" data-reveal aria-labelledby="pnl-founder">
        <h2 class="doc-h2" id="pnl-founder">A remark from the Founder</h2>
        <div class="doc-prose">
          <p>Your active contribution hours are fixed in accordance with our policies. Beyond them, we warmly encourage you to devote a further <strong>2.5 hours</strong> each day to staying holistically fit. A sound body and a steady mind are the quiet foundation of exceptional work, and so this practice is regarded as part of your eligibility criteria and is assessed accordingly.</p>
          <p>A gentle rhythm you might follow for that time:</p>
          <ul class="doc-list">
            <li><svg class="doc-list__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg><span>15 to 30 minutes of meditation: the chanting of Aum, the Hare Krishna Mahamantra, or any practice true to your own faith.</span></li>
            <li><svg class="doc-list__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg><span>45 minutes of intensive physical exercise.</span></li>
            <li><svg class="doc-list__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg><span>15 minutes of focused rest.</span></li>
            <li><svg class="doc-list__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg><span>30 minutes with the Srimad Bhagavad Gita, or any scripture that speaks to you.</span></li>
          </ul>
          <p>Why ask for something so personal in a professional letter? Because good health shapes character, and character is what upholds true professional excellence. Consider this an invitation, offered with care. Thank you for your precious time and your kind efforts.</p>
        </div>
      </section>
      )}

      {/* ---------------------------------------------------------------- 07 OFFER SUMMARY */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-summary">
        <p class="doc-kicker"><span class="doc-kicker__n">07</span></p>
        <h2 class="doc-h2" id="pnl-summary">Offer Summary</h2>
        <div class="doc-grid">
          <div class="sum"><p class="sum__k">Position</p><p class="sum__v">{c.roleTitle}</p></div>
          {c.department && (<div class="sum"><p class="sum__k">Department</p><p class="sum__v">{c.department}</p></div>)}
          <div class="sum"><p class="sum__k">Employment Type</p><p class="sum__v">{c.employmentType}</p></div>
          <div class="sum"><p class="sum__k">Work Mode</p><p class="sum__v">{c.workMode}</p></div>
          <div class="sum"><p class="sum__k">Duration</p><p class="sum__v">{c.duration}</p></div>
          {c.joiningDate && (<div class="sum"><p class="sum__k">Joining Date</p><p class="sum__v">{formatDate(c.joiningDate)}</p></div>)}
          {c.reportingTo && (<div class="sum"><p class="sum__k">Reporting To</p><p class="sum__v">{c.reportingTo}</p></div>)}
          {c.hoursCommitment && (<div class="sum"><p class="sum__k">Working Hours</p><p class="sum__v">{c.hoursCommitment}</p></div>)}
          <div class="sum"><p class="sum__k">Compensation</p><p class="sum__v">{c.compensation}</p></div>
          {offer.expiryDate && (<div class="sum"><p class="sum__k">Offer Expires</p><p class="sum__v">{formatDate(offer.expiryDate)}</p></div>)}
          <div class="sum doc-grid__wide"><p class="sum__k">Integrity Hash</p><p class="sum__v sum__v--hash">{offer.integrityHash}</p></div>
        </div>
      </section>

      {/* ---------------------------------------------------------------- 08 AUTHORISATION */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-auth">
        <p class="doc-kicker"><span class="doc-kicker__n">08</span></p>
        <h2 class="doc-h2" id="pnl-auth">Authorisation</h2>
        <div class="doc-sign">
          <div>
            <p class="doc-meta">Issued by EduRankAI &nbsp;|&nbsp; {formatDate(offer.offerDate)}</p>
            <p class="doc-sign__name">{c.signatoryName}</p>
            <p class="doc-meta">{c.signatoryTitle}</p>
            <p class="doc-sign__org">EduRankAI</p>
          </div>
          <div class="doc-seal" aria-hidden="true">
            <span class="doc-seal__t">EDU<br />RANK<br />AI</span>
          </div>
        </div>
      </section>

      {isSigned && offer.signatureDataUrl && (
        <section class="doc-panel" data-reveal aria-labelledby="pnl-accepted">
          <h2 class="doc-h2" id="pnl-accepted">Accepted by Applicant</h2>
          <div class="doc-grid">
            <div class="sum">
              <p class="sum__k">Candidate Signature</p>
              <img src={offer.signatureDataUrl} alt="Signature" class="doc-sigimg" />
              <p class="doc-meta doc-meta--i">Signed: {formatDateTimeIST(offer.signedAt)}</p>
            </div>
            <div class="sum">
              <p class="sum__k">Date of Signing</p>
              <p class="sum__v">{formatDate(offer.signedAt)}</p>
              <p class="doc-meta">By signing, the candidate has accepted this offer and all terms herein.</p>
            </div>
          </div>
        </section>
      )}

      {/* ---------------------------------------------------------------- 09 ACCESS */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-access">
        <p class="doc-kicker"><span class="doc-kicker__n">09</span></p>
        <h2 class="doc-h2" id="pnl-access">Access Credentials</h2>
        {offer.createdUserId ? (
          <div class="doc-access">
            <p class="doc-prose__p">
              Your institutional account is active. Sign in at
              <a href="https://edurankai.in/admin/login" class="doc-link">edurankai.in/admin/login</a>
              using <strong>either</strong> your personal email OR your internal handle &mdash; both work.
            </p>
            <div class="doc-grid">
              <div class="sum sum--card">
                <p class="sum__k">Personal Email</p>
                <p class="sum__v sum__v--mono">{c.candidateEmail || offer.candidateEmail}</p>
              </div>
              <div class="sum sum--card sum--keyed">
                <p class="sum__k">Internal Handle</p>
                <p class="sum__v sum__v--mono">{internalHandle || (c.candidateEmail || offer.candidateEmail)}</p>
              </div>
              <div class="sum sum--card doc-grid__wide">
                <p class="sum__k">Password</p>
                <p class="doc-prose__p">
                  Set or reset your password any time via
                  <a href="/forgot-password" class="doc-link">Set / reset password</a>.
                  For security, we never display a stored password &mdash; you choose your own.
                </p>
              </div>
            </div>
            <p class="doc-meta doc-meta--i"><strong>Note:</strong> These credentials are valid for the entire engagement period. If you applied with an existing account, keep using the password you already set.</p>
          </div>
        ) : (
          <div class="doc-access">
            <p class="doc-meta">Login credentials will be provided after offer acceptance.</p>
          </div>
        )}
      </section>

      {/* ---------------------------------------------------------------- 10 VERIFICATION */}
      <section class="doc-panel" data-reveal aria-labelledby="pnl-verify">
        <p class="doc-kicker"><span class="doc-kicker__n">10</span></p>
        <h2 class="doc-h2" id="pnl-verify">Verification</h2>
        <div class="verify">
          <div class="verify__top">
            {/* A real QR, generated on our own server. This was a literal "QR" placeholder, so the
                verification square on every issued offer was decorative and scanning it did nothing.
                If generation fails the printed URL below is the fallback — it works either way. */}
            <div id="qrCanvasBox" class="qr">
              {verifyQr
                ? <Fragment set:html={verifyQr} />
                : <span class="qr__fallback">QR</span>}
            </div>
            <div class="verify__txt">
              <p class="verify__h">Verify this offer letter</p>
              <p class="doc-meta">Scan the QR or visit:</p>
              <p class="verify__url">{verifyUrl}</p>
            </div>
          </div>
          <div class="doc-grid verify__facts">
            <div class="sum"><p class="sum__k">Reference</p><p class="sum__v sum__v--mono">{offer.refNumber}</p></div>
            <div class="sum"><p class="sum__k">Issued</p><p class="sum__v">{formatDate(offer.offerDate)}</p></div>
            {isSigned && offer.signedAt && (
              <div class="sum"><p class="sum__k">Signed</p><p class="sum__v">{formatDateTimeIST(offer.signedAt)}</p></div>
            )}
            <div class="sum doc-grid__wide"><p class="sum__k">Integrity Hash</p><p class="sum__v sum__v--hash">{offer.integrityHash}</p></div>
          </div>
        </div>
      </section>

      <footer class="doc-close">
        <p class="doc-wordmark doc-wordmark--sm">Edu<em>Rank</em>AI</p>
        <p class="doc-close__meta"><span class="doc-ref doc-ref--sm">{offer.refNumber}</span>{offer.offerDate && (<span> &nbsp;|&nbsp; {formatDate(offer.offerDate)}</span>)}</p>
        <p class="doc-pill">Private and Confidential</p>
      </footer>

    </article>

    {!isAdmin && isAvailable && !isWithdrawn && expiryStatus !== 'expired' && (
      <div class="doc-accept no-print">
        <p class="doc-kicker">Your response</p>
        <h2 class="doc-h2">Accept this offer</h2>
        <p class="doc-accept__lead">Type your full legal name as your signature, confirm that you accept the terms, and click <strong>Accept and Sign</strong>. This is a binding electronic acceptance.</p>

        <form method="POST" id="signForm" class="doc-form">
          <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" />

          <div class="doc-field">
            <label for="typedName" class="doc-label">Your full legal name *</label>
            <input type="text" id="typedName" name="typedName" required minlength="3" maxlength="120"
                   placeholder="e.g. Suhas Puligadda" class="doc-input" />
          </div>

          <div class="doc-sigbox">
            <p class="doc-label">Signature preview</p>
            <div id="sigPreview" class="doc-sigpreview">&nbsp;</div>
          </div>

          <label class="doc-consent">
            <input type="checkbox" id="acceptCheck" name="consent" value="yes" required class="doc-check" />
            <span>I have read this offer, accept all the terms, and confirm that the typed name above is my legal electronic signature. My signature, IP address, and timestamp will be permanently recorded as evidence of acceptance.</span>
          </label>

          <button type="submit" id="signSubmitBtn" class="doc-submit">Accept and Sign Offer</button>
        </form>

        <p class="doc-meta doc-meta--i">Your signature, IP, and timestamp will be recorded as evidence of acceptance.</p>
      </div>
    )}

    {!isAdmin && !isSigned && !isWithdrawn && !isDeclined && (
      <div class="doc-decline no-print">
        <details class="doc-details">
          <summary class="doc-summary">
            <svg class="doc-summary__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            I want to decline this offer
          </summary>
          <form method="POST" class="doc-form doc-form--decline" onsubmit="return confirm('Decline this offer? A 6-month cooling period applies. This cannot be undone.');">
            <input type="hidden" name="action" value="decline" />
            <p class="doc-warn"><strong>Important:</strong> Declining triggers a <strong>6-month cooling period</strong>. You cannot reapply for the same role for 6 months. Your auto-issued account access will be revoked immediately. This cannot be undone.</p>
            <label for="declineReason" class="doc-label">Reason (optional, up to 500 chars)</label>
            <textarea id="declineReason" name="declineReason" rows="3" maxlength="500" placeholder="Help us improve - why are you declining?" class="doc-textarea"></textarea>
            <button type="submit" class="doc-btn doc-btn--decline">Decline this Offer</button>
          </form>
        </details>
      </div>
    )}

    {!isAdmin && isAvailable && expiryStatus !== 'expired' && (
      <p class="doc-thread no-print">
        Questions? <a href={'/portal/applications/' + offer.applicationId} class="doc-link">Use the message thread</a>.
      </p>
    )}

  </section>
  </div>

  <style is:global>
    /* ==========================================================================
       OFFER DOCUMENT — presentation only. Warm paper, near-black ink, saffron
       used strictly as keyline / underline / focus (never behind white text).
       Namespaced under .era-doc (plus the fixed rail) so nothing leaks.
       ========================================================================== */
    .era-doc {
      --paper: #FBF8F3;
      --paper-2: #F4EFE7;
      --ink: #1a1510;
      --ink-2: #2e2520;
      --muted: #5c5349;
      --rule: #ece4d6;
      --accent: #FF4F00;
      --rust: #c2410c;
      --serif: 'Fraunces', 'Cormorant Garamond', Georgia, serif;
      --mono: 'Geist Mono', ui-monospace, SFMono-Regular, monospace;
      --ease-doc: cubic-bezier(0.22, 0.61, 0.36, 1);
      --dur-reveal: 520ms;
      background: var(--paper);
      color: var(--ink);
    }
    .doc-shell {
      max-width: 62rem;
      margin: 0 auto;
      padding: 20px clamp(16px, 5vw, 40px) 64px;
    }
    .era-doc p { margin: 0; }

    /* ---------- reading progress rail (zero JS, scroll-driven CSS) ---------- */
    .doc-rail {
      position: fixed; inset: 0 0 auto 0; height: 3px;
      background: var(--rule, #ece4d6); z-index: 60; pointer-events: none;
    }
    .doc-rail__fill {
      display: block; height: 100%; background: #FF4F00;
      transform: scaleX(0); transform-origin: 0 50%;
    }
    @keyframes doc-rail-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @supports (animation-timeline: scroll(root block)) {
      .doc-rail__fill { animation: doc-rail-fill linear both; animation-timeline: scroll(root block); }
    }
    @supports not (animation-timeline: scroll(root block)) {
      .doc-rail { display: none; }
    }

    /* ---------- entrance motion (CSS only; no JS, never leaves content hidden) ---------- */
    @keyframes doc-reveal {
      from { opacity: 0; transform: translate3d(0, 14px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes doc-rule-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .era-doc [data-reveal] { opacity: 1; }
    @supports (animation-timeline: view()) {
      .era-doc [data-reveal] {
        animation: doc-reveal var(--dur-reveal) var(--ease-doc) both;
        animation-timeline: view();
        /* Ends at "entry 100%" (the moment the panel is fully on screen), NOT at a
           cover percentage. A cover-based end is not always reachable for the last
           panel on a short page, which would leave a clause of a signed document
           permanently half-faded. Every clause must reach full opacity. */
        animation-range: entry 6% entry 100%;
      }
    }

    /* ---------- type ---------- */
    .doc-wordmark {
      font-family: var(--serif); font-weight: 600; letter-spacing: -0.02em;
      font-size: clamp(1.35rem, 4.4vw, 1.7rem); line-height: 1.1; color: var(--ink);
    }
    .doc-wordmark em { font-style: italic; font-weight: 500; color: var(--rust); }
    .doc-wordmark--sm { font-size: 1.15rem; }
    .doc-org { font-size: 0.72rem; color: var(--muted); line-height: 1.6; overflow-wrap: anywhere; }
    .doc-eyebrow {
      font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--muted);
    }
    .doc-kicker {
      display: flex; align-items: center; gap: 10px;
      font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--muted); margin-bottom: 10px;
    }
    .doc-kicker__n { color: var(--rust); font-weight: 500; }
    .doc-kicker__n::after {
      content: ''; display: inline-block; width: 22px; height: 1px;
      background: var(--rule); vertical-align: middle; margin: 0 0 3px 10px;
    }
    .doc-display {
      font-family: var(--serif); font-weight: 300;
      font-size: clamp(2.1rem, 9vw, 4rem); line-height: 1.03; letter-spacing: -0.02em;
      color: var(--ink); overflow-wrap: break-word; hyphens: none;
    }
    .doc-contact { font-size: 0.82rem; color: var(--muted); line-height: 1.7; margin-top: 8px; overflow-wrap: anywhere; }
    .doc-h1 {
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(1.15rem, 3.6vw, 1.6rem); line-height: 1.3; letter-spacing: -0.01em;
      color: var(--ink); margin: 0 0 14px;
    }
    .doc-h1__re { color: var(--muted); font-weight: 400; }
    .doc-h2 {
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(1.3rem, 3.4vw, 1.75rem); line-height: 1.2; letter-spacing: -0.01em;
      color: var(--ink); margin: 0 0 18px;
    }
    .doc-h2::after {
      content: ''; display: block; width: 48px; height: 2px; margin-top: 12px;
      background: var(--accent); transform-origin: 0 50%;
    }
    @supports (animation-timeline: view()) {
      .doc-h2::after {
        animation: doc-rule-draw 620ms var(--ease-doc) both;
        animation-timeline: view(); animation-range: entry 6% entry 100%;
      }
    }
    .doc-prose { max-width: 62ch; }
    .doc-prose p, .doc-prose__p {
      font-size: 1.0625rem; line-height: 1.78; color: var(--ink-2); margin: 0 0 14px;
    }
    .doc-prose p:last-child, .doc-prose__p:last-child { margin-bottom: 0; }
    .doc-prose strong, .doc-prose__p strong { color: var(--ink); font-weight: 600; }
    .doc-prose__note { font-style: italic; }
    .doc-meta { font-size: 0.82rem; line-height: 1.65; color: var(--muted); }
    .doc-meta--i { font-style: italic; margin-top: 10px; }
    .doc-meta strong { color: var(--ink); }
    .doc-link { color: var(--rust); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .doc-link:hover { color: var(--ink); }

    /* ---------- toolbar ---------- */
    .doc-actions {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px; margin-bottom: 18px;
    }
    .doc-back {
      display: inline-flex; align-items: center; gap: 7px;
      font-family: var(--mono); font-size: 0.78rem; color: var(--muted); text-decoration: none;
    }
    .doc-back:hover { color: var(--rust); }
    .doc-back svg { width: 15px; height: 15px; flex: 0 0 auto; }
    .doc-actions__btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .doc-btn {
      display: inline-flex; align-items: center; gap: 7px;
      font: inherit; font-size: 0.8rem; font-weight: 600; line-height: 1;
      padding: 11px 16px; border-radius: 8px; cursor: pointer;
      background: var(--ink); color: #fff; border: 1px solid var(--ink);
      -webkit-appearance: none;
    }
    .doc-btn svg { width: 15px; height: 15px; flex: 0 0 auto; }
    .doc-btn:hover { background: #000; }
    .doc-btn--ghost { background: #fff; color: var(--ink); border-color: var(--rule); }
    .doc-btn--ghost:hover { background: var(--paper-2); }
    .doc-btn:focus-visible, .doc-back:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* ---------- notices ---------- */
    .doc-note {
      display: flex; align-items: flex-start; gap: 12px;
      background: #fff; border: 1px solid var(--rule); border-left: 3px solid var(--accent);
      border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;
    }
    .doc-note__i { width: 19px; height: 19px; flex: 0 0 auto; margin-top: 2px; color: var(--rust); }
    .doc-note p { font-size: 0.9rem; line-height: 1.65; color: var(--ink-2); }
    .doc-note p + p { margin-top: 7px; }
    .doc-note__eyebrow {
      font-size: 0.66rem !important; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--rust) !important; margin-bottom: 5px;
    }
    .doc-note__sm { font-size: 0.82rem !important; }
    .doc-note__quote { font-size: 0.82rem !important; font-style: italic; color: var(--muted) !important; }
    .doc-note--warn { border-left-color: var(--rust); }
    .doc-note--ok .doc-note__i { color: var(--ink); }
    .doc-note--time { border-left-color: var(--accent); }
    .doc-cta {
      display: inline-block; margin-top: 12px; background: var(--ink); color: #fff;
      border-radius: 8px; padding: 11px 20px; font-size: 0.85rem; font-weight: 700;
      text-decoration: none; border-bottom: 3px solid var(--accent);
    }
    .doc-cta:hover { background: #000; }
    .doc-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* ---------- the document ---------- */
    .doc-paper {
      background: #fff; border: 1px solid var(--rule); border-radius: 16px;
      margin-bottom: 22px; box-shadow: 0 1px 2px rgba(26, 21, 16, 0.04);
    }
    .doc-cover {
      background: var(--paper-2); border-bottom: 1px solid var(--rule);
      border-radius: 15px 15px 0 0;
      padding: clamp(22px, 6vw, 44px) clamp(18px, 5vw, 48px) clamp(28px, 7vw, 52px);
    }
    .doc-cover__top {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 18px; flex-wrap: wrap; padding-bottom: clamp(24px, 6vw, 44px);
      border-bottom: 1px solid var(--rule);
    }
    .doc-cover__ref { text-align: left; }
    @media (min-width: 560px) { .doc-cover__ref { text-align: right; } }
    .doc-ref {
      font-family: var(--mono); font-size: 0.95rem; letter-spacing: 0.04em;
      color: var(--ink); margin-top: 5px; overflow-wrap: anywhere;
    }
    .doc-ref--sm { font-size: 0.8rem; }
    .doc-pill {
      display: inline-block; margin-top: 9px; padding: 3px 9px;
      font-size: 0.58rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--rust); border: 1px solid var(--rule); border-radius: 4px; background: #fff;
    }
    .doc-cover__body { padding-top: clamp(26px, 7vw, 48px); }
    .doc-recipient { margin-bottom: 20px; }
    .doc-cover__rule {
      display: block; width: 180px; max-width: 60%; height: 2px;
      background: var(--accent); transform-origin: 0 50%; margin: 0 0 20px;
    }
    @supports (animation-timeline: view()) {
      .doc-cover__rule { animation: doc-rule-draw 620ms var(--ease-doc) 380ms both; }
    }
    .doc-badge {
      display: inline-block; padding: 6px 12px; background: #fff;
      border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 4px;
      font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--ink);
    }
    .doc-panel {
      padding: clamp(26px, 6.5vw, 48px) clamp(18px, 5vw, 48px);
      border-top: 1px solid var(--rule);
    }
    .doc-panel:first-of-type { border-top: 0; }
    .doc-panel--quote { background: var(--paper-2); }

    /* ---------- fact / summary card grid (1 col phone, 2 cols from 560px) ---------- */
    .doc-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    @media (min-width: 560px) { .doc-grid { grid-template-columns: 1fr 1fr; } }
    .doc-grid__wide { grid-column: 1 / -1; }
    .fact {
      background: var(--paper); border: 1px solid var(--rule);
      border-left: 3px solid var(--accent); border-radius: 10px; padding: 16px 18px;
    }
    .fact__k {
      font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--muted); margin-bottom: 7px;
    }
    .fact__v {
      font-family: var(--serif); font-weight: 500; font-size: 1.28rem;
      line-height: 1.25; color: var(--ink); overflow-wrap: anywhere;
    }
    .sum { border: 1px solid var(--rule); border-radius: 10px; padding: 14px 16px; background: #fff; }
    .sum--card { background: var(--paper); }
    .sum--keyed { border-left: 3px solid var(--accent); }
    .sum__k {
      font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--muted); margin-bottom: 6px;
    }
    .sum__v { font-size: 0.95rem; font-weight: 600; color: var(--ink); line-height: 1.55; overflow-wrap: anywhere; }
    .sum__v--mono { font-family: var(--mono); font-weight: 400; font-size: 0.85rem; -webkit-user-select: all; user-select: all; }
    .sum__v--hash { font-family: var(--mono); font-weight: 400; font-size: 0.8rem; color: var(--rust); word-break: break-all; }

    /* ---------- founder list ---------- */
    .doc-list { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 9px; }
    .doc-list li { display: flex; gap: 10px; font-size: 1rem; line-height: 1.7; color: var(--ink-2); }
    .doc-list__i { width: 16px; height: 16px; flex: 0 0 auto; margin-top: 5px; color: var(--rust); }

    /* ---------- authorisation ---------- */
    .doc-sign { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
    .doc-sign__name {
      font-family: var(--serif); font-weight: 600; font-size: 1.15rem;
      color: var(--ink); line-height: 1.3; margin-top: 10px;
    }
    .doc-sign__org { font-size: 0.82rem; font-weight: 700; color: var(--rust); margin-top: 4px; }
    .doc-seal {
      width: 62px; height: 62px; flex: 0 0 auto; border-radius: 50%;
      border: 1.5px solid var(--ink); background: var(--paper-2);
      display: flex; align-items: center; justify-content: center;
      box-shadow: inset 0 0 0 3px #fff, inset 0 0 0 4.5px var(--accent);
    }
    .doc-seal__t {
      font-size: 0.44rem; font-weight: 700; letter-spacing: 0.06em;
      text-align: center; line-height: 1.25; color: var(--ink);
    }
    .doc-sigimg {
      max-height: 80px; max-width: 100%; background: #fff;
      border: 1px solid var(--rule); border-radius: 6px; padding: 4px; display: block;
    }

    /* ---------- access ---------- */
    .doc-access {
      background: var(--paper-2); border: 1px solid var(--rule);
      border-radius: 12px; padding: clamp(16px, 4vw, 22px);
    }
    .doc-access .doc-grid { margin-top: 14px; }
    .doc-access .doc-link { margin: 0 4px; overflow-wrap: anywhere; }
    .sum .doc-prose__p { font-size: 0.88rem; line-height: 1.68; color: var(--ink-2); }

    /* ---------- verification ---------- */
    .verify {
      background: var(--paper-2); border: 1px solid var(--rule);
      border-radius: 12px; padding: clamp(16px, 4vw, 24px);
    }
    .verify__top { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
    .qr {
      width: 112px; height: 112px; flex: 0 0 auto; background: #fff;
      border: 1px solid var(--rule); border-radius: 6px; padding: 6px;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .qr svg { width: 100%; height: 100%; display: block; }
    .qr__fallback { font-size: 0.6rem; color: var(--muted); }
    .verify__txt { flex: 1 1 220px; min-width: 0; }
    .verify__h { font-family: var(--serif); font-weight: 600; font-size: 1.05rem; color: var(--ink); margin-bottom: 4px; }
    .verify__url {
      font-family: var(--mono); font-size: 0.82rem; color: var(--rust);
      word-break: break-all; margin-top: 4px;
    }
    .verify__facts { margin-top: 16px; }

    /* ---------- closing band ---------- */
    .doc-close {
      border-top: 1px solid var(--rule); background: var(--paper-2);
      border-radius: 0 0 15px 15px; padding: clamp(20px, 5vw, 32px) clamp(18px, 5vw, 48px);
      text-align: center;
    }
    .doc-close__meta { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin-top: 8px; overflow-wrap: anywhere; }
    .doc-close .doc-pill { margin-top: 12px; }

    /* ---------- acceptance ---------- */
    .doc-accept {
      background: #fff; border: 1px solid var(--rule); border-top: 3px solid var(--accent);
      border-radius: 14px; padding: clamp(20px, 5vw, 32px); margin-bottom: 18px;
    }
    .doc-accept__lead { font-size: 0.95rem; line-height: 1.7; color: var(--ink-2); margin-bottom: 20px; max-width: 62ch; }
    .doc-accept__lead strong { color: var(--ink); }
    .doc-form { display: flex; flex-direction: column; gap: 14px; }
    .doc-label {
      display: block; font-size: 0.66rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.12em; color: var(--muted); margin-bottom: 7px;
    }
    .doc-input, .doc-textarea {
      width: 100%; box-sizing: border-box; padding: 12px 14px; background: #fff;
      border: 1px solid var(--rule); border-bottom: 2px solid var(--muted); border-radius: 8px;
      font-family: inherit; font-size: 1rem; color: var(--ink);
      outline: none; -webkit-appearance: none;
    }
    .doc-input:focus-visible, .doc-textarea:focus-visible, .doc-check:focus-visible,
    .doc-submit:focus-visible, .doc-summary:focus-visible, .doc-link:focus-visible, .doc-cta:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px;
    }
    .doc-textarea { resize: vertical; font-size: 0.92rem; border-bottom-width: 1px; }
    .doc-sigbox { background: var(--paper); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 12px; }
    .doc-sigpreview {
      min-height: 50px; font-family: 'Brush Script MT', 'Lucida Handwriting', cursive;
      font-size: 30px; font-style: italic; color: var(--ink);
      border-bottom: 1.5px solid var(--rule); padding: 4px 0; text-align: center;
      overflow-wrap: anywhere;
    }
    .doc-consent {
      display: flex; align-items: flex-start; gap: 11px; padding: 13px;
      background: var(--paper); border: 1px solid var(--rule); border-radius: 8px;
      cursor: pointer; font-size: 0.85rem; line-height: 1.6; color: var(--ink-2);
    }
    .doc-check { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; accent-color: #FF4F00; }
    .doc-submit {
      background: var(--ink); border: none; border-bottom: 3px solid var(--accent);
      color: #fff; font-family: inherit; font-weight: 700; font-size: 0.98rem;
      padding: 15px; border-radius: 8px; cursor: pointer; -webkit-appearance: none;
    }
    .doc-submit:hover { background: #000; }

    /* ---------- decline ---------- */
    .doc-decline { margin-top: 4px; margin-bottom: 18px; }
    .doc-details { background: #fff; border: 1px solid var(--rule); border-radius: 12px; padding: 6px 14px; }
    .doc-summary {
      display: flex; align-items: center; gap: 8px; list-style: none;
      font-size: 0.88rem; font-weight: 600; color: var(--ink-2);
      cursor: pointer; padding: 12px 2px; min-height: 44px; box-sizing: border-box;
    }
    .doc-summary::-webkit-details-marker { display: none; }
    .doc-summary__i { width: 16px; height: 16px; flex: 0 0 auto; color: var(--rust); transition: transform 180ms cubic-bezier(0.4, 0, 0.2, 1); }
    .doc-details[open] .doc-summary__i { transform: rotate(180deg); }
    .doc-form--decline { padding: 4px 2px 14px; }
    .doc-warn {
      font-size: 0.82rem; line-height: 1.7; color: var(--ink-2);
      background: var(--paper-2); border: 1px solid var(--rule);
      border-left: 3px solid var(--rust); border-radius: 8px; padding: 12px;
    }
    .doc-warn strong { color: var(--rust); }
    .doc-btn--decline {
      align-self: flex-start; background: #fff; color: var(--rust);
      border: 1px solid var(--rust); border-radius: 8px; padding: 12px 20px; font-size: 0.86rem;
    }
    .doc-btn--decline:hover { background: var(--paper-2); }
    .doc-thread { font-size: 0.82rem; color: var(--muted); text-align: center; }

    /* ---------- reduced motion: nothing animates, nothing stays hidden ---------- */
    @media (prefers-reduced-motion: reduce) {
      .era-doc *, .era-doc *::before, .era-doc *::after,
      .doc-rail, .doc-rail__fill {
        animation: none !important;
        transition: none !important;
      }
      .era-doc [data-reveal] { opacity: 1 !important; transform: none !important; }
      .doc-h2::after, .doc-cover__rule { transform: none !important; opacity: 1 !important; }
      .doc-rail__fill { transform: scaleX(1) !important; }
      html { scroll-behavior: auto; }
    }

    @media print {
      /* Isolate ONLY the offer letter: hide every other element (site nav,
         floating SOS/Report/chat buttons, toolbars, progress rail, sign form,
         banners) so the printed / saved-as-PDF output is just the clean letter. */
      body { background: #fff !important; }
      body * { visibility: hidden !important; }
      #offerLetter, #offerLetter * { visibility: visible !important; }
      #offerLetter {
        position: absolute !important; left: 0 !important; top: 0 !important;
        width: 100% !important; max-width: 100% !important; margin: 0 !important;
        box-shadow: none !important; border: none !important; border-radius: 0 !important;
      }
      /* Force background colours/ink to render - browsers strip backgrounds in print. */
      #offerLetter, #offerLetter * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      /* Navigation, actions and the progress rail never print. */
      .no-print, .doc-rail, .doc-actions { display: none !important; }
      /* A half-revealed panel would print blank. Non-negotiable. */
      .era-doc [data-reveal], .doc-h2::after, .doc-cover__rule {
        animation: none !important; transition: none !important;
        opacity: 1 !important; transform: none !important;
      }
      /* Keep a panel whole on one page. */
      #offerLetter .doc-cover,
      #offerLetter .doc-panel,
      #offerLetter .doc-close,
      #offerLetter .fact,
      #offerLetter .sum,
      #offerLetter .verify,
      #offerLetter .doc-sign,
      #offerLetter li { break-inside: avoid; page-break-inside: avoid; }
      #offerLetter h1, #offerLetter h2, #offerLetter .doc-kicker { break-after: avoid-page; page-break-after: avoid; }
      #offerLetter p { orphans: 3; widows: 3; }
      #offerLetter .doc-cover, #offerLetter .doc-close { border-radius: 0 !important; }
      /* THE QR MUST SURVIVE PRINT: >= 30mm, black on white, crisp module edges. */
      #qrCanvasBox {
        width: 34mm !important; height: 34mm !important;
        background: #fff !important; border: none !important; padding: 2mm !important;
        image-rendering: crisp-edges;
      }
      #qrCanvasBox svg { width: 100% !important; height: 100% !important; shape-rendering: crispEdges; }
      .verify__url, .sum__v--hash { color: #000 !important; }
      @page { size: A4; margin: 12mm; }
    }
  </style>

  <script is:inline src="/era/era-qr.js"></script>
  <script is:inline src="/era/era-offer-pdf.js"></script>

  <script is:inline define:vars={{ verifyUrl: verifyUrl, isAvailable: isAvailable, isAdmin: isAdmin, offerPdfData: offerPdfData }}>
    // QR rendering
    setTimeout(function() {
      var qrBox = document.getElementById('qrCanvasBox');
      if (qrBox && typeof QRCode !== 'undefined') {
        var cv = document.createElement('canvas');
        cv.width = 64; cv.height = 64;
        QRCode.toCanvas(cv, verifyUrl, { width: 64, margin: 0, color: { dark: '#0C0C0C', light: '#FFFFFF' } }, function(err) {
          if (!err) {
            qrBox.innerHTML = '';
            qrBox.appendChild(cv);
          }
        });
      }
    }, 200);

    // Typed-name signature (Safari-friendly, no canvas drawing)
    var typedNameInput = document.getElementById('typedName');
    var sigPreview = document.getElementById('sigPreview');
    var acceptCheck = document.getElementById('acceptCheck');
    var sigForm = document.getElementById('signForm');
    var sigDataInput = document.getElementById('signatureDataUrl');

    function renderPreview() {
      if (!typedNameInput || !sigPreview) return;
      var v = typedNameInput.value.trim();
      sigPreview.textContent = v || '\u00a0';
    }

    if (typedNameInput) {
      typedNameInput.addEventListener('input', renderPreview);
      typedNameInput.addEventListener('change', renderPreview);
    }

    function nameToSignatureImage(name) {
      // Render the typed name as a cursive PNG image in-memory (no user drawing needed)
      var c = document.createElement('canvas');
      c.width = 600;
      c.height = 140;
      var cx = c.getContext('2d');
      cx.fillStyle = '#ffffff';
      cx.fillRect(0, 0, c.width, c.height);
      cx.fillStyle = '#0a0a0c';
      cx.font = 'italic 56px "Brush Script MT", "Lucida Handwriting", cursive';
      cx.textAlign = 'center';
      cx.textBaseline = 'middle';
      cx.fillText(name, c.width / 2, c.height / 2);
      return c.toDataURL('image/png');
    }

    if (sigForm && isAvailable && !isAdmin) {
      sigForm.addEventListener('submit', function(e) {
        var name = (typedNameInput ? typedNameInput.value : '').trim();
        if (!name || name.length < 3) {
          e.preventDefault();
          alert('Please type your full legal name (at least 3 characters).');
          if (typedNameInput) typedNameInput.focus();
          return false;
        }
        if (acceptCheck && !acceptCheck.checked) {
          e.preventDefault();
          alert('Please tick the acceptance checkbox.');
          return false;
        }
        try {
          sigDataInput.value = nameToSignatureImage(name);
        } catch (err) {
          // If canvas/toDataURL fails for any reason on Safari, fall back to a safer text-only data URL
          sigDataInput.value = 'data:image/svg+xml;utf8,' + encodeURIComponent(
            '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="140"><rect width="100%" height="100%" fill="#fff"/><text x="50%" y="50%" font-family="cursive" font-style="italic" font-size="56" text-anchor="middle" dominant-baseline="middle" fill="#0a0a0c">' +
            name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') +
            '</text></svg>'
          );
        }
      });
    }

    // Download PDF - one click, direct download, our own generator (no external
    // library). Falls back to native print if the generator is unavailable.
    var dlBtn = document.getElementById('downloadPdfBtn');
    if (dlBtn) dlBtn.addEventListener('click', function() {
      var fname = 'EduRankAI-Offer-' + ((offerPdfData.candidateName || 'Letter').replace(/[^a-zA-Z0-9]/g, '')) + '.pdf';
      if (window.EraOfferPdf && window.EraOfferPdf.download(offerPdfData, fname)) return;
      window.print();
    });
  </script>

</BaseLayout>
