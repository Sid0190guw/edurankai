---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { sql } from 'drizzle-orm';
import {
  ensureFeedSchema, rows, dbReason,
  likePost, addComment, listComments, recordShare, toggleSave, savedPostIds,
} from '@/lib/feed';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=/portal/feed');

// ---------------- Bootstrap schema (once per process, and it reports failure) ----------------
// Six CREATE TABLE statements used to run on EVERY load of this page inside one `catch (e) {}`.
// They are in src/lib/feed.ts now, behind a once-per-process guard, and a boot failure reaches the
// page as a sentence instead of rendering an empty feed that looks like a quiet one.
const schemaBoot = await ensureFeedSchema();

// ---------------- AR filter catalogue ----------------
// The presets are a real, idempotent seed of a real table: the AR tray renders one card per row and
// the camera routines are keyed by slug, so a missing row means a missing filter.
//
// THE DESCRIPTIONS BELOW NOW DESCRIBE WHAT THE CODE IN THIS FILE ACTUALLY DOES. Two of them did
// not. "Hand Trail" was described as a "particle trail following motion regions" and its
// implementation pushes particles at Math.random() * width, Math.random() * height every frame —
// its own comment admits there is no motion detection. "Anatomy Overlay" was described as "skull
// and facial muscle landmarks projected on the camera" and it draws an ellipse and dots at fixed
// fractions of the canvas with no face detection of any kind. Naming a drawing a detection is how a
// learner comes to believe a camera is tracking their face when nothing is.
try {
  const f = rows(await db.execute(sql`SELECT COUNT(*)::int AS n FROM ar_filters`));
  if ((f[0]?.n ?? 0) === 0) {
    const presets = [
      ['soft-glow', 'Soft Glow', 'face', 'Gentle Gaussian halo over the whole frame'],
      ['threshold', 'Ink Stamp', 'face', 'Binary high-contrast etching of the visible scene'],
      ['rgb-shift', 'Chroma Drift', 'face', 'Channel separation effect with R/G/B offset'],
      ['anatomy', 'Anatomy Overlay', 'educational-overlay', 'Decorative skull-and-muscle diagram drawn at a fixed position — it does not detect or track a face'],
      ['math-notation', 'Math Notation', 'educational-overlay', 'Equation grid and coordinate axes drawn over the frame'],
      ['molecule', 'Molecule Halo', 'educational-overlay', 'Ball-and-stick caffeine molecule orbiting the centre of the frame'],
      ['hand-trail', 'Hand Trail', 'hand', 'Decorative particle trail — it is not driven by hand or motion tracking'],
      ['world-grid', 'World Grid', 'world', 'Perspective grid drawn over the lower half of the frame'],
      ['polar-warp', 'Polar Warp', 'face', 'Radial coordinate warp around the centre'],
      ['edge-find', 'Edge Find', 'face', 'Sobel edge detection in cyan'],
    ];
    for (const p of presets) {
      await db.execute(sql`
        INSERT INTO ar_filters (slug, name, kind, code, creator_user_id)
        VALUES (${p[0]}, ${p[1]}, ${p[2]}, ${p[3]}, ${user.id})
        ON CONFLICT (slug) DO NOTHING
      `);
    }
  }
} catch (e: any) {
  console.error('[feed] ar_filters seed failed:', dbReason(e));
}

// ---------------- THE 23 POSTS THAT WERE NOT REAL ----------------
//
// REMOVED, DELIBERATELY, AND NOT REPLACED. The first time any signed-in person opened this page on
// an empty table, it INSERTed 12 reels, 8 clips and 3 XR experiences from literal arrays — with
// view counts of 18,400 / 31,200 / 142,000 and like counts in the thousands, all typed into this
// file — and set author_user_id to THAT PERSON. Whoever opened the feed first became the credited
// author of 23 lectures they never made, with fabricated engagement, and no media behind any of
// them: media_url was never written, and the "thumbnail" is a canvas gradient keyed on the array
// index.
//
// The feed has a real writer (the Publish composer below, action=create_post) and real readers, so
// an empty feed is now simply an empty feed, and it says so.

// ---------------- Load user interests (or default) ----------------
let interests: string[] = [];
let follows: string[] = [];
let dailyCap = 90;
try {
  const r = rows(await db.execute(sql`
    SELECT interests, follows, daily_cap_minutes FROM feed_user_interests WHERE user_id = ${user.id}
  `));
  if (r[0]) {
    interests = Array.isArray(r[0].interests) ? r[0].interests : (typeof r[0].interests === 'string' ? JSON.parse(r[0].interests) : []);
    follows = Array.isArray(r[0].follows) ? r[0].follows : (typeof r[0].follows === 'string' ? JSON.parse(r[0].follows) : []);
    dailyCap = r[0].daily_cap_minutes ?? 90;
  } else {
    interests = ['math','physics','ai','chemistry'];
    await db.execute(sql`
      INSERT INTO feed_user_interests (user_id, interests, follows)
      VALUES (${user.id}, ${JSON.stringify(interests)}::jsonb, '[]'::jsonb)
      ON CONFLICT (user_id) DO NOTHING
    `);
  }
} catch (e) {}

// ---------------- View + AR-filter-use logging (JSON) ----------------
//
// THE WRITER THAT WAS NEVER BUILT. An IntersectionObserver at the bottom of this page has always
// POSTed each reel view to /api/feed-view — a route that does not exist in this repository — with
// `.catch(() => {})` hiding the 404. feed_view_events is CREATEd above and was INSERTed into by
// nothing, and TWO things read it:
//   * minutesToday / capReached, the daily watch-time cap. It could never fire. The wellbeing meter
//     read "0m / 90m today" for every reader forever and the "take a walk" banner was unreachable.
//   * seenSet, the de-ranking term in scorePost(). Always empty, so the recommender silently lost
//     one of its inputs and could keep resurfacing the same reel.
// A stated wellbeing control that cannot fire is worse than no control, because the number beside
// it looks measured.
//
// The handler lives on this page rather than under src/pages/api/ because the page already owns
// every other write in this feature (like, create_post, save_interests), and a second surface is a
// second place for the shapes to drift. The client contract is unchanged — the same JSON body it
// has always sent — only the URL moves here.
//
// ONE ROW PER USER, PER POST, PER DAY. Without that guard a reader reloading the page inflates
// their own watch total until the cap trips; with it, the cap counts distinct posts seen today.
if (
  Astro.request.method === 'POST' &&
  (Astro.request.headers.get('content-type') || '').includes('application/json')
) {
  const jsonOut = (payload: any, status: number) =>
    new Response(JSON.stringify(payload), { status, headers: { 'content-type': 'application/json' } });
  let body: any = null;
  try { body = await Astro.request.json(); } catch (_) { body = null; }

  const postId = String(body?.post_id || '');
  const filterSlug = String(body?.filter_slug || '');

  try {
    // THE THREE CONTROLS THAT USED TO DO NOTHING AT ALL.
    //
    // The comment, share and bookmark buttons on every reel had no id, no data attribute, no class
    // any script read and no handler — tapping one was indistinguishable from tapping the
    // background — while each carried a count taken from the seed literals. These are their
    // writers. Each returns the number that is now stored, so the button shows a real figure.
    const act = String(body?.act || '');
    if (act) {
      const target = String(body?.post_id_target || '');
      if (!/^[0-9a-fA-F-]{36}$/.test(target)) return jsonOut({ ok: false, error: 'bad post id' }, 400);
      if (act === 'comment') {
        const r = await addComment(target, user.id, String(body?.body || ''));
        return r.ok ? jsonOut({ ok: true, count: r.rows.count }, 200) : jsonOut({ ok: false, error: r.error }, 400);
      }
      if (act === 'share') {
        const r = await recordShare(target);
        return r.ok ? jsonOut({ ok: true, count: r.rows.count }, 200) : jsonOut({ ok: false, error: r.error }, 400);
      }
      if (act === 'save') {
        const r = await toggleSave(target, user.id);
        return r.ok ? jsonOut({ ok: true, saved: r.rows.saved }, 200) : jsonOut({ ok: false, error: r.error }, 400);
      }
      if (act === 'like') {
        const r = await likePost(target, user.id);
        return r.ok ? jsonOut({ ok: true, count: r.rows.count, liked: r.rows.liked }, 200) : jsonOut({ ok: false, error: r.error }, 400);
      }
      return jsonOut({ ok: false, error: 'unknown action' }, 400);
    }

    if (postId) {
      if (!/^[0-9a-fA-F-]{36}$/.test(postId)) return jsonOut({ ok: false, error: 'bad post id' }, 400);
      const pct = Math.max(0, Math.min(100, Math.round(Number(body?.watched_pct) || 0)));
      const device = String(body?.device || 'web').slice(0, 20);
      await db.execute(sql`
        INSERT INTO feed_view_events (user_id, post_id, watched_pct, device)
        SELECT ${user.id}, ${postId}::uuid, ${pct}, ${device}
         WHERE NOT EXISTS (
           SELECT 1 FROM feed_view_events
            WHERE user_id = ${user.id} AND post_id = ${postId}::uuid AND created_at >= CURRENT_DATE
         )
      `);
      return jsonOut({ ok: true }, 200);
    }
    if (filterSlug) {
      // The AR tray orders by use_count and nothing ever incremented it, so a tray presenting itself
      // as usage-ranked was permanently alphabetical. This is that increment.
      await db.execute(sql`
        UPDATE ar_filters SET use_count = COALESCE(use_count, 0) + 1 WHERE slug = ${filterSlug.slice(0, 120)}
      `);
      return jsonOut({ ok: true }, 200);
    }
    return jsonOut({ ok: false, error: 'nothing to record' }, 400);
  } catch (e: any) {
    return jsonOut({ ok: false, error: String(e?.cause?.message || e?.message || 'failed').slice(0, 160) }, 500);
  }
}

// ---------------- Handle POST ----------------
let okMsg = '', errMsg = '';
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get('action') || '');
    if (action === 'create_post') {
      const kind = String(form.get('kind') || 'reel');
      const title = String(form.get('title') || '').slice(0, 280);
      const description = String(form.get('description') || '').slice(0, 2000);
      const tagsRaw = String(form.get('tags') || '');
      const visibility = String(form.get('visibility') || 'public');
      const tags = tagsRaw.split(',').map(t => t.trim().toLowerCase()).filter(Boolean).slice(0, 12);
      // The link and the length the author actually typed, stored in the columns that were
      // declared for them and never written.
      const mediaUrlRaw = String(form.get('media_url') || '').trim().slice(0, 2000);
      const mediaUrl = /^https?:\/\//i.test(mediaUrlRaw) ? mediaUrlRaw : null;
      const durRaw = parseInt(String(form.get('duration_seconds') || ''), 10);
      const duration = Number.isFinite(durRaw) && durRaw > 0 ? Math.min(86400, durRaw) : null;
      if (!title) { errMsg = 'Title is required'; }
      else if (mediaUrlRaw && !mediaUrl) { errMsg = 'The link must start with http:// or https://. Nothing was published.'; }
      else {
        const created = rows(await db.execute(sql`
          INSERT INTO feed_posts (author_user_id, kind, title, description, topic_tags, visibility, media_url, duration_seconds)
          VALUES (${user.id}, ${kind}, ${title}, ${description}, ${JSON.stringify(tags)}::jsonb, ${visibility}, ${mediaUrl}, ${duration})
          RETURNING id
        `));
        okMsg = created.length > 0
          ? 'Published' + (mediaUrl ? '.' : ' — with no link attached, so the card will say there is no recording behind it.')
          : '';
        if (created.length === 0) errMsg = 'The post was not stored (the database returned no row). Nothing was published.';
      }
    } else if (action === 'save_interests') {
      const raw = String(form.get('interests') || '');
      const list = raw.split(',').map(s => s.trim().toLowerCase()).filter(Boolean).slice(0, 30);
      await db.execute(sql`
        INSERT INTO feed_user_interests (user_id, interests, updated_at)
        VALUES (${user.id}, ${JSON.stringify(list)}::jsonb, NOW())
        ON CONFLICT (user_id) DO UPDATE SET interests = EXCLUDED.interests, updated_at = NOW()
      `);
      interests = list;
      okMsg = 'Interests saved';
    } else if (action === 'like') {
      // Goes through likePost(), which increments only when a like row was really inserted. The
      // statement here used to add 1 to like_count on every press, including the presses the
      // ON CONFLICT threw away — so a reader who tapped twice inflated the number by one.
      const postId = String(form.get('post_id') || '');
      if (postId) {
        const r = await likePost(postId, user.id);
        if (!r.ok) errMsg = 'Your like was not recorded: ' + r.error;
      }
    }
  } catch (e: any) {
    // e.message from postgres-js is the failed SQL. The reason is on e.cause.
    errMsg = 'That did not save: ' + dbReason(e);
    console.error('[feed] POST failed:', dbReason(e));
  }
}

// ---------------- Fetch posts ----------------
// EVERY READ BELOW REPORTS ITS FAILURE. A feed that renders "no reels yet" because the query threw
// is the same picture as a feed nobody has posted to, and this page shipped exactly that picture
// for 23 posts' worth of invented content.
let allPosts: any[] = [];
let feedReadError = '';
try {
  allPosts = rows(await db.execute(sql`
    SELECT id, author_user_id, kind, title, description, topic_tags, media_url, duration_seconds,
           view_count, like_count, comment_count, share_count, engagement_score, created_at
    FROM feed_posts ORDER BY created_at DESC LIMIT 200
  `));
} catch (e: any) {
  feedReadError = dbReason(e);
  console.error('[feed] post read failed:', feedReadError);
}

// ---------------- Seen post ids today ----------------
let seenRows: any[] = [];
try {
  seenRows = rows(await db.execute(sql`
    SELECT DISTINCT post_id FROM feed_view_events WHERE user_id = ${user.id} AND created_at > NOW() - INTERVAL '7 days'
  `));
} catch (e: any) { console.error('[feed] seen read failed:', dbReason(e)); }
const seenSet = new Set(seenRows.map((r: any) => r.post_id));

// ---------------- Watched-time today ----------------
let watchRow: any[] = [];
let watchReadFailed = false;
try {
  watchRow = rows(await db.execute(sql`
    SELECT COALESCE(SUM(watched_pct), 0)::int AS pct_sum
    FROM feed_view_events WHERE user_id = ${user.id} AND created_at >= CURRENT_DATE
  `));
} catch (e: any) {
  watchReadFailed = true;
  console.error('[feed] watch-time read failed:', dbReason(e));
}
const pctSumToday = watchRow[0]?.pct_sum || 0;
// Rough: assume avg post is 45s, watched_pct of 100 = 45s watched. So minutes ~ pct_sum/100 * 45 / 60
const minutesToday = Math.floor((pctSumToday / 100) * 45 / 60);
const watchPct = Math.min(100, Math.floor((minutesToday / dailyCap) * 100));
const capReached = minutesToday >= dailyCap;

// ---------------- Hand-rolled recommendation scoring ----------------
function jaccard(a: string[], b: string[]) {
  if (!a.length || !b.length) return 0;
  const sa = new Set(a), sb = new Set(b);
  let inter = 0;
  sa.forEach(x => { if (sb.has(x)) inter++; });
  const uni = new Set([...a, ...b]).size;
  return uni === 0 ? 0 : inter / uni;
}
function scorePost(p: any) {
  const tags = Array.isArray(p.topic_tags) ? p.topic_tags : (typeof p.topic_tags === 'string' ? JSON.parse(p.topic_tags || '[]') : []);
  const created = new Date(p.created_at).getTime();
  const ageDays = (Date.now() - created) / (1000 * 60 * 60 * 24);
  const recency = ageDays < 7 ? 1 : 0.5;
  const tm = jaccard(tags, interests);
  const authorFollowed = follows.includes(p.author_user_id) ? 0.3 : 0;
  const seen = seenSet.has(p.id) ? 1.5 : 0;
  const score =
    Math.log((p.view_count || 0) + 1) * 0.4 +
    Math.log((p.like_count || 0) + 1) * 0.3 +
    recency +
    tm * 0.5 +
    authorFollowed -
    seen;
  return { score: Math.round(score * 100) / 100, tags, recency, tm, authorFollowed, seen };
}
const scored = allPosts.map((p: any) => ({ ...p, ...scorePost(p) }));
scored.sort((a: any, b: any) => b.score - a.score);

const reels = scored.filter((p: any) => p.kind === 'reel').slice(0, 20);
const clips = scored.filter((p: any) => p.kind === 'clip').slice(0, 20);
const xrPosts = scored.filter((p: any) => p.kind === 'xr-experience').slice(0, 20);

// ---------------- AR filters ----------------
let filters: any[] = [];
let filtersReadError = '';
try {
  filters = rows(await db.execute(sql`
    SELECT id, slug, name, kind, code, use_count FROM ar_filters ORDER BY use_count DESC, name ASC LIMIT 24
  `));
} catch (e: any) {
  filtersReadError = dbReason(e);
  console.error('[feed] ar_filters read failed:', filtersReadError);
}

// ---------------- Comments, and what this reader has saved ----------------
// Both tables exist; neither had a reader. feed_comments was created and never selected from, and
// there was no bookmark table at all, so the two counts under every reel were seed literals.
const visibleIds: string[] = [...reels, ...clips, ...xrPosts].map((p: any) => String(p.id));
const commentsRead = await listComments(visibleIds);
const commentsByPost: Record<string, any[]> = commentsRead.ok ? commentsRead.rows : {};
const savesRead = await savedPostIds(user.id);
const savedSet = new Set(savesRead.ok ? savesRead.rows : []);

// Topic options for the clips filter, taken from the tags actually present on the clips on screen.
// The dropdown used to offer a hardcoded seven-topic list, so it could filter to a topic no clip
// carried, and could not offer one that every clip carried.
const clipTopics = Array.from(new Set(
  clips.flatMap((c: any) => (Array.isArray(c.tags) ? c.tags : []) as string[])
)).sort().slice(0, 40);

const safeReels = JSON.stringify(reels);
const safeClips = JSON.stringify(clips);
const safeXr = JSON.stringify(xrPosts);
const safeFilters = JSON.stringify(filters);
const safeInterests = JSON.stringify(interests);
---
<BaseLayout title="Feed - EduRankAI" description="Student media feed with reels, clips and AR experiences">
<style>
  body { background: #0a0a0c !important; color: #e8e8ee !important; }
  body.era-has-fab { padding-bottom: 0 !important; }
  .feed-root { min-height: 100vh; background: #0a0a0c; color: #e8e8ee; font-family: 'Cormorant Garamond', Georgia, serif; }
  .feed-top {
    position: sticky; top: 0; z-index: 30; background: rgba(10,10,12,0.92); backdrop-filter: blur(14px);
    border-bottom: 1px solid #2a2a35; padding: 14px 22px; display: flex; align-items: center; gap: 18px;
  }
  .feed-top h1 { margin: 0; font-size: 26px; font-weight: 500; letter-spacing: -0.01em; }
  .feed-top h1 span { color: #67e8f9; font-style: italic; }
  .tabs { display: flex; gap: 6px; margin-left: auto; }
  .tab {
    background: transparent; border: 1px solid #2a2a35; color: #c8c8d2;
    padding: 8px 16px; border-radius: 999px; cursor: pointer; font-family: inherit;
    font-size: 14px; letter-spacing: 0.02em; transition: all 0.15s;
  }
  .tab:hover { border-color: #67e8f9; color: #67e8f9; }
  .tab.active { background: #67e8f9; color: #0a0a0c; border-color: #67e8f9; font-weight: 600; }
  .wellbeing {
    margin: 12px 22px; padding: 12px 16px; background: #11131a;
    border: 1px solid #2a2a35; border-left: 3px solid #a78bfa; border-radius: 8px;
    font-size: 13px; color: #c8c8d2; display: flex; align-items: center; gap: 14px;
  }
  .wellbeing svg { flex-shrink: 0; color: #a78bfa; }
  .wb-meter { flex: 1; height: 6px; background: #1a1a22; border-radius: 4px; overflow: hidden; min-width: 140px; }
  .wb-meter > div { height: 100%; background: linear-gradient(90deg, #67e8f9, #a78bfa); transition: width 0.4s; }
  .wb-text { font-family: 'Geist Mono', monospace; font-size: 11px; color: #c8c8d2; white-space: nowrap; }

  /* TAB PANELS */
  .panel { display: none; }
  .panel.active { display: block; }

  /* ---------- REELS PANEL (vertical snap scroll) ---------- */
  .reels-panel {
    height: calc(100vh - 100px); overflow-y: scroll; scroll-snap-type: y mandatory;
    scrollbar-width: none; position: relative;
  }
  .reels-panel::-webkit-scrollbar { display: none; }
  .reel {
    height: calc(100vh - 100px); scroll-snap-align: start;
    display: flex; justify-content: center; align-items: center; position: relative;
  }
  .reel-card {
    position: relative; width: 380px; height: calc(100vh - 140px); max-height: 760px;
    background: #11131a; border-radius: 18px; overflow: hidden;
    border: 1px solid #2a2a35; box-shadow: 0 12px 60px rgba(0,0,0,0.6);
  }
  .reel-thumb { position: absolute; inset: 0; }
  .reel-thumb canvas { width: 100%; height: 100%; display: block; }
  .reel-overlay {
    position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.85) 100%);
    pointer-events: none;
  }
  .reel-meta {
    position: absolute; left: 16px; right: 70px; bottom: 18px; z-index: 2;
  }
  .reel-meta .rtitle { font-size: 19px; line-height: 1.25; font-weight: 500; margin-bottom: 6px; }
  .reel-meta .rauth { font-size: 13px; color: #c8c8d2; font-family: 'Geist Mono', monospace; margin-bottom: 6px; }
  .reel-meta .rtags { display: flex; flex-wrap: wrap; gap: 5px; }
  .reel-meta .rtags span {
    background: rgba(167,139,250,0.16); color: #c4b5fd; padding: 3px 8px; border-radius: 6px;
    font-size: 11px; font-family: 'Geist Mono', monospace;
  }
  .reel-meta .rmedia {
    display: inline-block; margin-bottom: 6px; font-size: 12px; color: #67e8f9;
    font-family: 'Geist Mono', monospace; text-decoration: none; border-bottom: 1px solid rgba(103,232,249,0.5);
  }
  .reel-meta .rnomedia {
    margin-bottom: 6px; font-size: 11px; line-height: 1.45; color: #9a9aa8; font-family: 'Geist Mono', monospace;
  }
  /* Comment sheet — the reader and composer for feed_comments. */
  .comment-sheet {
    display: none; position: absolute; left: 0; right: 0; bottom: 0; z-index: 6; max-height: 62%;
    background: rgba(10,10,14,0.97); border-top: 1px solid #2a2a35; border-radius: 16px 16px 0 0;
    padding: 12px 14px 14px; overflow-y: auto;
  }
  .comment-sheet.open { display: block; }
  .cs-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 13px; color: #c8c8d2; }
  .cs-close { background: none; border: 1px solid #2a2a35; color: #c8c8d2; border-radius: 8px; padding: 3px 10px; cursor: pointer; font-family: inherit; font-size: 12px; }
  .cs-empty { color: #8a8a99; font-style: italic; font-size: 13px; margin: 6px 0; }
  .cs-error { color: #fb7185; font-size: 12px; line-height: 1.5; margin: 6px 0; }
  .cs-item { font-size: 13px; line-height: 1.45; margin-bottom: 8px; color: #e8e8ee; }
  .cs-item strong { display: block; font-family: 'Geist Mono', monospace; font-size: 11px; color: #67e8f9; }
  .cs-form { display: flex; gap: 6px; margin-top: 8px; }
  .cs-form input {
    flex: 1; background: #11131a; border: 1px solid #2a2a35; color: #e8e8ee;
    border-radius: 8px; padding: 8px 10px; font-family: inherit; font-size: 13px;
  }
  .cs-form button { background: #67e8f9; color: #0a0a0c; border: 0; border-radius: 8px; padding: 8px 14px; font-family: inherit; font-weight: 600; cursor: pointer; }
  .cs-msg { font-size: 12px; color: #fb7185; margin: 6px 0 0; min-height: 1em; }
  .clip-open { display: inline-block; margin: 4px 0 6px; font-size: 12px; color: #67e8f9; font-family: 'Geist Mono', monospace; text-decoration: none; border-bottom: 1px solid rgba(103,232,249,0.5); }
  .clip-nolink { margin: 4px 0 6px; font-size: 11px; color: #8a8a99; font-family: 'Geist Mono', monospace; }
  .read-error {
    margin: 12px 22px; padding: 12px 16px; background: #1a1114; border: 1px solid #fb7185;
    border-radius: 8px; color: #fb7185; font-size: 13px; line-height: 1.55;
  }
  .reel-side {
    position: absolute; right: 12px; bottom: 24px; z-index: 3; display: flex; flex-direction: column; gap: 14px;
  }
  .rs-btn.saved { color: #a78bfa; border-color: #a78bfa; }
  .rs-btn {
    background: rgba(20,20,28,0.6); border: 1px solid rgba(255,255,255,0.08); color: #e8e8ee;
    width: 46px; height: 46px; border-radius: 50%; display: flex; flex-direction: column;
    align-items: center; justify-content: center; cursor: pointer;
    transition: all 0.15s; backdrop-filter: blur(4px);
  }
  .rs-btn:hover { background: rgba(103,232,249,0.18); border-color: #67e8f9; transform: scale(1.08); }
  .rs-btn.liked { color: #fb7185; border-color: #fb7185; }
  .rs-btn svg { width: 22px; height: 22px; }
  .rs-count { font-size: 10px; font-family: 'Geist Mono', monospace; color: #c8c8d2; margin-top: 2px; text-align: center; }
  .reel-top-actions {
    position: absolute; top: 14px; right: 14px; z-index: 3; display: flex; gap: 8px;
  }
  .reel-top-actions button {
    background: rgba(20,20,28,0.5); border: 1px solid rgba(255,255,255,0.1); color: #e8e8ee;
    width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    cursor: pointer; backdrop-filter: blur(4px);
  }
  .why-tip {
    position: absolute; top: 60px; right: 14px; z-index: 4;
    background: #11131a; border: 1px solid #2a2a35; border-radius: 10px;
    padding: 10px 12px; font-size: 11px; color: #c8c8d2; max-width: 230px;
    font-family: 'Geist Mono', monospace; display: none;
  }
  .why-tip.show { display: block; }
  .why-tip h4 { margin: 0 0 6px 0; color: #67e8f9; font-size: 11px; font-family: inherit; font-weight: 600; }
  .why-tip .sig { display: flex; justify-content: space-between; margin: 3px 0; }
  .why-tip .sig span:last-child { color: #67e8f9; }

  /* ---------- CLIPS PANEL ---------- */
  .clips-panel { padding: 24px; }
  .filter-bar { display: flex; gap: 10px; margin-bottom: 22px; flex-wrap: wrap; align-items: center; }
  .filter-bar select, .filter-bar input {
    background: #11131a; border: 1px solid #2a2a35; color: #e8e8ee; padding: 8px 12px;
    border-radius: 8px; font-family: inherit; font-size: 14px;
  }
  .filter-bar input:focus, .filter-bar select:focus { outline: none; border-color: #67e8f9; }
  .clip-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 22px;
  }
  .clip-card { background: #11131a; border: 1px solid #2a2a35; border-radius: 12px; overflow: hidden; cursor: pointer; transition: all 0.15s; }
  .clip-card:hover { transform: translateY(-3px); border-color: #67e8f9; }
  .clip-thumb { width: 100%; aspect-ratio: 16/9; position: relative; background: #06080a; }
  .clip-thumb canvas { width: 100%; height: 100%; display: block; }
  .clip-dur {
    position: absolute; right: 8px; bottom: 8px; background: rgba(0,0,0,0.78);
    color: #fff; padding: 3px 7px; border-radius: 4px; font-family: 'Geist Mono', monospace; font-size: 11px;
  }
  .clip-body { padding: 14px; }
  .clip-body h3 { margin: 0 0 7px 0; font-size: 17px; line-height: 1.3; font-weight: 500; }
  .clip-body .meta {
    font-size: 12px; color: #8a8a99; font-family: 'Geist Mono', monospace;
  }
  .clip-body .ctags { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 5px; }
  .clip-body .ctags span {
    background: rgba(103,232,249,0.12); color: #67e8f9; padding: 2px 7px; border-radius: 6px;
    font-size: 10px; font-family: 'Geist Mono', monospace;
  }

  /* ---------- AR PANEL ---------- */
  .xr-panel { padding: 24px; }
  .xr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
  .xr-card {
    background: #11131a; border: 1px solid #2a2a35; border-radius: 12px; padding: 18px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .xr-preview {
    width: 100%; aspect-ratio: 4/5; border-radius: 8px; background: #06080a; overflow: hidden;
    border: 1px solid #2a2a35;
  }
  .xr-preview canvas { width: 100%; height: 100%; display: block; }
  .xr-card h3 { margin: 0; font-size: 18px; font-weight: 500; }
  .xr-card .kind {
    font-family: 'Geist Mono', monospace; font-size: 10px; color: #a78bfa;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .xr-card .desc { font-size: 13px; color: #c8c8d2; line-height: 1.45; font-family: inherit; min-height: 36px; }
  .xr-card button.try {
    background: #67e8f9; color: #0a0a0c; border: 0; padding: 9px 14px; border-radius: 8px;
    font-family: inherit; font-weight: 600; cursor: pointer; font-size: 14px;
  }
  .xr-card button.try:hover { background: #a78bfa; }

  /* AR live modal */
  .ar-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 100; display: none;
    align-items: center; justify-content: center; flex-direction: column; padding: 20px;
  }
  .ar-modal.open { display: flex; }
  .ar-stage {
    position: relative; max-width: 640px; width: 100%; aspect-ratio: 3/4;
    background: #0a0a0c; border-radius: 14px; overflow: hidden; border: 1px solid #2a2a35;
  }
  .ar-stage video, .ar-stage canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .ar-stage video { visibility: hidden; }
  .ar-controls {
    display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; justify-content: center;
  }
  .ar-controls button {
    background: #11131a; color: #e8e8ee; border: 1px solid #2a2a35; padding: 8px 14px;
    border-radius: 8px; cursor: pointer; font-family: 'Cormorant Garamond', serif; font-size: 14px;
  }
  .ar-controls button.active { background: #67e8f9; color: #0a0a0c; border-color: #67e8f9; }
  .ar-controls button.close { background: #fb7185; color: #0a0a0c; border-color: #fb7185; }
  .ar-status { color: #c8c8d2; margin-top: 10px; font-family: 'Geist Mono', monospace; font-size: 12px; min-height: 18px; }

  /* FAB */
  .feed-fab {
    position: fixed; right: 26px; bottom: 26px; z-index: 50; width: 56px; height: 56px;
    border-radius: 50%; background: #67e8f9; color: #0a0a0c; border: 0; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 28px rgba(103, 232, 249, 0.35);
  }
  .feed-fab:hover { background: #a78bfa; }
  .feed-fab svg { width: 26px; height: 26px; }

  /* Create modal */
  .create-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 100; display: none;
    align-items: center; justify-content: center; padding: 20px;
  }
  .create-modal.open { display: flex; }
  .create-card { background: #11131a; border: 1px solid #2a2a35; border-radius: 14px; padding: 26px; max-width: 540px; width: 100%; }
  .create-card h2 { margin: 0 0 16px 0; font-size: 26px; font-weight: 500; }
  .create-card label { display: block; font-size: 12px; color: #8a8a99; margin: 10px 0 4px 0; font-family: 'Geist Mono', monospace; }
  .create-card input, .create-card select, .create-card textarea {
    width: 100%; background: #0a0a0c; border: 1px solid #2a2a35; color: #e8e8ee;
    padding: 9px 12px; border-radius: 7px; font-family: inherit; font-size: 14px;
  }
  .create-card textarea { resize: vertical; min-height: 90px; }
  .create-card .row-btn { display: flex; gap: 10px; margin-top: 18px; justify-content: flex-end; }
  .create-card button {
    padding: 9px 16px; border-radius: 7px; border: 1px solid #2a2a35; background: #1a1a22;
    color: #e8e8ee; cursor: pointer; font-family: inherit; font-size: 14px;
  }
  .create-card button.primary { background: #67e8f9; color: #0a0a0c; border-color: #67e8f9; font-weight: 600; }

  /* Cap-reached lock screen */
  .timeup {
    position: fixed; inset: 0; background: rgba(10,10,12,0.96); z-index: 200; display: none;
    align-items: center; justify-content: center; flex-direction: column; gap: 16px; padding: 30px;
  }
  .timeup.open { display: flex; }
  .timeup h2 { font-size: 38px; margin: 0; font-weight: 400; color: #a78bfa; }
  .timeup p { color: #c8c8d2; max-width: 480px; text-align: center; font-size: 16px; line-height: 1.5; }

  .toast {
    position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
    background: #11131a; border: 1px solid #67e8f9; color: #67e8f9;
    padding: 10px 18px; border-radius: 8px; font-family: 'Geist Mono', monospace; font-size: 13px;
    z-index: 300; display: none;
  }
  .toast.show { display: block; }

  .empty { padding: 60px 20px; text-align: center; color: #8a8a99; font-style: italic; }
</style>

<div class="feed-root">
  <div class="feed-top">
    <h1><span>edu</span>Feed</h1>
    <div class="tabs">
      <button class="tab active" data-tab="reels">Reels</button>
      <button class="tab" data-tab="clips">Clips</button>
      <button class="tab" data-tab="xr">AR / XR</button>
      <button class="tab" data-tab="interests">Interests</button>
    </div>
  </div>

  <div class="wellbeing">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v6m0 6v6m11-11h-6m-6 0H1"/></svg>
    <span>We use engagement signals to recommend, but we cap daily watch time at {dailyCap} min and never show you content optimised purely for outrage.</span>
    <div class="wb-meter"><div style={`width:${watchPct}%`}></div></div>
    <span class="wb-text">{watchReadFailed ? 'watch time unavailable' : minutesToday + 'm / ' + dailyCap + 'm today'}</span>
  </div>

  {!schemaBoot.ok && (
    <div class="read-error">
      The feed's tables could not be prepared ({schemaBoot.error}). Nothing below is a picture of an
      empty feed — it is a picture of a feed that could not be read. Posting is likely to fail too.
    </div>
  )}
  {feedReadError && (
    <div class="read-error">
      The posts could not be read ({feedReadError}). This is NOT "nobody has posted" — the query did
      not run. Reload once the database recovers.
    </div>
  )}
  {watchReadFailed && (
    <div class="read-error">
      Your watch time for today could not be read, so the daily cap is not being enforced on this
      page load. The meter above is blank rather than showing a zero it cannot stand behind.
    </div>
  )}

  {okMsg && <div class="toast show">{okMsg}</div>}
  {errMsg && <div class="toast show" style="border-color:#fb7185;color:#fb7185">{errMsg}</div>}

  <!-- REELS PANEL -->
  <div class="panel active" id="panel-reels">
    <div class="reels-panel" id="reelsScroll">
      {reels.length === 0 && !feedReadError && (
        <div class="empty">
          Nothing has been posted to the feed yet. Use the + button to publish the first reel —
          give it a title, tags and a link to the recording.
        </div>
      )}
      {reels.map((r: any, i: number) => (
        <div class="reel" data-post-id={r.id} data-idx={i}>
          <div class="reel-card">
            <div class="reel-thumb"><canvas data-thumb-seed={i} data-thumb-kind="reel"></canvas></div>
            <div class="reel-overlay"></div>
            <div class="reel-top-actions">
              <button class="why-btn" title="Why am I seeing this?" data-idx={i}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </button>
              {/* The "More" overflow button that used to sit here had no handler, no menu and no
                  action behind it — it was three dots that did nothing. Removed rather than left
                  in place looking like a menu. */}
            </div>
            <div class="why-tip" data-tip={i}>
              <h4>Why am I seeing this</h4>
              <div class="sig"><span>Score</span><span>{r.score}</span></div>
              <div class="sig"><span>Tag match</span><span>{Math.round(r.tm * 100)}%</span></div>
              <div class="sig"><span>Recency</span><span>{r.recency === 1 ? 'fresh' : 'older'}</span></div>
              <div class="sig"><span>Author followed</span><span>{r.authorFollowed > 0 ? 'yes' : 'no'}</span></div>
              <div class="sig"><span>Already seen</span><span>{r.seen > 0 ? 'yes' : 'no'}</span></div>
            </div>
            <div class="reel-meta">
              <div class="rtitle">{r.title}</div>
              <div class="rauth">{r.duration_seconds ? r.duration_seconds + 's' : 'no duration recorded'}</div>
              {r.media_url
                ? <a class="rmedia" href={r.media_url} target="_blank" rel="noopener noreferrer">Open the linked recording &rarr;</a>
                : <div class="rnomedia">No recording is attached to this post — the panel behind it is a generated pattern, not a video frame.</div>}
              <div class="rtags">
                {(Array.isArray(r.tags) ? r.tags : []).slice(0,4).map((t: string) => <span>#{t}</span>)}
              </div>
            </div>
            <div class="reel-side">
              <button class="rs-btn like-btn" data-post-id={r.id} title="Like">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <span class="rs-count">{r.like_count}</span>
              </button>
              <button class="rs-btn comment-btn" data-post-id={r.id} title="Comments">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span class="rs-count">{(commentsByPost[String(r.id)] || []).length}</span>
              </button>
              <button class="rs-btn share-btn" data-post-id={r.id} title="Share a link to this post">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span class="rs-count">{r.share_count || 0}</span>
              </button>
              <button class={'rs-btn save-btn' + (savedSet.has(String(r.id)) ? ' saved' : '')} data-post-id={r.id} title="Save for later">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                <span class="rs-count rs-save-label">{savedSet.has(String(r.id)) ? 'Saved' : 'Save'}</span>
              </button>
            </div>
            {/* THE COMMENT THREAD. feed_comments was created by this page and never read from or
                written to, and the button above carried a count from the seed array. This sheet is
                the reader and the composer for it. */}
            <div class="comment-sheet" data-sheet={r.id}>
              <div class="cs-head">
                <span>Comments</span>
                <button class="cs-close" data-close-sheet={r.id} type="button">Close</button>
              </div>
              {!commentsRead.ok && (
                <p class="cs-error">The comments could not be read ({commentsRead.error}). This is not "no comments" — reload once the database recovers.</p>
              )}
              <div class="cs-list" data-list={r.id}>
                {commentsRead.ok && (commentsByPost[String(r.id)] || []).length === 0 && (
                  <p class="cs-empty">No comments yet. Yours would be the first.</p>
                )}
                {(commentsByPost[String(r.id)] || []).map((c: any) => (
                  <div class="cs-item"><strong>{c.author_name}</strong><span>{c.body}</span></div>
                ))}
              </div>
              <form class="cs-form" data-form={r.id}>
                <input type="text" maxlength="2000" placeholder="Add a comment" data-input={r.id} />
                <button type="submit">Post</button>
              </form>
              <p class="cs-msg" data-msg={r.id}></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CLIPS PANEL -->
  <div class="panel" id="panel-clips">
    <div class="clips-panel">
      <div class="filter-bar">
        <input type="text" id="clipSearch" placeholder="Search titles or tags..." />
        {/* Topics come from the tags on the clips actually on screen. The seven hardcoded options
            that used to be here could filter to a topic no clip carried — and hid every topic a
            clip did carry. */}
        <select id="clipTopic">
          <option value="">All topics</option>
          {clipTopics.map((t: string) => <option value={t}>{t}</option>)}
        </select>
        <select id="clipDur">
          <option value="">Any duration</option>
          <option value="short">Under 30 min</option>
          <option value="long">30 min +</option>
        </select>
      </div>
      <div class="clip-grid" id="clipGrid">
        {clips.length === 0 && !feedReadError && <div class="empty">No long-form clips have been published yet.</div>}
        {clips.map((c: any, i: number) => (
          <div class="clip-card" data-tags={(Array.isArray(c.tags) ? c.tags : []).join(',')} data-dur={c.duration_seconds}>
            <div class="clip-thumb">
              <canvas data-thumb-seed={i+100} data-thumb-kind="clip"></canvas>
              <div class="clip-dur">{Math.floor((c.duration_seconds||0)/60)}:{String((c.duration_seconds||0)%60).padStart(2,'0')}</div>
            </div>
            <div class="clip-body">
              <h3>{c.title}</h3>
              <div class="meta">{Number(c.view_count || 0).toLocaleString()} views · score {c.score}</div>
              {/* A clip card used to have no click handler and there is no player route, so the
                  grid was a poster wall. A card now opens the link its author attached, and says
                  plainly when there is none instead of looking clickable. */}
              {c.media_url
                ? <a class="clip-open" href={c.media_url} target="_blank" rel="noopener noreferrer">Open the recording &rarr;</a>
                : <div class="clip-nolink">No recording link was attached to this post.</div>}
              <div class="ctags">
                {(Array.isArray(c.tags) ? c.tags : []).slice(0,5).map((t: string) => <span>#{t}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- XR PANEL -->
  <div class="panel" id="panel-xr">
    <div class="xr-panel">
      <div class="xr-grid" id="xrGrid">
        {filtersReadError && (
          <div class="read-error">The AR filter catalogue could not be read ({filtersReadError}). The camera effects below are missing because the query failed, not because none exist.</div>
        )}
        {!filtersReadError && filters.length === 0 && (
          <div class="empty">No camera filters are published yet.</div>
        )}
        {filters.map((f: any, i: number) => (
          <div class="xr-card" data-filter-slug={f.slug}>
            <div class="xr-preview"><canvas data-preview-slug={f.slug} data-preview-idx={i}></canvas></div>
            <div class="kind">{f.kind}</div>
            <h3>{f.name}</h3>
            <div class="desc">{f.code}</div>
            <button class="try" data-try-slug={f.slug}>Try in camera</button>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- INTERESTS PANEL -->
  <div class="panel" id="panel-interests">
    <div style="padding:24px; max-width:680px">
      <h2 style="font-weight:500; font-size:28px; margin:0 0 10px 0">Your interests</h2>
      <p style="color:#c8c8d2; margin:0 0 18px 0">Comma-separated tags. We use these to drive the recommendation algorithm.</p>
      <form method="POST">
        <input type="hidden" name="action" value="save_interests" />
        <textarea name="interests" rows="4" style="width:100%; background:#11131a; border:1px solid #2a2a35; color:#e8e8ee; padding:12px; border-radius:8px; font-family:'Geist Mono', monospace; font-size:13px">{interests.join(', ')}</textarea>
        <button type="submit" style="margin-top:14px; background:#67e8f9; color:#0a0a0c; border:0; padding:10px 18px; border-radius:8px; font-family:inherit; font-weight:600; cursor:pointer; font-size:15px">Save interests</button>
      </form>

      <h3 style="margin:32px 0 10px 0; font-weight:500">Algorithm transparency</h3>
      <pre style="background:#11131a; border:1px solid #2a2a35; padding:14px; border-radius:8px; font-size:11px; line-height:1.6; color:#c8c8d2; overflow-x:auto">score = log(views+1) * 0.4
      + log(likes+1) * 0.3
      + (recency_days &lt; 7 ? 1 : 0.5)
      + jaccard(post_tags, your_interests) * 0.5
      + (author_followed ? 0.3 : 0)
      - (already_seen ? 1.5 : 0)</pre>
      <p style="color:#8a8a99; font-size:13px; line-height:1.5; margin-top:14px">No outrage signals, no purely-attention-grabbing weighting, and a hard 90-minute daily cap. You can see the exact score on every reel by tapping the question-mark icon.</p>
    </div>
  </div>

  <button class="feed-fab" id="fab" title="New post">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>

  <!-- Create modal -->
  <div class="create-modal" id="createModal">
    <div class="create-card">
      <h2>Publish to the feed</h2>
      <form method="POST">
        <input type="hidden" name="action" value="create_post" />
        <label>Kind</label>
        <select name="kind">
          <option value="reel">Reel (short-form vertical)</option>
          <option value="clip">Clip (long-form horizontal)</option>
          <option value="photo">Photo</option>
          <option value="xr-experience">AR / XR experience</option>
          <option value="thread">Thread</option>
        </select>
        <label>Title</label>
        <input type="text" name="title" required maxlength="280" />
        <label>Description</label>
        <textarea name="description" maxlength="2000"></textarea>
        <label>Topic tags (comma-separated)</label>
        <input type="text" name="tags" placeholder="math, integration, jee" />
        {/* THE LINK IS WHAT MAKES A POST A POST. feed_posts.media_url has existed since this table
            was created and nothing ever wrote it, so every card on the feed was a title over a
            generated gradient with nothing behind it. Documents and recordings are links on this
            project — never uploads — so this is a URL field. */}
        <label>Link to the recording or document (Drive or any public URL)</label>
        <input type="url" name="media_url" maxlength="2000" placeholder="https://drive.google.com/..." />
        <label>Length in seconds (optional)</label>
        <input type="number" name="duration_seconds" min="0" max="86400" />
        <label>Visibility</label>
        <select name="visibility">
          <option value="public">Public</option>
          <option value="followers">Followers only</option>
          <option value="course">Course classmates</option>
          <option value="unlisted">Unlisted</option>
        </select>
        <div class="row-btn">
          <button type="button" id="cancelCreate">Cancel</button>
          <button type="submit" class="primary">Publish</button>
        </div>
      </form>
    </div>
  </div>

  <!-- AR modal -->
  <div class="ar-modal" id="arModal">
    <div class="ar-stage">
      <video id="arVideo" autoplay playsinline muted></video>
      <canvas id="arCanvas"></canvas>
    </div>
    <div class="ar-controls">
      <button class="active" data-fx="soft-glow">Soft Glow</button>
      <button data-fx="threshold">Threshold</button>
      <button data-fx="rgb-shift">RGB Shift</button>
      <button data-fx="edge-find">Edge Find</button>
      <button data-fx="polar-warp">Polar Warp</button>
      <button data-fx="anatomy">Anatomy Overlay</button>
      <button data-fx="math-notation">Math Notation</button>
      <button data-fx="molecule">Molecule Halo</button>
      <button data-fx="hand-trail">Hand Trail</button>
      <button data-fx="world-grid">World Grid</button>
      <button class="close" id="arClose">Close</button>
    </div>
    <div class="ar-status" id="arStatus">Ready</div>
  </div>

  {capReached && (
    <div class="timeup open">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <h2>Time's up for today</h2>
      <p>You've reached your daily watch-time cap of {dailyCap} minutes. We do this on purpose. Take a walk, do a problem set, or come back tomorrow.</p>
      <a href="/portal" style="color:#67e8f9; text-decoration:none; border:1px solid #67e8f9; padding:9px 16px; border-radius:8px; font-family:'Geist Mono', monospace; font-size:13px">Back to portal</a>
    </div>
  )}
</div>

<script is:inline define:vars={{ safeReels, safeClips, safeXr, safeFilters, safeInterests }}>
(function(){
  const reels = JSON.parse(safeReels);
  const clips = JSON.parse(safeClips);
  const xrPosts = JSON.parse(safeXr);
  const filters = JSON.parse(safeFilters);

  // -------- TAB SWITCHING --------
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.panel');
  tabs.forEach(t => t.addEventListener('click', () => {
    tabs.forEach(x => x.classList.remove('active'));
    panels.forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    const id = 'panel-' + t.dataset.tab;
    const p = document.getElementById(id);
    if (p) p.classList.add('active');
  }));

  // -------- ANIMATED CANVAS THUMBNAILS --------
  function drawReelThumb(canvas, seed) {
    const w = canvas.width = canvas.clientWidth || 380;
    const h = canvas.height = canvas.clientHeight || 600;
    const ctx = canvas.getContext('2d');
    // hash seed
    const hue1 = (seed * 47) % 360;
    const hue2 = (seed * 89 + 120) % 360;
    const g = ctx.createLinearGradient(0, 0, w, h);
    g.addColorStop(0, `hsl(${hue1}, 70%, 22%)`);
    g.addColorStop(1, `hsl(${hue2}, 65%, 14%)`);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // floating shapes
    const t = Date.now() / 1000;
    for (let i = 0; i < 14; i++) {
      const x = w/2 + Math.cos(t * 0.4 + i + seed) * (w * 0.35);
      const y = h/2 + Math.sin(t * 0.5 + i * 1.3 + seed) * (h * 0.32);
      const r = 28 + Math.sin(t + i) * 14;
      const ng = ctx.createRadialGradient(x, y, 0, x, y, r);
      ng.addColorStop(0, `hsla(${(hue1 + i * 22) % 360}, 80%, 65%, 0.55)`);
      ng.addColorStop(1, `hsla(${(hue1 + i * 22) % 360}, 80%, 60%, 0)`);
      ctx.fillStyle = ng;
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    }
    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let i = 0; i < 12; i++) {
      ctx.beginPath(); ctx.moveTo(0, (h/12)*i); ctx.lineTo(w, (h/12)*i); ctx.stroke();
    }
    // central icon shape
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.beginPath();
    ctx.arc(w/2, h*0.45, w * 0.18, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawClipThumb(canvas, seed) {
    const w = canvas.width = canvas.clientWidth || 360;
    const h = canvas.height = canvas.clientHeight || 200;
    const ctx = canvas.getContext('2d');
    const hue1 = (seed * 37) % 360;
    const hue2 = (seed * 71 + 60) % 360;
    const g = ctx.createLinearGradient(0, 0, w, h);
    g.addColorStop(0, `hsl(${hue1}, 60%, 25%)`);
    g.addColorStop(1, `hsl(${hue2}, 55%, 14%)`);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // wave-form lines
    ctx.strokeStyle = `hsla(${hue1}, 90%, 75%, 0.6)`;
    ctx.lineWidth = 1.5;
    for (let k = 0; k < 5; k++) {
      ctx.beginPath();
      for (let x = 0; x < w; x++) {
        const y = h/2 + Math.sin(x * 0.03 + k + seed) * (15 + k * 8);
        if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    // central play
    ctx.fillStyle = 'rgba(255,255,255,0.18)';
    ctx.beginPath();
    ctx.arc(w/2, h/2, 24, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.moveTo(w/2 - 7, h/2 - 9);
    ctx.lineTo(w/2 + 11, h/2);
    ctx.lineTo(w/2 - 7, h/2 + 9);
    ctx.closePath(); ctx.fill();
  }

  function drawXrPreview(canvas, slug, idx) {
    const w = canvas.width = canvas.clientWidth || 280;
    const h = canvas.height = canvas.clientHeight || 350;
    const ctx = canvas.getContext('2d');
    const hue = (idx * 47) % 360;
    const g = ctx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w);
    g.addColorStop(0, `hsl(${hue}, 60%, 30%)`);
    g.addColorStop(1, `hsl(${(hue + 180) % 360}, 40%, 10%)`);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // face silhouette
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.beginPath(); ctx.ellipse(w/2, h*0.5, w*0.28, h*0.32, 0, 0, Math.PI * 2); ctx.fill();
    // overlay specific
    if (slug === 'soft-glow') {
      const g2 = ctx.createRadialGradient(w/2, h*0.5, 0, w/2, h*0.5, w*0.4);
      g2.addColorStop(0, 'rgba(255,255,255,0.5)');
      g2.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = g2; ctx.fillRect(0,0,w,h);
    } else if (slug === 'threshold') {
      ctx.fillStyle = '#fff';
      for (let i = 0; i < 1200; i++) {
        const x = Math.random() * w, y = Math.random() * h;
        const v = ((x-w/2)*(x-w/2) + (y-h/2)*(y-h/2)) < w*w*0.08 ? 1 : 0;
        if (v) ctx.fillRect(x, y, 2, 2);
      }
    } else if (slug === 'rgb-shift') {
      ctx.fillStyle = 'rgba(255,0,80,0.4)';
      ctx.beginPath(); ctx.ellipse(w/2 - 6, h*0.5, w*0.28, h*0.32, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(0,255,200,0.4)';
      ctx.beginPath(); ctx.ellipse(w/2 + 6, h*0.5, w*0.28, h*0.32, 0, 0, Math.PI * 2); ctx.fill();
    } else if (slug === 'anatomy') {
      ctx.strokeStyle = '#67e8f9'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.ellipse(w/2, h*0.45, w*0.22, h*0.27, 0, 0, Math.PI * 2); ctx.stroke();
      // markers
      ctx.fillStyle = '#a78bfa';
      [[w*0.43, h*0.4], [w*0.57, h*0.4], [w/2, h*0.5], [w*0.45, h*0.6], [w*0.55, h*0.6]].forEach(p => {
        ctx.beginPath(); ctx.arc(p[0], p[1], 3, 0, Math.PI*2); ctx.fill();
      });
      ctx.font = '10px monospace'; ctx.fillStyle = '#67e8f9';
      ctx.fillText('orbital', w*0.38, h*0.35);
      ctx.fillText('zygomatic', w*0.52, h*0.66);
    } else if (slug === 'math-notation') {
      ctx.font = '14px monospace'; ctx.fillStyle = '#67e8f9';
      const eqs = ['∫f(x)dx', 'e^(iπ)+1=0', '∇²φ=ρ', 'Σ1/n²=π²/6', 'a²+b²=c²'];
      eqs.forEach((e, i) => ctx.fillText(e, 20, 30 + i * 60));
    } else if (slug === 'molecule') {
      ctx.strokeStyle = '#a78bfa'; ctx.lineWidth = 1.2;
      const cx = w/2, cy = h*0.5;
      const atoms = [[cx,cy],[cx+30,cy-20],[cx+30,cy+20],[cx-30,cy-20],[cx-30,cy+20],[cx,cy-40],[cx,cy+40]];
      atoms.forEach((a, i) => {
        if (i > 0) {
          ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(a[0], a[1]); ctx.stroke();
        }
        ctx.fillStyle = i === 0 ? '#67e8f9' : '#a78bfa';
        ctx.beginPath(); ctx.arc(a[0], a[1], 6, 0, Math.PI*2); ctx.fill();
      });
    } else if (slug === 'hand-trail') {
      for (let i = 0; i < 30; i++) {
        ctx.fillStyle = `hsla(${(i*12) % 360}, 80%, 60%, ${1 - i/30})`;
        ctx.beginPath(); ctx.arc(w*0.3 + i*4, h*0.5 - Math.sin(i*0.3)*30, 6, 0, Math.PI*2); ctx.fill();
      }
    } else if (slug === 'world-grid') {
      ctx.strokeStyle = 'rgba(103,232,249,0.5)'; ctx.lineWidth = 1;
      // perspective grid
      for (let i = 0; i < 10; i++) {
        ctx.beginPath();
        ctx.moveTo(0, h*0.6 + i*15);
        ctx.lineTo(w, h*0.6 + i*15);
        ctx.stroke();
      }
      for (let i = -10; i < 10; i++) {
        ctx.beginPath();
        ctx.moveTo(w/2, h*0.6);
        ctx.lineTo(w/2 + i * 30, h);
        ctx.stroke();
      }
    } else if (slug === 'polar-warp') {
      for (let r = 10; r < w/2; r += 14) {
        ctx.strokeStyle = `hsla(${r * 3}, 80%, 60%, 0.5)`;
        ctx.beginPath(); ctx.arc(w/2, h/2, r, 0, Math.PI*2); ctx.stroke();
      }
    } else if (slug === 'edge-find') {
      ctx.strokeStyle = '#67e8f9'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.ellipse(w/2, h*0.5, w*0.28, h*0.32, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(w/2-w*0.1, h*0.42, w*0.04, h*0.03, 0, 0, Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(w/2+w*0.1, h*0.42, w*0.04, h*0.03, 0, 0, Math.PI*2); ctx.stroke();
    }
  }

  // Animate reel thumbnails
  const reelCanvases = document.querySelectorAll('canvas[data-thumb-kind="reel"]');
  function loopReels() {
    reelCanvases.forEach(c => {
      const seed = parseInt(c.dataset.thumbSeed) || 1;
      drawReelThumb(c, seed);
    });
    requestAnimationFrame(loopReels);
  }
  loopReels();

  // Static clip thumbnails
  document.querySelectorAll('canvas[data-thumb-kind="clip"]').forEach(c => {
    const seed = parseInt(c.dataset.thumbSeed) || 1;
    drawClipThumb(c, seed);
  });
  // XR previews
  document.querySelectorAll('canvas[data-preview-slug]').forEach(c => {
    drawXrPreview(c, c.dataset.previewSlug, parseInt(c.dataset.previewIdx) || 0);
  });

  // -------- WHY-TIP toggle --------
  document.querySelectorAll('.why-btn').forEach(b => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = b.dataset.idx;
      const tip = document.querySelector('.why-tip[data-tip="'+idx+'"]');
      if (tip) tip.classList.toggle('show');
    });
  });

  // -------- REEL ACTION BUTTONS --------
  //
  // THE COUNT SHOWN IS THE COUNT THAT WAS STORED. Every one of these posts JSON to this page and
  // paints the number the SERVER returns. The like button used to paint an optimistic +1 and
  // swallow the response entirely (`catch(e) {}`), so a like the database refused still moved the
  // number in front of the reader. The other three buttons had no handler at all.
  async function feedAct(payload) {
    const res = await fetch(window.location.pathname, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    let data = null;
    try { data = await res.json(); } catch (_) { data = null; }
    if (!res.ok || !data || data.ok !== true) {
      throw new Error((data && data.error) || ('the server answered ' + res.status));
    }
    return data;
  }
  function sheetMsg(postId, text) {
    const el = document.querySelector('.cs-msg[data-msg="' + postId + '"]');
    if (el) el.textContent = text || '';
  }

  document.querySelectorAll('.like-btn').forEach(b => {
    b.addEventListener('click', async () => {
      if (b.classList.contains('liked')) return;
      const c = b.querySelector('.rs-count');
      const before = c ? c.textContent : '';
      try {
        const data = await feedAct({ act: 'like', post_id_target: b.dataset.postId });
        b.classList.add('liked');
        if (c) c.textContent = String(data.count);
      } catch (err) {
        // The like did NOT happen, so the number must not move and the reader must be told.
        if (c) c.textContent = before;
        sheetMsg(b.dataset.postId, 'Your like was not saved: ' + err.message);
        b.title = 'Like was not saved: ' + err.message;
      }
    });
  });

  // -------- COMMENTS: open the sheet, post a comment, read it back --------
  document.querySelectorAll('.comment-btn').forEach(b => {
    b.addEventListener('click', () => {
      const sheet = document.querySelector('.comment-sheet[data-sheet="' + b.dataset.postId + '"]');
      if (sheet) sheet.classList.toggle('open');
    });
  });
  document.querySelectorAll('.cs-close').forEach(b => {
    b.addEventListener('click', () => {
      const sheet = document.querySelector('.comment-sheet[data-sheet="' + b.dataset.closeSheet + '"]');
      if (sheet) sheet.classList.remove('open');
    });
  });
  document.querySelectorAll('.cs-form').forEach(f => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const postId = f.dataset.form;
      const input = document.querySelector('.cs-form input[data-input="' + postId + '"]');
      const list = document.querySelector('.cs-list[data-list="' + postId + '"]');
      const btn = f.querySelector('button');
      const text = input && input.value ? input.value.trim() : '';
      if (!text) { sheetMsg(postId, 'Write something first.'); return; }
      if (btn) btn.disabled = true;
      sheetMsg(postId, '');
      try {
        const data = await feedAct({ act: 'comment', post_id_target: postId, body: text });
        if (list) {
          const empty = list.querySelector('.cs-empty');
          if (empty) empty.remove();
          const item = document.createElement('div');
          item.className = 'cs-item';
          const who = document.createElement('strong');
          who.textContent = 'You';
          const bodyEl = document.createElement('span');
          bodyEl.textContent = text; // textContent, never innerHTML — a comment is somebody else's text
          item.appendChild(who); item.appendChild(bodyEl);
          list.appendChild(item);
        }
        const countEl = document.querySelector('.comment-btn[data-post-id="' + postId + '"] .rs-count');
        if (countEl) countEl.textContent = String(data.count);
        if (input) input.value = '';
      } catch (err) {
        sheetMsg(postId, 'Not posted: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });

  // -------- SHARE: only counted when a share or a copy actually happened --------
  document.querySelectorAll('.share-btn').forEach(b => {
    b.addEventListener('click', async () => {
      const postId = b.dataset.postId;
      const url = window.location.origin + window.location.pathname + '#post-' + postId;
      let shared = false;
      try {
        if (navigator.share) { await navigator.share({ url: url }); shared = true; }
        else if (navigator.clipboard) { await navigator.clipboard.writeText(url); shared = true; }
      } catch (_) {
        shared = false; // the person cancelled the share sheet, or the clipboard was refused
      }
      if (!shared) { sheetMsg(postId, 'Nothing was shared, so nothing was counted. Copy the address bar instead.'); return; }
      try {
        const data = await feedAct({ act: 'share', post_id_target: postId });
        const c = b.querySelector('.rs-count');
        if (c) c.textContent = String(data.count);
        sheetMsg(postId, 'Link copied.');
      } catch (err) {
        sheetMsg(postId, 'The link was copied, but the share count was not recorded: ' + err.message);
      }
    });
  });

  // -------- SAVE / UNSAVE (feed_saves) --------
  document.querySelectorAll('.save-btn').forEach(b => {
    b.addEventListener('click', async () => {
      const label = b.querySelector('.rs-save-label');
      try {
        const data = await feedAct({ act: 'save', post_id_target: b.dataset.postId });
        b.classList.toggle('saved', data.saved === true);
        if (label) label.textContent = data.saved ? 'Saved' : 'Save';
      } catch (err) {
        sheetMsg(b.dataset.postId, 'Not saved: ' + err.message);
      }
    });
  });

  // -------- VIEW EVENT logging via IntersectionObserver --------
  const sentViews = new Set();
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && e.intersectionRatio > 0.6) {
        const postId = e.target.dataset.postId;
        if (postId && !sentViews.has(postId)) {
          sentViews.add(postId);
          // Posts to this page, which answers JSON. Same body as before; the route it used to call
          // (/api/feed-view) never existed, so every view was a 404 swallowed by the catch below.
          fetch(window.location.pathname, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: postId, watched_pct: 100, device: 'web' })
          }).catch(() => {});
        }
      }
    });
  }, { threshold: [0.6] });
  document.querySelectorAll('.reel').forEach(r => io.observe(r));

  // -------- CLIPS FILTERING --------
  const clipSearch = document.getElementById('clipSearch');
  const clipTopic = document.getElementById('clipTopic');
  const clipDur = document.getElementById('clipDur');
  function filterClips() {
    // Guarded: these three lookups used to be dereferenced unconditionally inside the handler, so a
    // markup change that removed any one of them would have killed clip filtering on first use.
    if (!clipSearch || !clipTopic || !clipDur) return;
    const q = (clipSearch.value || '').toLowerCase();
    const t = clipTopic.value;
    const d = clipDur.value;
    document.querySelectorAll('.clip-card').forEach(card => {
      const tags = (card.dataset.tags || '').toLowerCase();
      const dur = parseInt(card.dataset.dur) || 0;
      const title = card.querySelector('h3').textContent.toLowerCase();
      let show = true;
      if (q && !title.includes(q) && !tags.includes(q)) show = false;
      if (t && !tags.includes(t)) show = false;
      if (d === 'short' && dur >= 1800) show = false;
      if (d === 'long' && dur < 1800) show = false;
      card.style.display = show ? '' : 'none';
    });
  }
  clipSearch?.addEventListener('input', filterClips);
  clipTopic?.addEventListener('change', filterClips);
  clipDur?.addEventListener('change', filterClips);

  // -------- CREATE FAB / MODAL --------
  const fab = document.getElementById('fab');
  const createModal = document.getElementById('createModal');
  const cancelCreate = document.getElementById('cancelCreate');
  fab?.addEventListener('click', () => createModal.classList.add('open'));
  cancelCreate?.addEventListener('click', () => createModal.classList.remove('open'));
  createModal?.addEventListener('click', (e) => {
    if (e.target === createModal) createModal.classList.remove('open');
  });

  // -------- AR MODAL + getUserMedia --------
  const arModal = document.getElementById('arModal');
  const arVideo = document.getElementById('arVideo');
  const arCanvas = document.getElementById('arCanvas');
  const arStatus = document.getElementById('arStatus');
  const arClose = document.getElementById('arClose');
  let arStream = null;
  let arFx = 'soft-glow';
  let arRaf = null;

  async function openAr(fx) {
    arFx = fx;
    document.querySelectorAll('.ar-controls button[data-fx]').forEach(b => {
      b.classList.toggle('active', b.dataset.fx === fx);
    });
    arModal.classList.add('open');
    arStatus.textContent = 'Requesting camera...';
    try {
      arStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640, height: 480 }, audio: false });
      arVideo.srcObject = arStream;
      await arVideo.play();
      arStatus.textContent = 'Camera live. Effect: ' + fx;
      runArLoop();
    } catch (e) {
      arStatus.textContent = 'Camera unavailable: ' + (e.message || 'permission denied');
    }
  }

  function closeAr() {
    arModal.classList.remove('open');
    if (arStream) {
      arStream.getTracks().forEach(t => t.stop());
      arStream = null;
    }
    if (arRaf) { cancelAnimationFrame(arRaf); arRaf = null; }
  }
  arClose?.addEventListener('click', closeAr);

  document.querySelectorAll('.ar-controls button[data-fx]').forEach(b => {
    b.addEventListener('click', () => {
      arFx = b.dataset.fx;
      document.querySelectorAll('.ar-controls button[data-fx]').forEach(x => x.classList.toggle('active', x === b));
      arStatus.textContent = 'Effect: ' + arFx;
    });
  });

  document.querySelectorAll('button[data-try-slug]').forEach(b => {
    b.addEventListener('click', () => {
      const slug = b.dataset.trySlug;
      openAr(slug);
      // The tray is ordered by use_count. This is the only thing that has ever written it, so the
      // ordering finally means what the panel says it means.
      fetch(window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filter_slug: slug })
      }).catch(() => {});
    });
  });

  // -------- REAL AR EFFECTS --------
  // Pre-blurred buffer for soft-glow
  function gaussianBlur(srcData, w, h) {
    // Separable 3-tap blur approximating gaussian
    const data = srcData.data;
    const out = new Uint8ClampedArray(data.length);
    // horizontal
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = (y*w + x) * 4;
        const im = (y*w + Math.max(0, x-1)) * 4;
        const ip = (y*w + Math.min(w-1, x+1)) * 4;
        for (let c = 0; c < 3; c++) {
          out[i+c] = (data[im+c] + 2*data[i+c] + data[ip+c]) / 4;
        }
        out[i+3] = data[i+3];
      }
    }
    // vertical
    const out2 = new Uint8ClampedArray(data.length);
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = (y*w + x) * 4;
        const im = (Math.max(0, y-1)*w + x) * 4;
        const ip = (Math.min(h-1, y+1)*w + x) * 4;
        for (let c = 0; c < 3; c++) {
          out2[i+c] = (out[im+c] + 2*out[i+c] + out[ip+c]) / 4;
        }
        out2[i+3] = out[i+3];
      }
    }
    return new ImageData(out2, w, h);
  }

  function applyFx(ctx, w, h, fx, t) {
    // grab frame from video
    ctx.drawImage(arVideo, 0, 0, w, h);
    if (fx === 'soft-glow') {
      const img = ctx.getImageData(0, 0, w, h);
      const blurred = gaussianBlur(img, w, h);
      // Composite: original + (blurred * 0.55)
      const od = img.data, bd = blurred.data;
      for (let i = 0; i < od.length; i += 4) {
        od[i] = Math.min(255, od[i] * 0.55 + bd[i] * 0.55);
        od[i+1] = Math.min(255, od[i+1] * 0.55 + bd[i+1] * 0.55);
        od[i+2] = Math.min(255, od[i+2] * 0.55 + bd[i+2] * 0.55);
      }
      ctx.putImageData(img, 0, 0);
    } else if (fx === 'threshold') {
      const img = ctx.getImageData(0, 0, w, h);
      const d = img.data;
      for (let i = 0; i < d.length; i += 4) {
        const lum = 0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2];
        const v = lum > 110 ? 255 : 0;
        d[i] = v; d[i+1] = v; d[i+2] = v;
      }
      ctx.putImageData(img, 0, 0);
    } else if (fx === 'rgb-shift') {
      const img = ctx.getImageData(0, 0, w, h);
      const d = img.data;
      const out = new Uint8ClampedArray(d.length);
      const dx = 6;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = (y*w + x) * 4;
          const ir = (y*w + Math.max(0, x - dx)) * 4;
          const ib = (y*w + Math.min(w-1, x + dx)) * 4;
          out[i] = d[ir];
          out[i+1] = d[i+1];
          out[i+2] = d[ib+2];
          out[i+3] = 255;
        }
      }
      ctx.putImageData(new ImageData(out, w, h), 0, 0);
    } else if (fx === 'edge-find') {
      // Sobel
      const img = ctx.getImageData(0, 0, w, h);
      const d = img.data;
      const lum = new Float32Array(w*h);
      for (let i = 0; i < w*h; i++) {
        lum[i] = 0.299*d[i*4] + 0.587*d[i*4+1] + 0.114*d[i*4+2];
      }
      const out = new Uint8ClampedArray(d.length);
      for (let y = 1; y < h-1; y++) {
        for (let x = 1; x < w-1; x++) {
          const tl = lum[(y-1)*w + (x-1)], tt = lum[(y-1)*w + x], tr = lum[(y-1)*w + (x+1)];
          const ll = lum[y*w + (x-1)], rr = lum[y*w + (x+1)];
          const bl = lum[(y+1)*w + (x-1)], bb = lum[(y+1)*w + x], br = lum[(y+1)*w + (x+1)];
          const gx = -tl - 2*ll - bl + tr + 2*rr + br;
          const gy = -tl - 2*tt - tr + bl + 2*bb + br;
          const g = Math.min(255, Math.sqrt(gx*gx + gy*gy));
          const i = (y*w + x) * 4;
          out[i] = 0; out[i+1] = g; out[i+2] = g; out[i+3] = 255;
        }
      }
      ctx.putImageData(new ImageData(out, w, h), 0, 0);
    } else if (fx === 'polar-warp') {
      const img = ctx.getImageData(0, 0, w, h);
      const d = img.data;
      const out = new Uint8ClampedArray(d.length);
      const cx = w/2, cy = h/2;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const dx = x - cx, dy = y - cy;
          const r = Math.sqrt(dx*dx + dy*dy);
          const a = Math.atan2(dy, dx) + r * 0.005;
          const sx = Math.floor(cx + Math.cos(a) * r);
          const sy = Math.floor(cy + Math.sin(a) * r);
          const i = (y*w + x) * 4;
          if (sx >= 0 && sx < w && sy >= 0 && sy < h) {
            const j = (sy*w + sx) * 4;
            out[i] = d[j]; out[i+1] = d[j+1]; out[i+2] = d[j+2]; out[i+3] = 255;
          }
        }
      }
      ctx.putImageData(new ImageData(out, w, h), 0, 0);
    } else if (fx === 'anatomy') {
      // overlay anatomical markers around centre (rough face approximation)
      ctx.strokeStyle = '#67e8f9'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.ellipse(w/2, h*0.5, w*0.22, h*0.3, 0, 0, Math.PI * 2); ctx.stroke();
      // landmarks
      const landmarks = [
        { x: w*0.41, y: h*0.42, label: 'orbital' },
        { x: w*0.59, y: h*0.42, label: 'orbital' },
        { x: w*0.50, y: h*0.50, label: 'nasal' },
        { x: w*0.42, y: h*0.62, label: 'zygomatic' },
        { x: w*0.58, y: h*0.62, label: 'zygomatic' },
        { x: w*0.50, y: h*0.68, label: 'mental' },
      ];
      landmarks.forEach(l => {
        ctx.fillStyle = '#a78bfa';
        ctx.beginPath(); ctx.arc(l.x, l.y, 4, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = '#67e8f9';
        ctx.font = '11px monospace';
        ctx.fillText(l.label, l.x + 8, l.y);
      });
    } else if (fx === 'math-notation') {
      ctx.strokeStyle = 'rgba(103,232,249,0.25)'; ctx.lineWidth = 0.5;
      for (let i = 0; i < w; i += 40) {
        ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, h); ctx.stroke();
      }
      for (let i = 0; i < h; i += 40) {
        ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(w, i); ctx.stroke();
      }
      ctx.font = '16px monospace'; ctx.fillStyle = '#67e8f9';
      const eqs = ['∫f(x)dx', 'e^(iπ)+1=0', '∇²φ=4πρ', 'Σ1/n² = π²/6', 'F = ma'];
      eqs.forEach((e, i) => {
        const x = (i * 137 + t * 30) % w;
        const y = 40 + ((i * 71) % (h - 80));
        ctx.fillText(e, x, y);
      });
    } else if (fx === 'molecule') {
      const cx = w*0.5, cy = h*0.5;
      const R = Math.min(w, h) * 0.18;
      const atoms = [
        { x: 0, y: 0, z: 0, c: '#67e8f9', r: 8 },
        { x: 1, y: 0, z: 0.3, c: '#a78bfa', r: 6 },
        { x: -1, y: 0, z: 0.3, c: '#a78bfa', r: 6 },
        { x: 0, y: 1, z: -0.4, c: '#fb7185', r: 5 },
        { x: 0, y: -1, z: -0.4, c: '#fb7185', r: 5 },
        { x: 0.7, y: 0.7, z: 0, c: '#fbbf24', r: 4 },
        { x: -0.7, y: -0.7, z: 0, c: '#fbbf24', r: 4 },
      ];
      const proj = atoms.map(a => {
        const ca = Math.cos(t*0.6), sa = Math.sin(t*0.6);
        const x = a.x * ca - a.z * sa;
        const z = a.x * sa + a.z * ca;
        return { x: cx + x * R, y: cy + a.y * R, z, c: a.c, r: a.r * (1 + z*0.3) };
      }).sort((a,b) => a.z - b.z);
      ctx.strokeStyle = 'rgba(255,255,255,0.5)'; ctx.lineWidth = 1.5;
      proj.forEach((p, i) => {
        if (i > 0) { ctx.beginPath(); ctx.moveTo(proj[0].x, proj[0].y); ctx.lineTo(p.x, p.y); ctx.stroke(); }
      });
      proj.forEach(p => {
        ctx.fillStyle = p.c;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx.fill();
      });
    } else if (fx === 'hand-trail') {
      // detect motion regions by frame differencing — simplified: animate particles in random direction
      if (!window.__handTrail) window.__handTrail = [];
      window.__handTrail.push({ x: Math.random()*w, y: Math.random()*h, life: 1, hue: (t*40) % 360 });
      while (window.__handTrail.length > 40) window.__handTrail.shift();
      window.__handTrail.forEach(p => {
        p.life *= 0.96;
        ctx.fillStyle = `hsla(${p.hue}, 80%, 60%, ${p.life})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, 8 * p.life, 0, Math.PI*2); ctx.fill();
      });
    } else if (fx === 'world-grid') {
      ctx.strokeStyle = 'rgba(103,232,249,0.55)'; ctx.lineWidth = 1;
      // horizon-anchored perspective grid (lower half)
      const horizon = h * 0.45;
      const offset = (t * 30) % 30;
      for (let i = 0; i < 14; i++) {
        const y = horizon + Math.pow(i, 1.6) * 4 + offset;
        if (y > h) break;
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
      }
      for (let i = -10; i <= 10; i++) {
        ctx.beginPath();
        ctx.moveTo(w/2, horizon);
        ctx.lineTo(w/2 + i * 60, h);
        ctx.stroke();
      }
    }
  }

  function runArLoop() {
    const w = arCanvas.width = arVideo.videoWidth || 640;
    const h = arCanvas.height = arVideo.videoHeight || 480;
    const ctx = arCanvas.getContext('2d');
    const t = Date.now() / 1000;
    try { applyFx(ctx, w, h, arFx, t); } catch(e) {}
    arRaf = requestAnimationFrame(runArLoop);
  }

  // auto-hide toast after 3s
  setTimeout(() => document.querySelectorAll('.toast').forEach(t => t.classList.remove('show')), 3200);
})();
</script>

</BaseLayout>
