---
// /portal/search — ONE SEARCH ACROSS THE WORKPLACE.
//
// =================================================================================================
// WHAT THIS PAGE IS
// =================================================================================================
//
// People, departments, projects, tasks, documents, announcements and policies, from one box. Two of
// those seven do not exist in this product yet, and this page SAYS SO by name rather than quietly
// returning nothing — a search that drops a whole category without a word is how somebody concludes
// their project was deleted.
//
// =================================================================================================
// AUTHORIZATION IS PART OF THE QUERY, NOT A FILTER ON THE RESULT
// =================================================================================================
//
// A search box is the one screen where a person can probe for things they cannot see. A hit count
// that moves as you type a colleague's surname confirms the colleague exists; a title inside a "you
// cannot open this" placeholder is the leak itself. So every source in src/lib/search-global.ts
// narrows in its WHERE clause, and this page has no filtering step, no hidden rows and no CSS that
// conceals a result. The count on screen is the count of what this person may open.
//
// The people scope comes from the ORGANIZATION GRAPH through resolveOrgViewerScope() — the same
// function /portal/organization uses — so the chart and the search agree about who you may see.
// Never a role name. When the graph is empty the People group says so instead of showing everybody.
//
// EVERY GROUP CARRIES ITS OWN SCOPE SENTENCE, rendered under the heading. A person should be able to
// read what they were allowed to search without asking anybody.
//
// =================================================================================================
// NO POST HANDLER, NO CLIENT JAVASCRIPT
// =================================================================================================
//
// The query is a GET form, so a search is shareable, survives a back button, and is bookmarkable.
// There is no autocomplete endpoint on purpose: an as-you-type endpoint is a probe oracle with a
// nicer interface, and every keystroke would be a database round trip on a phone connection.
//
// MOBILE FIRST: 360px, 44px targets, single column, nothing scrolls the page sideways.
import WorkspaceNav from '@/components/workforce/WorkspaceNav.astro';
import EmptyState from '@/components/workforce/EmptyState.astro';
import { composeWorkspace } from '@/lib/workforce/composer';
import { globalSearch, MIN_QUERY_CHARS } from '@/lib/search-global';

const PATH = '/portal/search';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login?next=' + encodeURIComponent(PATH));

// ------------------------------------------------------------------------------------------------
// EVERY CONST BEFORE ITS FIRST USE.
// ------------------------------------------------------------------------------------------------

let composed: any = null;
try {
  composed = await composeWorkspace(user as any, { locals: Astro.locals, next: PATH });
} catch (e: any) {
  // A composition that cannot be built is not guessed at. holds() then answers false for everything,
  // which lands the reader on the narrowest scope their employee record allows — the safe direction.
  console.error('[portal/search] compose', e?.cause?.message || e?.message);
}

const holds = (key: string): boolean => {
  try {
    return composed?.context?.holds ? composed.context.holds(key) === true : false;
  } catch {
    return false;
  }
};

const ctx = composed?.context || null;
const q = String(Astro.url.searchParams.get('q') || '').trim().slice(0, 80);

const model = await globalSearch(q, {
  userId: String(user.id),
  employeeId: ctx?.employeeId ?? null,
  departmentId: ctx?.departmentId ?? null,
  holds,
});

const groupsWithHits = model.sources.filter((s) => s.hits.length > 0);
const groupsWithout = model.sources.filter((s) => s.hits.length === 0);
const searched = !model.tooShort;
---

<!doctype html>
<html lang="en" style="background:#F8F8F6;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Search - EduRankAI</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;background:#F8F8F6;color:#1B1813;padding-bottom:96px;
      font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
      -webkit-text-size-adjust:100%;}
    html,body{overflow-x:hidden;}
    .topbar{position:sticky;top:0;z-index:20;background:#FDFDFC;border-bottom:1px solid #DFDCD8;
      padding:14px 16px 10px;}
    .topbar h1{margin:0;font-size:1rem;font-weight:700;letter-spacing:-0.01em;}
    .topbar p{margin:4px 0 0;font-size:0.75rem;line-height:1.5;color:#564E43;}
    .wrap{max-width:760px;margin:0 auto;padding:12px 12px 0;}
    form.q{display:flex;flex-wrap:wrap;gap:8px;margin:0;}
    form.q label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);
      white-space:nowrap;}
    .field{flex:1 1 100%;min-width:0;min-height:48px;padding:12px 14px;border:1px solid #DFDCD8;
      border-radius:10px;background:#FDFDFC;color:#1B1813;font:inherit;font-size:0.9375rem;}
    .go{flex:1 1 120px;min-height:48px;padding:12px 16px;border:1px solid #1B1813;border-radius:10px;
      background:#1B1813;color:#FFFFFF;font:inherit;font-size:0.9375rem;font-weight:650;cursor:pointer;}
    .clear{flex:1 1 120px;display:inline-flex;align-items:center;justify-content:center;min-height:48px;
      padding:12px 16px;border:1px solid #DFDCD8;border-radius:10px;background:#FDFDFC;color:#564E43;
      font-size:0.9375rem;font-weight:600;text-decoration:none;}
    .go:focus-visible,.field:focus-visible{outline:2px solid #6F52E5;outline-offset:2px;}
    .count{margin:12px 0 0;font-size:0.8125rem;color:#564E43;}
    .notice{margin:12px 0 0;padding:10px 12px;border:1px solid #EADECD;border-radius:10px;
      background:#FBF7F1;font-size:0.8125rem;line-height:1.55;color:#6D470D;}
    .group{margin:14px 0 0;border:1px solid #DFDCD8;border-radius:12px;background:#FDFDFC;overflow:hidden;}
    .group__head{padding:11px 13px;border-bottom:1px solid #EFEDE9;}
    .group__title{margin:0;font-size:0.9375rem;font-weight:680;line-height:1.35;}
    .group__scope{margin:3px 0 0;font-size:0.75rem;line-height:1.5;color:#70685C;overflow-wrap:anywhere;}
    .hit{display:block;padding:11px 13px;border-bottom:1px solid #EFEDE9;color:inherit;text-decoration:none;}
    .hit:last-child{border-bottom:none;}
    .hit p{margin:0;font-size:0.875rem;line-height:1.45;font-weight:600;overflow-wrap:anywhere;}
    .hit small{display:block;margin-top:3px;font-size:0.75rem;color:#70685C;overflow-wrap:anywhere;}
    .hit:focus-visible{outline:2px solid #6F52E5;outline-offset:-2px;}
    .kind{display:inline-block;margin-right:6px;padding:2px 8px;border-radius:999px;
      border:1px solid #DFDCD8;background:#F8F8F6;font-size:0.6875rem;font-weight:700;color:#564E43;}
    .absent{margin:14px 0 0;padding:12px 13px;border:1px solid #DFDCD8;border-radius:12px;
      background:#FDFDFC;}
    .absent h2{margin:0 0 4px;font-size:0.8125rem;font-weight:700;}
    .absent p{margin:6px 0 0;font-size:0.75rem;line-height:1.55;color:#70685C;overflow-wrap:anywhere;}
    .foot{margin:16px 0 0;padding:12px 2px;border-top:1px solid #DFDCD8;font-size:0.75rem;
      line-height:1.6;color:#70685C;}
    @media (min-width:640px){ .field{flex:1 1 320px;} }
  </style>
</head>
<body>
  <header class="topbar">
    <h1>Search</h1>
    <p>People, departments, tasks, documents and pages you are entitled to open.</p>
  </header>

  <main class="wrap">
    <form class="q" method="get" action={PATH} role="search">
      <label for="gq">Search the workplace</label>
      <input class="field" id="gq" type="search" name="q" value={q} maxlength="80" autocomplete="off"
        placeholder="A name, a department, a task, a page" />
      <button class="go" type="submit">Search</button>
      {q && <a class="clear" href={PATH}>Clear</a>}
    </form>

    {model.tooShort && q.length > 0 && (
      <p class="notice">
        Type at least {MIN_QUERY_CHARS} characters. A single letter matches most of the company and
        helps nobody find anything.
      </p>
    )}

    {model.tooShort && q.length === 0 && (
      <EmptyState
        title="What are you looking for"
        body="This searches the people, departments, tasks, documents and pages you are entitled to open. Anything you may not open is never returned, so what you see is what you can reach."
        illustration="search"
      />
    )}

    {model.degraded && (
      <p class="notice">
        Part of this search could not run, so these results may be incomplete. What could not be
        searched is named below rather than left blank.
      </p>
    )}

    {searched && (
      <p class="count">
        {model.hitCount === 0
          ? 'Nothing you can open matches "' + model.query + '".'
          : model.hitCount + (model.hitCount === 1 ? ' result' : ' results') + ' for "' + model.query + '".'}
      </p>
    )}

    {groupsWithHits.map((s) => (
      <section class="group">
        <div class="group__head">
          <h2 class="group__title">{s.label}</h2>
          {s.scopeNote && <p class="group__scope">{s.scopeNote}</p>}
        </div>
        {s.hits.map((h) => (
          <a class="hit" href={h.href}>
            <p><span class="kind">{h.kind}</span>{h.title}</p>
            {h.detail && <small>{h.detail}</small>}
          </a>
        ))}
      </section>
    ))}

    {searched && groupsWithout.length > 0 && (
      <section class="absent">
        <h2>Everywhere else this looked</h2>
        {groupsWithout.map((s) => (<p>{s.label}: {s.note}</p>))}
      </section>
    )}

    <p class="foot">
      Results are decided in the query, not filtered afterwards. A person, a task or a page you are
      not entitled to open is never selected, so it can never appear as a greyed-out row or change a
      count. Who you may find under People is decided by the organization graph, and searching for
      somebody you cannot see returns nothing rather than confirming they exist.
    </p>
  </main>

  {/* THE COMPOSED BAR. This was `<BottomNav variant="hr" active="" />` — a hardcoded
      Home | Tasks | Community | My HR with no capability test behind it, whose Home
      pointed at /portal rather than at this reader's actual home, and which lit no tab
      at all. The bar therefore rearranged itself as a person moved through their own
      workspace: WCAG 2.2 SC 3.2.3 Consistent Navigation, and the muscle memory a bottom
      bar exists to build. This page ALREADY composes, so the swap costs nothing — the
      same composition that scoped the content now draws the bar, and the two cannot
      disagree about what this person may reach. */}
  {composed && <WorkspaceNav composed={composed} />}
</body>
</html>
