---
/**
 * /mail/settings — the settings that belong to THIS product, and honest pointers to the ones that do
 * not.
 *
 * WHAT THIS PAGE DOES NOT DO, AND WHY IT SAYS SO. SMTP credentials, IMAP polling and the outbound
 * transport are owned by /admin/mail/settings and by the mail infrastructure — this product does not
 * reconfigure them, and a second form editing the same rows is how two screens come to disagree
 * about which server is sending. Where a setting lives elsewhere, this page links to it and states
 * the current value read-only, rather than pretending to own it.
 *
 * The two things it DOES own — the sending identity used on campaigns, and this person's own
 * signature — are edited here because nothing else edits them.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getMailConfig, getMailboxAddress, MAIL_DOMAIN } from '@/lib/mail';
import { getSignature } from '@/lib/mail-advanced';
import { transportStatus } from '@/lib/mail-transport';
import { listDomains } from '@/lib/mail-product/domains';
import { listApiKeys, listWebhooks } from '@/lib/mail-product/keys';
import { audienceTotals } from '@/lib/mail-product/analytics';
import { num, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let cfg: any = null;
let transport = { mode: 'none', detail: '' };
let address = '';
let signature = { html: '', on: false };
let domains: any[] = [];
let keys: any[] = [];
let hooks: any[] = [];
let audience: Record<string, number> = {};
let error = '';

if (access.allowed) {
  try {
    [cfg, transport, address, signature, domains, keys, hooks, audience] = await Promise.all([
      getMailConfig().catch(() => null),
      transportStatus().catch(() => ({ mode: 'none' as const, detail: 'Could not be read' })),
      getMailboxAddress(user!.id).catch(() => String(user?.email || '')),
      getSignature(user!.id).catch(() => ({ html: '', on: false })),
      listDomains().catch(() => []),
      listApiKeys().catch(() => []),
      listWebhooks().catch(() => []),
      audienceTotals().catch(() => ({} as Record<string, number>)),
    ]) as any;
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/settings] read failed:', error);
  }
}

const liveKeys = keys.filter((k: any) => !k.revoked_at).length;
const activeHooks = hooks.filter((h: any) => h.is_active).length;
const verifiedDomains = domains.filter((d: any) => d.status === 'verified').length;

const SECTIONS = [
  { id: 'profile', label: 'Profile', icon: 'contacts' },
  { id: 'identity', label: 'Sending identity', icon: 'send' },
  { id: 'infrastructure', label: 'Infrastructure', icon: 'mailboxes' },
  { id: 'organisation', label: 'Organisation', icon: 'building' },
  { id: 'security', label: 'Security', icon: 'shield' },
  { id: 'billing', label: 'Billing', icon: 'analytics' },
];
---
<MailShell title="Settings" active="settings" subtitle={address}>
  <div class="em-wrap em-stack" id="sRoot">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>Settings could not be read.</strong> {error}</p></div>
    )}

    <nav class="s-jump" aria-label="Settings sections">
      {SECTIONS.map((s) => (
        <a href={`#${s.id}`} class="em-btn sm"><MailIcon name={s.icon} size={13} /> {s.label}</a>
      ))}
    </nav>

    <!-- Profile ------------------------------------------------------------------------------- -->
    <section class="em-card" id="profile">
      <div class="em-card-head"><h2 class="em-h2">Profile</h2></div>
      <div class="em-card-body">
        <div class="em-grid c2">
          <div>
            <p class="em-label">Name</p>
            <p style="font-size:14px;font-weight:620;color:var(--em-ink)">{user?.name || '—'}</p>
            <p class="em-note">Changed in your account settings, not here.</p>
          </div>
          <div>
            <p class="em-label">Your mailbox address</p>
            <p class="em-mono" style="font-size:14px;color:var(--em-ink)">{address}</p>
            <p class="em-note">Derived from your internal handle. Mail sent to it arrives in your Inbox.</p>
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--em-line);margin:20px 0" />

        <label class="em-check" style="margin-bottom:12px">
          <input type="checkbox" id="sSigOn" checked={signature.on} />
          Append my signature to messages I send from the composer
        </label>
        <label class="em-field">
          <span class="em-label">Signature</span>
          <textarea class="em-textarea" id="sSig" rows="4" placeholder="Name&#10;Role, EduRankAI">{signature.html}</textarea>
          <span class="em-hint">
            Basic HTML is kept. It is appended to mail sent from the mailbox composer — campaigns use a
            Signature block in the builder instead, so a campaign&rsquo;s footer is part of its design.
          </span>
        </label>
        <button type="button" class="em-btn pri" data-s-sig>Save signature</button>
      </div>
    </section>

    <!-- Sending identity ------------------------------------------------------------------------ -->
    <section class="em-card" id="identity">
      <div class="em-card-head">
        <h2 class="em-h2">Sending identity</h2>
        <span class="em-note em-push">Used as the default From on new campaigns</span>
      </div>
      <div class="em-card-body">
        <div class="em-grid c2">
          <div>
            <p class="em-label">From name</p>
            <p style="font-size:14px;color:var(--em-ink)">{cfg?.fromName || <em class="em-note">not set</em>}</p>
          </div>
          <div>
            <p class="em-label">From address</p>
            <p class="em-mono" style="font-size:14px;color:var(--em-ink)">{cfg?.fromAddress || <em class="em-note">not set</em>}</p>
          </div>
        </div>
        <div class="em-alert info" style="margin:18px 0 0">
          <MailIcon name="info" size={16} />
          <p>
            These live with the transport configuration and are edited on
            <a href="/admin/mail/settings">Mail settings</a>. They are shown here read-only on purpose:
            two forms writing the same rows is how two screens come to disagree about which server is
            sending. A campaign can override the From per campaign.
          </p>
        </div>
      </div>
    </section>

    <!-- Infrastructure --------------------------------------------------------------------------- -->
    <section class="em-card" id="infrastructure">
      <div class="em-card-head"><h2 class="em-h2">Infrastructure</h2></div>
      <div class="em-card-body">
        <div class="s-row">
          <span class={'em-badge ' + (transport.mode === 'none' ? 'bad' : 'ok')}>
            <span class="em-dot"></span>{transport.mode === 'none' ? 'Not configured' : transport.mode.toUpperCase()}
          </span>
          <div><p class="em-h3">Outbound transport</p><p class="em-note">{transport.detail}</p></div>
          <a class="em-btn sm em-push" href="/admin/mail/settings">Configure</a>
        </div>

        <div class="s-row">
          <span class={'em-badge ' + (verifiedDomains === domains.length && domains.length ? 'ok' : domains.length ? 'warn' : '')}>
            {verifiedDomains}/{domains.length || 0}
          </span>
          <div><p class="em-h3">Sending domains verified</p>
            <p class="em-note">Unauthenticated mail is spam-foldered by most providers.</p></div>
          <a class="em-btn sm em-push" href="/mail/domains">Domains</a>
        </div>

        <div class="s-row">
          <span class="em-badge">{num(liveKeys)}</span>
          <div><p class="em-h3">Active API keys</p><p class="em-note">Stored as hashes; shown once at creation.</p></div>
          <a class="em-btn sm em-push" href="/mail/api">Keys</a>
        </div>

        <div class="s-row">
          <span class="em-badge">{num(activeHooks)}</span>
          <div><p class="em-h3">Active webhooks</p><p class="em-note">Signed delivery-event callbacks.</p></div>
          <a class="em-btn sm em-push" href="/mail/api">Webhooks</a>
        </div>

        <div class="s-row">
          <span class="em-badge">{num(audience.subscribed || 0)}</span>
          <div><p class="em-h3">Subscribed contacts</p>
            <p class="em-note">Of {num(audience.total || 0)} total. Only these can receive a campaign.</p></div>
          <a class="em-btn sm em-push" href="/mail/contacts">Contacts</a>
        </div>
      </div>
    </section>

    <!-- Organisation ------------------------------------------------------------------------------ -->
    <section class="em-card" id="organisation">
      <div class="em-card-head"><h2 class="em-h2">Organisation &amp; team</h2></div>
      <div class="em-card-body">
        <div class="em-grid c2">
          <div>
            <p class="em-label">Mail domain</p>
            <p class="em-mono" style="font-size:14px;color:var(--em-ink)">{MAIL_DOMAIN}</p>
            <p class="em-note">Every internal address is on this domain.</p>
          </div>
          <div>
            <p class="em-label">Who may open a mailbox</p>
            <p style="font-size:13.5px;color:var(--em-ink-2);line-height:1.6">
              An internal role, admin access, or an active employee record.
            </p>
          </div>
        </div>
        <div class="em-alert info" style="margin-top:18px">
          <MailIcon name="shield" size={16} />
          <p>
            Team membership and permissions are <strong>not</strong> configured here. They come from
            the platform&rsquo;s own roles and from employee records, and
            <code class="em-mono"> canUseMailbox()</code> composes those three existing answers rather
            than creating a fourth. A separate mail-only permission list would be a second RBAC that
            could disagree with the first.
          </p>
        </div>
        <p style="margin-top:14px">
          <a class="em-btn sm" href="/mail/mailboxes">See every mailbox</a>
          <a class="em-btn sm ghost" href="/admin/mail/groups" style="margin-inline-start:6px">Distribution groups</a>
        </p>
      </div>
    </section>

    <!-- Security ------------------------------------------------------------------------------------ -->
    <section class="em-card" id="security">
      <div class="em-card-head"><h2 class="em-h2">Security</h2></div>
      <div class="em-card-body">
        <ul class="s-facts">
          <li>
            <strong>Message bodies from outside are never rendered as HTML in this application.</strong>
            An inbound message is authored by whoever sent it; its markup is shown as text, with the
            original available in an isolated frame. That is why external mail looks plainer here than
            in a consumer client.
          </li>
          <li>
            <strong>API keys are stored as SHA-256 hashes.</strong> The first twelve characters are kept
            so a key can be identified in a list. There is no path that can reconstruct one.
          </li>
          <li>
            <strong>Webhook endpoints must be https,</strong> because delivery events carry recipient
            addresses. Twenty consecutive failures switch an endpoint off.
          </li>
          <li>
            <strong>Every mail API route authorises before it reads anything.</strong> A query that ran
            for an unauthorised caller has already happened, whatever the response says.
          </li>
          <li>
            <strong>Suppression is one-way by default.</strong> An import cannot resubscribe somebody who
            opted out, bounced or complained — only an explicit, confirmed status change can.
          </li>
        </ul>
      </div>
    </section>

    <!-- Billing ---------------------------------------------------------------------------------------- -->
    <section class="em-card" id="billing">
      <div class="em-card-head"><h2 class="em-h2">Usage</h2></div>
      <div class="em-card-body">
        <p class="em-lede" style="margin-bottom:16px">
          There is no billing on this system — it relays through your own configured mail server, so
          the volume below is what your provider sees, not an invoice.
        </p>
        <div class="em-grid c3">
          <div class="em-stat"><p class="em-stat-k">Contacts</p><p class="em-stat-v">{num(audience.total || 0)}</p></div>
          <div class="em-stat"><p class="em-stat-k">Sending domains</p><p class="em-stat-v">{num(domains.length)}</p></div>
          <div class="em-stat"><p class="em-stat-k">API keys</p><p class="em-stat-v">{num(liveKeys)}</p></div>
        </div>
        <p class="em-hint" style="margin-top:14px">
          Watch your provider&rsquo;s own rate limits before a large campaign — the dispatcher sends in
          batches, but the ceiling is theirs, not ours.
          <a href="/mail/analytics">Analytics</a> shows the volume actually sent.
        </p>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var EM = window.EM;
      if (!EM) return;
      var btn = document.querySelector('[data-s-sig]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        EM.busy(btn, true, 'Saving');
        // The signature lives in the mail engine's own table, written by the endpoint that owns it.
        EM.api('/api/mail/product/signature', {
          body: { html: document.getElementById('sSig').value, on: document.getElementById('sSigOn').checked },
        }).then(function (res) {
          EM.busy(btn, false);
          EM.toast(res.ok ? 'Signature saved.' : (res.error || 'The signature was NOT saved.'), res.ok ? 'ok' : 'bad');
        });
      });
    })();
  </script>
</MailShell>

<style>
  .s-jump { display: flex; gap: 6px; flex-wrap: wrap; }
  .s-row { display: flex; align-items: center; gap: var(--em-3); padding: var(--em-3) 0;
    border-bottom: 1px solid var(--em-line); flex-wrap: wrap; }
  .s-row:last-child { border-bottom: none; padding-bottom: 0; }
  .s-row > div { min-width: 0; flex: 1; }
  .s-facts { margin: 0; padding-inline-start: 18px; }
  .s-facts li { font-size: 13px; line-height: 1.65; color: var(--em-ink-3); margin-bottom: 12px; }
  .s-facts strong { color: var(--em-ink); font-weight: 640; }
  section[id] { scroll-margin-top: 76px; }
</style>
