---
/**
 * /mail/api — API keys and webhooks.
 *
 * A KEY IS SHOWN ONCE AND STORED NEVER. mail_api_keys holds a SHA-256 and the first twelve
 * characters, and nothing else. There is no "reveal" button on this page because there is nothing to
 * reveal — no code path anywhere can reconstruct a key from a stored row. The create dialog says so
 * before the key is generated, not after it has scrolled away.
 *
 * A REVOKED KEY IS KEPT. revoked_at is set and the row stays, so "which key made that call" still
 * has an answer after the key is gone.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listApiKeys, listWebhooks, API_SCOPES, WEBHOOK_EVENTS } from '@/lib/mail-product/keys';
import { timeAgo, fullTime, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let keys: any[] = [];
let hooks: any[] = [];
let error = '';
if (access.allowed) {
  try {
    [keys, hooks] = await Promise.all([listApiKeys(), listWebhooks()]);
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/api] read failed:', error);
  }
}
const live = keys.filter((k) => !k.revoked_at);
const revoked = keys.filter((k) => k.revoked_at);
---
<MailShell title="API & webhooks" active="api" subtitle="Programmatic access">
  <button slot="actions" type="button" class="em-btn" data-k-hook><MailIcon name="webhook" size={15} /> Add webhook</button>
  <button slot="actions" type="button" class="em-btn pri" data-k-new><MailIcon name="key" size={15} /> Create key</button>

  <div class="em-wrap em-stack" id="kRoot">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>This page could not be read.</strong> {error}</p></div>
    )}

    <!-- Keys ---------------------------------------------------------------------------------- -->
    <div class="em-card">
      <div class="em-card-head">
        <div><h2 class="em-h2">API keys</h2>
          <p class="em-note">Only a hash is stored. A key is shown once, when it is created.</p></div>
      </div>

      {live.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="key" size={34} strokeWidth={1.3} />
          <h3>No active keys</h3>
          <p>A key lets another system send transactional mail or read contacts and events through the API.</p>
          <button type="button" class="em-btn pri" data-k-new><MailIcon name="plus" size={15} /> Create a key</button>
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">Name</th><th scope="col">Key</th><th scope="col">Permissions</th>
              <th scope="col">Last used</th><th scope="col">Created</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {live.map((k: any) => (
                <tr>
                  <td><strong>{k.name}</strong></td>
                  <td><code class="em-mono">{k.key_prefix}…</code></td>
                  <td>{(k.scopes || []).map((s: string) => <span class="em-badge" style="margin-inline-end:4px">{s}</span>)}</td>
                  <td>
                    {k.last_used_at
                      ? <span class="em-note" title={fullTime(k.last_used_at)}>{timeAgo(k.last_used_at)}</span>
                      : <span class="em-note">never used</span>}
                  </td>
                  <td><span class="em-note">{timeAgo(k.created_at)}</span></td>
                  <td><button type="button" class="em-btn ghost sm danger" data-k-revoke={k.id} data-name={k.name}>Revoke</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div></div>
      )}

      {revoked.length > 0 && (
        <div class="em-card-foot">
          <details style="width:100%">
            <summary style="cursor:pointer;font-size:12.5px;font-weight:620;color:var(--em-ink-3)">
              {revoked.length} revoked key{revoked.length === 1 ? '' : 's'} — kept so past calls can still be attributed
            </summary>
            <div style="margin-top:10px">
              {revoked.map((k: any) => (
                <p class="em-row tight" style="font-size:12px;padding:4px 0;border-bottom:1px solid var(--em-line)">
                  <code class="em-mono">{k.key_prefix}…</code>
                  <span>{k.name}</span>
                  <span class="em-note em-push">revoked {timeAgo(k.revoked_at)}</span>
                </p>
              ))}
            </div>
          </details>
        </div>
      )}
    </div>

    <!-- Webhooks ------------------------------------------------------------------------------- -->
    <div class="em-card">
      <div class="em-card-head">
        <div><h2 class="em-h2">Webhooks</h2>
          <p class="em-note">Delivery events POSTed to your endpoint, signed.</p></div>
      </div>

      {hooks.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="webhook" size={34} strokeWidth={1.3} />
          <h3>No webhooks</h3>
          <p>
            Add one to receive sends, opens, clicks, bounces and complaints as they happen, rather than
            polling for them.
          </p>
          <button type="button" class="em-btn pri" data-k-hook><MailIcon name="plus" size={15} /> Add a webhook</button>
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">Endpoint</th><th scope="col">Events</th><th scope="col">State</th>
              <th scope="col">Last delivery</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {hooks.map((h: any) => (
                <tr>
                  <td><code class="em-mono" style="word-break:break-all">{h.url}</code></td>
                  <td>{(h.events || []).map((ev: string) => <span class="em-badge" style="margin-inline-end:4px">{ev}</span>)}</td>
                  <td>
                    <span class={'em-badge ' + (h.is_active ? 'ok' : '')}>{h.is_active ? 'active' : 'off'}</span>
                    {h.failure_count > 0 && (
                      <span class="em-badge bad" style="margin-inline-start:4px" title="Twenty consecutive failures switches a webhook off automatically.">
                        {h.failure_count} failing
                      </span>
                    )}
                  </td>
                  <td><span class="em-note">{h.last_delivery_at ? timeAgo(h.last_delivery_at) : 'never'}</span></td>
                  <td>
                    <span class="em-row tight" style="flex-wrap:nowrap">
                      <button type="button" class="em-btn ghost sm" data-k-test={h.id}>Test</button>
                      <button type="button" class="em-btn ghost sm" data-k-log={h.id}>Log</button>
                      <button type="button" class="em-btn ghost sm" data-k-toggle={h.id} data-active={String(h.is_active)}>
                        {h.is_active ? 'Disable' : 'Enable'}
                      </button>
                      <button type="button" class="em-btn ghost sm danger" data-k-delhook={h.id}>Delete</button>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div></div>
      )}

      <div class="em-card-foot">
        <p class="em-note">
          Each delivery carries <code class="em-mono">X-EduRankAI-Signature</code> =
          sha256(secret + &ldquo;.&rdquo; + timestamp + &ldquo;.&rdquo; + body). Recompute it to verify the
          request came from here. Twenty consecutive failures switch a webhook off — continuing to post
          at a dead endpoint is how a product ends up on somebody else&rsquo;s abuse list.
        </p>
      </div>
    </div>

    <div id="kLog"></div>
  </div>

  <!-- Create key -->
  <div class="em-modal" id="kModal" hidden>
    <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="kTitle">
      <div class="em-modal-head"><h2 id="kTitle">Create an API key</h2></div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-k-err hidden><p></p></div>
        <div class="em-alert warn">
          <MailIcon name="warning" size={16} />
          <p>The key is shown <strong>once</strong>, on the next screen. Only a hash is stored — there is
            no page, and no support request, that can show it again.</p>
        </div>
        <label class="em-field"><span class="em-label">Name <span class="req">*</span></span>
          <input class="em-input" id="kName" data-autofocus placeholder="Applicant portal" />
          <span class="em-hint">Which system will use it. That is the only question a list of keys has to answer.</span></label>
        <fieldset style="border:none;padding:0">
          <legend class="em-label">Permissions <span class="req">*</span></legend>
          {API_SCOPES.map((s) => (
            <label class="em-check" style="display:flex;align-items:flex-start;gap:8px;margin-bottom:8px">
              <input type="checkbox" data-k-scope value={s.key} style="margin-top:3px" />
              <span><strong style="font-size:12.5px">{s.label}</strong>
                <span class="em-note" style="display:block">{s.detail}</span></span>
            </label>
          ))}
        </fieldset>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-k-create>Create key</button>
        <button type="button" class="em-btn ghost" data-k-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <!-- Reveal (once) -->
  <div class="em-modal" id="kReveal" hidden>
    <div class="em-modal-card" role="alertdialog" aria-modal="true" aria-labelledby="kRevealTitle">
      <div class="em-modal-head"><h2 id="kRevealTitle">Copy this key now</h2></div>
      <div class="em-modal-body">
        <p class="em-lede" style="margin-bottom:14px" data-k-note></p>
        <div class="em-row tight">
          <input class="em-input em-mono" id="kSecret" readonly data-autofocus style="flex:1" />
          <button type="button" class="em-btn" data-k-copy><MailIcon name="copy" size={14} /> Copy</button>
        </div>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-k-done>I have stored it</button>
      </div>
    </div>
  </div>

  <!-- Add webhook -->
  <div class="em-modal" id="kHookModal" hidden>
    <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="kHookTitle">
      <div class="em-modal-head"><h2 id="kHookTitle">Add a webhook</h2></div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-k-herr hidden><p></p></div>
        <label class="em-field"><span class="em-label">Endpoint URL <span class="req">*</span></span>
          <input class="em-input" id="kUrl" data-autofocus placeholder="https://example.com/hooks/mail" />
          <span class="em-hint">https only. Delivery events carry recipient addresses and must not travel unencrypted.</span></label>
        <fieldset style="border:none;padding:0">
          <legend class="em-label">Events <span class="req">*</span></legend>
          <div class="em-row">
            {WEBHOOK_EVENTS.map((ev) => (
              <label class="em-check"><input type="checkbox" data-k-event value={ev.key} /> {ev.label}</label>
            ))}
          </div>
        </fieldset>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-k-createhook>Add webhook</button>
        <button type="button" class="em-btn ghost" data-k-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <script src="/mail/keys.js" is:inline defer></script>
</MailShell>
