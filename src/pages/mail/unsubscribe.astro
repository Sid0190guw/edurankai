---
/**
 * /mail/unsubscribe — the public opt-out page.
 *
 * THE ONE PAGE IN THIS PRODUCT WITH NO SIGN-IN, AND IT HAS TO BE. Every campaign footer links here
 * with {{unsubscribe_url}}; a link that asked somebody to log in before they could stop receiving
 * mail is a link that produces a spam complaint instead of an unsubscribe, and complaints damage
 * delivery for everybody else on the domain.
 *
 * IT DOES NOT UNSUBSCRIBE ON GET. A GET must be safe: mail clients, link scanners and corporate
 * security gateways prefetch every URL in a message, and a one-click GET unsubscribe would opt
 * people out who never saw the page. The GET shows a page with a button; the POST does the work.
 *
 * IT REVEALS NOTHING. The contact id is a uuid supplied in the link. The page never displays the
 * address, never confirms whether the id exists, and answers the same way either way — otherwise it
 * is an oracle for testing whether an address is in this system.
 *
 * IT DOES NOT DO THE WORK ITSELF. An earlier version of this page ran its own UPDATE on
 * `mail_contacts.status`, which looks right and is half an opt-out: it never wrote
 * `mail_suppression`, so deleting the contact and re-importing the spreadsheet made a person who had
 * asked us to stop mailable again, and the transactional API — which reads that same table — kept
 * sending. It also left the person sitting in other campaigns' pending queues. All four steps live
 * in unsubscribeContact(); this page collects the click and reports the outcome.
 */
import { unsubscribeContact } from '@/lib/mail-campaigns';
import { dbReason } from '@/lib/mail-contacts';

const url = new URL(Astro.request.url);
const contactId = url.searchParams.get('c') || '';
const campaignId = url.searchParams.get('k') || '';
// Links minted by this engine carry the contact's own unsub_token; links minted by the core
// campaign engine do not. unsubscribeContact() verifies one when it is there and accepts the
// id alone when it is not, so mail already in people's inboxes keeps working.
const token = url.searchParams.get('t') || '';

let done = false;
let failed = false;

// Astro.clientAddress THROWS on an adapter that does not provide it, and an unsubscribe page that
// 500s because it wanted an IP for a log line would be an absurd way to fail. It is optional data.
let clientIp: string | undefined;
try {
  clientIp = Astro.clientAddress || undefined;
} catch {
  clientIp = Astro.request.headers.get('x-forwarded-for') || undefined;
}

if (Astro.request.method === 'POST') {
  try {
    const res = await unsubscribeContact(contactId, token || null, campaignId || null, {
      ip: clientIp,
      userAgent: Astro.request.headers.get('user-agent') || undefined,
      source: 'Unsubscribe page',
    });
    // `done` regardless of whether a row matched — an unknown id, an invalid token and an
    // already-unsubscribed contact must all be indistinguishable from a successful one, or this
    // page enumerates the audience. A genuine WRITE failure is a different thing and is not hidden:
    // unsubscribeContact() throws for those, and the catch below reports them.
    done = true;
    if (!res.ok) console.warn('[mail/unsubscribe] refused for ' + contactId + ': ' + res.error);
  } catch (e: any) {
    // A failure is reported HONESTLY. Telling somebody they have been unsubscribed when the write
    // threw is the single worst thing this page could do: they stop trying, and keep receiving mail.
    failed = true;
    console.error('[mail/unsubscribe] failed:', dbReason(e));
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Email preferences · EduRankAI</title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;
      font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      background: #F6F7F9; color: #1E293B; }
    .card { background: #fff; border: 1px solid #E3E8EF; border-radius: 16px; padding: 40px 34px;
      max-width: 480px; width: 100%; box-shadow: 0 2px 12px rgba(11, 18, 32, 0.07); text-align: center; }
    .mark { width: 40px; height: 40px; border-radius: 10px; background: #FF4F00; display: grid;
      place-items: center; margin: 0 auto 20px; }
    h1 { font-size: 21px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 10px; color: #0B1220; }
    p { font-size: 14px; line-height: 1.65; color: #475569; margin: 0 0 18px; }
    .btn { display: inline-block; border: 1px solid #CFD8E3; background: #fff; color: #1E293B;
      font: inherit; font-size: 14px; font-weight: 620; padding: 11px 22px; border-radius: 7px;
      cursor: pointer; text-decoration: none; }
    .btn.pri { background: #FF4F00; border-color: #FF4F00; color: #fff; }
    .btn:focus-visible { outline: 2px solid #FF4F00; outline-offset: 2px; }
    .note { font-size: 12px; color: #7C8AA0; margin-top: 22px; }
    .bad { background: #FCECEA; border: 1px solid #B3261E; color: #B3261E; border-radius: 10px;
      padding: 12px 14px; font-size: 13.5px; line-height: 1.55; text-align: start; }
    @media (prefers-color-scheme: dark) {
      body { background: #0B0E13; color: #DCE3EC; }
      .card { background: #12161D; border-color: #232A35; }
      h1 { color: #F2F5F9; } p { color: #A3B0C2; }
      .btn { background: #12161D; border-color: #303948; color: #DCE3EC; }
      .btn.pri { background: #FF4F00; border-color: #FF4F00; color: #fff; }
      .bad { background: #2A1412; border-color: #F98F87; color: #F98F87; }
    }
  </style>
</head>
<body>
  <main class="card">
    <div class="mark" aria-hidden="true">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>
      </svg>
    </div>

    {failed && (
      <>
        <h1>That did not go through</h1>
        <p class="bad">
          Something went wrong on our side and <strong>you have not been unsubscribed</strong>. Please
          try once more. If it fails again, reply to the message you received and we will do it by hand
          — do not assume it worked.
        </p>
        <form method="post">
          <button type="submit" class="btn pri">Try again</button>
        </form>
      </>
    )}

    {done && !failed && (
      <>
        <h1>You have been unsubscribed</h1>
        <p>
          You will not receive further campaign emails from EduRankAI. It can take a few minutes for a
          send already in progress to stop.
        </p>
        <p class="note">
          Messages sent directly to you by a person, and anything required about an application you
          have made, are not campaign email and are not affected.
        </p>
      </>
    )}

    {!done && !failed && (
      <>
        <h1>Unsubscribe from these emails?</h1>
        <p>
          You will stop receiving campaign emails from EduRankAI. Nothing happens until you press the
          button below.
        </p>
        <form method="post">
          <button type="submit" class="btn pri">Unsubscribe me</button>
        </form>
        <p class="note">
          Pressed by mistake? Just close this page — nothing has been changed.
        </p>
      </>
    )}
  </main>
</body>
</html>
