---
/**
 * /mail/domains — sending domains and their four DNS records.
 *
 * THE MOST DANGEROUS SCREEN IN THIS PRODUCT, and the reason is specific. Its documented next step is
 * "add a DNS record", and a SECOND SPF record makes providers treat the whole domain as failing SPF.
 * So a lookup that TIMED OUT must never be rendered as "no SPF record found" — that reading would
 * talk an operator into breaking mail delivery for the company.
 *
 * /api/mail/dns-check.ts already distinguishes those two cases and travels the reasons back in
 * `unchecked`. This screen calls that route, shows a fourth state ("Not checked") in its own right,
 * and recordCheck() refuses to downgrade a previously-verified record on the strength of a lookup
 * that did not complete.
 *
 * THE DKIM ROW DOES NOT PRINT A MADE-UP KEY. This platform relays through the configured SMTP
 * account and holds no signing key, so the setup card says where the real value comes from. A setup
 * screen that shows an invented DKIM record guarantees a failed check.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listDomains, setupRecords, RECORD_WORDING, type RecordStatus } from '@/lib/mail-product/domains';
import { transportStatus } from '@/lib/mail-transport';
import { MAIL_DOMAIN } from '@/lib/mail';
import { timeAgo, fullTime, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let domains: any[] = [];
let transport = { mode: 'none', detail: '' };
let error = '';

if (access.allowed) {
  try {
    [domains, transport] = await Promise.all([
      listDomains(),
      transportStatus().catch(() => ({ mode: 'none' as const, detail: 'Could not be read' })),
    ]);
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/domains] read failed:', error);
  }
}

const RECORDS: { key: string; label: string; what: string }[] = [
  { key: 'spf', label: 'SPF', what: 'Says which servers may send as this domain.' },
  { key: 'dkim', label: 'DKIM', what: 'Signs each message so it cannot be altered in transit.' },
  { key: 'dmarc', label: 'DMARC', what: 'Tells receivers what to do when SPF and DKIM disagree.' },
  { key: 'mx', label: 'MX', what: 'Where mail TO this domain is delivered. Not needed to send.' },
];
---
<MailShell title="Domains" active="domains" subtitle="Authentication for the addresses you send from">
  <button slot="actions" type="button" class="em-btn" data-d-checkall><MailIcon name="refresh" size={15} /> Check all</button>
  <button slot="actions" type="button" class="em-btn pri" data-d-add><MailIcon name="plus" size={15} /> Add domain</button>

  <div class="em-wrap em-stack" id="dRoot">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>Domains could not be read.</strong> {error}</p></div>
    )}

    <div class="em-alert info">
      <MailIcon name="info" size={16} />
      <p>
        Unauthenticated mail is spam-foldered by most providers, whatever it says. Get SPF, DKIM and
        DMARC to <strong>Verified</strong> before a real campaign goes out. MX matters only if this
        domain also <em>receives</em> mail — a send-only domain is not failing without one.
      </p>
    </div>

    {transport.mode === 'none' && (
      <div class="em-alert warn">
        <MailIcon name="warning" size={16} />
        <p>
          No SMTP transport is configured, so nothing can be sent from any of these domains yet.
          Set the mail server in <a href="/admin/mail/settings">Mail settings</a>.
        </p>
      </div>
    )}

    {domains.length === 0 ? (
      <div class="em-card"><div class="em-empty">
        <MailIcon name="domains" size={38} strokeWidth={1.3} />
        <h3>No domains added</h3>
        <p>
          Add the domain your From address uses — for this system that is normally
          <code class="em-mono"> {MAIL_DOMAIN}</code> — and this screen will check its records and
          tell you exactly what to create.
        </p>
        <button type="button" class="em-btn pri" data-d-add><MailIcon name="plus" size={15} /> Add a domain</button>
      </div></div>
    ) : (
      domains.map((d: any) => (
        <div class="em-card" data-d-card={d.id}>
          <div class="em-card-head">
            <div style="min-width:0;flex:1">
              <h2 class="em-h2 em-mono">{d.domain}</h2>
              <p class="em-note" data-d-checked>
                {d.last_checked_at ? 'Checked ' + timeAgo(d.last_checked_at) : 'Never checked'}
                {d.verified_at && ' · verified ' + fullTime(d.verified_at)}
              </p>
            </div>
            <span class={'em-badge ' + (d.status === 'verified' ? 'ok' : d.status === 'failed' ? 'bad' : 'warn')}>
              <span class="em-dot"></span>
              {d.status === 'verified' ? 'Sending ready' : d.status === 'failed' ? 'Failing' : 'Pending'}
            </span>
            <button type="button" class="em-btn sm" data-d-check={d.domain} data-id={d.id}>
              <MailIcon name="refresh" size={13} /> Check now
            </button>
          </div>

          <div class="em-card-body flush">
            <div class="em-tablewrap">
              <table class="em-table">
                <thead><tr>
                  <th scope="col">Record</th><th scope="col">Status</th>
                  <th scope="col">What it does</th><th scope="col">Found</th>
                </tr></thead>
                <tbody>
                  {RECORDS.map((r) => {
                    const st = (d[r.key + '_status'] || 'pending') as RecordStatus;
                    const w = RECORD_WORDING[st] || RECORD_WORDING.pending;
                    const detail = d.detail?.[r.key];
                    const found = r.key === 'mx'
                      ? (d.detail?.mx || []).map((m: any) => `${m.host} (${m.priority})`).join(', ')
                      : detail?.record || (detail?.selectors || []).map((s: any) => s.selector).join(', ') || '';
                    return (
                      <tr data-d-row={r.key}>
                        <td><strong>{r.label}</strong></td>
                        <td>
                          <span class={'em-badge ' + (w.tone === 'muted' ? '' : w.tone)} title={w.detail}>{w.label}</span>
                        </td>
                        <td><span class="em-note">{r.what}</span></td>
                        <td>
                          {found
                            ? <code class="em-mono" style="word-break:break-all;font-size:11px">{String(found).slice(0, 160)}</code>
                            : <span class="em-note">—</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {(d.detail?.unchecked || []).length > 0 && (
              <div class="em-alert warn" style="margin:16px">
                <MailIcon name="warning" size={15} />
                <div>
                  <strong>Some lookups did not complete.</strong>
                  <p style="margin-top:4px">
                    {(d.detail.unchecked as string[]).join(' · ')}. Those rows show the last answer we had —
                    they are <em>not</em> a verdict on your DNS. Do not add a record on the strength of a
                    row marked &ldquo;Not checked&rdquo;: a second SPF record makes the domain fail SPF outright.
                  </p>
                </div>
              </div>
            )}

            {d.detail?.spf?.multiple && (
              <div class="em-alert bad" style="margin:16px">
                <MailIcon name="warning" size={15} />
                <p>
                  <strong>More than one SPF record.</strong> Receivers treat that as a permanent error and the
                  domain fails SPF entirely. Merge them into a single <code class="em-mono">v=spf1 … ~all</code>.
                </p>
              </div>
            )}

            <details style="margin:16px">
              <summary style="cursor:pointer;font-size:12.5px;font-weight:620;color:var(--em-ink-3)">
                Records to create at your DNS host
              </summary>
              <div class="em-tablewrap" style="margin-top:12px">
                <table class="em-table">
                  <thead><tr><th scope="col">Type</th><th scope="col">Host</th><th scope="col">Value</th></tr></thead>
                  <tbody>
                    {setupRecords(d.domain).map((rec) => (
                      <tr>
                        <td><strong>{rec.type}</strong></td>
                        <td><code class="em-mono" style="word-break:break-all">{rec.host}</code></td>
                        <td>
                          <code class="em-mono" style="word-break:break-all">{rec.value}</code>
                          <p class="em-note" style="margin-top:5px">{rec.note}</p>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </div>

          <div class="em-card-foot">
            <button type="button" class="em-btn ghost sm danger em-push" data-d-del={d.id} data-name={d.domain}>Remove</button>
          </div>
        </div>
      ))
    )}
  </div>

  <script src="/mail/domains.js" is:inline defer></script>
</MailShell>
