---
/**
 * /mail/contacts/lists — lists, segments and custom fields.
 *
 * THE DISTINCTION THIS PAGE HAS TO TEACH, because getting it wrong is how a campaign goes to the
 * wrong people:
 *   A LIST is a membership. Somebody is on it until they are taken off. It is a fact about the past.
 *   A SEGMENT is a filter. It matches whoever fits the rules RIGHT NOW, and its size changes without
 *   anybody touching it.
 * The segment builder shows the live count as the rules are edited, which is the only way to see the
 * difference rather than be told about it.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listLists, listSegments, listCustomFields } from '@/lib/mail-product/contacts';
import { num, timeAgo, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let lists: any[] = [];
let segments: any[] = [];
let fields: any[] = [];
let error = '';

if (access.allowed) {
  try {
    [lists, segments, fields] = await Promise.all([listLists(), listSegments(), listCustomFields()]);
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/lists] read failed:', error);
  }
}

const FIELD_LABELS: Record<string, string> = {
  email: 'Email', first_name: 'First name', last_name: 'Last name', status: 'Status',
  tag: 'Tag', list: 'List', source: 'Source', created_at: 'Date added', field: 'Custom field',
};
const OP_LABELS: Record<string, string> = {
  is: 'is', is_not: 'is not', contains: 'contains', not_contains: 'does not contain',
  starts_with: 'starts with', ends_with: 'ends with', is_set: 'is set', is_not_set: 'is not set',
  before: 'before', after: 'on or after',
};

function describeRules(r: any): string {
  const cs = (r?.conditions || []);
  if (!cs.length) return 'No conditions — matches every contact.';
  return cs.map((c: any) =>
    `${FIELD_LABELS[c.field] || c.field}${c.field === 'field' && c.key ? ` (${c.key})` : ''} ${OP_LABELS[c.op] || c.op}${c.value ? ' ' + c.value : ''}`
  ).join(r.match === 'any' ? '  OR  ' : '  AND  ');
}
---
<MailShell title="Lists & segments" active="lists" subtitle="Who a campaign can be addressed to">
  <button slot="actions" type="button" class="em-btn" data-ls-new-field><MailIcon name="plus" size={15} /> Field</button>
  <button slot="actions" type="button" class="em-btn" data-ls-new-segment><MailIcon name="segment" size={15} /> New segment</button>
  <button slot="actions" type="button" class="em-btn pri" data-ls-new-list><MailIcon name="plus" size={15} /> New list</button>

  <div class="em-wrap em-stack">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>This page could not be read.</strong> {error}</p></div>
    )}

    <div class="em-alert info">
      <MailIcon name="info" size={16} />
      <p>
        A <strong>list</strong> is a membership somebody stays on until they are removed.
        A <strong>segment</strong> is a filter that re-evaluates every time it is used — its size
        changes on its own as contacts are added, tagged or unsubscribed. A campaign addressed to a
        segment sends to whoever matched at the moment it was queued, and that set is frozen from then on.
      </p>
    </div>

    <!-- Lists ------------------------------------------------------------------------------ -->
    <div class="em-card">
      <div class="em-card-head">
        <div><h2 class="em-h2">Lists</h2><p class="em-note">Explicit membership.</p></div>
      </div>
      {lists.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="list" size={34} strokeWidth={1.3} />
          <h3>No lists yet</h3>
          <p>Create one for each audience you send to — applicants, partner institutions, staff.</p>
          <button type="button" class="em-btn pri" data-ls-new-list><MailIcon name="plus" size={15} /> Create a list</button>
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">List</th><th scope="col">Address</th>
              <th scope="col" class="num">Members</th><th scope="col">Created</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {lists.map((l) => (
                <tr data-id={l.id}>
                  <td>
                    <a href={`/mail/contacts?listId=${l.id}`}>{l.name}</a>
                    {l.description && <div class="em-note">{l.description}</div>}
                  </td>
                  <td><code class="em-mono">{l.slug}</code></td>
                  <td class="num">{num(l.member_count)}</td>
                  <td><span class="em-note">{timeAgo(l.created_at)}</span></td>
                  <td>
                    <button type="button" class="em-btn ghost sm danger" data-ls-del-list={l.id} data-name={l.name}>Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div></div>
      )}
    </div>

    <!-- Segments ---------------------------------------------------------------------------- -->
    <div class="em-card">
      <div class="em-card-head">
        <div><h2 class="em-h2">Segments</h2><p class="em-note">Stored filters, evaluated live.</p></div>
      </div>
      {segments.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="segment" size={34} strokeWidth={1.3} />
          <h3>No segments yet</h3>
          <p>A segment picks people out by what is true of them — a tag, a status, a custom field, a date.</p>
          <button type="button" class="em-btn pri" data-ls-new-segment><MailIcon name="plus" size={15} /> Build a segment</button>
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">Segment</th><th scope="col">Rules</th>
              <th scope="col" class="num">Matches now</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {segments.map((s) => (
                <tr data-id={s.id}>
                  <td><a href={`/mail/contacts?segmentId=${s.id}`}>{s.name}</a>
                    {s.description && <div class="em-note">{s.description}</div>}</td>
                  <td><span class="em-note">{describeRules(s.rules)}</span></td>
                  <td class="num"><span data-ls-count={s.id} class="em-skel" style="display:inline-block;width:40px;height:14px">&nbsp;</span></td>
                  <td>
                    <button type="button" class="em-btn ghost sm" data-ls-edit-segment={s.id}
                            data-payload={JSON.stringify({ id: s.id, name: s.name, description: s.description, rules: s.rules })}>Edit</button>
                    <button type="button" class="em-btn ghost sm danger" data-ls-del-segment={s.id} data-name={s.name}>Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div></div>
      )}
    </div>

    <!-- Custom fields ------------------------------------------------------------------------ -->
    <div class="em-card">
      <div class="em-card-head">
        <div><h2 class="em-h2">Custom fields</h2>
          <p class="em-note">Declared once, then offered in the contact form, the CSV importer and the variable picker.</p></div>
      </div>
      <div class="em-card-body">
        {fields.length === 0
          ? <p class="em-note">None yet. Built-in variables — <code class="em-mono">{'{{first_name}}'}</code>, <code class="em-mono">{'{{last_name}}'}</code>, <code class="em-mono">{'{{email}}'}</code> — always work.</p>
          : (
            <div class="em-row">
              {fields.map((f) => (
                <span class="em-chip">
                  {f.label} <code class="em-mono">{`{{${f.key}}}`}</code>
                  <button type="button" data-ls-del-field={f.id} aria-label={`Delete the ${f.label} field`}>
                    <MailIcon name="close" size={11} />
                  </button>
                </span>
              ))}
            </div>
          )}
      </div>
    </div>
  </div>

  <!-- List dialog -->
  <div class="em-modal" id="lsListModal" hidden>
    <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="lsListTitle">
      <div class="em-modal-head"><h2 id="lsListTitle">New list</h2></div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-ls-err hidden><p></p></div>
        <label class="em-field"><span class="em-label">Name <span class="req">*</span></span>
          <input class="em-input" id="lsListName" data-autofocus /></label>
        <label class="em-field"><span class="em-label">Description</span>
          <textarea class="em-textarea" id="lsListDesc" rows="2"></textarea></label>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-ls-save-list>Create list</button>
        <button type="button" class="em-btn ghost" data-ls-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <!-- Segment builder -->
  <div class="em-modal" id="lsSegModal" hidden>
    <div class="em-modal-card wide" role="dialog" aria-modal="true" aria-labelledby="lsSegTitle">
      <div class="em-modal-head">
        <h2 id="lsSegTitle">New segment</h2>
        <span class="em-badge accent em-push" data-ls-live>counting…</span>
      </div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-ls-serr hidden><p></p></div>
        <label class="em-field"><span class="em-label">Name <span class="req">*</span></span>
          <input class="em-input" id="lsSegName" data-autofocus /></label>

        <div class="em-row tight" style="margin-bottom:12px">
          <span class="em-label" style="margin:0">Match</span>
          <select class="em-select" id="lsSegMatch" style="width:auto">
            <option value="all">all of these conditions</option>
            <option value="any">any of these conditions</option>
          </select>
        </div>

        <div id="lsConds"></div>
        <button type="button" class="em-btn sm" data-ls-add-cond><MailIcon name="plus" size={13} /> Add condition</button>

        <p class="em-hint" style="margin-top:14px">
          The count above updates as you edit and is the number of contacts matching <em>right now</em>.
          With no conditions a segment matches everybody, which is almost never what is wanted on a campaign.
        </p>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-ls-save-seg>Save segment</button>
        <button type="button" class="em-btn ghost" data-ls-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="lsData" set:html={JSON.stringify({
    lists: lists.map((l) => ({ id: l.id, name: l.name })),
    fields: fields.map((f) => ({ key: f.key, label: f.label })),
    segments: segments.map((s) => ({ id: s.id, rules: s.rules })),
  })}></script>
  <script src="/mail/lists.js" is:inline defer></script>
</MailShell>
