---
/**
 * /mail/contacts/import — CSV import, in two steps.
 *
 * PREVIEW BEFORE WRITE, ALWAYS. Step one parses the file, shows the first rows, lets the column
 * mapping be corrected, and reports how many addresses are valid, invalid and duplicated — and it
 * writes NOTHING. Step two does the work. A one-step import is how somebody finds out afterwards
 * that column three was phone numbers.
 *
 * THE FILE NEVER LEAVES THE BROWSER UNTIL STEP TWO except as text for the preview, and it is never
 * stored: this product has no upload path and does not want one (see the note about links in
 * /api/mail/send.ts). The CSV is read with FileReader and posted as a string.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listLists, listCustomFields } from '@/lib/mail-product/contacts';
import { reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let lists: any[] = [];
let fields: any[] = [];
if (access.allowed) {
  try {
    [lists, fields] = await Promise.all([listLists(), listCustomFields()]);
  } catch (e: any) {
    console.error('[mail/import] read failed:', reasonOf(e));
  }
}
---
<MailShell
  title="Import contacts"
  active="contacts"
  subtitle="CSV"
  crumbs={[{ label: 'Contacts', href: '/mail/contacts' }, { label: 'Import' }]}
>
  <div class="em-wrap narrow em-stack" id="imRoot">

    <ol class="im-steps" aria-label="Import steps">
      <li data-im-step="1" aria-current="step"><span>1</span> Choose a file</li>
      <li data-im-step="2"><span>2</span> Check the columns</li>
      <li data-im-step="3"><span>3</span> Import</li>
    </ol>

    <!-- Step 1 --------------------------------------------------------------------------------- -->
    <section class="em-card" data-im-panel="1">
      <div class="em-card-head"><h2 class="em-h2">Choose a CSV file</h2></div>
      <div class="em-card-body">
        <div class="im-drop" id="imDrop" tabindex="0" role="button" aria-label="Choose a CSV file, or drop one here">
          <MailIcon name="upload" size={30} strokeWidth={1.4} />
          <p class="em-h3" style="margin-top:10px">Drop a CSV here, or press to choose one</p>
          <p class="em-note">The first row must be column headings. Up to 12 MB, or 50,000 rows.</p>
          <input type="file" id="imFile" accept=".csv,text/csv" hidden />
        </div>

        <div class="em-alert bad" data-im-err hidden style="margin-top:16px"><p></p></div>

        <div class="em-alert info" style="margin-top:16px">
          <MailIcon name="info" size={16} />
          <p>
            An address that already exists is <strong>updated, not duplicated</strong>. Anybody who has
            unsubscribed, bounced or complained <strong>stays suppressed</strong> — an import cannot
            resubscribe somebody, because that is exactly how a suppression list gets wiped by accident.
          </p>
        </div>
      </div>
    </section>

    <!-- Step 2 --------------------------------------------------------------------------------- -->
    <section class="em-card" data-im-panel="2" hidden>
      <div class="em-card-head">
        <h2 class="em-h2">Check the columns</h2>
        <span class="em-badge em-push" data-im-filename></span>
      </div>
      <div class="em-card-body">
        <div class="em-grid c4" style="margin-bottom:20px">
          <div class="em-stat"><p class="em-stat-k">Rows</p><p class="em-stat-v" data-im-rows>0</p></div>
          <div class="em-stat"><p class="em-stat-k">Valid</p><p class="em-stat-v" data-im-valid>0</p>
            <p class="em-stat-d">will be imported</p></div>
          <div class="em-stat"><p class="em-stat-k">Duplicates</p><p class="em-stat-v" data-im-dupes>0</p>
            <p class="em-stat-d">within the file</p></div>
          <div class="em-stat"><p class="em-stat-k">Rejected</p><p class="em-stat-v" data-im-invalid>0</p>
            <p class="em-stat-d">not an address</p></div>
        </div>

        <div class="em-alert warn" data-im-noemail hidden>
          <MailIcon name="warning" size={16} />
          <p><strong>No column is mapped to the email address.</strong> Pick it below — nothing can be imported without it.</p>
        </div>

        <h3 class="em-h3" style="margin-bottom:8px">Column mapping</h3>
        <div class="em-tablewrap">
          <table class="em-table">
            <thead><tr><th scope="col">Column in your file</th><th scope="col">Import as</th><th scope="col">First value</th></tr></thead>
            <tbody data-im-map></tbody>
          </table>
        </div>

        <h3 class="em-h3" style="margin:22px 0 8px">First rows, as they will be read</h3>
        <div class="em-tablewrap"><table class="em-table" data-im-sample></table></div>

        <div class="em-grid c2" style="margin-top:22px">
          <label class="em-field">
            <span class="em-label" for="imList">Add everyone to a list</span>
            <select class="em-select" id="imList">
              <option value="">Do not add to a list</option>
              {lists.map((l) => <option value={l.id}>{l.name}</option>)}
            </select>
            <span class="em-hint">A campaign can only be addressed to a list or a segment, so an import with neither is an audience nothing can reach.</span>
          </label>
          <label class="em-field">
            <span class="em-label" for="imTags">Tag everyone</span>
            <input class="em-input" id="imTags" placeholder="comma, separated" />
            <span class="em-hint">Useful for segmenting later — for example the source or the intake month.</span>
          </label>
        </div>
      </div>
      <div class="em-card-foot">
        <button type="button" class="em-btn pri" data-im-run>Import contacts</button>
        <button type="button" class="em-btn ghost" data-im-back>Choose a different file</button>
      </div>
    </section>

    <!-- Step 3 --------------------------------------------------------------------------------- -->
    <section class="em-card" data-im-panel="3" hidden>
      <div class="em-card-head"><h2 class="em-h2">Result</h2></div>
      <div class="em-card-body">
        <div class="em-grid c3" style="margin-bottom:20px">
          <div class="em-stat"><p class="em-stat-k">Created</p><p class="em-stat-v" data-im-created>0</p></div>
          <div class="em-stat"><p class="em-stat-k">Updated</p><p class="em-stat-v" data-im-updated>0</p></div>
          <div class="em-stat"><p class="em-stat-k">Rejected</p><p class="em-stat-v" data-im-rejected>0</p></div>
        </div>
        <div data-im-rejects></div>
      </div>
      <div class="em-card-foot">
        <a class="em-btn pri" href="/mail/contacts">See the contacts</a>
        <button type="button" class="em-btn" data-im-back>Import another file</button>
      </div>
    </section>
  </div>

  <script type="application/json" id="imFields" set:html={JSON.stringify(fields.map((f) => ({ key: f.key, label: f.label })))}></script>
  <script src="/mail/import.js" is:inline defer></script>
</MailShell>

<style>
  .im-steps { display: flex; gap: var(--em-2); list-style: none; margin: 0 0 var(--em-4); padding: 0; flex-wrap: wrap; }
  .im-steps li { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 620;
    color: var(--em-ink-4); padding: 7px 14px; border-radius: var(--em-r-full); background: var(--em-surface-3); }
  .im-steps li span { width: 18px; height: 18px; border-radius: 50%; background: var(--em-line-2);
    color: var(--em-surface); display: grid; place-items: center; font-size: 11px; }
  .im-steps li[aria-current="step"] { background: var(--em-accent-soft); color: var(--em-ink); }
  .im-steps li[aria-current="step"] span { background: var(--em-accent); color: #fff; }
  .im-steps li[data-done] span { background: var(--em-ok); color: #fff; }

  .im-drop { border: 2px dashed var(--em-line-2); border-radius: var(--em-r-lg); padding: var(--em-10) var(--em-5);
    text-align: center; color: var(--em-ink-4); cursor: pointer; transition: border-color var(--em-t), background var(--em-t); }
  .im-drop:hover, .im-drop:focus-visible, .im-drop.over { border-color: var(--em-accent); background: var(--em-accent-soft); }
</style>
