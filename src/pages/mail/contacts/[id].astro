---
/**
 * /mail/contacts/[id] — one person.
 *
 * WHAT A CONTACT PROFILE IS FOR. Answering, in one screen, the four questions somebody opens it to
 * ask: who is this, may we mail them, what have we sent them, and did they read it. The subscription
 * state is the loudest thing on the page, because it is the one that decides whether the other three
 * matter.
 *
 * THE STATUS CONTROL IS EXPLICIT AND ONE-WAY-ISH. Resubscribing somebody is a deliberate act with a
 * confirmation that says what it means, because the only lawful reason to do it is that they asked.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getContact, contactLists, contactActivity, listLists, listCustomFields } from '@/lib/mail-product/contacts';
import { initials, avatarColour, timeAgo, fullTime, num, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);
const id = String(Astro.params.id || '');

let contact: any = null;
let lists: any[] = [];
let allLists: any[] = [];
let activity: any[] = [];
let fields: any[] = [];
let error = '';

if (access.allowed) {
  try {
    contact = await getContact(id);
    if (contact) {
      const [l, a, al, f] = await Promise.all([
        contactLists(id).catch(() => []),
        contactActivity(id, 50).catch(() => []),
        listLists().catch(() => []),
        listCustomFields().catch(() => []),
      ]);
      lists = l; activity = a; allLists = al; fields = f;
    }
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/contact] read failed:', error);
  }
}

const name = contact ? ([contact.first_name, contact.last_name].filter(Boolean).join(' ') || contact.email) : '';
const STATUS_TONE: Record<string, string> = {
  subscribed: 'ok', unconfirmed: 'warn', unsubscribed: '', bounced: 'bad', complained: 'bad',
};
const STATUS_MEANS: Record<string, string> = {
  subscribed: 'Campaigns will be sent to this address.',
  unconfirmed: 'Added but not confirmed. Campaigns are not sent to unconfirmed addresses.',
  unsubscribed: 'They opted out. Campaigns are not sent, and an import will not resubscribe them.',
  bounced: 'Mail to this address failed hard. It is suppressed to protect the sending domain.',
  complained: 'They marked mail from us as spam. Continuing to send would damage every other send.',
};
const EVENT_TONE: Record<string, string> = {
  sent: '', delivered: 'ok', opened: 'info', clicked: 'accent',
  bounced: 'bad', failed: 'bad', complained: 'bad', unsubscribed: 'warn', deferred: 'warn',
};

const counts = activity.reduce((a: Record<string, number>, e: any) => {
  a[e.type] = (a[e.type] || 0) + 1;
  return a;
}, {});
---
<MailShell
  title={contact ? name : 'Contact'}
  active="contacts"
  subtitle={contact ? contact.email : ''}
  crumbs={[{ label: 'Contacts', href: '/mail/contacts' }, { label: contact ? name : 'Not found' }]}
>
  {contact && (
    <button slot="actions" type="button" class="em-btn" data-compose={JSON.stringify({ to: contact.email })}>
      <MailIcon name="edit" size={15} /> Message
    </button>
  )}

  <div class="em-wrap">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>This contact could not be read.</strong> {error}</p></div>
    )}

    {!contact && !error && (
      <div class="em-card"><div class="em-empty">
        <MailIcon name="contacts" size={36} strokeWidth={1.3} />
        <h3>No contact with that id</h3>
        <p>It may have been deleted, or the link may be out of date.</p>
        <a class="em-btn" href="/mail/contacts">Back to contacts</a>
      </div></div>
    )}

    {contact && (
      <div class="em-grid" style="grid-template-columns:minmax(0,1fr) 320px;align-items:start">
        <div class="em-stack">
          <div class="em-card">
            <div class="em-card-body">
              <div class="em-row" style="flex-wrap:nowrap;align-items:flex-start">
                <span class="em-avatar lg" aria-hidden="true" style={`background:${avatarColour(contact.email)}`}>
                  {initials(name, contact.email)}
                </span>
                <div style="min-width:0;flex:1">
                  <h2 class="em-h1" style="margin-bottom:2px">{name}</h2>
                  <p class="em-mono" style="color:var(--em-ink-3)">{contact.email}</p>
                  <p class="em-row tight" style="margin-top:10px">
                    <span class={'em-badge ' + (STATUS_TONE[contact.status] || '')}>{contact.status}</span>
                    {(contact.tags || []).map((t: string) => (
                      <a class="em-badge" href={`/mail/contacts?tag=${encodeURIComponent(t)}`} style="text-decoration:none">
                        <MailIcon name="tag" size={10} /> {t}
                      </a>
                    ))}
                  </p>
                </div>
              </div>
              <p class="em-alert info" style="margin:16px 0 0">
                <MailIcon name="info" size={15} />
                <span>{STATUS_MEANS[contact.status] || ''}</span>
              </p>
            </div>
          </div>

          <div class="em-card">
            <div class="em-card-head">
              <h2 class="em-h2">Activity</h2>
              <span class="em-note em-push">
                {Object.keys(counts).length
                  ? Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(' · ')
                  : 'nothing recorded'}
              </span>
            </div>
            {activity.length === 0 ? (
              <div class="em-empty" style="padding:36px 20px">
                <MailIcon name="analytics" size={30} strokeWidth={1.3} />
                <h3>No delivery events yet</h3>
                <p>
                  Sends, opens and clicks appear here once this person has been included in a campaign.
                  Mail sent from the composer is recorded in your mailbox, not here.
                </p>
              </div>
            ) : (
              <div class="em-card-body flush">
                <div class="em-tablewrap">
                  <table class="em-table">
                    <thead><tr><th scope="col">Event</th><th scope="col">Campaign</th><th scope="col">When</th></tr></thead>
                    <tbody>
                      {activity.map((e: any) => (
                        <tr>
                          <td>
                            <span class={'em-badge ' + (EVENT_TONE[e.type] || '')}>{e.type}</span>
                            {e.url && <div class="em-note em-mono" style="margin-top:3px;max-width:340px;overflow:hidden;text-overflow:ellipsis">{e.url}</div>}
                          </td>
                          <td>{e.campaign_id ? <a href={`/mail/campaigns/${e.campaign_id}`}>{e.campaign_name || 'Campaign'}</a> : <span class="em-note">—</span>}</td>
                          <td><span class="em-note" title={fullTime(e.created_at)}>{timeAgo(e.created_at)}</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="em-stack" id="cpSide" data-id={contact.id}>
          <div class="em-card">
            <div class="em-card-head"><h2 class="em-h2">Subscription</h2></div>
            <div class="em-card-body">
              <label class="em-field">
                <span class="em-label" for="cpStatus">Status</span>
                <select class="em-select" id="cpStatus">
                  {['subscribed', 'unconfirmed', 'unsubscribed', 'bounced', 'complained'].map((s) => (
                    <option value={s} selected={contact.status === s}>{s}</option>
                  ))}
                </select>
                <span class="em-hint">
                  Changing this is a deliberate act. Only set somebody back to <em>subscribed</em> if they
                  asked to be — an import will never do it for you.
                </span>
              </label>
              <p class="em-note">
                Subscribed {fullTime(contact.subscribed_at)}
                {contact.unsubscribed_at && <> · opted out {fullTime(contact.unsubscribed_at)}</>}
              </p>
            </div>
          </div>

          <div class="em-card">
            <div class="em-card-head"><h2 class="em-h2">Lists</h2></div>
            <div class="em-card-body">
              {lists.length === 0
                ? <p class="em-note">Not on any list, so no list-addressed campaign will reach this person.</p>
                : (
                  <div class="em-row tight">
                    {lists.map((l) => (
                      <a class="em-chip" href={`/mail/contacts?listId=${l.id}`} style="text-decoration:none">{l.name}</a>
                    ))}
                  </div>
                )}
              {allLists.length > 0 && (
                <label class="em-field" style="margin-top:14px">
                  <span class="em-label" for="cpAddList">Add to a list</span>
                  <div class="em-row tight">
                    <select class="em-select" id="cpAddList" style="flex:1">
                      <option value="">Choose…</option>
                      {allLists.filter((l) => !lists.some((x) => x.id === l.id)).map((l) => (
                        <option value={l.id}>{l.name}</option>
                      ))}
                    </select>
                    <button type="button" class="em-btn" data-cp-addlist>Add</button>
                  </div>
                </label>
              )}
            </div>
          </div>

          {(fields.length > 0 || Object.keys(contact.fields || {}).length > 0) && (
            <div class="em-card">
              <div class="em-card-head"><h2 class="em-h2">Fields</h2></div>
              <div class="em-card-body">
                {Object.entries(contact.fields || {}).length === 0 && <p class="em-note">No custom values stored.</p>}
                {Object.entries(contact.fields || {}).map(([k, v]) => (
                  <p class="em-row tight" style="justify-content:space-between;border-bottom:1px solid var(--em-line);padding:6px 0">
                    <code class="em-mono">{`{{${k}}}`}</code>
                    <span style="font-size:13px">{String(v)}</span>
                  </p>
                ))}
              </div>
            </div>
          )}

          <div class="em-card">
            <div class="em-card-head"><h2 class="em-h2">Danger zone</h2></div>
            <div class="em-card-body">
              <p class="em-note" style="margin-bottom:12px">
                Deleting removes the contact and every event recorded against them. Campaign totals
                already sent stay as they are — those messages did leave.
              </p>
              <button type="button" class="em-btn danger wide" data-cp-delete>
                <MailIcon name="trash" size={14} /> Delete this contact
              </button>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ contactId: contact?.id || '' }}>
    (function () {
      var EM = window.EM;
      if (!EM || !contactId) return;

      var status = document.getElementById('cpStatus');
      if (status) {
        var was = status.value;
        status.addEventListener('change', function () {
          var next = status.value;
          var resubscribing = next === 'subscribed' && was !== 'subscribed';
          var go = resubscribing
            ? EM.confirm({
                title: 'Resubscribe this contact?',
                body: 'Only do this if they have asked to receive mail again. Sending to somebody who opted out is what produces spam complaints, and complaints damage delivery for everybody else on the domain.',
                confirmLabel: 'Yes, they asked',
              })
            : Promise.resolve(true);

          go.then(function (yes) {
            if (!yes) { status.value = was; return; }
            EM.api('/api/mail/product/contacts', { body: { action: 'status', id: contactId, status: next } })
              .then(function (res) {
                if (!res.ok) { status.value = was; EM.toast(res.error || 'Nothing was changed.', 'bad'); return; }
                was = next;
                EM.toast('Status updated to ' + next + '.', 'ok');
                setTimeout(function () { location.reload(); }, 700);
              });
          });
        });
      }

      var addBtn = document.querySelector('[data-cp-addlist]');
      if (addBtn) addBtn.addEventListener('click', function () {
        var sel = document.getElementById('cpAddList');
        if (!sel || !sel.value) return;
        EM.busy(addBtn, true);
        EM.api('/api/mail/product/contacts', { body: { action: 'bulk-list', ids: [contactId], listId: sel.value } })
          .then(function (res) {
            EM.busy(addBtn, false);
            if (!res.ok) { EM.toast(res.error || 'Nothing was changed.', 'bad'); return; }
            EM.toast('Added to the list.', 'ok');
            setTimeout(function () { location.reload(); }, 600);
          });
      });

      var del = document.querySelector('[data-cp-delete]');
      if (del) del.addEventListener('click', function () {
        EM.confirm({
          title: 'Delete this contact?',
          body: 'The contact and their recorded events are removed permanently. This cannot be undone. If the aim is to stop mailing them, set the status to unsubscribed instead — that keeps the suppression.',
          confirmLabel: 'Delete permanently',
          tone: 'danger',
        }).then(function (yes) {
          if (!yes) return;
          EM.busy(del, true, 'Deleting');
          EM.api('/api/mail/product/contacts', { body: { action: 'delete', id: contactId } })
            .then(function (res) {
              EM.busy(del, false);
              if (!res.ok) { EM.toast(res.error || 'Nothing was deleted.', 'bad'); return; }
              location.href = '/mail/contacts';
            });
        });
      });
    })();
  </script>
</MailShell>
