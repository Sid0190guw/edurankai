---
/**
 * /mail — the dashboard.
 *
 * WHAT A DASHBOARD IS FOR. Not "every number we have". Four questions, in the order somebody
 * actually asks them on opening a mail platform:
 *   1. Is anything waiting for me?          (unread, drafts, campaigns mid-send)
 *   2. Is sending healthy?                  (delivery, bounce, complaint — with their basis stated)
 *   3. What went out, and how did it do?    (last campaigns)
 *   4. Is anything broken?                  (no transport, unverified domain, dead webhook)
 *
 * Question 4 is first on the page when the answer is yes, because a delivery figure means nothing if
 * there is no transport configured.
 *
 * EVERY READ IS INDIVIDUALLY GUARDED. A dashboard that 500s because one aggregate failed loses the
 * nine that would have loaded. A failed read renders as "could not be read", never as a zero — a
 * zero is a claim, and it would be a false one.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import Chart from '@/components/mail/Chart.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getFolderCounts } from '@/lib/mail';
import { transportStatus } from '@/lib/mail-transport';
import { campaignTotals, transactionalTotals, dailySeries, campaignPerformance, audienceTotals, rates } from '@/lib/mail-product/analytics';
import { listCampaigns, STATUS_WORDING } from '@/lib/mail-product/campaigns';
import { listDomains } from '@/lib/mail-product/domains';
import { num, pct, timeAgo, fullTime, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

// Everything below runs ONLY for somebody who may see it. MailShell renders the refusal.
let counts: Record<string, number> = {};
let totals = { sent: 0, delivered: 0, deferred: 0, bounced: 0, opened: 0, clicked: 0, unsubscribed: 0, complained: 0, failed: 0 };
let txTotals: Record<string, number> = {};
let series: any[] = [];
let performance: any[] = [];
let audience: Record<string, number> = {};
let campaigns: any[] = [];
let domains: any[] = [];
let transport: { mode: string; detail: string } = { mode: 'none', detail: '' };
const problems: string[] = [];
let partial = false;

if (access.allowed) {
  const safe = async <T,>(label: string, fn: () => Promise<T>, dflt: T): Promise<T> => {
    try { return await fn(); } catch (e: any) {
      // The reason is on e.cause. Logged in full; the page states that a figure is missing rather
      // than printing a zero it cannot stand behind.
      console.error('[mail/dashboard] ' + label + ' failed:', reasonOf(e));
      partial = true;
      return dflt;
    }
  };

  const [c, ct, tt, ds, cp, at, cl, dl, ts] = await Promise.all([
    safe('folder counts', () => getFolderCounts(user!.id), {} as Record<string, number>),
    safe('campaign totals', () => campaignTotals(30), { totals, partial: true }),
    safe('transactional totals', () => transactionalTotals(30), { totals: {}, partial: true }),
    safe('series', () => dailySeries(30), { rows: [], partial: true }),
    safe('performance', () => campaignPerformance(5), [] as any[]),
    safe('audience', () => audienceTotals(), {} as Record<string, number>),
    safe('campaigns', () => listCampaigns({ limit: 6 }), [] as any[]),
    safe('domains', () => listDomains(), [] as any[]),
    safe('transport', () => transportStatus(), { mode: 'none', detail: 'Could not be read' }),
  ]);

  counts = c;
  totals = ct.totals as any;
  if (ct.partial) partial = true;
  txTotals = tt.totals as any;
  series = ds.rows;
  if (ds.partial) partial = true;
  performance = cp;
  audience = at;
  campaigns = cl;
  domains = dl;
  transport = ts;

  // ---- The "is anything broken" pass -----------------------------------------------------------
  if (transport.mode === 'none') {
    problems.push('No SMTP transport is configured, so nothing can leave this system. Set the mail server in Mail Settings before queueing a campaign.');
  }
  const unverified = domains.filter((d) => d.status !== 'verified');
  if (unverified.length) {
    problems.push(`${unverified.length} sending domain${unverified.length > 1 ? 's are' : ' is'} not fully authenticated. Unauthenticated mail is spam-foldered by most providers.`);
  }
  const stuck = campaigns.filter((c) => c.status === 'sending');
  if (stuck.length) {
    problems.push(`${stuck.length} campaign${stuck.length > 1 ? 's are' : ' is'} mid-send. Open it to watch progress, or pause it.`);
  }
  if (totals.bounced > 0 && totals.sent > 0 && totals.bounced / totals.sent > 0.05) {
    problems.push(`The bounce rate over the last 30 days is ${pct(totals.bounced, totals.sent)}. Above about 5% providers start throttling the domain — clean the audience before the next send.`);
  }
}

const derived = rates(totals as any);
const rate = (k: string) => derived.find((r) => r.key === k);
const inbox = counts.inbox || 0;
const drafts = counts.drafts_total || 0;
const scheduled = campaigns.filter((c) => c.status === 'scheduled').length;
---
<MailShell title="Dashboard" active="dashboard" subtitle="EduRankAI Mail" counts={counts}>
  <button slot="actions" type="button" class="em-btn" data-compose>
    <MailIcon name="edit" size={15} /> Compose
  </button>
  <a slot="actions" class="em-btn pri" href="/mail/campaigns?new=1">
    <MailIcon name="plus" size={15} /> New campaign
  </a>

  <div class="em-wrap em-stack">

    {problems.length > 0 && (
      <div class="em-alert warn" role="status">
        <MailIcon name="warning" size={17} />
        <div>
          <strong>{problems.length === 1 ? 'One thing needs attention' : problems.length + ' things need attention'}</strong>
          <ul style="margin:6px 0 0;padding-inline-start:18px">
            {problems.map((p) => <li style="margin-bottom:3px">{p}</li>)}
          </ul>
        </div>
      </div>
    )}

    {partial && (
      <div class="em-alert info">
        <MailIcon name="info" size={17} />
        <p>Some figures on this page could not be read from the database just now, so they are shown as blank rather than as zero. The reason is in the server log.</p>
      </div>
    )}

    <!-- 1. Waiting for you ------------------------------------------------------------------- -->
    <div class="em-grid c4">
      <a class="em-stat em-tile" href="/mail/box/inbox">
        <p class="em-stat-k"><MailIcon name="inbox" size={13} /> Unread</p>
        <p class="em-stat-v">{num(inbox)}</p>
        <p class="em-stat-d">in your inbox</p>
      </a>
      <a class="em-stat em-tile" href="/mail/box/drafts">
        <p class="em-stat-k"><MailIcon name="draft" size={13} /> Drafts</p>
        <p class="em-stat-v">{num(drafts)}</p>
        <p class="em-stat-d">unsent messages</p>
      </a>
      <a class="em-stat em-tile" href="/mail/contacts">
        <p class="em-stat-k"><MailIcon name="contacts" size={13} /> Subscribed</p>
        <p class="em-stat-v">{num(audience.subscribed || 0)}</p>
        <p class="em-stat-d">of <strong>{num(audience.total || 0)}</strong> contacts</p>
      </a>
      <a class="em-stat em-tile" href="/mail/campaigns">
        <p class="em-stat-k"><MailIcon name="campaigns" size={13} /> Scheduled</p>
        <p class="em-stat-v">{num(scheduled)}</p>
        <p class="em-stat-d">campaigns waiting to send</p>
      </a>
    </div>

    <!-- 2. Sending health -------------------------------------------------------------------- -->
    <div class="em-card">
      <div class="em-card-head">
        <div>
          <h2 class="em-h2">Sending over the last 30 days</h2>
          <p class="em-note">
            Campaign delivery only. Transactional mail (offers, resets, reminders) is counted separately below,
            because the two are recorded by different parts of the system and adding them silently would double nothing and hide everything.
          </p>
        </div>
        <a class="em-btn sm em-push" href="/mail/analytics">Full analytics <MailIcon name="arrowRight" size={13} /></a>
      </div>
      <div class="em-card-body">
        <Chart
          rows={series}
          series={[
            { key: 'sent', label: 'Sent' },
            { key: 'opened', label: 'Opened' },
            { key: 'clicked', label: 'Clicked' },
            { key: 'bounced', label: 'Bounced' },
          ]}
          summary="Campaign messages sent, opened, clicked and bounced per day over the last 30 days"
        />
      </div>
      <div class="em-card-foot em-rate-strip">
        {['delivery', 'open', 'click', 'bounce', 'unsub'].map((k) => {
          const r = rate(k);
          return (
            <div class="em-rate">
              <span class="em-rate-v">{r && r.value !== null ? r.value.toFixed(1) + '%' : '—'}</span>
              <span class="em-rate-k">{r?.label}</span>
              {/* WHICH DENOMINATOR. An open rate over sent and an open rate over delivered differ by
                  exactly the bounce rate, and a product that shows one and labels it the other is
                  wrong by a number it could have got right. */}
              <span class="em-rate-b">of {r?.basis}</span>
            </div>
          );
        })}
      </div>
    </div>

    <div class="em-grid c2">
      <!-- 3. Recent campaigns ---------------------------------------------------------------- -->
      <div class="em-card">
        <div class="em-card-head">
          <h2 class="em-h2">Recent campaigns</h2>
          <a class="em-btn sm ghost em-push" href="/mail/campaigns">See all</a>
        </div>
        {performance.length === 0 && campaigns.length === 0 ? (
          <div class="em-empty">
            <MailIcon name="campaigns" size={34} strokeWidth={1.3} />
            <h3>No campaigns yet</h3>
            <p>A campaign is one message, sent once, to a list or a segment — with a report afterwards.</p>
            <a class="em-btn pri" href="/mail/campaigns?new=1"><MailIcon name="plus" size={15} /> Create the first one</a>
          </div>
        ) : (
          <div class="em-card-body flush">
            <div class="em-tablewrap">
              <table class="em-table">
                <thead>
                  <tr>
                    <th scope="col">Campaign</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="num">Sent</th>
                    <th scope="col" class="num">Opened</th>
                  </tr>
                </thead>
                <tbody>
                  {(performance.length ? performance : campaigns).map((c: any) => (
                    <tr>
                      <td>
                        <a href={`/mail/campaigns/${c.id}`}>{c.name}</a>
                        <div class="em-note">{timeAgo(c.completed_at || c.updated_at)}</div>
                      </td>
                      <td><span class={'em-badge ' + (STATUS_WORDING[c.status as keyof typeof STATUS_WORDING]?.tone === 'muted' ? '' : STATUS_WORDING[c.status as keyof typeof STATUS_WORDING]?.tone)}>{STATUS_WORDING[c.status as keyof typeof STATUS_WORDING]?.label || c.status}</span></td>
                      <td class="num">{num(c.sent_count ?? 0)}</td>
                      <td class="num">{c.opened !== undefined ? pct(c.opened, c.sent_count) : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>

      <!-- 4. Infrastructure ------------------------------------------------------------------ -->
      <div class="em-card">
        <div class="em-card-head"><h2 class="em-h2">Infrastructure</h2></div>
        <div class="em-card-body em-stack">
          <div class="em-infra">
            <span class={'em-badge ' + (transport.mode === 'none' ? 'bad' : 'ok')}>
              <span class="em-dot"></span>{transport.mode === 'none' ? 'No transport' : transport.mode.toUpperCase()}
            </span>
            <div>
              <p class="em-h3">Outbound transport</p>
              <p class="em-note">{transport.detail || 'Not configured'}</p>
            </div>
            <a class="em-btn sm em-push" href="/admin/mail/settings">Configure</a>
          </div>

          {domains.length === 0 ? (
            <div class="em-infra">
              <span class="em-badge warn"><span class="em-dot"></span>None</span>
              <div>
                <p class="em-h3">Sending domains</p>
                <p class="em-note">No domain has been added, so nothing is being checked for SPF, DKIM or DMARC.</p>
              </div>
              <a class="em-btn sm em-push" href="/mail/domains">Add one</a>
            </div>
          ) : domains.slice(0, 3).map((d: any) => (
            <div class="em-infra">
              <span class={'em-badge ' + (d.status === 'verified' ? 'ok' : d.status === 'failed' ? 'bad' : 'warn')}>
                <span class="em-dot"></span>{d.status === 'verified' ? 'Verified' : d.status === 'failed' ? 'Failing' : 'Pending'}
              </span>
              <div>
                <p class="em-h3">{d.domain}</p>
                <p class="em-note">
                  SPF {d.spf_status} · DKIM {d.dkim_status} · DMARC {d.dmarc_status}
                  {d.last_checked_at ? ' · checked ' + timeAgo(d.last_checked_at) : ' · never checked'}
                </p>
              </div>
              <a class="em-btn sm em-push" href="/mail/domains">Open</a>
            </div>
          ))}

          <div class="em-infra">
            <span class="em-badge info"><span class="em-dot"></span>{num((txTotals.sent as number) || 0)}</span>
            <div>
              <p class="em-h3">Transactional mail, 30 days</p>
              <p class="em-note">
                Sent by the platform itself — offers, password resets, reminders.
                {txTotals.failed ? ` ${num(txTotals.failed)} failed.` : ' None recorded as failed.'}
              </p>
            </div>
            <a class="em-btn sm em-push" href="/admin/mail/analytics">Detail</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</MailShell>

<style>
  .em-tile { display: block; text-decoration: none; transition: border-color var(--em-t), box-shadow var(--em-t); }
  .em-tile:hover { border-color: var(--em-line-2); box-shadow: var(--em-sh-2); }
  .em-rate-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: var(--em-4); }
  .em-rate { display: flex; flex-direction: column; gap: 1px; }
  .em-rate-v { font-size: 17px; font-weight: 690; color: var(--em-ink); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .em-rate-k { font-size: 11.5px; font-weight: 620; color: var(--em-ink-3); }
  .em-rate-b { font-size: 10.5px; color: var(--em-ink-4); }
  .em-infra { display: flex; align-items: center; gap: var(--em-3); padding: var(--em-3) 0; border-bottom: 1px solid var(--em-line); flex-wrap: wrap; }
  .em-infra:last-child { border-bottom: none; padding-bottom: 0; }
  .em-infra > div { min-width: 0; flex: 1; }
</style>
