---
/**
 * /mail/templates — system, transactional and campaign templates.
 *
 * THREE KINDS, AND THE DIFFERENCE MATTERS:
 *   SYSTEM         — read by the platform itself by key (offers, password resets). Not deletable and
 *                    not editable here; switching one off would break a transactional send.
 *   TRANSACTIONAL  — one-to-one messages the platform sends on an event.
 *   CAMPAIGN       — the bodies campaigns are built from.
 *
 * These are the same `email_templates` rows /admin/mail/templates has always written. This screen
 * adds the builder, the versions and the kind; it does not start a second table.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listTemplates } from '@/lib/mail-product/templates';
import { MERGE_VARIABLES } from '@/lib/mail-product/personalize';
import { timeAgo, reasonOf, str } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);
const url = new URL(Astro.request.url);
const kind = str(url.searchParams.get('kind'), 20);
const q = str(url.searchParams.get('q'), 120);

let rows: any[] = [];
let error = '';
if (access.allowed) {
  try {
    rows = await listTemplates({ kind: kind || undefined, q: q || undefined });
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/templates] read failed:', error);
  }
}

function link(v: string | null): string {
  const u = new URL(url.href);
  if (v) u.searchParams.set('kind', v); else u.searchParams.delete('kind');
  return u.pathname + (u.search || '');
}
---
<MailShell title="Templates" active="templates" subtitle="Reusable message bodies, versioned">
  <button slot="actions" type="button" class="em-btn pri" data-t-new><MailIcon name="plus" size={15} /> New template</button>

  <div class="em-wrap em-stack" id="tRoot">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>Templates could not be read.</strong> {error}</p></div>
    )}

    <div class="em-card">
      <div class="em-card-head">
        <form class="em-search" role="search" method="get" style="flex:1;max-width:320px">
          <MailIcon name="search" size={15} />
          <input type="search" name="q" value={q} placeholder="Search templates" aria-label="Search templates" />
          {kind && <input type="hidden" name="kind" value={kind} />}
        </form>
        <div class="em-seg em-push" role="group" aria-label="Filter by kind">
          <a href={link(null)} aria-current={!kind ? 'true' : undefined}>All</a>
          <a href={link('campaign')} aria-current={kind === 'campaign' ? 'true' : undefined}>Campaign</a>
          <a href={link('transactional')} aria-current={kind === 'transactional' ? 'true' : undefined}>Transactional</a>
          <a href={link('system')} aria-current={kind === 'system' ? 'true' : undefined}>System</a>
        </div>
      </div>

      {rows.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="templates" size={36} strokeWidth={1.3} />
          <h3>{kind || q ? 'No templates match that' : 'No templates yet'}</h3>
          <p>
            {kind || q
              ? 'Try clearing the filter.'
              : 'A template is a message body you keep and reuse. Every save creates a version, so a campaign that has already gone out can still show exactly what it sent.'}
          </p>
          {kind || q
            ? <a class="em-btn" href="/mail/templates">Clear filters</a>
            : <button type="button" class="em-btn pri" data-t-new><MailIcon name="plus" size={15} /> Create one</button>}
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">Template</th><th scope="col">Kind</th>
              <th scope="col" class="num">Version</th><th scope="col">Updated</th>
              <th scope="col">Active</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {rows.map((t: any) => (
                <tr data-id={t.id}>
                  <td>
                    {t.is_system
                      ? <span style="font-weight:620;color:var(--em-ink)">{t.template_key}</span>
                      : <a href={`/mail/templates/${t.id}`}>{t.template_key}</a>}
                    <div class="em-note">{t.subject}</div>
                  </td>
                  <td>
                    <span class={'em-badge ' + (t.is_system ? 'info' : t.kind === 'transactional' ? 'warn' : '')}>
                      {t.is_system ? 'system' : t.kind}
                    </span>
                  </td>
                  <td class="num">v{t.version}</td>
                  <td><span class="em-note" title={t.updated_at}>{timeAgo(t.updated_at)}</span></td>
                  <td>
                    <label class="em-check">
                      <input type="checkbox" data-t-active={t.id} checked={t.is_active} disabled={t.is_system}
                             aria-label={`${t.template_key} is active`} />
                      <span class="em-sr-only">Active</span>
                    </label>
                  </td>
                  <td>
                    <span class="em-row tight" style="flex-wrap:nowrap">
                      {!t.is_system && <a class="em-btn ghost sm" href={`/mail/templates/${t.id}`}>Edit</a>}
                      <button type="button" class="em-btn ghost sm" data-t-dup={t.id}>Duplicate</button>
                      {!t.is_system && <button type="button" class="em-btn ghost sm danger" data-t-del={t.id} data-name={t.template_key}>Delete</button>}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div></div>
      )}
    </div>

    <div class="em-card">
      <div class="em-card-head"><h2 class="em-h2">Variables</h2></div>
      <div class="em-card-body">
        <p class="em-lede" style="margin-bottom:14px">
          These are filled per person <strong>in campaigns and automations</strong>, where one message
          is built for each recipient. A message sent from the mailbox composer goes to everybody as
          one message, so a variable typed there is sent literally — the composer says so when you
          insert one.
        </p>
        <div class="em-tablewrap">
          <table class="em-table">
            <thead><tr><th scope="col">Variable</th><th scope="col">Means</th><th scope="col">Example</th></tr></thead>
            <tbody>
              {MERGE_VARIABLES.map((v) => (
                <tr>
                  <td><code class="em-mono">{`{{${v.key}}}`}</code></td>
                  <td>{v.label}</td>
                  <td><span class="em-note">{v.sample}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="em-hint" style="margin-top:12px">
          A variable nothing can fill is sent as <strong>empty text</strong>, never as the literal
          <code class="em-mono">{'{{first_name}}'}</code>. The builder warns about unknown ones while you write.
          Declare your own on <a href="/mail/contacts/lists">Lists &amp; segments</a>.
        </p>
      </div>
    </div>
  </div>

  <div class="em-modal" id="tNewModal" hidden>
    <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="tNewTitle">
      <div class="em-modal-head"><h2 id="tNewTitle">New template</h2></div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-t-err hidden><p></p></div>
        <label class="em-field"><span class="em-label">Name <span class="req">*</span></span>
          <input class="em-input" id="tName" data-autofocus placeholder="Stage 3 invitation" />
          <span class="em-hint">Stored as a key, lower-case and hyphenated.</span></label>
        <label class="em-field"><span class="em-label">Kind</span>
          <select class="em-select" id="tKind">
            <option value="campaign">Campaign — a body campaigns are built from</option>
            <option value="transactional">Transactional — sent one-to-one on an event</option>
          </select></label>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-t-create>Create and open</button>
        <button type="button" class="em-btn ghost" data-t-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var EM = window.EM;
      if (!EM) return;
      var modal = document.getElementById('tNewModal');
      var close = null;
      var err = modal.querySelector('[data-t-err]');

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-t-new]')) { err.hidden = true; close = EM.openModal(modal); return; }
        if (e.target.closest('[data-t-cancel]')) { if (close) close(); return; }

        var create = e.target.closest('[data-t-create]');
        if (create) {
          var name = document.getElementById('tName').value.trim();
          if (!name) { err.hidden = false; err.querySelector('p').textContent = 'Give the template a name.'; return; }
          EM.busy(create, true, 'Creating');
          EM.api('/api/mail/product/templates', {
            body: { action: 'create', name: name, kind: document.getElementById('tKind').value },
          }).then(function (res) {
            EM.busy(create, false);
            if (!res.ok) { err.hidden = false; err.querySelector('p').textContent = res.error || 'The template was not created.'; return; }
            location.href = '/mail/templates/' + res.id;
          });
          return;
        }

        var dup = e.target.closest('[data-t-dup]');
        if (dup) {
          EM.busy(dup, true);
          EM.api('/api/mail/product/templates', { body: { action: 'duplicate', id: dup.dataset.tDup } })
            .then(function (res) {
              EM.busy(dup, false);
              if (!res.ok) { EM.toast(res.error || 'Nothing was duplicated.', 'bad'); return; }
              location.href = '/mail/templates/' + res.id;
            });
          return;
        }

        var del = e.target.closest('[data-t-del]');
        if (del) {
          EM.confirm({
            title: 'Delete "' + del.dataset.name + '"?',
            body: 'The template and its version history are removed permanently. Campaigns already built from it keep their own frozen copy of what they sent.',
            confirmLabel: 'Delete template',
            tone: 'danger',
          }).then(function (yes) {
            if (!yes) return;
            EM.api('/api/mail/product/templates', { body: { action: 'delete', id: del.dataset.tDel } })
              .then(function (res) {
                if (!res.ok) { EM.toast(res.error || 'Nothing was deleted.', 'bad', 10000); return; }
                EM.toast('Template deleted.', 'ok');
                location.reload();
              });
          });
        }
      });

      document.addEventListener('change', function (e) {
        var box = e.target.closest('[data-t-active]');
        if (!box) return;
        var on = box.checked;
        EM.api('/api/mail/product/templates', { body: { action: 'active', id: box.dataset.tActive, active: on } })
          .then(function (res) {
            if (!res.ok) { box.checked = !on; EM.toast(res.error || 'Nothing was changed.', 'bad'); return; }
            EM.toast(on ? 'Template switched on.' : 'Template switched off — it will not be offered when building a campaign.', 'ok');
          });
      });
    })();
  </script>
</MailShell>

<style>
  .em-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0);
    clip-path: inset(50%); white-space: nowrap; }
</style>
