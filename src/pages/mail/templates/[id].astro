---
/**
 * /mail/templates/[id] — the builder, mounted on a template, plus its version history.
 *
 * A VERSION IS RESTORED FORWARD, NEVER BACKWARD. "Restore v3" saves v3's content as a NEW version,
 * so the history stays a record of what happened rather than a record of what somebody currently
 * wishes had happened. That is the whole reason to keep versions at all.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import Builder from '@/components/mail/Builder.astro';
import '@/styles/mail-builder.css';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getTemplate, listVersions } from '@/lib/mail-product/templates';
import { coerceDocument, emptyDocument } from '@/lib/mail-product/blocks';
import { timeAgo, fullTime, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);
const id = String(Astro.params.id || '');

let template: any = null;
let versions: any[] = [];
let error = '';

if (access.allowed) {
  try {
    template = await getTemplate(id);
    if (template) versions = await listVersions(id, 20).catch(() => []);
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/template] read failed:', error);
  }
}

if (template?.is_system) return Astro.redirect('/mail/templates');

const doc = template?.blocks ? coerceDocument(template.blocks) : emptyDocument();
---
<MailShell
  title={template ? template.template_key : 'Template'}
  active="templates"
  subtitle={template ? `v${template.version} · ${template.kind}` : ''}
  flush={true}
>
  <span slot="actions" class="em-note" data-bd-status>Loading…</span>
  <button slot="actions" type="button" class="em-btn" data-t-history>
    <MailIcon name="clock" size={14} /> History
  </button>
  <button slot="actions" type="button" class="em-btn" data-bd-save>Save</button>
  <a slot="actions" class="em-btn pri" href="/mail/templates">Done</a>

  {error && (
    <div class="em-page"><div class="em-alert bad">
      <MailIcon name="warning" size={16} />
      <p><strong>This template could not be read.</strong> {error}</p>
    </div></div>
  )}

  {!template && !error && (
    <div class="em-page"><div class="em-card"><div class="em-empty">
      <MailIcon name="templates" size={36} strokeWidth={1.3} />
      <h3>No template with that id</h3>
      <a class="em-btn" href="/mail/templates">Back to templates</a>
    </div></div></div>
  )}

  {template && (
    <Builder owner="template" ownerId={id} doc={doc} subject={template.subject} preheader={template.preheader || ''} />
  )}

  {template && (
    <div class="em-modal" id="tHistory" hidden>
      <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="tHistTitle">
        <div class="em-modal-head">
          <h2 id="tHistTitle">Version history</h2>
          <button type="button" class="em-btn ghost icon sm em-push" data-t-close aria-label="Close">
            <MailIcon name="close" size={16} />
          </button>
        </div>
        <div class="em-modal-body">
          {versions.length === 0 ? (
            <p class="em-note">No versions recorded yet. One is written on every save.</p>
          ) : (
            <div class="em-tablewrap">
              <table class="em-table">
                <thead><tr><th scope="col">Version</th><th scope="col">Change</th><th scope="col">When</th><th scope="col"></th></tr></thead>
                <tbody>
                  {versions.map((v: any) => (
                    <tr>
                      <td><strong>v{v.version}</strong>{v.version === template.version && <span class="em-badge ok" style="margin-inline-start:6px">current</span>}</td>
                      <td>{v.note || 'Edited'}<div class="em-note">{v.subject}</div></td>
                      <td><span class="em-note" title={fullTime(v.created_at)}>{timeAgo(v.created_at)}{v.author ? ' · ' + v.author : ''}</span></td>
                      <td>
                        {v.version !== template.version && (
                          <button type="button" class="em-btn ghost sm" data-t-restore={v.version}>Restore</button>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <p class="em-hint" style="margin-top:14px">
            Restoring saves that version&rsquo;s content as a <strong>new</strong> version. Nothing in the
            history is ever overwritten — that is what makes it a record.
          </p>
        </div>
      </div>
    </div>
  )}

  <script is:inline define:vars={{ templateId: template?.id || '' }}>
    (function () {
      var EM = window.EM;
      if (!EM || !templateId) return;
      var modal = document.getElementById('tHistory');
      var close = null;

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-t-history]')) { close = EM.openModal(modal); return; }
        if (e.target.closest('[data-t-close]')) { if (close) close(); return; }

        var r = e.target.closest('[data-t-restore]');
        if (!r) return;
        var version = Number(r.dataset.tRestore);
        EM.confirm({
          title: 'Restore version ' + version + '?',
          body: 'Its content is saved as a new version on top of the current one. Nothing in the history is lost, and you can restore back again.',
          confirmLabel: 'Restore v' + version,
        }).then(function (yes) {
          if (!yes) return;
          EM.busy(r, true);
          EM.api('/api/mail/product/templates', { body: { action: 'restore', id: templateId, version: version } })
            .then(function (res) {
              EM.busy(r, false);
              if (!res.ok) { EM.toast(res.error || 'Nothing was restored.', 'bad'); return; }
              EM.toast(res.note || 'Restored.', 'ok');
              setTimeout(function () { location.reload(); }, 800);
            });
        });
      });
    })();
  </script>
</MailShell>
