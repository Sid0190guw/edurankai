---
/**
 * /mail/campaigns — every campaign and what state it is in.
 *
 * THE STATE IS THE POINT OF THIS SCREEN. Eight states, one badge vocabulary (STATUS_WORDING in
 * campaigns.ts), and a tooltip on each that says what it means for the recipients — because
 * "Queued" and "Sending" and "Completed" are the difference between nobody having received it,
 * some people having received it, and everybody having been attempted.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listCampaigns, STATUS_WORDING } from '@/lib/mail-product/campaigns';
import { CAMPAIGN_STATUSES } from '@/lib/mail-product/schema';
import { num, pct, timeAgo, fullTime, reasonOf, str } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);
const url = new URL(Astro.request.url);
const status = str(url.searchParams.get('status'), 20);
const q = str(url.searchParams.get('q'), 120);
const openNew = url.searchParams.has('new');

let rows: any[] = [];
let error = '';
if (access.allowed) {
  try {
    rows = await listCampaigns({ status: status || undefined, q: q || undefined, limit: 100 });
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/campaigns] read failed:', error);
  }
}

const byStatus = rows.reduce((a: Record<string, number>, c: any) => {
  a[c.status] = (a[c.status] || 0) + 1;
  return a;
}, {});

function link(k: string, v: string | null): string {
  const u = new URL(url.href);
  if (v) u.searchParams.set(k, v); else u.searchParams.delete(k);
  u.searchParams.delete('new');
  return u.pathname + (u.search || '');
}
---
<MailShell title="Campaigns" active="campaigns" subtitle="One message, sent once, with a report">
  <button slot="actions" type="button" class="em-btn pri" data-cp-new>
    <MailIcon name="plus" size={15} /> New campaign
  </button>

  <div class="em-wrap em-stack" id="cpList">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>Campaigns could not be read.</strong> This list is empty for a reason that is not
          &ldquo;no campaigns&rdquo;, and nothing has been changed. {error}</p></div>
    )}

    <div class="em-card">
      <div class="em-card-head">
        <form class="em-search" role="search" method="get" style="flex:1;max-width:320px">
          <MailIcon name="search" size={15} />
          <input type="search" name="q" value={q} placeholder="Search by name or subject" aria-label="Search campaigns" />
          {status && <input type="hidden" name="status" value={status} />}
        </form>
        <div class="em-seg em-push" role="group" aria-label="Filter by state">
          <a href={link('status', null)} aria-current={!status ? 'true' : undefined}>All</a>
          {CAMPAIGN_STATUSES.filter((s) => byStatus[s] || s === status).map((s) => (
            <a href={link('status', s)} aria-current={status === s ? 'true' : undefined}
               title={STATUS_WORDING[s].detail}>
              {STATUS_WORDING[s].label}{byStatus[s] ? ` (${byStatus[s]})` : ''}
            </a>
          ))}
        </div>
      </div>

      {rows.length === 0 ? (
        <div class="em-empty">
          <MailIcon name="campaigns" size={36} strokeWidth={1.3} />
          <h3>{status || q ? 'No campaigns match that' : 'No campaigns yet'}</h3>
          <p>
            {status || q
              ? 'Try clearing the filter.'
              : 'A campaign is one message sent once to a list or a segment. You build it, preview it, send yourself a test, then schedule or send it — and it keeps a report of what happened.'}
          </p>
          {status || q
            ? <a class="em-btn" href="/mail/campaigns">Clear filters</a>
            : <button type="button" class="em-btn pri" data-cp-new><MailIcon name="plus" size={15} /> Create the first campaign</button>}
        </div>
      ) : (
        <div class="em-card-body flush"><div class="em-tablewrap">
          <table class="em-table">
            <thead><tr>
              <th scope="col">Campaign</th>
              <th scope="col">State</th>
              <th scope="col" class="num">Recipients</th>
              <th scope="col" class="num">Sent</th>
              <th scope="col" class="num">Failed</th>
              <th scope="col">When</th>
              <th scope="col"></th>
            </tr></thead>
            <tbody>
              {rows.map((c: any) => {
                const w = STATUS_WORDING[c.status as keyof typeof STATUS_WORDING] || STATUS_WORDING.draft;
                const tone = w.tone === 'muted' ? '' : w.tone;
                return (
                  <tr>
                    <td>
                      <a href={`/mail/campaigns/${c.id}`}>{c.name}</a>
                      <div class="em-note">{c.subject || <em>no subject yet</em>}</div>
                    </td>
                    <td>
                      <span class={'em-badge ' + tone + (c.status === 'sending' ? ' live' : '')} title={w.detail}>
                        {c.status === 'sending' && <span class="em-dot"></span>}
                        {w.label}
                      </span>
                    </td>
                    <td class="num">{c.recipients_total ? num(c.recipients_total) : <span class="em-note">—</span>}</td>
                    <td class="num">{num(c.sent_count)}</td>
                    <td class="num">
                      {c.failed_count > 0
                        ? <span style="color:var(--em-bad);font-weight:640">{num(c.failed_count)}</span>
                        : <span class="em-note">0</span>}
                    </td>
                    <td>
                      <span class="em-note" title={fullTime(c.scheduled_at || c.completed_at || c.updated_at)}>
                        {c.status === 'scheduled' && c.scheduled_at
                          ? 'sends ' + fullTime(c.scheduled_at)
                          : timeAgo(c.completed_at || c.updated_at)}
                      </span>
                    </td>
                    <td>
                      <a class="em-btn ghost sm" href={`/mail/campaigns/${c.id}`}>
                        {['completed', 'sending', 'paused'].includes(c.status) ? 'Report' : 'Open'}
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div></div>
      )}
    </div>
  </div>

  <div class="em-modal" id="cpNewModal" hidden={!openNew}>
    <div class="em-modal-card" role="dialog" aria-modal="true" aria-labelledby="cpNewTitle">
      <div class="em-modal-head"><h2 id="cpNewTitle">New campaign</h2></div>
      <div class="em-modal-body">
        <div class="em-alert bad" data-cp-err hidden><p></p></div>
        <label class="em-field">
          <span class="em-label">Internal name <span class="req">*</span></span>
          <input class="em-input" id="cpName" data-autofocus placeholder="August programme update" />
          <span class="em-hint">Only you see this. The subject line comes next.</span>
        </label>
        <label class="em-field">
          <span class="em-label">Subject line</span>
          <input class="em-input" id="cpSubject" placeholder="Your application has moved to stage 3" />
          <span class="em-hint">You can change it at any time before the campaign is queued.</span>
        </label>
      </div>
      <div class="em-modal-foot">
        <button type="button" class="em-btn pri" data-cp-create>Create and open</button>
        <button type="button" class="em-btn ghost" data-cp-cancel>Cancel</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var EM = window.EM;
      if (!EM) return;
      var modal = document.getElementById('cpNewModal');
      var close = null;
      var err = modal.querySelector('[data-cp-err]');

      // ?new=1 opens the dialog on load — the dashboard's "New campaign" button links here.
      if (!modal.hidden) { modal.hidden = true; close = EM.openModal(modal); }

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-cp-new]')) { err.hidden = true; close = EM.openModal(modal); return; }
        if (e.target.closest('[data-cp-cancel]')) { if (close) close(); return; }
        var go = e.target.closest('[data-cp-create]');
        if (!go) return;

        var name = document.getElementById('cpName').value.trim();
        if (!name) { err.hidden = false; err.querySelector('p').textContent = 'Give the campaign a name so you can find it later.'; return; }
        EM.busy(go, true, 'Creating');
        EM.api('/api/mail/product/campaigns', {
          body: { action: 'create', name: name, subject: document.getElementById('cpSubject').value },
        }).then(function (res) {
          EM.busy(go, false);
          if (!res.ok) {
            err.hidden = false;
            err.querySelector('p').textContent = res.error || 'The campaign was not created.';
            return;
          }
          location.href = '/mail/campaigns/' + res.id;
        });
      });
    })();
  </script>
</MailShell>
