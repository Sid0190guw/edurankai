---
/**
 * /mail/campaigns/[id]/design — the email builder, mounted on a campaign.
 *
 * REFUSES TO OPEN ON A FROZEN CAMPAIGN. Once a campaign is queued its content is the record of what
 * was sent; opening an editor on it would let somebody change what the report claims to describe.
 * The redirect goes back to the campaign, which explains the state.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import Builder from '@/components/mail/Builder.astro';
import '@/styles/mail-builder.css';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { getCampaign } from '@/lib/mail-product/campaigns';
import { coerceDocument, emptyDocument } from '@/lib/mail-product/blocks';
import { reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);
const id = String(Astro.params.id || '');

let campaign: any = null;
let error = '';
if (access.allowed) {
  try {
    campaign = await getCampaign(id);
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/design] read failed:', error);
  }
}

if (campaign && !['draft', 'scheduled', 'failed'].includes(campaign.status)) {
  return Astro.redirect(`/mail/campaigns/${id}`);
}

// A campaign with no blocks yet opens on the starter document rather than an empty white box —
// there is nothing to learn from an empty canvas.
const doc = campaign?.blocks ? coerceDocument(campaign.blocks) : emptyDocument();
---
<MailShell
  title={campaign ? campaign.name : 'Design'}
  active="campaigns"
  subtitle="Email design"
  flush={true}
  crumbs={[]}
>
  <span slot="actions" class="em-note" data-bd-status>Loading…</span>
  <button slot="actions" type="button" class="em-btn" data-bd-save>Save</button>
  <a slot="actions" class="em-btn pri" href={`/mail/campaigns/${id}`}>
    Done <MailIcon name="arrowRight" size={14} />
  </a>

  {error && (
    <div class="em-page"><div class="em-alert bad">
      <MailIcon name="warning" size={16} />
      <p><strong>This campaign could not be read.</strong> {error}</p>
    </div></div>
  )}

  {!campaign && !error && (
    <div class="em-page"><div class="em-card"><div class="em-empty">
      <MailIcon name="campaigns" size={36} strokeWidth={1.3} />
      <h3>No campaign with that id</h3>
      <a class="em-btn" href="/mail/campaigns">Back to campaigns</a>
    </div></div></div>
  )}

  {campaign && (
    <Builder owner="campaign" ownerId={id} doc={doc} subject={campaign.subject} preheader={campaign.preheader || ''} />
  )}
</MailShell>
