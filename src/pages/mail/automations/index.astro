---
/**
 * /mail/automations — the list of workflows.
 *
 * THREE STATES, AND ONE OF THEM IS A PROMISE. `draft` is being built. `paused` means nobody new
 * enters but runs already part-way stay where they are. `active` means it is mailing people right
 * now — which is why switching it on is the only action here that validates the graph first and
 * refuses with the reason.
 */
import MailShell from '@/components/mail/MailShell.astro';
import MailIcon from '@/components/mail/MailIcon.astro';
import { canUseMailbox } from '@/lib/auth/mail-access';
import { listAutomations, runCounts, validateGraph, coerceGraph, describeNode } from '@/lib/mail-product/automations';
import { num, timeAgo, reasonOf } from '@/lib/mail-product/common';

const user = Astro.locals.user;
const access = await canUseMailbox(user as any);

let rows: any[] = [];
let error = '';
if (access.allowed) {
  try {
    rows = await listAutomations();
    // Run counts, sequentially bounded by the list's own 100-row cap.
    for (const a of rows) {
      a.counts = await runCounts(a.id).catch(() => ({}));
      const g = coerceGraph(a.graph);
      a.validation = validateGraph(g);
      a.nodeCount = g.nodes.length;
      a.trigger = g.nodes.find((n: any) => n.kind === 'trigger');
      a.triggerLabel = a.trigger ? describeNode(a.trigger) : 'No trigger';
    }
  } catch (e: any) {
    error = reasonOf(e);
    console.error('[mail/automations] read failed:', error);
  }
}

const TONE: Record<string, string> = { active: 'ok', paused: 'warn', draft: '' };
const MEANS: Record<string, string> = {
  active: 'Live. Contacts entering now run through it.',
  paused: 'Nobody new enters. Runs already part-way through stay where they are.',
  draft: 'Not live. Nothing has been sent.',
};
---
<MailShell title="Automations" active="automations" subtitle="Workflows that send on their own">
  <button slot="actions" type="button" class="em-btn pri" data-a-new><MailIcon name="plus" size={15} /> New automation</button>

  <div class="em-wrap em-stack">
    {error && (
      <div class="em-alert bad"><MailIcon name="warning" size={16} />
        <p><strong>Automations could not be read.</strong> {error}</p></div>
    )}

    {rows.length === 0 ? (
      <div class="em-card"><div class="em-empty">
        <MailIcon name="automations" size={38} strokeWidth={1.3} />
        <h3>No automations yet</h3>
        <p>
          An automation is a graph: something happens, a contact enters, and each step decides what
          comes next — send, wait, branch, tag, call a webhook, finish. A new one starts from the
          stage-change example so there is something to read rather than an empty canvas.
        </p>
        <button type="button" class="em-btn pri" data-a-new><MailIcon name="plus" size={15} /> Build the first one</button>
      </div></div>
    ) : (
      <div class="em-grid c2">
        {rows.map((a: any) => (
          <div class="em-card">
            <div class="em-card-head">
              <div style="min-width:0;flex:1">
                <h2 class="em-h2"><a href={`/mail/automations/${a.id}`} style="color:inherit;text-decoration:none">{a.name}</a></h2>
                <p class="em-note">{a.triggerLabel}</p>
              </div>
              <span class={'em-badge ' + (TONE[a.status] || '')} title={MEANS[a.status]}>
                {a.status === 'active' && <span class="em-dot"></span>}
                {a.status}
              </span>
            </div>
            <div class="em-card-body">
              {!a.validation.ok && (
                <div class="em-alert warn" style="margin-bottom:12px">
                  <MailIcon name="warning" size={15} />
                  <p>
                    {a.validation.problems.length} thing{a.validation.problems.length === 1 ? '' : 's'} to fix
                    before this can be switched on.
                  </p>
                </div>
              )}
              <div class="em-grid c3" style="gap:12px">
                <div><p class="em-stat-k">Steps</p><p style="font-size:19px;font-weight:680;color:var(--em-ink)">{a.nodeCount}</p></div>
                <div><p class="em-stat-k">Running</p><p style="font-size:19px;font-weight:680;color:var(--em-ink)">{num(a.counts.running || 0)}</p></div>
                <div><p class="em-stat-k">Completed</p><p style="font-size:19px;font-weight:680;color:var(--em-ink)">{num(a.counts.completed || 0)}</p></div>
              </div>
            </div>
            <div class="em-card-foot">
              <a class="em-btn sm" href={`/mail/automations/${a.id}`}>Open</a>
              <span class="em-note em-push">{timeAgo(a.updated_at)}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    (function () {
      var EM = window.EM;
      if (!EM) return;
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-a-new]');
        if (!b) return;
        var name = window.prompt('Name this automation', 'Stage 3 follow-up');
        if (!name || !name.trim()) return;
        EM.busy(b, true, 'Creating');
        EM.api('/api/mail/product/automations', { body: { action: 'create', name: name.trim() } })
          .then(function (res) {
            EM.busy(b, false);
            if (!res.ok) { EM.toast(res.error || 'The automation was not created.', 'bad'); return; }
            location.href = '/mail/automations/' + res.id;
          });
      });
    })();
  </script>
</MailShell>
