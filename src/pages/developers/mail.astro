---
/**
 * /developers/mail — the public reference for the transactional email API.
 *
 * WRITTEN FOR SOMEBODY INTEGRATING AT 2AM. Every section that describes a behaviour also describes
 * what happens when it goes wrong, because the failure is what the reader is actually looking for.
 * Where a capability does not exist yet it says so — a documented webhook that can never fire costs
 * more than an honest gap.
 *
 * No company other than EduRankAI is named anywhere on this page.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';
import { PAYLOAD_VERSION } from '@/lib/mailapi/schema';
import { ALL_SCOPES } from '@/lib/mailapi/keys';
import { EVENT_TYPES } from '@/lib/mailapi/webhooks';
import { LIMITS } from '@/lib/mailapi/validate';

const base = SITE.url.replace(/\/$/, '');

// Rendered from the same constants the API enforces, so the page cannot drift from the behaviour.
const ENDPOINTS: { method: string; path: string; scope: string; note: string }[] = [
  { method: 'POST', path: '/api/v1/email/send', scope: 'email.send', note: 'Send a message.' },
  { method: 'GET', path: '/api/v1/messages', scope: 'email.read', note: 'List and correlate by metadata.' },
  { method: 'GET', path: '/api/v1/messages/:id', scope: 'email.read', note: 'One message.' },
  { method: 'GET', path: '/api/v1/messages/:id/status', scope: 'email.read', note: 'Status plus delivery events.' },
  { method: 'DELETE', path: '/api/v1/messages/:id', scope: 'email.send', note: 'Cancel a scheduled send.' },
  { method: 'GET', path: '/api/v1/events', scope: 'events.read', note: 'The event feed, for backfill and reconciliation.' },
  { method: 'GET', path: '/api/v1/templates', scope: 'templates.read', note: 'List templates.' },
  { method: 'POST', path: '/api/v1/templates', scope: 'templates.write', note: 'Create with a first version.' },
  { method: 'GET', path: '/api/v1/templates/:id', scope: 'templates.read', note: 'One template and its versions.' },
  { method: 'PATCH', path: '/api/v1/templates/:id', scope: 'templates.write', note: 'Rename, or add a draft version.' },
  { method: 'DELETE', path: '/api/v1/templates/:id', scope: 'templates.write', note: 'Archive it.' },
  { method: 'POST', path: '/api/v1/templates/:id/publish', scope: 'templates.write', note: 'Publish or unpublish a version.' },
  { method: 'POST', path: '/api/v1/templates/:id/preview', scope: 'templates.read', note: 'Test render. Nothing is sent.' },
  { method: 'POST', path: '/api/v1/templates/:id/copy', scope: 'templates.write', note: 'Promote to another environment.' },
  { method: 'GET', path: '/api/v1/webhooks', scope: 'events.read', note: 'List endpoints.' },
  { method: 'POST', path: '/api/v1/webhooks', scope: 'events.read + email.send', note: 'Register. The secret is shown once.' },
  { method: 'PATCH', path: '/api/v1/webhooks/:id', scope: 'events.read + email.send', note: 'Change url, events, or re-enable.' },
  { method: 'DELETE', path: '/api/v1/webhooks/:id', scope: 'events.read + email.send', note: 'Remove it.' },
  { method: 'POST', path: '/api/v1/webhooks/:id/rotate', scope: 'events.read + email.send', note: 'New secret, with an overlap.' },
  { method: 'POST', path: '/api/v1/webhooks/:id/test', scope: 'events.read', note: 'Send a signed verification event.' },
  { method: 'GET', path: '/api/v1/webhooks/:id/deliveries', scope: 'events.read', note: 'Delivery log and dead letters.' },
  { method: 'POST', path: '/api/v1/webhooks/:id/deliveries', scope: 'events.read + email.send', note: 'Replay a dead delivery.' },
  { method: 'GET', path: '/api/v1/suppressions', scope: 'email.read', note: 'Addresses we have stopped mailing.' },
  { method: 'POST', path: '/api/v1/suppressions', scope: 'email.send', note: 'Add one.' },
  { method: 'DELETE', path: '/api/v1/suppressions', scope: 'email.send', note: 'Remove one.' },
  { method: 'GET', path: '/api/v1/domains', scope: 'domains.read', note: 'Sending identities and DNS posture.' },
  { method: 'POST', path: '/api/v1/domains', scope: 'domains.write', note: 'Register and check one.' },
];

const ERRORS: { code: string; status: number; meaning: string }[] = [
  { code: 'invalid_request', status: 400, meaning: 'A field is missing or malformed. `param` names it.' },
  { code: 'missing_api_key', status: 401, meaning: 'No key was presented.' },
  { code: 'invalid_api_key', status: 401, meaning: 'Not a key we recognise.' },
  { code: 'expired_api_key', status: 401, meaning: 'It had an expiry, or it was rotated and the grace period ended.' },
  { code: 'revoked_api_key', status: 401, meaning: 'Somebody revoked it. Create a new one.' },
  { code: 'insufficient_scope', status: 403, meaning: 'The response names the scope that was required.' },
  { code: 'environment_mismatch', status: 403, meaning: 'The key and its record disagree. Refused rather than believed.' },
  { code: 'organization_inactive', status: 403, meaning: 'Sending is disabled for this organization.' },
  { code: 'template_not_found', status: 404, meaning: 'No such template in THIS environment.' },
  { code: 'message_not_found', status: 404, meaning: 'Also the answer for another organization or environment.' },
  { code: 'idempotency_key_reused', status: 409, meaning: 'That key was used for a different request.' },
  { code: 'idempotency_in_progress', status: 409, meaning: 'The first call with that key is still running.' },
  { code: 'payload_too_large', status: 413, meaning: 'Over 1 MB. Bodies are HTML and text; documents are links.' },
  { code: 'template_not_published', status: 422, meaning: 'Production needs a published version, or options.allow_draft.' },
  { code: 'template_variable_missing', status: 422, meaning: 'Named in missing_variables. Refused rather than rendered blank.' },
  { code: 'all_recipients_suppressed', status: 422, meaning: 'Every recipient asked us to stop, or hard bounced.' },
  { code: 'attachment_not_a_link', status: 422, meaning: 'File content was sent. Attachments are links.' },
  { code: 'rate_limit_exceeded', status: 429, meaning: 'Retry-After says how long.' },
  { code: 'no_transport', status: 503, meaning: 'No mail server is configured on this deployment.' },
];

const SCOPE_NOTES: { scope: string; what: string }[] = [
  { scope: 'email.send', what: 'Send messages, cancel scheduled ones, manage suppression, register webhooks.' },
  { scope: 'email.read', what: 'Read messages and their status.' },
  { scope: 'templates.read', what: 'List, read and preview templates.' },
  { scope: 'templates.write', what: 'Create, version, publish, archive and promote templates.' },
  { scope: 'events.read', what: 'Read delivery events and manage webhook endpoints.' },
  { scope: 'domains.read', what: 'Read sending identities and their DNS posture.' },
  { scope: 'domains.write', what: 'Register and re-check sending domains.' },
];
---
