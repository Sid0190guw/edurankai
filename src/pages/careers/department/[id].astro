---
// /careers/department/[id] — ONE DEPARTMENT.
//
// Generic: it works for every department the site has, and shows the division layer only where the
// department actually has one. A page that only worked for the research department would leave the
// other thirty in the directory pointing at a 404.
//
// AN UNKNOWN ID IS A NOT-FOUND STATE, NOT A REDIRECT AND NOT A CRASH. A department page that
// silently bounced to /careers would tell somebody with a stale link that their bookmark works.
import BaseLayout from '@/layouts/BaseLayout.astro';
import OpportunityCard from '@/components/careers/OpportunityCard.astro';
import ScaleStrip from '@/components/careers/ScaleStrip.astro';
import { db } from '@/lib/db';
import { departments } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { listDivisions, openRoleCountByDivision } from '@/lib/xscale/divisions';
import { listOpportunities } from '@/lib/xscale/roles-ext';
import {
  SCALE_DISCLAIMER, classificationDef, scaleRangeText, RESEARCH_CLASSIFICATIONS,
} from '@/lib/xscale/taxonomy';
import { XSCALE_DEPARTMENT_ID } from '@/data/xscale-catalog';

const { id } = Astro.params;
const departmentId = String(id || '');

let dept: any = null;
let deptReadable = true;
if (departmentId) {
  try {
    const found = await db.select().from(departments).where(eq(departments.id, departmentId)).limit(1);
    dept = found[0] || null;
  } catch (e: any) {
    deptReadable = false;
    console.error('[department] lookup failed:', e?.cause?.message || e?.message);
  }
}

// A NOT-FOUND IS SERVED AS A 404, with a page. Astro will not set the status for us.
const notFound = deptReadable && !dept;
if (notFound) Astro.response.status = 404;

const divisionList = dept ? await listDivisions({ departmentId }) : { rows: [], readable: true };
const divisionCounts = dept ? await openRoleCountByDivision(departmentId) : {};

// The department's own postings, first page only. A department page is a way in, not a search
// surface; the search surface is /careers/opportunities and this links there.
const listing = dept
  ? await listOpportunities({ departmentId, limit: 12 })
  : { rows: [], total: 0, readable: true, degraded: false };

const isResearchDepartment = departmentId === XSCALE_DEPARTMENT_ID;

// The scale span this department actually covers, taken from its divisions rather than asserted.
const declaredMin = divisionList.rows.reduce<number | null>((acc, d) => {
  if (typeof d.scaleMinExp !== 'number') return acc;
  if (acc === null) return d.scaleMinExp;
  return Math.min(acc, d.scaleMinExp);
}, null);
const declaredMax = divisionList.rows.reduce<number | null>((acc, d) => {
  if (typeof d.scaleMaxExp !== 'number') return acc;
  if (acc === null) return d.scaleMaxExp;
  return Math.max(acc, d.scaleMaxExp);
}, null);
const hasSpan = declaredMin !== null && declaredMax !== null;
const spanText = hasSpan ? scaleRangeText(declaredMin as number, declaredMax as number) : '';

// Which classifications this department's divisions actually use, so the page describes the real
// mix rather than reciting all eight.
const usedClassifications = Array.from(new Set(
  divisionList.rows.map((d) => d.researchClassification).filter(Boolean) as string[],
)).map((k) => classificationDef(k)).filter(Boolean);
const hasClassifications = usedClassifications.length > 0;

const hasDivisions = divisionList.rows.length > 0;
const divisionsUnreadable = divisionList.readable === false;
const hasRoles = listing.rows.length > 0;
const rolesUnreadable = listing.readable === false;
const moreThanShown = listing.total > listing.rows.length;

const pageTitle = dept ? String(dept.name) : 'Department not found';
const metaDescription = dept
  ? String(dept.description || '').slice(0, 300)
  : 'This department could not be found.';
---

<BaseLayout title={pageTitle} description={metaDescription} noindex={notFound}>
  {!deptReadable && (
    <section class="px-[5vw] py-16 max-w-3xl mx-auto">
      <h1 class="font-display text-[1.6rem] font-semibold text-ink mb-3">We could not load this department</h1>
      <p class="text-[0.92rem] text-ink-2 leading-relaxed mb-5">
        This is a fault on our side rather than a department that does not exist. Please try again shortly.
      </p>
      <a href="/careers/departments" class="btn-primary no-underline">Back to the directory</a>
    </section>
  )}

  {notFound && (
    <section class="px-[5vw] py-16 max-w-3xl mx-auto">
      <p class="eyebrow mb-2">404</p>
      <h1 class="font-display text-[1.7rem] font-semibold text-ink mb-3">There is no department at this address</h1>
      <p class="text-[0.92rem] text-ink-2 leading-relaxed mb-5">
        The link may be old, or the department may have been renamed. The directory lists every one we have.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/careers/departments" class="btn-primary no-underline">Department directory</a>
        <a href="/careers" class="btn-ghost no-underline">All open roles</a>
      </div>
    </section>
  )}

  {dept && (
    <>
      <section class="px-[5vw] pt-9 md:pt-12 pb-5 max-w-7xl mx-auto">
        <p class="eyebrow mb-2">
          <a href="/careers/departments" class="text-inherit no-underline hover:underline">Departments</a>
          <span class="mx-1.5 text-ink-soft/50">/</span>
          {dept.name}
        </p>
        <h1 class="font-display text-[clamp(1.8rem,4.4vw,2.8rem)] font-semibold text-ink leading-[1.07] tracking-tight mb-3">
          {dept.name}
        </h1>
        <p class="text-[0.95rem] text-ink-2 leading-relaxed max-w-3xl mb-4">{dept.description}</p>

        <div class="flex flex-wrap gap-2">
          <a href={`/careers/opportunities?dept=${departmentId}`} class="btn-primary no-underline">
            {listing.total} open {listing.total === 1 ? 'opportunity' : 'opportunities'}
          </a>
          <a href="/careers/departments" class="btn-ghost no-underline">Department directory</a>
        </div>
      </section>

      {hasSpan && (
        <section class="px-[5vw] pb-6 max-w-7xl mx-auto">
          <div class="bg-white border border-ink/10 rounded-2xl p-5" style="border-left:4px solid #FF4F00;">
            <h2 class="font-display text-[1.1rem] font-semibold text-ink m-0 mb-1">
              Research across {spanText}
            </h2>
            <p class="text-[0.86rem] text-ink-2 leading-relaxed max-w-3xl m-0 mb-4">
              From ultra-small theoretical and mathematical regimes through quantum, atomic, molecular, nano,
              micro, human, planetary and cosmological scales. {SCALE_DISCLAIMER}
            </p>
            <ScaleStrip minExp={declaredMin} maxExp={declaredMax} hrefBase={`/careers/opportunities?dept=${departmentId}`} showDisclaimer={false} />
          </div>
        </section>
      )}

      {isResearchDepartment && hasClassifications && (
        <section class="px-[5vw] pb-6 max-w-7xl mx-auto">
          <h2 class="font-display text-[1.2rem] font-semibold text-ink mb-1">What kind of work this is</h2>
          <p class="text-[0.85rem] text-ink-soft mb-4 max-w-3xl">
            Every posting in this department carries one of these classifications, and states its evidential
            standing separately. Established science, active experimental research, computational research,
            theoretical research and speculative frontier research are kept visibly distinct.
          </p>
          <div class="grid gap-2.5 md:grid-cols-2 xl:grid-cols-4">
            {RESEARCH_CLASSIFICATIONS.map((c) => (
              <a href={`/careers/opportunities?dept=${departmentId}&classification=${c.key}`} class="block bg-white border border-ink/10 rounded-xl p-4 no-underline text-inherit hover:border-ink/25 transition-colors">
                <p class="font-display text-[0.92rem] font-semibold text-ink m-0 mb-1">{c.label}</p>
                <p class="text-[0.76rem] text-ink-soft leading-relaxed m-0">{c.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {hasDivisions && (
        <section class="px-[5vw] pb-8 max-w-7xl mx-auto">
          <h2 class="font-display text-[1.2rem] font-semibold text-ink mb-1">
            {divisionList.rows.length} divisions
          </h2>
          <p class="text-[0.85rem] text-ink-soft mb-4 max-w-3xl">
            Each division states its scale range and the kind of work it does at the top of its own page,
            along with the honest limits of that work.
          </p>
          <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            {divisionList.rows.map((d) => (
              <article class="bg-white border border-ink/10 rounded-2xl p-5">
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h3 class="font-display text-[1rem] font-semibold text-ink leading-tight m-0">
                    <a href={`/careers/division/${d.slug}`} class="no-underline text-inherit hover:text-burn transition-colors">{d.name}</a>
                  </h3>
                  <span class="shrink-0 text-[0.66rem] font-mono text-ink-soft border border-ink/12 rounded-full px-2 py-0.5">{d.code || ''}</span>
                </div>
                {typeof d.scaleMinExp === 'number' && typeof d.scaleMaxExp === 'number' && (
                  <p class="text-[0.72rem] font-mono text-ink-soft m-0 mb-2">{scaleRangeText(d.scaleMinExp, d.scaleMaxExp)}</p>
                )}
                <p class="text-[0.8rem] text-ink-soft leading-relaxed m-0 mb-3">{d.summary}</p>
                <div class="flex items-center justify-between gap-2">
                  <a href={`/careers/division/${d.slug}`} class="text-[0.76rem] font-semibold text-burn no-underline hover:underline">Open the division &rarr;</a>
                  <span class="text-[0.72rem] text-ink-soft">{divisionCounts[d.id] || 0} open</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {divisionsUnreadable && (
        <section class="px-[5vw] pb-8 max-w-7xl mx-auto">
          <div class="bg-white border border-ink/10 rounded-2xl px-5 py-4" style="border-left:4px solid #8a5a00;">
            <p class="text-[0.83rem] text-ink-2 leading-relaxed m-0">
              The division register could not be read, so divisions are not listed. That is a fault on our side.
            </p>
          </div>
        </section>
      )}

      <section class="px-[5vw] pb-14 max-w-7xl mx-auto">
        <h2 class="font-display text-[1.2rem] font-semibold text-ink mb-4">Open opportunities</h2>

        {rolesUnreadable && (
          <div class="bg-white border border-ink/10 rounded-2xl p-6" style="border-left:4px solid #9a3412;">
            <p class="text-[0.88rem] text-ink-2 leading-relaxed m-0">
              We could not load this department's opportunities. That is a fault on our side, not an empty list.
            </p>
          </div>
        )}

        {!rolesUnreadable && !hasRoles && (
          <div class="bg-white border border-ink/10 rounded-2xl p-8 text-center">
            <p class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">Nothing is open in this department today.</p>
            <p class="text-[0.86rem] text-ink-soft max-w-lg mx-auto m-0 mb-4">
              This is the real state, not a filtered view. Other departments are hiring.
            </p>
            <a href="/careers" class="btn-primary no-underline">Browse every open role</a>
          </div>
        )}

        {hasRoles && (
          <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            {listing.rows.map((r) => <OpportunityCard role={r} />)}
          </div>
        )}

        {moreThanShown && (
          <div class="mt-6 text-center">
            <a href={`/careers/opportunities?dept=${departmentId}`} class="btn-ghost no-underline">
              See all {listing.total} &rarr;
            </a>
          </div>
        )}
      </section>
    </>
  )}
</BaseLayout>
