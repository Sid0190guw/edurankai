---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BeforeYouApply from '@/components/BeforeYouApply.astro';
import { db } from '@/lib/db';
import { roles, departments } from '@/lib/db/schema';
import { eq, and, ne } from 'drizzle-orm';
import { getRoleAicte } from '@/lib/role-aicte';
import {
  resolveEngagementPolicy, applyRoleOverrides, jobPostingWorkHours,
  describeCommitment, describeProgrammeTotal, commitmentFacts, isInternshipPolicy,
  aicteCreditEquivalent, AICTE_HOURS_PER_CREDIT,
} from '@/lib/engagement-policy';
import { stripOwnershipPromise } from '@/lib/compensation-text';
import { resolveWorkMode, displayLocation, workModeSentence, jobLocationType } from '@/lib/work-mode';
import ScaleStrip from '@/components/careers/ScaleStrip.astro';
import { getRoleExtension } from '@/lib/xscale/roles-ext';
import { getDivisionById } from '@/lib/xscale/divisions';
import {
  SCALE_DISCLAIMER, careerRung, classificationDef, classificationEvidence, effectiveJobStatus,
  scaleRangeText, skillCategoryLabel,
} from '@/lib/xscale/taxonomy';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/careers');

const found = await db.select().from(roles).where(eq(roles.slug, slug)).limit(1);
if (found.length === 0) return Astro.redirect('/careers');

const r = found[0];

// A CLOSED POSTING IS SHOWN AS CLOSED. It used to redirect to /careers, which is the wrong answer to
// two different questions at once: somebody following a link they were sent is told nothing about
// what happened to the role, and somebody mid-application is dropped on a list with no explanation.
// Worse, a redirect made "closed" a matter of the LIST rather than the POSTING — the row was gone
// from view while the apply flow, which keys on the role slug, would still have taken a submission.
//
// The status comes from effectiveJobStatus(), which is deadline-aware: a posting whose deadline has
// passed is closed whether or not anybody remembered to change its status.
const roleExtension = await getRoleExtension(String(r.id));
const jobStatus = effectiveJobStatus({
  jobStatus: roleExtension.jobStatus,
  isOpen: r.isOpen,
  applicationDeadline: r.applicationDeadline,
});
// DRAFT and ARCHIVED are not public at all — an unfinished advertisement is not an advertisement.
// 404, with a page, rather than a redirect that would imply the link is fine.
const roleIsHidden = !jobStatus.publiclyVisible;
if (roleIsHidden) {
  return new Response(null, { status: 302, headers: { Location: '/careers?gone=' + encodeURIComponent(slug) } });
}
const acceptsApplications = jobStatus.acceptsApplications;
const closedNote = jobStatus.publicNote;

// Work mode, decided once, before anything that renders or serialises it. Permanent roles are on
// site; internships and apprenticeships may be on site or hybrid; nothing is remote. `locationText`
// is what the candidate sees: a role with a real bespoke site keeps its own wording, and a row that
// still carries the old "Remote / Hybrid (India)" string is shown as what it actually is, without
// waiting for the database to be corrected.
const workMode = resolveWorkMode(r.engagementType, r.level, r.location);
const locationText = displayLocation(r.engagementType, r.level, r.location);

// The application_fee_amount / application_fee_currency columns are added via
// runtime ALTER and aren't in the Drizzle schema, so fetch them separately.
let roleFeeAmount: number | null = null;
let roleFeeCurrency = 'CHF';
try {
  const { sql } = await import('drizzle-orm');
  const feeRow = await db.execute(sql`SELECT application_fee_amount, application_fee_currency FROM roles WHERE slug = ${slug} LIMIT 1`);
  const feeRs = (Array.isArray(feeRow) ? feeRow : ((feeRow as any)?.rows || [])) as any[];
  if (feeRs[0]) {
    roleFeeAmount = feeRs[0].application_fee_amount != null ? Number(feeRs[0].application_fee_amount) : null;
    roleFeeCurrency = feeRs[0].application_fee_currency || 'CHF';
  }
} catch (_) {}

const deptResult = await db.select().from(departments).where(eq(departments.id, r.departmentId)).limit(1);
const deptName = deptResult.length > 0 ? deptResult[0].name : 'EduRankAI';

// AICTE-portal-format fields (optional; blank for most permanent/senior roles).
const aicte = await getRoleAicte(r.id);

// ---- RESEARCH FACETS (Extreme-Scale department; null on every other role) --------------------
// getRoleExtension() was already called above, because the closed-state decision needs job_status
// from it. Nothing here re-queries.
const division = roleExtension.divisionId ? await getDivisionById(roleExtension.divisionId) : null;
const classification = classificationDef(roleExtension.researchClassification);
const evidence = classificationEvidence(
  roleExtension.researchClassification, roleExtension.scaleMinExp, roleExtension.scaleMaxExp,
);
const rung = careerRung(roleExtension.careerLevel);
const hasScaleRange = typeof roleExtension.scaleMinExp === 'number'
  && typeof roleExtension.scaleMaxExp === 'number';
const scaleRangeLabel = hasScaleRange
  ? scaleRangeText(roleExtension.scaleMinExp as number, roleExtension.scaleMaxExp as number)
  : '';
const isResearchPosting = !!(classification || division || hasScaleRange);
// Every comparison hoisted: a `<` inside a JSX expression breaks .astro parsing.
const hasPreferredSkills = roleExtension.preferredSkills.length > 0;
const hasTools = roleExtension.tools.length > 0;
const hasDeliverables = roleExtension.deliverables.length > 0;
const hasEvaluation = roleExtension.evaluationCriteria.length > 0;
const hasCollaborators = roleExtension.collaboratesWith.length > 0;
const hasSkillCategories = roleExtension.skillCategories.length > 0;
const hasIntegrityNote = !!roleExtension.integrityNote;
const hasApplicationInstructions = !!roleExtension.applicationInstructions;
const hasReportingTo = !!roleExtension.reportingTo;
const deadlineLabel = r.applicationDeadline
  ? new Date(r.applicationDeadline).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'long', year: 'numeric' })
  : '';

// WORKING TIME COMES FROM ONE MODULE, NOT FROM THIS PAGE.
//
// This page used to publish "2.5 hours per day, 5 days per week" as its internship fallback while
// the catalog said 6 days and ~40 hours, and it showed a bare "~40 hrs/week" tile with the split
// buried in a paragraph below. Both numbers now come from src/lib/engagement-policy.ts, which
// cannot state a total without its split, and which refuses to describe a senior role in counted
// hours at all -- a Director's page now says so instead of showing an empty grid.
const engagement = applyRoleOverrides(
  resolveEngagementPolicy({ level: r.level, engagementType: r.engagementType, roleTitle: r.title }),
  {
    daysPerWeek: aicte.workingDaysPerWeek,
    hoursPerWeek: aicte.hoursPerWeek,
    projectHoursPerDay: aicte.projectHoursPerDay,
    wellbeingHoursPerDay: aicte.wellbeingHoursPerDay,
  },
);
const engagementIsCounted = isInternshipPolicy(engagement);
const engagementFacts = commitmentFacts(engagement);
const engagementProgrammeTotal = describeProgrammeTotal(engagement);
const engagementCredits = aicteCreditEquivalent(engagement);
const engagementHeading = engagementIsCounted
  ? 'How this ' + engagement.label.toLowerCase() + ' is structured'
  : 'How working time works at this level';

const relatedRoles = await db.select({
  slug: roles.slug,
  title: roles.title,
  level: roles.level,
  engagementType: roles.engagementType
}).from(roles).where(and(eq(roles.departmentId, r.departmentId), ne(roles.id, r.id), eq(roles.isOpen, true))).limit(4);

const levelColors: Record<string, string> = {
  'C-Level': 'bg-plum-bg text-plum border-plum-border',
  'Lead': 'bg-leaf-bg text-leaf border-leaf-border',
  'Senior': 'bg-sky-bg text-sky border-sky-border',
  'Mid': 'bg-burn-pale text-burn border-burn-dim',
  'Junior': 'bg-cream-2 text-ink-soft border-ink/15',
  'Intern': 'bg-gold-bg text-gold-deep border-gold-border',
  'Apprentice': 'bg-leaf-bg text-leaf border-leaf-border'
};
const levelClass = levelColors[r.level] || 'bg-cream-2 text-ink-soft border-ink/15';

const levelFraming: Record<string, { tagline: string; scope: string }> = {
  'C-Level': { tagline: 'Founding leadership', scope: 'Build the function from zero. Set the strategy. Own the outcome.' },
  'Lead': { tagline: 'Senior leadership', scope: 'Set direction within your domain. Build and mentor a team. Own outcomes at the function level.' },
  'Senior': { tagline: 'Individual contributor at the frontier', scope: 'Own complex problems end-to-end. Set technical direction. Mentor mid and junior teammates.' },
  'Mid': { tagline: 'Trusted operator', scope: 'Drive specific initiatives with minimal supervision. Deepen craft. Begin mentoring others.' },
  'Junior': { tagline: 'Early career, real ownership', scope: 'Work on real problems day one. Be supported by senior mentors. Grow fast.' },
  'Intern': { tagline: 'Learn at the frontier', scope: 'Contribute to live projects. Shadow senior practitioners. Build a portfolio that matters.' },
  'Apprentice': { tagline: 'Structured learning programme', scope: 'Six-month immersion with mentorship. From foundation to contribution.' }
};
const framing = levelFraming[r.level] || { tagline: '', scope: '' };

// Interns and apprentices are unpaid by default, and their catalog entry carries the literal
// 'Unpaid — ...' string for that. A trainee role that says anything else genuinely pays, so it must
// show its stipend instead of the unpaid notice. Telling a candidate that a paid role is unpaid
// misrepresents the offer, and it is the kind of error someone only discovers after they have
// turned down other work.
// The stored salary text is free-form and some rows still promise equity the firm does not
// offer (EduRankAI is a proprietorship). Sanitise ONCE here, then render only this value - the
// band, the page title, the meta description and the stipend callout all read the same string,
// so a promise removed from one and left in another would be worse than not removing it at all.
const salaryText = stripOwnershipPromise(r.salary);
const isTrainee = r.level === 'Intern' || r.level === 'Apprentice';
const paysStipend = !!salaryText && !/^\s*unpaid\b/i.test(salaryText);
const showCompensation = !isTrainee || paysStipend;

const applyHref = '/apply?role=' + r.slug;

// Work mode is not described here in prose that can drift from the posting. It comes from
// src/lib/work-mode.ts, which derives it from the engagement: permanent roles are on site,
// internships and apprenticeships may be on site or hybrid, nothing is remote. These lines used
// to promise "limited remote flexibility" and "remote in rare, pre-approved cases", which is what
// applicants were reading and acting on.
const engagementInfo: Record<string, string> = {
  'Full-Time': 'Permanent role. Full-time commitment.',
  'Internship': 'Structured, hands-on mentorship for a fixed term.',
  'Apprenticeship': 'Six months. Structured mentorship.'
};
const engagementText = ((engagementInfo[r.engagementType] || '') + ' ' + workModeSentence(workMode, r.engagementType)).trim();

// Parse the freeform salary text into a structured range for Google Jobs.
// Understands both "up to ₹120 LPA" and "INR 20,00,000 - 40,00,000
// per annum" (Indian digit grouping). Monthly stipends are never structured.
// Salary text is monetary compensation only -- EduRankAI is a proprietorship, so a
// role's stored salary string must never promise an ownership or profit-linked share.
function parseSalaryINR(text: string | null | undefined): { min: number | null; max: number | null } | null {
  if (!text) return null;
  const s = String(text);
  if (/month/i.test(s)) return null;
  const lpa = s.match(/(\d+(?:\.\d+)?)\s*LPA/i);
  if (lpa) {
    const v = parseFloat(lpa[1]);
    return Number.isFinite(v) ? { min: null, max: Math.round(v * 100000) } : null;
  }
  if (!/INR|₹|Rs\.?/i.test(s)) return null;
  const nums = (s.match(/\d[\d,]{4,}/g) || [])
    .map((n) => parseInt(n.replace(/,/g, ''), 10))
    .filter((n) => Number.isFinite(n) && n >= 100000);
  if (!nums.length) return null;
  return { min: nums.length > 1 ? Math.min(...nums) : null, max: Math.max(...nums) };
}
const salaryRange = parseSalaryINR(salaryText);
const salaryMaxINR = salaryRange?.max ?? null;
// Nothing here is remote, so nothing is ever marked TELECOMMUTE. This used to be a regex over the
// stored location string, and because every catalogue row said "Remote / Hybrid (India)" it made
// TELECOMMUTE the default for the entire careers portal -- including the internships, which Google
// then listed as remote work. The mode now comes from the engagement, and a stale database row
// cannot change it.

// For an on-site role, work out whether the location string actually names a city. Remove the words
// that describe the ARRANGEMENT rather than the place, then flatten the leftover punctuation; if
// nothing meaningful remains, the site is undisclosed and no addressLocality should be published.
// Deliberately does NOT strip parentheticals wholesale: "On-site (Pune, India)" keeps its city that
// way, whereas dropping the bracketed part would silently discard it.
const onsiteLocality = (locationText || '')
  .replace(/exact location disclosed on selection|disclosed on selection|location withheld|to be confirmed/gi, '')
  .replace(/\b(on-?site|onsite|in[- ]person|undisclosed|confidential|india|bharat|tbc|tba)\b/gi, '')
  .replace(/[()\[\]]/g, ' ')
  .replace(/[\/,;:—–-]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const expByLevel: Record<string, number> = {
  'C-Level': 12, 'Lead': 8, 'Senior': 5, 'Mid': 3, 'Junior': 1, 'Intern': 0, 'Apprentice': 0,
};
const yearsExp = expByLevel[r.level || 'Mid'] ?? 0;

const today = new Date();
const datePostedISO = new Date(r.createdAt).toISOString().split('T')[0];
// Google requires validThrough. A flat 60-day window was published for EVERY posting regardless of
// its actual deadline, which meant a role closing next week was advertised to Google as open for two
// months — and a role with a later deadline was dropped from results early. Use the real deadline
// where the posting has one; keep the 60-day window only as the fallback for postings with none.
const declaredDeadline = r.applicationDeadline
  ? new Date(r.applicationDeadline)
  : (roleExtension.validThrough ? new Date(roleExtension.validThrough) : null);
const validThrough = declaredDeadline && Number.isFinite(declaredDeadline.getTime())
  ? declaredDeadline.toISOString()
  : new Date(today.getTime() + 60 * 24 * 3600 * 1000).toISOString();

const clean = (s: string | null | undefined) => (s || '').replace(/\s+/g, ' ').trim();

const jobPostingSchema: any = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: r.title,
  // Lead with the role-specific line: every catalogue `about` opens with the same boilerplate
  // intro, so putting `function` first is what actually distinguishes one posting from another.
  description: (clean(r.function) ? '<p><strong>' + clean(r.function) + '</strong></p>' : '')
    + '<p>' + (r.about || '') + '</p>'
    + (r.responsibilities && r.responsibilities.length ? '<h3>Responsibilities</h3><ul>' + (r.responsibilities as string[]).map(x => '<li>' + x + '</li>').join('') + '</ul>' : '')
    + (r.skills && r.skills.length ? '<h3>Skills</h3><ul>' + (r.skills as string[]).map(x => '<li>' + x + '</li>').join('') + '</ul>' : ''),
  identifier: { '@type': 'PropertyValue', name: 'EduRankAI', value: r.slug },
  datePosted: datePostedISO,
  validThrough,                               // Google requires this; 60-day window
  directApply: true,                          // tells Google Jobs the apply lives here
  employmentType: r.engagementType === 'Full-Time' ? 'FULL_TIME' : (r.engagementType === 'Internship' ? 'INTERN' : (r.engagementType === 'Apprenticeship' ? 'CONTRACTOR' : 'FULL_TIME')),
  // Derived from the role's real terms, not assumed. This used to hardcode "2H30M per day,
  // 5 days/week" for EVERY internship, which for a role with different terms published structured
  // data that contradicted the visible page — Google treats that mismatch as a policy problem.
  // It then grew a set of fallbacks that disagreed with the visible page in the other direction:
  // "40 hours per week" flat, and "2.5 hours per day" for internships that are actually six days.
  // Both the tile and this string are now the same module, so they cannot drift apart again.
  workHours: jobPostingWorkHours(engagement),
  industry: 'Artificial Intelligence Research',
  occupationalCategory: deptName,
  experienceRequirements: {
    '@type': 'OccupationalExperienceRequirements',
    monthsOfExperience: yearsExp * 12,
  },
  educationRequirements: {
    '@type': 'EducationalOccupationalCredential',
    // Use the role's stated qualifications where it has them. Flat-defaulting every intern role to
    // "high school" understated programmes that actually require an engineering degree, which loses
    // them on degree-filtered searches. Values are from Google's accepted credentialCategory set.
    credentialCategory: (() => {
      const q = (aicte.qualifications || []).join(' ') + ' ' + (aicte.qualificationType || '');
      if (/M\.?\s?Tech|M\.?E\.?|Master|MCA|M\.?Sc|PG|Postgraduate/i.test(q)) return 'postgraduate degree';
      if (/B\.?\s?Tech|B\.?E\.?|Bachelor|B\.?Sc|BCA|UG|Undergraduate/i.test(q)) return 'bachelor degree';
      return r.level === 'Intern' || r.level === 'Apprentice' ? 'high school' : 'bachelor degree';
    })(),
  },
  hiringOrganization: {
    '@type': 'Organization',
    name: 'EduRankAI',
    sameAs: 'https://edurankai.in',
    logo: 'https://edurankai.in/favicon.svg',
  },
  jobLocation: {
    '@type': 'Place',
    // Only emit addressLocality when the location string actually names a place. Some roles
    // deliberately withhold the site (secure/high-protocol programmes), and passing the raw
    // string through would put junk like "On-site, India (exact location disclosed on selection)"
    // into structured data as if it were a city name. Country-only is valid; it just cannot match
    // city-level searches, which is the intended trade-off for not disclosing the site.
    address: onsiteLocality
      ? { '@type': 'PostalAddress', addressCountry: 'IN', addressLocality: onsiteLocality }
      : { '@type': 'PostalAddress', addressCountry: 'IN' },
  },
};
// jobLocationType is deliberately never set. Google reads TELECOMMUTE as "done away from any
// employer site", and its own guidance is that a hybrid role is not TELECOMMUTE -- it has a real
// place of work. Setting it here is what put every posting into remote job searches.
if (jobLocationType(workMode)) {
  jobPostingSchema.jobLocationType = jobLocationType(workMode);
}
// Intern + Apprentice compensation is NOT published — stipend is discussed at
// the offer stage. JSON-LD baseSalary is only emitted for permanent roles.
if (salaryMaxINR && r.level !== 'Intern' && r.level !== 'Apprentice') {
  const salaryValue: any = { '@type': 'QuantitativeValue', maxValue: salaryMaxINR, unitText: 'YEAR' };
  if (salaryRange?.min && salaryRange.min !== salaryMaxINR) salaryValue.minValue = salaryRange.min;
  jobPostingSchema.baseSalary = {
    '@type': 'MonetaryAmount',
    currency: 'INR',
    value: salaryValue,
  };
}

// C-suite-tuned page title and description: surface seniority + comp band
// up-front so the result wins on senior search queries.
const seniorTitle = ['C-Level', 'Lead'].includes(r.level || '');
const pageTitle = seniorTitle
  ? r.title + ' (up to ' + (salaryText || 'top market band') + ') | ' + deptName + ' | EduRankAI'
  : r.title + ' - ' + deptName + ' - EduRankAI Careers';

// The meta description MUST be unique per role. Every catalogue role's `about` opens with the
// same boilerplate intro sentence, and that sentence is ~155 characters — so truncating `about`
// at 157 produced one byte-identical description across 548 of the 583 roles (only 36 distinct).
// Google reads that as near-duplicate content and generally discards the description. `function`
// is the role-specific one-liner and is distinct for all 583, so lead with it.
// Truncate on a word boundary rather than mid-word.
const cut = (s: string, n: number) => {
  if (s.length <= n) return s;
  const sp = s.lastIndexOf(' ', n - 1);
  return s.slice(0, sp > n * 0.6 ? sp : n).replace(/[,;:\-—\s]+$/, '') + '...';
};
const roleLine = clean(r.function) || clean(r.about);
const metaDesc = seniorTitle
  ? cut(`${r.title} at EduRankAI. ${salaryText ? salaryText + '. ' : ''}${roleLine}`, 185)
  : cut(`${r.title} - ${deptName} at EduRankAI. ${roleLine}`, 165);

// JSON.stringify does not escape "<", so a role field containing "</script>" would break out of
// the ld+json block. Escaping "<" keeps the JSON valid and the tag un-closable from data.
const jobPostingJson = JSON.stringify(jobPostingSchema).replace(/</g, '\\u003c');
---
<BaseLayout title={pageTitle} description={metaDesc}>
  <script type="application/ld+json" set:html={jobPostingJson} is:inline></script>

  <section class="px-[5vw] py-12 md:py-16 max-w-4xl mx-auto">
    <a href="/careers" class="inline-flex items-center gap-2 text-[0.8rem] font-mono text-ink-soft hover:text-burn transition-colors mb-8">
      <span>&larr;</span> Back to all roles
    </a>

    <div class="mb-10 pb-10 border-b border-ink/10">
      <div class="flex items-center gap-2 mb-3">
        <p class="eyebrow">{deptName}</p>
        <span class="text-ink-soft/40">/</span>
        <p class="text-[0.7rem] font-mono uppercase tracking-[0.15em] text-ink-soft">{framing.tagline}</p>
      </div>
      <h1 class="font-display text-[clamp(2rem,4.5vw,3.2rem)] font-semibold text-ink leading-[1.05] tracking-tight mb-5">
        {r.title}
      </h1>
      <p class="text-[1.05rem] text-ink-2 leading-relaxed mb-6 max-w-2xl">{r.function}</p>
      <div class="flex flex-wrap gap-2">
        <span class={'text-[0.7rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border ' + levelClass}>{r.level}</span>
        <span class="text-[0.7rem] font-semibold text-ink-soft bg-cream-2 border border-ink/10 px-2.5 py-1 rounded-md">{r.engagementType}</span>
        <span class="text-[0.7rem] font-semibold text-ink-soft bg-cream-2 border border-ink/10 px-2.5 py-1 rounded-md">{locationText}</span>
        {r.duration && <span class="text-[0.7rem] font-semibold text-ink-soft bg-cream-2 border border-ink/10 px-2.5 py-1 rounded-md">{r.duration}</span>}
      </div>
    </div>

    {/* Compensation is HIDDEN on public pages for UNPAID Intern + Apprentice roles — that
        discussion happens privately at offer. For permanent roles, and for the trainee roles that
        actually carry a stipend, we show the published band so candidates know what to expect. */}
    <div class={showCompensation ? 'grid grid-cols-1 sm:grid-cols-3 gap-3 mb-12' : 'grid grid-cols-1 sm:grid-cols-2 gap-3 mb-12'}>
      {showCompensation && (
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-2 font-bold">Compensation</p>
          <p class="text-[0.88rem] text-ink leading-snug font-medium">{salaryText}</p>
        </div>
      )}
      <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-2 font-bold">Engagement</p>
        <p class="text-[0.88rem] text-ink leading-snug font-medium">{r.engagementType}</p>
        <p class="text-[0.74rem] text-ink-soft mt-1">{engagementText}</p>
      </div>
      <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-2 font-bold">Scope of role</p>
        <p class="text-[0.82rem] text-ink leading-snug">{framing.scope}</p>
      </div>
    </div>

    {isTrainee && !paysStipend && (
      <div class="flex items-start gap-2.5 bg-leaf-bg border border-leaf-border rounded-xl px-4 py-3.5 mb-12">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7a45" stroke-width="2" class="mt-0.5 shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
        <p class="text-[0.84rem] text-leaf leading-relaxed">Please note this is an <b>unpaid {r.engagementType === 'Apprenticeship' ? 'apprenticeship' : 'internship'}</b> — the offer is real work, mentorship and experience at the frontier, not a stipend.</p>
      </div>
    )}

    {isTrainee && paysStipend && (
      <div class="flex items-start gap-2.5 bg-gold-bg border border-gold-border rounded-xl px-4 py-3.5 mb-12">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a6a12" stroke-width="2" class="mt-0.5 shrink-0"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <p class="text-[0.84rem] text-gold-deep leading-relaxed">This is a <b>paid {r.engagementType === 'Apprenticeship' ? 'apprenticeship' : 'internship'}</b> — {salaryText}.</p>
      </div>
    )}

    <!-- ================= RESEARCH CLASSIFICATION =================
         Rendered only for a posting that carries one, so nothing changes on the ~988 roles that do
         not. It sits ABOVE the role description on purpose: a scale range read after the job title
         has already done its work is a scale range read as a capability claim. What the work IS
         comes before what the work sounds like. -->
    {isResearchPosting && (
      <div class="mb-12 bg-white border border-ink/10 rounded-2xl p-5 md:p-6" style="border-left:4px solid #FF4F00;">
