        <div class="flex flex-wrap items-center gap-2 mb-4">
          {classification && (
            <span class="text-[0.76rem] font-semibold text-burn bg-burn-pale border border-burn-dim rounded-full px-3 py-1">{classification.label}</span>
          )}
          {evidence && (
            <span class="text-[0.76rem] font-medium text-ink-2 bg-cream-2 border border-ink/10 rounded-full px-3 py-1">{evidence.label}</span>
