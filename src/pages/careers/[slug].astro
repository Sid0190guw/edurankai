    {r.eligibility && r.eligibility.length > 0 && (
      <div class="mb-12">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">04 &mdash; The bar</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-5">Who thrives here</h2>
        <ul class="space-y-3">
          {r.eligibility.map((item) => (
            <li class="flex gap-3 text-[0.93rem] text-ink-2 leading-[1.7]">
              <span class="text-burn flex-shrink-0 mt-1 font-bold">&rarr;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {aicte.learningOutcomes.length > 0 && (
      <div class="mb-12">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">Learning Outcomes</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-5">What you will practically learn</h2>
        <div class="flex flex-wrap gap-2">
          {aicte.learningOutcomes.map((s) => (
            <span class="text-[0.85rem] text-ink-2 bg-white border border-ink/15 px-3.5 py-2 rounded-md font-medium">{s}</span>
          ))}
        </div>
      </div>
    )}

    {(aicte.qualifications.length > 0 || aicte.specialisations.length > 0) && (
      <div class="mb-12 grid grid-cols-1 md:grid-cols-2 gap-8">
        {aicte.qualifications.length > 0 && (
          <div>
            <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">Qualification{aicte.qualificationType ? ' (' + aicte.qualificationType + ')' : ''}</p>
            <ul class="space-y-2">
              {aicte.qualifications.map((q) => (
                <li class="flex gap-2 text-[0.9rem] text-ink-2"><span class="text-burn font-bold">&middot;</span><span>{q}</span></li>
              ))}
            </ul>
          </div>
        )}
        {aicte.specialisations.length > 0 && (
          <div>
            <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">Specialisation</p>
            <div class="flex flex-wrap gap-1.5">
              {aicte.specialisations.map((s) => (
                <span class="text-[0.78rem] text-ink-soft bg-cream-2 border border-ink/10 px-2.5 py-1 rounded-md">{s}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    {aicte.perks.length > 0 && (
      <div class="mb-12">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">Perks</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-5">What you get, beyond the work itself</h2>
        <ul class="space-y-3">
          {aicte.perks.map((p) => (
            <li class="flex gap-3 text-[0.93rem] text-ink-2 leading-[1.7]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-burn flex-shrink-0 mt-1"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* WORKING TIME. Always rendered, for every level. A senior role used to show nothing here at
        all, which left "what are the hours?" answered only by whatever the candidate assumed. */}
    <div class="mb-12">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">Terms of Engagement</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-3">{engagementHeading}</h2>
        <p class="text-[0.9rem] text-ink-2 leading-[1.8] mb-5 max-w-3xl">{engagement.headline}</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
          <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
            <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-1 font-bold">Type</p>
            <p class="text-[0.9rem] text-ink font-semibold">{engagementIsCounted ? (aicte.internshipMode || 'Full-Time') : engagement.label}</p>
          </div>
          {engagementFacts.map((f) => (
            <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
              <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-1 font-bold">{f.k}</p>
              <p class="text-[0.9rem] text-ink font-semibold">{f.v}</p>
            </div>
          ))}
          {engagementIsCounted && !!aicte.noOfInterns && (
            <div class="bg-cream-2 border border-ink/10 rounded-xl p-4">
              <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-1 font-bold">Positions</p>
              <p class="text-[0.9rem] text-ink font-semibold">{aicte.noOfInterns}</p>
            </div>
          )}
        </div>
        {engagementIsCounted && (
          <p class="text-[0.86rem] text-ink-2 leading-relaxed mb-4">
            <strong>Project work and departmental responsibilities</strong> and <strong>holistic well-being and personal development</strong> together make up the total engagement above &mdash; the total is not all task output. Well-being time covers physical fitness, mindfulness, reading, reflective learning, leadership development and community engagement. {engagementProgrammeTotal}
          </p>
        )}
        <div class="bg-cream-2 border border-ink/10 rounded-xl p-5 mb-4">
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-2 font-bold">Measured by</p>
          <p class="text-[0.86rem] text-ink-2 leading-[1.8] mb-3">{engagement.measuredBy}</p>
          <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-2 font-bold">Where this stands legally</p>
          <p class="text-[0.82rem] text-ink-soft leading-[1.8]">{engagement.statutoryNote}</p>
          {engagementIsCounted && engagementCredits != null && (
            <p class="text-[0.82rem] text-ink-soft leading-[1.8] mt-2">At a minimum of {AICTE_HOURS_PER_CREDIT} hours of work per academic credit, this engagement is equivalent to roughly {engagementCredits} credits. Your institution decides what it awards; EduRankAI records the hours and the work.</p>
          )}
          <p class="text-[0.82rem] text-ink-soft leading-[1.8] mt-2">The full per-level model is published at <a href="/policy/working-hours" class="text-burn font-semibold underline">Working Hours by Level</a>.</p>
        </div>
        {aicte.engagementNotes.length > 0 && (
          <ul class="space-y-2.5">
            {aicte.engagementNotes.map((n) => (
              <li class="flex gap-3 text-[0.86rem] text-ink-soft leading-[1.7]">
                <span class="text-burn flex-shrink-0 mt-1 font-bold">&middot;</span>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        )}
    </div>

    <div class="mb-12">
      <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">05 &mdash; Hiring process</p>
      <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-5">What to expect after you apply</h2>
      <ol class="space-y-4">
        <li class="flex gap-4 text-[0.92rem] text-ink-2 leading-[1.7]">
          <span class="font-mono text-[0.72rem] text-burn flex-shrink-0 mt-1 font-bold">01</span>
          <div>
            <p class="font-semibold text-ink mb-1">Application review</p>
            <p class="text-ink-soft text-[0.86rem]">Every application is read personally within five business days. We respond either way.</p>
          </div>
        </li>
        <li class="flex gap-4 text-[0.92rem] text-ink-2 leading-[1.7]">
          <span class="font-mono text-[0.72rem] text-burn flex-shrink-0 mt-1 font-bold">02</span>
          <div>
            <p class="font-semibold text-ink mb-1">Take-home or live exercise</p>
            <p class="text-ink-soft text-[0.86rem]">Role-specific. Time-boxed. Real problems we are actually working on, not invented puzzles.</p>
          </div>
        </li>
        <li class="flex gap-4 text-[0.92rem] text-ink-2 leading-[1.7]">
          <span class="font-mono text-[0.72rem] text-burn flex-shrink-0 mt-1 font-bold">03</span>
          <div>
            <p class="font-semibold text-ink mb-1">Conversations</p>
            <p class="text-ink-soft text-[0.86rem]">Deep technical and values conversations with the team you would join. No trick questions. No panel ambushes.</p>
          </div>
        </li>
        <li class="flex gap-4 text-[0.92rem] text-ink-2 leading-[1.7]">
          <span class="font-mono text-[0.72rem] text-burn flex-shrink-0 mt-1 font-bold">04</span>
          <div>
            <p class="font-semibold text-ink mb-1">Offer or honest no</p>
            <p class="text-ink-soft text-[0.86rem]">If yes: digital offer letter, signed in-portal, transparent terms. If no: written feedback if you want it.</p>
          </div>
        </li>
      </ol>
    </div>

    <!-- What this role hands over, and what it is judged on. A research posting that says what you
         will do but not what "done" looks like leaves the candidate guessing at the bar. -->
    {(hasPreferredSkills || hasTools || hasDeliverables || hasEvaluation || hasReportingTo || hasCollaborators) && (
      <div class="mb-12">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-burn mb-2 font-bold">The standard</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-5">What you deliver, and how it is judged</h2>

        <div class="grid gap-4 md:grid-cols-2">
          {hasDeliverables && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <h3 class="font-display text-[1rem] font-semibold text-ink m-0 mb-3">Deliverables</h3>
              <ul class="space-y-2 m-0 p-0 list-none">
                {roleExtension.deliverables.map((d) => (
                  <li class="text-[0.87rem] text-ink-2 leading-[1.6] pl-4 relative">
                    <span class="absolute left-0 top-[0.55em] w-1.5 h-1.5 rounded-full bg-burn"></span>{d}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {hasEvaluation && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <h3 class="font-display text-[1rem] font-semibold text-ink m-0 mb-3">Evaluation criteria</h3>
              <ul class="space-y-2 m-0 p-0 list-none">
                {roleExtension.evaluationCriteria.map((c) => (
                  <li class="text-[0.87rem] text-ink-2 leading-[1.6] pl-4 relative">
                    <span class="absolute left-0 top-[0.55em] w-1.5 h-1.5 rounded-full bg-sky"></span>{c}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {hasPreferredSkills && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <h3 class="font-display text-[1rem] font-semibold text-ink m-0 mb-1">Preferred, not required</h3>
              <p class="text-[0.78rem] text-ink-soft m-0 mb-3">Nothing in this list is a bar to applying.</p>
              <div class="flex flex-wrap gap-1.5">
                {roleExtension.preferredSkills.map((sk) => (
                  <span class="text-[0.74rem] text-ink-2 bg-cream-2 border border-ink/8 rounded-lg px-2.5 py-1">{sk}</span>
                ))}
              </div>
            </div>
          )}
          {hasTools && (
            <div class="bg-white border border-ink/10 rounded-2xl p-5">
              <h3 class="font-display text-[1rem] font-semibold text-ink m-0 mb-3">Tools you would work in</h3>
              <div class="flex flex-wrap gap-1.5">
                {roleExtension.tools.map((t) => (
                  <span class="text-[0.74rem] text-ink-2 bg-cream-2 border border-ink/8 rounded-lg px-2.5 py-1">{t}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        {(hasReportingTo || hasCollaborators) && (
          <div class="mt-4 bg-cream-2 border border-ink/10 rounded-2xl p-5">
            {hasReportingTo && (
              <p class="text-[0.87rem] text-ink-2 leading-relaxed m-0 mb-2">
                <strong class="font-semibold">Reports to:</strong> {roleExtension.reportingTo}
              </p>
            )}
            {hasCollaborators && (
              <p class="text-[0.87rem] text-ink-2 leading-relaxed m-0">
                <strong class="font-semibold">Works with:</strong> {roleExtension.collaboratesWith.join(', ')}
              </p>
            )}
          </div>
        )}
      </div>
    )}

    <div class="mt-12">
      <BeforeYouApply feeAmount={roleFeeAmount ?? undefined} feeCurrency={roleFeeCurrency} roleLevel={r.level} engagementType={r.engagementType} />
    </div>

    {acceptsApplications && (
      <div class="bg-white border-2 border-burn rounded-2xl p-6 md:p-8">
        <h3 class="font-display text-xl md:text-2xl font-semibold text-ink mb-3">Ready to apply?</h3>
        <p class="text-[0.9rem] text-ink-soft mb-5 leading-relaxed">
          We read every application personally. If you are the right person for this role &mdash; regardless of pedigree, background, or where you are based &mdash; you will hear back from us within five business days.
        </p>
        {hasApplicationInstructions && (
          <p class="text-[0.88rem] text-ink-2 mb-5 leading-[1.7] bg-cream-2 border border-ink/10 rounded-xl p-4">{roleExtension.applicationInstructions}</p>
        )}
        {deadlineLabel && (
          <p class="text-[0.84rem] font-semibold text-ink-2 mb-4">Applications close on {deadlineLabel}.</p>
        )}
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={applyHref} class="btn-primary flex-1 justify-center inline-flex items-center gap-2 text-center">Apply for {r.title} <span>&rarr;</span></a>
          <a href="/careers" class="btn-ghost flex-1 justify-center">See all open roles</a>
        </div>
      </div>
    )}

    <!-- CLOSED / PAUSED. The posting stays readable and says plainly what happened. There is no
         apply button, and there is no hidden one either: the submission path refuses this role
         server-side (refuseIfNotAccepting in src/lib/xscale/roles-ext.ts), so posting the form by
         hand does not get past it. -->
    {!acceptsApplications && (
      <div class="bg-white border-2 rounded-2xl p-6 md:p-8" style="border-color:#9a3412;">
        <h3 class="font-display text-xl md:text-2xl font-semibold text-ink mb-3">This role is not accepting applications</h3>
        <p class="text-[0.9rem] text-ink-2 mb-4 leading-relaxed">{closedNote}</p>
        <p class="text-[0.86rem] text-ink-soft mb-5 leading-relaxed">
          The description is left up so that you can see what it was, and so a link somebody sent you still
          leads somewhere. If you had started an application for it, nothing you entered has been submitted.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/careers" class="btn-primary flex-1 justify-center">See all open roles</a>
          <a href="/careers/opportunities" class="btn-ghost flex-1 justify-center">Search by field and scale</a>
        </div>
      </div>
    )}

    {relatedRoles.length > 0 && (
      <div class="mt-16 pt-12 border-t border-ink/10">
        <p class="text-[0.62rem] font-mono uppercase tracking-[0.15em] text-ink-soft mb-3 font-bold">Other roles in {deptName}</p>
        <h2 class="font-display text-xl md:text-2xl font-semibold text-ink mb-6">Explore related openings</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedRoles.map((rel) => (
            <a href={'/careers/' + rel.slug} class="bg-white border border-ink/10 rounded-xl p-5 hover:border-burn transition-colors group">
              <p class="font-display text-[1.05rem] font-semibold text-ink group-hover:text-burn transition-colors mb-2">{rel.title}</p>
              <div class="flex gap-2">
                <span class={'text-[0.68rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded border ' + (levelColors[rel.level] || 'bg-cream-2 text-ink-soft border-ink/15')}>{rel.level}</span>
                <span class="text-[0.68rem] font-semibold text-ink-soft bg-cream-2 border border-ink/10 px-2 py-0.5 rounded">{rel.engagementType}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- Sticky apply bar - appears after user scrolls past the hero. Rendered only when the posting
       actually accepts applications; a floating Apply button over a closed role is a promise the
       submission path is going to refuse. -->
  {acceptsApplications && (
  <div id="stickyApply" style="position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(255,255,255,0.96);backdrop-filter:blur(14px);border-top:1px solid rgba(0,0,0,0.1);padding:10px 5vw;transform:translateY(100%);transition:transform 0.25s ease;box-shadow:0 -4px 22px rgba(0,0,0,0.06);">
    <div style="max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;">
      <div style="min-width:0;flex:1;">
        <p style="font-size:11.5px;color:#6b7280;font-family:'Geist Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 1px;line-height:1.2;">{r.level} {r.engagementType}</p>
        <p style="font-size:14px;font-weight:600;color:#0F0F12;margin:0;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{r.title}</p>
      </div>
      <a href={applyHref} class="btn-primary" style="flex-shrink:0;font-size:13px;padding:9px 18px;white-space:nowrap;">Apply &rarr;</a>
    </div>
  </div>
  )}

  <script is:inline>
    (function() {
      var bar = document.getElementById('stickyApply');
      if (!bar) return;
      var threshold = 600;
      function check() {
        if (window.scrollY > threshold) {
          bar.style.transform = 'translateY(0)';
        } else {
          bar.style.transform = 'translateY(100%)';
        }
      }
      window.addEventListener('scroll', check, { passive: true });
      check();
    })();
  </script>
</BaseLayout>