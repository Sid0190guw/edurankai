        )}

        {hasScaleRange && (
          <div class="mb-4">
            <ScaleStrip minExp={roleExtension.scaleMinExp} maxExp={roleExtension.scaleMaxExp} showDisclaimer={false} />
          </div>
        )}

        {hasIntegrityNote && (
          <p class="text-[0.86rem] text-ink-2 leading-[1.7] bg-cream-2 border border-ink/10 rounded-xl p-4 mb-3">{roleExtension.integrityNote}</p>
