---
// /careers/division/[slug] — ONE DIVISION.
//
// The page a candidate reads before deciding whether this is their field. It leads with the scale
// range and the classification, and it puts the division's INTEGRITY NOTE above the openings rather
// than below them — the sentence that says what this work is and is not is not a footnote to be
// scrolled past after the job titles have already done their work.
//
// An unknown slug is a 404 with a page, not a redirect. A redirect tells somebody with a stale link
// that their bookmark still works.
import BaseLayout from '@/layouts/BaseLayout.astro';
import OpportunityCard from '@/components/careers/OpportunityCard.astro';
import ScaleStrip from '@/components/careers/ScaleStrip.astro';
import { db } from '@/lib/db';
import { departments } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { getDivisionBySlug, listDivisions } from '@/lib/xscale/divisions';
import { listOpportunities } from '@/lib/xscale/roles-ext';
import {
  SCALE_DISCLAIMER, bandsForRange, classificationDef, classificationEvidence,
  scaleRangeText, skillCategoryLabel,
} from '@/lib/xscale/taxonomy';

const { slug } = Astro.params;
const divisionSlug = String(slug || '');

const division = divisionSlug ? await getDivisionBySlug(divisionSlug) : null;
const notFound = !division;
if (notFound) Astro.response.status = 404;

let dept: any = null;
if (division) {
  try {
    const found = await db.select().from(departments).where(eq(departments.id, division.departmentId)).limit(1);
    dept = found[0] || null;
  } catch (e: any) {
    console.error('[division] department lookup failed:', e?.cause?.message || e?.message);
  }
}

const listing = division
  ? await listOpportunities({ divisionId: division.id, limit: 60 })
  : { rows: [], total: 0, readable: true, degraded: false };

// Sibling divisions, so somebody in the wrong place can move sideways rather than back out.
const siblings = division
  ? (await listDivisions({ departmentId: division.departmentId })).rows.filter((d) => d.id !== division.id)
  : [];

const hasScale = !!division
  && typeof division.scaleMinExp === 'number'
  && typeof division.scaleMaxExp === 'number';
const minExp = hasScale ? (division!.scaleMinExp as number) : null;
const maxExp = hasScale ? (division!.scaleMaxExp as number) : null;
const scaleText = hasScale ? scaleRangeText(minExp as number, maxExp as number) : '';
const bands = hasScale ? bandsForRange(minExp as number, maxExp as number) : [];
const reachableBands = bands.filter((b) => b.experimentallyAccessible);
const unreachableBands = bands.filter((b) => !b.experimentallyAccessible);
const hasUnreachable = unreachableBands.length > 0;
const allUnreachable = bands.length > 0 && reachableBands.length === 0;

const cls = division ? classificationDef(division.researchClassification) : null;
const ev = division ? classificationEvidence(division.researchClassification, minExp, maxExp) : null;

// Roles grouped by career rung, so the page reads as a ladder rather than as an unsorted list.
const byRung = new Map<number, typeof listing.rows>();
for (const r of listing.rows) {
  const k = typeof r.careerLevel === 'number' ? r.careerLevel : -1;
  if (!byRung.has(k)) byRung.set(k, []);
  byRung.get(k)!.push(r);
}
const rungGroups = Array.from(byRung.entries())
  .sort((a, b) => a[0] - b[0])
  .map(([rung, rows]) => ({ rung, rows }));

const hasRoles = listing.rows.length > 0;
const rolesUnreadable = listing.readable === false;
const hasDomains = !!division && division.domains.length > 0;
const hasSkillCats = !!division && division.skillCategories.length > 0;
const hasCollaborators = !!division && division.collaboratesWith.length > 0;
const hasSiblings = siblings.length > 0;
const hasCharter = !!division && division.charter.length > 0;

const pageTitle = division ? division.name : 'Division not found';
const metaDescription = division
  ? (division.summary + ' ' + scaleText).slice(0, 300)
  : 'This division could not be found.';
---

<BaseLayout title={pageTitle} description={metaDescription} noindex={notFound}>
  {notFound && (
    <section class="px-[5vw] py-16 max-w-3xl mx-auto">
      <p class="eyebrow mb-2">404</p>
      <h1 class="font-display text-[1.7rem] font-semibold text-ink mb-3">There is no division at this address</h1>
      <p class="text-[0.92rem] text-ink-2 leading-relaxed mb-5">
        The link may be old, or the division may not have been published yet. The directory lists every
        department and the divisions inside it.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/careers/departments" class="btn-primary no-underline">Department directory</a>
        <a href="/careers/opportunities" class="btn-ghost no-underline">Search opportunities</a>
      </div>
    </section>
  )}

  {division && (
    <>
      <!-- ============================== HEADER ============================== -->
      <section class="px-[5vw] pt-9 md:pt-12 pb-5 max-w-7xl mx-auto">
        <p class="eyebrow mb-2">
          <a href="/careers/departments" class="text-inherit no-underline hover:underline">Departments</a>
          <span class="mx-1.5 text-ink-soft/50">/</span>
          {dept
            ? <a href={`/careers/department/${division.departmentId}`} class="text-inherit no-underline hover:underline">{dept.name}</a>
            : division.departmentId}
          {division.code && <span class="mx-1.5 text-ink-soft/50">/</span>}
          {division.code && <span class="font-mono">{division.code}</span>}
        </p>
        <h1 class="font-display text-[clamp(1.8rem,4.4vw,2.7rem)] font-semibold text-ink leading-[1.07] tracking-tight mb-3">
          {division.name}
        </h1>
        <p class="text-[0.95rem] text-ink-2 leading-relaxed max-w-3xl mb-4">{division.summary}</p>

        <div class="flex flex-wrap items-center gap-2">
          {cls && (
            <span class="text-[0.74rem] font-semibold text-burn bg-burn-pale border border-burn-dim rounded-full px-3 py-1">{cls.label}</span>
          )}
          {ev && (
            <span class="text-[0.74rem] font-medium text-ink-2 bg-cream-2 border border-ink/10 rounded-full px-3 py-1">{ev.label}</span>
          )}
          {hasScale && (
            <span class="text-[0.74rem] font-mono text-ink-2 bg-cream-2 border border-ink/10 rounded-full px-3 py-1">{scaleText}</span>
          )}
          <span class="text-[0.74rem] font-medium text-ink-2 bg-cream-2 border border-ink/10 rounded-full px-3 py-1">
            {listing.total} open
          </span>
        </div>
      </section>

      <!-- ============================== HONESTY, ABOVE THE JOBS ============================== -->
      <section class="px-[5vw] pb-6 max-w-7xl mx-auto">
        <div class="bg-white border border-ink/10 rounded-2xl p-5 md:p-6" style="border-left:4px solid #9a3412;">
          <h2 class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">
            What this work is, and what it is not
          </h2>
          <p class="text-[0.88rem] text-ink-2 leading-[1.7] m-0 mb-3">{division.integrityNote}</p>
          {ev && (
            <p class="text-[0.85rem] text-ink-2 leading-[1.7] m-0 mb-3">
              <strong class="font-semibold">{ev.label}.</strong> {ev.statement}
            </p>
          )}
          {allUnreachable && (
            <p class="text-[0.85rem] leading-[1.7] m-0 mb-3" style="color:#9a3412;">
              No part of this division's declared range is reachable by any apparatus that exists. The work here
              is mathematics, theory and computation, and it is worth doing on those terms — but nothing produced
              in it is a demonstrated physical fact or an available technology.
            </p>
          )}
          {hasUnreachable && !allUnreachable && (
            <p class="text-[0.85rem] text-ink-2 leading-[1.7] m-0 mb-3">
              Part of this division's range sits where no experiment reaches:
              {' '}{unreachableBands.map((b) => b.label).join(', ')}. Work in those bands is theory and computation,
              and every posting says which side of that line it falls on.
            </p>
          )}
          <p class="text-[0.78rem] text-ink-soft leading-relaxed m-0">{SCALE_DISCLAIMER}</p>
        </div>
      </section>

      {hasScale && (
        <section class="px-[5vw] pb-6 max-w-7xl mx-auto">
          <div class="bg-white border border-ink/10 rounded-2xl p-5">
            <h2 class="font-display text-[1rem] font-semibold text-ink m-0 mb-3">Where this division sits</h2>
            <ScaleStrip minExp={minExp} maxExp={maxExp} hrefBase="/careers/opportunities" showDisclaimer={false} />
            <div class="mt-4 grid gap-2">
              {bands.map((b) => (
                <div class="flex items-start gap-3">
                  <span class="shrink-0 mt-0.5 text-[0.64rem] font-mono font-bold rounded px-1.5 py-0.5" style={b.experimentallyAccessible ? 'color:#1f5136;background:#E4EEE7;' : 'color:#9a3412;background:#FCEBE2;'}>
                    {b.id.replace('BAND_', 'B')}
                  </span>
                  <p class="text-[0.8rem] text-ink-2 leading-relaxed m-0">
                    <strong class="font-semibold">{b.label}</strong>
                    <span class="font-mono text-[0.72rem] text-ink-soft"> ({scaleRangeText(b.minExp, b.maxExp, '')})</span>
                    <br />{b.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {hasCharter && (
        <section class="px-[5vw] pb-6 max-w-7xl mx-auto">
          <div class="bg-cream-2 border border-ink/10 rounded-2xl p-5 md:p-6">
            <h2 class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">Charter</h2>
            <p class="text-[0.9rem] text-ink-2 leading-[1.75] max-w-3xl m-0">{division.charter}</p>
          </div>
        </section>
      )}

      {(hasDomains || hasSkillCats || hasCollaborators) && (
        <section class="px-[5vw] pb-8 max-w-7xl mx-auto">
          <div class="grid gap-4 md:grid-cols-3">
            {hasDomains && (
              <div class="bg-white border border-ink/10 rounded-2xl p-5">
                <h2 class="font-display text-[0.95rem] font-semibold text-ink m-0 mb-3">Domains</h2>
                <div class="flex flex-wrap gap-1.5">
                  {division.domains.map((d) => (
                    <span class="text-[0.74rem] text-ink-2 bg-cream-2 border border-ink/8 rounded-lg px-2.5 py-1">{d}</span>
                  ))}
                </div>
              </div>
            )}
            {hasSkillCats && (
              <div class="bg-white border border-ink/10 rounded-2xl p-5">
                <h2 class="font-display text-[0.95rem] font-semibold text-ink m-0 mb-3">Disciplines</h2>
                <div class="flex flex-wrap gap-1.5">
                  {division.skillCategories.map((k) => (
                    <a href={`/careers/opportunities?skillcat=${k}`} class="text-[0.74rem] text-ink-2 bg-cream-2 border border-ink/8 rounded-lg px-2.5 py-1 no-underline hover:border-ink/25 transition-colors">
                      {skillCategoryLabel(k) || k}
                    </a>
                  ))}
                </div>
              </div>
            )}
            {hasCollaborators && (
              <div class="bg-white border border-ink/10 rounded-2xl p-5">
                <h2 class="font-display text-[0.95rem] font-semibold text-ink m-0 mb-3">Works with</h2>
                <p class="text-[0.78rem] text-ink-soft leading-relaxed m-0 mb-2">
                  Divisions this one collaborates with routinely.
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {division.collaboratesWith.map((c) => (
                    <span class="text-[0.72rem] font-mono text-ink-2 bg-cream-2 border border-ink/8 rounded-lg px-2 py-1">{c}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- ============================== OPENINGS ============================== -->
      <section id="openings" class="px-[5vw] pb-12 max-w-7xl mx-auto scroll-mt-20">
        <h2 class="font-display text-[1.3rem] font-semibold text-ink mb-1">
          {listing.total} open {listing.total === 1 ? 'opportunity' : 'opportunities'}
        </h2>
        <p class="text-[0.85rem] text-ink-soft mb-5 max-w-3xl">
          Grouped by career rung. Every posting states its own classification, its scale range and what it
          expects you to have already done.
        </p>

        {rolesUnreadable && (
          <div class="bg-white border border-ink/10 rounded-2xl p-6" style="border-left:4px solid #9a3412;">
            <p class="text-[0.88rem] text-ink-2 leading-relaxed m-0">
              We could not load this division's opportunities. That is a fault on our side, not an empty list.
              Try again shortly, or write to
              <a href="mailto:hr@edurankai.in" class="text-burn font-semibold no-underline hover:underline"> hr@edurankai.in</a>.
            </p>
          </div>
        )}

        {!rolesUnreadable && !hasRoles && (
          <div class="bg-white border border-ink/10 rounded-2xl p-8 text-center">
            <p class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">Nothing is open in this division today.</p>
            <p class="text-[0.86rem] text-ink-soft max-w-lg mx-auto m-0 mb-4">
              This is the real state of the division, not a filtered view. The other divisions in this
              department may be hiring.
            </p>
            <div class="flex flex-wrap gap-2 justify-center">
              <a href={`/careers/department/${division.departmentId}`} class="btn-primary no-underline">The whole department</a>
              <a href="/careers/opportunities" class="btn-ghost no-underline">Search everything</a>
            </div>
          </div>
        )}

        {hasRoles && rungGroups.map((g) => (
          <div class="mb-7">
            <h3 class="text-[0.74rem] font-bold uppercase tracking-[0.1em] text-ink-soft mb-3 pb-2 border-b border-ink/8">
              {g.rung >= 0 ? 'Level ' + g.rung : 'Other'}
              <span class="ml-2 font-mono font-normal text-ink-soft/70">{g.rows.length}</span>
            </h3>
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
              {g.rows.map((r) => <OpportunityCard role={r} showDivision={false} />)}
            </div>
          </div>
        ))}
      </section>

      {hasSiblings && (
        <section class="px-[5vw] pb-14 max-w-7xl mx-auto">
          <h2 class="font-display text-[1.05rem] font-semibold text-ink mb-3">Other divisions in this department</h2>
          <div class="flex flex-wrap gap-2">
            {siblings.map((s) => (
              <a href={`/careers/division/${s.slug}`} class="text-[0.8rem] text-ink-2 bg-white border border-ink/10 rounded-lg px-3 py-2 no-underline hover:border-ink/25 transition-colors">
                {s.name}
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
