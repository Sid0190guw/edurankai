---
// /careers/membership — Membership section (SCAFFOLD).
// Intentionally a structural placeholder: the hero, the three-tier layout and the benefit rows
// are in place so the section can be filled in later without redesigning it. Nothing here charges
// or persists anything yet — the tiers below are drafts, clearly marked, not live products.
// When we build this out: wire tiers to a `memberships` table, gate benefits, and add checkout.
import BaseLayout from '@/layouts/BaseLayout.astro';

const user = Astro.locals.user;

// Draft tiers — placeholders to be finalised. Not offered, not priced live.
const TIERS = [
  {
    name: 'Community',
    tagline: 'For everyone starting out',
    points: ['Member profile', 'Save roles & track applications', 'Community updates'],
    accent: '#128a3f',
  },
  {
    name: 'Plus',
    tagline: 'For active candidates & learners',
    points: ['Everything in Community', 'Priority review', 'Early access to new openings'],
    accent: '#1045BB',
    featured: true,
  },
  {
    name: 'Pro',
    tagline: 'For serious, ongoing engagement',
    points: ['Everything in Plus', 'One-to-one guidance', 'Recognition & credentials'],
    accent: '#FF4F00',
  },
];
---
<BaseLayout title="Membership — EduRankAI" description="EduRankAI membership — benefits for candidates and learners. Launching soon.">
  <section class="mx-auto max-w-5xl px-4 py-12 md:py-16">

    <p class="text-[0.62rem] font-mono uppercase tracking-[0.18em] text-burn font-bold mb-3">Membership</p>
    <h1 class="font-display text-[1.9rem] md:text-[2.4rem] font-semibold text-ink leading-[1.1] mb-3">
      One membership, more from EduRankAI.
    </h1>
    <p class="text-[0.98rem] text-ink-2 leading-relaxed max-w-2xl mb-2">
      A single membership that follows you across the platform — applying, learning and growing with us.
      We're finalising the tiers and benefits below.
    </p>
    <div class="inline-flex items-center gap-2 bg-burn-pale border border-burn-dim rounded-full px-3.5 py-1.5 text-[0.78rem] font-semibold text-burn mb-10">
      <span style="width:7px;height:7px;border-radius:50%;background:#FF4F00;display:inline-block;"></span>
      Launching soon — this section is being set up
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      {TIERS.map((t) => (
        <div class="relative bg-white rounded-2xl p-6" style={`border:1px solid rgba(14,11,8,0.10);border-top:4px solid ${t.accent};${t.featured ? 'box-shadow:0 12px 30px -14px rgba(16,69,187,0.35);' : ''}`}>
          {t.featured && (
            <span class="absolute top-4 right-4 text-[0.6rem] font-mono uppercase tracking-[0.14em] font-bold px-2 py-0.5 rounded-full" style="background:#EBF0FF;color:#1045BB;">Popular</span>
          )}
          <h2 class="font-display text-[1.25rem] font-semibold text-ink m-0 mb-1">{t.name}</h2>
          <p class="text-[0.82rem] text-ink-soft m-0 mb-4">{t.tagline}</p>
          <ul class="list-none p-0 m-0 space-y-2.5">
            {t.points.map((p) => (
              <li class="flex items-start gap-2 text-[0.86rem] text-ink-2 leading-snug">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={t.accent} stroke-width="2.4" class="mt-0.5 shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 pt-4 border-t border-ink/8">
            <span class="inline-block text-[0.78rem] font-semibold text-ink-soft">Details coming soon</span>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-cream-2 border border-ink/10 rounded-2xl p-6 md:p-7 flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
      <div>
        <h3 class="font-display text-[1.1rem] font-semibold text-ink m-0 mb-1">Want to hear when membership opens?</h3>
        <p class="text-[0.86rem] text-ink-soft m-0">We'll let you know inside your portal the moment it goes live.</p>
      </div>
      <a href={user ? '/portal' : '/portal/login?next=/careers/membership'}
         class="shrink-0 bg-ink hover:bg-ink/90 text-white font-semibold py-2.5 px-6 rounded-xl text-[0.88rem] no-underline text-center">
        {user ? 'Go to my portal' : 'Sign in to your portal'}
      </a>
    </div>

  </section>
</BaseLayout>
