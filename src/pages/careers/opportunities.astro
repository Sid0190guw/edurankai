---
// /careers/opportunities — THE RESEARCH OPPORTUNITY SEARCH.
//
// The site already has /careers, which works and lists everything by team. This page is the surface
// the research department needs and that one does not have: search and filter by division, by
// research classification, by scale band, by skill category, by career rung and by posting date, with
// every filter carried in the URL so a result can be shared, bookmarked and cleared.
//
// IT DOES NOT REPLACE /careers. Adding six filters to a 569-line page that is working and is the
// site's main hiring surface would risk it for no gain; this page links back to it and it links here.
//
// ONE QUERY, ONE VISIBILITY RULE. Everything comes from listOpportunities(), which is also what the
// department page and the division pages call. A filter added there works on all three at once and
// the rule about what the public may see is written down in exactly one place.
//
// EVERY COMPARISON IS IN THE FRONTMATTER. A `<` inside a JSX expression breaks .astro parsing, and a
// typed Record<string,string> in the markup does too. Both have taken pages down on this project.
import BaseLayout from '@/layouts/BaseLayout.astro';
import OpportunityCard from '@/components/careers/OpportunityCard.astro';
import ScaleStrip from '@/components/careers/ScaleStrip.astro';
import { db } from '@/lib/db';
import { departments } from '@/lib/db/schema';
import { asc } from 'drizzle-orm';
import { listOpportunities } from '@/lib/xscale/roles-ext';
import { listDivisions } from '@/lib/xscale/divisions';
import {
  CAREER_LADDER, RESEARCH_CLASSIFICATIONS, SCALE_BANDS, SKILL_CATEGORIES,
  SCALE_DISCLAIMER, scaleBand, classificationDef, scaleRangeText,
} from '@/lib/xscale/taxonomy';

const url = new URL(Astro.request.url);
const p = url.searchParams;
const str = (k: string) => (p.get(k) || '').trim();
const q = str('q');
const deptFilter = str('dept');
const divisionFilter = str('division');
const levelFilter = str('level');
const rungRaw = str('rung');
const rung = rungRaw === '' ? null : Number(rungRaw);
const engagementFilter = str('type');
const modeFilter = str('mode');
const classificationFilter = str('classification');
const bandFilter = str('band');
const skillCatFilter = str('skillcat');
const skillFilter = str('skill');
const postedRaw = str('posted');
const posted = postedRaw === '' ? 0 : Number(postedRaw);

const PAGE_SIZE = 24;
const pageRaw = Number(str('page') || '1');
const page = Number.isFinite(pageRaw) && pageRaw >= 1 ? Math.floor(pageRaw) : 1;

const anyFilter = !!(q || deptFilter || divisionFilter || levelFilter || rungRaw || engagementFilter
  || modeFilter || classificationFilter || bandFilter || skillCatFilter || skillFilter || postedRaw);

// Reference data. Both tolerate a missing table and say which of "nothing there" and "could not
// look" happened, because an empty filter dropdown and a broken one look identical otherwise.
let allDepts: any[] = [];
let deptsReadable = true;
try {
  allDepts = await db.select().from(departments).orderBy(asc(departments.sortOrder));
} catch (e: any) {
  deptsReadable = false;
  console.error('[opportunities] departments:', e?.cause?.message || e?.message);
}

const divisionList = await listDivisions({ departmentId: deptFilter || null });

const result = await listOpportunities({
  q,
  departmentId: deptFilter || undefined,
  divisionId: divisionFilter || undefined,
  level: levelFilter || undefined,
  careerLevel: Number.isFinite(rung as number) ? (rung as number) : null,
  engagementType: engagementFilter || undefined,
  workMode: modeFilter || undefined,
  classification: classificationFilter || undefined,
  band: bandFilter || undefined,
  skillCategory: skillCatFilter || undefined,
  skill: skillFilter || undefined,
  postedWithinDays: Number.isFinite(posted) && posted > 0 ? posted : undefined,
  limit: PAGE_SIZE,
  offset: (page - 1) * PAGE_SIZE,
});

const total = result.total;
const shown = result.rows.length;
const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));
const hasPrev = page > 1;
const hasNext = page < pageCount;
const isEmpty = shown === 0;
const unreadable = result.readable === false;
const degraded = result.degraded === true;

// The URL for another page, keeping every filter. Built here rather than inline because a template
// literal with a comparison in it is exactly the kind of expression .astro chokes on.
function pageHref(n: number): string {
  const next = new URLSearchParams(p);
  next.set('page', String(n));
  return '/careers/opportunities?' + next.toString();
}
const prevHref = pageHref(page - 1);
const nextHref = pageHref(page + 1);

// A filter chip's "remove me" URL. Same reason: computed, never inlined.
function withoutParam(key: string): string {
  const next = new URLSearchParams(p);
  next.delete(key);
  next.delete('page');
  const s = next.toString();
  return '/careers/opportunities' + (s ? '?' + s : '');
}

const activeChips: { label: string; href: string }[] = [];
if (q) activeChips.push({ label: 'Search: ' + q, href: withoutParam('q') });
if (deptFilter) activeChips.push({ label: 'Department: ' + (allDepts.find((d) => d.id === deptFilter)?.name || deptFilter), href: withoutParam('dept') });
if (divisionFilter) activeChips.push({ label: 'Division: ' + (divisionList.rows.find((d) => d.id === divisionFilter)?.name || divisionFilter), href: withoutParam('division') });
if (classificationFilter) activeChips.push({ label: 'Classification: ' + (classificationDef(classificationFilter)?.label || classificationFilter), href: withoutParam('classification') });
if (bandFilter) activeChips.push({ label: 'Scale: ' + (scaleBand(bandFilter)?.label || bandFilter), href: withoutParam('band') });
if (skillCatFilter) activeChips.push({ label: 'Discipline: ' + (SKILL_CATEGORIES.find((c) => c.key === skillCatFilter)?.label || skillCatFilter), href: withoutParam('skillcat') });
if (skillFilter) activeChips.push({ label: 'Skill: ' + skillFilter, href: withoutParam('skill') });
if (levelFilter) activeChips.push({ label: 'Level: ' + levelFilter, href: withoutParam('level') });
if (rungRaw) activeChips.push({ label: 'Rung: L' + rungRaw, href: withoutParam('rung') });
if (engagementFilter) activeChips.push({ label: engagementFilter, href: withoutParam('type') });
if (modeFilter) activeChips.push({ label: modeFilter, href: withoutParam('mode') });
if (postedRaw) activeChips.push({ label: 'Posted in ' + postedRaw + ' days', href: withoutParam('posted') });
const hasChips = activeChips.length > 0;

const LEVELS = ['C-Level', 'Lead', 'Senior', 'Mid', 'Junior', 'Intern', 'Apprentice'];
const ENGAGEMENTS = ['Full-Time', 'Internship', 'Apprenticeship'];
const MODES = ['On site', 'Hybrid'];
const POSTED_OPTIONS = [
  { value: '7', label: 'Last 7 days' },
  { value: '30', label: 'Last 30 days' },
  { value: '90', label: 'Last 90 days' },
];

const selectedBand = scaleBand(bandFilter);
const hasDivisions = divisionList.rows.length > 0;
const divisionsUnreadable = divisionList.readable === false;

// A whole skill list for the datalist, so the skill box suggests real vocabulary rather than
// inviting a guess that matches nothing.
const skillSuggestions = SKILL_CATEGORIES.flatMap((c) => c.skills).slice(0, 260);

const pageTitle = 'Research opportunities';
const metaDescription =
  'Search open research and engineering opportunities by division, research classification, scale band, '
  + 'discipline and career level. Every posting states whether the work is theoretical, computational, '
  + 'experimental, prototype or applied engineering.';
---

<BaseLayout title={pageTitle} description={metaDescription}>
  <section class="px-[5vw] pt-9 md:pt-12 pb-4 max-w-7xl mx-auto">
    <p class="eyebrow mb-2">Careers &middot; Research opportunities</p>
    <h1 class="font-display text-[clamp(1.9rem,4.6vw,2.9rem)] font-semibold text-ink leading-[1.06] tracking-tight mb-3">
      Search by what the work actually is
    </h1>
    <p class="text-[0.95rem] text-ink-2 leading-relaxed max-w-3xl mb-4">
      Every research posting carries a classification and a scale range. Filter by either, and by division,
      discipline, career rung or how recently it was posted. Everything you choose is kept in the address bar,
      so a search can be shared or bookmarked.
    </p>
    <p class="text-[0.8rem] text-ink-soft leading-relaxed max-w-3xl mb-5">{SCALE_DISCLAIMER}</p>

    <div class="flex flex-wrap gap-2 mb-2">
      <a href="/careers" class="text-[0.78rem] font-semibold text-burn px-3 py-1.5 rounded-lg border border-burn-dim bg-burn-pale no-underline hover:bg-burn-pale/70">All roles across every team &rarr;</a>
      <a href="/careers/departments" class="text-[0.78rem] font-semibold text-sky px-3 py-1.5 rounded-lg border border-sky-border bg-sky-bg no-underline hover:opacity-80">Department directory &rarr;</a>
    </div>
  </section>

  <!-- ============================== BROWSE BY SCALE ============================== -->
  <section class="px-[5vw] pb-5 max-w-7xl mx-auto">
    <div class="bg-white border border-ink/10 rounded-2xl p-4 md:p-5">
      <h2 class="font-display text-[1.02rem] font-semibold text-ink m-0 mb-1">Browse by scale band</h2>
      <p class="text-[0.8rem] text-ink-soft m-0 mb-3">
        Eleven bands from 10<sup>-100</sup> m to 10<sup>100</sup> m. Click one to filter.
        The hatched bands are the ones no apparatus reaches.
      </p>
      <ScaleStrip hrefBase="/careers/opportunities" showDisclaimer={false} />
      {selectedBand && (
        <p class="text-[0.82rem] text-ink-2 leading-relaxed mt-3 mb-0 pt-3 border-t border-ink/8">
          <strong class="font-semibold">{selectedBand.label}</strong>
          <span class="font-mono text-[0.76rem] text-ink-soft"> ({scaleRangeText(selectedBand.minExp, selectedBand.maxExp)})</span>
          <br />{selectedBand.description}
        </p>
      )}
    </div>
  </section>

  <!-- ============================== FILTERS ============================== -->
  <section id="results" class="px-[5vw] pb-10 max-w-7xl mx-auto scroll-mt-20">
    <form method="GET" class="bg-white border border-ink/10 rounded-2xl p-3 md:p-4 mb-4">
      <div class="flex items-center gap-2.5 bg-cream-2 border border-ink/10 rounded-xl px-3.5 py-2.5 focus-within:border-burn transition-colors mb-3">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-soft/60 flex-shrink-0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <label for="opp-q" class="sr-only">Search opportunities</label>
        <input id="opp-q" type="text" name="q" value={q} placeholder="Search a title, a domain, a tool (Qiskit, GROMACS, MPI)..." class="flex-1 bg-transparent border-0 outline-none text-[0.9rem] text-ink placeholder:text-ink-soft/60" />
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <div>
          <label for="f-dept" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Department</label>
          <select id="f-dept" name="dept" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">All departments</option>
            {allDepts.map((d) => <option value={d.id} selected={deptFilter === d.id}>{d.name}</option>)}
          </select>
        </div>

        <div>
          <label for="f-division" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Division</label>
          <select id="f-division" name="division" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">All divisions</option>
            {divisionList.rows.map((d) => <option value={d.id} selected={divisionFilter === d.id}>{d.name}</option>)}
          </select>
        </div>

        <div>
          <label for="f-classification" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Research classification</label>
          <select id="f-classification" name="classification" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any classification</option>
            {RESEARCH_CLASSIFICATIONS.map((c) => <option value={c.key} selected={classificationFilter === c.key}>{c.label}</option>)}
          </select>
        </div>

        <div>
          <label for="f-band" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Scale band</label>
          <select id="f-band" name="band" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any scale</option>
            {SCALE_BANDS.map((b) => <option value={b.id} selected={bandFilter === b.id}>{b.label}</option>)}
          </select>
        </div>

        <div>
          <label for="f-skillcat" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Discipline</label>
          <select id="f-skillcat" name="skillcat" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any discipline</option>
            {SKILL_CATEGORIES.map((c) => <option value={c.key} selected={skillCatFilter === c.key}>{c.label}</option>)}
          </select>
        </div>

        <div>
          <label for="f-skill" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Specific skill</label>
          <input id="f-skill" type="text" name="skill" value={skillFilter} list="skill-options" placeholder="e.g. Tensor calculus" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn" />
          <datalist id="skill-options">
            {skillSuggestions.map((s) => <option value={s}></option>)}
          </datalist>
        </div>

        <div>
          <label for="f-rung" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Career rung</label>
          <select id="f-rung" name="rung" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any rung</option>
            {CAREER_LADDER.map((r) => <option value={String(r.level)} selected={rungRaw === String(r.level)}>L{r.level} &middot; {r.label}</option>)}
          </select>
        </div>

        <div>
          <label for="f-level" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Seniority</label>
          <select id="f-level" name="level" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">All levels</option>
            {LEVELS.map((lv) => <option value={lv} selected={levelFilter === lv}>{lv}</option>)}
          </select>
        </div>

        <div>
          <label for="f-type" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Engagement</label>
          <select id="f-type" name="type" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any engagement</option>
            {ENGAGEMENTS.map((t) => <option value={t} selected={engagementFilter === t}>{t}</option>)}
          </select>
        </div>

        <div>
          <label for="f-mode" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Work mode</label>
          <select id="f-mode" name="mode" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any mode</option>
            {MODES.map((m) => <option value={m} selected={modeFilter === m}>{m}</option>)}
          </select>
        </div>

        <div>
          <label for="f-posted" class="block text-[0.68rem] font-semibold uppercase tracking-wider text-ink-soft mb-1">Posted</label>
          <select id="f-posted" name="posted" class="w-full border border-ink/15 bg-white rounded-xl px-3 py-2 text-[0.82rem] text-ink-2 outline-none focus:border-burn">
            <option value="">Any time</option>
            {POSTED_OPTIONS.map((o) => <option value={o.value} selected={postedRaw === o.value}>{o.label}</option>)}
          </select>
        </div>

        <div class="flex items-end gap-2">
          <button type="submit" class="btn-primary flex-1 whitespace-nowrap">Filter</button>
          {anyFilter && (
            <a href="/careers/opportunities" class="btn-ghost whitespace-nowrap text-center">Clear</a>
          )}
        </div>
      </div>
    </form>

    {hasChips && (
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="text-[0.72rem] font-semibold uppercase tracking-wider text-ink-soft">Filtering by</span>
        {activeChips.map((c) => (
          <a href={c.href} class="inline-flex items-center gap-1.5 text-[0.74rem] font-medium text-ink-2 bg-cream-2 border border-ink/10 rounded-full pl-3 pr-2 py-1 no-underline hover:border-ink/25">
            {c.label}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </a>
        ))}
        <a href="/careers/opportunities" class="text-[0.74rem] font-semibold text-burn no-underline hover:underline">Clear all</a>
      </div>
    )}

    <!-- STATE: could not read. Reported separately from "nothing matched", because they are
         different facts and telling a candidate there are no roles when the database is down is a
         lie the system would be telling on its own initiative. -->
    {unreadable && (
      <div class="bg-white border border-ink/10 rounded-2xl p-6 mb-4" style="border-left:4px solid #9a3412;">
        <h2 class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">We could not load opportunities just now</h2>
        <p class="text-[0.88rem] text-ink-2 leading-relaxed m-0">
          This is a fault on our side, not an empty list. Please try again in a moment, or write to
          <a href="mailto:hr@edurankai.in" class="text-burn font-semibold no-underline hover:underline"> hr@edurankai.in</a> and
          we will send you what is open.
        </p>
      </div>
    )}

    {degraded && !unreadable && (
      <div class="bg-white border border-ink/10 rounded-2xl px-5 py-3 mb-4" style="border-left:4px solid #8a5a00;">
        <p class="text-[0.83rem] text-ink-2 leading-relaxed m-0">
          The research classification fields are not available on this deployment yet, so the classification,
          scale and division filters are inactive. The roles below are real and the search still works.
        </p>
      </div>
    )}

    {!unreadable && (
      <div class="mb-4 flex items-center justify-between flex-wrap gap-2">
        <p class="text-[0.85rem] text-ink-soft m-0">
          <strong class="text-ink font-semibold">{total}</strong> {total === 1 ? 'opportunity' : 'opportunities'}{anyFilter ? ' match your filters' : ''}
        </p>
        {pageCount > 1 && (
          <p class="text-[0.75rem] font-mono text-ink-soft/70 m-0">Page {page} of {pageCount}</p>
        )}
      </div>
    )}

    {!unreadable && isEmpty && (
      <div class="bg-white border border-ink/10 rounded-2xl p-8 text-center">
        <h2 class="font-display text-[1.1rem] font-semibold text-ink m-0 mb-2">No opportunities match your current filters.</h2>
        <p class="text-[0.88rem] text-ink-soft leading-relaxed max-w-lg mx-auto m-0 mb-4">
          Try widening the scale band or the classification first — those are the two that narrow a search
          fastest. Nothing here is hidden from you; this really is everything that matches.
        </p>
        <div class="flex flex-wrap gap-2 justify-center">
          <a href="/careers/opportunities" class="btn-primary no-underline">Clear filters</a>
          <a href="/careers" class="btn-ghost no-underline">Browse every team</a>
        </div>
      </div>
    )}

    {!isEmpty && (
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {result.rows.map((r) => <OpportunityCard role={r} />)}
      </div>
    )}

    {pageCount > 1 && (
      <nav class="flex items-center justify-center gap-3 mt-7" aria-label="Pagination">
        {hasPrev
          ? <a href={prevHref} class="btn-ghost no-underline">&larr; Previous</a>
          : <span class="btn-ghost opacity-40 cursor-not-allowed">&larr; Previous</span>}
        <span class="text-[0.8rem] font-mono text-ink-soft">{page} / {pageCount}</span>
        {hasNext
          ? <a href={nextHref} class="btn-ghost no-underline">Next &rarr;</a>
          : <span class="btn-ghost opacity-40 cursor-not-allowed">Next &rarr;</span>}
      </nav>
    )}
  </section>

  <!-- ============================== DIVISIONS ============================== -->
  {hasDivisions && (
    <section class="px-[5vw] pb-14 max-w-7xl mx-auto">
      <h2 class="font-display text-[1.3rem] font-semibold text-ink mb-1">Browse by division</h2>
      <p class="text-[0.85rem] text-ink-soft mb-4 max-w-2xl">
        Each division states the scale it works at and the kind of work it does, at the top of its own page.
      </p>
      <div class="grid gap-2.5 md:grid-cols-2 xl:grid-cols-3">
        {divisionList.rows.map((d) => (
          <a href={`/careers/division/${d.slug}`} class="block bg-white border border-ink/10 rounded-xl p-4 no-underline text-inherit hover:border-ink/25 transition-colors">
            <p class="font-display text-[0.95rem] font-semibold text-ink m-0 mb-1">{d.name}</p>
            <p class="text-[0.78rem] text-ink-soft leading-relaxed m-0 line-clamp-2">{d.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {divisionsUnreadable && (
    <section class="px-[5vw] pb-14 max-w-7xl mx-auto">
      <div class="bg-white border border-ink/10 rounded-2xl px-5 py-4" style="border-left:4px solid #8a5a00;">
        <p class="text-[0.83rem] text-ink-2 leading-relaxed m-0">
          The division register could not be read, so divisions are not listed here. That is a fault on our
          side rather than an empty department.
        </p>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .line-clamp-2 {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>
