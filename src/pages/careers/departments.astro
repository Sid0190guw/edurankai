---
// /careers/departments — THE DEPARTMENT DIRECTORY.
//
// The site had no directory. /careers grouped roles by team inside one long page, which works when
// you already know you want a job and does not work when you want to know what the organisation is
// made of. This page is the second thing: a list of departments, each with its open count, its
// divisions where it has them, and a route into a filtered listing.
//
// COUNTS ARE READ IN ONE QUERY, NOT ONE PER DEPARTMENT. A count per row on a page listing thirty
// departments is thirty sequential round trips on a public page, which is the shape that made
// /careers take five seconds on a cold instance.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { db } from '@/lib/db';
import { departments } from '@/lib/db/schema';
import { sql, asc } from 'drizzle-orm';
import { listDivisions, openRoleCountByDivision } from '@/lib/xscale/divisions';
import { XSCALE_DEPARTMENT_ID } from '@/data/xscale-catalog';
import { SCALE_DISCLAIMER_SHORT } from '@/lib/xscale/taxonomy';

const rowsOf = (r: any): any[] => (Array.isArray(r) ? r : (r?.rows || []));

let allDepts: any[] = [];
let deptsReadable = true;
try {
  allDepts = await db.select().from(departments)
    .where(sql`is_visible = TRUE`)
    .orderBy(asc(departments.sortOrder), asc(departments.name));
} catch (e: any) {
  deptsReadable = false;
  console.error('[departments] list failed:', e?.cause?.message || e?.message);
}

// Open-role counts for every department at once. Respects the same public visibility rule the
// listing query uses: open, PUBLISHED, and not past its deadline.
let counts: Record<string, number> = {};
let countsReadable = true;
try {
  const r = await db.execute(sql`
    SELECT department_id, COUNT(*)::int AS n
      FROM roles
     WHERE is_open = TRUE
       AND COALESCE(job_status, 'PUBLISHED') = 'PUBLISHED'
       AND (application_deadline IS NULL OR application_deadline > NOW())
       AND department_id IS NOT NULL
     GROUP BY department_id`);
  counts = Object.fromEntries(rowsOf(r).map((x) => [String(x.department_id), Number(x.n || 0)]));
} catch (e: any) {
  countsReadable = false;
  console.error('[departments] counts failed:', e?.cause?.message || e?.message);
}

const divisionList = await listDivisions({});
const divisionCounts = await openRoleCountByDivision(null);

// Divisions grouped by department, so a department card can show what it is made of.
const divisionsByDept: Record<string, typeof divisionList.rows> = {};
for (const d of divisionList.rows) {
  if (!divisionsByDept[d.departmentId]) divisionsByDept[d.departmentId] = [];
  divisionsByDept[d.departmentId].push(d);
}

// Every comparison hoisted out of the markup — a `<` inside a JSX expression breaks .astro parsing.
const cards = allDepts.map((d) => {
  const divs = divisionsByDept[d.id] || [];
  const openCount = counts[d.id] || 0;
  return {
    id: String(d.id),
    name: String(d.name),
    description: String(d.description || ''),
    openCount,
    hasOpen: openCount > 0,
    divisions: divs,
    divisionCount: divs.length,
    hasDivisions: divs.length > 0,
    isResearchDepartment: String(d.id) === XSCALE_DEPARTMENT_ID,
  };
});

const withOpen = cards.filter((c) => c.hasOpen);
const withoutOpen = cards.filter((c) => !c.hasOpen);
const totalOpen = Object.values(counts).reduce((a, b) => a + b, 0);
const departmentCount = cards.length;
const nothingAtAll = departmentCount === 0;
const anyDivisions = divisionList.rows.length > 0;

const metaDescription =
  'Every department at EduRankAI, with open roles, divisions and the kind of work each one does. '
  + 'Browse the directory and apply to any opportunity directly.';
---

<BaseLayout title="Department directory" description={metaDescription}>
  <section class="px-[5vw] pt-9 md:pt-12 pb-6 max-w-7xl mx-auto">
    <p class="eyebrow mb-2">Careers &middot; Directory</p>
    <h1 class="font-display text-[clamp(1.9rem,4.6vw,2.9rem)] font-semibold text-ink leading-[1.06] tracking-tight mb-3">
      What this organisation is made of
    </h1>
    <p class="text-[0.95rem] text-ink-2 leading-relaxed max-w-3xl mb-5">
      {countsReadable
        ? totalOpen + ' open ' + (totalOpen === 1 ? 'role' : 'roles') + ' across ' + departmentCount + ' departments.'
        : departmentCount + ' departments. Open-role counts could not be read just now.'}
      {anyDivisions ? ' Research departments are organised into divisions, each stating the scale it works at.' : ''}
    </p>

    <div class="flex flex-wrap gap-2">
      <a href="/careers" class="text-[0.78rem] font-semibold text-burn px-3 py-1.5 rounded-lg border border-burn-dim bg-burn-pale no-underline hover:bg-burn-pale/70">All open roles &rarr;</a>
      <a href="/careers/opportunities" class="text-[0.78rem] font-semibold text-sky px-3 py-1.5 rounded-lg border border-sky-border bg-sky-bg no-underline hover:opacity-80">Search research opportunities &rarr;</a>
    </div>
  </section>

  {!deptsReadable && (
    <section class="px-[5vw] pb-10 max-w-7xl mx-auto">
      <div class="bg-white border border-ink/10 rounded-2xl p-6" style="border-left:4px solid #9a3412;">
        <h2 class="font-display text-[1.05rem] font-semibold text-ink m-0 mb-2">We could not load the directory</h2>
        <p class="text-[0.88rem] text-ink-2 leading-relaxed m-0">
          This is a fault on our side, not an empty organisation. Please try again shortly, or write to
          <a href="mailto:hr@edurankai.in" class="text-burn font-semibold no-underline hover:underline"> hr@edurankai.in</a>.
        </p>
      </div>
    </section>
  )}

  {deptsReadable && nothingAtAll && (
    <section class="px-[5vw] pb-10 max-w-7xl mx-auto">
      <div class="bg-white border border-ink/10 rounded-2xl p-8 text-center">
        <h2 class="font-display text-[1.1rem] font-semibold text-ink m-0 mb-2">No departments are published yet.</h2>
        <p class="text-[0.88rem] text-ink-soft m-0">The directory will list them here as soon as they are.</p>
      </div>
    </section>
  )}

  {deptsReadable && !nothingAtAll && (
    <section class="px-[5vw] pb-12 max-w-7xl mx-auto">
      {withOpen.length > 0 && (
        <h2 class="font-display text-[1.25rem] font-semibold text-ink mb-3">Departments hiring now</h2>
      )}
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {withOpen.map((c) => (
          <article class={'bg-white border rounded-2xl p-5 ' + (c.isResearchDepartment ? 'border-burn-dim' : 'border-ink/10')}>
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="font-display text-[1.05rem] font-semibold text-ink leading-tight m-0">
                <a href={`/careers/department/${c.id}`} class="no-underline text-inherit hover:text-burn transition-colors">{c.name}</a>
              </h3>
              <span class="shrink-0 text-[0.68rem] font-mono font-bold text-burn bg-burn-pale border border-burn-dim rounded-full px-2 py-0.5">{c.openCount}</span>
            </div>
            <p class="text-[0.82rem] text-ink-soft leading-relaxed m-0 mb-3">{c.description}</p>
            {c.hasDivisions && (
              <p class="text-[0.74rem] text-ink-soft m-0 mb-3">
                <strong class="text-ink-2 font-semibold">{c.divisionCount}</strong> {c.divisionCount === 1 ? 'division' : 'divisions'}
              </p>
            )}
            <div class="flex flex-wrap gap-2">
              <a href={`/careers/department/${c.id}`} class="text-[0.76rem] font-semibold text-burn no-underline hover:underline">Open the department &rarr;</a>
              <a href={`/careers/opportunities?dept=${c.id}`} class="text-[0.76rem] font-semibold text-ink-soft no-underline hover:text-ink">See the {c.openCount} open</a>
            </div>
          </article>
        ))}
      </div>

      {withoutOpen.length > 0 && (
        <div class="mt-8">
          <h2 class="font-display text-[1.05rem] font-semibold text-ink mb-1">Not hiring at the moment</h2>
          <p class="text-[0.82rem] text-ink-soft mb-3 max-w-2xl">
            These departments exist and have no open posting today. Nothing is being hidden from you; there is
            simply nothing to apply to yet.
          </p>
          <div class="flex flex-wrap gap-2">
            {withoutOpen.map((c) => (
              <a href={`/careers/department/${c.id}`} class="text-[0.78rem] text-ink-2 bg-cream-2 border border-ink/10 rounded-lg px-3 py-1.5 no-underline hover:border-ink/25 transition-colors">{c.name}</a>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  {anyDivisions && (
    <section class="px-[5vw] pb-14 max-w-7xl mx-auto">
      <div class="bg-cream-2 border border-ink/10 rounded-2xl p-5 md:p-6">
        <h2 class="font-display text-[1.15rem] font-semibold text-ink m-0 mb-2">Research divisions</h2>
        <p class="text-[0.85rem] text-ink-2 leading-relaxed max-w-3xl m-0 mb-2">
          A division is the level between a department and a posting. Each one declares the scale range it
          works at and the kind of research it does. {SCALE_DISCLAIMER_SHORT}
        </p>
        <div class="grid gap-2 md:grid-cols-2 xl:grid-cols-3 mt-4">
          {divisionList.rows.map((d) => (
            <a href={`/careers/division/${d.slug}`} class="flex items-start justify-between gap-3 bg-white border border-ink/10 rounded-xl px-4 py-3 no-underline text-inherit hover:border-ink/25 transition-colors">
              <span class="text-[0.84rem] font-medium text-ink leading-snug">{d.name}</span>
              <span class="shrink-0 text-[0.68rem] font-mono text-ink-soft">{divisionCounts[d.id] || 0}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
