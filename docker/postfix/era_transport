# docker/postfix/era_transport — the transport map referenced by main.cf.override.
#
# Every message accepted for a domain we host is routed to the ingest bridge instead of to a local
# mailbox. The bridge signs it and hands it to /api/mail/inbound; the application decides who it
# belongs to. Postfix therefore never needs a Unix account, a virtual mailbox map, or a reload when
# a user is added — a user is a database row.
#
# FORMAT: `<pattern> <transport>:<nexthop>`. The transport name must match the service defined in
# master.cf.override. Postfix reads the HASHED form of this file, not the text — after editing you
# must run, inside the mta container:
#
#     postmap /etc/postfix/era_transport && postfix reload
#
# Forgetting the postmap is the classic failure: the text file says one thing, the .db says the
# previous thing, and mail keeps routing the old way with no error anywhere. ./scripts/start-mail.sh
# runs postmap for you on start.
#
# The domain below must match MAIL_DOMAIN. A second hosted domain gets a second line.

edurankai.in            era-ingest:[mail-parser]:1025
.edurankai.in           era-ingest:[mail-parser]:1025

# The square brackets matter: they tell Postfix the nexthop is a literal host, so it connects
# directly instead of looking up MX records for `mail-parser`, which do not exist.
