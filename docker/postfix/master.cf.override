# docker/postfix/master.cf.override — appended to the generated Postfix master.cf.
#
# Defines the `era-ingest` transport referenced by transport_maps in main.cf.override: an SMTP
# client pointed at the ingest bridge inside the compose network.
#
# WHY EACH FLAG IS HERE, because a wrong one here is silent mail loss:
#
#   -o smtp_send_xforward_command=yes
#       Forwards the ORIGINAL client's IP and HELO to the bridge. Without it every inbound message
#       appears to come from the Postfix container, and the Received: chain — the thing you read
#       when investigating whether a message is genuine — is broken at exactly the hop that matters.
#
#   -o disable_dns_lookups=yes
#       The destination is a compose service name resolved by Docker's embedded DNS, not a public
#       hostname with MX records. Without this Postfix tries to look up MX for `mail-parser` and
#       defers the message.
#
#   -o smtp_tls_security_level=none
#       This hop is inside the container network. The bridge deliberately implements no STARTTLS
#       (see docker/mailops/smtp-server.mjs); asking for TLS here would defer every message.
#
#   -o syslog_name=postfix/era-ingest
#       So the log line for this hop is greppable and distinguishable from ordinary outbound SMTP.
#
# The concurrency limit is 20: the bridge forwards over HTTP to the app, and 20 parallel POSTs is
# already more than a single app instance wants. Raising it does not make delivery faster, it makes
# the app the bottleneck and turns 451-retries into the normal case.

era-ingest  unix  -       -       n       -       20      smtp
    -o syslog_name=postfix/era-ingest
    -o smtp_send_xforward_command=yes
    -o disable_dns_lookups=yes
    -o smtp_tls_security_level=none
    -o smtp_helo_name=$myhostname
