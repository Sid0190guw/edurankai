# docker/dovecot/dovecot.cf.override — appended to the generated Dovecot config.
#
# WHAT DOVECOT IS FOR IN THIS SYSTEM, which is less than you might expect.
#
# The application stores mail in Postgres (`mail_messages`, `mail_box`, `mail_recipients`) and users
# read it in the web client. Dovecot is NOT that store. It exists for two narrower jobs:
#
#   1. SASL authentication for Postfix submission on 587 — so a desktop mail client, or the app's
#      own SMTP transport, can authenticate to send.
#   2. IMAP access to any mailbox that IS held on this host — the org mailbox that the IMAP poller
#      reads, and any account someone wants to reach from a phone's mail app.
#
# Which means: DO NOT assume a user visible in the web client has a Dovecot mailbox. They do not.
# Adding one is an explicit act (docker-mailserver's `setup email add`), and docs/mail/DEPLOYMENT.md
# section 7 covers when that is the right thing to do.

# --- protocols -----------------------------------------------------------------------------------
# No POP3. It is a second retrieval protocol with its own auth surface, for a feature nobody here
# has asked for; every port that answers is a port to defend.
protocols = imap lmtp sieve

# --- authentication ------------------------------------------------------------------------------
# No plaintext auth on an unencrypted connection. With SSL_TYPE=self-signed in local development
# this means your mail client must be told to accept the certificate — that is the correct trade:
# a client that silently sends a password in the clear is worse than one that asks a question.
disable_plaintext_auth = yes
auth_mechanisms = plain login

# Do not tell an attacker which half of the guess was right. Dovecot's default already does this;
# it is written out because it is a property people disable while debugging and forget to restore.
auth_verbose = no
auth_failure_delay = 2 secs

# --- mailbox layout ------------------------------------------------------------------------------
mail_location = maildir:/var/mail/%d/%n/Maildir

namespace inbox {
  inbox = yes
  # Standard special-use folders, so a phone mail app files sent/drafts/trash where the user expects
  # rather than creating a second set with different names.
  mailbox Drafts { special_use = \Drafts auto = subscribe }
  mailbox Sent   { special_use = \Sent   auto = subscribe }
  mailbox Junk   { special_use = \Junk   auto = subscribe }
  mailbox Trash  { special_use = \Trash  auto = subscribe }
  mailbox Archive { special_use = \Archive auto = subscribe }
}

# --- limits --------------------------------------------------------------------------------------
# A stuck client that opens connections without closing them will exhaust the process limit and lock
# everyone out; these bound the damage to the one account.
mail_max_userip_connections = 20

# --- logging -------------------------------------------------------------------------------------
# Login attempts, with the IP. This is the log you read after a fail2ban ban to find out whether the
# ban was right. Not `mail_debug` — that logs message content paths and fills a disk quickly.
log_path = /var/log/mail/dovecot.log
auth_verbose_passwords = no
