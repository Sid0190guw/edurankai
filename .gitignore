.env*.local

# Trained model weights. The code that produces them is versioned; the artefacts are not — they are
# hundreds of megabytes, they are reproducible from a fixed seed, and a repository is a poor
# artefact store. Run `python ml/intent/train.py` to rebuild.
ml/*/model/
ml/*/data/
ml/*/adapters/     # LoRA adapters: 50-200MB of weights, same rule as model/ - never in the repo, never in the bundle

.vercel

# Scraped pages and scratch notes kept in the project root for reference. 700 KB of other
# people's HTML was committed by a `git add -A` that swept the whole working tree; it is not
# source, it is not served (Astro serves src/pages and public only), and it inflates every deploy.
/*.html
/g.mdx
/h.txt

# `.env.*` above also matched `.env.example`, which is the one file in this family that MUST be
# committed — it is the environment contract a new engineer reads before they have any secrets. The
# negation is last because in git the LAST matching pattern wins. It re-includes exactly one name;
# every real `.env`, `.env.local`, `.env.production` stays ignored.
!.env.example

# Local mail-stack state: message spools, captured test mail, DKIM keys, container volumes. Never
# committed — the DKIM private key alone would let anyone sign mail as this domain.
/docker/data/
/docker/dkim/
/.mailtest/

# ---------------------------------------------------------------------------
# mail-engine (Patch 2 — SMTP/inbound/outbound engine)
# ---------------------------------------------------------------------------
# THE SPOOL IS LIVE MAIL. Queued messages, held inbound mail and unpublished delivery events. It is
# real people's correspondence on disk; it must never reach a repository or a deploy bundle.
mail-engine/.spool/
mail-engine/**/.spool/

# DKIM PRIVATE KEYS. The one file in this stack that is catastrophic to leak: whoever holds it can
# sign mail that every receiving server will believe came from this domain. keys/README.md and
# keys/.gitkeep are tracked; nothing else in there ever is.
mail-engine/keys/*
!mail-engine/keys/README.md
!mail-engine/keys/.gitkeep

# TLS material and the mailbox password file for the local stack.
#
# `certs/*` and not `certs/`, deliberately: git cannot re-include a file inside an ignored DIRECTORY,
# only inside an ignored glob. The directory itself has to be committed, because Docker creates a
# missing bind-mount source as a root-owned directory that nothing in the container can then write
# to — which is exactly the crash-loop the entrypoints now also defend against.
mail-engine/docker/certs/*
!mail-engine/docker/certs/.gitkeep
!mail-engine/docker/certs/README.md
mail-engine/docker/dovecot/users
mail-engine/.env

# Backup archives and the Prometheus bearer token: real data and a real credential, written by
# scripts/backup.sh and scripts/start-mail.sh onto the machine that runs the stack.
/backups/
/docker/prometheus/metrics_token
