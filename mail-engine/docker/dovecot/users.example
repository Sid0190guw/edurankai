# mail-engine/docker/dovecot/users — one mailbox per line. COPY THIS TO `users`, WHICH IS GITIGNORED.
#
# Format:  address:{scheme}hash::::
# Generate a hash:  docker compose -f mail-engine/docker-compose.yml exec dovecot doveadm pw -s ARGON2ID
#
# These are ORGANISATIONAL mailboxes, not user accounts. Learner and staff mail lives in the
# application's own mailbox tables; the addresses here are the ones a mail system is required to
# have and the ones a human actually opens in a mail client.
#
# postmaster@edurankai.in:{ARGON2ID}$argon2id$v=19$m=65536,t=3,p=1$...:::::
# abuse@edurankai.in:{ARGON2ID}$argon2id$v=19$m=65536,t=3,p=1$...:::::
# connect@edurankai.in:{ARGON2ID}$argon2id$v=19$m=65536,t=3,p=1$...:::::
