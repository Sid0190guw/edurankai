# mail-engine/docker/postfix/master.cf — which daemons listen where.
#
# THE DISTINCTION THIS FILE ENCODES: port 25 is for OTHER MAIL SERVERS, ports 587 and 465 are for
# OUR OWN USERS. They are not the same service with different numbers. Port 25 must accept anonymous
# connections (that is what an MX is) and must therefore only accept mail addressed to us. Ports 587
# and 465 require authentication and, having authenticated, will relay anywhere — which is exactly
# what makes accidentally applying submission's permissions to port 25 an open relay.

# ==========================================================================
# service   type  private unpriv  chroot  wakeup  maxproc  command + args
# ==========================================================================
smtp       inet  n       -       n       -       -       smtpd
  -o smtpd_sasl_auth_enable=no

# Submission, STARTTLS on 587. Authentication is mandatory and encryption is mandatory: a password
# must never cross a network in the clear, and `encrypt` is safe here in a way it is not on port 25
# because the clients are ours.
submission inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# Implicit TLS submission on 465. Same rules, different handshake.
smtps      inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

pickup     unix  n       -       n       60      1       pickup
cleanup    unix  n       -       n       -       0       cleanup
qmgr       unix  n       -       n       300     1       qmgr
tlsmgr     unix  -       -       n       1000?   1       tlsmgr
rewrite    unix  -       -       n       -       -       trivial-rewrite
bounce     unix  -       -       n       -       0       bounce
defer      unix  -       -       n       -       0       bounce
trace      unix  -       -       n       -       0       bounce
verify     unix  -       -       n       -       1       verify
flush      unix  n       -       n       1000?   0       flush
proxymap   unix  -       -       n       -       -       proxymap
proxywrite unix  -       -       n       -       1       proxymap
smtp       unix  -       -       n       -       -       smtp
relay      unix  -       -       n       -       -       smtp
showq      unix  n       -       n       -       -       showq
error      unix  -       -       n       -       -       error
retry      unix  -       -       n       -       -       error
discard    unix  -       -       n       -       -       discard
local      unix  -       n       n       -       -       local
virtual    unix  -       n       n       -       -       virtual
lmtp       unix  -       -       n       -       -       lmtp
anvil      unix  -       -       n       -       1       anvil
scache     unix  -       -       n       -       1       scache

# The alternative inbound shape: hand the raw message to the mail engine over HTTP instead of
# storing it in Dovecot. Selected by setting VIRTUAL_TRANSPORT=engine in the environment.
#
# The engine answers 200 (accept), 503 (retry later) or 550 (refuse), and pipe-to-engine.sh turns
# those into the exit codes Postfix reads as delivered / deferred / bounced. That mapping is the
# whole reason this is a script and not a one-line curl: an HTTP failure that exits 0 tells Postfix
# a message was delivered when it was not.
engine     unix  -       n       n       -       -       pipe
  flags=DRhu user=nobody argv=/usr/local/bin/pipe-to-engine.sh ${sender} ${recipient}
