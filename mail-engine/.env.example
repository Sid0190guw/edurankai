# mail-engine/.env.example — copy to mail-engine/.env and edit. `.env` is gitignored.
#
# THE ENGINE READS THIS FILE AND NOTHING ELSE. It never opens the application's .env, .env.local or
# .env.production — those hold live database credentials, and the working rule in CLAUDE.md is that
# local processes do not open them. The engine has no database access at all; it talks to the
# application over HTTP with one shared secret.
#
# Every value below has a default that is safe: with an empty file the engine starts, queues mail,
# serves /healthz, and delivers nothing to anybody. Making it send is a deliberate act.
#
# Check what a given environment actually resolves to:
#   node --import tsx mail-engine/src/cli.ts check

# ===========================================================================
# 1. IDENTITY — who this mail server says it is
# ===========================================================================
# Used in EHLO, in generated Message-IDs, and as the name a receiving server checks against the
# PTR record of your IP. MUST be a fully qualified name, and in production must resolve to the
# sending IP with a matching PTR. See docs/dns.md.
MAIL_HOSTNAME=mail.edurankai.in

# Domains this engine accepts inbound mail for, and is allowed to send as. Comma-separated.
# A message whose From is outside this list is REFUSED at submission — that is the anti-relay rule.
MAIL_DOMAINS=edurankai.in

# ===========================================================================
# 2. OUTBOUND — how mail leaves
# ===========================================================================
# OFF BY DEFAULT. With this false the whole pipeline runs — validation, queue, MX lookup, throttle,
# DKIM, events — and stops before opening a socket to a stranger's mail server. Turn it on when you
# intend to mail real people.
MAIL_DELIVERY_ENABLED=false

# Empty = deliver direct to each recipient's MX on port 25. That is how a real mail server works and
# it will NOT work from a laptop or from most cloud hosts, because outbound 25 is blocked. Set a
# smarthost here to relay instead. For local testing point it at Mailpit/MailHog (port 1025).
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASS=
# 465 = implicit TLS, 587 = STARTTLS. Derived from the port; only set this for a non-standard port.
MAIL_RELAY_SECURE=

# Refuse to hand a message to a server that will not do STARTTLS. Leave false for direct-to-MX:
# a receiving server without TLS still deserves the mail, and refusing means it goes nowhere.
MAIL_REQUIRE_TLS=false

MAIL_SMTP_CONNECT_TIMEOUT_MS=20000
MAIL_SMTP_GREETING_TIMEOUT_MS=15000
MAIL_SMTP_SOCKET_TIMEOUT_MS=60000

# ===========================================================================
# 3. RATE AND CONCURRENCY — "do NOT blindly send unlimited traffic"
# ===========================================================================
# Simultaneous connections to ONE destination domain. Large providers count these and answer 421
# when a sender opens too many, which is a reputation event and not merely a deferral.
MAIL_PER_DOMAIN_CONCURRENCY=2
# Simultaneous connections across all domains.
MAIL_GLOBAL_CONCURRENCY=8
# Messages per minute to one destination domain, sliding window. 0 disables the limit.
MAIL_PER_DOMAIN_RATE_PER_MINUTE=60
# Messages claimed from the spool in one pass, and how long the worker sleeps when it is empty.
MAIL_BATCH_SIZE=20
MAIL_POLL_INTERVAL_MS=2000

# ===========================================================================
# 4. RETRY — how long a temporarily-unreachable recipient is given
# ===========================================================================
# The defaults are 9 attempts at 1m, 3m, 9m, 27m, 81m, 4h, 6h, 6h, 6h — about 24 hours in total,
# which is what a receiving postmaster expects before a sender gives up.
MAIL_MAX_ATTEMPTS=9
MAIL_RETRY_BASE_MS=60000
MAIL_RETRY_FACTOR=3
MAIL_RETRY_MAX_MS=21600000
# Jitter is what actually prevents a retry storm: without it, ten thousand messages deferred by one
# outage all come back at the same second. 0.2 = each delay varies by up to +/-20%.
MAIL_RETRY_JITTER=0.2

# ===========================================================================
# 5. LIMITS
# ===========================================================================
MAIL_MAX_MESSAGE_BYTES=26214400
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_RECIPIENTS=100
# Refused on the way in and on the way out. Executables first.
MAIL_BLOCKED_EXTENSIONS=exe,scr,pif,com,bat,cmd,vbs,vbe,js,jse,wsf,wsh,msi,msp,hta,cpl,jar,lnk,reg,ps1,psm1,scf,inf,chm

# ===========================================================================
# 6. DKIM
# ===========================================================================
# The selector appears in the DNS record name: <selector>._domainkey.<domain>
MAIL_DKIM_SELECTOR=era1
# Where <domain>.private lives. Gitignored. Generate with: cli keygen <domain>
MAIL_DKIM_KEY_DIR=mail-engine/keys

# ===========================================================================
# 7. THE LINK TO THE APPLICATION
# ===========================================================================
MAIL_APP_BASE_URL=http://127.0.0.1:4321

# Signs every delivery event the engine sends, and every request the application sends back. Not a
# bearer token — an HMAC over the timestamp and the body, so a captured request cannot be replayed
# or modified. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The SAME value must be set as MAIL_APP_SHARED_SECRET in the application's environment.
MAIL_APP_SHARED_SECRET=

# The secret the application already uses on /api/mail/inbound (header x-mail-secret). Shown in
# /admin/mail/settings. Without it, inbound mail is spooled but never handed over.
MAIL_INBOUND_SECRET=

MAIL_APP_TIMEOUT_MS=15000

# ===========================================================================
# 8. STORAGE
# ===========================================================================
# THE DURABILITY PROMISE. Queued messages, held inbound mail and unpublished events live here.
# In Docker this is a named volume; on a host it must be on real disk, backed up, and never on a
# tmpfs. Everything else in this system can be rebuilt from git — this cannot.
MAIL_SPOOL_DIR=mail-engine/.spool

# ===========================================================================
# 9. INBOUND
# ===========================================================================
# Accept mail for any address at a hosted domain. OFF by default: with it off, a mistyped address is
# refused at RCPT time and the sender is told immediately by their own mail client. A catch-all turns
# that into silence and attracts dictionary spam.
MAIL_CATCH_ALL=false
# Rspamd score at or above which a message is REFUSED outright.
MAIL_SPAM_REJECT_SCORE=15
# Score at or above which it is accepted but filed to Spam.
MAIL_SPAM_QUARANTINE_SCORE=6

# ===========================================================================
# 10. MAILBOX SYNC (Dovecot -> application)
# ===========================================================================
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
MAIL_IMAP_SECURE=true
# Only for Dovecot on the same host with a self-signed certificate. NEVER true against a mailbox on
# the public Internet — it makes the encryption decorative.
MAIL_IMAP_ALLOW_SELF_SIGNED=false

# ===========================================================================
# 11. THE ENGINE'S OWN API
# ===========================================================================
MAIL_ENGINE_PORT=2580
# Loopback by default. A submission API reachable from the network with no secret is an open relay
# wearing a JSON hat. In Docker this is 0.0.0.0 inside the compose network only.
MAIL_ENGINE_HOST=127.0.0.1
MAIL_LOG_LEVEL=info

# ===========================================================================
# 12. DOCKER-ONLY (read by docker-compose.yml, not by the engine)
# ===========================================================================
# Publish the MX port somewhere harmless while testing; 25 needs root and a public IP to be useful.
POSTFIX_SMTP_PORT=25
POSTFIX_SUBMISSION_PORT=587
POSTFIX_SUBMISSIONS_PORT=465
DOVECOT_IMAPS_PORT=993
# lmtp:inet:dovecot:24 stores accepted mail in a real mailbox; `engine` pipes it to the application.
VIRTUAL_TRANSPORT=lmtp:inet:dovecot:24
# Postfix's own smarthost, in host:port form, e.g. [smtp.example.com]:587
MAIL_RELAY_HOST_WITH_PORT=
# Where postmaster@ and abuse@ mail is forwarded. RFC 2142 requires both to be reachable.
MAIL_POSTMASTER=
# Extra organisational mailboxes for Dovecot, comma-separated.
MAIL_EXTRA_MAILBOXES=
